    <edge source="Friedman Test" target="ANOVA">
      <data key="d4">8.0</data>
      <data key="d5">The Friedman test serves as the non-parametric statistical counterpart to ANOVA for comparing multiple classifiers.</data>
      <data key="d6">statistical methodology, hypothesis testing</data>

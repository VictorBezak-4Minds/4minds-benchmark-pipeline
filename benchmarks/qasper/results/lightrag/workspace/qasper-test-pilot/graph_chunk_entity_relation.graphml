      <data key="d0">ITA</data>
      <data key="d1">category</data>
      <data key="d2">A proposed conversational framework comprising imaginators and arbitrators, evaluated against several baseline models.</data>
      <data key="d3">chunk-e97e9e342e051e03614c8dcaa59a2bbc</data>
    </node>
    <node id="GLOVE">
      <data key="d0">GLOVE</data>
      <data key="d1">category</data>
      <data key="d2">Global Vectors for Word Representation, a pretrained word embedding method integrated with LSTM-attention imaginators.</data>

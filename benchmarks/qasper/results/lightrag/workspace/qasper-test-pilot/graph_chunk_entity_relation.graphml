    <node id="Netherlands">
      <data key="d0">Netherlands</data>
      <data key="d1">geo</data>
      <data key="d2">The Netherlands (Dutch context) is a country whose obituaries were analyzed by Barth2013 for information density compared to German ones.&lt;SEP&gt;The Netherlands is a European country whose Dutch obituary practices and text structures were compared with German obituaries.</data>
      <data key="d3">chunk-dc1405d1609fdbebb00fe9dd18235f8e&lt;SEP&gt;chunk-9a42d2500d95a11dc6c778a73c5dba9c</data>
    </node>
    <node id="Turkey">
      <data key="d0">Turkey</data>
      <data key="d1">geo</data>
      <data key="d2">The country whose language conventions, diacritics, national organizations, and locations are analyzed in the tweet dataset.&lt;SEP&gt;Turkey is a country whose cultural, religious, and gendered obituary conventions were analyzed via data from a major newspaper.&lt;SEP&gt;Turkey is the geographic and linguistic origin associated with the Turkish language tweets analyzed for named entity variants.&lt;SEP&gt;Turkey is the nation associated with the Turkish language tweets analyzed for named entity variants.</data>
      <data key="d3">chunk-4752470c8ccb777bad45ef52fde0243d&lt;SEP&gt;chunk-195b3bb495c9171fc33fb85c129c4366&lt;SEP&gt;chunk-9a42d2500d95a11dc6c778a73c5dba9c</data>
    </node>
    <node id="Institute for Natural Language Processing">
      <data key="d0">Institute for Natural Language Processing</data>

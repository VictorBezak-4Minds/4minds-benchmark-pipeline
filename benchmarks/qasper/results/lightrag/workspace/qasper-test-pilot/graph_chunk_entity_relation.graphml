      <data key="d0">Joint Event, Intent and Sentiment Embedding</data>
      <data key="d1">category</data>
      <data key="d2">A proposed multi-task embedding framework that jointly learns event representations by minimizing loss across events, intents, and sentiment polarity.</data>
      <data key="d3">chunk-a8fecfb2a0e52c8eb6b888c9cbd44d9c</data>

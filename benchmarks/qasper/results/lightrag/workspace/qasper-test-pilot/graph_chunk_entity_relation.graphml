    </node>
    <node id="Faceted Navigation">
      <data key="d0">Faceted Navigation</data>
      <data key="d1">category</data>
      <data key="d2">Faceted navigation is an information retrieval paradigm that leverages keyphrases to filter and browse digital news content.</data>
      <data key="d3">chunk-f7a0c631645254ecce4e14a53d44a991</data>
    </node>
    <node id="Topic Detection and Tracking">

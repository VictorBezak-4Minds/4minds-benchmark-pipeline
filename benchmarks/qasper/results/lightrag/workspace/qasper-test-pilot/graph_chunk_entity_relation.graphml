  <graph edgedefault="undirected">
    <node id="Beslan">
      <data key="d0">Beslan</data>
      <data key="d1">geo</data>
      <data key="d2">Beslan is a town referenced in the context of the named event 'la strage di Beslan' (Beslan school siege).</data>
      <data key="d3">chunk-48ba6937cc2983c08b0405a141734414</data>
    </node>
    <node id="2014 EVALITA Workshop">
      <data key="d0">2014 EVALITA Workshop</data>
      <data key="d1">event</data>
      <data key="d2">The 2014 EVALITA Workshop is an evaluation workshop within which the EVENTI evaluation exercise was organized.</data>
      <data key="d3">chunk-48ba6937cc2983c08b0405a141734414</data>
    </node>
    <node id="EVENTI">
      <data key="d0">EVENTI</data>
      <data key="d1">event</data>
      <data key="d2">EVENTI is an evaluation campaign and benchmark corpus focused on event detection, extent, and classification in Italian texts.&lt;SEP&gt;EVENTI is an evaluation campaign and exercise organized to promote research in Italian Temporal Processing, focusing on event detection and classification.&lt;SEP&gt;The EVENTI exercise is an evaluation campaign and benchmark task focused on event detection and classification in Italian texts.</data>
      <data key="d3">chunk-48ba6937cc2983c08b0405a141734414&lt;SEP&gt;chunk-d7345d905ffe9add1bcb531e153ba67c&lt;SEP&gt;chunk-b929f54fb0080794be4ecee79e383e83</data>
    </node>
    <node id="TempEval-2">
      <data key="d0">TempEval-2</data>
      <data key="d1">event</data>
      <data key="d2">TempEval-2 is an evaluation campaign held at SemEval 2010 whose Italian dataset test articles were used to create the development set for the EVENTI experiments.</data>
      <data key="d3">chunk-48ba6937cc2983c08b0405a141734414</data>
    </node>
    <node id="Beslan School Siege">
      <data key="d0">Beslan School Siege</data>
      <data key="d1">event</data>
      <data key="d2">The Beslan school siege ('la strage di Beslan') is a historical named event cited as an example of a multi-token event expression in Italian.</data>
      <data key="d3">chunk-48ba6937cc2983c08b0405a141734414</data>
    </node>
    <node id="OCCURRENCE">
      <data key="d0">OCCURRENCE</data>
      <data key="d1">category</data>
      <data key="d2">OCCURRENCE is an event semantic class and the most frequent category in the dataset, often overgeneralized during classification.&lt;SEP&gt;OCCURRENCE is an event semantic class representing dynamic events and actions, forming a large majority of annotated events.&lt;SEP&gt;OCCURRENCE is one of the seven TimeML event classes used in the EVENTI annotation task.</data>
      <data key="d3">chunk-729f27491ada48b04fdb73922b86d171&lt;SEP&gt;chunk-48ba6937cc2983c08b0405a141734414&lt;SEP&gt;chunk-d7345d905ffe9add1bcb531e153ba67c</data>
    </node>
    <node id="ASPECTUAL">
      <data key="d0">ASPECTUAL</data>
      <data key="d1">category</data>
      <data key="d2">ASPECTUAL is an event semantic class denoting aspectual phases of actions.&lt;SEP&gt;ASPECTUAL is one of the seven TimeML event classes indicating aspectual phases of events in the EVENTI task.</data>
      <data key="d3">chunk-48ba6937cc2983c08b0405a141734414&lt;SEP&gt;chunk-d7345d905ffe9add1bcb531e153ba67c</data>
    </node>
    <node id="PERCEPTION">
      <data key="d0">PERCEPTION</data>
      <data key="d1">category</data>
      <data key="d2">PERCEPTION is an event semantic class denoting sensory or perception events.&lt;SEP&gt;PERCEPTION is one of the seven TimeML event classes denoting physical perception in the EVENTI classification task.</data>
      <data key="d3">chunk-48ba6937cc2983c08b0405a141734414&lt;SEP&gt;chunk-d7345d905ffe9add1bcb531e153ba67c</data>
    </node>
    <node id="REPORTING">
      <data key="d0">REPORTING</data>
      <data key="d1">category</data>
      <data key="d2">REPORTING is an event class denoting reporting actions or speech acts.&lt;SEP&gt;REPORTING is an event semantic classification category evaluated in the event classification subtask.&lt;SEP&gt;REPORTING is one of the seven TimeML event classes used to classify events of reporting or stating information.</data>
      <data key="d3">chunk-729f27491ada48b04fdb73922b86d171&lt;SEP&gt;chunk-48ba6937cc2983c08b0405a141734414&lt;SEP&gt;chunk-d7345d905ffe9add1bcb531e153ba67c</data>
    </node>
    <node id="I_STATE">
      <data key="d0">I_STATE</data>
      <data key="d1">category</data>
      <data key="d2">I_STATE (Intensional State) is a TimeML event category representing intensional states in the EVENTI annotation schema.&lt;SEP&gt;I_STATE is an intensional state category expressing factual relationships between target events and their arguments.</data>
      <data key="d3">chunk-48ba6937cc2983c08b0405a141734414&lt;SEP&gt;chunk-d7345d905ffe9add1bcb531e153ba67c</data>
    </node>
    <node id="I_ACTION">
      <data key="d0">I_ACTION</data>
      <data key="d1">category</data>
      <data key="d2">I_ACTION (Intensional Action) is a TimeML event category representing intensional actions in the EVENTI classification schema.&lt;SEP&gt;I_ACTION is an event semantic classification category analyzed for classification errors.&lt;SEP&gt;I_ACTION is an intensional action category in the event annotation schema.</data>
      <data key="d3">chunk-729f27491ada48b04fdb73922b86d171&lt;SEP&gt;chunk-48ba6937cc2983c08b0405a141734414&lt;SEP&gt;chunk-d7345d905ffe9add1bcb531e153ba67c</data>
    </node>
    <node id="STATE">
      <data key="d0">STATE</data>
      <data key="d1">category</data>
      <data key="d2">STATE is an event semantic class representing conditions or static situations in the annotation schema.&lt;SEP&gt;STATE is an event semantic classification category subject to error analysis across different NLP models.&lt;SEP&gt;STATE is one of the seven TimeML event classes denoting circumstances or states that hold true.</data>
      <data key="d3">chunk-729f27491ada48b04fdb73922b86d171&lt;SEP&gt;chunk-48ba6937cc2983c08b0405a141734414&lt;SEP&gt;chunk-d7345d905ffe9add1bcb531e153ba67c</data>
    </node>
    <node id="SemEval 2010">
      <data key="d0">SemEval 2010</data>
      <data key="d1">event</data>
      <data key="d2">SemEval 2010 is an international natural language processing evaluation campaign that hosted the TempEval-2 evaluation exercise.</data>
      <data key="d3">chunk-48ba6937cc2983c08b0405a141734414</data>
    </node>
    <node id="ACE">
      <data key="d0">ACE</data>
      <data key="d1">category</data>
      <data key="d2">ACE (Automatic Content Extraction) is a benchmark and semantic annotation framework defining semantic categories for event extraction.</data>
      <data key="d3">chunk-48ba6937cc2983c08b0405a141734414</data>
    </node>
    <node id="FrameNet">
      <data key="d0">FrameNet</data>
      <data key="d1">category</data>
      <data key="d2">FrameNet is a computational lexicography project and semantic categorization framework defining semantic frames.</data>
      <data key="d3">chunk-48ba6937cc2983c08b0405a141734414</data>
    </node>
    <node id="TimeML">
      <data key="d0">TimeML</data>
      <data key="d1">category</data>
      <data key="d2">TimeML is a rich specification language and annotation guideline standard for temporal and event markup in natural language texts.</data>
      <data key="d3">chunk-48ba6937cc2983c08b0405a141734414</data>
    </node>
    <node id="It-TimeML">
      <data key="d0">It-TimeML</data>
      <data key="d1">category</data>
      <data key="d2">It-TimeML is the Italian adaptation of the TimeML specification guidelines used for tagging events in Italian texts.</data>
      <data key="d3">chunk-48ba6937cc2983c08b0405a141734414</data>
    </node>
    <node id="Subtask B">
      <data key="d0">Subtask B</data>
      <data key="d1">event</data>
      <data key="d2">A secondary sub-competition within SemEval-2017 Task 6 evaluating humor detection systems.&lt;SEP&gt;A subtask within an evaluation task focused on ranking all tweets within a hashtag file in descending order of funniness.&lt;SEP&gt;Subtask B is a semi-ranking challenge designed to rank tweets based on predicted humor.&lt;SEP&gt;Subtask B is a specific subtask within the EVENTI exercise dedicated to determining the extent and class of event mentions.</data>
      <data key="d3">chunk-1c233285dd27a358f6bf38c2050006d0&lt;SEP&gt;chunk-8d534b033667c04cda76230428876daf&lt;SEP&gt;chunk-1f5cacf6864d5742410fde3c5baacf4f&lt;SEP&gt;chunk-48ba6937cc2983c08b0405a141734414</data>
    </node>
    <node id="Main Task">
      <data key="d0">Main Task</data>
      <data key="d1">event</data>
      <data key="d2">The Main Task is the primary dataset and evaluation subtrack in the EVENTI campaign focused on contemporary news articles.</data>
      <data key="d3">chunk-48ba6937cc2983c08b0405a141734414</data>
    </node>
    <node id="Pilot Task">
      <data key="d0">Pilot Task</data>
      <data key="d1">event</data>
      <data key="d2">The Pilot Task is an evaluation track within EVENTI focused on testing event detection on historical news articles.</data>
      <data key="d3">chunk-48ba6937cc2983c08b0405a141734414</data>
    </node>
    <node id="Single-Token Event">
      <data key="d0">Single-Token Event</data>
      <data key="d1">category</data>
      <data key="d2">Single-Token Event is a category of event mentions in EVENTI realized as an individual lexical token.</data>
      <data key="d3">chunk-48ba6937cc2983c08b0405a141734414</data>
    </node>
    <node id="Multi-Token Event">
      <data key="d0">Multi-Token Event</data>
      <data key="d1">category</data>
      <data key="d2">Multi-Token Event is a category of event mentions in EVENTI spanning multiple lexical tokens, including named events and verbal periphrases.</data>
      <data key="d3">chunk-48ba6937cc2983c08b0405a141734414</data>
    </node>
    <node id="Named Event">
      <data key="d0">Named Event</data>
      <data key="d1">category</data>
      <data key="d2">Named Event is a specific category of multi-token event expressions denoting specific historical or named occurrences.</data>
      <data key="d3">chunk-48ba6937cc2983c08b0405a141734414</data>
    </node>
    <node id="Verbal Periphrasis">
      <data key="d0">Verbal Periphrasis</data>
      <data key="d1">category</data>
      <data key="d2">Verbal Periphrasis is a category of multi-token verbal structures recognized as eventive expressions in the EVENTI guidelines.</data>
      <data key="d3">chunk-48ba6937cc2983c08b0405a141734414</data>
    </node>
    <node id="Verb">
      <data key="d0">Verb</data>
      <data key="d1">category</data>
      <data key="d2">A grammatical part-of-speech category evaluated in the event detection task for identifying verbal event mentions.&lt;SEP&gt;Verb is a grammatical part-of-speech category specified in sentence plan slots with inflectional attributes like voice, tense, and polarity.&lt;SEP&gt;Verb is a grammatical part-of-speech category that represents the most frequent realization of annotated events in EVENTI.</data>
      <data key="d3">chunk-d2133007f11cdae6d7728268eadeba6c&lt;SEP&gt;chunk-48ba6937cc2983c08b0405a141734414&lt;SEP&gt;chunk-729f27491ada48b04fdb73922b86d171</data>
    </node>
    <node id="Noun">
      <data key="d0">Noun</data>
      <data key="d1">category</data>
      <data key="d2">A part-of-speech category analyzed in the evaluation to measure detection performance on nominal event triggers.&lt;SEP&gt;Noun is a grammatical part-of-speech category that represents the second most frequent realization of annotated events in EVENTI.&lt;SEP&gt;Noun is a grammatical part-of-speech category used within slot annotations, functioning as head nouns, proper nouns, or common nouns.</data>
      <data key="d3">chunk-d2133007f11cdae6d7728268eadeba6c&lt;SEP&gt;chunk-48ba6937cc2983c08b0405a141734414&lt;SEP&gt;chunk-729f27491ada48b04fdb73922b86d171</data>
    </node>
    <node id="Adjective">
      <data key="d0">Adjective</data>
      <data key="d1">category</data>
      <data key="d2">A grammatical part-of-speech category analyzed for event detection performance across different models.&lt;SEP&gt;A part-of-speech category used as a binary feature to signal expressions or recommendations.&lt;SEP&gt;Adjective is a grammatical part-of-speech category annotated as event expressions in the EVENTI dataset.&lt;SEP&gt;Adjective is a grammatical part-of-speech category used in slot annotations to modify nouns or serve as the head of an nl name.</data>
      <data key="d3">chunk-d2133007f11cdae6d7728268eadeba6c&lt;SEP&gt;chunk-48ba6937cc2983c08b0405a141734414&lt;SEP&gt;chunk-729f27491ada48b04fdb73922b86d171&lt;SEP&gt;chunk-1e9f52662c01528fd8d607b1462c48df</data>
    </node>
    <node id="Prepositional Phrase">
      <data key="d0">Prepositional Phrase</data>
      <data key="d1">category</data>
      <data key="d2">A syntactic constituent category analyzed for evaluating system robustness on multi-token event realizations.&lt;SEP&gt;Prepositional Phrase is a syntactic part-of-speech category that realizes event mentions in Italian texts.</data>
      <data key="d3">chunk-48ba6937cc2983c08b0405a141734414&lt;SEP&gt;chunk-729f27491ada48b04fdb73922b86d171</data>
    </node>
    <node id="FBK-HLT">
      <data key="d0">FBK-HLT</data>
      <data key="d1">organization</data>
      <data key="d2">FBK-HLT is a research team or system from Fondazione Bruno Kessler that participated in the EVENTI Subtask B evaluation campaign.&lt;SEP&gt;FBK-HLT is a research unit at Fondazione Bruno Kessler focused on Human Language Technology, noted for its competitive benchmark system in event detection.&lt;SEP&gt;FBK-HLT refers to the Human Language Technology unit at Fondazione Bruno Kessler, which developed a competitive baseline system evaluated in the study.</data>
      <data key="d3">chunk-729f27491ada48b04fdb73922b86d171&lt;SEP&gt;chunk-d7345d905ffe9add1bcb531e153ba67c&lt;SEP&gt;chunk-b929f54fb0080794be4ecee79e383e83</data>
    </node>
    <node id="Marco">
      <data key="d0">Marco</data>
      <data key="d1">person</data>
      <data key="d2">Marco is an individual named in the example sentence used to illustrate the sequence-to-sequence BIO tagging problem.</data>
      <data key="d3">chunk-d7345d905ffe9add1bcb531e153ba67c</data>
    </node>
    <node id="Italian Wikipedia">
      <data key="d0">Italian Wikipedia</data>
      <data key="d1">organization</data>
      <data key="d2">Italian Wikipedia is the Italian-language edition of the Wikipedia encyclopedia, used as a text corpus source for generating word embeddings.</data>
      <data key="d3">chunk-d7345d905ffe9add1bcb531e153ba67c</data>
    </node>
    <node id="EVENTI Subtask B">
      <data key="d0">EVENTI Subtask B</data>
      <data key="d1">event</data>
      <data key="d2">EVENTI Subtask B is a specific competition subtask within the EVENTI shared task focused on event detection and classification.</data>
      <data key="d3">chunk-d7345d905ffe9add1bcb531e153ba67c</data>
    </node>
    <node id="Verbs">
      <data key="d0">Verbs</data>
      <data key="d1">category</data>
      <data key="d2">Verbs are a linguistic part-of-speech category representing the largest class of annotated event mentions in the dataset.</data>
      <data key="d3">chunk-d7345d905ffe9add1bcb531e153ba67c</data>
    </node>
    <node id="Nouns">
      <data key="d0">Nouns</data>
      <data key="d1">category</data>
      <data key="d2">Nouns are a linguistic part-of-speech category serving as the second most frequent annotation class for events.</data>
      <data key="d3">chunk-d7345d905ffe9add1bcb531e153ba67c</data>
    </node>
    <node id="Adjectives">
      <data key="d0">Adjectives</data>
      <data key="d1">category</data>
      <data key="d2">Adjectives are a syntactic part-of-speech category annotated as events when in predicative positions with copular constructions.</data>
      <data key="d3">chunk-d7345d905ffe9add1bcb531e153ba67c</data>
    </node>
    <node id="Prepositional Phrases">
      <data key="d0">Prepositional Phrases</data>
      <data key="d1">category</data>
      <data key="d2">Prepositional phrases are syntactic constructions annotated as event realizations in the evaluation data.</data>
      <data key="d3">chunk-d7345d905ffe9add1bcb531e153ba67c</data>
    </node>
    <node id="Indo-European">
      <data key="d0">Indo-European</data>
      <data key="d1">category</data>
      <data key="d2">A major language family comprising several subgroups including Indo-Aryan, Slavic, and Germanic.&lt;SEP&gt;Indo-European is a major language family whose typical realization of events is reflected in the distribution of the dataset.</data>
      <data key="d3">chunk-ba3fa25c5e29c7ea3201eac4d5fbec61&lt;SEP&gt;chunk-d7345d905ffe9add1bcb531e153ba67c</data>
    </node>
    <node id="BIO Scheme">
      <data key="d0">BIO Scheme</data>
      <data key="d1">category</data>
      <data key="d2">BIO Scheme is a token labeling convention representing Beginning, Inside, and Outside tokens, used to formulate event mention detection as a sequence labeling problem.</data>
      <data key="d3">chunk-d7345d905ffe9add1bcb531e153ba67c</data>
    </node>
    <node id="EVENTI Exercise">
      <data key="d0">EVENTI Exercise</data>
      <data key="d1">event</data>
      <data key="d2">The EVENTI exercise is an evaluation campaign and benchmark task focused on event detection and classification in Italian texts.</data>
      <data key="d3">chunk-729f27491ada48b04fdb73922b86d171</data>
    </node>
    <node id="Berardi">
      <data key="d0">Berardi</data>
      <data key="d1">person</data>
      <data key="d2">Berardi is a researcher referenced for creating word embeddings (word2vec and GloVe configurations) compared in the study.</data>
      <data key="d3">chunk-729f27491ada48b04fdb73922b86d171</data>
    </node>
    <node id="Italian">
      <data key="d0">Italian</data>
      <data key="d1">category</data>
      <data key="d2">A Romance language included in the bilingual morphological datasets.&lt;SEP&gt;A geographic, cultural, and linguistic designation appearing as a cuisine slot value (e.g., food=Italian) and as a target translation language for WOZ2.0.&lt;SEP&gt;Italian is a European language detected as a false-positive occurrence within digital corpora for Russia.&lt;SEP&gt;Italian is a Romance language included in existing bilingual resources and dictionaries for translation tasks.&lt;SEP&gt;Italian refers to the Italian geographic and linguistic domain for which the NLP models and the EVENTI shared task are designed.&lt;SEP&gt;One of the languages of the WOZ2.0 dataset used for empirical benchmarking of the G-SAT dialogue state tracking system.&lt;SEP&gt;One of the professional translation target languages evaluated in the multilingual WOZ2.0 dataset experiments.</data>
      <data key="d3">chunk-2e1e71821eb167dabc5002a21237f815&lt;SEP&gt;chunk-729f27491ada48b04fdb73922b86d171&lt;SEP&gt;chunk-d7d53ab63937232bbcc4be9c7080dd31&lt;SEP&gt;chunk-9896f0582e2237c4a0dd8169f6817110&lt;SEP&gt;chunk-00381e9f572e2f4c1655790b19b827fd&lt;SEP&gt;chunk-af6147035553ac26ef0837a5ab654f4f&lt;SEP&gt;chunk-785a16b34b0c74a5ee4f9f416976a683</data>
    </node>
    <node id="DH-FBK">
      <data key="d0">DH-FBK</data>
      <data key="d1">organization</data>
      <data key="d2">DH-FBK refers to the Digital Humanities research unit at Fondazione Bruno Kessler, associated with the DH-FBK_100 embedding configuration evaluated in the study.</data>
      <data key="d3">chunk-729f27491ada48b04fdb73922b86d171</data>
    </node>
    <node id="ILC">
      <data key="d0">ILC</data>
      <data key="d1">organization</data>
      <data key="d2">ILC refers to the Istituto di Linguistica Computazionale (ILC-CNR), associated with the ILC-ItWack word embedding configuration compared in the evaluation.</data>
      <data key="d3">chunk-729f27491ada48b04fdb73922b86d171</data>
    </node>
    <node id="Event Detection Subtask">
      <data key="d0">Event Detection Subtask</data>
      <data key="d1">category</data>
      <data key="d2">A subtask within event extraction benchmarks focused on identifying occurrences and boundaries of event mentions in text.</data>
      <data key="d3">chunk-729f27491ada48b04fdb73922b86d171</data>
    </node>
    <node id="Event Classification Subtask">
      <data key="d0">Event Classification Subtask</data>
      <data key="d1">category</data>
      <data key="d2">A subtask in event extraction focused on assigning semantic categories to detected event expressions.</data>
      <data key="d3">chunk-729f27491ada48b04fdb73922b86d171</data>
    </node>
    <node id="Event Extent Subtask">
      <data key="d0">Event Extent Subtask</data>
      <data key="d1">category</data>
      <data key="d2">A subtask that measures the system's ability to accurately delimit the exact textual span or boundary of an event mention.</data>
      <data key="d3">chunk-729f27491ada48b04fdb73922b86d171</data>
    </node>
    <node id="WASSA 2017 Emotion Intensity Shared Task">
      <data key="d0">WASSA 2017 Emotion Intensity Shared Task</data>
      <data key="d1">event</data>
      <data key="d2">The WASSA 2017 Emotion Intensity Shared Task (EmoInt-2017) is an academic competitive evaluation task where systems automatically determine the degree or intensity of emotions expressed in tweets.</data>
      <data key="d3">chunk-b929f54fb0080794be4ecee79e383e83</data>
    </node>
    <node id="Event Detection and Classification">
      <data key="d0">Event Detection and Classification</data>
      <data key="d1">category</data>
      <data key="d2">A natural language processing task category focused on identifying mentions of events and classifying them according to predefined semantic classes.</data>
      <data key="d3">chunk-b929f54fb0080794be4ecee79e383e83</data>
    </node>
    <node id="Emotion Intensity">
      <data key="d0">Emotion Intensity</data>
      <data key="d1">category</data>
      <data key="d2">An affective computing task category focused on determining real-valued numerical scores representing the degree of emotions such as joy, sadness, fear, or anger in text.&lt;SEP&gt;The core continuous prediction target representing the strength of emotion conveyed in each tweet.</data>
      <data key="d3">chunk-21a91d0fd0db145647734eeea856cd2e&lt;SEP&gt;chunk-b929f54fb0080794be4ecee79e383e83</data>
    </node>
    <node id="Liu">
      <data key="d0">Liu</data>
      <data key="d1">person</data>
      <data key="d2">Liu is a researcher who introduced an attention-based recurrent neural network approach for slot filling in Natural Language Understanding in 2016.&lt;SEP&gt;Liu is a researcher who proposed DetectVC to solve voluntary following issues among collusive followers.</data>
      <data key="d3">chunk-74441bc0683e1fe464f8cf5bd0c14d93&lt;SEP&gt;chunk-b929f54fb0080794be4ecee79e383e83</data>
    </node>
    <node id="Vinyals">
      <data key="d0">Vinyals</data>
      <data key="d1">person</data>
      <data key="d2">Researcher referenced regarding a global intra-sentence attentional component formulation.&lt;SEP&gt;Vinyals is a researcher known for attentional models in parsing and grammar, whose work informed the intra-sentence attention component used in EmoAtt.</data>
      <data key="d3">chunk-21a91d0fd0db145647734eeea856cd2e&lt;SEP&gt;chunk-b929f54fb0080794be4ecee79e383e83</data>

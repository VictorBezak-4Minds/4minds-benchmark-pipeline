    <node id="Mayo Clinic">
      <data key="d0">Mayo Clinic</data>
      <data key="d1">organization</data>
      <data key="d2">A renowned medical institution whose clinical notes and pathology reports were utilized for clinical information extraction research.&lt;SEP&gt;Mayo Clinic is a medical center that provided clinical notes and pathology reports from cancer patients and de-identified the records for research.</data>
      <data key="d3">chunk-dcb2d684d656e9d9c24124949d2aaf80&lt;SEP&gt;chunk-db96a568a81e93ae0f5b620a7d452203</data>
    </node>
    <node id="BluLab">
      <data key="d0">BluLab</data>
      <data key="d1">organization</data>
      <data key="d2">A research group or system developer that built supervised classifiers for clinical information extraction using cTAKES features.&lt;SEP&gt;BluLab is a research group or system that developed an extraction system utilizing morphological, lexical, and syntactic features from cTAKES.</data>
      <data key="d3">chunk-dcb2d684d656e9d9c24124949d2aaf80&lt;SEP&gt;chunk-26c91c9a531d8aea5394e79e584448ff</data>
    </node>
    <node id="Clinical Information Extraction">
      <data key="d0">Clinical Information Extraction</data>
      <data key="d1">category</data>
      <data key="d2">A biomedical natural language processing domain focused on identifying event expressions, spans, and attributes from raw clinical notes and pathology reports.&lt;SEP&gt;Clinical Information Extraction is the natural language processing domain focused on capturing key medical information, event mentions, and attributes from raw clinical notes.&lt;SEP&gt;The domain and task of automatically identifying entities, clinical events, time expressions, and temporal relations from clinical notes and electronic health records.</data>
      <data key="d3">chunk-dcb2d684d656e9d9c24124949d2aaf80&lt;SEP&gt;chunk-26c91c9a531d8aea5394e79e584448ff&lt;SEP&gt;chunk-db96a568a81e93ae0f5b620a7d452203</data>
    </node>
    <node id="Apache">
      <data key="d0">Apache</data>
      <data key="d1">organization</data>
      <data key="d2">An open-source software foundation whose clinical Text Analysis and Knowledge Extraction System (cTAKES) is used to generate linguistic features for clinical extraction.&lt;SEP&gt;Apache is an open-source software foundation that provides tools including the clinical Text Analysis and Knowledge Extraction System (cTAKES).</data>
      <data key="d3">chunk-dcb2d684d656e9d9c24124949d2aaf80&lt;SEP&gt;chunk-26c91c9a531d8aea5394e79e584448ff</data>
    </node>
    <node id="Language Modeling">
      <data key="d0">Language Modeling</data>
      <data key="d1">category</data>
      <data key="d2">A core natural language processing task that predicts words in sequence and evaluates linguistic fluency.&lt;SEP&gt;A fundamental natural language processing task involving predicting sequences of words, mentioned in the context of neural networks and LSTM architectures.&lt;SEP&gt;Language Modeling is a foundational NLP category involving self-supervised pre-training and fine-tuning of neural representations to capture linguistic syntax and semantics.</data>
      <data key="d3">chunk-dcb2d684d656e9d9c24124949d2aaf80&lt;SEP&gt;chunk-47f43d3218257ab88ccde621eadece2c&lt;SEP&gt;chunk-5e8ad7bf1880d82f40811c2078046e6b</data>
    </node>
    <node id="Named Entity Recognition">
      <data key="d0">Named Entity Recognition</data>
      <data key="d1">category</data>
      <data key="d2">A fundamental natural language processing task aimed at identifying and classifying entity mentions in text.&lt;SEP&gt;A natural language processing subtask focused on identifying and classifying entities in text, heavily influenced by name variants.&lt;SEP&gt;A natural language processing task (NER) focused on identifying and classifying named entities in unstructured text.&lt;SEP&gt;A natural language processing task that identifies and classifies named entities in text, often used as a framing for text-based attribute extraction.&lt;SEP&gt;A subtask of information extraction that identifies entities such as names, locations, times, diseases, and symptoms from text.&lt;SEP&gt;An information extraction sub-task category focused on identifying and classifying specific named entities, such as diseases and symptoms, typically formulated as sequence tagging.&lt;SEP&gt;Named Entity Recognition (NER) is an information extraction technique used to locate person entities for anonymization.&lt;SEP&gt;Named entity recognition is a fundamental subtask of information extraction in natural language processing aimed at locating and classifying key medical or textual entities.</data>
      <data key="d3">chunk-ef7b95a2f35faad97942f87543b7ab1f&lt;SEP&gt;chunk-57acb1a29c2b86c001f999352f15c3cc&lt;SEP&gt;chunk-dcb2d684d656e9d9c24124949d2aaf80&lt;SEP&gt;chunk-cfda2df27b2b2e8e0d65e1812ca700fd&lt;SEP&gt;chunk-f717f876f65432fa813fac20ad6a7ddb&lt;SEP&gt;chunk-f76f1c0c2ed37a786263a6a6d8b0bb6d&lt;SEP&gt;chunk-f1fb2eeb8c8333a70050efefb9412104&lt;SEP&gt;chunk-236f5016d3aa81277cabc5c947f1ca64</data>
    </node>
    <node id="Part-Of-Speech Tagging">
      <data key="d0">Part-Of-Speech Tagging</data>
      <data key="d1">category</data>
      <data key="d2">A linguistic annotation process that assigns grammatical categories (such as nouns and verbs) to words in a corpus, used to enrich word representations.&lt;SEP&gt;A linguistic annotation task that assigns grammatical tags to words, used as contextual features in neural clinical information extraction.&lt;SEP&gt;Part-Of-Speech Tagging is a natural language processing task that labels words in a text with their corresponding grammatical categories.&lt;SEP&gt;Part-of-speech tagging is a foundational natural language processing task that labels words in a text with their syntactic grammatical categories.</data>
      <data key="d3">chunk-dcb2d684d656e9d9c24124949d2aaf80&lt;SEP&gt;chunk-26c91c9a531d8aea5394e79e584448ff&lt;SEP&gt;chunk-236f5016d3aa81277cabc5c947f1ca64&lt;SEP&gt;chunk-5e8ad7bf1880d82f40811c2078046e6b</data>
    </node>
    <node id="Semantic Role Labeling">
      <data key="d0">Semantic Role Labeling</data>
      <data key="d1">category</data>
      <data key="d2">A linguistic analysis technique used to identify the predicate-argument structure and semantic roles within sentences.&lt;SEP&gt;An NLP task that identifies the predicate-argument structures of sentences to understand semantic relations.</data>
      <data key="d3">chunk-dcb2d684d656e9d9c24124949d2aaf80&lt;SEP&gt;chunk-18770431e1f17cd9efc7aedcdb98d303</data>
    </node>
    <node id="Information Retrieval">
      <data key="d0">Information Retrieval</data>
      <data key="d1">category</data>
      <data key="d2">A computational technique applied to query domain-specific vocabulary across comparable corpora using search engine tools like Lucene.&lt;SEP&gt;A computing discipline and high-level NLP task concerned with obtaining relevant information from textual resources.&lt;SEP&gt;Information retrieval is the field of computer science from which evaluation metrics like precision, recall, and the F score originate.&lt;SEP&gt;The process and field of finding and obtaining relevant information resources from a large collection of data.</data>
      <data key="d3">chunk-dcb2d684d656e9d9c24124949d2aaf80&lt;SEP&gt;chunk-cb73055a3a263fcef16382513853f022&lt;SEP&gt;chunk-3f37521f7c9c4230a9fe0c9f8b7f1604&lt;SEP&gt;chunk-116526d304daa442dbc1df519e7f8fc5</data>
    </node>
    <node id="Event Span Identification">
      <data key="d0">Event Span Identification</data>
      <data key="d1">category</data>
      <data key="d2">Event Span Identification is the subtask of extracting character offsets of event expressions from clinical notes, essential for subsequent attribute classification.</data>
      <data key="d3">chunk-26c91c9a531d8aea5394e79e584448ff</data>
    </node>
    <node id="Temporal Convolutional Neural Network">
      <data key="d0">Temporal Convolutional Neural Network</data>
      <data key="d1">category</data>
      <data key="d2">A deep learning architecture employed to learn hidden feature representations from raw text and basic linguistic annotations for clinical event span identification.&lt;SEP&gt;Temporal Convolutional Neural Network is a deep learning architecture utilizing one-dimensional convolution across sequence inputs to learn feature representations from text.</data>
      <data key="d3">chunk-26c91c9a531d8aea5394e79e584448ff&lt;SEP&gt;chunk-db96a568a81e93ae0f5b620a7d452203</data>
    </node>
    <node id="Time Delay Neural Networks">
      <data key="d0">Time Delay Neural Networks</data>
      <data key="d1">category</data>
      <data key="d2">Time Delay Neural Networks (TDNNs) are neural network models based on 1D convolution operations across temporal or sequential inputs.</data>
      <data key="d3">chunk-26c91c9a531d8aea5394e79e584448ff</data>
    </node>
    <node id="cTAKES">
      <data key="d0">cTAKES</data>
      <data key="d1">category</data>
      <data key="d2">The Apache clinical Text Analysis and Knowledge Extraction System (cTAKES) is a domain-specific natural language processing system designed for clinical feature extraction.&lt;SEP&gt;cTAKES is a specialized clinical natural language processing and feature extraction toolkit used for biomedical text analysis.</data>
      <data key="d3">chunk-26c91c9a531d8aea5394e79e584448ff&lt;SEP&gt;chunk-db96a568a81e93ae0f5b620a7d452203</data>
    </node>
    <node id="NLTK">
      <data key="d0">NLTK</data>
      <data key="d1">organization</data>
      <data key="d2">NLTK (Natural Language Toolkit) is an organization and open-source project providing natural language processing components utilized for developing unigram models.&lt;SEP&gt;NLTK (Natural Language Toolkit) is an organization and software project providing natural language processing tools used to filter low-content adjectives from Clarifai image labels.&lt;SEP&gt;Natural Language Toolkit (NLTK) is an open-source development project and software library providing natural language processing modules such as tokenizers and POS taggers.</data>
      <data key="d3">chunk-26c91c9a531d8aea5394e79e584448ff&lt;SEP&gt;chunk-bc715f7f0042435219a9937b5527ecef&lt;SEP&gt;chunk-9539a4c4fcbd235bc0ccbc8f3fd26a81</data>
    </node>
    <node id="RegexpTokenizer">
      <data key="d0">RegexpTokenizer</data>
      <data key="d1">category</data>
      <data key="d2">RegexpTokenizer is a regular expression-based tokenization tool in NLTK used to preserve character offset spans for tokens in clinical notes.</data>
      <data key="d3">chunk-26c91c9a531d8aea5394e79e584448ff</data>
    </node>
    <node id="Event Attribute Identification">
      <data key="d0">Event Attribute Identification</data>
      <data key="d1">category</data>
      <data key="d2">Event Attribute Identification is a clinical information extraction subtask aimed at determining the attributes and values associated with identified event expressions.</data>
      <data key="d3">chunk-26c91c9a531d8aea5394e79e584448ff</data>
    </node>
    <node id="Max Pooling">
      <data key="d0">Max Pooling</data>
      <data key="d1">category</data>
      <data key="d2">Max Pooling is a downsampling operation commonly used in convolutional networks to extract the most prominent feature values across sequences.</data>
      <data key="d3">chunk-26c91c9a531d8aea5394e79e584448ff</data>
    </node>
    <node id="Clinical TempEval">
      <data key="d0">Clinical TempEval</data>
      <data key="d1">event</data>
      <data key="d2">Clinical TempEval is an evaluation challenge and shared task focusing on extracting events, time expressions, and temporal relations from clinical narratives.</data>
      <data key="d3">chunk-db96a568a81e93ae0f5b620a7d452203</data>
    </node>
    <node id="THYME">
      <data key="d0">THYME</data>
      <data key="d1">category</data>
      <data key="d2">A specialized clinical corpus annotated with temporal information used for NLP benchmarking and research.&lt;SEP&gt;THYME (Temporal History of Your Medical Events) refers to a clinical data resource and annotation standard used for temporal relation extraction in the Clinical TempEval challenges.&lt;SEP&gt;THYME is a biomedical project/organization providing temporal clinical data divided into training, development, and testing portions for research evaluations.</data>
      <data key="d3">chunk-7562690242fd78972d67afd148f518b1&lt;SEP&gt;chunk-db96a568a81e93ae0f5b620a7d452203&lt;SEP&gt;chunk-0003df2b872764693025524cf2fd334c</data>
    </node>
    <node id="Lasagne">
      <data key="d0">Lasagne</data>
      <data key="d1">category</data>
      <data key="d2">Lasagne is a deep learning framework utilized to build and train neural network models.</data>
      <data key="d3">chunk-db96a568a81e93ae0f5b620a7d452203</data>
    </node>
    <node id="Glove">
      <data key="d0">Glove</data>
      <data key="d1">category</data>
      <data key="d2">Glove is a word representation model providing pre-trained 300-dimensional word vectors used to initialize neural network embeddings.</data>
      <data key="d3">chunk-db96a568a81e93ae0f5b620a7d452203</data>
    </node>
    <node id="DocTimeRel">
      <data key="d0">DocTimeRel</data>
      <data key="d1">category</data>
      <data key="d2">DocTimeRel is a clinical temporal relation classification subtask focused on determining the temporal relation between an event and the document creation time.</data>
      <data key="d3">chunk-db96a568a81e93ae0f5b620a7d452203</data>
    </node>
    <node id="Anafora">
      <data key="d0">Anafora</data>
      <data key="d1">category</data>
      <data key="d2">Anafora is a text annotation tool and standoff schema format used to distribute event, time, and temporal relation annotations separately from raw clinical text.</data>
      <data key="d3">chunk-db96a568a81e93ae0f5b620a7d452203</data>
    </node>
    <node id="AdaGrad">
      <data key="d0">AdaGrad</data>
      <data key="d1">category</data>
      <data key="d2">AdaGrad is an adaptive gradient optimization algorithm category used to minimize loss functions during resolver model training.&lt;SEP&gt;An adaptive gradient descent optimization algorithm used to update model parameters during training over mini-batches.</data>
      <data key="d3">chunk-e8c71ebe855cec9ba2150fa3ef2be8c9&lt;SEP&gt;chunk-db96a568a81e93ae0f5b620a7d452203</data>
    </node>
    <node id="Softmax Classifier">

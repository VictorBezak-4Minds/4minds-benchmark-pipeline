      <data key="d3">chunk-02f0f311662379cfa30789a001aeb981</data>
    </node>
    <node id="New York Times">
      <data key="d0">New York Times</data>
      <data key="d1">organization</data>
      <data key="d2">The New York Times is a prominent American newspaper whose obituaries and text corpus are used in multiple research studies.&lt;SEP&gt;The New York Times is an American media organization whose Gigaword Corpus is utilized for pre-training event embeddings.</data>
      <data key="d3">chunk-a8fecfb2a0e52c8eb6b888c9cbd44d9c&lt;SEP&gt;chunk-dc1405d1609fdbebb00fe9dd18235f8e</data>
    </node>
    <node id="Stock Prediction">
      <data key="d0">Stock Prediction</data>
      <data key="d1">category</data>
      <data key="d2">Stock Prediction is a financial prediction task category used to evaluate the utility of event embeddings.&lt;SEP&gt;Stock prediction is a financial forecasting task that utilizes event representations, sentiment, and external knowledge to predict market movements such as the S&amp;P 500 index.</data>
      <data key="d3">chunk-a8fecfb2a0e52c8eb6b888c9cbd44d9c&lt;SEP&gt;chunk-c9d3fbec1ae6ff5c0cac8214c21ddda4</data>
    </node>
    <node id="Hard Similarity Task">
      <data key="d0">Hard Similarity Task</data>
      <data key="d1">category</data>
      <data key="d2">Hard Similarity Task is an event similarity evaluation benchmark consisting of event pairs designed with contrasting lexical overlap and semantic similarity.</data>
      <data key="d3">chunk-a8fecfb2a0e52c8eb6b888c9cbd44d9c</data>
    </node>
    <node id="Transitive Sentence Similarity">
      <data key="d0">Transitive Sentence Similarity</data>
      <data key="d1">category</data>
      <data key="d2">An evaluation category focusing on assessing the similarity of transitive sentence pairs.&lt;SEP&gt;Transitive Sentence Similarity is a benchmark evaluation dataset and task consisting of paired transitive sentences to evaluate semantic representations.</data>
      <data key="d3">chunk-a8fecfb2a0e52c8eb6b888c9cbd44d9c&lt;SEP&gt;chunk-c25c713c59d89b362e411f24495aab21</data>
    </node>
    <node id="Compositional Neural Network">
      <data key="d0">Compositional Neural Network</data>
      <data key="d1">category</data>
      <data key="d2">Compositional Neural Network is a baseline model category that computes event representations via concatenation and a two-layer neural network.</data>
      <data key="d3">chunk-a8fecfb2a0e52c8eb6b888c9cbd44d9c</data>
    </node>
    <node id="Averaging Baseline">
      <data key="d0">Averaging Baseline</data>
      <data key="d1">category</data>
      <data key="d2">Averaging Baseline is a model category that represents events as the average of constituent word vectors using GloVe embeddings.</data>
      <data key="d3">chunk-a8fecfb2a0e52c8eb6b888c9cbd44d9c</data>
    </node>
    <node id="Element-wise Multiplicative Composition">
      <data key="d0">Element-wise Multiplicative Composition</data>
      <data key="d1">category</data>
      <data key="d2">Element-wise Multiplicative Composition is a baseline model category that concatenates element-wise multiplications between verbs and subjects/objects.</data>
      <data key="d3">chunk-a8fecfb2a0e52c8eb6b888c9cbd44d9c</data>
    </node>

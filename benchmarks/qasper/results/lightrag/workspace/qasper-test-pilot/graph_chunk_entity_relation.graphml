    <node id="Korean Natural Language Processing">
      <data key="d0">Korean Natural Language Processing</data>
      <data key="d1">category</data>
      <data key="d2">A domain of computational linguistics focused on developing natural language understanding and generation techniques for the Korean language.</data>
      <data key="d3">chunk-c79b21dbff7cd9735a0e14b1f97d11d4</data>
    </node>
    <node id="Spoken Language Understanding">
      <data key="d0">Spoken Language Understanding</data>
      <data key="d1">category</data>
      <data key="d2">A dialogue system component responsible for parsing user utterances and performing slot-filling, often modeled jointly with dialogue state tracking.&lt;SEP&gt;A pipeline module in spoken dialogue systems that extracts user intents and slot-value pairs from user utterances.&lt;SEP&gt;A subfield of natural language processing and dialog systems that handles parsing and intent understanding of spoken user utterances.</data>
      <data key="d3">chunk-c79b21dbff7cd9735a0e14b1f97d11d4&lt;SEP&gt;chunk-785a16b34b0c74a5ee4f9f416976a683&lt;SEP&gt;chunk-45dd962c5b788395b9105c9472288d6f</data>
    </node>
    <node id="Projects for Research and Development of Police Science and Technology">
      <data key="d0">Projects for Research and Development of Police Science and Technology</data>
      <data key="d1">event</data>
      <data key="d2">A research grant program focused on advancing police science and technology under grant PA-J000001-2017-101.</data>
      <data key="d3">chunk-c79b21dbff7cd9735a0e14b1f97d11d4</data>
    </node>
    <node id="Technology Innovation Program">
      <data key="d0">Technology Innovation Program</data>
      <data key="d1">event</data>
      <data key="d2">A research program under project number 10076583 targeting the development of free-running speech recognition technologies for embedded robot systems.</data>
      <data key="d3">chunk-c79b21dbff7cd9735a0e14b1f97d11d4</data>
    </node>
    <node id="Semantic Web Search">
      <data key="d0">Semantic Web Search</data>
      <data key="d1">category</data>
      <data key="d2">An application domain that utilizes structured semantics, summarization, and paraphrasing schemes to enhance web searching.</data>
      <data key="d3">chunk-c79b21dbff7cd9735a0e14b1f97d11d4</data>
    </node>
    <node id="Androutsopoulos">
      <data key="d0">Androutsopoulos</data>
      <data key="d1">person</data>
      <data key="d2">Androutsopoulos is a researcher who studied the generation of natural language sentences in English and Greek from OWL ontologies.</data>
      <data key="d3">chunk-5fa79759ff02333ae3d3a1d802134a1f</data>
    </node>
    <node id="WebNLG">
      <data key="d0">WebNLG</data>
      <data key="d1">event</data>
      <data key="d2">WebNLG is a natural language generation challenge and benchmarking event that spurred research in generating text from Semantic Web data.</data>
      <data key="d3">chunk-5fa79759ff02333ae3d3a1d802134a1f</data>
    </node>
    <node id="OWL">
      <data key="d0">OWL</data>
      <data key="d1">category</data>
      <data key="d2">A formal ontology language standard based on description logics, RDF, and RDF Schema, used to specify Semantic Web ontologies.&lt;SEP&gt;OWL (Web Ontology Language) is a semantic web language used to represent ontologies and formal statements, such as those extracted from the Disease Ontology.&lt;SEP&gt;The Web Ontology Language format used to represent underlying ontology statements and facts for natural language generation.&lt;SEP&gt;Web Ontology Language (OWL) is the de-facto standard ontology representation language for authoring ontologies on the Semantic Web.&lt;SEP&gt;Web Ontology Language, a semantic web language used for authoring rich and complex ontologies and class expressions.&lt;SEP&gt;Web Ontology Language, a semantic web representation standard used to model complex classes, properties, and relationships in knowledge domains.</data>
      <data key="d3">chunk-927600095f9514bfcdfdefa43cf8a474&lt;SEP&gt;chunk-ded262becf3ee747d4ac144ff92895ad&lt;SEP&gt;chunk-5fa79759ff02333ae3d3a1d802134a1f&lt;SEP&gt;chunk-ffe44690fdfc0faa73e0db61f9d33f01&lt;SEP&gt;chunk-6fcb14d19cf40f8290f78e99be61a949&lt;SEP&gt;chunk-aa0a1d40aed971d10ad0f0f2c4938cf4</data>
    </node>
    <node id="LD2NL">
      <data key="d0">LD2NL</data>
      <data key="d1">category</data>
      <data key="d2">LD2NL is an open-source natural language generation framework designed to verbalize RDF, OWL, and SPARQL Semantic Web data into natural language.&lt;SEP&gt;The system or framework responsible for generating natural language verbalizations of Linked Data, SPARQL constructs, and OWL axioms.</data>
      <data key="d3">chunk-a0cfc66c51b34132fd3046873eac6d5f&lt;SEP&gt;chunk-5fa79759ff02333ae3d3a1d802134a1f</data>
    </node>
    <node id="SPARQL2NL">
      <data key="d0">SPARQL2NL</data>
      <data key="d1">category</data>
      <data key="d2">SPARQL2NL is an open-source framework and predecessor verbalization system that uses rules to convert SPARQL queries into natural language, upon which LD2NL builds.</data>
      <data key="d3">chunk-5fa79759ff02333ae3d3a1d802134a1f</data>
    </node>
    <node id="SPARTIQULATION">
      <data key="d0">SPARTIQULATION</data>
      <data key="d1">category</data>
      <data key="d2">SPARTIQULATION is an existing verbalization system that demonstrates the generation of natural language from SPARQL and RDF data for question answering and explanation.</data>
      <data key="d3">chunk-5fa79759ff02333ae3d3a1d802134a1f</data>
    </node>
    <node id="Gatt">
      <data key="d0">Gatt</data>
      <data key="d1">person</data>
      <data key="d2">Gatt is a researcher who co-authored a comprehensive 2017 survey on Natural Language Generation.</data>
      <data key="d3">chunk-5fa79759ff02333ae3d3a1d802134a1f</data>
    </node>
    <node id="Greek">
      <data key="d0">Greek</data>
      <data key="d1">category</data>
      <data key="d2">Greek is a natural language targeted for sentence generation from OWL ontologies by Androutsopoulos.</data>
      <data key="d3">chunk-5fa79759ff02333ae3d3a1d802134a1f</data>
    </node>
    <node id="Description Logic SROIQ(D)">
      <data key="d0">Description Logic SROIQ(D)</data>
      <data key="d1">category</data>
      <data key="d2">SROIQ(D) is a formal description logic equivalent to the expressive foundation of OWL 2 ontologies, providing automated reasoning capabilities.</data>
      <data key="d3">chunk-5fa79759ff02333ae3d3a1d802134a1f</data>
    </node>
    <node id="Albert Einstein">
      <data key="d0">Albert Einstein</data>
      <data key="d1">person</data>
      <data key="d2">Albert Einstein is a historical figure referenced as an example individual in OWL assertional axioms regarding his birth place and birth date.&lt;SEP&gt;Albert Einstein is a renowned physicist used as a subject in example RDF triples and natural language verbalizations.&lt;SEP&gt;Albert Einstein is a renowned scientist referenced as an example individual born in Ulm in an RDF triple statement.&lt;SEP&gt;Albert Einstein is a renowned scientist whose birthplace is Ulm, place of death is Princeton, and who is known for general relativity; he serves as an example in RDF verbalization and subject grouping.</data>
      <data key="d3">chunk-a3ee8b1cb5d53b80c036359afaef1e68&lt;SEP&gt;chunk-c2d360f60388ef1a52b18c89e029ef44&lt;SEP&gt;chunk-bb5e43262e5e845585236177cb906ef7&lt;SEP&gt;chunk-5454e5b20bde9e381fa3cda34f91dec7</data>
    </node>
    <node id="Ulm">
      <data key="d0">Ulm</data>
      <data key="d1">geo</data>
      <data key="d2">Ulm is a city identified as the birth place of Albert Einstein in the RDF verbalization examples.&lt;SEP&gt;Ulm is a city identified as the birth place of Albert Einstein in the ontology example.&lt;SEP&gt;Ulm is a city identified as the birthplace of Albert Einstein.&lt;SEP&gt;Ulm is a city referenced as the birthplace of Albert Einstein in knowledge representation examples.</data>
      <data key="d3">chunk-a3ee8b1cb5d53b80c036359afaef1e68&lt;SEP&gt;chunk-c2d360f60388ef1a52b18c89e029ef44&lt;SEP&gt;chunk-bb5e43262e5e845585236177cb906ef7&lt;SEP&gt;chunk-5454e5b20bde9e381fa3cda34f91dec7</data>
    </node>
    <node id="Spain">
      <data key="d0">Spain</data>
      <data key="d1">geo</data>
      <data key="d2">A European country whose Spanish language dataset showed low annotator agreement and high performance variability.&lt;SEP&gt;Spain is a country referenced in an example ontology class expression describing individuals working at a university located there.&lt;SEP&gt;Spain is referenced in connection with the Spanish language sentiment analysis dataset examined for sentiment class ordering.</data>
      <data key="d3">chunk-2e9d6cd8b1a1f2b1ece006c42d145e4d&lt;SEP&gt;chunk-c2d360f60388ef1a52b18c89e029ef44&lt;SEP&gt;chunk-6b6698485050fd363980b75ae23a237b</data>
    </node>
    <node id="Alice">
      <data key="d0">Alice</data>
      <data key="d1">person</data>
      <data key="d2">Alice is an example individual person used to demonstrate individual representation and property assignment in OWL.</data>
      <data key="d3">chunk-c2d360f60388ef1a52b18c89e029ef44</data>
    </node>
    <node id="Reiter &amp; Dale">
      <data key="d0">Reiter &amp; Dale</data>
      <data key="d1">person</data>
      <data key="d2">Reiter &amp; Dale are researchers who proposed the standard architecture model for natural language generation cited in the text.</data>
      <data key="d3">chunk-c2d360f60388ef1a52b18c89e029ef44</data>
    </node>
    <node id="Animal">
      <data key="d0">Animal</data>
      <data key="d1">category</data>
      <data key="d2">Animal is an ontological class representing the set of all animals, used to demonstrate OWL classes and taxonomic subclass relationships.</data>
      <data key="d3">chunk-c2d360f60388ef1a52b18c89e029ef44</data>
    </node>
    <node id="Koala">
      <data key="d0">Koala</data>
      <data key="d1">category</data>
      <data key="d2">Koala is an ontological class defined as a subclass of Animal in an example of OWL terminological axioms.</data>
      <data key="d3">chunk-c2d360f60388ef1a52b18c89e029ef44</data>
    </node>
    <node id="Person">
      <data key="d0">Person</data>
      <data key="d1">category</data>
      <data key="d2">A named entity category representing individual people, accounting for 457 annotations in the analyzed Turkish tweet dataset.&lt;SEP&gt;Person is an atomic class and semantic category in OWL ontologies, used in class expressions and subclass axioms.&lt;SEP&gt;Person is an ontological class representing individuals, used to illustrate lexicalization into natural language terms like 'people'.</data>
      <data key="d3">chunk-731ed10b120fb04a1b73bc728f12beb5&lt;SEP&gt;chunk-c2d360f60388ef1a52b18c89e029ef44&lt;SEP&gt;chunk-bb5e43262e5e845585236177cb906ef7</data>
    </node>
    <node id="Professor">
      <data key="d0">Professor</data>
      <data key="d1">category</data>
      <data key="d2">Professor is an ontological category representing an academic occupation, used in the text to illustrate class expressions where professors work at a university.</data>
      <data key="d3">chunk-c2d360f60388ef1a52b18c89e029ef44</data>
    </node>
    <node id="University">
      <data key="d0">University</data>
      <data key="d1">organization</data>
      <data key="d2">University represents academic institutions where professors work and which can be geographically located in countries such as Spain.</data>
      <data key="d3">chunk-c2d360f60388ef1a52b18c89e029ef44</data>
    </node>
    <node id="Scientist">
      <data key="d0">Scientist</data>
      <data key="d1">category</data>
      <data key="d2">A profession and classification category applied to Albert Einstein in the ontology and triple examples.&lt;SEP&gt;Scientist is a professional category referenced in an example SPARQL query targeting individuals who were born in Ulm.&lt;SEP&gt;Scientist is an atomic class and category used to illustrate a terminological subclass axiom.&lt;SEP&gt;Scientist is an occupational category attributed to Albert Einstein in the triple verbalization example.</data>
      <data key="d3">chunk-a3ee8b1cb5d53b80c036359afaef1e68&lt;SEP&gt;chunk-c2d360f60388ef1a52b18c89e029ef44&lt;SEP&gt;chunk-bb5e43262e5e845585236177cb906ef7&lt;SEP&gt;chunk-5454e5b20bde9e381fa3cda34f91dec7</data>
    </node>
    <node id="Reiter">
      <data key="d0">Reiter</data>
      <data key="d1">person</data>
      <data key="d2">Reiter is a computer scientist and researcher who, along with Dale, proposed the standard model for natural language generation.</data>
      <data key="d3">chunk-c2d360f60388ef1a52b18c89e029ef44</data>
    </node>
    <node id="Dale">
      <data key="d0">Dale</data>
      <data key="d1">person</data>
      <data key="d2">Dale is a computer scientist and researcher who co-authored the standard natural language generation architecture cited in the LD2NL framework.</data>
      <data key="d3">chunk-c2d360f60388ef1a52b18c89e029ef44</data>
    </node>
    <node id="Terminological Axiom">
      <data key="d0">Terminological Axiom</data>
      <data key="d1">category</data>
      <data key="d2">Terminological axioms are a category of ontology statements that describe domain structures, class hierarchies, and relationships between classes.</data>
      <data key="d3">chunk-c2d360f60388ef1a52b18c89e029ef44</data>
    </node>
    <node id="Assertional Axiom">
      <data key="d0">Assertional Axiom</data>
      <data key="d1">category</data>
      <data key="d2">Assertional axioms are a category of ontology statements that assert concrete facts about individual entities, their class memberships, and properties.</data>
      <data key="d3">chunk-c2d360f60388ef1a52b18c89e029ef44</data>
    </node>
    <node id="Object Property">
      <data key="d0">Object Property</data>
      <data key="d1">category</data>
      <data key="d2">Object property is an ontological category representing binary relations between individuals, such as childOf.</data>
      <data key="d3">chunk-c2d360f60388ef1a52b18c89e029ef44</data>
    </node>
    <node id="Data Property">
      <data key="d0">Data Property</data>
      <data key="d1">category</data>
      <data key="d2">Data property is an ontological category that links an individual entity to a specific data value, such as birthDate.</data>
      <data key="d3">chunk-c2d360f60388ef1a52b18c89e029ef44</data>
    </node>
    <node id="Query Form">
      <data key="d0">Query Form</data>
      <data key="d1">category</data>
      <data key="d2">Query forms represent categories of SPARQL queries used to retrieve or construct RDF graphs, consisting of SELECT, CONSTRUCT, ASK, and DESCRIBE.</data>
      <data key="d3">chunk-c2d360f60388ef1a52b18c89e029ef44</data>
    </node>
    <node id="Nathan Rosen">
      <data key="d0">Nathan Rosen</data>
      <data key="d1">person</data>
      <data key="d2">Nathan Rosen is a physicist cited in an example RDF triple as being influenced by Albert Einstein.</data>
      <data key="d3">chunk-5454e5b20bde9e381fa3cda34f91dec7</data>
    </node>
    <node id="William Shakespeare">
      <data key="d0">William Shakespeare</data>
      <data key="d1">person</data>
      <data key="d2">William Shakespeare is a famous writer used as an example subject in RDF triple verbalization and sentence ordering.&lt;SEP&gt;William Shakespeare is an English writer who died on 23 April 1616, used as an example in RDF triple verbalization.</data>
      <data key="d3">chunk-a3ee8b1cb5d53b80c036359afaef1e68&lt;SEP&gt;chunk-5454e5b20bde9e381fa3cda34f91dec7</data>
    </node>
    <node id="Princeton">
      <data key="d0">Princeton</data>
      <data key="d1">geo</data>
      <data key="d2">Princeton is a location identified as the death place of Albert Einstein in the RDF verbalization examples.&lt;SEP&gt;Princeton is a location identified as the death place of Albert Einstein.</data>
      <data key="d3">chunk-a3ee8b1cb5d53b80c036359afaef1e68&lt;SEP&gt;chunk-5454e5b20bde9e381fa3cda34f91dec7</data>
    </node>
    <node id="Writer">
      <data key="d0">Writer</data>
      <data key="d1">category</data>
      <data key="d2">A profession and classification category applied to William Shakespeare.&lt;SEP&gt;Writer is an occupational category attributed to William Shakespeare in the triple verbalization example.</data>
      <data key="d3">chunk-a3ee8b1cb5d53b80c036359afaef1e68&lt;SEP&gt;chunk-5454e5b20bde9e381fa3cda34f91dec7</data>
    </node>
    <node id="LD2NL Framework">
      <data key="d0">LD2NL Framework</data>
      <data key="d1">category</data>
      <data key="d2">LD2NL Framework is a natural language generation framework designed to transform RDF graphs and triples into natural language text.</data>
      <data key="d3">chunk-5454e5b20bde9e381fa3cda34f91dec7</data>
    </node>
    <node id="RDF Graph">
      <data key="d0">RDF Graph</data>
      <data key="d1">category</data>
      <data key="d2">A graph-based data model representing semantic web data through subjects, predicates, objects, and literals.</data>
      <data key="d3">chunk-5454e5b20bde9e381fa3cda34f91dec7</data>
    </node>
    <node id="Literal">
      <data key="d0">Literal</data>
      <data key="d1">category</data>
      <data key="d2">A data value in an RDF graph consisting of a lexical form and a datatype IRI, optionally including a language tag.</data>
      <data key="d3">chunk-5454e5b20bde9e381fa3cda34f91dec7</data>
    </node>
    <node id="Triple Realization">
      <data key="d0">Triple Realization</data>
      <data key="d1">category</data>
      <data key="d2">The process of transforming individual RDF triples into grammatical natural language sentences within the LD2NL framework.</data>
      <data key="d3">chunk-5454e5b20bde9e381fa3cda34f91dec7</data>
    </node>
    <node id="Clustering And Ordering">
      <data key="d0">Clustering And Ordering</data>
      <data key="d1">category</data>
      <data key="d2">A stage of transformation rules in natural language generation that organizes verbalized sentences by frequency and subject coherence before grouping.</data>
      <data key="d3">chunk-5454e5b20bde9e381fa3cda34f91dec7</data>
    </node>
    <node id="Grouping">
      <data key="d0">Grouping</data>
      <data key="d1">category</data>
      <data key="d2">A transformation step following clustering and ordering designed to aggregate sentences and reduce redundant information.</data>
      <data key="d3">chunk-5454e5b20bde9e381fa3cda34f91dec7</data>
    </node>
    <node id="Benjamin Franklin">
      <data key="d0">Benjamin Franklin</data>
      <data key="d1">person</data>
      <data key="d2">Benjamin Franklin is a historical figure born in Boston, referenced in an example illustrating object grouping.</data>
      <data key="d3">chunk-a3ee8b1cb5d53b80c036359afaef1e68</data>
    </node>
    <node id="Leonard Nimoy">
      <data key="d0">Leonard Nimoy</data>
      <data key="d1">person</data>
      <data key="d2">Leonard Nimoy is a figure born in Boston, referenced in an example illustrating object grouping.</data>
      <data key="d3">chunk-a3ee8b1cb5d53b80c036359afaef1e68</data>
    </node>
    <node id="Boston">
      <data key="d0">Boston</data>
      <data key="d1">geo</data>
      <data key="d2">Boston is a city cited in the text as an example of a topic-specific entity term excluded from general n-grams.&lt;SEP&gt;Boston is a city identified as the birthplace of both Benjamin Franklin and Leonard Nimoy.&lt;SEP&gt;Boston is a major American city referenced in relation to the Boston Marathon bombings and the Boston Red Sox.</data>
      <data key="d3">chunk-652b9cdc03c6ea8c4e866d6c6a6062ca&lt;SEP&gt;chunk-f0e231c4e3067b98ab534052d00f25e1&lt;SEP&gt;chunk-a3ee8b1cb5d53b80c036359afaef1e68</data>
    </node>
    <node id="Dalianishovy">
      <data key="d0">Dalianishovy</data>
      <data key="d1">person</data>
      <data key="d2">Dalianishovy refers to researcher(s) cited for defining grouping as collecting and collapsing clauses with common elements.</data>
      <data key="d3">chunk-a3ee8b1cb5d53b80c036359afaef1e68</data>
    </node>
    <node id="General Relativity">
      <data key="d0">General Relativity</data>
      <data key="d1">category</data>
      <data key="d2">A fundamental theory in physics for which Albert Einstein is known, referenced in the natural language generation example.</data>
      <data key="d3">chunk-a3ee8b1cb5d53b80c036359afaef1e68</data>
    </node>
    <node id="People">
      <data key="d0">People</data>
      <data key="d1">category</data>
      <data key="d2">An ontological class or category representing human individuals, referenced in an example of OWL class expressions.</data>
      <data key="d3">chunk-a3ee8b1cb5d53b80c036359afaef1e68</data>
    </node>
    <node id="OWL Class">
      <data key="d0">OWL Class</data>
      <data key="d1">category</data>
      <data key="d2">A category and conceptual element in OWL 2 ontologies representing an abstract group or collection of individuals.</data>
      <data key="d3">chunk-a3ee8b1cb5d53b80c036359afaef1e68</data>
    </node>
    <node id="Albert Einstein's Birth">
      <data key="d0">Albert Einstein's Birth</data>
      <data key="d1">event</data>
      <data key="d2">The historical event of the birth of Albert Einstein, which took place in Ulm.</data>
      <data key="d3">chunk-a3ee8b1cb5d53b80c036359afaef1e68</data>
    </node>
    <node id="Albert Einstein's Death">
      <data key="d0">Albert Einstein's Death</data>
      <data key="d1">event</data>
      <data key="d2">The historical event of the death of Albert Einstein, which took place in Princeton.</data>
      <data key="d3">chunk-a3ee8b1cb5d53b80c036359afaef1e68</data>
    </node>
    <node id="William Shakespeare's Death">
      <data key="d0">William Shakespeare's Death</data>
      <data key="d1">event</data>
      <data key="d2">The historical event marking the death of writer William Shakespeare on 23 April 1616.</data>
      <data key="d3">chunk-a3ee8b1cb5d53b80c036359afaef1e68</data>
    </node>
    <node id="Benjamin Franklin's Birth">
      <data key="d0">Benjamin Franklin's Birth</data>
      <data key="d1">event</data>
      <data key="d2">The historical event of Benjamin Franklin being born, which occurred in Boston.</data>
      <data key="d3">chunk-a3ee8b1cb5d53b80c036359afaef1e68</data>
    </node>
    <node id="Leonard Nimoy's Birth">
      <data key="d0">Leonard Nimoy's Birth</data>
      <data key="d1">event</data>
      <data key="d2">The historical event of Leonard Nimoy being born, which occurred in Boston.</data>
      <data key="d3">chunk-a3ee8b1cb5d53b80c036359afaef1e68</data>
    </node>
    <node id="City">
      <data key="d0">City</data>
      <data key="d1">category</data>
      <data key="d2">City is an atomic class and category in OWL ontologies used in complex class expressions.</data>
      <data key="d3">chunk-bb5e43262e5e845585236177cb906ef7</data>
    </node>
    <node id="Assertional Axioms">
      <data key="d0">Assertional Axioms</data>
      <data key="d1">category</data>
      <data key="d2">Assertional Axioms (ABox Axioms) are a category of OWL axioms that state facts about individuals, such as their types and property values.</data>
      <data key="d3">chunk-bb5e43262e5e845585236177cb906ef7</data>
    </node>
    <node id="Terminological Axioms">
      <data key="d0">Terminological Axioms</data>
      <data key="d1">category</data>
      <data key="d2">Terminological Axioms (TBox Axioms) are a category of OWL axioms that express relationships between conceptual classes, such as subclass relations.</data>
      <data key="d3">chunk-bb5e43262e5e845585236177cb906ef7</data>
    </node>
    <node id="Power">
      <data key="d0">Power</data>
      <data key="d1">person</data>
      <data key="d2">Power is a researcher cited in the text regarding findings that most terminological axioms in ontologies are subclass axioms.</data>
      <data key="d3">chunk-bb5e43262e5e845585236177cb906ef7</data>
    </node>
    <node id="OWL Class Expressions">
      <data key="d0">OWL Class Expressions</data>
      <data key="d1">category</data>
      <data key="d2">OWL Class Expressions are a category of description logic constructs that define concepts or complex conditions in Web Ontology Language.</data>
      <data key="d3">chunk-bb5e43262e5e845585236177cb906ef7</data>
    </node>
    <node id="Subclass Axioms">
      <data key="d0">Subclass Axioms</data>
      <data key="d1">category</data>
      <data key="d2">Subclass Axioms are a category of terminological axioms asserting that all instances of a subclass belong to a superclass.</data>
      <data key="d3">chunk-bb5e43262e5e845585236177cb906ef7</data>
    </node>
    <node id="Atomic Classes">
      <data key="d0">Atomic Classes</data>
      <data key="d1">category</data>
      <data key="d2">Atomic Classes are basic, named concept categories in ontologies that serve as the foundational building blocks for complex class expressions.</data>
      <data key="d3">chunk-bb5e43262e5e845585236177cb906ef7</data>
    </node>
    <node id="Existential Restrictions">
      <data key="d0">Existential Restrictions</data>
      <data key="d1">category</data>
      <data key="d2">Existential Restrictions are a category of OWL class expressions specifying that individuals must have at least one relationship to members of a given class.</data>
      <data key="d3">chunk-bb5e43262e5e845585236177cb906ef7</data>
    </node>
    <node id="SPARQL SELECT Query">
      <data key="d0">SPARQL SELECT Query</data>
      <data key="d1">category</data>
      <data key="d2">SPARQL SELECT Query is a category of graph query consisting of a body section, an optional section, and a modifier section.</data>
      <data key="d3">chunk-bb5e43262e5e845585236177cb906ef7</data>
    </node>
    <node id="Domain Experts">
      <data key="d0">Domain Experts</data>
      <data key="d1">category</data>
      <data key="d2">A group of 66 evaluation participants with specialized knowledge who evaluated OWL axiom verbalizations and RDF resource summaries.&lt;SEP&gt;Subject-matter specialists with knowledge in semantic web formalisms who evaluated generated natural language sentences.</data>
      <data key="d3">chunk-a0cfc66c51b34132fd3046873eac6d5f&lt;SEP&gt;chunk-927600095f9514bfcdfdefa43cf8a474</data>
    </node>
    <node id="Non-Experts">
      <data key="d0">Non-Experts</data>
      <data key="d1">category</data>
      <data key="d2">A group of 20 volunteer evaluators without specialized domain knowledge who participated in evaluating fluency and instance identification.</data>
      <data key="d3">chunk-a0cfc66c51b34132fd3046873eac6d5f</data>
    </node>
    <node id="OWL Axiom Verbalization Experiment">
      <data key="d0">OWL Axiom Verbalization Experiment</data>
      <data key="d1">event</data>
      <data key="d2">The first evaluation experiment in which domain experts rated the adequacy and fluency of verbalized OWL axioms from the Koala ontology.</data>
      <data key="d3">chunk-a0cfc66c51b34132fd3046873eac6d5f</data>
    </node>
    <node id="RDF Resource Summaries Verbalization Experiment">
      <data key="d0">RDF Resource Summaries Verbalization Experiment</data>
      <data key="d1">event</data>
      <data key="d2">The second evaluation experiment where volunteers evaluated the verbalization of triples describing DBpedia resources based on adequacy, fluency, and completeness.</data>
      <data key="d3">chunk-a0cfc66c51b34132fd3046873eac6d5f</data>
    </node>
    <node id="Class Instance Identification Experiment">
      <data key="d0">Class Instance Identification Experiment</data>
      <data key="d1">event</data>
      <data key="d2">The third evaluation experiment where human raters were tasked with identifying class instances based on verbalized OWL class descriptions and resources.</data>
      <data key="d3">chunk-a0cfc66c51b34132fd3046873eac6d5f</data>
    </node>
    <node id="Gardent">
      <data key="d0">Gardent</data>
      <data key="d1">person</data>
      <data key="d2">A researcher cited for establishing the evaluation measures of adequacy and fluency used in natural language generation assessment.</data>
      <data key="d3">chunk-a0cfc66c51b34132fd3046873eac6d5f</data>
    </node>
    <node id="Koala Ontology">
      <data key="d0">Koala Ontology</data>
      <data key="d1">category</data>
      <data key="d2">A well-known benchmark ontology formulated in OWL used in the experiments to evaluate axiom verbalization.</data>
      <data key="d3">chunk-a0cfc66c51b34132fd3046873eac6d5f</data>
    </node>
    <node id="OWL Axioms">
      <data key="d0">OWL Axioms</data>
      <data key="d1">category</data>
      <data key="d2">Formal logical statements in the Web Ontology Language that express semantic relationships and restrictions within an ontology.</data>
      <data key="d3">chunk-a0cfc66c51b34132fd3046873eac6d5f</data>
    </node>
    <node id="RDF Resources">
      <data key="d0">RDF Resources</data>
      <data key="d1">category</data>
      <data key="d2">Entities and concepts represented in the Resource Description Framework that are subject to summarization and verbalization.</data>
      <data key="d3">chunk-a0cfc66c51b34132fd3046873eac6d5f</data>
    </node>
    <node id="Triple Patterns">
      <data key="d0">Triple Patterns</data>
      <data key="d1">category</data>
      <data key="d2">Core syntactic structures in SPARQL queries composed of subject, predicate, and object elements.</data>
      <data key="d3">chunk-a0cfc66c51b34132fd3046873eac6d5f</data>
    </node>
    <node id="Stanford Dependencies">
      <data key="d0">Stanford Dependencies</data>
      <data key="d1">category</data>
      <data key="d2">A grammatical dependency representation framework whose vocabulary is extended and used to formulate realization rules.</data>
      <data key="d3">chunk-a0cfc66c51b34132fd3046873eac6d5f</data>
    </node>
    <node id="Variables">
      <data key="d0">Variables</data>
      <data key="d1">category</data>
      <data key="d2">The set of variable identifiers used within SPARQL queries to represent unbound terms in graph patterns.</data>
      <data key="d3">chunk-a0cfc66c51b34132fd3046873eac6d5f</data>
    </node>
    <node id="Properties">
      <data key="d0">Properties</data>
      <data key="d1">category</data>
      <data key="d2">The set of semantic relations and predicates contained in target knowledge bases that link resources.</data>
      <data key="d3">chunk-a0cfc66c51b34132fd3046873eac6d5f</data>
    </node>
    <node id="Literals">
      <data key="d0">Literals</data>
      <data key="d1">category</data>
      <data key="d2">The set of concrete data values such as strings and numbers contained in target knowledge bases.</data>
      <data key="d3">chunk-a0cfc66c51b34132fd3046873eac6d5f</data>
    </node>
    <node id="German Federal Ministry of Economics and Technology">
      <data key="d0">German Federal Ministry of Economics and Technology</data>
      <data key="d1">organization</data>
      <data key="d2">A German federal ministry (BMWI) that supported semantic web research through the RAKI project.</data>
      <data key="d3">chunk-927600095f9514bfcdfdefa43cf8a474</data>
    </node>
    <node id="BMBF">
      <data key="d0">BMBF</data>
      <data key="d1">organization</data>
      <data key="d2">The German Federal Ministry of Education and Research, which supported research through the SOLIDE project.</data>
      <data key="d3">chunk-927600095f9514bfcdfdefa43cf8a474</data>
    </node>
    <node id="African Languages">
      <data key="d0">African Languages</data>
      <data key="d1">category</data>
      <data key="d2">A broad category of diverse, low-resourced languages that lack extensive benchmarks, datasets, and machine translation attention.&lt;SEP&gt;A broad group of low-resourced indigenous languages in Africa facing challenges such as low discoverability, lack of benchmarks, and limited machine translation resources.&lt;SEP&gt;A group of over 2,000 diverse and predominantly low-resourced languages spoken across the African continent.</data>
      <data key="d3">chunk-f50b15c876beec2eae8bf6437e8409aa&lt;SEP&gt;chunk-927600095f9514bfcdfdefa43cf8a474&lt;SEP&gt;chunk-fe3fb6b107774e12d36226865853669d</data>
    </node>
    <node id="Semantic Web Languages">
      <data key="d0">Semantic Web Languages</data>
      <data key="d1">category</data>
      <data key="d2">Formal knowledge representation languages, including RDF, OWL, and SPARQL, evaluated for natural language verbalization.</data>
      <data key="d3">chunk-927600095f9514bfcdfdefa43cf8a474</data>
    </node>
    <node id="Project LIMBO">
      <data key="d0">Project LIMBO</data>
      <data key="d1">organization</data>
      <data key="d2">A research project supported by the German Federal Ministry of Transport and Digital Infrastructure (BMVI) under grant number 19F2029I.</data>
      <data key="d3">chunk-927600095f9514bfcdfdefa43cf8a474</data>
    </node>
    <node id="Project OPAL">
      <data key="d0">Project OPAL</data>
      <data key="d1">organization</data>
      <data key="d2">A research project funded by the German Federal Ministry of Transport and Digital Infrastructure (BMVI) under grant number 19F2028A.</data>
      <data key="d3">chunk-927600095f9514bfcdfdefa43cf8a474</data>
    </node>
    <node id="Project RAKI">
      <data key="d0">Project RAKI</data>
      <data key="d1">organization</data>
      <data key="d2">A research initiative supported by the German Federal Ministry of Economics and Technology (BMWI) under grant number 01MD19012D.</data>
      <data key="d3">chunk-927600095f9514bfcdfdefa43cf8a474</data>
    </node>
    <node id="Project SOLIDE">
      <data key="d0">Project SOLIDE</data>
      <data key="d1">organization</data>
      <data key="d2">A research project funded by the German Federal Ministry of Education and Research (BMBF) under grant number 13N14456.</data>
      <data key="d3">chunk-927600095f9514bfcdfdefa43cf8a474</data>
    </node>
    <node id="Experiment I">
      <data key="d0">Experiment I</data>
      <data key="d1">event</data>
      <data key="d2">An experimental evaluation measuring the adequacy and fluency ratings of semantic web verbalizations.</data>
      <data key="d3">chunk-927600095f9514bfcdfdefa43cf8a474</data>
    </node>
    <node id="Experiment II">
      <data key="d0">Experiment II</data>
      <data key="d1">event</data>
      <data key="d2">An experimental evaluation assessing the adequacy, fluency, and completeness of verbalized resource summaries.</data>
      <data key="d3">chunk-927600095f9514bfcdfdefa43cf8a474</data>
    </node>
    <node id="Linguists">
      <data key="d0">Linguists</data>
      <data key="d1">category</data>
      <data key="d2">Non-domain experts specializing in language who evaluated the fluency and grammatical accuracy of verbalized sentences.</data>
      <data key="d3">chunk-927600095f9514bfcdfdefa43cf8a474</data>
    </node>
    <node id="SWRL">
      <data key="d0">SWRL</data>
      <data key="d1">category</data>
      <data key="d2">Semantic Web Rule Language, an ontology rule language targeted for future verbalization work.</data>
      <data key="d3">chunk-927600095f9514bfcdfdefa43cf8a474</data>
    </node>
    <node id="SHACL">
      <data key="d0">SHACL</data>
      <data key="d1">category</data>
      <data key="d2">Shapes Constraint Language, a standard language for validating graph-structured RDF data targeted for future verbalization support.</data>
      <data key="d3">chunk-927600095f9514bfcdfdefa43cf8a474</data>
    </node>
    <node id="Afrikaans">
      <data key="d0">Afrikaans</data>
      <data key="d1">category</data>
      <data key="d2">A South African language evaluated in the neural machine translation experiments with a comparatively larger dataset.&lt;SEP&gt;Afrikaans is a South African language included in the Autshumato parallel datasets and evaluated with neural machine translation models.&lt;SEP&gt;Afrikaans is a non-agglutinative language evaluated in the translation study that attained reasonable translation performance despite having fewer parallel sentences.&lt;SEP&gt;An analytic West-Germanic language descended from Dutch settlers in South Africa, addressed in machine translation experiments.&lt;SEP&gt;An official South African language included in neural machine translation model training from English.</data>
      <data key="d3">chunk-ddef736560bcb899db81b75205f4df60&lt;SEP&gt;chunk-927600095f9514bfcdfdefa43cf8a474&lt;SEP&gt;chunk-f50b15c876beec2eae8bf6437e8409aa&lt;SEP&gt;chunk-fe3fb6b107774e12d36226865853669d&lt;SEP&gt;chunk-5f2d07efa6f5f4a54b6cbbdd93f071bc</data>
    </node>
    <node id="isiZulu">
      <data key="d0">isiZulu</data>
      <data key="d1">category</data>
      <data key="d2">A Southern Bantu and Nguni language, being the second most spoken language in Southern Africa, recognized for high morphological complexity.&lt;SEP&gt;An indigenous South African language identified in the study as having very limited, lower-quality dataset resources.&lt;SEP&gt;An official South African language modeled in neural machine translation experiments.&lt;SEP&gt;IsiZulu is an agglutinative language evaluated in the neural machine translation study, exhibiting low BLEU scores due to high morphological complexity and small dataset size.&lt;SEP&gt;isiZulu is a South African target language evaluated in the translation experiments, noted for having low-quality parallel corpora and morphological complexity.</data>
      <data key="d3">chunk-ddef736560bcb899db81b75205f4df60&lt;SEP&gt;chunk-927600095f9514bfcdfdefa43cf8a474&lt;SEP&gt;chunk-f50b15c876beec2eae8bf6437e8409aa&lt;SEP&gt;chunk-fe3fb6b107774e12d36226865853669d&lt;SEP&gt;chunk-5f2d07efa6f5f4a54b6cbbdd93f071bc</data>
    </node>
    <node id="Northern Sotho">
      <data key="d0">Northern Sotho</data>
      <data key="d1">category</data>
      <data key="d2">A Southern Bantu language closely related and mutually intelligible with Setswana, also referred to as N. Sotho.&lt;SEP&gt;An indigenous South African language (also referred to as N. Sotho) identified as having exceptionally small datasets in the study.&lt;SEP&gt;An official South African language evaluated in neural machine translation from English.&lt;SEP&gt;Northern Sotho (referred to as N. Sotho) is an agglutinative language evaluated in the neural machine translation experiments.</data>
      <data key="d3">chunk-f50b15c876beec2eae8bf6437e8409aa&lt;SEP&gt;chunk-927600095f9514bfcdfdefa43cf8a474&lt;SEP&gt;chunk-fe3fb6b107774e12d36226865853669d&lt;SEP&gt;chunk-5f2d07efa6f5f4a54b6cbbdd93f071bc</data>
    </node>
    <node id="Setswana">
      <data key="d0">Setswana</data>
      <data key="d1">category</data>
      <data key="d2">A South African language with a comparatively larger dataset used in the neural machine translation ablation studies.&lt;SEP&gt;A Southern Bantu language closely related to Northern Sotho, targeted for machine translation models.&lt;SEP&gt;An African language analyzed as a target language in translation models and multi-head attention visualizations.&lt;SEP&gt;An official South African language used as a target translation language in neural machine translation experiments.&lt;SEP&gt;Setswana is a South African language included in the Autshumato project's parallel corpora and translation experiments.&lt;SEP&gt;Setswana is an agglutinative language evaluated in the translation experiments, which achieved higher translation performance due to a larger parallel dataset.</data>
      <data key="d3">chunk-ddef736560bcb899db81b75205f4df60&lt;SEP&gt;chunk-927600095f9514bfcdfdefa43cf8a474&lt;SEP&gt;chunk-f50b15c876beec2eae8bf6437e8409aa&lt;SEP&gt;chunk-fe3fb6b107774e12d36226865853669d&lt;SEP&gt;chunk-5f2d07efa6f5f4a54b6cbbdd93f071bc&lt;SEP&gt;chunk-aa0a1d40aed971d10ad0f0f2c4938cf4</data>
    </node>
    <node id="Xitsonga">
      <data key="d0">Xitsonga</data>
      <data key="d1">category</data>
      <data key="d2">A South African language analyzed in the study with higher-quality data showing promising translation performance.&lt;SEP&gt;A Southern Bantu language spoken by the Vatsonga people, originating from Mozambique.&lt;SEP&gt;An official South African language targeted for low-resource translation modeling.&lt;SEP&gt;Xitsonga is a Southern African language evaluated in both prior statistical machine translation research and new neural machine translation models.&lt;SEP&gt;Xitsonga is an agglutinative language included in the translation experiments, achieving relatively high translation performance supported by a larger volume of parallel sentences.</data>
      <data key="d3">chunk-ddef736560bcb899db81b75205f4df60&lt;SEP&gt;chunk-927600095f9514bfcdfdefa43cf8a474&lt;SEP&gt;chunk-f50b15c876beec2eae8bf6437e8409aa&lt;SEP&gt;chunk-fe3fb6b107774e12d36226865853669d&lt;SEP&gt;chunk-5f2d07efa6f5f4a54b6cbbdd93f071bc</data>
    </node>
    <node id="isiXhosa">
      <data key="d0">isiXhosa</data>
      <data key="d1">category</data>
      <data key="d2">An official South African language supported by Google Translate as of February 2019.&lt;SEP&gt;An official South African language supported by translation tools like Google Translate.</data>
      <data key="d3">chunk-927600095f9514bfcdfdefa43cf8a474&lt;SEP&gt;chunk-fe3fb6b107774e12d36226865853669d</data>
    </node>
    <node id="Southern Sotho">
      <data key="d0">Southern Sotho</data>
      <data key="d1">category</data>
      <data key="d2">An official South African language currently supported by tools like Google Translate.&lt;SEP&gt;An official South African language supported by Google Translate as of February 2019.</data>
      <data key="d3">chunk-927600095f9514bfcdfdefa43cf8a474&lt;SEP&gt;chunk-fe3fb6b107774e12d36226865853669d</data>
    </node>
    <node id="South African Centre for Digital Language Resources">
      <data key="d0">South African Centre for Digital Language Resources</data>
      <data key="d1">organization</data>
      <data key="d2">The South African Centre for Digital Language Resources (SADiLaR) is an institute providing an open platform for technologies and digital resources for South African languages.&lt;SEP&gt;The South African Centre for Digital Language Resources is an organization that hosts and provides public downloads for the Autshumato parallel corpora on its website.</data>
      <data key="d3">chunk-ddef736560bcb899db81b75205f4df60&lt;SEP&gt;chunk-fe3fb6b107774e12d36226865853669d</data>
    </node>
    <node id="Southern Africa">
      <data key="d0">Southern Africa</data>
      <data key="d1">geo</data>
      <data key="d2">Southern Africa is a geographic region encompassing countries and indigenous languages including isiZulu, Setswana, and Xitsonga.&lt;SEP&gt;Southern Africa is the geographic region encompassing several low-resource languages that lack extensive machine translation research.</data>
      <data key="d3">chunk-ddef736560bcb899db81b75205f4df60&lt;SEP&gt;chunk-fe3fb6b107774e12d36226865853669d</data>
    </node>
    <node id="Mozambique">
      <data key="d0">Mozambique</data>
      <data key="d1">geo</data>
      <data key="d2">Mozambique is a Southern African country identified as the origin of the Xitsonga language.</data>
      <data key="d3">chunk-fe3fb6b107774e12d36226865853669d</data>
    </node>
    <node id="Google Translate">
      <data key="d0">Google Translate</data>
      <data key="d1">organization</data>
      <data key="d2">A machine translation service provided by Google that supports translations for two additional South African official languages.&lt;SEP&gt;Google Translate is an automated translation service developed by Google used to translate Tamil sentences into English for comparative evaluation.&lt;SEP&gt;Google Translate is an automated translation service offering translation models for several official South African languages.</data>
      <data key="d3">chunk-f50b15c876beec2eae8bf6437e8409aa&lt;SEP&gt;chunk-fe3fb6b107774e12d36226865853669d&lt;SEP&gt;chunk-5fff775482c4d8a3088b428b10d9f761</data>
    </node>
    <node id="Southern Bantu Languages">
      <data key="d0">Southern Bantu Languages</data>
      <data key="d1">category</data>
      <data key="d2">A branch of the Bantu language group characterized by agglutinative structure, rich noun class systems, subject-verb-object word order, and tone, including isiZulu, N. Sotho, Setswana, and Xitsonga.</data>
      <data key="d3">chunk-fe3fb6b107774e12d36226865853669d</data>
    </node>
    <node id="Nguni Language Family">
      <data key="d0">Nguni Language Family</data>
      <data key="d1">category</data>
      <data key="d2">A linguistic subgroup of the Bantu languages to which isiZulu belongs, recognized for its morphological complexity.</data>
      <data key="d3">chunk-fe3fb6b107774e12d36226865853669d</data>
    </node>
    <node id="Vatsonga People">
      <data key="d0">Vatsonga People</data>
      <data key="d1">category</data>
      <data key="d2">An ethnic group originating in Mozambique whose language is Xitsonga.</data>
      <data key="d3">chunk-fe3fb6b107774e12d36226865853669d</data>
    </node>
    <node id="Google Scholar">
      <data key="d0">Google Scholar</data>
      <data key="d1">organization</data>
      <data key="d2">Google Scholar is an academic search engine and indexing tool used by researchers, cited as an example of indexing tools that often lack coverage of African conferences and journals.</data>
      <data key="d3">chunk-fe3fb6b107774e12d36226865853669d</data>
    </node>
    <node id="West-Germanic Languages">
      <data key="d0">West-Germanic Languages</data>
      <data key="d1">category</data>
      <data key="d2">A branch of the Germanic language family to which Afrikaans belongs.</data>
      <data key="d3">chunk-fe3fb6b107774e12d36226865853669d</data>
    </node>
    <node id="Bantu Languages">
      <data key="d0">Bantu Languages</data>
      <data key="d1">category</data>
      <data key="d2">A major group of African languages characterized by agglutinative morphology, rich noun class systems, subject-verb-object word order, and tone.</data>
      <data key="d3">chunk-fe3fb6b107774e12d36226865853669d</data>
    </node>
    <node id="Dutch Settlers">
      <data key="d0">Dutch Settlers</data>
      <data key="d1">category</data>
      <data key="d2">Historical European colonizers in South Africa from whom the Afrikaans language descended.</data>
      <data key="d3">chunk-fe3fb6b107774e12d36226865853669d</data>
    </node>
    <node id="Autshumato Project">
      <data key="d0">Autshumato Project</data>
      <data key="d1">organization</data>
      <data key="d2">The Autshumato project is an initiative aimed at providing data resources to support the development of open-source translation systems in South Africa.</data>
      <data key="d3">chunk-ddef736560bcb899db81b75205f4df60</data>
    </node>
    <node id="Southern African Languages">
      <data key="d0">Southern African Languages</data>
      <data key="d1">category</data>
      <data key="d2">Southern African Languages refers to the group of languages evaluated in the study, including Afrikaans, isiZulu, Northern Sotho, Setswana, and Xitsonga.</data>
      <data key="d3">chunk-ddef736560bcb899db81b75205f4df60</data>
    </node>
    <node id="N. Sotho">
      <data key="d0">N. Sotho</data>
      <data key="d1">category</data>
      <data key="d2">N. Sotho (Northern Sotho) is an indigenous South African language evaluated in the English translation benchmark.</data>
      <data key="d3">chunk-ddef736560bcb899db81b75205f4df60</data>
    </node>
    <node id="ConvS2S">
      <data key="d0">ConvS2S</data>
      <data key="d1">category</data>
      <data key="d2">A convolutional sequence-to-sequence neural network architecture evaluated for machine translation on South African languages and used in the ablation study.&lt;SEP&gt;A convolutional sequence-to-sequence neural network architecture evaluated on machine translation across target languages.&lt;SEP&gt;A convolutional sequence-to-sequence neural network model architecture category evaluated as a baseline translation model across multiple languages.&lt;SEP&gt;ConvS2S is a convolutional sequence-to-sequence neural network architecture modeled using Fairseq for baseline machine translation benchmarks.</data>
      <data key="d3">chunk-ddef736560bcb899db81b75205f4df60&lt;SEP&gt;chunk-f50b15c876beec2eae8bf6437e8409aa&lt;SEP&gt;chunk-5f2d07efa6f5f4a54b6cbbdd93f071bc&lt;SEP&gt;chunk-aa0a1d40aed971d10ad0f0f2c4938cf4</data>
    </node>
    <node id="Byte-Pair Encoding">
      <data key="d0">Byte-Pair Encoding</data>
      <data key="d1">category</data>
      <data key="d2">Byte-Pair Encoding (BPE) is a subword tokenisation method and category investigated through ablation studies to optimize rare word handling in translation models.&lt;SEP&gt;Byte-Pair Encoding (BPE) is a subword tokenisation method applied to improve vocabulary handling and model performance in translation.</data>
      <data key="d3">chunk-ddef736560bcb899db81b75205f4df60&lt;SEP&gt;chunk-5f2d07efa6f5f4a54b6cbbdd93f071bc</data>
    </node>
    <node id="WordPiece">
      <data key="d0">WordPiece</data>
      <data key="d1">category</data>
      <data key="d2">A subword tokenisation algorithm category used by the Transformer model with token counts aligned to optimal BPE settings.&lt;SEP&gt;WordPiece is a subtoken encoding algorithm similar to BPE used by Tensor2Tensor to prepare training data for Transformer models.</data>
      <data key="d3">chunk-ddef736560bcb899db81b75205f4df60&lt;SEP&gt;chunk-5f2d07efa6f5f4a54b6cbbdd93f071bc</data>
    </node>
    <node id="BPE Ablation Study">
      <data key="d0">BPE Ablation Study</data>
      <data key="d1">event</data>
      <data key="d2">The BPE Ablation Study is an empirical investigation conducted to identify the optimal number of subword tokens for ConvS2S translation models.</data>
      <data key="d3">chunk-ddef736560bcb899db81b75205f4df60</data>
    </node>
    <node id="WMT 2014">
      <data key="d0">WMT 2014</data>
      <data key="d1">event</data>
      <data key="d2">WMT 2014 is a machine translation benchmark event and shared task referenced for standard subword token counts in English-to-German and English-to-French translation.</data>
      <data key="d3">chunk-5f2d07efa6f5f4a54b6cbbdd93f071bc</data>
    </node>
    <node id="Agglutinative Languages">
      <data key="d0">Agglutinative Languages</data>
      <data key="d1">category</data>
      <data key="d2">Agglutinative languages are a morphological category of languages characterized by complex word formation through affixation, making them challenging for machine translation models with limited data.</data>
      <data key="d3">chunk-5f2d07efa6f5f4a54b6cbbdd93f071bc</data>
    </node>
    <node id="Subword-nmt">
      <data key="d0">Subword-nmt</data>
      <data key="d1">category</data>
      <data key="d2">A software tool and implementation utilized to perform subword segmentation and BPE ablation experiments.&lt;SEP&gt;A tokenisation utility and tool category used to conduct the ablation study on Byte-Pair Encoding token counts.</data>
      <data key="d3">chunk-f50b15c876beec2eae8bf6437e8409aa&lt;SEP&gt;chunk-5f2d07efa6f5f4a54b6cbbdd93f071bc</data>
    </node>
    <node id="TensorFlow Research Cloud">
      <data key="d0">TensorFlow Research Cloud</data>
      <data key="d1">organization</data>
      <data key="d2">A program by Google providing Cloud TPU resources that supported the computational research for this study.</data>
      <data key="d3">chunk-f50b15c876beec2eae8bf6437e8409aa</data>
    </node>
    <node id="Laura Martinus">
      <data key="d0">Laura Martinus</data>
      <data key="d1">person</data>
      <data key="d2">A researcher whose GitHub repository hosts the code and datasets for the ukuxhumana project.</data>
      <data key="d3">chunk-f50b15c876beec2eae8bf6437e8409aa</data>
    </node>

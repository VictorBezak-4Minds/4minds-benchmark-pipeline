      <data key="d0">Barth</data>
      <data key="d1">person</data>
      <data key="d2">Barth is a researcher who analyzed cultural norms and differences between German and Dutch obituaries in 2013.</data>
      <data key="d3">chunk-9a42d2500d95a11dc6c778a73c5dba9c</data>

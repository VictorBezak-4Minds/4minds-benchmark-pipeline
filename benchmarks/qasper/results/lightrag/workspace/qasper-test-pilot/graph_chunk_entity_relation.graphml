      <data key="d2">An information retrieval ranking function utilized to retrieve social media comments matching specific sentences in news articles based on query similarity.</data>
      <data key="d3">chunk-707d9bb0e2896feb599f211f8cc655a0</data>
    </node>
    <node id="Nearest TSM Classification">
      <data key="d0">Nearest TSM Classification</data>
      <data key="d1">category</data>
      <data key="d2">A classification approach that assigns an ideological label to a document based on proximity to prototypical topic-sentiment matrices.</data>
      <data key="d3">chunk-707d9bb0e2896feb599f211f8cc655a0</data>
    </node>
    <node id="House of Representatives">
      <data key="d0">House of Representatives</data>
      <data key="d1">organization</data>
      <data key="d2">The lower chamber of the United States Congress whose 2005 legislative debate transcripts are compiled in the Convote dataset for sentiment and ideology classification.</data>
      <data key="d3">chunk-c17d76bd622af1c5837b2964690c50ed</data>
    </node>
    <node id="U.S. Congress">
      <data key="d0">U.S. Congress</data>
      <data key="d1">organization</data>
      <data key="d2">The national legislative branch of the United States, comprising the House of Representatives where political debates take place.</data>
      <data key="d3">chunk-c17d76bd622af1c5837b2964690c50ed</data>
    </node>
    <node id="2005 U.S. House of Representatives Debates">
      <data key="d0">2005 U.S. House of Representatives Debates</data>
      <data key="d1">event</data>
      <data key="d2">The congressional floor debates that took place in the year 2005, transcribed in the Convote dataset to study speaker viewpoints and political polarity.</data>
      <data key="d3">chunk-c17d76bd622af1c5837b2964690c50ed</data>
    </node>
    <node id="Political Affiliation">
      <data key="d0">Political Affiliation</data>
      <data key="d1">category</data>
      <data key="d2">The classification labels assigned to speakers in the dataset, including Republican, Democrat, and Independent.</data>
      <data key="d3">chunk-c17d76bd622af1c5837b2964690c50ed</data>
    </node>
    <node id="Independent Affiliation">
      <data key="d0">Independent Affiliation</data>
      <data key="d1">category</data>
      <data key="d2">A minor political affiliation in the dataset represented by only six congressional documents, which was excluded from empirical evaluation due to sample size.</data>
      <data key="d3">chunk-c17d76bd622af1c5837b2964690c50ed</data>
    </node>
    <node id="Sentiment Polarity Classes">
      <data key="d0">Sentiment Polarity Classes</data>
      <data key="d1">category</data>
      <data key="d2">A set of five discrete sentiment classes provided by the sentiment analyzer to measure speaker polarity toward debate topics.</data>
      <data key="d3">chunk-c17d76bd622af1c5837b2964690c50ed</data>
    </node>
    <node id="Viewpoint Document">
      <data key="d0">Viewpoint Document</data>
      <data key="d1">category</data>
      <data key="d2">A synthesized document category combining all uninterrupted utterances of a speaker within a single congressional debate to capture their overall perspective.</data>
      <data key="d3">chunk-c17d76bd622af1c5837b2964690c50ed</data>
    </node>
    <node id="Polarizing Topics">
      <data key="d0">Polarizing Topics</data>
      <data key="d1">category</data>
      <data key="d2">A classification of congressional debate topics that provoke opposing sentiments across political affiliations such as Republicans and Democrats.</data>
      <data key="d3">chunk-c17d76bd622af1c5837b2964690c50ed</data>
    </node>
    <node id="Least Polarizing Topics">
      <data key="d0">Least Polarizing Topics</data>
      <data key="d1">category</data>
      <data key="d2">A classification of congressional debate topics characterized by minimal divergence in sentiment across opposing political ideologies.</data>
      <data key="d3">chunk-c17d76bd622af1c5837b2964690c50ed</data>
    </node>
    <node id="Goodfellow Et Al.">
      <data key="d0">Goodfellow Et Al.</data>
      <data key="d1">person</data>
      <data key="d2">Goodfellow et al. are researchers who introduced adversarial training in 2014, a technique adapted to enhance neural network robustness in language models.</data>
      <data key="d3">chunk-1ca9fdc4a98dc4d2c8f6875739e4d466</data>
    </node>
    <node id="Xu Et Al.">
      <data key="d0">Xu Et Al.</data>
      <data key="d1">person</data>
      <data key="d2">Xu et al. are researchers who proposed the post-trained BERT (BERT-PT) language model in 2019 for domain-specific sentiment analysis.</data>
      <data key="d3">chunk-1ca9fdc4a98dc4d2c8f6875739e4d466</data>
    </node>
    <node id="Ideology Detection">
      <data key="d0">Ideology Detection</data>
      <data key="d1">category</data>
      <data key="d2">Ideology detection is a natural language processing task aimed at automatically classifying and detecting political leanings or ideologies from textual data.</data>
      <data key="d3">chunk-1ca9fdc4a98dc4d2c8f6875739e4d466</data>
    </node>
    <node id="Aspect-Based Sentiment Analysis">
      <data key="d0">Aspect-Based Sentiment Analysis</data>
      <data key="d1">category</data>
      <data key="d2">Aspect-Based Sentiment Analysis (ABSA) is a sub-field and task category within natural language processing focused on identifying aspect terms and determining sentiment associated with those specific aspects.&lt;SEP&gt;Aspect-Based Sentiment Analysis (ABSA) is a subfield of natural language processing focused on identifying aspect terms and determining sentiment towards specific aspects in text.&lt;SEP&gt;Aspect-Based Sentiment Analysis (ABSA) is a subfield of sentiment analysis focused on identifying specific opinion targets (aspects) and determining the sentiment expressed toward them.</data>
      <data key="d3">chunk-1ca9fdc4a98dc4d2c8f6875739e4d466&lt;SEP&gt;chunk-22000c8a3ad4361f1298f9c99632a667&lt;SEP&gt;chunk-47f43d3218257ab88ccde621eadece2c</data>
    </node>
    <node id="Aspect Extraction">
      <data key="d0">Aspect Extraction</data>
      <data key="d1">category</data>
      <data key="d2">Aspect Extraction (AE) is a fundamental task category in ABSA typically modeled as a sequence labeling problem to identify terms referring to aspects of an entity.&lt;SEP&gt;Aspect Extraction (AE) is a natural language processing task aimed at identifying aspect terms within review text.&lt;SEP&gt;Aspect Extraction (AE) is a natural language processing task dedicated to identifying specific entity attributes or aspect terms in text.&lt;SEP&gt;Aspect Extraction (AE) is an NLP task category aimed at identifying specific aspect terms or targets in text.&lt;SEP&gt;Aspect Extraction is a key subtask of Aspect-Based Sentiment Analysis that focuses on extracting opinion targets or aspects from text.</data>
      <data key="d3">chunk-1ca9fdc4a98dc4d2c8f6875739e4d466&lt;SEP&gt;chunk-9b6bd8ee29f5ff509c2fa42f7d1d1739&lt;SEP&gt;chunk-22000c8a3ad4361f1298f9c99632a667&lt;SEP&gt;chunk-67aef3e225567bceaa8ddbf5e9866527&lt;SEP&gt;chunk-47f43d3218257ab88ccde621eadece2c</data>
    </node>
    <node id="Aspect Sentiment Classification">
      <data key="d0">Aspect Sentiment Classification</data>
      <data key="d1">category</data>
      <data key="d2">Aspect Sentiment Classification (ASC) is a major task category within ABSA that focuses on predicting sentiment polarity toward specific identified aspect terms.&lt;SEP&gt;Aspect Sentiment Classification (ASC) is a subtask of aspect-based sentiment analysis focused on determining whether sentiment toward a given aspect is positive, negative, or neutral.&lt;SEP&gt;Aspect Sentiment Classification (ASC) is a task within sentiment analysis aimed at determining the polarity of sentiment associated with specific aspects.&lt;SEP&gt;Aspect Sentiment Classification (ASC) is an NLP task category aimed at determining the sentiment polarity associated with given aspects.&lt;SEP&gt;Aspect Sentiment Classification is a core task in Aspect-Based Sentiment Analysis aimed at determining the sentiment orientation toward identified targets.</data>
      <data key="d3">chunk-1ca9fdc4a98dc4d2c8f6875739e4d466&lt;SEP&gt;chunk-9b6bd8ee29f5ff509c2fa42f7d1d1739&lt;SEP&gt;chunk-22000c8a3ad4361f1298f9c99632a667&lt;SEP&gt;chunk-67aef3e225567bceaa8ddbf5e9866527&lt;SEP&gt;chunk-47f43d3218257ab88ccde621eadece2c</data>
    </node>
    <node id="United States Congress">
      <data key="d0">United States Congress</data>
      <data key="d1">organization</data>
      <data key="d2">The legislative branch of the federal government of the United States whose speeches are analyzed in the study to detect political ideology and polarization.</data>
      <data key="d3">chunk-1ca9fdc4a98dc4d2c8f6875739e4d466</data>
    </node>
    <node id="Military Programs">
      <data key="d0">Military Programs</data>
      <data key="d1">category</data>
      <data key="d2">A policy domain and legislative topic categorized as highly polarizing between political ideologies in the US Congressional speeches.</data>
      <data key="d3">chunk-1ca9fdc4a98dc4d2c8f6875739e4d466</data>
    </node>
    <node id="Administration Processes">
      <data key="d0">Administration Processes</data>
      <data key="d1">category</data>
      <data key="d2">A topical category involving administrative and governmental procedures, identified as one of the most polarizing topics in the study.</data>
      <data key="d3">chunk-1ca9fdc4a98dc4d2c8f6875739e4d466</data>
    </node>
    <node id="Worker Safety">
      <data key="d0">Worker Safety</data>
      <data key="d1">category</data>
      <data key="d2">A legislative and social policy topic identified as among the least polarizing issues between Republicans and Democrats in the analysis.</data>
      <data key="d3">chunk-1ca9fdc4a98dc4d2c8f6875739e4d466</data>
    </node>
    <node id="Energy Projects">
      <data key="d0">Energy Projects</data>
      <data key="d1">category</data>
      <data key="d2">A topical domain concerning energy initiatives and projects, found to have low distance and polarization between ideological classes.</data>
      <data key="d3">chunk-1ca9fdc4a98dc4d2c8f6875739e4d466</data>
    </node>
    <node id="Gun Control">
      <data key="d0">Gun Control</data>
      <data key="d1">category</data>
      <data key="d2">A controversial social and political topic that counter-intuitively ranked among the least polarizing topics in the dataset due to sparse occurrences in the training speeches.</data>
      <data key="d3">chunk-1ca9fdc4a98dc4d2c8f6875739e4d466</data>
    </node>
    <node id="Nearest Neighbor Classification">
      <data key="d0">Nearest Neighbor Classification</data>
      <data key="d1">category</data>
      <data key="d2">A machine learning classification algorithm utilized to classify political ideologies based on the top polarizing topic-sentiment representations.</data>
      <data key="d3">chunk-1ca9fdc4a98dc4d2c8f6875739e4d466</data>
    </node>
    <node id="BERT-PT">
      <data key="d0">BERT-PT</data>
      <data key="d1">category</data>
      <data key="d2">BERT-PT is a post-trained BERT model category and baseline codebase used for comparative evaluation and ablation study in AE and ASC tasks.&lt;SEP&gt;Post-trained BERT, a domain-adapted variant of the BERT model proposed by Xu et al. specifically for sentiment analysis and aspect extraction tasks.</data>
      <data key="d3">chunk-1ca9fdc4a98dc4d2c8f6875739e4d466&lt;SEP&gt;chunk-67aef3e225567bceaa8ddbf5e9866527</data>
    </node>
    <node id="BERT Adversarial Training">
      <data key="d0">BERT Adversarial Training</data>
      <data key="d1">category</data>
      <data key="d2">A novel neural network architecture (BAT) that incorporates adversarial training into post-trained BERT for aspect-based sentiment analysis.&lt;SEP&gt;BERT Adversarial Training (BAT) is a neural architecture and methodology combining post-trained BERT representations with adversarial perturbations during training.</data>
      <data key="d3">chunk-1ca9fdc4a98dc4d2c8f6875739e4d466&lt;SEP&gt;chunk-22000c8a3ad4361f1298f9c99632a667</data>
    </node>
    <node id="SemEval 2014">
      <data key="d0">SemEval 2014</data>
      <data key="d1">event</data>
      <data key="d2">SemEval 2014 is an international semantic evaluation workshop that provided benchmark evaluation datasets for aspect sentiment classification tasks.&lt;SEP&gt;SemEval 2014 was a natural language processing evaluation contest that featured task 4 focused on aspect-based sentiment analysis, introducing benchmarks for aspect extraction and aspect sentiment classification.</data>
      <data key="d3">chunk-22000c8a3ad4361f1298f9c99632a667&lt;SEP&gt;chunk-47f43d3218257ab88ccde621eadece2c</data>
    </node>
    <node id="Graph Convolutional Networks">
      <data key="d0">Graph Convolutional Networks</data>
      <data key="d1">category</data>
      <data key="d2">Graph Convolutional Networks (GCNs) are neural network architectures designed to operate over graph structures, used in sentiment analysis to model dependencies between multiple aspects.</data>
      <data key="d3">chunk-47f43d3218257ab88ccde621eadece2c</data>
    </node>
    <node id="Bidirectional LSTMs">
      <data key="d0">Bidirectional LSTMs</data>
      <data key="d1">category</data>
      <data key="d2">Bidirectional Long Short-Term Memory networks (BiLSTMs) are recurrent neural architectures that process sequential inputs in both forward and backward directions.</data>
      <data key="d3">chunk-47f43d3218257ab88ccde621eadece2c</data>
    </node>
    <node id="Autoencoder">
      <data key="d0">Autoencoder</data>
      <data key="d1">category</data>
      <data key="d2">Autoencoders are a category of neural network architectures designed to learn representations by reconstructing inputs, utilized in unsupervised aspect extraction and feature transfer.</data>
      <data key="d3">chunk-47f43d3218257ab88ccde621eadece2c</data>
    </node>
    <node id="Aspect Category Sentiment Classification">
      <data key="d0">Aspect Category Sentiment Classification</data>
      <data key="d1">category</data>
      <data key="d2">Aspect Category Sentiment Classification is a coarse-grained ABSA task focusing on identifying sentiment towards broader aspect categories.</data>
      <data key="d3">chunk-47f43d3218257ab88ccde621eadece2c</data>
    </node>
    <node id="Aspect Term Sentiment Classification">
      <data key="d0">Aspect Term Sentiment Classification</data>
      <data key="d1">category</data>
      <data key="d2">Aspect Term Sentiment Classification is a fine-grained ABSA task aimed at determining sentiment polarity towards specific aspect terms.</data>
      <data key="d3">chunk-47f43d3218257ab88ccde621eadece2c</data>
    </node>
    <node id="SemEval 2014 Task 4">
      <data key="d0">SemEval 2014 Task 4</data>
      <data key="d1">event</data>
      <data key="d2">SemEval 2014 Task 4 is a benchmark natural language processing competition focused on aspect-based sentiment analysis tasks and datasets.&lt;SEP&gt;SemEval 2014 Task 4 is an NLP competition event focused on aspect-based sentiment analysis, providing benchmark datasets for laptop and restaurant domains.</data>
      <data key="d3">chunk-9b6bd8ee29f5ff509c2fa42f7d1d1739&lt;SEP&gt;chunk-67aef3e225567bceaa8ddbf5e9866527</data>
    </node>
    <node id="SemEval 2016 Task 5">
      <data key="d0">SemEval 2016 Task 5</data>
      <data key="d1">event</data>
      <data key="d2">SemEval 2016 Task 5 is an NLP shared task competition event providing benchmark datasets for aspect-based sentiment analysis, including the restaurant dataset used for ASC.&lt;SEP&gt;SemEval 2016 Task 5 is an evaluation competition providing benchmark datasets for aspect-based sentiment analysis.</data>
      <data key="d3">chunk-9b6bd8ee29f5ff509c2fa42f7d1d1739&lt;SEP&gt;chunk-67aef3e225567bceaa8ddbf5e9866527</data>
    </node>
    <node id="White-Box Attacks">
      <data key="d0">White-Box Attacks</data>
      <data key="d1">category</data>
      <data key="d2">White-box attacks are a class of adversarial attacks in which the attacker has complete access to the model parameters and gradients.</data>
      <data key="d3">chunk-9b6bd8ee29f5ff509c2fa42f7d1d1739</data>
    </node>
    <node id="Black-Box Attacks">
      <data key="d0">Black-Box Attacks</data>
      <data key="d1">category</data>
      <data key="d2">Black-box attacks are a class of adversarial attacks where the attacker can only interact with the model via its inputs and outputs without direct access to internal parameters.</data>
      <data key="d3">chunk-9b6bd8ee29f5ff509c2fa42f7d1d1739</data>
    </node>
    <node id="PyTorch">
      <data key="d0">PyTorch</data>
      <data key="d1">organization</data>
      <data key="d2">An open-source deep learning library used for implementing and training the G-SAT model architecture.&lt;SEP&gt;PyTorch is an open-source machine learning framework and ecosystem used to implement neural network architectures and loss functions such as cross-entropy loss.</data>
      <data key="d3">chunk-9b6bd8ee29f5ff509c2fa42f7d1d1739&lt;SEP&gt;chunk-af6147035553ac26ef0837a5ab654f4f</data>
    </node>
    <node id="Cross Entropy Loss">
      <data key="d0">Cross Entropy Loss</data>
      <data key="d1">category</data>
      <data key="d2">Cross entropy loss is a standard loss function category used to measure the performance of classification models whose output is a probability value.</data>
      <data key="d3">chunk-9b6bd8ee29f5ff509c2fa42f7d1d1739</data>
    </node>
    <node id="Backpropagation">
      <data key="d0">Backpropagation</data>
      <data key="d1">category</data>
      <data key="d2">Backpropagation is an optimization and training algorithm used in neural networks to compute gradients of the loss function with respect to model parameters.</data>
      <data key="d3">chunk-9b6bd8ee29f5ff509c2fa42f7d1d1739</data>
    </node>
    <node id="Token Embeddings">
      <data key="d0">Token Embeddings</data>
      <data key="d1">category</data>
      <data key="d2">Token embeddings represent an embedding category that maps individual vocabulary tokens into continuous dense vector representations.</data>
      <data key="d3">chunk-9b6bd8ee29f5ff509c2fa42f7d1d1739</data>
    </node>
    <node id="Position Embeddings">
      <data key="d0">Position Embeddings</data>
      <data key="d1">category</data>
      <data key="d2">Position embeddings represent an embedding category used to encode and preserve positional ordering information of sequence elements.</data>
      <data key="d3">chunk-9b6bd8ee29f5ff509c2fa42f7d1d1739</data>
    </node>
    <node id="Segment Embeddings">
      <data key="d0">Segment Embeddings</data>
      <data key="d1">category</data>
      <data key="d2">Segment embeddings represent an embedding category used to distinguish between different sentences or input segments in multi-sequence tasks.</data>
      <data key="d3">chunk-9b6bd8ee29f5ff509c2fa42f7d1d1739</data>
    </node>
    <node id="Laptop Domain">
      <data key="d0">Laptop Domain</data>
      <data key="d1">category</data>
      <data key="d2">Laptop Domain is a data and evaluation domain category in SemEval benchmark datasets used for AE and ASC tasks.</data>
      <data key="d3">chunk-67aef3e225567bceaa8ddbf5e9866527</data>
    </node>
    <node id="Restaurant Domain">
      <data key="d0">Restaurant Domain</data>
      <data key="d1">category</data>
      <data key="d2">Restaurant Domain is a data and evaluation domain category in SemEval benchmark datasets used for evaluating AE and ASC models.</data>
      <data key="d3">chunk-67aef3e225567bceaa8ddbf5e9866527</data>
    </node>
    <node id="Macro-F1">
      <data key="d0">Macro-F1</data>
      <data key="d1">category</data>
      <data key="d2">Macro-F1 is an evaluation metric category that averages F1 scores across individual classes to handle class imbalance in the ASC task.</data>
      <data key="d3">chunk-67aef3e225567bceaa8ddbf5e9866527</data>
    </node>
    <node id="Accuracy">
      <data key="d0">Accuracy</data>
      <data key="d1">category</data>
      <data key="d2">A standard performance evaluation metric that measures the agreement between a classification model's predictions and the gold standard reference annotations.&lt;SEP&gt;Accuracy is an evaluation metric category measuring the proportion of correct predictions, used alongside Macro-F1 for ASC evaluation.</data>
      <data key="d3">chunk-67aef3e225567bceaa8ddbf5e9866527&lt;SEP&gt;chunk-dacb70558821cf911a6e2c412a464f07</data>
    </node>
    <node id="BERT_BASE">
      <data key="d0">BERT_BASE</data>
      <data key="d1">category</data>
      <data key="d2">BERT_BASE is a foundational pre-trained transformer model architecture category whose uncased version is used for model initialization.</data>
      <data key="d3">chunk-67aef3e225567bceaa8ddbf5e9866527</data>
    </node>
    <node id="BAT">
      <data key="d0">BAT</data>
      <data key="d1">category</data>
      <data key="d2">BAT is an adversarial training model framework category evaluated using perturbation parameters on NLP tasks.</data>
      <data key="d3">chunk-67aef3e225567bceaa8ddbf5e9866527</data>
    </node>
    <node id="Adidas AG">
      <data key="d0">Adidas AG</data>
      <data key="d1">organization</data>
      <data key="d2">Adidas AG is a multinational corporation that provided funding for the research on adversarial training in aspect-based sentiment analysis.</data>
      <data key="d3">chunk-22000c8a3ad4361f1298f9c99632a667</data>
    </node>
    <node id="Devlin">
      <data key="d0">Devlin</data>
      <data key="d1">person</data>
      <data key="d2">Devlin is a researcher recognized for introducing the BERT model and its word embedding architecture in 2018.</data>
      <data key="d3">chunk-22000c8a3ad4361f1298f9c99632a667</data>
    </node>
    <node id="SemEval 2016">
      <data key="d0">SemEval 2016</data>
      <data key="d1">event</data>
      <data key="d2">SemEval 2016 is an international semantic evaluation workshop that provided benchmark evaluation datasets for aspect extraction tasks.</data>
      <data key="d3">chunk-22000c8a3ad4361f1298f9c99632a667</data>
    </node>
    <node id="Morphological Generalization">
      <data key="d0">Morphological Generalization</data>
      <data key="d1">category</data>
      <data key="d2">Morphological Generalization is an evaluation framework assessing how well cross-lingual models translate rare and unseen inflected word forms.&lt;SEP&gt;Morphological Generalization is the capability of models or human translators to generate and understand rare inflections of words based on general morphological rules.&lt;SEP&gt;The ability of a language model or translator to understand, produce, and map rare or unseen inflectional forms of lexemes accurately.&lt;SEP&gt;The ability of bilingual lexicon induction models to accurately translate rare, inflected, or previously unseen morphological variants of words.</data>
      <data key="d3">chunk-9896f0582e2237c4a0dd8169f6817110&lt;SEP&gt;chunk-874a0fecf572a7885d7353d9aa510123&lt;SEP&gt;chunk-a857415cf32d5d04b955b0da8d697209&lt;SEP&gt;chunk-22000c8a3ad4361f1298f9c99632a667</data>
    </node>
    <node id="Post-Trained BERT">
      <data key="d0">Post-Trained BERT</data>
      <data key="d1">category</data>
      <data key="d2">Post-Trained BERT (BERT-PT) is a domain-adapted language representation model evaluated on aspect extraction and aspect sentiment classification tasks.</data>
      <data key="d3">chunk-22000c8a3ad4361f1298f9c99632a667</data>
    </node>
    <node id="Aspect Category Detection">
      <data key="d0">Aspect Category Detection</data>
      <data key="d1">category</data>
      <data key="d2">Aspect Category Detection is a subtask within Aspect-Based Sentiment Analysis focused on identifying predefined aspect categories in text.</data>
      <data key="d3">chunk-22000c8a3ad4361f1298f9c99632a667</data>
    </node>
    <node id="Aspect Category Polarity">
      <data key="d0">Aspect Category Polarity</data>
      <data key="d1">category</data>
      <data key="d2">Aspect Category Polarity is an ABSA subtask aimed at determining the sentiment orientation associated with specific aspect categories.</data>
      <data key="d3">chunk-22000c8a3ad4361f1298f9c99632a667</data>
    </node>
    <node id="White-Box Adversarial Examples">
      <data key="d0">White-Box Adversarial Examples</data>
      <data key="d1">category</data>
      <data key="d2">White-Box Adversarial Examples are adversarial perturbations generated with full knowledge of the model's architecture and parameters, targeted for comparison in sentiment tasks.</data>
      <data key="d3">chunk-22000c8a3ad4361f1298f9c99632a667</data>
    </node>
    <node id="Black-Box Adversarial Examples">
      <data key="d0">Black-Box Adversarial Examples</data>
      <data key="d1">category</data>
      <data key="d2">Black-Box Adversarial Examples are adversarial evaluation and training inputs created without internal access to model parameters.</data>
      <data key="d3">chunk-22000c8a3ad4361f1298f9c99632a667</data>
    </node>
    <node id="Zipfian Distribution">
      <data key="d0">Zipfian Distribution</data>
      <data key="d1">category</data>
      <data key="d2">A statistical distribution pattern common in human language where a large proportion of tokens come from rare types, including infrequent inflections of lexemes.&lt;SEP&gt;The Zipfian Distribution is a statistical power-law distribution characteristic of human language, where word frequency drops rapidly and a large proportion of tokens belong to rare types.</data>
      <data key="d3">chunk-9896f0582e2237c4a0dd8169f6817110&lt;SEP&gt;chunk-22000c8a3ad4361f1298f9c99632a667</data>
    </node>
    <node id="Morphological Inflection">
      <data key="d0">Morphological Inflection</data>
      <data key="d1">category</data>
      <data key="d2">Morphological Inflection refers to the grammatical variation of words into different forms, which often appear in the long tail of word frequency distributions.</data>
      <data key="d3">chunk-22000c8a3ad4361f1298f9c99632a667</data>
    </node>
    <node id="Polish">
      <data key="d0">Polish</data>
      <data key="d1">category</data>
      <data key="d2">A Slavic language analyzed in pairs with Czech and Spanish, featuring rich case inflection including singular dative forms.&lt;SEP&gt;A Slavic language evaluated in BLI experiments, both with related languages like Czech and unrelated languages like Spanish.&lt;SEP&gt;A Slavic language incorporated in the morphological translation dictionaries for cross-lingual evaluation.&lt;SEP&gt;Polish is a Slavic language evaluated in the study to test bilingual lexicon induction performance across morphosyntactic categories.&lt;SEP&gt;Polish is a language belonging to the Slavic family included in the morphologically complete dictionaries for bilingual lexicon induction evaluation.</data>
      <data key="d3">chunk-874a0fecf572a7885d7353d9aa510123&lt;SEP&gt;chunk-0ca3ab8f8c0dca0a40d79a8ee4226255&lt;SEP&gt;chunk-9896f0582e2237c4a0dd8169f6817110&lt;SEP&gt;chunk-00381e9f572e2f4c1655790b19b827fd&lt;SEP&gt;chunk-a857415cf32d5d04b955b0da8d697209</data>
    </node>
    <node id="Czech">
      <data key="d0">Czech</data>
      <data key="d1">category</data>
      <data key="d2">A Slavic language analyzed in comparison to Polish in bilingual lexicon induction experiments.&lt;SEP&gt;A Slavic language evaluated in pair with Polish for morphological generalization in bilingual lexicon induction.&lt;SEP&gt;A Slavic language selected for cross-lingual morphological mapping and bilingual induction.&lt;SEP&gt;Czech is a Slavic language included among the language pairs used to test morphological generalization in BLI models.</data>
      <data key="d3">chunk-00381e9f572e2f4c1655790b19b827fd&lt;SEP&gt;chunk-9896f0582e2237c4a0dd8169f6817110&lt;SEP&gt;chunk-874a0fecf572a7885d7353d9aa510123&lt;SEP&gt;chunk-0ca3ab8f8c0dca0a40d79a8ee4226255</data>
    </node>
    <node id="Russian">
      <data key="d0">Russian</data>
      <data key="d1">category</data>
      <data key="d2">A Slavic language included in the inflectional translation resource.&lt;SEP&gt;Russian is a language belonging to the Slavic family incorporated into the 40 morphologically complete dictionaries.</data>
      <data key="d3">chunk-00381e9f572e2f4c1655790b19b827fd&lt;SEP&gt;chunk-9896f0582e2237c4a0dd8169f6817110</data>
    </node>
    <node id="Slovak">
      <data key="d0">Slovak</data>
      <data key="d1">category</data>
      <data key="d2">A Slavic language selected for inflectional mapping and cross-lingual BLI benchmarks.&lt;SEP&gt;Slovak is a Slavic language utilized in the evaluation of bilingual lexicon induction across genetically-related language pairs.</data>
      <data key="d3">chunk-00381e9f572e2f4c1655790b19b827fd&lt;SEP&gt;chunk-9896f0582e2237c4a0dd8169f6817110</data>
    </node>
    <node id="Ukrainian">
      <data key="d0">Ukrainian</data>
      <data key="d1">category</data>
      <data key="d2">A Slavic language incorporated in the morphological evaluation datasets.&lt;SEP&gt;Ukrainian is a Slavic language included in the research to evaluate bilingual lexicon induction across related language pairs.</data>
      <data key="d3">chunk-00381e9f572e2f4c1655790b19b827fd&lt;SEP&gt;chunk-9896f0582e2237c4a0dd8169f6817110</data>
    </node>
    <node id="Open Multilingual WordNet">
      <data key="d0">Open Multilingual WordNet</data>
      <data key="d1">organization</data>
      <data key="d2">A collaborative lexical resource and database project that groups words into sets of synonyms across multiple languages.&lt;SEP&gt;Open Multilingual WordNet is a lexical resource and collaborative project from which Spanish-English and Italian-English lexica were derived.</data>
      <data key="d3">chunk-00381e9f572e2f4c1655790b19b827fd&lt;SEP&gt;chunk-9896f0582e2237c4a0dd8169f6817110</data>
    </node>
    <node id="FastText">
      <data key="d0">FastText</data>
      <data key="d1">category</data>
      <data key="d2">A large-scale word embedding architecture and library that encodes character n-grams to represent words, including subword morphological information.&lt;SEP&gt;An embedding model architecture that leverages subword n-grams, facilitating morphological generalization across related languages.</data>
      <data key="d3">chunk-9896f0582e2237c4a0dd8169f6817110&lt;SEP&gt;chunk-0ca3ab8f8c0dca0a40d79a8ee4226255</data>
    </node>
    <node id="MUSE Dataset">
      <data key="d0">MUSE Dataset</data>
      <data key="d1">category</data>
      <data key="d2">A widely used bilingual evaluation benchmark created with an internal translation tool, predominantly containing high-frequency word forms ranked in the top 10k.</data>
      <data key="d3">chunk-9896f0582e2237c4a0dd8169f6817110</data>
    </node>
    <node id="Semantic Leakage">
      <data key="d0">Semantic Leakage</data>
      <data key="d1">category</data>
      <data key="d2">An evaluation issue where different inflections of the same lexeme appear in both training and test sets, enabling models to memorize lemmas rather than truly generalizing.</data>
      <data key="d3">chunk-9896f0582e2237c4a0dd8169f6817110</data>
    </node>
    <node id="Open-Vocabulary BLI">
      <data key="d0">Open-Vocabulary BLI</data>
      <data key="d1">category</data>
      <data key="d2">A setting in bilingual lexicon induction that tests a model's capacity to translate out-of-vocabulary and rare morphological variants rather than just closed-vocabulary words.&lt;SEP&gt;A variant of bilingual lexicon induction that evaluates word translation models on rare and out-of-vocabulary inflected word forms.</data>
      <data key="d3">chunk-00381e9f572e2f4c1655790b19b827fd&lt;SEP&gt;chunk-9896f0582e2237c4a0dd8169f6817110</data>
    </node>
    <node id="Inflectional Paradigm">
      <data key="d0">Inflectional Paradigm</data>
      <data key="d1">category</data>
      <data key="d2">The complete set of morphological forms and inflected variants that can be generated from a single lexical root or lexeme.</data>
      <data key="d3">chunk-9896f0582e2237c4a0dd8169f6817110</data>
    </node>
    <node id="Wiktionary">
      <data key="d0">Wiktionary</data>
      <data key="d1">organization</data>
      <data key="d2">A collaborative multilingual online dictionary project from which UniMorph extracts inflectional word paradigms.</data>
      <data key="d3">chunk-00381e9f572e2f4c1655790b19b827fd</data>
    </node>
    <node id="UniMorph">
      <data key="d0">UniMorph</data>
      <data key="d1">organization</data>
      <data key="d2">A project providing inflectional word paradigms and morphological schema across dozens of languages, utilized for generating morphological dictionaries.&lt;SEP&gt;UniMorph is a collaborative morphological project providing grammatical inflections used to construct out-of-vocabulary evaluation data.&lt;SEP&gt;UniMorph is an open collaborative project and database that provides morphological data and gold standard morphological tags for word forms across languages.</data>
      <data key="d3">chunk-00381e9f572e2f4c1655790b19b827fd&lt;SEP&gt;chunk-874a0fecf572a7885d7353d9aa510123&lt;SEP&gt;chunk-a857415cf32d5d04b955b0da8d697209</data>
    </node>
    <node id="MUSE">
      <data key="d0">MUSE</data>
      <data key="d1">category</data>
      <data key="d2">A widely used open bilingual dictionary and evaluation resource covering genetically related language pairs such as French, Spanish, Italian, and Portuguese.</data>
      <data key="d3">chunk-00381e9f572e2f4c1655790b19b827fd</data>
    </node>
    <node id="fastText">
      <data key="d0">fastText</data>
      <data key="d1">organization</data>
      <data key="d2">An open-source library and project providing large-scale word representation models and embeddings.</data>
      <data key="d3">chunk-00381e9f572e2f4c1655790b19b827fd</data>
    </node>
    <node id="Extended Open Multilingual WordNet">
      <data key="d0">Extended Open Multilingual WordNet</data>
      <data key="d1">organization</data>
      <data key="d2">An extension of the Open Multilingual WordNet lexical database grouping words into synonym sets across languages, used for generating dictionary translation pairs.</data>
      <data key="d3">chunk-00381e9f572e2f4c1655790b19b827fd</data>
    </node>
    <node id="Cross-Lingual Word Embeddings">
      <data key="d0">Cross-Lingual Word Embeddings</data>
      <data key="d1">category</data>
      <data key="d2">Semantic vector space representations spanning multiple languages, evaluated through bilingual lexicon induction tasks.</data>
      <data key="d3">chunk-00381e9f572e2f4c1655790b19b827fd</data>
    </node>
    <node id="Precision at k">
      <data key="d0">Precision at k</data>
      <data key="d1">category</data>
      <data key="d2">An evaluation metric commonly used in bilingual lexicon induction to measure translation retrieval accuracy, particularly at k=1.</data>
      <data key="d3">chunk-00381e9f572e2f4c1655790b19b827fd</data>
    </node>
    <node id="Train-Test Paradigm Leakage">
      <data key="d0">Train-Test Paradigm Leakage</data>
      <data key="d1">category</data>
      <data key="d2">A data leakage issue identified in evaluation datasets where test word forms share lemmata with forms in the training set.</data>
      <data key="d3">chunk-00381e9f572e2f4c1655790b19b827fd</data>
    </node>
    <node id="Wug Test">
      <data key="d0">Wug Test</data>
      <data key="d1">event</data>
      <data key="d2">The Wug Test is a classic psycholinguistic experiment testing inflectional generalization on novel words, referenced as an analogy to out-of-vocabulary word evaluation.</data>
      <data key="d3">chunk-a857415cf32d5d04b955b0da8d697209</data>
    </node>
    <node id="Cross-Lingual Embedding Space">
      <data key="d0">Cross-Lingual Embedding Space</data>
      <data key="d1">category</data>
      <data key="d2">A cross-lingual embedding space is a shared vector representation induced from monolingual embeddings to facilitate bilingual alignment and translation.</data>
      <data key="d3">chunk-a857415cf32d5d04b955b0da8d697209</data>
    </node>
    <node id="Monolingual Word Embeddings">
      <data key="d0">Monolingual Word Embeddings</data>
      <data key="d1">category</data>
      <data key="d2">Monolingual word embeddings are continuous vector representations of words within a single language that serve as the input for bilingual dictionary induction.</data>
      <data key="d3">chunk-a857415cf32d5d04b955b0da8d697209</data>
    </node>
    <node id="Morphosyntactic Categories">
      <data key="d0">Morphosyntactic Categories</data>
      <data key="d1">category</data>
      <data key="d2">Grammatical classifications defining word inflection such as imperative verb forms and singular dative nouns analyzed in the study.&lt;SEP&gt;Grammatical property categories, including tense, aspect, case, and part-of-speech, used to tag and align words across languages.&lt;SEP&gt;Morphosyntactic categories are grammatical paradigm slots whose distributions and translation difficulties are controlled and analyzed across models.</data>
      <data key="d3">chunk-874a0fecf572a7885d7353d9aa510123&lt;SEP&gt;chunk-0ca3ab8f8c0dca0a40d79a8ee4226255&lt;SEP&gt;chunk-a857415cf32d5d04b955b0da8d697209</data>
    </node>
    <node id="Second-Person Plural Present Imperative">
      <data key="d0">Second-Person Plural Present Imperative</data>
      <data key="d1">category</data>
      <data key="d2">A low-frequency morphosyntactic verb form category demonstrating particularly low accuracy in both French–Spanish and Polish–Czech pairs.&lt;SEP&gt;The second-person plural present imperative is a specific rare morphosyntactic category exhibiting notably low translation accuracy across evaluated languages.</data>
      <data key="d3">chunk-0ca3ab8f8c0dca0a40d79a8ee4226255&lt;SEP&gt;chunk-a857415cf32d5d04b955b0da8d697209</data>
    </node>
    <node id="French–Spanish">
      <data key="d0">French–Spanish</data>
      <data key="d1">category</data>
      <data key="d2">A genetically related Romance language pair used to evaluate the accuracy of bilingual lexicon induction across inflectional forms.</data>
      <data key="d3">chunk-0ca3ab8f8c0dca0a40d79a8ee4226255</data>
    </node>
    <node id="Polish–Czech">
      <data key="d0">Polish–Czech</data>
      <data key="d1">category</data>
      <data key="d2">A genetically related Slavic language pair evaluated in bilingual lexicon induction and morphological generalization experiments.</data>
      <data key="d3">chunk-0ca3ab8f8c0dca0a40d79a8ee4226255</data>
    </node>
    <node id="Polish–Spanish">
      <data key="d0">Polish–Spanish</data>
      <data key="d1">category</data>
      <data key="d2">A cross-family language pair connecting a Slavic and a Romance language to test morphological generalization across unrelated languages.</data>
      <data key="d3">chunk-0ca3ab8f8c0dca0a40d79a8ee4226255</data>
    </node>
    <node id="Syncretism">
      <data key="d0">Syncretism</data>
      <data key="d1">category</data>
      <data key="d2">A linguistic phenomenon where different paradigm slots share the same surface form, hypothesized to affect embedding representation quality.</data>
      <data key="d3">chunk-0ca3ab8f8c0dca0a40d79a8ee4226255</data>
    </node>
    <node id="Spanish–Polish">
      <data key="d0">Spanish–Polish</data>
      <data key="d1">category</data>
      <data key="d2">An experimental language pair mapping between a Romance language and a Slavic language to test morphological generalization.</data>
      <data key="d3">chunk-0ca3ab8f8c0dca0a40d79a8ee4226255</data>
    </node>
    <node id="Singular Dative Noun">
      <data key="d0">Singular Dative Noun</data>
      <data key="d1">category</data>
      <data key="d2">A morphosyntactic nominal form in Slavic languages that proved difficult for bilingual lexicon induction models even among frequent lexemes.</data>
      <data key="d3">chunk-0ca3ab8f8c0dca0a40d79a8ee4226255</data>
    </node>
    <node id="Lexeme Frequency">
      <data key="d0">Lexeme Frequency</data>
      <data key="d1">category</data>
      <data key="d2">A metric used to partition source dictionaries into frequency bins to study its effect on morphological translation accuracy.</data>
      <data key="d3">chunk-0ca3ab8f8c0dca0a40d79a8ee4226255</data>
    </node>
    <node id="Morphological Generalization Experiment">
      <data key="d0">Morphological Generalization Experiment</data>
      <data key="d1">event</data>
      <data key="d2">An experimental evaluation designed to assess a model's morphological capability by controlling for lexical semantics.</data>
      <data key="d3">chunk-0ca3ab8f8c0dca0a40d79a8ee4226255</data>
    </node>
    <node id="Ruder">
      <data key="d0">Ruder</data>
      <data key="d1">person</data>
      <data key="d2">Ruder refers to Sebastian Ruder (Ruder et al., 2018), a researcher whose model is evaluated and adapted for bilingual lexicon induction experiments.</data>
      <data key="d3">chunk-874a0fecf572a7885d7353d9aa510123</data>
    </node>
    <node id="Conneau">
      <data key="d0">Conneau</data>
      <data key="d1">person</data>
      <data key="d2">Conneau refers to Alexis Conneau (Conneau et al., 2018), a researcher associated with the development of the MUSE dictionary used in BLI evaluation.</data>
      <data key="d3">chunk-874a0fecf572a7885d7353d9aa510123</data>
    </node>
    <node id="Digital Stylometry">
      <data key="d0">Digital Stylometry</data>
      <data key="d1">category</data>
      <data key="d2">A research area and analytical technique focused on attributing authorship or matching user accounts across social networks based on linguistic style.&lt;SEP&gt;Digital Stylometry is a methodology and field of study that uses computational, temporal, and linguistic patterns to identify and link user accounts across diverse online services.&lt;SEP&gt;Digital Stylometry is a novel methodology combining traditional stylometric techniques with big-data social informatics to link user accounts across social networks based on temporal and linguistic activity.</data>
      <data key="d3">chunk-c18ec95758198fc24e4adbe977b2a821&lt;SEP&gt;chunk-874a0fecf572a7885d7353d9aa510123&lt;SEP&gt;chunk-6cb472a550ed02164d9c3ff8cf171759</data>
    </node>
    <node id="Morphological Constraint">
      <data key="d0">Morphological Constraint</data>
      <data key="d1">category</data>
      <data key="d2">A training-time restriction that allows self-learning alignment models to align word pairs only if they share identical morphosyntactic categories.</data>
      <data key="d3">chunk-874a0fecf572a7885d7353d9aa510123</data>
    </node>
    <node id="Self-Learning Models">
      <data key="d0">Self-Learning Models</data>
      <data key="d1">category</data>
      <data key="d2">Iterative alignment algorithms used in bilingual lexicon induction to learn cross-lingual mappings without exhaustive supervision.</data>
      <data key="d3">chunk-874a0fecf572a7885d7353d9aa510123</data>
    </node>
    <node id="Standard BLI Task">
      <data key="d0">Standard BLI Task</data>
      <data key="d1">category</data>
      <data key="d2">The traditional benchmark evaluation setting for bilingual lexicon induction, which measures word translation accuracy without controlling for morphological forms.</data>
      <data key="d3">chunk-874a0fecf572a7885d7353d9aa510123</data>
    </node>
    <node id="Controlled For Lexeme BLI">
      <data key="d0">Controlled For Lexeme BLI</data>
      <data key="d1">category</data>
      <data key="d2">An experimental evaluation setting designed to measure morphological generalization in bilingual lexicon induction independently of lexeme frequency.</data>
      <data key="d3">chunk-874a0fecf572a7885d7353d9aa510123</data>
    </node>
    <node id="MUSE Dictionary">
      <data key="d0">MUSE Dictionary</data>
      <data key="d1">category</data>
      <data key="d2">A standard multilingual benchmark dictionary created by Conneau et al. used to evaluate bilingual lexicon induction models.</data>
      <data key="d3">chunk-874a0fecf572a7885d7353d9aa510123</data>
    </node>
    <node id="Social Networks">
      <data key="d0">Social Networks</data>
      <data key="d1">category</data>
      <data key="d2">Online platforms and networking sites where individuals maintain user accounts, profiles, and linguistic activity.&lt;SEP&gt;Social networks are online platforms, including Twitter and Facebook, that provide public textual and temporal activity data used to model and identify user accounts.</data>
      <data key="d3">chunk-bc72a8696f96f81ea7b13e31bd1a5bbb&lt;SEP&gt;chunk-874a0fecf572a7885d7353d9aa510123</data>
    </node>
    <node id="User Profiling">
      <data key="d0">User Profiling</data>
      <data key="d1">category</data>
      <data key="d2">The process of linking, matching, and synthesizing aggregate behavioral and linguistic profiles of users across different platforms.</data>
      <data key="d3">chunk-874a0fecf572a7885d7353d9aa510123</data>
    </node>
    <node id="Large-Scale BLI Evaluation">
      <data key="d0">Large-Scale BLI Evaluation</data>
      <data key="d1">event</data>
      <data key="d2">An empirical experimental study conducted using 40 morphologically complete dictionaries across Slavic and Romance languages to evaluate lexicon induction models.</data>
      <data key="d3">chunk-874a0fecf572a7885d7353d9aa510123</data>
    </node>
    <node id="Wincenty Lutosławski">
      <data key="d0">Wincenty Lutosławski</data>
      <data key="d1">person</data>
      <data key="d2">Wincenty Lutosławski was a philosopher who compiled and defined the foundational principles of stylometry in 1890 in his work 'Principes de stylométrie'.</data>
      <data key="d3">chunk-6cb472a550ed02164d9c3ff8cf171759</data>
    </node>
    <node id="Balduzzi">
      <data key="d0">Balduzzi</data>
      <data key="d1">person</data>
      <data key="d2">Balduzzi is a researcher who studied linking user profiles across services using private user data from the Friend Finder system.</data>
      <data key="d3">chunk-6cb472a550ed02164d9c3ff8cf171759</data>
    </node>
    <node id="Renaissance">
      <data key="d0">Renaissance</data>
      <data key="d1">event</data>
      <data key="d2">The Renaissance is a historical cultural era during whose early period the field of stylometry emerged.&lt;SEP&gt;The Renaissance is a historical period to which the origins of traditional stylometry practice are traced.</data>
      <data key="d3">chunk-f72431d36a16227ea7d1db8d40a9ca21&lt;SEP&gt;chunk-6cb472a550ed02164d9c3ff8cf171759</data>
    </node>
    <node id="Stylometry">
      <data key="d0">Stylometry</data>
      <data key="d1">category</data>
      <data key="d2">Stylometry is the field and statistical analysis of variations in literary style between authors or genres, often used to attribute authorship.&lt;SEP&gt;Stylometry is the field of analyzing linguistic style and author habits, providing the foundation for matching user accounts without relying on explicit profile information.&lt;SEP&gt;Stylometry is the field of study dedicated to analyzing linguistic style and authorship attribution, cited as an established discipline developed to address challenges similar to profile matching.</data>
      <data key="d3">chunk-3a58f646da20a5dcef84244d40bf423b&lt;SEP&gt;chunk-f72431d36a16227ea7d1db8d40a9ca21&lt;SEP&gt;chunk-6cb472a550ed02164d9c3ff8cf171759</data>
    </node>
    <node id="Profile Matching">
      <data key="d0">Profile Matching</data>
      <data key="d1">category</data>
      <data key="d2">Profile Matching is the task of identifying and linking multiple accounts belonging to the same individual across different Internet platforms.</data>
      <data key="d3">chunk-6cb472a550ed02164d9c3ff8cf171759</data>
    </node>
    <node id="Social Media Rumor Detection">
      <data key="d0">Social Media Rumor Detection</data>
      <data key="d1">category</data>
      <data key="d2">Social Media Rumor Detection is an application area in social informatics that benefits from cross-network profile matching to track rumor spreaders.</data>
      <data key="d3">chunk-6cb472a550ed02164d9c3ff8cf171759</data>
    </node>
    <node id="Linguistic Models">
      <data key="d0">Linguistic Models</data>
      <data key="d1">category</data>
      <data key="d2">Linguistic models analyze the written style and vocabulary in social media posts to identify authorship traits.&lt;SEP&gt;Linguistic models are analytical frameworks designed to evaluate and compare the writing styles and word choices of users across social networks.</data>
      <data key="d3">chunk-3a58f646da20a5dcef84244d40bf423b&lt;SEP&gt;chunk-6cb472a550ed02164d9c3ff8cf171759</data>
    </node>
    <node id="Temporal Models">
      <data key="d0">Temporal Models</data>
      <data key="d1">category</data>
      <data key="d2">Temporal models analyze the timing and schedule patterns of user activity across platforms to assist in cross-account linkage.&lt;SEP&gt;Temporal models are a class of analytical approaches that use time-based features such as month, day of week, day of month, and hour to identify and match user activity patterns.&lt;SEP&gt;Temporal models are analytical frameworks designed to track and compare the timing and frequency of user posting patterns across different platforms.</data>
      <data key="d3">chunk-bc72a8696f96f81ea7b13e31bd1a5bbb&lt;SEP&gt;chunk-3a58f646da20a5dcef84244d40bf423b&lt;SEP&gt;chunk-6cb472a550ed02164d9c3ff8cf171759</data>
    </node>
    <node id="Temporal-Linguistic Models">
      <data key="d0">Temporal-Linguistic Models</data>
      <data key="d1">category</data>
      <data key="d2">Combined temporal-linguistic models integrate both posting times and linguistic features to achieve optimal user profile matching across networks.</data>
      <data key="d3">chunk-6cb472a550ed02164d9c3ff8cf171759</data>
    </node>
    <node id="Personally Identifiable Information">
      <data key="d0">Personally Identifiable Information</data>
      <data key="d1">category</data>
      <data key="d2">Personally Identifiable Information (PII) encompasses explicit user profile attributes such as screen names, birthdays, and geographic locations.</data>
      <data key="d3">chunk-6cb472a550ed02164d9c3ff8cf171759</data>
    </node>
    <node id="Social Informatics">
      <data key="d0">Social Informatics</data>
      <data key="d1">category</data>
      <data key="d2">Social informatics is an interdisciplinary field focusing on social network analysis and big-data methods, combined here with stylometry.</data>
      <data key="d3">chunk-6cb472a550ed02164d9c3ff8cf171759</data>
    </node>
    <node id="Friend Finder System">
      <data key="d0">Friend Finder System</data>
      <data key="d1">category</data>
      <data key="d2">The Friend Finder system is a contact-matching utility provided by various social networks that leverages private contact data to discover user accounts.</data>
      <data key="d3">chunk-6cb472a550ed02164d9c3ff8cf171759</data>
    </node>
    <node id="Advertising">
      <data key="d0">Advertising</data>
      <data key="d1">category</data>
      <data key="d2">Advertising is a commercial use case cited for aggregated cross-platform user profiling.</data>
      <data key="d3">chunk-6cb472a550ed02164d9c3ff8cf171759</data>
    </node>
    <node id="Background Checks">
      <data key="d0">Background Checks</data>
      <data key="d1">category</data>
      <data key="d2">Background checks are commercial evaluation procedures that utilize aggregated cross-network user profile information.</data>
      <data key="d3">chunk-6cb472a550ed02164d9c3ff8cf171759</data>
    </node>
    <node id="Google Plus">
      <data key="d0">Google Plus</data>
      <data key="d1">organization</data>
      <data key="d2">Google Plus is a social network whose public profiles and API were used as a third-party source to collect ground-truth links between Twitter and Facebook accounts.</data>
      <data key="d3">chunk-3a58f646da20a5dcef84244d40bf423b</data>
    </node>
    <node id="N-gram Language Modelling">
      <data key="d0">N-gram Language Modelling</data>
      <data key="d1">category</data>
      <data key="d2">N-gram language modelling is a statistical language modeling approach that captures word sequences conditioned on preceding words to model individual writing behavior.</data>
      <data key="d3">chunk-3a58f646da20a5dcef84244d40bf423b</data>
    </node>
    <node id="Google Plus API">
      <data key="d0">Google Plus API</data>
      <data key="d1">category</data>
      <data key="d2">The Google Plus API is an application programming interface used to access publicly available profile links connecting Google Plus users to other platforms.</data>
      <data key="d3">chunk-3a58f646da20a5dcef84244d40bf423b</data>
    </node>
    <node id="Twitter API">
      <data key="d0">Twitter API</data>
      <data key="d1">category</data>
      <data key="d2">The Twitter API is an interface utilized to retrieve public posts, linguistic content, and post timestamps from Twitter accounts.</data>
      <data key="d3">chunk-3a58f646da20a5dcef84244d40bf423b</data>
    </node>
    <node id="Facebook API">
      <data key="d0">Facebook API</data>
      <data key="d1">category</data>
      <data key="d2">The Facebook API is an interface used to collect user post contents and associated posting timestamps from public Facebook accounts.</data>
      <data key="d3">chunk-3a58f646da20a5dcef84244d40bf423b</data>
    </node>
    <node id="Combined Temporal-Linguistic Models">
      <data key="d0">Combined Temporal-Linguistic Models</data>
      <data key="d1">category</data>
      <data key="d2">Combined temporal-linguistic models are multi-feature analytical models integrating timing habits and textual stylometry to rank candidate matching accounts across social networks.</data>
      <data key="d3">chunk-3a58f646da20a5dcef84244d40bf423b</data>
    </node>
    <node id="Baseline Random Choice Ranker">
      <data key="d0">Baseline Random Choice Ranker</data>
      <data key="d1">category</data>
      <data key="d2">The baseline random choice ranker is a benchmark ranking model that serves as a comparison standard, assigning an expected accuracy of 1/N.</data>
      <data key="d3">chunk-3a58f646da20a5dcef84244d40bf423b</data>
    </node>
    <node id="User Activity Patterns">
      <data key="d0">User Activity Patterns</data>
      <data key="d1">category</data>
      <data key="d2">User activity patterns encompass behavioral metrics consisting of linguistic expression and temporal posting habits across social media services.</data>
      <data key="d3">chunk-3a58f646da20a5dcef84244d40bf423b</data>
    </node>
    <node id="N-gram Models">
      <data key="d0">N-gram Models</data>
      <data key="d1">category</data>
      <data key="d2">N-gram Models are a category of language models that approximate sequence probabilities using context from preceding words.</data>
      <data key="d3">chunk-9539a4c4fcbd235bc0ccbc8f3fd26a81</data>
    </node>
    <node id="Unigram Model">
      <data key="d0">Unigram Model</data>
      <data key="d1">category</data>
      <data key="d2">A unigram model is a type of n-gram language model where n=1, estimating word probabilities independently without relying on preceding context words.&lt;SEP&gt;A unigram model is a type of probabilistic language model where word order is disregarded, utilized here to represent both linguistic and temporal features.</data>
      <data key="d3">chunk-9539a4c4fcbd235bc0ccbc8f3fd26a81&lt;SEP&gt;chunk-f72431d36a16227ea7d1db8d40a9ca21</data>
    </node>
    <node id="Bigram Model">
      <data key="d0">Bigram Model</data>
      <data key="d1">category</data>
      <data key="d2">A bigram model is a type of n-gram language model where n=2, estimating the probability of a word conditioned on the single immediately preceding word.</data>
      <data key="d3">chunk-9539a4c4fcbd235bc0ccbc8f3fd26a81</data>
    </node>
    <node id="Witten-Bell Smoothing">
      <data key="d0">Witten-Bell Smoothing</data>
      <data key="d1">category</data>
      <data key="d2">A statistical smoothing technique used to adjust probability distributions by discounting observed words and allocating probability mass to unobserved vocabulary terms based on observed word types.&lt;SEP&gt;Witten-Bell smoothing is a statistical language modeling technique used to calculate probability distributions across the linguistic and temporal models in the study.</data>
      <data key="d3">chunk-9539a4c4fcbd235bc0ccbc8f3fd26a81&lt;SEP&gt;chunk-f72431d36a16227ea7d1db8d40a9ca21</data>
    </node>
    <node id="Kullback-Leibler Divergence">
      <data key="d0">Kullback-Leibler Divergence</data>
      <data key="d1">category</data>
      <data key="d2">A statistical distance metric measuring the dissimilarity between two probability distributions, adapted in symmetric form to quantify differences between language models of user accounts.</data>
      <data key="d3">chunk-9539a4c4fcbd235bc0ccbc8f3fd26a81</data>
    </node>
    <node id="Cross-Entropy">
      <data key="d0">Cross-Entropy</data>
      <data key="d1">category</data>
      <data key="d2">A measure of the difference between two probability distributions over the same set of events, used directly in the calculation of perplexity.</data>
      <data key="d3">chunk-9539a4c4fcbd235bc0ccbc8f3fd26a81</data>
    </node>
    <node id="Confusion Model">
      <data key="d0">Confusion Model</data>
      <data key="d1">category</data>
      <data key="d2">A novel algorithmic matching model developed by the authors that achieved high accuracy in user matching and substantially outperformed human judges as well as standard models.&lt;SEP&gt;A novel method proposed by the authors for measuring similarity between texts without relying directly on standard n-gram models.&lt;SEP&gt;A theoretically motivated probabilistic similarity model that evaluates the likelihood that one user account will be confused with another based on word distribution and mutual information.&lt;SEP&gt;The confusion model is a predictive modeling technique evaluated in the study that demonstrated the highest accuracy in linking user profiles across Twitter and Facebook, outperforming other methods.</data>
      <data key="d3">chunk-bc72a8696f96f81ea7b13e31bd1a5bbb&lt;SEP&gt;chunk-9539a4c4fcbd235bc0ccbc8f3fd26a81&lt;SEP&gt;chunk-c18ec95758198fc24e4adbe977b2a821&lt;SEP&gt;chunk-f72431d36a16227ea7d1db8d40a9ca21</data>
    </node>
    <node id="Account Matching Models">
      <data key="d0">Account Matching Models</data>
      <data key="d1">category</data>
      <data key="d2">Account matching models encompass heuristic and statistical techniques, including TF-IDF and confusion models, used to link accounts across platforms based on characteristic textual content.</data>
      <data key="d3">chunk-bc72a8696f96f81ea7b13e31bd1a5bbb</data>
    </node>
    <node id="Inverse Document Frequency">
      <data key="d0">Inverse Document Frequency</data>
      <data key="d1">category</data>
      <data key="d2">A metric and weighting factor incorporated in text analysis that diminishes the weight of common terms and increases the weight of rare terms across a corpus.</data>
      <data key="d3">chunk-bc72a8696f96f81ea7b13e31bd1a5bbb</data>
    </node>
    <node id="Mutual Information">
      <data key="d0">Mutual Information</data>
      <data key="d1">category</data>
      <data key="d2">An information theory metric used to measure the strength of statistical association between random variables representing true users and guessed users.</data>
      <data key="d3">chunk-bc72a8696f96f81ea7b13e31bd1a5bbb</data>
    </node>
    <node id="Multinomial Distribution">
      <data key="d0">Multinomial Distribution</data>
      <data key="d1">category</data>
      <data key="d2">A probability distribution used in the auxiliary generative model to select users and words generating tokens in the corpus.</data>
      <data key="d3">chunk-bc72a8696f96f81ea7b13e31bd1a5bbb</data>
    </node>
    <node id="Dirichlet Distribution">
      <data key="d0">Dirichlet Distribution</data>
      <data key="d1">category</data>
      <data key="d2">A family of multivariate continuous probability distributions used as prior distributions over multinomial distributions in the confusion model.</data>
      <data key="d3">chunk-bc72a8696f96f81ea7b13e31bd1a5bbb</data>
    </node>
    <node id="Temporal Features">
      <data key="d0">Temporal Features</data>
      <data key="d1">category</data>
      <data key="d2">A set of discrete time-based activity features categorized into 74 bins covering month, day of the month, day of the week, and hour of the day.</data>
      <data key="d3">chunk-bc72a8696f96f81ea7b13e31bd1a5bbb</data>
    </node>
    <node id="Spatial Information">
      <data key="d0">Spatial Information</data>
      <data key="d1">category</data>
      <data key="d2">Contextual geographic location data shown in research to correlate with people's linguistic activities on social media.</data>
      <data key="d3">chunk-bc72a8696f96f81ea7b13e31bd1a5bbb</data>
    </node>
    <node id="Human Judges">
      <data key="d0">Human Judges</data>
      <data key="d1">person</data>
      <data key="d2">A group of three English-speaking evaluators recruited from Amazon Mechanical Turk to manually identify matching user profiles across social networks.&lt;SEP&gt;Human evaluators tested against computational models in the user account matching task, achieving an average accuracy of 0.60 and a top accuracy of 0.69.</data>
      <data key="d3">chunk-c18ec95758198fc24e4adbe977b2a821&lt;SEP&gt;chunk-f72431d36a16227ea7d1db8d40a9ca21</data>
    </node>
    <node id="Urban Scaling">
      <data key="d0">Urban Scaling</data>
      <data key="d1">category</data>
      <data key="d2">Urban Scaling refers to the statistical relationships and scaling properties observing how urban attributes, including communication volume and vocabulary, vary with city population.&lt;SEP&gt;Urban scaling is a theoretical concept and scientific framework describing how aggregate socioeconomic, communication, and linguistic metrics vary nonlinearly with city population size.&lt;SEP&gt;Urban scaling is a theoretical framework describing how socioeconomic, infrastructural, and linguistic measures vary non-linearly with city population size.</data>
      <data key="d3">chunk-d46bdf96e3fc5df8745fb87337fae5aa&lt;SEP&gt;chunk-c18ec95758198fc24e4adbe977b2a821&lt;SEP&gt;chunk-17facb3b5ef194b17b64104e94f4e83d</data>
    </node>
    <node id="Zipf's Law">
      <data key="d0">Zipf's Law</data>
      <data key="d1">category</data>
      <data key="d2">A statistical power-law distribution relating word frequency to rank, whose scaling exponent decreases as urban area population and text volume increase.&lt;SEP&gt;Zipf's Law is an empirical linguistic law formulating word frequency distribution, investigated within Twitter corpora to observe changes across different city sizes.&lt;SEP&gt;Zipf's Law is an empirical linguistic law governing word frequency distributions whose exponent was measured and evaluated across citywise Twitter corpora.&lt;SEP&gt;Zipf's law is an empirical linguistic distribution law whose parameters and exponents are evaluated across varying city sizes.&lt;SEP&gt;Zipf's law is an empirical statistical principle in linguistics that relates word frequency to its rank or probability distribution.</data>
      <data key="d3">chunk-d46bdf96e3fc5df8745fb87337fae5aa&lt;SEP&gt;chunk-05fedd4164c9b7124d9a3db12915651a&lt;SEP&gt;chunk-7a96f0a5c9cb8a4b3ffecae493bed473&lt;SEP&gt;chunk-17facb3b5ef194b17b64104e94f4e83d&lt;SEP&gt;chunk-c18ec95758198fc24e4adbe977b2a821</data>
    </node>
    <node id="Heaps' Law">
      <data key="d0">Heaps' Law</data>
      <data key="d1">category</data>
      <data key="d2">Heaps' Law is an empirical law modeling the scaling between vocabulary size and text volume, examined for structural deviations within digital Twitter text.&lt;SEP&gt;Heaps' law is a power-law relationship describing vocabulary growth in text, examined on Twitter to show decelerating growth of distinct tokens with city size.</data>
      <data key="d3">chunk-d46bdf96e3fc5df8745fb87337fae5aa&lt;SEP&gt;chunk-c18ec95758198fc24e4adbe977b2a821</data>
    </node>
    <node id="Metropolitan And Micropolitan Statistical Areas">
      <data key="d0">Metropolitan And Micropolitan Statistical Areas</data>
      <data key="d1">geo</data>
      <data key="d2">Geographic entities defined in the United States representing urban and suburban centers used to aggregate citywise Twitter corpora.</data>
      <data key="d3">chunk-c18ec95758198fc24e4adbe977b2a821</data>
    </node>
    <node id="Opinion Mining">
      <data key="d0">Opinion Mining</data>
      <data key="d1">category</data>
      <data key="d2">A computational natural language processing technique planned for future integration into digital stylometry systems.</data>
      <data key="d3">chunk-c18ec95758198fc24e4adbe977b2a821</data>
    </node>
    <node id="Superlinear Scaling">
      <data key="d0">Superlinear Scaling</data>
      <data key="d1">category</data>
      <data key="d2">Superlinear scaling is a regime where a metric increases at a faster rate than the base variable, observed in word frequency growth rates and total volume of tweets across city sizes.&lt;SEP&gt;Superlinear scaling refers to a nonlinear scaling regime where aggregate quantities, such as total tweet count and word volume, grow faster than city population size.&lt;SEP&gt;Superlinear scaling refers to urban scaling relationships where a quantity grows disproportionately faster than population size, often linked to innovation and wealth.</data>
      <data key="d3">chunk-d46bdf96e3fc5df8745fb87337fae5aa&lt;SEP&gt;chunk-05fedd4164c9b7124d9a3db12915651a&lt;SEP&gt;chunk-17facb3b5ef194b17b64104e94f4e83d</data>
    </node>
    <node id="Sublinear Scaling">
      <data key="d0">Sublinear Scaling</data>
      <data key="d1">category</data>
      <data key="d2">Sublinear scaling describes a regime where an aggregate metric grows more slowly than population size, observed in the scaling of Twitter user counts with city size.&lt;SEP&gt;Sublinear scaling is a regime where an observed metric grows at a proportionally slower rate than the independent variable, observed in vocabulary size and distinct words relative to city population.&lt;SEP&gt;Sublinear scaling refers to urban scaling relationships where a quantity grows slower than population size, typically reflecting infrastructural efficiency.</data>
      <data key="d3">chunk-d46bdf96e3fc5df8745fb87337fae5aa&lt;SEP&gt;chunk-05fedd4164c9b7124d9a3db12915651a&lt;SEP&gt;chunk-17facb3b5ef194b17b64104e94f4e83d</data>
    </node>
    <node id="Online Social Networks">
      <data key="d0">Online Social Networks</data>
      <data key="d1">category</data>
      <data key="d2">Online social networks (OSNs) are digital platforms whose message texts, metadata, and spatial variations are studied to understand linguistic patterns, user localization, and public mood.</data>
      <data key="d3">chunk-d46bdf96e3fc5df8745fb87337fae5aa</data>
    </node>
    <node id="City Size">
      <data key="d0">City Size</data>
      <data key="d1">category</data>
      <data key="d2">City size refers to the population magnitude of an urban settlement, serving as a primary independent variable in urban scaling laws.</data>
      <data key="d3">chunk-d46bdf96e3fc5df8745fb87337fae5aa</data>
    </node>
    <node id="Scaling Exponent">
      <data key="d0">Scaling Exponent</data>
      <data key="d1">category</data>
      <data key="d2">A scaling exponent is a mathematical power-law parameter that quantifies the dynamics and sensitivity of an urban indicator or word frequency relative to population size.</data>
      <data key="d3">chunk-d46bdf96e3fc5df8745fb87337fae5aa</data>
    </node>
    <node id="Linear Scaling">
      <data key="d0">Linear Scaling</data>
      <data key="d1">category</data>
      <data key="d2">Linear scaling is a proportional relationship regime evaluated in statistical models alongside sublinear and superlinear regimes.&lt;SEP&gt;Linear scaling is an urban scaling regime where a socioeconomic quantity is directly proportional to population size, commonly associated with individual human needs like housing and jobs.</data>
      <data key="d3">chunk-d46bdf96e3fc5df8745fb87337fae5aa&lt;SEP&gt;chunk-05fedd4164c9b7124d9a3db12915651a</data>
    </node>
    <node id="Hierarchical Triangular Mesh">
      <data key="d0">Hierarchical Triangular Mesh</data>
      <data key="d1">category</data>
      <data key="d2">Hierarchical Triangular Mesh is a practical geographic spatial indexing scheme utilized to map coordinates of tweets to specific geographical subdivisions.</data>
      <data key="d3">chunk-d46bdf96e3fc5df8745fb87337fae5aa</data>
    </node>
    <node id="Metropolitan Statistical Areas">
      <data key="d0">Metropolitan Statistical Areas</data>
      <data key="d1">geo</data>
      <data key="d2">Metropolitan Statistical Areas (MSAs) are aggregated urban regions in the United States defined by economic and population integration, used to analyze urban scaling.</data>
      <data key="d3">chunk-d46bdf96e3fc5df8745fb87337fae5aa</data>
    </node>
    <node id="US Counties">
      <data key="d0">US Counties</data>
      <data key="d1">geo</data>
      <data key="d2">US Counties are administrative subdivisions across the United States to which geolocated tweets were mapped using spatial indexing.</data>
      <data key="d3">chunk-d46bdf96e3fc5df8745fb87337fae5aa</data>
    </node>
    <node id="GADM Database">
      <data key="d0">GADM Database</data>
      <data key="d1">organization</data>
      <data key="d2">GADM is a database of global administrative boundaries from which US county borders were extracted for spatial data matching.</data>
      <data key="d3">chunk-d46bdf96e3fc5df8745fb87337fae5aa</data>
    </node>
    <node id="Path.com">
      <data key="d0">Path.com</data>
      <data key="d1">organization</data>
      <data key="d2">Path.com is a third-party social networking service whose associated post URLs were retained during the Twitter dataset filtering process.</data>
      <data key="d3">chunk-d46bdf96e3fc5df8745fb87337fae5aa</data>
    </node>
    <node id="Leitao">
      <data key="d0">Leitao</data>
      <data key="d1">person</data>
      <data key="d2">Leitao is a researcher who, along with colleagues, proposed the 'Person Model' used to model scaling relations and output conservation across urban populations.</data>
      <data key="d3">chunk-17facb3b5ef194b17b64104e94f4e83d</data>
    </node>
    <node id="Person Model">
      <data key="d0">Person Model</data>
      <data key="d1">category</data>
      <data key="d2">The Person Model is a statistical maximum likelihood estimation (MLE) model used to fit user scaling, message volume, and word counts against metropolitan population.&lt;SEP&gt;The Person Model is a theoretical framework introduced by Leitao et al. that models urban scaling as a consequence of individual probability scaling and conservation of aggregate output across cities.</data>
      <data key="d3">chunk-05fedd4164c9b7124d9a3db12915651a&lt;SEP&gt;chunk-17facb3b5ef194b17b64104e94f4e83d</data>
    </node>
    <node id="Bayesian Information Criterion">
      <data key="d0">Bayesian Information Criterion</data>
      <data key="d1">category</data>
      <data key="d2">The Bayesian Information Criterion (BIC) is a statistical metric used to assess model fit and confirm the presence of nonlinear versus linear scaling.</data>
      <data key="d3">chunk-17facb3b5ef194b17b64104e94f4e83d</data>
    </node>
    <node id="Python">
      <data key="d0">Python</data>
      <data key="d1">category</data>
      <data key="d2">Python is a programming language used for data analysis and scientific computing, hosting the powerlaw package utilized in the study.</data>
      <data key="d3">chunk-17facb3b5ef194b17b64104e94f4e83d</data>
    </node>
    <node id="Powerlaw Package">
      <data key="d0">Powerlaw Package</data>
      <data key="d1">category</data>
      <data key="d2">The powerlaw package is a Python software library that implements Maximum Likelihood methods to fit power-law distributions to empirical data.</data>
      <data key="d3">chunk-17facb3b5ef194b17b64104e94f4e83d</data>
    </node>
    <node id="Maximum Likelihood Method">
      <data key="d0">Maximum Likelihood Method</data>
      <data key="d1">category</data>
      <data key="d2">The Maximum Likelihood method is a statistical approach employed by the powerlaw package to determine the best-fit parameters for empirical frequency distributions.</data>
      <data key="d3">chunk-17facb3b5ef194b17b64104e94f4e83d</data>
    </node>
    <node id="Kolmogorov-Smirnov Distance">
      <data key="d0">Kolmogorov-Smirnov Distance</data>
      <data key="d1">category</data>
      <data key="d2">The Kolmogorov-Smirnov distance is a statistical metric used to find the optimal lower-bound frequency threshold for power-law distribution fitting.</data>
      <data key="d3">chunk-17facb3b5ef194b17b64104e94f4e83d</data>
    </node>
    <node id="Mobile Communication Network">
      <data key="d0">Mobile Communication Network</data>
      <data key="d1">category</data>
      <data key="d2">A mobile communication network is a telecommunications network referenced in previous literature to compare human communication scaling behavior with social media platforms.</data>
      <data key="d3">chunk-17facb3b5ef194b17b64104e94f4e83d</data>
    </node>
    <node id="Walmart">
      <data key="d0">Walmart</data>
      <data key="d1">organization</data>
      <data key="d2">Walmart is a retail corporation whose name appears as an example of a sublinearly scaling word in urban Twitter text.</data>
      <data key="d3">chunk-7a96f0a5c9cb8a4b3ffecae493bed473</data>
    </node>
    <node id="Urban Areas">
      <data key="d0">Urban Areas</data>
      <data key="d1">geo</data>
      <data key="d2">Urban Areas refers to cities and metropolitan centers whose population sizes are evaluated against word frequency scaling and vocabulary diversity.</data>
      <data key="d3">chunk-7a96f0a5c9cb8a4b3ffecae493bed473</data>
    </node>
    <node id="MSA Areas">
      <data key="d0">MSA Areas</data>
      <data key="d1">geo</data>
      <data key="d2">MSA Areas (Metropolitan Statistical Areas) are geographic regions used to measure demographic distributions and scaling relationships with linguistic data.</data>
      <data key="d3">chunk-7a96f0a5c9cb8a4b3ffecae493bed473</data>
    </node>
    <node id="Hispanic Or Latino Population">
      <data key="d0">Hispanic Or Latino Population</data>
      <data key="d1">category</data>
      <data key="d2">Hispanic Or Latino Population is an ethnic demographic group whose urban presence is examined in relation to superlinearly scaling Spanish vocabulary in metropolitan areas.</data>
      <data key="d3">chunk-7a96f0a5c9cb8a4b3ffecae493bed473</data>
    </node>
    <node id="Linear Scaling Category">
      <data key="d0">Linear Scaling Category</data>
      <data key="d1">category</data>
      <data key="d2">Linear Scaling Category is a classification of words whose frequency scales proportionally with city size, representing a core Twitter vocabulary and common English words.</data>
      <data key="d3">chunk-7a96f0a5c9cb8a4b3ffecae493bed473</data>
    </node>
    <node id="Sublinear Scaling Regime">
      <data key="d0">Sublinear Scaling Regime</data>
      <data key="d1">category</data>
      <data key="d2">Sublinear Scaling Regime is a category of words whose relative frequency decreases as city size increases, often associated with weather reports, outdoor activities, and rural slang.</data>
      <data key="d3">chunk-7a96f0a5c9cb8a4b3ffecae493bed473</data>
    </node>
    <node id="Superlinear Scaling Regime">
      <data key="d0">Superlinear Scaling Regime</data>
      <data key="d1">category</data>
      <data key="d2">Superlinear Scaling Regime is a category of words that become disproportionately more prevalent in larger cities, including Spanish words, flight status terms, and urban lifestyle vocabulary.</data>
      <data key="d3">chunk-7a96f0a5c9cb8a4b3ffecae493bed473</data>
    </node>
    <node id="Core-Twitter Vocabulary">
      <data key="d0">Core-Twitter Vocabulary</data>
      <data key="d1">category</data>
      <data key="d2">A group of highly common English words, Twitter-specific abbreviations, and select slang terms that fit the linear scaling model and appear homogeneously across all urban areas.</data>
      <data key="d3">chunk-7a96f0a5c9cb8a4b3ffecae493bed473</data>
    </node>
    <node id="Weather Services Reporting">
      <data key="d0">Weather Services Reporting</data>
      <data key="d1">category</data>
      <data key="d2">A semantic category of sublinearly scaling terms such as flood, thunderstorm, and wind, reflecting weather-related postings on social media.</data>
      <data key="d3">chunk-7a96f0a5c9cb8a4b3ffecae493bed473</data>
    </node>
    <node id="Outdoor-Related Activities">
      <data key="d0">Outdoor-Related Activities</data>
      <data key="d1">category</data>
      <data key="d2">A semantic category of sublinear words including fishing, deer, truck, and hunting, reflecting activities and features less prevalent in densely populated urban centers.</data>
      <data key="d3">chunk-7a96f0a5c9cb8a4b3ffecae493bed473</data>
    </node>
    <node id="Flight-Reporting">
      <data key="d0">Flight-Reporting</data>
      <data key="d1">category</data>
      <data key="d2">A category of superlinearly scaling terms such as flight and delayed, heavily associated with airport hubs and large urban travel networks.</data>
      <data key="d3">chunk-7a96f0a5c9cb8a4b3ffecae493bed473</data>
    </node>
    <node id="Lifestyle-Related Words">
      <data key="d0">Lifestyle-Related Words</data>
      <data key="d1">category</data>
      <data key="d2">A group of superlinearly scaling terms representing metropolitan lifestyle and commerce, including fitness, fashion, restaurant, and traffic.</data>
      <data key="d3">chunk-7a96f0a5c9cb8a4b3ffecae493bed473</data>
    </node>
    <node id="Spanish Words">
      <data key="d0">Spanish Words</data>
      <data key="d1">category</data>
      <data key="d2">A linguistic group of terms such as gracias, por, and para that scale superlinearly, reflecting the linguistic presence of Hispanic populations in larger cities.</data>
      <data key="d3">chunk-7a96f0a5c9cb8a4b3ffecae493bed473</data>
    </node>
    <node id="Slang And Swearwords">
      <data key="d0">Slang And Swearwords</data>
      <data key="d1">category</data>
      <data key="d2">Colloquial and profanity terms that appear at both ends of the scaling distribution, showing shifts in specific forms of expression between smaller and larger urban areas.</data>
      <data key="d3">chunk-7a96f0a5c9cb8a4b3ffecae493bed473</data>
    </node>
    <node id="Communication Efficiency Framework">
      <data key="d0">Communication Efficiency Framework</data>
      <data key="d1">category</data>
      <data key="d2">A theoretical framework explaining variations in Zipf's law exponent in terms of communicative effort, reader comprehension, and vocabulary diversity.&lt;SEP&gt;The communication efficiency framework is a theoretical linguistic framework positing that an increased variety of distinct tokens decreases communication efficiency by requiring more comprehension effort.</data>
      <data key="d3">chunk-05fedd4164c9b7124d9a3db12915651a&lt;SEP&gt;chunk-7a96f0a5c9cb8a4b3ffecae493bed473</data>
    </node>
    <node id="Metropolitan Statistical Area">
      <data key="d0">Metropolitan Statistical Area</data>
      <data key="d1">geo</data>
      <data key="d2">Metropolitan Statistical Areas (MSAs) are geographic entities in the United States used to evaluate urban population scaling against Twitter vocabulary size and message volume.</data>
      <data key="d3">chunk-05fedd4164c9b7124d9a3db12915651a</data>
    </node>
    <node id="Linguistic Laws">
      <data key="d0">Linguistic Laws</data>
      <data key="d1">category</data>
      <data key="d2">Linguistic laws are statistical relationships and patterns governing language use and vocabulary scaling, which are influenced by communication media such as Twitter.</data>
      <data key="d3">chunk-05fedd4164c9b7124d9a3db12915651a</data>
    </node>
    <node id="Micropolitan Statistical Area">
      <data key="d0">Micropolitan Statistical Area</data>
      <data key="d1">geo</data>
      <data key="d2">Micropolitan Statistical Areas are geographic regions in the United States used alongside Metropolitan Statistical Areas to evaluate city-level scaling of Twitter corpora.</data>
      <data key="d3">chunk-05fedd4164c9b7124d9a3db12915651a</data>
    </node>
    <node id="Logistic Regression Classifier">
      <data key="d0">Logistic Regression Classifier</data>
      <data key="d1">category</data>
      <data key="d2">A logistic regression classifier is a machine learning algorithm trained on semantic and syntactic features of manually labelled tweets to predict speech act categories.</data>
      <data key="d3">chunk-05fedd4164c9b7124d9a3db12915651a</data>
    </node>
    <node id="Multi-Class Classification">
      <data key="d0">Multi-Class Classification</data>
      <data key="d1">category</data>
      <data key="d2">Multi-class classification is a computational categorization framework applied to classify tweets into one of six distinct speech act classes.</data>
      <data key="d3">chunk-05fedd4164c9b7124d9a3db12915651a</data>
    </node>
    <node id="Tweet Acts">
      <data key="d0">Tweet Acts</data>
      <data key="d1">category</data>
      <data key="d2">Tweet Acts is a speech act classifier system and research study designed to identify speech act categories within social media posts on Twitter.</data>
      <data key="d3">chunk-05fedd4164c9b7124d9a3db12915651a</data>
    </node>
    <node id="Social And Behavioural Studies">
      <data key="d0">Social And Behavioural Studies</data>
      <data key="d1">category</data>
      <data key="d2">Social and behavioural studies encompass academic research analyzing public Twitter data to investigate human interaction and communication behavior.</data>
      <data key="d3">chunk-05fedd4164c9b7124d9a3db12915651a</data>
    </node>
    <node id="Austin">
      <data key="d0">Austin</data>
      <data key="d1">person</data>
      <data key="d2">Austin is a linguistic philosopher who originally proposed speech act theory to study pragmatics and communicative acts.</data>
      <data key="d3">chunk-f0e231c4e3067b98ab534052d00f25e1</data>
    </node>
    <node id="Searle">
      <data key="d0">Searle</data>
      <data key="d1">person</data>
      <data key="d2">Searle is a philosopher of language who refined Austin's speech act theory and established a formalized taxonomy of communicative speech acts.</data>
      <data key="d3">chunk-f0e231c4e3067b98ab534052d00f25e1</data>
    </node>
    <node id="Zhao et al.">
      <data key="d0">Zhao et al.</data>
      <data key="d1">person</data>
      <data key="d2">Zhao et al. are researchers who formulated definitions for topic and topic types in microblog analysis.</data>
      <data key="d3">chunk-f0e231c4e3067b98ab534052d00f25e1</data>
    </node>
    <node id="Boston Marathon Bombings">
      <data key="d0">Boston Marathon Bombings</data>
      <data key="d1">event</data>
      <data key="d2">The Boston Marathon bombings is a historical news event cited as an example of an event-oriented topic discussed on Twitter.</data>
      <data key="d3">chunk-f0e231c4e3067b98ab534052d00f25e1</data>
    </node>
    <node id="Ferguson Riots">
      <data key="d0">Ferguson Riots</data>
      <data key="d1">event</data>
      <data key="d2">The Ferguson riots refer to civil unrest referenced via the query #fergusonriots as a dataset collection topic on Twitter.</data>
      <data key="d3">chunk-f0e231c4e3067b98ab534052d00f25e1</data>
    </node>
    <node id="Red Sox">
      <data key="d0">Red Sox</data>
      <data key="d1">organization</data>
      <data key="d2">Red Sox is a professional baseball team referenced as an example of a topic-specific term excluded from general n-gram features.&lt;SEP&gt;The Boston Red Sox is a professional baseball team referenced as an entity-oriented topic analyzed in Twitter data.</data>
      <data key="d3">chunk-652b9cdc03c6ea8c4e866d6c6a6062ca&lt;SEP&gt;chunk-f0e231c4e3067b98ab534052d00f25e1</data>
    </node>
    <node id="Ashton Kutcher">
      <data key="d0">Ashton Kutcher</data>
      <data key="d1">person</data>
      <data key="d2">Ashton Kutcher is a public figure and actor used as an example of an entity-oriented topic discussed on Twitter.</data>
      <data key="d3">chunk-f0e231c4e3067b98ab534052d00f25e1</data>
    </node>
    <node id="Speech Act Taxonomy">
      <data key="d0">Speech Act Taxonomy</data>
      <data key="d1">category</data>
      <data key="d2">A formalized classification system for communicative acts, adapted from Searle to classify speech acts such as assertions, questions, and requests on Twitter.</data>
      <data key="d3">chunk-f0e231c4e3067b98ab534052d00f25e1</data>
    </node>
    <node id="Entity-Oriented Topics">
      <data key="d0">Entity-Oriented Topics</data>
      <data key="d1">category</data>
      <data key="d2">A topic type defined by Zhao et al. that focuses on specific entities, characterized by higher proportions of assertions and expressions.</data>
      <data key="d3">chunk-f0e231c4e3067b98ab534052d00f25e1</data>
    </node>
    <node id="Event-Oriented Topics">
      <data key="d0">Event-Oriented Topics</data>
      <data key="d1">category</data>
      <data key="d2">A topic type defined by Zhao et al. centered on specific occurrences, showing speech act distributions similar to entity-oriented topics.</data>
      <data key="d3">chunk-f0e231c4e3067b98ab534052d00f25e1</data>
    </node>
    <node id="Long-Standing Topics">
      <data key="d0">Long-Standing Topics</data>
      <data key="d1">category</data>
      <data key="d2">A topic type defined by Zhao et al. that involves commonly discussed, opinion-heavy subjects exhibiting higher frequencies of recommendations.</data>
      <data key="d3">chunk-f0e231c4e3067b98ab534052d00f25e1</data>
    </node>
    <node id="Ferguson">
      <data key="d0">Ferguson</data>
      <data key="d1">geo</data>
      <data key="d2">Ferguson is a city in Missouri, United States, known as the location of the Ferguson riots discussed on Twitter.</data>
      <data key="d3">chunk-f0e231c4e3067b98ab534052d00f25e1</data>
    </node>
    <node id="Pragmatics">
      <data key="d0">Pragmatics</data>
      <data key="d1">category</data>
      <data key="d2">A subfield of linguistics focused on how context, intention, and communicative acts contribute to meaning beyond the literal words spoken or written.</data>
      <data key="d3">chunk-f0e231c4e3067b98ab534052d00f25e1</data>
    </node>
    <node id="Assertion">
      <data key="d0">Assertion</data>
      <data key="d1">category</data>
      <data key="d2">A primary speech act category in Searle's taxonomy and the Twitter classification model, conveying facts, claims, or beliefs.</data>
      <data key="d3">chunk-f0e231c4e3067b98ab534052d00f25e1</data>
    </node>
    <node id="Recommendation Expression">
      <data key="d0">Recommendation Expression</data>
      <data key="d1">category</data>
      <data key="d2">A category within the speech act taxonomy for Twitter, encompassing opinions, evaluations, and recommendations, dominant in long-standing topics.</data>
      <data key="d3">chunk-f0e231c4e3067b98ab534052d00f25e1</data>
    </node>
    <node id="Request">
      <data key="d0">Request</data>
      <data key="d1">category</data>
      <data key="d2">A speech act category representing an appeal, demand, or instruction directed to others to prompt an action.</data>
      <data key="d3">chunk-f0e231c4e3067b98ab534052d00f25e1</data>
    </node>
    <node id="Miscellaneous">
      <data key="d0">Miscellaneous</data>
      <data key="d1">category</data>
      <data key="d2">A catch-all speech act classification for tweets that do not fit into the other defined categories.</data>
      <data key="d3">chunk-f0e231c4e3067b98ab534052d00f25e1</data>
    </node>
    <node id="Semantic Features">
      <data key="d0">Semantic Features</data>
      <data key="d1">category</data>
      <data key="d2">A broad group of model features derived from the meaning and semantic content of tweets to train classification algorithms.&lt;SEP&gt;A category of meaning-based linguistic features evaluated in speech act classification models.&lt;SEP&gt;Semantic Features is a broad category of 1,647 binary classification features based on meaning, including opinion words, vulgar words, emoticons, speech act verbs, and n-grams.</data>
      <data key="d3">chunk-652b9cdc03c6ea8c4e866d6c6a6062ca&lt;SEP&gt;chunk-f0e231c4e3067b98ab534052d00f25e1&lt;SEP&gt;chunk-1e9f52662c01528fd8d607b1462c48df</data>
    </node>
    <node id="Syntactic Features">
      <data key="d0">Syntactic Features</data>
      <data key="d1">category</data>
      <data key="d2">A category of linguistic features derived from grammatical structure, including dependency sub-trees and part-of-speech tags.&lt;SEP&gt;A group of computational features based on grammatical structure, tweet syntax, and linguistic form used for machine learning classification.&lt;SEP&gt;Syntactic Features is a broad category of 1,666 binary classification features based on structural and grammatical patterns, including punctuation, Twitter-specific characters, abbreviations, and dependency sub-trees.</data>
      <data key="d3">chunk-652b9cdc03c6ea8c4e866d6c6a6062ca&lt;SEP&gt;chunk-f0e231c4e3067b98ab534052d00f25e1&lt;SEP&gt;chunk-1e9f52662c01528fd8d607b1462c48df</data>
    </node>
    <node id="Wierzbicka">
      <data key="d0">Wierzbicka</data>
      <data key="d1">person</data>
      <data key="d2">Wierzbicka is a linguist or researcher who compiled a collection of 229 English speech act verbs categorized into 37 groups.</data>
      <data key="d3">chunk-652b9cdc03c6ea8c4e866d6c6a6062ca</data>
    </node>
    <node id="Owoputi et al.">
      <data key="d0">Owoputi et al.</data>
      <data key="d1">person</data>
      <data key="d2">Owoputi et al. are researchers who developed a Twitter part-of-speech tagger used to identify verbs in tweets.</data>
      <data key="d3">chunk-652b9cdc03c6ea8c4e866d6c6a6062ca</data>
    </node>
    <node id="Crystal">
      <data key="d0">Crystal</data>
      <data key="d1">person</data>
      <data key="d2">Crystal is an author and linguist who wrote a book on language used on the internet, from which abbreviations were collected.</data>
      <data key="d3">chunk-652b9cdc03c6ea8c4e866d6c6a6062ca</data>
    </node>
    <node id="Kong et al.">
      <data key="d0">Kong et al.</data>
      <data key="d1">person</data>
      <data key="d2">Kong et al. are researchers who created TweeboParser, a Twitter dependency parser for English.</data>
      <data key="d3">chunk-652b9cdc03c6ea8c4e866d6c6a6062ca</data>
    </node>
    <node id="Harvard General Inquirer">
      <data key="d0">Harvard General Inquirer</data>
      <data key="d1">organization</data>
      <data key="d2">The Harvard General Inquirer is an academic project and lexicon commonly used in sentiment classification tasks to identify positive and negative opinion words.</data>
      <data key="d3">chunk-652b9cdc03c6ea8c4e866d6c6a6062ca</data>
    </node>
    <node id="Porter">
      <data key="d0">Porter</data>
      <data key="d1">person</data>
      <data key="d2">Porter refers to the creator of the Porter Stemming algorithm, used to stem verbs in the study.</data>
      <data key="d3">chunk-652b9cdc03c6ea8c4e866d6c6a6062ca</data>
    </node>
    <node id="Opinion Words">
      <data key="d0">Opinion Words</data>
      <data key="d1">category</data>
      <data key="d2">A subcategory of semantic features consisting of 2,442 positive and negative words from the Harvard General Inquirer lexicon used to signal speech acts.</data>
      <data key="d3">chunk-652b9cdc03c6ea8c4e866d6c6a6062ca</data>
    </node>
    <node id="Vulgar Words">
      <data key="d0">Vulgar Words</data>
      <data key="d1">category</data>
      <data key="d2">A subcategory of semantic features comprising 349 words used to indicate strong emotion or informality in online text.</data>
      <data key="d3">chunk-652b9cdc03c6ea8c4e866d6c6a6062ca</data>
    </node>
    <node id="Emoticons">
      <data key="d0">Emoticons</data>
      <data key="d1">category</data>
      <data key="d2">A subcategory of semantic features containing 362 text-based emoticons that capture emotion and informality in tweets.</data>
      <data key="d3">chunk-652b9cdc03c6ea8c4e866d6c6a6062ca</data>
    </node>
    <node id="Speech Act Verbs">
      <data key="d0">Speech Act Verbs</data>
      <data key="d1">category</data>
      <data key="d2">A subcategory of semantic features based on 229 English verbs categorized into 37 groups that typically indicate specific speech acts.</data>
      <data key="d3">chunk-652b9cdc03c6ea8c4e866d6c6a6062ca</data>
    </node>
    <node id="N-grams">
      <data key="d0">N-grams</data>
      <data key="d1">category</data>
      <data key="d2">A subcategory of semantic features consisting of 1,415 selected unigrams, bigrams, and trigrams predictive of speech acts in tweets.</data>
      <data key="d3">chunk-652b9cdc03c6ea8c4e866d6c6a6062ca</data>
    </node>
    <node id="Punctuations">
      <data key="d0">Punctuations</data>
      <data key="d1">category</data>
      <data key="d2">A subcategory of syntactic features involving punctuation marks such as question marks and exclamation points that signal speech acts.</data>
      <data key="d3">chunk-652b9cdc03c6ea8c4e866d6c6a6062ca</data>
    </node>
    <node id="Twitter-specific Characters">
      <data key="d0">Twitter-specific Characters</data>
      <data key="d1">category</data>
      <data key="d2">A subcategory of syntactic features covering platform-specific characters including #, @, and RT, especially in the initial position of a tweet.</data>
      <data key="d3">chunk-652b9cdc03c6ea8c4e866d6c6a6062ca</data>
    </node>
    <node id="Abbreviations">
      <data key="d0">Abbreviations</data>
      <data key="d1">category</data>
      <data key="d2">A subcategory of name variants characterized by shortened letter sequences or acronyms representing full entity names.&lt;SEP&gt;A subcategory of syntactic features comprising 944 informal abbreviations collected from online sources and linguistic literature.&lt;SEP&gt;Abbreviations are shortened lexical forms commonly utilized as informal name variants in digital communication.</data>
      <data key="d3">chunk-652b9cdc03c6ea8c4e866d6c6a6062ca&lt;SEP&gt;chunk-4752470c8ccb777bad45ef52fde0243d&lt;SEP&gt;chunk-731ed10b120fb04a1b73bc728f12beb5</data>
    </node>
    <node id="Dependency Sub-trees">
      <data key="d0">Dependency Sub-trees</data>
      <data key="d1">category</data>
      <data key="d2">A subcategory of syntactic features capturing structural relationships between words in sentences derived from dependency parse trees.</data>
      <data key="d3">chunk-652b9cdc03c6ea8c4e866d6c6a6062ca</data>
    </node>
    <node id="Zhang et al.">
      <data key="d0">Zhang et al.</data>
      <data key="d1">person</data>
      <data key="d2">Zhang et al. refers to researchers who previously developed a supervised Twitter speech act classifier used as a benchmark for comparison.</data>
      <data key="d3">chunk-1e9f52662c01528fd8d607b1462c48df</data>
    </node>
    <node id="Part-of-Speech">
      <data key="d0">Part-of-Speech</data>
      <data key="d1">category</data>
      <data key="d2">A grammatical category and tagging scheme used to identify linguistic elements such as adjectives and interjections for feature extraction.</data>
      <data key="d3">chunk-1e9f52662c01528fd8d607b1462c48df</data>
    </node>
    <node id="Dialogue State Tracking">
      <data key="d0">Dialogue State Tracking</data>
      <data key="d1">category</data>
      <data key="d2">A core component and subfield in task-oriented dialogue systems that tracks user goals, constraints, and slot-value pairs across conversational turns.&lt;SEP&gt;A core sub-task and component in spoken dialogue systems responsible for estimating the probability distribution over dialogue states and slot-value pairs based on user utterances and conversation history.&lt;SEP&gt;A key functional task and component in spoken dialogue systems focused on estimating user goals and beliefs across dialogue turns.&lt;SEP&gt;A subfield and task within conversational AI focused on correctly inferring and maintaining a user's goals and requests throughout a dialogue.&lt;SEP&gt;Dialogue State Tracking is a key task and subfield in natural language processing and dialogue systems focused on estimating user goals and slot-value pairs across conversation turns.&lt;SEP&gt;Dialogue state tracking (DST) is an NLP task in dialogue systems that estimates a user's goals and requestable slots at each turn.&lt;SEP&gt;Dialogue state tracking is a key task in task-oriented dialogue systems focused on estimating a user's goals and requests at each conversational turn.</data>
      <data key="d3">chunk-2e1e71821eb167dabc5002a21237f815&lt;SEP&gt;chunk-4752470c8ccb777bad45ef52fde0243d&lt;SEP&gt;chunk-1e9f52662c01528fd8d607b1462c48df&lt;SEP&gt;chunk-785a16b34b0c74a5ee4f9f416976a683&lt;SEP&gt;chunk-af6147035553ac26ef0837a5ab654f4f&lt;SEP&gt;chunk-45dd962c5b788395b9105c9472288d6f</data>
    </node>
    <node id="Task-Oriented Dialogue System">
      <data key="d0">Task-Oriented Dialogue System</data>
      <data key="d1">category</data>
      <data key="d2">A category of conversational systems designed to interact with and assist users via natural language to accomplish specific tasks and goals.</data>
      <data key="d3">chunk-1e9f52662c01528fd8d607b1462c48df</data>
    </node>
    <node id="Dependency Tree">
      <data key="d0">Dependency Tree</data>
      <data key="d1">category</data>
      <data key="d2">A syntactic tree representation where each word in a sentence corresponds one-to-one with a node in the tree, used to extract sub-trees and grammatical relations.</data>
      <data key="d3">chunk-1e9f52662c01528fd8d607b1462c48df</data>
    </node>
    <node id="Constituency Tree">
      <data key="d0">Constituency Tree</data>
      <data key="d1">category</data>
      <data key="d2">A syntactic phrase structure tree contrasted with dependency trees in sentence parsing.</data>
      <data key="d3">chunk-1e9f52662c01528fd8d607b1462c48df</data>
    </node>
    <node id="Rumor Detection">
      <data key="d0">Rumor Detection</data>
      <data key="d1">category</data>
      <data key="d2">A downstream social media analysis and natural language processing application that utilizes speech act classification.</data>
      <data key="d3">chunk-1e9f52662c01528fd8d607b1462c48df</data>
    </node>
    <node id="WOZ2.0">
      <data key="d0">WOZ2.0</data>
      <data key="d1">category</data>
      <data key="d2">A benchmark dialogue dataset available in multiple languages including Italian and German, used for evaluating dialogue state tracking models.&lt;SEP&gt;A dialogue benchmark dataset consisting of 1,200 restaurant booking conversations across English, German, and Italian languages used for dialogue state tracking evaluation.&lt;SEP&gt;A multi-lingual benchmark dataset containing dialogue turns in English, Italian, and German used to evaluate dialogue state tracking models.&lt;SEP&gt;WOZ2.0 is a dialogue state tracking benchmark dataset consisting of 1,200 written conversations for restaurant booking, collected using the Wizard of Oz framework and translated into multiple languages.</data>
      <data key="d3">chunk-2e1e71821eb167dabc5002a21237f815&lt;SEP&gt;chunk-af6147035553ac26ef0837a5ab654f4f&lt;SEP&gt;chunk-785a16b34b0c74a5ee4f9f416976a683&lt;SEP&gt;chunk-1e9f52662c01528fd8d607b1462c48df</data>
    </node>
    <node id="Interjection">
      <data key="d0">Interjection</data>
      <data key="d1">category</data>
      <data key="d2">A part-of-speech category conveying emotion used as a binary feature to signal expressions.</data>
      <data key="d3">chunk-1e9f52662c01528fd8d607b1462c48df</data>
    </node>
    <node id="Dialogue Policy Manager">
      <data key="d0">Dialogue Policy Manager</data>
      <data key="d1">category</data>
      <data key="d2">A component in task-oriented dialogue systems that determines the next system action based on the current dialogue state.</data>
      <data key="d3">chunk-785a16b34b0c74a5ee4f9f416976a683</data>
    </node>
    <node id="GLAD">
      <data key="d0">GLAD</data>
      <data key="d1">category</data>
      <data key="d2">A Global-Locally Self-Attentive Dialogue State Tracker model that employs independent slot-specific encoders with recurrent and self-attention layers.&lt;SEP&gt;A recurrent neural network-based dialogue state tracking model that utilizes pre-trained word and character embeddings.&lt;SEP&gt;GLAD is a dialogue state tracking model that utilizes separate encoders for each slot and pre-trained embeddings, serving as a baseline for performance comparisons.&lt;SEP&gt;GLAD is a dialogue state tracking model that utilizes separate encoders for each slot and pre-trained embeddings, serving as an experimental baseline.&lt;SEP&gt;Global-Locally Self-Attentive Dialogue State Tracker; a model that combines global and local bidirectional-LSTMs with attention mechanisms, known for high performance but significant computational latency.</data>
      <data key="d3">chunk-4752470c8ccb777bad45ef52fde0243d&lt;SEP&gt;chunk-af6147035553ac26ef0837a5ab654f4f&lt;SEP&gt;chunk-785a16b34b0c74a5ee4f9f416976a683&lt;SEP&gt;chunk-45dd962c5b788395b9105c9472288d6f</data>
    </node>
    <node id="GCE">
      <data key="d0">GCE</data>
      <data key="d1">category</data>
      <data key="d2">A recurrent neural network-based dialogue state tracking model evaluated as a state-of-the-art baseline.&lt;SEP&gt;GCE is a dialogue state tracking model with a single encoder architecture that reduces model size and execution time compared to GLAD.&lt;SEP&gt;Globally Conditioned Encoder; a dialogue state tracking model designed within the GLAD framework to reduce latency using a shared globally conditioned encoder.&lt;SEP&gt;The Globally Conditioned Encoder model, a dialogue state tracking architecture that simplifies GLAD by eliminating slot-specific recurrent and self-attention layers.</data>
      <data key="d3">chunk-4752470c8ccb777bad45ef52fde0243d&lt;SEP&gt;chunk-af6147035553ac26ef0837a5ab654f4f&lt;SEP&gt;chunk-785a16b34b0c74a5ee4f9f416976a683&lt;SEP&gt;chunk-45dd962c5b788395b9105c9472288d6f</data>
    </node>
    <node id="G-SAT">
      <data key="d0">G-SAT</data>
      <data key="d1">category</data>
      <data key="d2">A dialogue state tracking neural model featuring a Global encoder and Slot-Attentive decoders designed to significantly reduce prediction latency while maintaining high accuracy.&lt;SEP&gt;A proposed dialogue state tracking model architecture evaluated for joint goal accuracy, turn request tracking, and latency.&lt;SEP&gt;G-SAT is a proposed neural dialogue state tracker model featuring a simplified architecture, low parameter count, and reduced training and prediction execution times.&lt;SEP&gt;G-SAT is a proposed neural dialogue state tracker model with a simplified architecture, low parameter count, and reduced training and prediction execution times.&lt;SEP&gt;Global encoder and Slot-Attentive decoders; a proposed dialogue state tracking architecture designed to overcome the latency and complexity bottlenecks of existing models using a single encoder and slot-specific decoders.</data>
      <data key="d3">chunk-4752470c8ccb777bad45ef52fde0243d&lt;SEP&gt;chunk-af6147035553ac26ef0837a5ab654f4f&lt;SEP&gt;chunk-785a16b34b0c74a5ee4f9f416976a683&lt;SEP&gt;chunk-45dd962c5b788395b9105c9472288d6f</data>
    </node>
    <node id="Belief State">
      <data key="d0">Belief State</data>
      <data key="d1">category</data>
      <data key="d2">A probability distribution over possible dialogue states and slot-value pairs maintained and updated by the dialogue state tracker.</data>
      <data key="d3">chunk-785a16b34b0c74a5ee4f9f416976a683</data>
    </node>
    <node id="Domain Ontology">
      <data key="d0">Domain Ontology</data>
      <data key="d1">category</data>
      <data key="d2">The structural specification in a dialogue system that defines the set of informable and requestable slots and their valid values.&lt;SEP&gt;The structured schema of available slots and values for a specific domain, directly influencing the computational complexity of dialogue state tracking.</data>
      <data key="d3">chunk-785a16b34b0c74a5ee4f9f416976a683&lt;SEP&gt;chunk-45dd962c5b788395b9105c9472288d6f</data>
    </node>
    <node id="Joint Goal">
      <data key="d0">Joint Goal</data>
      <data key="d1">category</data>
      <data key="d2">A core internal property of the dialogue state indicating the set of constraint values specified by the user for informable slots at any point in the dialogue.&lt;SEP&gt;A standard evaluation metric for dialogue state tracking that measures the accuracy of tracking accumulated constraints and goals up to a given turn.&lt;SEP&gt;The cumulative set of slot-value pairs that specify the constraints defined by the user at any point in a dialogue.</data>
      <data key="d3">chunk-af6147035553ac26ef0837a5ab654f4f&lt;SEP&gt;chunk-785a16b34b0c74a5ee4f9f416976a683&lt;SEP&gt;chunk-45dd962c5b788395b9105c9472288d6f</data>
    </node>
    <node id="Informable Slots">
      <data key="d0">Informable Slots</data>
      <data key="d1">category</data>
      <data key="d2">A dialogue state tracking slot classification representing user goal constraints in a task-oriented conversation.&lt;SEP&gt;Attributes defined in a domain ontology that can be provided by the user during conversation as constraints.&lt;SEP&gt;Informable slots are a category of dialogue slots representing user constraints and attributes, whose values are predicted from a set of possible slot-values.</data>
      <data key="d3">chunk-2e1e71821eb167dabc5002a21237f815&lt;SEP&gt;chunk-af6147035553ac26ef0837a5ab654f4f&lt;SEP&gt;chunk-785a16b34b0c74a5ee4f9f416976a683</data>
    </node>
    <node id="Requestable Slots">
      <data key="d0">Requestable Slots</data>
      <data key="d1">category</data>
      <data key="d2">A dialogue state tracking slot classification representing user inquiries for specific information from the system.&lt;SEP&gt;Attributes defined in a domain ontology that represent information the user can ask the system to provide.&lt;SEP&gt;Requestable slots are a category of dialogue slots representing information requested by the user, modeled through binary probability estimation.</data>
      <data key="d3">chunk-2e1e71821eb167dabc5002a21237f815&lt;SEP&gt;chunk-af6147035553ac26ef0837a5ab654f4f&lt;SEP&gt;chunk-785a16b34b0c74a5ee4f9f416976a683</data>
    </node>
    <node id="Pre-trained Embeddings">
      <data key="d0">Pre-trained Embeddings</data>
      <data key="d1">category</data>
      <data key="d2">Pre-computed vector representations of words tested with the G-SAT model to evaluate robustness and accuracy across different configurations.</data>
      <data key="d3">chunk-785a16b34b0c74a5ee4f9f416976a683</data>
    </node>
    <node id="Task-Oriented Dialogue Systems">
      <data key="d0">Task-Oriented Dialogue Systems</data>
      <data key="d1">category</data>
      <data key="d2">Automated conversational systems designed to help users complete specific tasks, typically structured with pipeline components including SLU and DST.</data>
      <data key="d3">chunk-45dd962c5b788395b9105c9472288d6f</data>
    </node>
    <node id="StateNet">
      <data key="d0">StateNet</data>
      <data key="d1">category</data>
      <data key="d2">A state-of-the-art dialogue state tracking architecture that uses an LSTM network to compare user utterance representations against candidate slot values.</data>
      <data key="d3">chunk-45dd962c5b788395b9105c9472288d6f</data>
    </node>
    <node id="Neural Belief Tracker">
      <data key="d0">Neural Belief Tracker</data>
      <data key="d1">category</data>
      <data key="d2">A data-driven neural dialogue state tracking model that learns vector representations for slot-value pairs and user utterances without requiring a semantic lexicon.&lt;SEP&gt;A dialogue state tracking approach that utilizes representation learning and pre-trained embeddings without requiring hand-crafted features.</data>
      <data key="d3">chunk-af6147035553ac26ef0837a5ab654f4f&lt;SEP&gt;chunk-45dd962c5b788395b9105c9472288d6f</data>
    </node>
    <node id="Turn Request">
      <data key="d0">Turn Request</data>
      <data key="d1">category</data>
      <data key="d2">A standard evaluation metric for dialogue state tracking assessing a model's ability to identify a user's request for information at a specific dialogue turn.&lt;SEP&gt;The specific slot-value pairs requested by a user during a single conversational turn in a dialogue system.</data>
      <data key="d3">chunk-af6147035553ac26ef0837a5ab654f4f&lt;SEP&gt;chunk-45dd962c5b788395b9105c9472288d6f</data>
    </node>
    <node id="Bidirectional-LSTM">
      <data key="d0">Bidirectional-LSTM</data>
      <data key="d1">category</data>
      <data key="d2">A recurrent neural network variant that processes sequential input in forward and reverse directions, employed globally and locally in tracking models like GLAD.&lt;SEP&gt;Bidirectional-LSTM is a recurrent neural network architecture that processes sequence inputs in both forward and backward directions to generate contextual token representations.</data>
      <data key="d3">chunk-2e1e71821eb167dabc5002a21237f815&lt;SEP&gt;chunk-45dd962c5b788395b9105c9472288d6f</data>
    </node>
    <node id="End-To-End Dialogue Systems">
      <data key="d0">End-To-End Dialogue Systems</data>
      <data key="d1">category</data>
      <data key="d2">An architectural paradigm for dialogue systems that maps inputs directly to responses, in which dialogue state tracking remains an essential component.</data>
      <data key="d3">chunk-45dd962c5b788395b9105c9472288d6f</data>
    </node>
    <node id="Pre-Trained Embeddings">
      <data key="d0">Pre-Trained Embeddings</data>
      <data key="d1">category</data>
      <data key="d2">Pre-computed semantic vector representations used by models such as NBT, GLAD, and StateNet to represent lexical tokens and slot-value pairs without domain lexicons.&lt;SEP&gt;Pre-computed vector representations, including GloVe and character n-grams, used to represent semantic tokens without hand-crafted features.&lt;SEP&gt;Pre-trained embeddings are pre-computed vector representations of words utilized by baseline models like GLAD and GCE.</data>
      <data key="d3">chunk-4752470c8ccb777bad45ef52fde0243d&lt;SEP&gt;chunk-af6147035553ac26ef0837a5ab654f4f&lt;SEP&gt;chunk-45dd962c5b788395b9105c9472288d6f</data>
    </node>
    <node id="Delexicalisation">
      <data key="d0">Delexicalisation</data>
      <data key="d1">category</data>
      <data key="d2">A data representation method used to abstract specific slot values in utterances, facilitating joint spoken language understanding and dialogue state tracking.&lt;SEP&gt;An NLP method that replaces specific slot value tokens with generic semantic terms relying on large semantic dictionaries.</data>
      <data key="d3">chunk-af6147035553ac26ef0837a5ab654f4f&lt;SEP&gt;chunk-45dd962c5b788395b9105c9472288d6f</data>
    </node>
    <node id="G-SAT Model">
      <data key="d0">G-SAT Model</data>
      <data key="d1">category</data>
      <data key="d2">The G-SAT (Global encoder and Slot-Attentive decoders) model is a neural dialogue state tracking architecture designed to predict slot-value pairs for dialogue turns using a shared encoder and slot-specific decoders.</data>
      <data key="d3">chunk-2e1e71821eb167dabc5002a21237f815</data>
    </node>
    <node id="Wizard of Oz Framework">
      <data key="d0">Wizard of Oz Framework</data>
      <data key="d1">category</data>
      <data key="d2">The Wizard of Oz framework is an experimental data collection methodology where users interact with a system they believe is autonomous, but is operated or simulated by humans.</data>
      <data key="d3">chunk-2e1e71821eb167dabc5002a21237f815</data>
    </node>
    <node id="Restaurant Booking Task">
      <data key="d0">Restaurant Booking Task</data>
      <data key="d1">category</data>
      <data key="d2">The restaurant booking task is a domain category in goal-oriented dialogue systems involving conversations aimed at reserving or querying restaurant information.</data>
      <data key="d3">chunk-2e1e71821eb167dabc5002a21237f815</data>
    </node>
    <node id="ReLU">
      <data key="d0">ReLU</data>
      <data key="d1">category</data>
      <data key="d2">An activation function (Rectified Linear Unit) applied to the encoder hidden state to produce a slot-specific representation of the user utterance.</data>
      <data key="d3">chunk-2e1e71821eb167dabc5002a21237f815</data>
    </node>
    <node id="User Utterance">
      <data key="d0">User Utterance</data>
      <data key="d1">category</data>
      <data key="d2">The sequence of words or tokens input by a human user during a dialogue turn in a conversational system.</data>
      <data key="d3">chunk-2e1e71821eb167dabc5002a21237f815</data>
    </node>
    <node id="System Action">
      <data key="d0">System Action</data>
      <data key="d1">category</data>
      <data key="d2">The preceding action, slot, and value tokens emitted by a dialogue system, converted into a token sequence and fed into the encoder.</data>
      <data key="d3">chunk-2e1e71821eb167dabc5002a21237f815</data>
    </node>
    <node id="Encoder Module">
      <data key="d0">Encoder Module</data>
      <data key="d1">category</data>
      <data key="d2">The single shared module in the G-SAT architecture that takes the concatenated system action and user utterance to generate token-level and contextual hidden representations.</data>
      <data key="d3">chunk-2e1e71821eb167dabc5002a21237f815</data>
    </node>
    <node id="Slot-Specific Decoder">
      <data key="d0">Slot-Specific Decoder</data>
      <data key="d1">category</data>
      <data key="d2">Classifier modules within the G-SAT model dedicated to estimating the probability distribution over candidate values for individual dialogue slots.</data>
      <data key="d3">chunk-2e1e71821eb167dabc5002a21237f815</data>
    </node>
    <node id="BIBREF16">
      <data key="d0">BIBREF16</data>
      <data key="d1">person</data>
      <data key="d2">The researcher or author cited for translating the WOZ2.0 English dialogue dataset into German and Italian using professional translators.</data>
      <data key="d3">chunk-2e1e71821eb167dabc5002a21237f815</data>
    </node>
    <node id="BIBREF14">
      <data key="d0">BIBREF14</data>
      <data key="d1">person</data>
      <data key="d2">The researcher or author cited for the bidirectional-LSTM architecture utilized in the G-SAT encoder module.</data>
      <data key="d3">chunk-2e1e71821eb167dabc5002a21237f815</data>
    </node>
    <node id="BIBREF6">
      <data key="d0">BIBREF6</data>
      <data key="d1">person</data>
      <data key="d2">The researcher or author cited for the introduction and compilation of the WOZ2.0 restaurant dialogue dataset.</data>
      <data key="d3">chunk-2e1e71821eb167dabc5002a21237f815</data>
    </node>
    <node id="Time Complexity">
      <data key="d0">Time Complexity</data>
      <data key="d1">category</data>
      <data key="d2">An evaluation metric reflecting prediction latency, measured as the time required for a model to process a single batch of data.&lt;SEP&gt;Time complexity refers to the computational latency and duration required for batch training and prediction in neural dialogue models.</data>
      <data key="d3">chunk-4752470c8ccb777bad45ef52fde0243d&lt;SEP&gt;chunk-af6147035553ac26ef0837a5ab654f4f</data>
    </node>
    <node id="Restaurant Booking">
      <data key="d0">Restaurant Booking</data>
      <data key="d1">category</data>
      <data key="d2">A task-oriented dialogue domain involving conversational text interactions to reserve restaurant services.</data>
      <data key="d3">chunk-af6147035553ac26ef0837a5ab654f4f</data>
    </node>
    <node id="StateNet_PSI">
      <data key="d0">StateNet_PSI</data>
      <data key="d1">category</data>
      <data key="d2">A recurrent neural network-based dialogue state tracking baseline model that calculates a 2-Norm distance against fixed slot-value word vectors and only predicts informable slots.</data>
      <data key="d3">chunk-af6147035553ac26ef0837a5ab654f4f</data>
    </node>
    <node id="GloVe Embeddings">
      <data key="d0">GloVe Embeddings</data>
      <data key="d1">category</data>
      <data key="d2">A pre-trained word vector representation used to initialize token representations in dialogue models.</data>
      <data key="d3">chunk-af6147035553ac26ef0837a5ab654f4f</data>
    </node>
    <node id="WOZ2.0 Dataset">
      <data key="d0">WOZ2.0 Dataset</data>
      <data key="d1">category</data>
      <data key="d2">The WOZ2.0 dataset is a benchmark conversational dataset used for evaluating joint goal performance and turn request accuracy in dialogue state tracking.&lt;SEP&gt;The WOZ2.0 dataset is a benchmark dataset used for evaluating joint goal performance and turn request accuracy in dialogue state tracking.</data>
      <data key="d3">chunk-4752470c8ccb777bad45ef52fde0243d</data>
    </node>
    <node id="Task-Oriented Dialog System">
      <data key="d0">Task-Oriented Dialog System</data>
      <data key="d1">category</data>
      <data key="d2">Task-oriented dialog systems are conversational AI systems designed to assist users in completing specific tasks through dialogue flows.&lt;SEP&gt;Task-oriented dialog systems are conversational agents designed to assist users in completing specific goals or transactions.</data>
      <data key="d3">chunk-4752470c8ccb777bad45ef52fde0243d</data>
    </node>
    <node id="Social Media Texts">
      <data key="d0">Social Media Texts</data>
      <data key="d1">category</data>
      <data key="d2">Social media texts are an informal digital text genre characterized by non-standard expressions, abbreviations, and informal name variants.&lt;SEP&gt;Social media texts refer to user-generated informal digital text characterized by slang, non-standard grammar, and name variants.</data>
      <data key="d3">chunk-4752470c8ccb777bad45ef52fde0243d</data>
    </node>
    <node id="GeForce GTX 1080Ti GPU">
      <data key="d0">GeForce GTX 1080Ti GPU</data>
      <data key="d1">category</data>
      <data key="d2">GeForce GTX 1080Ti GPU is a specific hardware computing processor used as the consistent execution environment to test model time complexity.</data>
      <data key="d3">chunk-4752470c8ccb777bad45ef52fde0243d</data>
    </node>
    <node id="Requestable Slot">
      <data key="d0">Requestable Slot</data>
      <data key="d1">category</data>
      <data key="d2">A requestable slot is a category of dialogue slot representing user inquiries or requests, identified as an easier task to predict than informable slots.</data>
      <data key="d3">chunk-4752470c8ccb777bad45ef52fde0243d</data>
    </node>
    <node id="Informable Slot">
      <data key="d0">Informable Slot</data>
      <data key="d1">category</data>
      <data key="d2">An informable slot is a category of dialogue slot representing user constraints and information provided during a conversation.</data>
      <data key="d3">chunk-4752470c8ccb777bad45ef52fde0243d</data>
    </node>
    <node id="Multi-Domain Dialogue State Tracking">
      <data key="d0">Multi-Domain Dialogue State Tracking</data>
      <data key="d1">category</data>
      <data key="d2">Multi-domain dialogue state tracking is an advanced conversational AI task where the system tracks dialogue states across multiple domains and large slot sets.</data>
      <data key="d3">chunk-4752470c8ccb777bad45ef52fde0243d</data>
    </node>
    <node id="Joint Goal Performance">
      <data key="d0">Joint Goal Performance</data>
      <data key="d1">category</data>
      <data key="d2">Joint goal performance is a standard dialogue state tracking evaluation metric assessing how accurately a model identifies all user constraints at a dialogue turn.</data>
      <data key="d3">chunk-4752470c8ccb777bad45ef52fde0243d</data>
    </node>
    <node id="Turn Request Performance">
      <data key="d0">Turn Request Performance</data>
      <data key="d1">category</data>
      <data key="d2">Turn request performance is an evaluation metric assessing the model's accuracy in predicting user requests during specific dialogue turns.</data>
      <data key="d3">chunk-4752470c8ccb777bad45ef52fde0243d</data>
    </node>
    <node id="Wilcoxon Signed-Rank Test">
      <data key="d0">Wilcoxon Signed-Rank Test</data>
      <data key="d1">category</data>
      <data key="d2">The Wilcoxon signed-rank test is a non-parametric statistical hypothesis test used to verify the statistical significance of performance differences.</data>
      <data key="d3">chunk-4752470c8ccb777bad45ef52fde0243d</data>
    </node>
    <node id="Wilcoxon">
      <data key="d0">Wilcoxon</data>
      <data key="d1">person</data>
      <data key="d2">Frank Wilcoxon was a statistician whose name is attached to the non-parametric Wilcoxon signed-rank test used in statistical significance testing.</data>
      <data key="d3">chunk-4752470c8ccb777bad45ef52fde0243d</data>
    </node>
    <node id="Name Variants">
      <data key="d0">Name Variants</data>
      <data key="d1">category</data>
      <data key="d2">Name variants are informal, non-canonical lexical forms of proper names frequently occurring in microblogs and social media.</data>
      <data key="d3">chunk-4752470c8ccb777bad45ef52fde0243d</data>
    </node>
    <node id="Organization">
      <data key="d0">Organization</data>
      <data key="d1">category</data>
      <data key="d2">A named entity category designating institutions, companies, or groups, accounting for 241 annotations in the analyzed Turkish tweet dataset.</data>
      <data key="d3">chunk-731ed10b120fb04a1b73bc728f12beb5</data>
    </node>
    <node id="PLO">
      <data key="d0">PLO</data>
      <data key="d1">category</data>
      <data key="d2">A collective named entity category grouping Person, Location, and Organization entities, encompassing 980 total annotations in the study.&lt;SEP&gt;PLO refers to Person, Location, and Organization named entities annotated in the tweet dataset and categorized into name variants.</data>
      <data key="d3">chunk-195b3bb495c9171fc33fb85c129c4366&lt;SEP&gt;chunk-731ed10b120fb04a1b73bc728f12beb5</data>
    </node>
    <node id="Name Variant">
      <data key="d0">Name Variant</data>
      <data key="d1">category</data>
      <data key="d2">A classification of informal, distorted, abbreviated, or contracted forms of canonical named entities commonly used in social media texts.</data>
      <data key="d3">chunk-731ed10b120fb04a1b73bc728f12beb5</data>
    </node>
    <node id="Well-Formed Names">
      <data key="d0">Well-Formed Names</data>
      <data key="d1">category</data>
      <data key="d2">A category referring to standard, canonical named entities that follow standard orthographic and grammatical rules.</data>
      <data key="d3">chunk-731ed10b120fb04a1b73bc728f12beb5</data>
    </node>
    <node id="Date">
      <data key="d0">Date</data>
      <data key="d1">category</data>
      <data key="d2">A named entity category present in the original tweet dataset denoting calendar dates.</data>
      <data key="d3">chunk-731ed10b120fb04a1b73bc728f12beb5</data>
    </node>
    <node id="Time">
      <data key="d0">Time</data>
      <data key="d1">category</data>
      <data key="d2">A named entity category present in the original tweet dataset denoting temporal expressions.</data>
      <data key="d3">chunk-731ed10b120fb04a1b73bc728f12beb5</data>
    </node>
    <node id="Money">
      <data key="d0">Money</data>
      <data key="d1">category</data>

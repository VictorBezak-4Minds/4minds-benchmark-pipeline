      <data key="d3">chunk-b3bf41e0b7ea425266139faf090ad226</data>
    </node>
    <node id="OPAL">
      <data key="d0">OPAL</data>
      <data key="d1">organization</data>
      <data key="d2">A research project funded by the German Federal Ministry of Transport and Digital Infrastructure.</data>
      <data key="d3">chunk-b3bf41e0b7ea425266139faf090ad226</data>
    </node>
    <node id="Weight Pruning">
      <data key="d0">Weight Pruning</data>
      <data key="d1">category</data>
      <data key="d2">A model compression baseline method that iteratively removes non-essential weights from neural network matrices.&lt;SEP&gt;A model compression technique that eliminates non-essential or low-magnitude parameters to reduce memory footprint and latency in neural networks.&lt;SEP&gt;A model compression technique that eliminates redundant or unimportant parameters to introduce sparsity into neural network matrices.&lt;SEP&gt;A model compression technique that induces sparsity by eliminating redundant parameters or weights within neural network matrices.&lt;SEP&gt;A model compression technique that removes connections, neurons, or filters from deep neural networks to produce sparse architectures without significant loss in accuracy.&lt;SEP&gt;An unstructured compression method that induces sparsity in a neural network by setting small weights to zero via a binary mask.&lt;SEP&gt;Weight pruning is a model compression method that removes redundant or low-importance weights to decrease model size and computational complexity.</data>
      <data key="d3">chunk-b3bf41e0b7ea425266139faf090ad226&lt;SEP&gt;chunk-a1f1d3da436f9f4b7eadca13b0e5803e&lt;SEP&gt;chunk-8ff808f5f84391609fd609fe291c7f4e&lt;SEP&gt;chunk-7655d654b459dfdba7d9c1f562898a07&lt;SEP&gt;chunk-69bdb2043fb72d1301a9087fb8f43b95&lt;SEP&gt;chunk-f56a06d096f62c8282f59e57d190e7d9&lt;SEP&gt;chunk-e4f9917b54f845e14e0e4edafd46cb2d</data>
    </node>
    <node id="Matrix Factorization">
      <data key="d0">Matrix Factorization</data>
      <data key="d1">category</data>
      <data key="d2">A mathematical compression technique that decomposes a parameter matrix into the product of two lower-rank matrices.&lt;SEP&gt;A mathematical decomposition technique applied in model compression to factorize parameter matrices into lower ranks, saving memory and compute.&lt;SEP&gt;A mathematical decomposition technique used as a model compression baseline, often utilizing SVD.&lt;SEP&gt;A mathematical decomposition technique, such as Singular Value Decomposition, used to approximate parameter matrices with lower-rank representations.&lt;SEP&gt;A model compression approach that decomposes weight matrices into products of lower-dimensional matrices using techniques like Singular Value Decomposition.&lt;SEP&gt;Matrix Factorization is a mathematical technique category used in prior works to derive latent continuous representations for textual similarity.&lt;SEP&gt;Matrix factorization is a mathematical and compression technique used in LadaBERT to decompose weight matrices and reduce model parameters.</data>
      <data key="d3">chunk-b3bf41e0b7ea425266139faf090ad226&lt;SEP&gt;chunk-8ff808f5f84391609fd609fe291c7f4e&lt;SEP&gt;chunk-7655d654b459dfdba7d9c1f562898a07&lt;SEP&gt;chunk-69bdb2043fb72d1301a9087fb8f43b95&lt;SEP&gt;chunk-bf3bb0dbc6eb81bded1d21569d42693f&lt;SEP&gt;chunk-f56a06d096f62c8282f59e57d190e7d9&lt;SEP&gt;chunk-e4f9917b54f845e14e0e4edafd46cb2d</data>
    </node>
    <node id="Fact Checking">
      <data key="d0">Fact Checking</data>
      <data key="d1">category</data>
      <data key="d2">An automated information verification task in natural language processing that evaluates factual claims against external knowledge bases.</data>
      <data key="d3">chunk-b3bf41e0b7ea425266139faf090ad226</data>
    </node>
    <node id="Word Alignment">
      <data key="d0">Word Alignment</data>
      <data key="d1">category</data>
      <data key="d2">A subtask in machine translation that determines translational correspondences between words in parallel text corpora.&lt;SEP&gt;Word alignment is a natural language processing technique that maps corresponding words between source and target language sentence pairs.</data>
      <data key="d3">chunk-b3bf41e0b7ea425266139faf090ad226&lt;SEP&gt;chunk-3f2d2324dc0fae4c7fa89a1690e31637</data>
    </node>
    <node id="Weight Quantization">
      <data key="d0">Weight Quantization</data>
      <data key="d1">category</data>
      <data key="d2">A model compression method that reduces the bit-precision of weights within neural networks, ranging from 32-bit floating point down to 8-bit or binary representations.</data>
      <data key="d3">chunk-7655d654b459dfdba7d9c1f562898a07</data>
    </node>

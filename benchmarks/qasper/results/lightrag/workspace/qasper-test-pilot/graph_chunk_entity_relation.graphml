      <data key="d1">category</data>
      <data key="d2">A normalized exponential classification layer applied on top of neural network representations to compute class probabilities.</data>
      <data key="d3">chunk-db96a568a81e93ae0f5b620a7d452203</data>
    </node>
    <node id="Text-to-SQL Generation">
      <data key="d0">Text-to-SQL Generation</data>
      <data key="d1">category</data>
      <data key="d2">A natural language processing task focusing on translating cross-domain, context-dependent natural language questions into executable SQL queries.</data>
      <data key="d3">chunk-db96a568a81e93ae0f5b620a7d452203</data>
    </node>
    <node id="Part-of-Speech Tagging">
      <data key="d0">Part-of-Speech Tagging</data>
      <data key="d1">category</data>
      <data key="d2">A basic natural language processing technique that annotates words with their grammatical categories, used as input features for clinical event extraction.</data>
      <data key="d3">chunk-db96a568a81e93ae0f5b620a7d452203</data>
    </node>
    <node id="Suhr">
      <data key="d0">Suhr</data>
      <data key="d1">person</data>
      <data key="d2">A researcher referenced for proposing a context-dependent text-to-SQL model featuring an interaction-level encoder, segment-copying mechanism, and attention over previous utterances.&lt;SEP&gt;A researcher referenced for the 2018 work on learning context-dependent semantic parsing and a segment copying procedure designed for the ATIS dataset.&lt;SEP&gt;A researcher who developed models for generating ATIS SQL queries across interactions by incorporating conversation history and copying query segments.</data>
      <data key="d3">chunk-fdb0afdde0d066987770f69fd6c4b0b4&lt;SEP&gt;chunk-0003df2b872764693025524cf2fd334c&lt;SEP&gt;chunk-425ff15de9cdf497af29b3dcbbab27df</data>
    </node>
    <node id="Cross-Domain Context-Dependent Text-To-SQL Generation">
      <data key="d0">Cross-Domain Context-Dependent Text-To-SQL Generation</data>
      <data key="d1">category</data>
      <data key="d2">A task category in natural language processing and semantic parsing focusing on generating SQL queries across varied database schemas based on multi-turn user interactions.</data>
      <data key="d3">chunk-0003df2b872764693025524cf2fd334c</data>
    </node>
    <node id="Semantic Parsing">
      <data key="d0">Semantic Parsing</data>
      <data key="d1">category</data>
      <data key="d2">A broad category in natural language processing involving the translation of natural language utterances into machine-executable logical forms or database queries.&lt;SEP&gt;A computational linguistics task involving the transformation of natural language inputs into structured formats or representations.&lt;SEP&gt;A subfield of natural language processing focused on mapping natural language sentences into formal, machine-executable representations such as logical forms, lambda calculus, or SQL queries.&lt;SEP&gt;Semantic parsing is a natural language processing task that maps natural language sentences into structured, formal semantic representations.</data>
      <data key="d3">chunk-159ff4436a1c0b10a07d168b9d3ad6b6&lt;SEP&gt;chunk-236f5016d3aa81277cabc5c947f1ca64&lt;SEP&gt;chunk-0003df2b872764693025524cf2fd334c&lt;SEP&gt;chunk-425ff15de9cdf497af29b3dcbbab27df</data>
    </node>
    <node id="Context-Independent Semantic Parsing">
      <data key="d0">Context-Independent Semantic Parsing</data>
      <data key="d1">category</data>
      <data key="d2">A category of semantic parsing focused on converting single-turn, isolated questions into executable queries without conversational context.&lt;SEP&gt;A category of semantic parsing that maps individual natural language utterances directly to SQL queries without utilizing conversational context or interaction history.</data>
      <data key="d3">chunk-0003df2b872764693025524cf2fd334c&lt;SEP&gt;chunk-425ff15de9cdf497af29b3dcbbab27df</data>
    </node>
    <node id="Multi-Turn Interaction">
      <data key="d0">Multi-Turn Interaction</data>
      <data key="d1">category</data>
      <data key="d2">A category of conversational interaction where users submit a sequence of inter-related queries, frequently referring to previous mentions or omitting previously conveyed context.</data>
      <data key="d3">chunk-0003df2b872764693025524cf2fd334c</data>
    </node>
    <node id="Relational Database">
      <data key="d0">Relational Database</data>
      <data key="d1">category</data>
      <data key="d2">A category of structured data systems featuring multiple tables and column headers accessed and queried using SQL.&lt;SEP&gt;Relational Database is a category of structured database systems composed of multiple tables and column headers used for cross-domain grounded interactions.</data>
      <data key="d3">chunk-56c893ccea72c9785303bae311f29c7b&lt;SEP&gt;chunk-0003df2b872764693025524cf2fd334c</data>
    </node>
    <node id="Flight-Booking Domain">
      <data key="d0">Flight-Booking Domain</data>
      <data key="d1">category</data>
      <data key="d2">A domain category characterizing the ATIS dataset, focused specifically on flight reservation and schedule information.</data>
      <data key="d3">chunk-0003df2b872764693025524cf2fd334c</data>
    </node>
    <node id="Phase 2: DocTimeRel">
      <data key="d0">Phase 2: DocTimeRel</data>
      <data key="d1">event</data>
      <data key="d2">An evaluation phase in temporal information extraction benchmark experiments addressing document-time relations.</data>
      <data key="d3">chunk-0003df2b872764693025524cf2fd334c</data>
    </node>
    <node id="SParC">
      <data key="d0">SParC</data>
      <data key="d1">category</data>
      <data key="d2">A benchmark dataset for cross-domain semantic parsing and text-to-SQL tasks referenced in the experimental evaluation.&lt;SEP&gt;A cross-domain conversational text-to-SQL benchmark dataset designed for multi-turn semantic parsing across multiple databases.&lt;SEP&gt;A cross-domain, context-dependent text-to-SQL benchmark dataset used to evaluate semantic parsing models across conversational turns.&lt;SEP&gt;A cross-domain, multi-turn semantic parsing dataset for conversational text-to-SQL.&lt;SEP&gt;A large-scale dataset and benchmark category for cross-domain semantic parsing in context, consisting of coherent question sequences annotated with SQL queries across 200 databases and 138 domains.</data>
      <data key="d3">chunk-0003df2b872764693025524cf2fd334c&lt;SEP&gt;chunk-fdb0afdde0d066987770f69fd6c4b0b4&lt;SEP&gt;chunk-506d24d16d4296b3078ff20115c8082b&lt;SEP&gt;chunk-425ff15de9cdf497af29b3dcbbab27df&lt;SEP&gt;chunk-c0e641e454fbaf0939a594969a7304c3</data>
    </node>
    <node id="ATIS">
      <data key="d0">ATIS</data>
      <data key="d1">category</data>
      <data key="d2">A conversational benchmark dataset for flight reservations, widely used in context-dependent semantic parsing and conversational text-to-SQL.&lt;SEP&gt;A single-domain benchmark dataset focused on flight reservations, used to evaluate context-dependent semantic parsing models.&lt;SEP&gt;A single-domain benchmark dataset for context-dependent semantic parsing focused exclusively on the flight-booking domain.&lt;SEP&gt;A standard benchmark dataset in natural language processing used for spoken language understanding and semantic parsing evaluation.&lt;SEP&gt;The Air Travel Information System benchmark dataset used for evaluating conversational database queries.</data>
      <data key="d3">chunk-0003df2b872764693025524cf2fd334c&lt;SEP&gt;chunk-fdb0afdde0d066987770f69fd6c4b0b4&lt;SEP&gt;chunk-506d24d16d4296b3078ff20115c8082b&lt;SEP&gt;chunk-425ff15de9cdf497af29b3dcbbab27df&lt;SEP&gt;chunk-c0e641e454fbaf0939a594969a7304c3</data>
    </node>
    <node id="Spider">
      <data key="d0">Spider</data>
      <data key="d1">category</data>
      <data key="d2">A complex, cross-domain text-to-SQL benchmark dataset commonly used to test generalization across varied database schemas in single-turn queries.&lt;SEP&gt;A complex, cross-domain text-to-SQL benchmark dataset used as a comparative standard in semantic parsing research.&lt;SEP&gt;A cross-domain context-independent semantic parsing benchmark dataset upon which SParC is constructed, sharing the same database splits.&lt;SEP&gt;A large-scale cross-domain text-to-SQL benchmark dataset evaluating complex query generation across unseen database schemas.</data>
      <data key="d3">chunk-fdb0afdde0d066987770f69fd6c4b0b4&lt;SEP&gt;chunk-506d24d16d4296b3078ff20115c8082b&lt;SEP&gt;chunk-0003df2b872764693025524cf2fd334c&lt;SEP&gt;chunk-425ff15de9cdf497af29b3dcbbab27df</data>
    </node>

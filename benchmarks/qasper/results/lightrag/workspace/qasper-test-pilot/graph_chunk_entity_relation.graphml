      <data key="d7">chunk-7a96f0a5c9cb8a4b3ffecae493bed473</data>
    </edge>
    <edge source="Sublinear Scaling Regime" target="Outdoor-Related Activities">
      <data key="d4">9.0</data>
      <data key="d5">Outdoor-related vocabulary scales sublinearly as population density increases and physical environments change.</data>
      <data key="d6">scaling classification, rural lifestyle</data>
      <data key="d7">chunk-7a96f0a5c9cb8a4b3ffecae493bed473</data>
    </edge>
    <edge source="Sublinear Scaling Regime" target="Slang And Swearwords">
      <data key="d4">8.0</data>
      <data key="d5">Specific slang and swearwords such as shxt, dang, and damnit scale sublinearly, declining with city size.</data>
      <data key="d6">lexical variation, sublinear slang</data>
      <data key="d7">chunk-7a96f0a5c9cb8a4b3ffecae493bed473</data>
    </edge>
    <edge source="Superlinear Scaling Regime" target="Twitter">
      <data key="d4">7.0</data>
      <data key="d5">Tweets from Twitter contain words categorized into the superlinear scaling regime, which scale disproportionately in larger cities.</data>
      <data key="d6">lexical analysis, scaling regime</data>
      <data key="d7">chunk-7a96f0a5c9cb8a4b3ffecae493bed473</data>
    </edge>
    <edge source="Superlinear Scaling Regime" target="Flight-Reporting">
      <data key="d4">9.0</data>
      <data key="d5">Words associated with flight reporting belong to the superlinear regime due to concentration of air travel infrastructure in major cities.</data>

    </edge>
    <edge source="Text Content Manipulation" target="Controlled Text Generation">
      <data key="d4">9.0</data>
      <data key="d5">Text content manipulation is formulated as a specialized setting within controlled text generation requiring adherence to structured content and designated style.</data>

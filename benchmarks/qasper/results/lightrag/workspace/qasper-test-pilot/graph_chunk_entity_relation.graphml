    </node>
    <node id="Jrue Holiday">
      <data key="d0">Jrue Holiday</data>
      <data key="d1">person</data>
      <data key="d2">Jrue Holiday is a professional basketball player mentioned as an example entity in the reference sentences.</data>
      <data key="d3">chunk-009a3d10aa88ab09f7d1c51bd7755ef4</data>
    </node>
    <node id="Unsupervised Text Content Manipulation">
      <data key="d0">Unsupervised Text Content Manipulation</data>
      <data key="d1">category</data>
      <data key="d2">A natural language processing task aimed at generating realistic text that achieves content fidelity from structured data records while preserving the writing style of a reference sentence without ground-truth supervision.</data>
      <data key="d3">chunk-009a3d10aa88ab09f7d1c51bd7755ef4</data>
    </node>
    <node id="NBA Basketball Games">
      <data key="d0">NBA Basketball Games</data>
      <data key="d1">event</data>
      <data key="d2">Competitive sporting events organized by the NBA whose box-score statistics and accompanying game reports serve as source material for natural language generation research.&lt;SEP&gt;Professional basketball matches played within the NBA whose box-score statistics and journalistic reports constitute the empirical dataset.</data>
      <data key="d3">chunk-009a3d10aa88ab09f7d1c51bd7755ef4&lt;SEP&gt;chunk-e90c3963b2880a766180f3aafb75b379</data>
    </node>
    <node id="Neural Sequence To Sequence Models">
      <data key="d0">Neural Sequence To Sequence Models</data>
      <data key="d1">category</data>
      <data key="d2">Deep learning architectures that process structured input sequences to generate natural language outputs, traditionally trained with supervised data.</data>
      <data key="d3">chunk-009a3d10aa88ab09f7d1c51bd7755ef4</data>
    </node>
    <node id="Retrieve And Rewrite Framework">
      <data key="d0">Retrieve And Rewrite Framework</data>
      <data key="d1">category</data>
      <data key="d2">A two-step text generation paradigm where an existing similar sentence is retrieved from neighbors and then modified to express desired information.</data>
      <data key="d3">chunk-009a3d10aa88ab09f7d1c51bd7755ef4</data>
    </node>
    <node id="Back-Translation">
      <data key="d0">Back-Translation</data>
      <data key="d1">category</data>
      <data key="d2">A sequence generation and unsupervised training technique used to reconstruct input texts through an intermediate synthetic representation.&lt;SEP&gt;A text generation and training technique mixed with auto-encoding to handle multiple attributes in sentence generation.&lt;SEP&gt;A translation validation technique used by native speakers to evaluate the quality and semantic accuracy of model-generated translations.&lt;SEP&gt;An unsupervised data transformation technique used in text style transfer models to establish cycle-consistency loss.</data>
      <data key="d3">chunk-009a3d10aa88ab09f7d1c51bd7755ef4&lt;SEP&gt;chunk-f50b15c876beec2eae8bf6437e8409aa&lt;SEP&gt;chunk-e90c3963b2880a766180f3aafb75b379&lt;SEP&gt;chunk-8fa216244e9956f33ee1e83a4b072080</data>
    </node>
    <node id="Table-To-Document Generation">
      <data key="d0">Table-To-Document Generation</data>
      <data key="d1">category</data>
      <data key="d2">A natural language processing research task focused on generating descriptive textual reports from structured tabular data.&lt;SEP&gt;A natural language processing task focused on converting structured tabular data, such as box scores, into full-text summaries or documents.</data>
      <data key="d3">chunk-009a3d10aa88ab09f7d1c51bd7755ef4&lt;SEP&gt;chunk-e90c3963b2880a766180f3aafb75b379</data>
    </node>
    <node id="Dialogue Generation">
      <data key="d0">Dialogue Generation</data>
      <data key="d1">category</data>
      <data key="d2">An application domain in natural language processing aimed at producing conversational responses using neural or retrieval-based frameworks.&lt;SEP&gt;The NLP task and area of research focused on generating conversational responses from dialogue history and communication goals.</data>
      <data key="d3">chunk-009a3d10aa88ab09f7d1c51bd7755ef4&lt;SEP&gt;chunk-6b6907deaed642269724a32b0c9ccd9f</data>
    </node>
    <node id="Programming Code Generation">
      <data key="d0">Programming Code Generation</data>
      <data key="d1">category</data>
      <data key="d2">A computational task centered on synthesizing executable code from specifications or retrieved contextual neighbors.</data>
      <data key="d3">chunk-009a3d10aa88ab09f7d1c51bd7755ef4</data>
    </node>
    <node id="Lakers">
      <data key="d0">Lakers</data>
      <data key="d1">organization</data>
      <data key="d2">The Los Angeles Lakers are a professional basketball team cited as an example within the box-score content records.</data>
      <data key="d3">chunk-e90c3963b2880a766180f3aafb75b379</data>
    </node>
    <node id="Style Transfer">
      <data key="d0">Style Transfer</data>
      <data key="d1">category</data>
      <data key="d2">A machine learning and natural language processing paradigm aimed at modifying textual attributes and stylistic features while retaining underlying information.&lt;SEP&gt;A subfield and technique in natural language processing aimed at altering the style of text, exemplified by baseline models like MAST and AdvST.</data>
      <data key="d3">chunk-08e25f0ce4d7d5635eb6aed1b2807f91&lt;SEP&gt;chunk-e90c3963b2880a766180f3aafb75b379</data>
    </node>
    <node id="Unsupervised Learning">
      <data key="d0">Unsupervised Learning</data>
      <data key="d1">category</data>
      <data key="d2">A machine learning paradigm where models are trained without ground-truth output sentences or direct supervision.</data>
      <data key="d3">chunk-e90c3963b2880a766180f3aafb75b379</data>
    </node>
    <node id="Content Fidelity">
      <data key="d0">Content Fidelity</data>
      <data key="d1">category</data>
      <data key="d2">A metric and objective in natural language generation assessing how accurately and fully a generated text represents the designated content record.&lt;SEP&gt;An evaluation metric and category measuring how accurately generated text preserves and reflects conditioning data tuples and information records.</data>
      <data key="d3">chunk-8fa216244e9956f33ee1e83a4b072080&lt;SEP&gt;chunk-e90c3963b2880a766180f3aafb75b379</data>
    </node>
    <node id="Style Preservation">
      <data key="d0">Style Preservation</data>
      <data key="d1">category</data>
      <data key="d2">A metric and generation objective aimed at retaining the linguistic traits, tone, and syntactic style of a reference sentence during content modification.&lt;SEP&gt;An evaluation metric and category assessing how well a generated sentence retains stylistic attributes, word choice, and expressions from a reference sentence.</data>
      <data key="d3">chunk-8fa216244e9956f33ee1e83a4b072080&lt;SEP&gt;chunk-e90c3963b2880a766180f3aafb75b379</data>
    </node>
    <node id="AttnCopy-S2S">
      <data key="d0">AttnCopy-S2S</data>
      <data key="d1">category</data>
      <data key="d2">A baseline sequence-to-sequence attention model with copy mechanisms that prioritizes content fidelity over style control.&lt;SEP&gt;A baseline sequence-to-sequence model incorporating an attention-copy mechanism to generate sentences from content records.</data>
      <data key="d3">chunk-8fa216244e9956f33ee1e83a4b072080&lt;SEP&gt;chunk-e90c3963b2880a766180f3aafb75b379</data>
    </node>
    <node id="Rule-Based Method">
      <data key="d0">Rule-Based Method</data>
      <data key="d1">category</data>
      <data key="d2">A baseline approach that modifies sentences via explicit heuristics, mapping tuples and tokens to substitute text without neural generation.&lt;SEP&gt;A baseline approach that performs deterministic token replacement on reference sentences, offering high style preservation but low content fidelity.</data>
      <data key="d3">chunk-8fa216244e9956f33ee1e83a4b072080&lt;SEP&gt;chunk-e90c3963b2880a766180f3aafb75b379</data>
    </node>
    <node id="Multi-Attribute Style Transfer">
      <data key="d0">Multi-Attribute Style Transfer</data>
      <data key="d1">category</data>
      <data key="d2">A style transfer technique (MAST) modeling multiple attributes using back-translation and auto-encoding architectures.</data>
      <data key="d3">chunk-e90c3963b2880a766180f3aafb75b379</data>
    </node>
    <node id="Adversarial Style Transfer">
      <data key="d0">Adversarial Style Transfer</data>
      <data key="d1">category</data>
      <data key="d2">A multi-attribute style transfer method (AdvST) combining back-translation, auto-encoding, and adversarial training to disentangle content from style.</data>
      <data key="d3">chunk-e90c3963b2880a766180f3aafb75b379</data>
    </node>
    <node id="Supervised Game Report Generation">
      <data key="d0">Supervised Game Report Generation</data>
      <data key="d1">category</data>
      <data key="d2">A subfield of natural language processing focused on training models using paired data of game box-scores and human-written sports reports.</data>
      <data key="d3">chunk-e90c3963b2880a766180f3aafb75b379</data>
    </node>
    <node id="Automatic Evaluation">
      <data key="d0">Automatic Evaluation</data>
      <data key="d1">event</data>
      <data key="d2">An automated empirical evaluation process designed to quantitatively assess model performance using algorithmic metrics for content fidelity and style preservation.</data>
      <data key="d3">chunk-8fa216244e9956f33ee1e83a4b072080</data>
    </node>
    <node id="Sentence Fluency">
      <data key="d0">Sentence Fluency</data>
      <data key="d1">category</data>
      <data key="d2">A qualitative evaluation criterion measuring the naturalness, grammatical correctness, and readability of generated text.</data>
      <data key="d3">chunk-8fa216244e9956f33ee1e83a4b072080</data>
    </node>
    <node id="Table-to-Document Task">
      <data key="d0">Table-to-Document Task</data>
      <data key="d1">category</data>
      <data key="d2">A natural language generation task category where models generate descriptive text conditioned on structured table or record data.</data>
      <data key="d3">chunk-8fa216244e9956f33ee1e83a4b072080</data>
    </node>
    <node id="AdvST">
      <data key="d0">AdvST</data>
      <data key="d1">category</data>
      <data key="d2">An adversarial style transfer baseline model evaluated for its ability to balance style preservation and content manipulation.&lt;SEP&gt;An adversarial style transfer model evaluated as a baseline method for text generation and content manipulation.</data>
      <data key="d3">chunk-8fa216244e9956f33ee1e83a4b072080&lt;SEP&gt;chunk-08e25f0ce4d7d5635eb6aed1b2807f91</data>
    </node>
    <node id="MAST">
      <data key="d0">MAST</data>
      <data key="d1">category</data>
      <data key="d2">A style transfer baseline model used as a point of comparison in content fidelity and style preservation evaluations.&lt;SEP&gt;A style transfer model architecture utilized as a comparative baseline in text generation experiments.</data>
      <data key="d3">chunk-8fa216244e9956f33ee1e83a4b072080&lt;SEP&gt;chunk-08e25f0ce4d7d5635eb6aed1b2807f91</data>
    </node>
    <node id="Adam Optimization">
      <data key="d0">Adam Optimization</data>
      <data key="d1">category</data>
      <data key="d2">An adaptive learning rate optimization algorithm used for training the neural network models with gradient clipping.</data>
      <data key="d3">chunk-8fa216244e9956f33ee1e83a4b072080</data>
    </node>
    <node id="LSTM RNN">
      <data key="d0">LSTM RNN</data>
      <data key="d1">category</data>
      <data key="d2">A recurrent neural network architecture featuring two layers and 1000 hidden states that functions as the neural language model for re-scoring.&lt;SEP&gt;A recurrent neural network architecture featuring two layers and 1000 hidden states, used as a neural language model for n-best re-scoring.&lt;SEP&gt;A recurrent neural network architecture using single-layer LSTM units employed in all encoders and decoders.</data>
      <data key="d3">chunk-8fa216244e9956f33ee1e83a4b072080&lt;SEP&gt;chunk-3c17cbdd46b3ef569862a8fa188b4fab&lt;SEP&gt;chunk-762be16cab89cb90aaf53d4505452bf5</data>
    </node>
    <node id="Beam Search">
      <data key="d0">Beam Search</data>
      <data key="d1">category</data>
      <data key="d2">A heuristic search and decoding algorithm used during inference with a specified beam-width to produce output sentences.&lt;SEP&gt;A heuristic search and sequence decoding algorithm category applied during inference to optimize sentence generation quality.&lt;SEP&gt;Beam Search is a decoding algorithm applied during testing to generate the best translation outputs from trained sequence models.&lt;SEP&gt;Beam search is an algorithmic search strategy used by Pipelinebeam to iteratively select facts, sentence plans, natural language names, and fact subsets.</data>
      <data key="d3">chunk-8fa216244e9956f33ee1e83a4b072080&lt;SEP&gt;chunk-15b5829d32b6817e2c4e142dba61455b&lt;SEP&gt;chunk-ded262becf3ee747d4ac144ff92895ad&lt;SEP&gt;chunk-ddef736560bcb899db81b75205f4df60</data>
    </node>
    <node id="Information Extraction">
      <data key="d0">Information Extraction</data>
      <data key="d1">category</data>
      <data key="d2">A broad field of computer science focused on deriving structured information from unstructured data sources.&lt;SEP&gt;A subfield of natural language processing focused on automatically extracting structured information such as entities and relations from unstructured text.&lt;SEP&gt;An NLP method and tool used to extract structured data tuples from text to compute precision and recall against conditioned inputs.&lt;SEP&gt;Information Extraction is a natural language processing application that benefits from coreference resolution as a prerequisite text understanding step.</data>
      <data key="d3">chunk-8fa216244e9956f33ee1e83a4b072080&lt;SEP&gt;chunk-57acb1a29c2b86c001f999352f15c3cc&lt;SEP&gt;chunk-ea126b0da9c38f85b697b36cd33629f5&lt;SEP&gt;chunk-2425a9bfa1c48f3e56350fa213bdbdab</data>
    </node>
    <node id="Content Coverage Constraint">
      <data key="d0">Content Coverage Constraint</data>
      <data key="d1">category</data>
      <data key="d2">A modeling constraint encouraging text generators to mention each conditioned data record exactly once.</data>
      <data key="d3">chunk-8fa216244e9956f33ee1e83a4b072080</data>
    </node>
    <node id="Ours w/o Coverage">
      <data key="d0">Ours w/o Coverage</data>
      <data key="d1">category</data>
      <data key="d2">An ablation variant of the proposed model that omits the content coverage constraint to assess its impact on fidelity and style.</data>
      <data key="d3">chunk-8fa216244e9956f33ee1e83a4b072080</data>
    </node>
    <node id="Human Turkers">
      <data key="d0">Human Turkers</data>
      <data key="d1">person</data>
      <data key="d2">Crowd-sourced evaluators who participate in human study tasks to score and rank model-generated sentences.</data>
      <data key="d3">chunk-8fa216244e9956f33ee1e83a4b072080</data>
    </node>
    <node id="Bulls">
      <data key="d0">Bulls</data>
      <data key="d1">organization</data>
      <data key="d2">A sports team referenced in the text evaluation examples used for assessing structured content generation and manipulation.</data>
      <data key="d3">chunk-08e25f0ce4d7d5635eb6aed1b2807f91</data>
    </node>
    <node id="Clinical Natural Language Processing">
      <data key="d0">Clinical Natural Language Processing</data>
      <data key="d1">category</data>
      <data key="d2">A domain of artificial intelligence and computational linguistics dedicated to the analysis and processing of clinical records and healthcare data.&lt;SEP&gt;A subfield of artificial intelligence and computer science focused on developing computational methods for linguistic analysis and knowledge extraction from free-text clinical records.</data>
      <data key="d3">chunk-7562690242fd78972d67afd148f518b1&lt;SEP&gt;chunk-08e25f0ce4d7d5635eb6aed1b2807f91</data>
    </node>
    <node id="Rule-based Method">
      <data key="d0">Rule-based Method</data>
      <data key="d1">category</data>
      <data key="d2">A class of natural language processing techniques that relies on predefined linguistic rules and lightweight token replacement.</data>
      <data key="d3">chunk-08e25f0ce4d7d5635eb6aed1b2807f91</data>
    </node>
    <node id="AttnCopy Seq2seq">
      <data key="d0">AttnCopy Seq2seq</data>
      <data key="d1">category</data>
      <data key="d2">An attention-based sequence-to-sequence neural model with copying mechanisms serving as a baseline architecture for text generation.</data>
      <data key="d3">chunk-08e25f0ce4d7d5635eb6aed1b2807f91</data>
    </node>
    <node id="Qualitative Study">
      <data key="d0">Qualitative Study</data>
      <data key="d1">event</data>
      <data key="d2">An analytical examination conducted to inspect and compare generated sentence outputs across different model variants and test cases.</data>
      <data key="d3">chunk-08e25f0ce4d7d5635eb6aed1b2807f91</data>
    </node>
    <node id="Clinical Practice">
      <data key="d0">Clinical Practice</data>
      <data key="d1">category</data>
      <data key="d2">The medical and healthcare field that stands to be transformed through the large-scale computational processing of clinical records.</data>
      <data key="d3">chunk-08e25f0ce4d7d5635eb6aed1b2807f91</data>
    </node>
    <node id="Data Access Policies">
      <data key="d0">Data Access Policies</data>
      <data key="d1">category</data>
      <data key="d2">Regulatory, ethical, and institutional governance frameworks that restrict researcher access to sensitive medical data.</data>
      <data key="d3">chunk-08e25f0ce4d7d5635eb6aed1b2807f91</data>
    </node>
    <node id="Data Privacy">
      <data key="d0">Data Privacy</data>
      <data key="d1">category</data>
      <data key="d2">An ethical and regulatory principle focused on safeguarding sensitive patient health information in clinical records.</data>
      <data key="d3">chunk-08e25f0ce4d7d5635eb6aed1b2807f91</data>
    </node>
    <node id="Biomedical Natural Language Processing">
      <data key="d0">Biomedical Natural Language Processing</data>
      <data key="d1">category</data>
      <data key="d2">A domain of natural language processing focused on analyzing biomedical research literature, which faces fewer data privacy restrictions than clinical NLP.</data>
      <data key="d3">chunk-7562690242fd78972d67afd148f518b1</data>
    </node>
    <node id="HIPAA Privacy Rule">
      <data key="d0">HIPAA Privacy Rule</data>
      <data key="d1">category</data>
      <data key="d2">A United States regulatory framework that legally protects confidential patient medical information and clinician encounter records.&lt;SEP&gt;A health data privacy regulation that permits disclosure of health records of deceased individuals under specific conditions without IRB approval.&lt;SEP&gt;A legal framework in the United States that protects the confidentiality of individuals' medical and health data.</data>
      <data key="d3">chunk-7562690242fd78972d67afd148f518b1&lt;SEP&gt;chunk-bd3cd3db55d1536871b82317efd46a4b&lt;SEP&gt;chunk-c029640c5730b975534572e9f8f96fc9</data>
    </node>
    <node id="General Data Protection Regulation">
      <data key="d0">General Data Protection Regulation</data>
      <data key="d1">category</data>
      <data key="d2">A European Union legal framework governing the principles and scientific processing of personal and health data.&lt;SEP&gt;European Union regulation governing data protection, privacy principles like data minimization, and the scientific use of sensitive health data.</data>
      <data key="d3">chunk-7562690242fd78972d67afd148f518b1&lt;SEP&gt;chunk-bd3cd3db55d1536871b82317efd46a4b</data>
    </node>
    <node id="MIMIC-III">
      <data key="d0">MIMIC-III</data>
      <data key="d1">category</data>
      <data key="d2">A widely used clinical dataset covering intensive care admissions from a single hospital in the United States, subject to sampling bias.</data>
      <data key="d3">chunk-7562690242fd78972d67afd148f518b1</data>
    </node>
    <node id="I2b2 Shared Tasks">
      <data key="d0">I2b2 Shared Tasks</data>
      <data key="d1">event</data>
      <data key="d2">Collaborative evaluation events and competitive benchmarks providing annotated clinical datasets for NLP research.</data>
      <data key="d3">chunk-7562690242fd78972d67afd148f518b1</data>
    </node>
    <node id="ShARe/CLEF">
      <data key="d0">ShARe/CLEF</data>
      <data key="d1">event</data>
      <data key="d2">Shared clinical challenge tasks that produce annotated datasets for research community evaluation.</data>
      <data key="d3">chunk-7562690242fd78972d67afd148f518b1</data>
    </node>
    <node id="MiPACQ">
      <data key="d0">MiPACQ</data>
      <data key="d1">category</data>
      <data key="d2">A clinical text corpus used in published research that was subsequently restricted, trimmed down, or made unavailable due to legal or access issues.</data>
      <data key="d3">chunk-7562690242fd78972d67afd148f518b1</data>
    </node>
    <node id="Blulab">
      <data key="d0">Blulab</data>
      <data key="d1">category</data>
      <data key="d2">A clinical dataset previously utilized in published research and reproduction efforts that faced subsequent access restrictions.</data>
      <data key="d3">chunk-7562690242fd78972d67afd148f518b1</data>
    </node>
    <node id="EMC Dutch Clinical Corpus">
      <data key="d0">EMC Dutch Clinical Corpus</data>
      <data key="d1">category</data>
      <data key="d2">A Dutch-language clinical dataset that was utilized in empirical research but later faced distribution limitations or reduced availability.</data>
      <data key="d3">chunk-7562690242fd78972d67afd148f518b1</data>
    </node>
    <node id="2010 i2b2/VA Dataset">
      <data key="d0">2010 i2b2/VA Dataset</data>
      <data key="d1">category</data>
      <data key="d2">A clinical benchmark dataset consisting of 841 annotated patient records across three specialty areas used for training named entity recognition models.</data>
      <data key="d3">chunk-7562690242fd78972d67afd148f518b1</data>
    </node>
    <node id="Data Science">
      <data key="d0">Data Science</data>
      <data key="d1">category</data>
      <data key="d2">The broader field of analyzing data and developing computational models, sharing ethical and bias challenges with clinical NLP.</data>
      <data key="d3">chunk-7562690242fd78972d67afd148f518b1</data>
    </node>
    <node id="Sampling Bias">
      <data key="d0">Sampling Bias</data>
      <data key="d1">category</data>
      <data key="d2">A corpus-level bias that arises when the collected dataset does not adequately represent the target population.&lt;SEP&gt;A systemic error where a specific dataset or sample fails to represent the broader population, leading to skewed research conclusions and model invalidity.</data>
      <data key="d3">chunk-7562690242fd78972d67afd148f518b1&lt;SEP&gt;chunk-c029640c5730b975534572e9f8f96fc9</data>
    </node>
    <node id="EU">
      <data key="d0">EU</data>
      <data key="d1">geo</data>
      <data key="d2">The European Union, where the processing and scientific usage of health data are regulated under the General Data Protection Regulation.</data>
      <data key="d3">chunk-bd3cd3db55d1536871b82317efd46a4b</data>
    </node>
    <node id="Clinical NLP">
      <data key="d0">Clinical NLP</data>
      <data key="d1">category</data>
      <data key="d2">A specialized subfield of natural language processing focusing on extracting information, concepts, and knowledge from clinical and health-related documents.&lt;SEP&gt;A subfield of natural language processing focusing on the analysis of clinical records and medical text data.&lt;SEP&gt;The domain of applying natural language processing techniques to clinical notes, medical records, and healthcare data.</data>
      <data key="d3">chunk-8d534b033667c04cda76230428876daf&lt;SEP&gt;chunk-bd3cd3db55d1536871b82317efd46a4b&lt;SEP&gt;chunk-c029640c5730b975534572e9f8f96fc9</data>
    </node>
    <node id="Sanitization">
      <data key="d0">Sanitization</data>
      <data key="d1">category</data>
      <data key="d2">Data privacy techniques, including anonymization and de-identification, used to remove or alter sensitive identifiers from datasets.</data>
      <data key="d3">chunk-bd3cd3db55d1536871b82317efd46a4b</data>
    </node>
    <node id="Informed Consent">
      <data key="d0">Informed Consent</data>
      <data key="d1">category</data>
      <data key="d2">The legal and ethical process of obtaining explicit authorization from data subjects to collect, use, and process their health data.</data>
      <data key="d3">chunk-bd3cd3db55d1536871b82317efd46a4b</data>
    </node>
    <node id="Personal Genome Project">
      <data key="d0">Personal Genome Project</data>
      <data key="d1">organization</data>
      <data key="d2">An initiative that implements open consent by allowing individuals to make their personal data publicly available for research.</data>
      <data key="d3">chunk-bd3cd3db55d1536871b82317efd46a4b</data>
    </node>
    <node id="Polonetsky">
      <data key="d0">Polonetsky</data>
      <data key="d1">person</data>
      <data key="d2">A researcher cited for work providing overviews on sanitization procedures such as anonymization, pseudonymization, and de-identification.</data>
      <data key="d3">chunk-bd3cd3db55d1536871b82317efd46a4b</data>
    </node>
    <node id="Dwork">
      <data key="d0">Dwork</data>
      <data key="d1">person</data>
      <data key="d2">A researcher cited for studies on secure data access, storage, and the trade-off between privacy loss and data utility.</data>
      <data key="d3">chunk-bd3cd3db55d1536871b82317efd46a4b</data>
    </node>
    <node id="Pottenger">
      <data key="d0">Pottenger</data>
      <data key="d1">person</data>
      <data key="d2">A researcher cited alongside Dwork concerning secure access and storage of sensitive clinical data.</data>
      <data key="d3">chunk-bd3cd3db55d1536871b82317efd46a4b</data>
    </node>
    <node id="Malin">
      <data key="d0">Malin</data>
      <data key="d1">person</data>
      <data key="d2">A researcher cited for contributions to research on secure access and confidentiality of sensitive health data.</data>
      <data key="d3">chunk-bd3cd3db55d1536871b82317efd46a4b</data>
    </node>
    <node id="Rindfleisch">
      <data key="d0">Rindfleisch</data>
      <data key="d1">person</data>
      <data key="d2">A researcher cited for literature regarding secure data access, storage, and confidentiality in clinical settings.</data>
      <data key="d3">chunk-bd3cd3db55d1536871b82317efd46a4b</data>
    </node>
    <node id="Data Minimization">
      <data key="d0">Data Minimization</data>
      <data key="d1">category</data>
      <data key="d2">A core data protection principle under GDPR mandating that personal data collection and processing be limited to what is strictly necessary and retained only as long as required, encompassing techniques like sanitization.</data>
      <data key="d3">chunk-bd3cd3db55d1536871b82317efd46a4b</data>
    </node>
    <node id="Special Categories Of Personal Data">
      <data key="d0">Special Categories Of Personal Data</data>
      <data key="d1">category</data>
      <data key="d2">A GDPR regulatory classification for sensitive data, including health data, requiring explicit subject consent or public disclosure by the subject before scientific or technological processing.</data>
      <data key="d3">chunk-bd3cd3db55d1536871b82317efd46a4b</data>
    </node>
    <node id="Anonymization">
      <data key="d0">Anonymization</data>
      <data key="d1">category</data>
      <data key="d2">A sanitization technique that removes or modifies personal identifying details to prevent identification of individuals in a dataset.</data>
      <data key="d3">chunk-bd3cd3db55d1536871b82317efd46a4b</data>
    </node>
    <node id="Pseudonymization">
      <data key="d0">Pseudonymization</data>
      <data key="d1">category</data>
      <data key="d2">A data protection technique that replaces personal identifiers with pseudonyms to reduce linkability while preserving analytical utility.</data>
      <data key="d3">chunk-bd3cd3db55d1536871b82317efd46a4b</data>
    </node>
    <node id="De-Identification">
      <data key="d0">De-Identification</data>
      <data key="d1">category</data>
      <data key="d2">A process of removing or obscuring personal identifiers from clinical and health datasets to preserve subject confidentiality.</data>
      <data key="d3">chunk-bd3cd3db55d1536871b82317efd46a4b</data>
    </node>
    <node id="Deductive Disclosure">
      <data key="d0">Deductive Disclosure</data>
      <data key="d1">category</data>
      <data key="d2">A re-identification phenomenon where sanitized or de-identified data is re-linked to an individual using external information or inference.</data>
      <data key="d3">chunk-bd3cd3db55d1536871b82317efd46a4b</data>
    </node>
    <node id="Opt-In Policy">
      <data key="d0">Opt-In Policy</data>
      <data key="d1">category</data>
      <data key="d2">A consent framework where consent is presumed or granted by default, often coupled with a right to withdraw (opt-out), potentially structured in a broad or tiered manner.</data>
      <data key="d3">chunk-bd3cd3db55d1536871b82317efd46a4b</data>
    </node>
    <node id="Open Consent">
      <data key="d0">Open Consent</data>
      <data key="d1">category</data>
      <data key="d2">A data-sharing paradigm where participants agree to have their sensitive or genomic data made publicly available without guarantees of total anonymity.</data>
      <data key="d3">chunk-bd3cd3db55d1536871b82317efd46a4b</data>
    </node>
    <node id="Secure Access">
      <data key="d0">Secure Access</data>
      <data key="d1">category</data>
      <data key="d2">Data governance and computational mechanisms designed to provide researchers controlled, secure entry to sensitive clinical data while balancing utility and privacy.</data>
      <data key="d3">chunk-bd3cd3db55d1536871b82317efd46a4b</data>
    </node>
    <node id="Medical Institutions">
      <data key="d0">Medical Institutions</data>
      <data key="d1">organization</data>
      <data key="d2">Healthcare and clinical organizations that generate, store, and govern patient health records and clinical data.</data>
      <data key="d3">chunk-bd3cd3db55d1536871b82317efd46a4b</data>
    </node>
    <node id="VetCompass">
      <data key="d0">VetCompass</data>
      <data key="d1">organization</data>
      <data key="d2">A repository storing tens of millions of clinical documents from various veterinary clinics in the UK and Australia for research purposes.</data>
      <data key="d3">chunk-c029640c5730b975534572e9f8f96fc9</data>
    </node>
    <node id="Australia">
      <data key="d0">Australia</data>
      <data key="d1">geo</data>
      <data key="d2">A country whose workers were accepted to provide annotations for the dataset via AMT.&lt;SEP&gt;A nation where veterinary clinics contribute clinical documentation to the centralized VetCompass repository.&lt;SEP&gt;Australia is a country noted for being over-represented in Twitter language data compared to its population size.&lt;SEP&gt;Australia is a country showing over-predicted languages in Twitter data compared to census records.&lt;SEP&gt;Australia is one of the countries from which crowd workers were accepted to carry out annotation tasks.</data>
      <data key="d3">chunk-ef7b95a2f35faad97942f87543b7ab1f&lt;SEP&gt;chunk-c029640c5730b975534572e9f8f96fc9&lt;SEP&gt;chunk-d7d53ab63937232bbcc4be9c7080dd31&lt;SEP&gt;chunk-1d721fe5dad0029252753a2c12969e26&lt;SEP&gt;chunk-362346ad5b3a18dced3a68b0e282ea62</data>
    </node>
    <node id="Clinical NLP 2016 Workshop">
      <data key="d0">Clinical NLP 2016 Workshop</data>
      <data key="d1">event</data>
      <data key="d2">An academic workshop where early natural language processing work utilizing veterinary records from VetCompass was presented.</data>
      <data key="d3">chunk-c029640c5730b975534572e9f8f96fc9</data>
    </node>
    <node id="Kramer et al.">
      <data key="d0">Kramer et al.</data>
      <data key="d1">person</data>
      <data key="d2">Researchers who authored an influential study on emotional contagion via Facebook posts, which faced scrutiny over consent.</data>
      <data key="d3">chunk-c029640c5730b975534572e9f8f96fc9</data>
    </node>
    <node id="Rebholz-Schuhmann et al.">
      <data key="d0">Rebholz-Schuhmann et al.</data>
      <data key="d1">person</data>
      <data key="d2">Researchers known for work on ensembling trained models from disparate sources and creating silver standard corpora.</data>
      <data key="d3">chunk-c029640c5730b975534572e9f8f96fc9</data>
    </node>
    <node id="Lipton et al.">
      <data key="d0">Lipton et al.</data>
      <data key="d1">person</data>
      <data key="d2">Researchers who explored sequential modeling applied to diagnosis classification and imputing missing values in clinical texts.</data>
      <data key="d3">chunk-c029640c5730b975534572e9f8f96fc9</data>
    </node>
    <node id="Reporting Bias">
      <data key="d0">Reporting Bias</data>
      <data key="d1">category</data>
      <data key="d2">A form of bias found in clinical texts stemming from subjective clinician documentation, selective recall by patients, or suppression of sensitive information.&lt;SEP&gt;A form of bias in clinical documentation where information is selectively omitted, altered, or suppressed due to social stigma, legal fears, or clinician prejudices.</data>
      <data key="d3">chunk-8d534b033667c04cda76230428876daf&lt;SEP&gt;chunk-c029640c5730b975534572e9f8f96fc9</data>
    </node>
    <node id="Algorithm Transparency">
      <data key="d0">Algorithm Transparency</data>
      <data key="d1">category</data>
      <data key="d2">An ethical and legal principle requiring insight into how automated models make decisions and how training data biases influence outcomes.</data>
      <data key="d3">chunk-c029640c5730b975534572e9f8f96fc9</data>
    </node>
    <node id="Government">
      <data key="d0">Government</data>
      <data key="d1">organization</data>
      <data key="d2">Public governing bodies that can facilitate and guarantee researchers' access to relevant health data.</data>
      <data key="d3">chunk-c029640c5730b975534572e9f8f96fc9</data>
    </node>
    <node id="Healthcare Organizations">
      <data key="d0">Healthcare Organizations</data>
      <data key="d1">organization</data>
      <data key="d2">Medical and clinical institutions that maintain patient records and provide the computational infrastructure for health data research.</data>
      <data key="d3">chunk-c029640c5730b975534572e9f8f96fc9</data>
    </node>
    <node id="Statistical NLP">
      <data key="d0">Statistical NLP</data>
      <data key="d1">category</data>
      <data key="d2">A computational methodology within natural language processing that relies on statistical methods, requiring significant CPU and GPU power.</data>
      <data key="d3">chunk-c029640c5730b975534572e9f8f96fc9</data>
    </node>
    <node id="Interoperability">
      <data key="d0">Interoperability</data>
      <data key="d1">category</data>
      <data key="d2">The ability to share and combine health data across different medical institutions to improve statistical power and reduce bias in research.</data>
      <data key="d3">chunk-c029640c5730b975534572e9f8f96fc9</data>
    </node>
    <node id="Epidemiology">
      <data key="d0">Epidemiology</data>
      <data key="d1">category</data>
      <data key="d2">The study of health and disease distribution in populations, requiring cross-organizational interoperability to attain statistical power.</data>
      <data key="d3">chunk-c029640c5730b975534572e9f8f96fc9</data>
    </node>
    <node id="Surrogate Data">
      <data key="d0">Surrogate Data</data>
      <data key="d1">category</data>
      <data key="d2">Alternative health-related textual data, such as patient-generated content and social media posts, used to complement or substitute clinical discourse.</data>
      <data key="d3">chunk-c029640c5730b975534572e9f8f96fc9</data>
    </node>
    <node id="Derived Data">
      <data key="d0">Derived Data</data>
      <data key="d1">category</data>
      <data key="d2">Secondary forms of data such as text fragments, statistics, and trained models that reduce privacy risks because they prevent reconstruction of original patient text.</data>
      <data key="d3">chunk-c029640c5730b975534572e9f8f96fc9</data>
    </node>
    <node id="Data Quality">
      <data key="d0">Data Quality</data>
      <data key="d1">category</data>
      <data key="d2">The degree to which clinical notes accurately, completely, and explicitly reflect patient health conditions and treatment contexts.</data>
      <data key="d3">chunk-c029640c5730b975534572e9f8f96fc9</data>
    </node>
    <node id="Health Disparities">
      <data key="d0">Health Disparities</data>
      <data key="d1">category</data>
      <data key="d2">Systemic variations in healthcare access and treatment, reflected in clinical text through prejudices, ethnic communication gaps, and societal norms.&lt;SEP&gt;Unequal health outcomes and documentation gaps in clinical notes driven by practitioner prejudices or communication barriers across ethnic groups.</data>
      <data key="d3">chunk-8d534b033667c04cda76230428876daf&lt;SEP&gt;chunk-c029640c5730b975534572e9f8f96fc9</data>
    </node>
    <node id="Brady">
      <data key="d0">Brady</data>
      <data key="d1">person</data>
      <data key="d2">A researcher who, along with colleagues, found documentation disparities regarding obesity between sexes in weight clinics due to societal norms.</data>
      <data key="d3">chunk-8d534b033667c04cda76230428876daf</data>
    </node>
    <node id="Madhumita">
      <data key="d0">Madhumita</data>
      <data key="d1">person</data>
      <data key="d2">An individual acknowledged by the authors of the clinical NLP paper for providing helpful comments.</data>
      <data key="d3">chunk-8d534b033667c04cda76230428876daf</data>
    </node>
    <node id="Agency for Innovation by Science and Technology">
      <data key="d0">Agency for Innovation by Science and Technology</data>
      <data key="d1">organization</data>
      <data key="d2">A government agency (IWT) that funded the research through the Accumulate IWT SBO project.</data>
      <data key="d3">chunk-8d534b033667c04cda76230428876daf</data>
    </node>
    <node id="Duluth">
      <data key="d0">Duluth</data>
      <data key="d1">organization</data>
      <data key="d2">A research team and system that participated in SemEval-2017 Task 6 using N-gram language models for humor detection.</data>
      <data key="d3">chunk-8d534b033667c04cda76230428876daf</data>
    </node>
    <node id="Comedy Central">
      <data key="d0">Comedy Central</data>
      <data key="d1">organization</data>
      <data key="d2">A television network that aired the show @midnight with Chris Hardwick, which served as the source material for the humor detection task.</data>
      <data key="d3">chunk-8d534b033667c04cda76230428876daf</data>
    </node>
    <node id="Chris Hardwick">
      <data key="d0">Chris Hardwick</data>
      <data key="d1">person</data>
      <data key="d2">The host of the Comedy Central television show @midnight, who provides hashtags that inspire humorous responses.</data>
      <data key="d3">chunk-8d534b033667c04cda76230428876daf</data>
    </node>
    <node id="SemEval-2017 Task 6">
      <data key="d0">SemEval-2017 Task 6</data>
      <data key="d1">event</data>
      <data key="d2">An international NLP evaluation workshop task titled '#HashtagWars: Learning a Sense of Humor', focusing on computational humor detection.</data>
      <data key="d3">chunk-8d534b033667c04cda76230428876daf</data>
    </node>
    <node id="Computational Humor">
      <data key="d0">Computational Humor</data>
      <data key="d1">category</data>
      <data key="d2">An interdisciplinary research field combining linguistics, psychology, philosophy, and computer science to model, generate, or detect humor.</data>
      <data key="d3">chunk-8d534b033667c04cda76230428876daf</data>
    </node>
    <node id="Observational Bias">
      <data key="d0">Observational Bias</data>
      <data key="d1">category</data>
      <data key="d2">A bias occurring when explanatory factors are missing from clinical reports because they fall outside the experimental or clinical observation setting.</data>
      <data key="d3">chunk-8d534b033667c04cda76230428876daf</data>
    </node>
    <node id="Dual Use">
      <data key="d0">Dual Use</data>
      <data key="d1">category</data>
      <data key="d2">The concept and ethical issue where technologies or health information can be applied in both beneficial and harmful ways.</data>
      <data key="d3">chunk-8d534b033667c04cda76230428876daf</data>
    </node>
    <node id="Accumulate IWT SBO Project">
      <data key="d0">Accumulate IWT SBO Project</data>
      <data key="d1">organization</data>
      <data key="d2">A research project framework under which part of the clinical NLP research was carried out, sponsored by the IWT.</data>
      <data key="d3">chunk-8d534b033667c04cda76230428876daf</data>
    </node>
    <node id="@midnight">
      <data key="d0">@midnight</data>
      <data key="d1">event</data>
      <data key="d2">A Comedy Central television show hosted by Chris Hardwick that inspired audience tweets used as evaluation data for computational humor tasks.</data>
      <data key="d3">chunk-8d534b033667c04cda76230428876daf</data>
    </node>
    <node id="Subtask A">
      <data key="d0">Subtask A</data>
      <data key="d1">event</data>
      <data key="d2">A specific sub-competition within SemEval-2017 Task 6 in which the Duluth system participated.&lt;SEP&gt;A subtask within a natural language processing shared evaluation focused on pair-wise comparison of tweets to determine which is funnier.&lt;SEP&gt;Subtask A is a tweet humor comparison challenge where a system compares pairs of tweets to determine the funnier one.</data>
      <data key="d3">chunk-1c233285dd27a358f6bf38c2050006d0&lt;SEP&gt;chunk-8d534b033667c04cda76230428876daf&lt;SEP&gt;chunk-1f5cacf6864d5742410fde3c5baacf4f</data>
    </node>
    <node id="Streetlight Effect">
      <data key="d0">Streetlight Effect</data>
      <data key="d1">category</data>
      <data key="d2">An observational bias referring to the search for explanatory factors only where it is easy to look, leading to missed social and behavioral determinants in clinical texts.</data>
      <data key="d3">chunk-8d534b033667c04cda76230428876daf</data>
    </node>
    <node id="Privacy in Health">
      <data key="d0">Privacy in Health</data>
      <data key="d1">category</data>
      <data key="d2">The domain of data protection and patient confidentiality governing access to sensitive clinical notes and health records.</data>
      <data key="d3">chunk-8d534b033667c04cda76230428876daf</data>
    </node>
    <node id="Right to Science">
      <data key="d0">Right to Science</data>
      <data key="d1">category</data>
      <data key="d2">The ethical and legal principle emphasizing the right of individuals and society to participate in and benefit from scientific progress.</data>
      <data key="d3">chunk-8d534b033667c04cda76230428876daf</data>
    </node>
    <node id="Humor Generation">
      <data key="d0">Humor Generation</data>
      <data key="d1">category</data>
      <data key="d2">A subfield of computational humor focused on developing systems that synthesize comedic content.</data>
      <data key="d3">chunk-8d534b033667c04cda76230428876daf</data>
    </node>
    <node id="Recall Bias">
      <data key="d0">Recall Bias</data>
      <data key="d1">category</data>
      <data key="d2">A systematic error in clinical data caused by differences in how patients remember and report their medical experiences.</data>
      <data key="d3">chunk-8d534b033667c04cda76230428876daf</data>
    </node>
    <node id="N-gram Language Model">
      <data key="d0">N-gram Language Model</data>
      <data key="d1">category</data>
      <data key="d2">An N-gram Language Model is a statistical language modeling approach that estimates the probability of a word sequence using contiguous sequences of N words.</data>
      <data key="d3">chunk-1f5cacf6864d5742410fde3c5baacf4f</data>
    </node>
    <node id="Trigram Language Model">
      <data key="d0">Trigram Language Model</data>
      <data key="d1">category</data>
      <data key="d2">A Trigram Language Model is a specific type of N-gram language model that predicts word probabilities based on sequences of three words or two prior context words.&lt;SEP&gt;A statistical n-gram language modeling technique using sequences of three words, evaluated on tweet and news datasets for humor classification.</data>
      <data key="d3">chunk-1c233285dd27a358f6bf38c2050006d0&lt;SEP&gt;chunk-1f5cacf6864d5742410fde3c5baacf4f</data>
    </node>
    <node id="Brown Corpus">
      <data key="d0">Brown Corpus</data>
      <data key="d1">category</data>
      <data key="d2">The Brown Corpus is a text corpus whose newswire sections were used in prior research to build a 'common language' model.</data>
      <data key="d3">chunk-1f5cacf6864d5742410fde3c5baacf4f</data>
    </node>
    <node id="News Commentary Corpus">
      <data key="d0">News Commentary Corpus</data>
      <data key="d1">category</data>
      <data key="d2">The News Commentary Corpus is a collection of English news text used alongside the News Crawl Corpus to train unfunny baseline language models.</data>
      <data key="d3">chunk-1f5cacf6864d5742410fde3c5baacf4f</data>
    </node>
    <node id="News Crawl Corpus">
      <data key="d0">News Crawl Corpus</data>
      <data key="d1">category</data>
      <data key="d2">The News Crawl Corpus is an English news dataset from 2008, 2010, and 2011 utilized to train common language models.</data>
      <data key="d3">chunk-1f5cacf6864d5742410fde3c5baacf4f</data>
    </node>
    <node id="KenLM Toolkit">
      <data key="d0">KenLM Toolkit</data>
      <data key="d1">category</data>
      <data key="d2">The KenLM Toolkit is a language modeling software tool used to train, estimate, and score N-gram models with modified Kneser-Ney smoothing.</data>
      <data key="d3">chunk-1f5cacf6864d5742410fde3c5baacf4f</data>
    </node>
    <node id="Modified Kneser-Ney Smoothing">
      <data key="d0">Modified Kneser-Ney Smoothing</data>
      <data key="d1">category</data>
      <data key="d2">Modified Kneser-Ney Smoothing is an estimation and smoothing technique applied without pruning in the KenLM tool to handle unseen N-grams.</data>
      <data key="d3">chunk-1f5cacf6864d5742410fde3c5baacf4f</data>
    </node>
    <node id="Statistical Language Model">
      <data key="d0">Statistical Language Model</data>
      <data key="d1">category</data>
      <data key="d2">A statistical language model estimates the probability distribution of a sequence of words or an upcoming word based on linguistic training data.</data>
      <data key="d3">chunk-1f5cacf6864d5742410fde3c5baacf4f</data>
    </node>
    <node id="Unigram">
      <data key="d0">Unigram</data>
      <data key="d1">category</data>
      <data key="d2">A unigram is a single-word sequence representing the lowest order unit in N-gram language modeling.</data>
      <data key="d3">chunk-1f5cacf6864d5742410fde3c5baacf4f</data>
    </node>
    <node id="Bigram">
      <data key="d0">Bigram</data>
      <data key="d1">category</data>
      <data key="d2">A bigram is a contiguous two-word sequence utilized in training statistical language models.</data>
      <data key="d3">chunk-1f5cacf6864d5742410fde3c5baacf4f</data>
    </node>
    <node id="Markov Assumption">
      <data key="d0">Markov Assumption</data>
      <data key="d1">category</data>
      <data key="d2">The Markov assumption posits that the probability of a word depends solely on a small number of preceding words, simplifying sentence probability estimation.</data>
      <data key="d3">chunk-1f5cacf6864d5742410fde3c5baacf4f</data>
    </node>
    <node id="Common Language Model">
      <data key="d0">Common Language Model</data>
      <data key="d1">category</data>
      <data key="d2">A common language model represents standard, typical language patterns, serving as a baseline to evaluate distinctiveness, memorability, and humor.</data>
      <data key="d3">chunk-1f5cacf6864d5742410fde3c5baacf4f</data>
    </node>
    <node id="Back-Off Technique">
      <data key="d0">Back-Off Technique</data>
      <data key="d1">category</data>
      <data key="d2">The back-off technique is an estimation method in KenLM that calculates probabilities using lower-order N-grams with back-off weights when higher-order N-grams are absent.</data>
      <data key="d3">chunk-1f5cacf6864d5742410fde3c5baacf4f</data>
    </node>
    <node id="Tokenization">
      <data key="d0">Tokenization</data>
      <data key="d1">category</data>
      <data key="d2">Tokenization is a linguistic data preprocessing step performed via specialized toolkits to segment Twitter messages into filtered word tokens.&lt;SEP&gt;Tokenization is a text pre-processing procedure where input text is segmented into discrete tokens by splitting on whitespace and punctuation.</data>
      <data key="d3">chunk-d46bdf96e3fc5df8745fb87337fae5aa&lt;SEP&gt;chunk-1f5cacf6864d5742410fde3c5baacf4f</data>
    </node>
    <node id="Filtering">
      <data key="d0">Filtering</data>
      <data key="d1">category</data>
      <data key="d2">Filtering is a pre-processing method specifically applied to the tweet corpus to remove URLs, user mentions, and hashtag symbols.</data>
      <data key="d3">chunk-1f5cacf6864d5742410fde3c5baacf4f</data>
    </node>
    <node id="Task Organizers">
      <data key="d0">Task Organizers</data>
      <data key="d1">organization</data>
      <data key="d2">The Task Organizers are the competition committee responsible for providing the tweet datasets and formulating Subtask A and Subtask B.&lt;SEP&gt;The committee or coordinating body responsible for designing the shared ICD-10 coding challenge and providing datasets, dictionaries, and evaluation benchmarks.</data>
      <data key="d3">chunk-b0d30e05ac4755125277651156c72d63&lt;SEP&gt;chunk-1f5cacf6864d5742410fde3c5baacf4f</data>
    </node>
    <node id="Tweet Corpus">
      <data key="d0">Tweet Corpus</data>
      <data key="d1">category</data>
      <data key="d2">The Tweet Corpus is a dataset provided by task organizers consisting of 106 hashtag files and approximately 21,000 tokens divided into development and training partitions.</data>
      <data key="d3">chunk-1f5cacf6864d5742410fde3c5baacf4f</data>
    </node>
    <node id="Bigram Language Model">
      <data key="d0">Bigram Language Model</data>
      <data key="d1">category</data>
      <data key="d2">A statistical n-gram language modeling technique using sequences of two words, analyzed during the development and post-evaluation phases.</data>
      <data key="d3">chunk-1c233285dd27a358f6bf38c2050006d0</data>
    </node>
    <node id="#HashtagWars">
      <data key="d0">#HashtagWars</data>
      <data key="d1">event</data>
      <data key="d2">An online social media competition or trend generating humor-oriented tweets targeted for future corpus collection.</data>
      <data key="d3">chunk-1c233285dd27a358f6bf38c2050006d0</data>
    </node>
    <node id="Neural Relation Extraction">
      <data key="d0">Neural Relation Extraction</data>
      <data key="d1">category</data>
      <data key="d2">A natural language processing methodology aimed at extracting semantic relations between entities using neural networks.&lt;SEP&gt;A natural language processing subfield and machine learning category focused on extracting semantic relations between entities using neural models.&lt;SEP&gt;A subfield and task in natural language processing (NRE) focused on predicting semantic relations between entities from text, evaluated for gender bias.&lt;SEP&gt;Neural Relation Extraction (NRE) is an NLP task and model category focused on predicting semantic relationships between entities in text.&lt;SEP&gt;Neural Relation Extraction (NRE) is an application of neural network architectures to relation extraction, contributing to automated knowledge base construction.</data>
      <data key="d3">chunk-ef7b95a2f35faad97942f87543b7ab1f&lt;SEP&gt;chunk-0bac16ae7b48f68b81dcf01699b27c93&lt;SEP&gt;chunk-1c233285dd27a358f6bf38c2050006d0&lt;SEP&gt;chunk-362346ad5b3a18dced3a68b0e282ea62&lt;SEP&gt;chunk-806c5b143029efcdf6de258a039af615</data>
    </node>
    <node id="Automated Knowledge Base Construction">
      <data key="d0">Automated Knowledge Base Construction</data>
      <data key="d1">category</data>
      <data key="d2">A domain in artificial intelligence dedicated to automatically extracting structured facts and knowledge from unstructured text.&lt;SEP&gt;Automated Knowledge Base Construction (AKBC) is the process and domain of automatically building or expanding structured knowledge repositories using extraction models.</data>
      <data key="d3">chunk-1c233285dd27a358f6bf38c2050006d0&lt;SEP&gt;chunk-0bac16ae7b48f68b81dcf01699b27c93</data>
    </node>
    <node id="WikiGenderBias">
      <data key="d0">WikiGenderBias</data>
      <data key="d1">category</data>
      <data key="d2">A benchmark dataset derived from Wikipedia used to train word embeddings and analyze gender bias in relation extraction models.&lt;SEP&gt;A distantly supervised benchmark dataset featuring a human-annotated test set, created to evaluate gender bias in neural relation extraction systems.&lt;SEP&gt;A large dataset designed for the evaluation and benchmarking of gender bias in relation extraction and other NLP tasks.&lt;SEP&gt;A specialized benchmark dataset created to assess and measure gender bias in neural relation extraction models.&lt;SEP&gt;WikiGenderBias is a dataset created from Wikipedia data to analyze gender bias and train and test neural relation extraction models.&lt;SEP&gt;WikiGenderBias is a distantly supervised dataset containing a human-annotated test set of approximately 45,000 sentences curated to train and evaluate relation extraction systems for gender bias.</data>
      <data key="d3">chunk-ef7b95a2f35faad97942f87543b7ab1f&lt;SEP&gt;chunk-0bac16ae7b48f68b81dcf01699b27c93&lt;SEP&gt;chunk-b31134945186e62e7effccb3ba89b180&lt;SEP&gt;chunk-1c233285dd27a358f6bf38c2050006d0&lt;SEP&gt;chunk-362346ad5b3a18dced3a68b0e282ea62&lt;SEP&gt;chunk-806c5b143029efcdf6de258a039af615</data>
    </node>
    <node id="Unigram Language Model">
      <data key="d0">Unigram Language Model</data>
      <data key="d1">category</data>
      <data key="d2">A class of statistical language models applied in morphological and subword segmentation comparison methods.&lt;SEP&gt;A statistical language modeling technique based on single-word probabilities, considered for future NLP modeling work.&lt;SEP&gt;A unigram language model is a zero-order memoryless Markov model assuming that sub-word units or morphs occur independently in a word.</data>
      <data key="d3">chunk-1c233285dd27a358f6bf38c2050006d0&lt;SEP&gt;chunk-43d472bd5e8478be39954bdc44e0469e&lt;SEP&gt;chunk-b20ba46b9900c93d13d7e98bc090ac13</data>
    </node>
    <node id="Character-Level Language Model">
      <data key="d0">Character-Level Language Model</data>
      <data key="d1">category</data>
      <data key="d2">A language modeling method that predicts sequences at the character level rather than word level.&lt;SEP&gt;A statistical model estimating probabilities of character sequences, used to initialize subword candidate probabilities.</data>
      <data key="d3">chunk-1c233285dd27a358f6bf38c2050006d0&lt;SEP&gt;chunk-787a9d7cce59743956093bca0779b549</data>
    </node>
    <node id="Back-Off N-Gram Models">
      <data key="d0">Back-Off N-Gram Models</data>
      <data key="d1">category</data>
      <data key="d2">Traditional statistical n-gram language models utilizing smoothing and back-off strategies, against which neural network models are compared.</data>
      <data key="d3">chunk-1c233285dd27a358f6bf38c2050006d0</data>
    </node>
    <node id="Social Bias">
      <data key="d0">Social Bias</data>
      <data key="d1">category</data>
      <data key="d2">Social bias encompasses unfairness, disparities, and societal prejudices manifested within natural language processing and machine learning models.&lt;SEP&gt;Systematic prejudice or disparity reflected in automated natural language processing and artificial intelligence systems.</data>
      <data key="d3">chunk-1c233285dd27a358f6bf38c2050006d0&lt;SEP&gt;chunk-0bac16ae7b48f68b81dcf01699b27c93</data>
    </node>
    <node id="Distant Supervision">
      <data key="d0">Distant Supervision</data>
      <data key="d1">category</data>
      <data key="d2">A semi-supervised machine learning paradigm used to automatically label training data using existing knowledge bases, utilized in creating WikiGenderBias.&lt;SEP&gt;A weakly supervised machine learning technique used to automatically generate labeled training data for relation extraction by aligning knowledge bases with text.&lt;SEP&gt;Distant Supervision is a machine learning paradigm used to automatically generate training data for relation extraction models by aligning text with knowledge bases.</data>
      <data key="d3">chunk-1c233285dd27a358f6bf38c2050006d0&lt;SEP&gt;chunk-0bac16ae7b48f68b81dcf01699b27c93&lt;SEP&gt;chunk-362346ad5b3a18dced3a68b0e282ea62</data>
    </node>
    <node id="Evaluation Stage">
      <data key="d0">Evaluation Stage</data>
      <data key="d1">event</data>
      <data key="d2">The formal competition and testing phase of the shared task where system runs were officially evaluated and ranked.</data>
      <data key="d3">chunk-1c233285dd27a358f6bf38c2050006d0</data>
    </node>
    <node id="Development Stage">
      <data key="d0">Development Stage</data>
      <data key="d1">event</data>
      <data key="d2">The experimental and trial phase where system parameters, tokenization settings, and n-gram models were optimized on trial data.</data>
      <data key="d3">chunk-1c233285dd27a358f6bf38c2050006d0</data>
    </node>
    <node id="#BreakUpIn5Words">
      <data key="d0">#BreakUpIn5Words</data>
      <data key="d1">event</data>
      <data key="d2">A specific viral Twitter hashtag event and dataset file on which the language modeling system achieved exceptionally high performance in Subtask A and B.</data>
      <data key="d3">chunk-1c233285dd27a358f6bf38c2050006d0</data>
    </node>
    <node id="Barack Obama">
      <data key="d0">Barack Obama</data>
      <data key="d1">person</data>
      <data key="d2">Barack Obama is an individual referenced as an example entity in a relation tuple (Barack Obama, spouse, Michelle Obama) illustrating relation extraction.</data>
      <data key="d3">chunk-0bac16ae7b48f68b81dcf01699b27c93</data>
    </node>
    <node id="Michelle Obama">
      <data key="d0">Michelle Obama</data>
      <data key="d1">person</data>
      <data key="d2">Michelle Obama is an individual referenced as an example entity in a relation tuple (Barack Obama, spouse, Michelle Obama) illustrating relation extraction.</data>
      <data key="d3">chunk-0bac16ae7b48f68b81dcf01699b27c93</data>
    </node>
    <node id="Relation Extraction">
      <data key="d0">Relation Extraction</data>
      <data key="d1">category</data>
      <data key="d2">A natural language processing subtask focused on identifying semantic relationships between entity pairs in text.&lt;SEP&gt;An information extraction subdiscipline concerned with detecting and classifying semantic relationships between entities in text.&lt;SEP&gt;Relation Extraction (RE) is a natural language processing task aimed at extracting semantic relations from unstructured text and representing them as succinct tuples to populate knowledge bases.</data>
      <data key="d3">chunk-0bac16ae7b48f68b81dcf01699b27c93&lt;SEP&gt;chunk-b31134945186e62e7effccb3ba89b180&lt;SEP&gt;chunk-362346ad5b3a18dced3a68b0e282ea62</data>
    </node>
    <node id="NYT Dataset">
      <data key="d0">NYT Dataset</data>
      <data key="d1">category</data>
      <data key="d2">The NYT dataset is an existing relation extraction benchmark derived from the New York Times that lacks reliable gender information for evaluating social bias.</data>
      <data key="d3">chunk-0bac16ae7b48f68b81dcf01699b27c93</data>
    </node>
    <node id="Counterfactual Data Augmentation">
      <data key="d0">Counterfactual Data Augmentation</data>
      <data key="d1">category</data>
      <data key="d2">Counterfactual Data Augmentation (CDA) is a bias mitigation method that swaps masculine and feminine words to equalize training contexts.&lt;SEP&gt;Counterfactual Data Augmentation is a training set debiasing method involving gender-swapping used to reduce gender bias in predictive models.</data>
      <data key="d3">chunk-ef7b95a2f35faad97942f87543b7ab1f&lt;SEP&gt;chunk-0bac16ae7b48f68b81dcf01699b27c93</data>
    </node>
    <node id="Hard Debiasing">
      <data key="d0">Hard Debiasing</data>
      <data key="d1">category</data>
      <data key="d2">A word embedding debiasing method that modifies vector representations to eliminate gender bias while preserving semantic meaning.&lt;SEP&gt;Hard Debiasing is a debiasing technique applied to word embeddings to mitigate gender bias in downstream predictions.</data>
      <data key="d3">chunk-0bac16ae7b48f68b81dcf01699b27c93&lt;SEP&gt;chunk-362346ad5b3a18dced3a68b0e282ea62</data>
    </node>
    <node id="Name Anonymization">
      <data key="d0">Name Anonymization</data>
      <data key="d1">category</data>
      <data key="d2">A bias mitigation technique where entity names are replaced or masked to prevent models from learning spurious demographic associations.&lt;SEP&gt;A debiasing approach aimed at removing entity names to reduce entity-specific bias in relation extraction models.&lt;SEP&gt;A debiasing technique that replaces entity names to evaluate and reduce entity-level gender bias in relation extraction models.&lt;SEP&gt;Name Anonymization (NA) is a bias mitigation technique that replaces named person entities with placeholders to prevent names from serving as gender proxies.&lt;SEP&gt;Name Anonymization is a data pre-processing and debiasing technique analyzed for its capacity to reduce bias in relation extraction models.</data>
      <data key="d3">chunk-ef7b95a2f35faad97942f87543b7ab1f&lt;SEP&gt;chunk-0bac16ae7b48f68b81dcf01699b27c93&lt;SEP&gt;chunk-b31134945186e62e7effccb3ba89b180&lt;SEP&gt;chunk-362346ad5b3a18dced3a68b0e282ea62&lt;SEP&gt;chunk-806c5b143029efcdf6de258a039af615</data>
    </node>
    <node id="Equality of Opportunity">
      <data key="d0">Equality of Opportunity</data>
      <data key="d1">category</data>
      <data key="d2">A fairness metric evaluated to determine whether relation extraction models perform equitably across male and female demographic data points.&lt;SEP&gt;Equality of Opportunity is a fairness metric used to evaluate neural relation extraction models across binary gender attributes.&lt;SEP&gt;Equality of Opportunity is a fairness metric used to evaluate predictors and allocative bias in machine learning models.</data>
      <data key="d3">chunk-ef7b95a2f35faad97942f87543b7ab1f&lt;SEP&gt;chunk-0bac16ae7b48f68b81dcf01699b27c93&lt;SEP&gt;chunk-806c5b143029efcdf6de258a039af615</data>
    </node>
    <node id="OpenNRE">
      <data key="d0">OpenNRE</data>
      <data key="d1">category</data>
      <data key="d2">An open-source neural relation extraction toolkit and framework whose models are trained and evaluated on WikiGenderBias.&lt;SEP&gt;An open-source neural relation extraction toolkit and model collection evaluated for Equality of Opportunity and gender bias across relation types.&lt;SEP&gt;An open-source toolkit and framework used for implementing, training, and benchmarking neural relation extraction models.&lt;SEP&gt;OpenNRE is an open-source neural relation extraction system and toolkit evaluated for gender bias and debiasing effects across various models.&lt;SEP&gt;OpenNRE is an open-source neural relation extraction toolkit and code repository providing various encoders and selectors for evaluating models.</data>
      <data key="d3">chunk-ef7b95a2f35faad97942f87543b7ab1f&lt;SEP&gt;chunk-0bac16ae7b48f68b81dcf01699b27c93&lt;SEP&gt;chunk-b31134945186e62e7effccb3ba89b180&lt;SEP&gt;chunk-362346ad5b3a18dced3a68b0e282ea62&lt;SEP&gt;chunk-806c5b143029efcdf6de258a039af615</data>
    </node>
    <node id="Knowledge Bases">
      <data key="d0">Knowledge Bases</data>
      <data key="d1">category</data>
      <data key="d2">Knowledge Bases (KBs) are structured repositories of knowledge built or extended using relation extraction models, which downstream NLP applications rely on.</data>
      <data key="d3">chunk-0bac16ae7b48f68b81dcf01699b27c93</data>
    </node>
    <node id="Task-Based Dialogue Systems">
      <data key="d0">Task-Based Dialogue Systems</data>
      <data key="d1">category</data>
      <data key="d2">Task-Based Dialogue Systems are downstream natural language processing applications that rely on structured knowledge bases to execute user tasks.</data>
      <data key="d3">chunk-0bac16ae7b48f68b81dcf01699b27c93</data>
    </node>
    <node id="Allocative Bias">
      <data key="d0">Allocative Bias</data>
      <data key="d1">category</data>
      <data key="d2">Allocative bias refers to unfairness in the distribution of resources, opportunities, or information, such as disparate representation of gender in knowledge bases.</data>
      <data key="d3">chunk-0bac16ae7b48f68b81dcf01699b27c93</data>
    </node>
    <node id="F1 Score">
      <data key="d0">F1 Score</data>
      <data key="d1">category</data>
      <data key="d2">A statistical metric used to measure model performance and quantify the performance gap between male and female datapoints.&lt;SEP&gt;A statistical metric used to quantify the accuracy and performance of the LID model across held-out evaluation samples.&lt;SEP&gt;F1 score is an evaluation metric category measuring the harmonic mean of precision and recall, used to evaluate the AE task.&lt;SEP&gt;The F1 score is a performance metric measuring the harmonic mean of precision and recall, used to evaluate relation extraction models and compute gender performance differences.</data>
      <data key="d3">chunk-0bac16ae7b48f68b81dcf01699b27c93&lt;SEP&gt;chunk-6152391765893a69aa07b46696567745&lt;SEP&gt;chunk-67aef3e225567bceaa8ddbf5e9866527&lt;SEP&gt;chunk-806c5b143029efcdf6de258a039af615</data>
    </node>
    <node id="DBPedia">
      <data key="d0">DBPedia</data>
      <data key="d1">organization</data>
      <data key="d2">A structured knowledge base project that extracts data from Wikipedia, used to retrieve relation sets for the WikiGenderBias dataset.</data>
      <data key="d3">chunk-362346ad5b3a18dced3a68b0e282ea62</data>
    </node>
    <node id="AMT">
      <data key="d0">AMT</data>
      <data key="d1">organization</data>
      <data key="d2">Amazon Mechanical Turk, a crowdsourcing platform used to recruit human workers for annotating ground truth labels for the relation extraction test set.</data>
      <data key="d3">chunk-362346ad5b3a18dced3a68b0e282ea62</data>
    </node>
    <node id="Barack">
      <data key="d0">Barack</data>
      <data key="d1">person</data>
      <data key="d2">A prominent individual referenced as an example entity in Wikipedia articles to illustrate the distant supervision relation extraction process.</data>
      <data key="d3">chunk-362346ad5b3a18dced3a68b0e282ea62</data>
    </node>
    <node id="Michelle">
      <data key="d0">Michelle</data>
      <data key="d1">person</data>
      <data key="d2">An individual referenced as an example entity linked to Barack through the spouse relation in relation extraction examples.</data>
      <data key="d3">chunk-362346ad5b3a18dced3a68b0e282ea62</data>
    </node>
    <node id="England">
      <data key="d0">England</data>
      <data key="d1">geo</data>
      <data key="d2">A geographic location whose residents were eligible to participate as AMT annotators for ground truth labeling.&lt;SEP&gt;England is one of the countries from which crowd workers were recruited to perform annotation tasks.</data>
      <data key="d3">chunk-ef7b95a2f35faad97942f87543b7ab1f&lt;SEP&gt;chunk-362346ad5b3a18dced3a68b0e282ea62</data>
    </node>
    <node id="Gender-Swapping">
      <data key="d0">Gender-Swapping</data>
      <data key="d1">category</data>
      <data key="d2">A bias mitigation and counterfactual data augmentation technique that removes contextual gender bias and bolsters relation extraction performance.&lt;SEP&gt;A data-level debiasing and augmentation technique that swaps gendered terms and pronouns to achieve gender parity in training datasets.</data>
      <data key="d3">chunk-362346ad5b3a18dced3a68b0e282ea62&lt;SEP&gt;chunk-806c5b143029efcdf6de258a039af615</data>
    </node>
    <node id="Spouse Relation">
      <data key="d0">Spouse Relation</data>
      <data key="d1">category</data>
      <data key="d2">A semantic relation evaluated in neural relation extraction that frequently exhibits high gender bias and performance disparities.&lt;SEP&gt;A semantic relation in WikiGenderBias connecting married entities, hypothesized to be vulnerable to model gender bias due to lexical patterns in female Wikipedia articles.</data>
      <data key="d3">chunk-362346ad5b3a18dced3a68b0e282ea62&lt;SEP&gt;chunk-806c5b143029efcdf6de258a039af615</data>
    </node>
    <node id="Hypernym Relation">
      <data key="d0">Hypernym Relation</data>
      <data key="d1">category</data>
      <data key="d2">A semantic relation in relation extraction that exhibited low initial gender bias but an increased performance gap under name anonymization.&lt;SEP&gt;A semantic relation representing categorical type or occupation, hypothesized to correlate with male entities in Wikipedia articles.</data>
      <data key="d3">chunk-362346ad5b3a18dced3a68b0e282ea62&lt;SEP&gt;chunk-806c5b143029efcdf6de258a039af615</data>
    </node>
    <node id="BirthDate Relation">
      <data key="d0">BirthDate Relation</data>
      <data key="d1">category</data>
      <data key="d2">A biographical relation used as an experimental control in WikiGenderBias, expected to show no correlation with entity gender.&lt;SEP&gt;A semantic relation evaluated in relation extraction that showed low Equality of Opportunity satisfaction across multiple architectures.</data>
      <data key="d3">chunk-362346ad5b3a18dced3a68b0e282ea62&lt;SEP&gt;chunk-806c5b143029efcdf6de258a039af615</data>
    </node>
    <node id="BirthPlace Relation">
      <data key="d0">BirthPlace Relation</data>
      <data key="d1">category</data>
      <data key="d2">A geographic biographical relation used as an experimental control in WikiGenderBias, expected to be unaffected by gender bias.&lt;SEP&gt;A semantic relation evaluated in neural relation extraction that exhibited substantial gender bias comparable to the spouse relation.</data>
      <data key="d3">chunk-362346ad5b3a18dced3a68b0e282ea62&lt;SEP&gt;chunk-806c5b143029efcdf6de258a039af615</data>
    </node>
    <node id="Hard-Debiasing">
      <data key="d0">Hard-Debiasing</data>
      <data key="d1">category</data>
      <data key="d2">Hard-Debiasing is a bias mitigation technique applied to word embeddings to remove gender components from gender-neutral word vectors.</data>
      <data key="d3">chunk-ef7b95a2f35faad97942f87543b7ab1f</data>
    </node>
    <node id="PCNN">
      <data key="d0">PCNN</data>
      <data key="d1">category</data>
      <data key="d2">Piecewise Convolutional Neural Network (PCNN) is a neural encoder that applies piecewise max-pooling based on head and tail entity positions.&lt;SEP&gt;Piecewise Convolutional Neural Network architecture evaluated in neural relation extraction alongside average and attention selectors.</data>
      <data key="d3">chunk-ef7b95a2f35faad97942f87543b7ab1f&lt;SEP&gt;chunk-806c5b143029efcdf6de258a039af615</data>
    </node>
    <node id="RNN">
      <data key="d0">RNN</data>
      <data key="d1">category</data>
      <data key="d2">A class of neural network architectures typically trained to recognize temporal patterns across sequential data.&lt;SEP&gt;Recurrent Neural Network (RNN) is a neural network architecture used as an encoder for sequential data in OpenNRE.&lt;SEP&gt;Recurrent Neural Network architecture whose combination with attention exhibited high bias on the spouse relation.&lt;SEP&gt;Recurrent Neural Network, a category of neural model architecture evaluated with an attention mechanism for intent argument inference.</data>
      <data key="d3">chunk-ef7b95a2f35faad97942f87543b7ab1f&lt;SEP&gt;chunk-3d0d62f131549ff6e8a1545f667c733a&lt;SEP&gt;chunk-806c5b143029efcdf6de258a039af615&lt;SEP&gt;chunk-6b6907deaed642269724a32b0c9ccd9f</data>
    </node>
    <node id="Bi-RNN">
      <data key="d0">Bi-RNN</data>
      <data key="d1">category</data>
      <data key="d2">Bidirectional Recurrent Neural Network (Bi-RNN) is a sequence encoder in OpenNRE that processes text sequences in both directions.&lt;SEP&gt;Bidirectional Recurrent Neural Network architecture evaluated for gender bias and Equality of Opportunity in relation extraction.</data>
      <data key="d3">chunk-ef7b95a2f35faad97942f87543b7ab1f&lt;SEP&gt;chunk-806c5b143029efcdf6de258a039af615</data>
    </node>
    <node id="Wikipedia Infoboxes">
      <data key="d0">Wikipedia Infoboxes</data>
      <data key="d1">category</data>
      <data key="d2">Wikipedia Infoboxes are structured data boxes on Wikipedia articles that were analyzed for gender-based discrepancies in spouse information.</data>
      <data key="d3">chunk-ef7b95a2f35faad97942f87543b7ab1f</data>
    </node>
    <node id="Hard-Debiased Word Embeddings">
      <data key="d0">Hard-Debiased Word Embeddings</data>
      <data key="d1">category</data>
      <data key="d2">A bias mitigation technique utilizing debiased word embeddings to reduce performance disparities across gender categories.</data>
      <data key="d3">chunk-806c5b143029efcdf6de258a039af615</data>
    </node>
    <node id="CDA">
      <data key="d0">CDA</data>
      <data key="d1">category</data>
      <data key="d2">Counterfactual Data Augmentation, a debiasing technique applied to training text to reduce gender bias in embedding and relation extraction models.</data>
      <data key="d3">chunk-806c5b143029efcdf6de258a039af615</data>
    </node>
    <node id="Average Selector">
      <data key="d0">Average Selector</data>
      <data key="d1">category</data>
      <data key="d2">A sentence selector baseline in neural relation extraction that weights training sentences equally and demonstrated superior bias mitigation over attention selectors.</data>
      <data key="d3">chunk-806c5b143029efcdf6de258a039af615</data>
    </node>
    <node id="Attention Selector">
      <data key="d0">Attention Selector</data>
      <data key="d1">category</data>
      <data key="d2">A sentence selection mechanism in neural relation extraction models that weights sentences according to learned attention scores.</data>
      <data key="d3">chunk-806c5b143029efcdf6de258a039af615</data>
    </node>
    <node id="EiTAKA">
      <data key="d0">EiTAKA</data>
      <data key="d1">organization</data>
      <data key="d2">A research team or system participating in the SemEval-2018 Task 1 competition focused on emotion analysis of tweets.</data>
      <data key="d3">chunk-b31134945186e62e7effccb3ba89b180</data>
    </node>
    <node id="SiTAKA">
      <data key="d0">SiTAKA</data>
      <data key="d1">organization</data>
      <data key="d2">A research team or system that participated in the Twitter Sentiment Analysis Track in SemEval 2017.</data>
      <data key="d3">chunk-b31134945186e62e7effccb3ba89b180</data>
    </node>
    <node id="SemEval-2018 Task 1">
      <data key="d0">SemEval-2018 Task 1</data>
      <data key="d1">event</data>
      <data key="d2">An academic evaluation competition focusing on affect and emotion analysis in tweets.</data>
      <data key="d3">chunk-b31134945186e62e7effccb3ba89b180</data>
    </node>
    <node id="SemEval 2017">
      <data key="d0">SemEval 2017</data>
      <data key="d1">event</data>
      <data key="d2">An international workshop on semantic evaluation featuring a Twitter Sentiment Analysis Track.&lt;SEP&gt;SemEval 2017 is an international workshop and evaluation campaign on semantic analysis, featuring competitive NLP benchmarks including the Twitter Sentiment Analysis Track.</data>
      <data key="d3">chunk-289c3be854417f1af5a604180e6310cc&lt;SEP&gt;chunk-b31134945186e62e7effccb3ba89b180</data>
    </node>
    <node id="Gender Swapping">
      <data key="d0">Gender Swapping</data>
      <data key="d1">category</data>
      <data key="d2">A data pre-processing and debiasing technique that swaps gender indicators to mitigate context and gender bias in models.</data>
      <data key="d3">chunk-b31134945186e62e7effccb3ba89b180</data>
    </node>
    <node id="Debiased Embeddings">
      <data key="d0">Debiased Embeddings</data>
      <data key="d1">category</data>
      <data key="d2">A bias mitigation method that modifies word representation vectors to reduce gender-based stereotyping and performance gaps.</data>
      <data key="d3">chunk-b31134945186e62e7effccb3ba89b180</data>
    </node>
    <node id="XGBoost Regressors">
      <data key="d0">XGBoost Regressors</data>
      <data key="d1">category</data>
      <data key="d2">An ensemble gradient boosting algorithm applied to valence intensity regression and emotion classification.</data>
      <data key="d3">chunk-b31134945186e62e7effccb3ba89b180</data>
    </node>
    <node id="N-Stream ConvNets">
      <data key="d0">N-Stream ConvNets</data>
      <data key="d1">category</data>
      <data key="d2">A deep learning convolutional neural network architecture utilized for tweet affect and emotion analysis.</data>
      <data key="d3">chunk-b31134945186e62e7effccb3ba89b180</data>
    </node>
    <node id="Equality Of Opportunity">
      <data key="d0">Equality Of Opportunity</data>
      <data key="d1">category</data>
      <data key="d2">A fairness metric measuring whether predictors achieve equal prediction recall across demographic groups, such as male and female entities.</data>
      <data key="d3">chunk-b31134945186e62e7effccb3ba89b180</data>
    </node>
    <node id="Twitter Sentiment Analysis Track">
      <data key="d0">Twitter Sentiment Analysis Track</data>
      <data key="d1">event</data>
      <data key="d2">The Twitter Sentiment Analysis Track is an evaluation track within SemEval 2017 focused on classifying the sentiment and polarity of tweets across multiple languages.</data>
      <data key="d3">chunk-289c3be854417f1af5a604180e6310cc</data>
    </node>
    <node id="Message Polarity Classification">
      <data key="d0">Message Polarity Classification</data>
      <data key="d1">category</data>
      <data key="d2">Message Polarity Classification is Subtask A of the Twitter Sentiment Analysis Track at SemEval 2017, assessing systems on their ability to determine whether a tweet is positive, negative, or neutral.</data>
      <data key="d3">chunk-289c3be854417f1af5a604180e6310cc</data>
    </node>
    <node id="King Saud University">
      <data key="d0">King Saud University</data>
      <data key="d1">organization</data>
      <data key="d2">King Saud University is a higher education and research institution whose Arabic corpus (Ksucorpus) was used to train Arabic word embedding models.</data>
      <data key="d3">chunk-289c3be854417f1af5a604180e6310cc</data>
    </node>
    <node id="Bing Liu">
      <data key="d0">Bing Liu</data>
      <data key="d1">person</data>
      <data key="d2">Bing Liu is a computer science researcher whose opinion lexicons were utilized and translated into Arabic for sentiment analysis evaluation.</data>
      <data key="d3">chunk-289c3be854417f1af5a604180e6310cc</data>
    </node>
    <node id="Bag Of Words">
      <data key="d0">Bag Of Words</data>
      <data key="d1">category</data>
      <data key="d2">Bag of Words is an n-gram text feature extraction category representing sequences of tokens to provide contextual information for classification.</data>
      <data key="d3">chunk-289c3be854417f1af5a604180e6310cc</data>
    </node>
    <node id="Bag Of Negated Words">
      <data key="d0">Bag Of Negated Words</data>
      <data key="d1">category</data>
      <data key="d2">Bag of Negated Words is a specialized feature representation category capturing sequences of tokens within negated contexts in text.</data>
      <data key="d3">chunk-289c3be854417f1af5a604180e6310cc</data>
    </node>
    <node id="Part Of Speech Tagging">
      <data key="d0">Part Of Speech Tagging</data>
      <data key="d1">category</data>
      <data key="d2">Part of speech tagging is a grammatical text annotation category used to distinguish subjective, non-neutral terms from objective content.</data>
      <data key="d3">chunk-289c3be854417f1af5a604180e6310cc</data>
    </node>
    <node id="SiTAKA Team">
      <data key="d0">SiTAKA Team</data>
      <data key="d1">organization</data>
      <data key="d2">The SiTAKA research team developed the SiTAKA system and participated in the SemEval 2017 Twitter Sentiment Analysis Track, ranking 8th in English and 2nd in Arabic.</data>
      <data key="d3">chunk-289c3be854417f1af5a604180e6310cc</data>
    </node>
    <node id="Stanford University">
      <data key="d0">Stanford University</data>
      <data key="d1">organization</data>
      <data key="d2">Stanford University is a research institution whose NLP group developed the Stanford Tagger used for tokenization and POS tagging of Arabic tweets.</data>
      <data key="d3">chunk-289c3be854417f1af5a604180e6310cc</data>
    </node>
    <node id="Arabic Wikipedia">
      <data key="d0">Arabic Wikipedia</data>
      <data key="d1">organization</data>
      <data key="d2">Arabic Wikipedia is an open-collaborative Arabic-language encyclopedia project whose corpus was used to train Arabic word embeddings.</data>
      <data key="d3">chunk-289c3be854417f1af5a604180e6310cc</data>
    </node>
    <node id="Support Vector Machines">
      <data key="d0">Support Vector Machines</data>
      <data key="d1">category</data>
      <data key="d2">A class of supervised machine learning algorithms that served as the primary foundation for constructing the study's sentiment classification models.&lt;SEP&gt;A traditional machine learning classification algorithm historically applied to sentiment analysis tasks.&lt;SEP&gt;Support Vector Machines (SVM) is a machine learning classifier widely reported and utilized for sentiment analysis classification problems.&lt;SEP&gt;Support Vector Machines (SVM) is a supervised machine learning classification algorithm widely used for large-scale text and sentiment categorization.</data>
      <data key="d3">chunk-1ca9fdc4a98dc4d2c8f6875739e4d466&lt;SEP&gt;chunk-02b1ce0e6302d1e78683fc67d2a9ca7b&lt;SEP&gt;chunk-0b5684eaac7a3f52271bc1ff14d5ff1f&lt;SEP&gt;chunk-3194fa4581f2aaec823530e030775b2e</data>
    </node>
    <node id="Opinion Lexicons">
      <data key="d0">Opinion Lexicons</data>
      <data key="d1">category</data>
      <data key="d2">Opinion lexicons are vocabulary resources containing polarity information used to compute sentiment scores and feature representations.</data>
      <data key="d3">chunk-0b5684eaac7a3f52271bc1ff14d5ff1f</data>
    </node>
    <node id="En-SiTAKA">
      <data key="d0">En-SiTAKA</data>
      <data key="d1">category</data>
      <data key="d2">En-SiTAKA is a sentiment analysis system designed to classify English-language tweets using semantic clusters, embeddings, and lexicons.</data>
      <data key="d3">chunk-0b5684eaac7a3f52271bc1ff14d5ff1f</data>
    </node>
    <node id="Ar-SiTAKA">
      <data key="d0">Ar-SiTAKA</data>
      <data key="d1">category</data>
      <data key="d2">Ar-SiTAKA is a sentiment analysis system designed to evaluate and classify Arabic-language tweets.</data>
      <data key="d3">chunk-0b5684eaac7a3f52271bc1ff14d5ff1f</data>
    </node>
    <node id="Part of Speech">
      <data key="d0">Part of Speech</data>
      <data key="d1">category</data>
      <data key="d2">Part of Speech (POS) refers to syntactic word classes—such as nouns, adjectives, adverbs, and verbs—whose frequencies and distributions are used as features to differentiate subjective from objective texts.</data>
      <data key="d3">chunk-0b5684eaac7a3f52271bc1ff14d5ff1f</data>
    </node>
    <node id="Bi-tagged Features">
      <data key="d0">Bi-tagged Features</data>
      <data key="d1">category</data>
      <data key="d2">Bi-tagged features are syntactic representation features that combine bigram word tokens with their corresponding part-of-speech tags to capture expressive and subjective phrases.</data>
      <data key="d3">chunk-0b5684eaac7a3f52271bc1ff14d5ff1f</data>
    </node>
    <node id="Ark Tweet NLP">
      <data key="d0">Ark Tweet NLP</data>
      <data key="d1">category</data>
      <data key="d2">Ark Tweet NLP is a natural language processing toolkit for Twitter that provides pretrained resources, including 1,000 Brown clusters generated from 56 million English-language tweets.</data>
      <data key="d3">chunk-0b5684eaac7a3f52271bc1ff14d5ff1f</data>
    </node>
    <node id="Brown Clustering Algorithm">
      <data key="d0">Brown Clustering Algorithm</data>
      <data key="d1">category</data>
      <data key="d2">The Brown clustering algorithm is a hierarchical clustering algorithm used to group words based on syntactic and semantic context from large text corpora.</data>
      <data key="d3">chunk-0b5684eaac7a3f52271bc1ff14d5ff1f</data>
    </node>
    <node id="K-means Algorithm">
      <data key="d0">K-means Algorithm</data>
      <data key="d1">category</data>
      <data key="d2">The K-means algorithm is an unsupervised clustering method applied to group 40-dimensional word embeddings into 4,960 semantic clusters.</data>
      <data key="d3">chunk-0b5684eaac7a3f52271bc1ff14d5ff1f</data>
    </node>
    <node id="Pooling Functions">
      <data key="d0">Pooling Functions</data>
      <data key="d1">category</data>
      <data key="d2">Pooling functions are element-wise mathematical operations (sum, standard-deviation, minimum, and maximum) used to convert variable-length word embedding vectors into a fixed-length tweet vector representation.</data>
      <data key="d3">chunk-0b5684eaac7a3f52271bc1ff14d5ff1f</data>
    </node>
    <node id="URV">
      <data key="d0">URV</data>
      <data key="d1">organization</data>
      <data key="d2">URV (Universitat Rovira i Virgili) is an academic research institution that provided research support funds for the sentiment analysis project.</data>
      <data key="d3">chunk-e060c5bbcfa40d71aa9fb0a2e63bff30</data>
    </node>
    <node id="Martí i Franqués">
      <data key="d0">Martí i Franqués</data>
      <data key="d1">person</data>
      <data key="d2">Martí i Franqués is a historical figure whose namesake PhD grant provided partial funding for the research work.</data>
      <data key="d3">chunk-e060c5bbcfa40d71aa9fb0a2e63bff30</data>
    </node>
    <node id="Subword Segmentation">
      <data key="d0">Subword Segmentation</data>
      <data key="d1">category</data>
      <data key="d2">A natural language processing technique for breaking words down into smaller subword units or morphemes.&lt;SEP&gt;Subword Segmentation is an NLP data preprocessing technique that splits words into subword units to handle vocabulary size, out-of-vocabulary words, and morphological complexity.</data>
      <data key="d3">chunk-43d472bd5e8478be39954bdc44e0469e&lt;SEP&gt;chunk-e060c5bbcfa40d71aa9fb0a2e63bff30</data>
    </node>
    <node id="Finnish">
      <data key="d0">Finnish</data>
      <data key="d1">category</data>
      <data key="d2">A natural language used to evaluate subword seed lexicons, pre-pruning, and morphological segmentation accuracy.&lt;SEP&gt;Finnish is a Finno-Ugric language category used in the morphological segmentation experiments and error analysis.&lt;SEP&gt;Finnish is a language used in existing evaluation benchmarks paired with English in prior BLI studies.&lt;SEP&gt;Finnish is a morphologically rich language used in data sets to evaluate subword and morphological segmentation methods.</data>
      <data key="d3">chunk-9896f0582e2237c4a0dd8169f6817110&lt;SEP&gt;chunk-25f6efeef473f49482457fa3064ed4dd&lt;SEP&gt;chunk-43d472bd5e8478be39954bdc44e0469e&lt;SEP&gt;chunk-e060c5bbcfa40d71aa9fb0a2e63bff30</data>
    </node>
    <node id="North Sami">
      <data key="d0">North Sami</data>
      <data key="d1">category</data>
      <data key="d2">North Sami is a language whose dataset was utilized in evaluating the unigram subword segmentation models.</data>
      <data key="d3">chunk-e060c5bbcfa40d71aa9fb0a2e63bff30</data>
    </node>
    <node id="Morfessor Baseline">
      <data key="d0">Morfessor Baseline</data>
      <data key="d1">category</data>
      <data key="d2">A baseline morphological segmentation algorithm initialized with whole words that uses greedy local search and recursive binary splitting.&lt;SEP&gt;A baseline statistical morphological segmentation framework for which the EM+Prune algorithm is introduced.&lt;SEP&gt;Morfessor Baseline is a probabilistic generative morphological segmentation model whose recursive training algorithm and optimization problems are analyzed and improved in the study.&lt;SEP&gt;Morfessor Baseline is an unsupervised generative method within the Morfessor family that uses MAP estimation and greedy local search for morphological segmentation.</data>
      <data key="d3">chunk-43d472bd5e8478be39954bdc44e0469e&lt;SEP&gt;chunk-787a9d7cce59743956093bca0779b549&lt;SEP&gt;chunk-b20ba46b9900c93d13d7e98bc090ac13&lt;SEP&gt;chunk-e060c5bbcfa40d71aa9fb0a2e63bff30</data>
    </node>
    <node id="Morfessor EM+Prune">
      <data key="d0">Morfessor EM+Prune</data>
      <data key="d1">category</data>
      <data key="d2">A proposed training algorithm for Morfessor Baseline designed to reduce search error during training and lower Morfessor model costs.&lt;SEP&gt;A subword segmentation method combining the unigram language model and priors of Morfessor Baseline with an EM+Prune training algorithm.&lt;SEP&gt;Morfessor EM+Prune is a morphological segmentation and subword tokenization framework combining Expectation-Maximization (EM) training with lexicon pruning strategies.&lt;SEP&gt;Morfessor EM+Prune is a novel unigram subword segmentation algorithm that integrates Expectation Maximization and lexicon pruning to reduce search error and improve segmentation accuracy.&lt;SEP&gt;Morfessor EM+Prune is a proposed morphological segmentation method combining Expectation Maximization with iterative lexicon pruning.</data>
      <data key="d3">chunk-43d472bd5e8478be39954bdc44e0469e&lt;SEP&gt;chunk-b20ba46b9900c93d13d7e98bc090ac13&lt;SEP&gt;chunk-e060c5bbcfa40d71aa9fb0a2e63bff30&lt;SEP&gt;chunk-787a9d7cce59743956093bca0779b549&lt;SEP&gt;chunk-b076d49bd537ec691f3ab083fc7fd528</data>
    </node>
    <node id="SentencePiece">
      <data key="d0">SentencePiece</data>
      <data key="d1">category</data>
      <data key="d2">A subword segmentation method and tool designed for multilingual NLP systems and neural machine translation, using an EM+Prune training algorithm.&lt;SEP&gt;A subword tokenisation tool and variant category of BPE used to address rare words in neural machine translation systems.&lt;SEP&gt;A subword tokenization library and technique mentioned regarding token count choices across source and target data.&lt;SEP&gt;SentencePiece is a subword tokenization algorithm that can be recovered as a special case of Morfessor EM+Prune by omitting the prior and applying specific configuration settings.&lt;SEP&gt;SentencePiece is a subword tokenization and segmentation approach that can be derived from Morfessor EM+Prune using specific hyper-parameters.&lt;SEP&gt;SentencePiece is a widely adopted unigram subword segmentation method and software implementation evaluated and compared against Morfessor EM+Prune.</data>
      <data key="d3">chunk-b20ba46b9900c93d13d7e98bc090ac13&lt;SEP&gt;chunk-e060c5bbcfa40d71aa9fb0a2e63bff30&lt;SEP&gt;chunk-f50b15c876beec2eae8bf6437e8409aa&lt;SEP&gt;chunk-787a9d7cce59743956093bca0779b549&lt;SEP&gt;chunk-b076d49bd537ec691f3ab083fc7fd528&lt;SEP&gt;chunk-5f2d07efa6f5f4a54b6cbbdd93f071bc</data>
    </node>
    <node id="Greedy Unigram Likelihood">
      <data key="d0">Greedy Unigram Likelihood</data>
      <data key="d1">category</data>
      <data key="d2">A subword segmentation and pruning strategy based on unigram probability models, designed for speech recognition.&lt;SEP&gt;Greedy Unigram Likelihood is an existing subword segmentation method operating in a generative unigram language modeling framework.</data>
      <data key="d3">chunk-787a9d7cce59743956093bca0779b549&lt;SEP&gt;chunk-e060c5bbcfa40d71aa9fb0a2e63bff30</data>
    </node>
    <node id="Expectation Maximization">
      <data key="d0">Expectation Maximization</data>
      <data key="d1">category</data>
      <data key="d2">Expectation Maximization (EM) is an iterative statistical optimization algorithm utilized in the training phase of the proposed Morfessor EM+Prune method.&lt;SEP&gt;The Expectation Maximization (EM) algorithm is an iterative technique for finding Maximum Likelihood or Maximum a Posteriori estimates in models with latent variables.</data>
      <data key="d3">chunk-b20ba46b9900c93d13d7e98bc090ac13&lt;SEP&gt;chunk-e060c5bbcfa40d71aa9fb0a2e63bff30</data>
    </node>
    <node id="Decision Tree">
      <data key="d0">Decision Tree</data>
      <data key="d1">category</data>
      <data key="d2">A Decision Tree is a supervised classification model exemplified in the study's experimental illustrations.&lt;SEP&gt;A supervised learning algorithm evaluated among candidate classifiers for Twitter speech act classification.</data>
      <data key="d3">chunk-1e9f52662c01528fd8d607b1462c48df&lt;SEP&gt;chunk-e060c5bbcfa40d71aa9fb0a2e63bff30</data>
    </node>
    <node id="Hammarström">
      <data key="d0">Hammarström</data>
      <data key="d1">person</data>
      <data key="d2">Hammarström is an NLP researcher who authored a notable 2011 survey on unsupervised morphological segmentation methods.</data>
      <data key="d3">chunk-e060c5bbcfa40d71aa9fb0a2e63bff30</data>
    </node>
    <node id="Ruokolainen">
      <data key="d0">Ruokolainen</data>
      <data key="d1">person</data>
      <data key="d2">Ruokolainen is a researcher whose comparative evaluation and morphological error analysis framework is utilized in the study.&lt;SEP&gt;Ruokolainen is an NLP researcher who authored a 2016 comparative survey on semi-supervised morphological segmentation.</data>
      <data key="d3">chunk-25f6efeef473f49482457fa3064ed4dd&lt;SEP&gt;chunk-e060c5bbcfa40d71aa9fb0a2e63bff30</data>
    </node>
    <node id="Sennrich">
      <data key="d0">Sennrich</data>
      <data key="d1">person</data>
      <data key="d2">A researcher referenced for describing the Byte Pair Encoding (BPE) algorithm in neural machine translation.&lt;SEP&gt;A researcher who first adapted Byte Pair Encoding (BPE) from data compression to neural machine translation to learn subword units.&lt;SEP&gt;Sennrich is a computational linguistics researcher who first adapted the Byte Pair Encoding segmentation algorithm for neural machine translation in 2015.&lt;SEP&gt;Sennrich is a researcher cited for work on Byte Pair Encoding merge operations and joint bilingual vocabulary learning in neural machine translation.</data>
      <data key="d3">chunk-ba3fa25c5e29c7ea3201eac4d5fbec61&lt;SEP&gt;chunk-ffaa7abbd8709e94a9523e6b922ac96b&lt;SEP&gt;chunk-acd45458d7c3c63e9891f23252405a17&lt;SEP&gt;chunk-e060c5bbcfa40d71aa9fb0a2e63bff30</data>
    </node>
    <node id="EI-reg Task">
      <data key="d0">EI-reg Task</data>
      <data key="d1">event</data>
      <data key="d2">EI-reg is an Emotion Intensity regression benchmark task evaluated in the research experiments.</data>
      <data key="d3">chunk-e060c5bbcfa40d71aa9fb0a2e63bff30</data>
    </node>
    <node id="V-reg Task">
      <data key="d0">V-reg Task</data>
      <data key="d1">event</data>
      <data key="d2">V-reg is a Valence regression evaluation task benchmarked in the experimental analysis.</data>
      <data key="d3">chunk-e060c5bbcfa40d71aa9fb0a2e63bff30</data>
    </node>
    <node id="EI-oc Task">
      <data key="d0">EI-oc Task</data>
      <data key="d1">event</data>
      <data key="d2">EI-oc is an Emotion Intensity ordinal classification evaluation task assessed in the experimental results.</data>
      <data key="d3">chunk-e060c5bbcfa40d71aa9fb0a2e63bff30</data>
    </node>
    <node id="V-oc Task">
      <data key="d0">V-oc Task</data>
      <data key="d1">event</data>
      <data key="d2">V-oc is a Valence ordinal classification evaluation task evaluated in the sentiment analysis study.</data>
      <data key="d3">chunk-e060c5bbcfa40d71aa9fb0a2e63bff30</data>
    </node>
    <node id="Spitkovsky">
      <data key="d0">Spitkovsky</data>
      <data key="d1">person</data>
      <data key="d2">Spitkovsky is a researcher who introduced lateen-EM, an alternating optimization method combining Expectation Maximization and Viterbi optimization.</data>
      <data key="d3">chunk-b20ba46b9900c93d13d7e98bc090ac13</data>
    </node>
    <node id="Virpioja">
      <data key="d0">Virpioja</data>
      <data key="d1">person</data>
      <data key="d2">Virpioja is a researcher who analyzed the challenges of applying Expectation Maximization to generative morphology learning.</data>
      <data key="d3">chunk-b20ba46b9900c93d13d7e98bc090ac13</data>
    </node>
    <node id="Viterbi Algorithm">
      <data key="d0">Viterbi Algorithm</data>
      <data key="d1">category</data>
      <data key="d2">The Viterbi algorithm is an optimization algorithm related to hidden Markov models, utilized in hard-EM approaches.</data>
      <data key="d3">chunk-b20ba46b9900c93d13d7e98bc090ac13</data>
    </node>
    <node id="Minimum Description Length">
      <data key="d0">Minimum Description Length</data>
      <data key="d1">category</data>
      <data key="d2">The Minimum Description Length (MDL) principle is an information-theoretic framework used to design priors favoring concise lexicons.</data>
      <data key="d3">chunk-b20ba46b9900c93d13d7e98bc090ac13</data>
    </node>
    <node id="Probabilistic Generative Methods">
      <data key="d0">Probabilistic Generative Methods</data>
      <data key="d1">category</data>
      <data key="d2">Probabilistic generative methods model the joint probability of generating a sequence of morphs in morphological segmentation.</data>
      <data key="d3">chunk-b20ba46b9900c93d13d7e98bc090ac13</data>
    </node>
    <node id="Discriminative Methods">
      <data key="d0">Discriminative Methods</data>
      <data key="d1">category</data>
      <data key="d2">Discriminative methods model the conditional probability of segmentation boundaries given unsegmented text, contrasted with generative methods.</data>
      <data key="d3">chunk-b20ba46b9900c93d13d7e98bc090ac13</data>
    </node>
    <node id="Markov Model">
      <data key="d0">Markov Model</data>
      <data key="d1">category</data>
      <data key="d2">A Markov model is a stochastic model that models sequences; unigram models are treated as zero-order memoryless Markov models.</data>
      <data key="d3">chunk-b20ba46b9900c93d13d7e98bc090ac13</data>
    </node>
    <node id="Forward-Backward Algorithm">
      <data key="d0">Forward-Backward Algorithm</data>
      <data key="d1">category</data>
      <data key="d2">The forward-backward algorithm is the application of the Expectation Maximization algorithm to hidden Markov models.</data>
      <data key="d3">chunk-b20ba46b9900c93d13d7e98bc090ac13</data>
    </node>
    <node id="Lateen-EM">
      <data key="d0">Lateen-EM</data>
      <data key="d1">category</data>
      <data key="d2">An iteration structure variant for Expectation-Maximization training tested within the Morfessor EM+Prune framework.&lt;SEP&gt;Lateen-EM is a hybrid optimization variant that alternates between standard Expectation Maximization and Viterbi optimization.</data>
      <data key="d3">chunk-b076d49bd537ec691f3ab083fc7fd528&lt;SEP&gt;chunk-b20ba46b9900c93d13d7e98bc090ac13</data>
    </node>
    <node id="Greedy Local Search">
      <data key="d0">Greedy Local Search</data>
      <data key="d1">category</data>
      <data key="d2">An optimization algorithm that makes locally optimal choices at each stage, used in Morfessor Baseline to iteratively refine corpus segmentations.&lt;SEP&gt;Greedy local search is a search heuristic used in Morfessor Baseline that explores neighboring parameter configurations to minimize cost.</data>
      <data key="d3">chunk-787a9d7cce59743956093bca0779b549&lt;SEP&gt;chunk-b20ba46b9900c93d13d7e98bc090ac13</data>
    </node>
    <node id="Maximum a Posteriori">
      <data key="d0">Maximum a Posteriori</data>
      <data key="d1">category</data>
      <data key="d2">Maximum a Posteriori (MAP) estimation is a Bayesian parameter estimation technique incorporating a prior distribution.</data>
      <data key="d3">chunk-b20ba46b9900c93d13d7e98bc090ac13</data>
    </node>
    <node id="Maximum Likelihood">
      <data key="d0">Maximum Likelihood</data>
      <data key="d1">category</data>
      <data key="d2">Maximum Likelihood (ML) estimation is a statistical method for estimating model parameters by maximizing the likelihood function.</data>
      <data key="d3">chunk-b20ba46b9900c93d13d7e98bc090ac13</data>
    </node>
    <node id="Varjokallio">
      <data key="d0">Varjokallio</data>
      <data key="d1">person</data>
      <data key="d2">A researcher who developed a subword segmentation method based on greedy unigram likelihood pruning for speech recognition applications.</data>
      <data key="d3">chunk-787a9d7cce59743956093bca0779b549</data>
    </node>
    <node id="ASR">
      <data key="d0">ASR</data>
      <data key="d1">category</data>
      <data key="d2">Automatic Speech Recognition, an NLP and speech technology domain for which subword segmentation algorithms are applied.</data>
      <data key="d3">chunk-787a9d7cce59743956093bca0779b549</data>
    </node>
    <node id="NMT">
      <data key="d0">NMT</data>
      <data key="d1">category</data>
      <data key="d2">Neural Machine Translation, a field of natural language processing that heavily relies on subword tokenization methods like SentencePiece.</data>
      <data key="d3">chunk-787a9d7cce59743956093bca0779b549</data>
    </node>
    <node id="NLP">
      <data key="d0">NLP</data>
      <data key="d1">category</data>
      <data key="d2">Natural Language Processing, the broader domain of computing systems dealing with human language processing and subword segmentation.</data>
      <data key="d3">chunk-787a9d7cce59743956093bca0779b549</data>
    </node>
    <node id="Recursive Binary Splitting">
      <data key="d0">Recursive Binary Splitting</data>
      <data key="d1">category</data>
      <data key="d2">A segmentation technique used during resegmentation in Morfessor Baseline to divide words into constituent units.</data>
      <data key="d3">chunk-787a9d7cce59743956093bca0779b549</data>
    </node>
    <node id="Expectation-Maximization">
      <data key="d0">Expectation-Maximization</data>
      <data key="d1">category</data>
      <data key="d2">An iterative optimization algorithm (EM) used for parameter estimation and probability refinement in subword segmentation models.</data>
      <data key="d3">chunk-787a9d7cce59743956093bca0779b549</data>
    </node>
    <node id="Hard-EM">
      <data key="d0">Hard-EM</data>
      <data key="d1">category</data>
      <data key="d2">A deterministic variation of the Expectation-Maximization algorithm used for parameter estimation and frequency-based subword pruning.</data>
      <data key="d3">chunk-787a9d7cce59743956093bca0779b549</data>
    </node>
    <node id="Bayesian EM">
      <data key="d0">Bayesian EM</data>
      <data key="d1">category</data>
      <data key="d2">A probabilistic optimization algorithm variant used in Morfessor modeling to control lexicon compactness and prior costs.&lt;SEP&gt;A variant of the Expectation-Maximization training algorithm used in the configuration required to recover SentencePiece.&lt;SEP&gt;An adaptation of the Expectation-Maximization algorithm incorporating Bayesian priors such as the implicit Dirichlet Process prior.</data>
      <data key="d3">chunk-b076d49bd537ec691f3ab083fc7fd528&lt;SEP&gt;chunk-787a9d7cce59743956093bca0779b549&lt;SEP&gt;chunk-43d472bd5e8478be39954bdc44e0469e</data>
    </node>
    <node id="Dirichlet Process Prior">
      <data key="d0">Dirichlet Process Prior</data>
      <data key="d1">category</data>
      <data key="d2">A nonparametric Bayesian prior implemented in Bayesian EM to modify count normalization in the M-step.</data>
      <data key="d3">chunk-787a9d7cce59743956093bca0779b549</data>
    </node>
    <node id="Viterbi Segmentation">
      <data key="d0">Viterbi Segmentation</data>
      <data key="d1">category</data>
      <data key="d2">A dynamic programming segmentation method used to determine optimal token sequences and compute Viterbi counts for pruning.</data>
      <data key="d3">chunk-787a9d7cce59743956093bca0779b549</data>
    </node>
    <node id="Subword Regularization">
      <data key="d0">Subword Regularization</data>
      <data key="d1">category</data>
      <data key="d2">Subword Regularization is a denoising-based regularization technique for neural NLP systems that samples alternative subword segmentations.</data>
      <data key="d3">chunk-b076d49bd537ec691f3ab083fc7fd528</data>
    </node>
    <node id="EM+Viterbi-Prune">
      <data key="d0">EM+Viterbi-Prune</data>
      <data key="d1">category</data>
      <data key="d2">EM+Viterbi-prune is a training algorithm variant combining EM training with pruning decisions derived from a single Viterbi iteration.</data>
      <data key="d3">chunk-b076d49bd537ec691f3ab083fc7fd528</data>
    </node>
    <node id="Minimum Description Length Pruning">
      <data key="d0">Minimum Description Length Pruning</data>
      <data key="d1">category</data>
      <data key="d2">Minimum Description Length (MDL) pruning is a pruning criterion in Morfessor EM+Prune where subwords are removed based on estimated cost trade-offs between lexicon size and data likelihood.</data>
      <data key="d3">chunk-b076d49bd537ec691f3ab083fc7fd528</data>
    </node>
    <node id="Morpho Challenge 2010">
      <data key="d0">Morpho Challenge 2010</data>
      <data key="d1">event</data>
      <data key="d2">Morpho Challenge 2010 is a computational linguistics evaluation campaign and challenge providing benchmark datasets for morphological segmentation across languages such as English, Finnish, and Turkish.&lt;SEP&gt;Morpho Challenge 2010 is a natural language processing shared task competition providing benchmark datasets for English, Finnish, and Turkish morphological segmentation.</data>
      <data key="d3">chunk-b076d49bd537ec691f3ab083fc7fd528&lt;SEP&gt;chunk-25f6efeef473f49482457fa3064ed4dd</data>
    </node>
    <node id="Seed Lexicon">
      <data key="d0">Seed Lexicon</data>
      <data key="d1">category</data>
      <data key="d2">The initial vocabulary of up to one million frequent substrings used by Morfessor EM+Prune, curated via pre-pruning of redundant subwords and forced splitting.</data>
      <data key="d3">chunk-b076d49bd537ec691f3ab083fc7fd528</data>
    </node>
    <node id="Pre-Pruning">
      <data key="d0">Pre-Pruning</data>
      <data key="d1">category</data>
      <data key="d2">A filtering process in Morfessor EM+Prune that removes unproductive and redundant substrings based on occurrence counts before training.</data>
      <data key="d3">chunk-b076d49bd537ec691f3ab083fc7fd528</data>
    </node>
    <node id="Forced Splitting">
      <data key="d0">Forced Splitting</data>
      <data key="d1">category</data>
      <data key="d2">A mechanism in Morfessor EM+Prune to ensure segment boundaries before or after designated characters such as hyphens, apostrophes, and colons.</data>
      <data key="d3">chunk-b076d49bd537ec691f3ab083fc7fd528</data>
    </node>
    <node id="Forward-Filtering Backward-Sampling Algorithm">
      <data key="d0">Forward-Filtering Backward-Sampling Algorithm</data>
      <data key="d1">category</data>
      <data key="d2">An algorithmic method used to sample alternative segmentations from the full data distribution for subword regularization.</data>
      <data key="d3">chunk-b076d49bd537ec691f3ab083fc7fd528</data>
    </node>
    <node id="Viterbi Training">
      <data key="d0">Viterbi Training</data>
      <data key="d1">category</data>
      <data key="d2">A training and counting process whose single-iteration counts are used in the EM+Viterbi-prune variant to make aggressive pruning decisions.</data>
      <data key="d3">chunk-b076d49bd537ec691f3ab083fc7fd528</data>
    </node>
    <node id="Sametinget">
      <data key="d0">Sametinget</data>
      <data key="d1">organization</data>
      <data key="d2">Sametinget (the Sámi Parliament) is the public body and organization associated with the creation of the Den samiske tekstbanken corpus used for North Sámi data.</data>
      <data key="d3">chunk-25f6efeef473f49482457fa3064ed4dd</data>
    </node>
    <node id="Prefix">
      <data key="d0">Prefix</data>
      <data key="d1">category</data>
      <data key="d2">Prefix is a grammatical morph category denoting an affix placed before a word stem, utilized in morphological error analysis.</data>
      <data key="d3">chunk-25f6efeef473f49482457fa3064ed4dd</data>
    </node>
    <node id="Stem">
      <data key="d0">Stem</data>
      <data key="d1">category</data>
      <data key="d2">Stem is a central morph category denoting the core part of a word to which affixes are attached.</data>
      <data key="d3">chunk-25f6efeef473f49482457fa3064ed4dd</data>
    </node>
    <node id="Suffix">
      <data key="d0">Suffix</data>
      <data key="d1">category</data>
      <data key="d2">Suffix is a grammatical morph category denoting an affix placed after a word stem, analyzed in morphological segmentation.</data>
      <data key="d3">chunk-25f6efeef473f49482457fa3064ed4dd</data>
    </node>
    <node id="Over-segmentation">
      <data key="d0">Over-segmentation</data>
      <data key="d1">category</data>
      <data key="d2">Over-segmentation is an error category in morphological segmentation where an incorrect boundary is introduced within a morph segment.</data>
      <data key="d3">chunk-25f6efeef473f49482457fa3064ed4dd</data>
    </node>
    <node id="Under-segmentation">
      <data key="d0">Under-segmentation</data>
      <data key="d1">category</data>
      <data key="d2">Under-segmentation is an error category in morphological segmentation where an actual morph boundary is omitted.</data>
      <data key="d3">chunk-25f6efeef473f49482457fa3064ed4dd</data>
    </node>
    <node id="North Sámi">
      <data key="d0">North Sámi</data>
      <data key="d1">category</data>
      <data key="d2">An indigenous language included in the error analysis and boundary precision-recall evaluation for morphological segmentation.&lt;SEP&gt;North Sámi is an indigenous Uralic language category analyzed using text from Den samiske tekstbanken.</data>
      <data key="d3">chunk-25f6efeef473f49482457fa3064ed4dd&lt;SEP&gt;chunk-43d472bd5e8478be39954bdc44e0469e</data>
    </node>
    <node id="Boundary Precision">
      <data key="d0">Boundary Precision</data>
      <data key="d1">category</data>
      <data key="d2">Boundary Precision is an evaluation metric category measuring the percentage of correctly assigned morph boundaries out of all predicted boundaries.</data>
      <data key="d3">chunk-25f6efeef473f49482457fa3064ed4dd</data>
    </node>
    <node id="Boundary Recall">
      <data key="d0">Boundary Recall</data>
      <data key="d1">category</data>
      <data key="d2">Boundary Recall is an evaluation metric category measuring the proportion of true annotated morph boundaries identified by the model.</data>
      <data key="d3">chunk-25f6efeef473f49482457fa3064ed4dd</data>
    </node>
    <node id="Boundary F1-Score">
      <data key="d0">Boundary F1-Score</data>
      <data key="d1">category</data>
      <data key="d2">Boundary F1-Score is an evaluation metric category representing the harmonic mean of boundary precision and boundary recall.</data>
      <data key="d3">chunk-25f6efeef473f49482457fa3064ed4dd</data>
    </node>
    <node id="European Research Council">
      <data key="d0">European Research Council</data>
      <data key="d1">organization</data>
      <data key="d2">A public funding body established by the European Union that funded the FoTran research project.&lt;SEP&gt;The European Research Council (ERC) is a funding body that supported the research through project grant ERC StG BroadSem 678254.</data>
      <data key="d3">chunk-a70218d643d3a2f540abe4bb2afd6986&lt;SEP&gt;chunk-43d472bd5e8478be39954bdc44e0469e</data>
    </node>
    <node id="MeMAD Project">
      <data key="d0">MeMAD Project</data>
      <data key="d1">organization</data>
      <data key="d2">A research and innovation project supported by the European Union's Horizon 2020 programme.</data>
      <data key="d3">chunk-43d472bd5e8478be39954bdc44e0469e</data>
    </node>
    <node id="FoTran Project">
      <data key="d0">FoTran Project</data>
      <data key="d1">organization</data>
      <data key="d2">A research project supported by the European Research Council under the European Union's Horizon 2020 programme.</data>
      <data key="d3">chunk-43d472bd5e8478be39954bdc44e0469e</data>
    </node>
    <node id="Aalto University School of Science">
      <data key="d0">Aalto University School of Science</data>
      <data key="d1">organization</data>
      <data key="d2">An academic institution whose Science-IT project provided computational resources for the morphological segmentation study.</data>
      <data key="d3">chunk-43d472bd5e8478be39954bdc44e0469e</data>
    </node>
    <node id="Horizon 2020">
      <data key="d0">Horizon 2020</data>
      <data key="d1">category</data>
      <data key="d2">A major European Union research and innovation funding programme that funded projects such as MeMAD and FoTran.&lt;SEP&gt;Horizon 2020 is a European Union research and innovation programme that provided funding under grant agreement no. 645452 (QT21).</data>
      <data key="d3">chunk-3d0343896fcb9bca626f6a9369daf5a8&lt;SEP&gt;chunk-43d472bd5e8478be39954bdc44e0469e</data>
    </node>
    <node id="Georeferenced Corpora">
      <data key="d0">Georeferenced Corpora</data>
      <data key="d1">category</data>
      <data key="d2">Large text datasets paired with geographic coordinate metadata, derived from web-crawled and social media sources to study demographics and language distributions.</data>
      <data key="d3">chunk-43d472bd5e8478be39954bdc44e0469e</data>
    </node>
    <node id="Social Media Corpora">
      <data key="d0">Social Media Corpora</data>
      <data key="d1">category</data>
      <data key="d2">Datasets harvested from social media platforms, evaluated for representing real-world population demographics and language inventories.</data>
      <data key="d3">chunk-43d472bd5e8478be39954bdc44e0469e</data>
    </node>
    <node id="Web-Crawled Corpora">
      <data key="d0">Web-Crawled Corpora</data>
      <data key="d1">category</data>
      <data key="d2">Datasets compiled via automated web crawling, evaluated against census benchmarks for demographic representativeness.</data>
      <data key="d3">chunk-43d472bd5e8478be39954bdc44e0469e</data>
    </node>
    <node id="Science-IT">
      <data key="d0">Science-IT</data>
      <data key="d1">organization</data>
      <data key="d2">A high-performance computing project and infrastructure at Aalto University School of Science providing computational resources for research.</data>
      <data key="d3">chunk-43d472bd5e8478be39954bdc44e0469e</data>
    </node>
    <node id="United Nations">
      <data key="d0">United Nations</data>
      <data key="d1">organization</data>
      <data key="d2">The United Nations (UN) is an international organization providing country-level population estimates and census aggregations used as ground-truth baselines.&lt;SEP&gt;The United Nations is an international organization whose datasets serve as a ground-truth benchmark and whose official legislative texts are used for training language identification models.</data>
      <data key="d3">chunk-a06cb5cf31459df4733b688cf007ff6d&lt;SEP&gt;chunk-6b470fa40233ba7e36a9f7c70bafce9c</data>
    </node>
    <node id="World Factbook">
      <data key="d0">World Factbook</data>
      <data key="d1">organization</data>
      <data key="d2">The World Factbook is an informational resource providing baseline estimations of language use in countries where UN census data is unavailable.</data>
      <data key="d3">chunk-a06cb5cf31459df4733b688cf007ff6d</data>
    </node>
    <node id="Human Geography">
      <data key="d0">Human Geography</data>
      <data key="d1">category</data>
      <data key="d2">Human geography is an academic field concerned with understanding the relationships between people, places, and spatial behavior using geographic data.</data>
      <data key="d3">chunk-a06cb5cf31459df4733b688cf007ff6d</data>
    </node>
    <node id="Unstructured Geographic Information">
      <data key="d0">Unstructured Geographic Information</data>
      <data key="d1">category</data>
      <data key="d2">Unstructured geographic information refers to non-standard spatial data, such as social media posts and web pages, used for geographic analysis.</data>
      <data key="d3">chunk-a06cb5cf31459df4733b688cf007ff6d</data>
    </node>
    <node id="Language Identification Model">
      <data key="d0">Language Identification Model</data>
      <data key="d1">category</data>
      <data key="d2">A computational methodology and tool used to classify texts by language codes across both Twitter and web-crawled corpora.</data>
      <data key="d3">chunk-a06cb5cf31459df4733b688cf007ff6d</data>
    </node>
    <node id="Population Demographics">
      <data key="d0">Population Demographics</data>
      <data key="d1">category</data>
      <data key="d2">Demographic attributes of human populations, such as language variety and regional density, measured using traditional censuses or corpus proxies.</data>
      <data key="d3">chunk-a06cb5cf31459df4733b688cf007ff6d</data>
    </node>
    <node id="Per Capita GDP">
      <data key="d0">Per Capita GDP</data>
      <data key="d1">category</data>
      <data key="d2">An economic metric used alongside internet-usage statistics to adjust raw population figures for unequal access to digital technologies.</data>
      <data key="d3">chunk-a06cb5cf31459df4733b688cf007ff6d</data>
    </node>
    <node id="Country-Code Top-Level Domains">
      <data key="d0">Country-Code Top-Level Domains</data>
      <data key="d1">category</data>
      <data key="d2">Internet domain extensions used as a regionalization heuristic to geolocate web-crawled texts to specific countries.</data>
      <data key="d3">chunk-a06cb5cf31459df4733b688cf007ff6d</data>
    </node>
    <node id="Big Data">
      <data key="d0">Big Data</data>
      <data key="d1">category</data>
      <data key="d2">Large-scale digital datasets, including social media feeds and web crawls, studied for representativeness compared to real-world populations.</data>
      <data key="d3">chunk-a06cb5cf31459df4733b688cf007ff6d</data>
    </node>
    <node id="Estonia">
      <data key="d0">Estonia</data>
      <data key="d1">geo</data>
      <data key="d2">Estonia is a country highlighted as an example of a nation that extensively uses its country code top-level domain, potentially over-representing it in web-crawled corpora.&lt;SEP&gt;Estonia is a country identified as over-represented in web-crawled language data relative to its population.</data>
      <data key="d3">chunk-6b470fa40233ba7e36a9f7c70bafce9c&lt;SEP&gt;chunk-1d721fe5dad0029252753a2c12969e26</data>
    </node>
    <node id="European Parliament">
      <data key="d0">European Parliament</data>
      <data key="d1">organization</data>
      <data key="d2">The European Parliament is a legislative body whose official proceedings and texts are used as part of the training dataset for the language identification model.</data>
      <data key="d3">chunk-6b470fa40233ba7e36a9f7c70bafce9c</data>
    </node>
    <node id="IARPA">
      <data key="d0">IARPA</data>
      <data key="d1">organization</data>
      <data key="d2">IARPA (Intelligence Advanced Research Projects Activity) is a research agency whose Babel project language packs are used as language-focused corpora for language identification training.</data>
      <data key="d3">chunk-6b470fa40233ba7e36a9f7c70bafce9c</data>
    </node>
    <node id="Language Identification">
      <data key="d0">Language Identification</data>
      <data key="d1">category</data>
      <data key="d2">Language identification is a natural language processing task and classification technique aimed at detecting languages from small samples such as web pages and social media posts.</data>
      <data key="d3">chunk-6b470fa40233ba7e36a9f7c70bafce9c</data>
    </node>
    <node id="GlobalVoices">
      <data key="d0">GlobalVoices</data>
      <data key="d1">organization</data>
      <data key="d2">GlobalVoices is an international citizen media community whose multilingual news and commentary texts serve as training data for the language identification model.</data>
      <data key="d3">chunk-6b470fa40233ba7e36a9f7c70bafce9c</data>
    </node>
    <node id="Ubuntu">
      <data key="d0">Ubuntu</data>
      <data key="d1">organization</data>
      <data key="d2">Ubuntu is an open-source software operating system project whose documentation was utilized as a formal text dataset for training the language identification system.</data>
      <data key="d3">chunk-6b470fa40233ba7e36a9f7c70bafce9c</data>
    </node>
    <node id="GNOME">
      <data key="d0">GNOME</data>
      <data key="d1">organization</data>
      <data key="d2">GNOME is an open-source desktop environment project whose software documentation is incorporated into the language identification training corpus.</data>
      <data key="d3">chunk-6b470fa40233ba7e36a9f7c70bafce9c</data>
    </node>
    <node id="Tatoeba">
      <data key="d0">Tatoeba</data>
      <data key="d1">organization</data>
      <data key="d2">Tatoeba is a collaborative online database of language-learning sentences utilized as an informal text domain for language identification.</data>
      <data key="d3">chunk-6b470fa40233ba7e36a9f7c70bafce9c</data>
    </node>
    <node id="LTI">
      <data key="d0">LTI</data>
      <data key="d1">organization</data>
      <data key="d2">Language Technologies Institute (LTI) is an academic research organization credited as a source of Bible texts for the language identification dataset.</data>
      <data key="d3">chunk-6b470fa40233ba7e36a9f7c70bafce9c</data>
    </node>
    <node id="Language Mapping">
      <data key="d0">Language Mapping</data>
      <data key="d1">category</data>
      <data key="d2">Language mapping is the research domain and objective focused on assessing and visualizing global linguistic distribution across populations and geographic areas.</data>
      <data key="d3">chunk-6b470fa40233ba7e36a9f7c70bafce9c</data>
    </node>
    <node id="Top-Level Domains">
      <data key="d0">Top-Level Domains</data>
      <data key="d1">category</data>
      <data key="d2">Top-level domains (TLDs) are internet domain suffixes used in the study to infer the country of origin of web pages, introducing geographic representation biases.</data>
      <data key="d3">chunk-6b470fa40233ba7e36a9f7c70bafce9c</data>
    </node>
    <node id="UN">
      <data key="d0">UN</data>
      <data key="d1">organization</data>
      <data key="d2">The United Nations is an international organization that provides official population estimates used to evaluate digital dataset representations.&lt;SEP&gt;The United Nations provides aggregated census data used as primary ground-truth benchmarks for country-level language demographics.</data>
      <data key="d3">chunk-6152391765893a69aa07b46696567745&lt;SEP&gt;chunk-1d721fe5dad0029252753a2c12969e26</data>
    </node>
    <node id="LID Model">
      <data key="d0">LID Model</data>
      <data key="d1">category</data>
      <data key="d2">A Language Identification (LID) model trained on samples of 50 characters to predict language labels across web-crawled and social media domains.</data>
      <data key="d3">chunk-6152391765893a69aa07b46696567745</data>
    </node>
    <node id="Web-Crawled Dataset">
      <data key="d0">Web-Crawled Dataset</data>
      <data key="d1">category</data>
      <data key="d2">A digital corpus derived from web scraping covering 166 countries, used to evaluate language representation and population density correlations.</data>
      <data key="d3">chunk-6152391765893a69aa07b46696567745</data>
    </node>
    <node id="Social Media Dataset">
      <data key="d0">Social Media Dataset</data>
      <data key="d1">category</data>
      <data key="d2">A digital corpus comprising social media posts (including Twitter) covering 169 countries, used to study linguistic and demographic distributions.</data>
      <data key="d3">chunk-6152391765893a69aa07b46696567745</data>
    </node>
    <node id="Minority Languages">
      <data key="d0">Minority Languages</data>
      <data key="d1">category</data>
      <data key="d2">Languages with lower representation forming a long-tail distribution in digital text corpora.</data>
      <data key="d3">chunk-6152391765893a69aa07b46696567745</data>
    </node>
    <node id="Non-Western Languages">
      <data key="d0">Non-Western Languages</data>
      <data key="d1">category</data>
      <data key="d2">Languages spoken outside the Western world that risk underrepresentation and geographic bias when uniform frequency thresholds are imposed on datasets.</data>
      <data key="d3">chunk-6152391765893a69aa07b46696567745</data>
    </node>
    <node id="Non-English-Speaking Countries">
      <data key="d0">Non-English-Speaking Countries</data>
      <data key="d1">geo</data>
      <data key="d2">Geographic locations not traditionally identified as English-speaking that nevertheless generate substantial amounts of English digital content.</data>
      <data key="d3">chunk-6152391765893a69aa07b46696567745</data>
    </node>
    <node id="GDP-Weighting">
      <data key="d0">GDP-Weighting</data>
      <data key="d1">category</data>
      <data key="d2">An adjustment methodology based on per capita gross domestic product used to account for economic differences in digital text production across countries.</data>
      <data key="d3">chunk-6152391765893a69aa07b46696567745</data>
    </node>
    <node id="Internet-Usage-Weighting">
      <data key="d0">Internet-Usage-Weighting</data>
      <data key="d1">category</data>
      <data key="d2">A metric adjusting population estimates by internet access rates to better reflect national production of digital web content.</data>
      <data key="d3">chunk-6152391765893a69aa07b46696567745</data>
    </node>
    <node id="Pearson Correlation">
      <data key="d0">Pearson Correlation</data>
      <data key="d1">category</data>
      <data key="d2">A statistical measure used to calculate the strength of linear association between corpus sizes and adjusted population estimates.</data>
      <data key="d3">chunk-6152391765893a69aa07b46696567745</data>
    </node>
    <node id="Ground-Truth Population Numbers">
      <data key="d0">Ground-Truth Population Numbers</data>
      <data key="d1">category</data>
      <data key="d2">Demographic population benchmarks, derived from UN estimates, against which digital text distributions are evaluated.</data>
      <data key="d3">chunk-6152391765893a69aa07b46696567745</data>
    </node>
    <node id="Western Europe">
      <data key="d0">Western Europe</data>
      <data key="d1">geo</data>
      <data key="d2">Western Europe is a region identified as being over-represented in Twitter language data relative to population size.</data>
      <data key="d3">chunk-1d721fe5dad0029252753a2c12969e26</data>
    </node>
    <node id="Southeast Asia">
      <data key="d0">Southeast Asia</data>
      <data key="d1">geo</data>
      <data key="d2">Southeast Asia is a geographic region identified as being under-represented in web-crawled language corpora.</data>
      <data key="d3">chunk-1d721fe5dad0029252753a2c12969e26</data>
    </node>
    <node id="CIA">
      <data key="d0">CIA</data>
      <data key="d1">organization</data>
      <data key="d2">The Central Intelligence Agency produces the World Factbook, utilized as fallback ground-truth data for country-level demographics when UN data is unavailable.</data>
      <data key="d3">chunk-1d721fe5dad0029252753a2c12969e26</data>
    </node>
    <node id="Web-Crawled Data">
      <data key="d0">Web-Crawled Data</data>
      <data key="d1">category</data>
      <data key="d2">A large digital text corpus derived from web scraping, evaluated for population weighting, regional bias, and language demographics.</data>
      <data key="d3">chunk-1d721fe5dad0029252753a2c12969e26</data>
    </node>
    <node id="Twitter Data">
      <data key="d0">Twitter Data</data>
      <data key="d1">category</data>
      <data key="d2">A corpus of digital text gathered from Twitter used to measure geographic representation and language distribution across countries.</data>
      <data key="d3">chunk-1d721fe5dad0029252753a2c12969e26</data>
    </node>
    <node id="UN Aggregated Census Data">
      <data key="d0">UN Aggregated Census Data</data>
      <data key="d1">category</data>
      <data key="d2">Official United Nations census datasets used as the primary ground-truth benchmark for national language demographics and population figures.</data>
      <data key="d3">chunk-1d721fe5dad0029252753a2c12969e26</data>
    </node>
    <node id="CIA World Factbook">
      <data key="d0">CIA World Factbook</data>
      <data key="d1">category</data>
      <data key="d2">A demographic and geographic reference dataset compiled by the CIA, used as secondary ground-truth data when UN language records are missing.</data>
      <data key="d3">chunk-1d721fe5dad0029252753a2c12969e26</data>
    </node>
    <node id="Hindi Language">
      <data key="d0">Hindi Language</data>
      <data key="d1">category</data>
      <data key="d2">A major language spoken in India, used as an illustrative threshold benchmark for corpus language presence.</data>
      <data key="d3">chunk-1d721fe5dad0029252753a2c12969e26</data>
    </node>
    <node id="Internet Access">
      <data key="d0">Internet Access</data>
      <data key="d1">category</data>
      <data key="d2">A demographic metric measuring population access to the internet, providing correlation and weighting for digital text generation.</data>
      <data key="d3">chunk-1d721fe5dad0029252753a2c12969e26</data>
    </node>
    <node id="Gross Domestic Product">
      <data key="d0">Gross Domestic Product</data>
      <data key="d1">category</data>
      <data key="d2">An economic measure (GDP) analyzed to determine whether economic factors improve the population weighting of digital text corpora.&lt;SEP&gt;Gross Domestic Product (GDP) is an economic metric used to weight population data, demonstrating that Twitter data aligns more closely with wealthier populations.</data>
      <data key="d3">chunk-d7d53ab63937232bbcc4be9c7080dd31&lt;SEP&gt;chunk-1d721fe5dad0029252753a2c12969e26</data>
    </node>
    <node id="North America">
      <data key="d0">North America</data>
      <data key="d1">geo</data>
      <data key="d2">North America is a continent noted for having better linguistic representation within Twitter data than general web-crawled data.</data>
      <data key="d3">chunk-d7d53ab63937232bbcc4be9c7080dd31</data>
    </node>
    <node id="Oceania">
      <data key="d0">Oceania</data>
      <data key="d1">geo</data>
      <data key="d2">Oceania is a geographic region that demonstrates superior language representation on Twitter relative to web corpora.</data>
      <data key="d3">chunk-d7d53ab63937232bbcc4be9c7080dd31</data>
    </node>
    <node id="Eastern Europe">
      <data key="d0">Eastern Europe</data>
      <data key="d1">geo</data>
      <data key="d2">Eastern Europe is a geographic region accounting for a disproportionately large share of the web-crawled corpus despite its smaller global population share.</data>
      <data key="d3">chunk-d7d53ab63937232bbcc4be9c7080dd31</data>
    </node>
    <node id="South Africa">
      <data key="d0">South Africa</data>
      <data key="d1">geo</data>
      <data key="d2">A country in Africa whose official languages, including low-resourced indigenous languages, are the focus of the machine translation study.&lt;SEP&gt;A country on the African continent with 11 official languages, serving as the focus for neural machine translation experiments.&lt;SEP&gt;South Africa is a country in Southern Africa with 11 official languages discussed in the context of machine translation research.&lt;SEP&gt;South Africa is a country where Twitter data indicates over-predicted language diversity.&lt;SEP&gt;South Africa is a country whose governmental data, constitution, and indigenous languages are the subject of machine translation research.</data>
      <data key="d3">chunk-ddef736560bcb899db81b75205f4df60&lt;SEP&gt;chunk-d7d53ab63937232bbcc4be9c7080dd31&lt;SEP&gt;chunk-927600095f9514bfcdfdefa43cf8a474&lt;SEP&gt;chunk-f50b15c876beec2eae8bf6437e8409aa&lt;SEP&gt;chunk-fe3fb6b107774e12d36226865853669d</data>
    </node>
    <node id="Ground-Truth Data">
      <data key="d0">Ground-Truth Data</data>
      <data key="d1">category</data>
      <data key="d2">Ground-Truth Data refers to census-based reference data on language use and population demographics used to evaluate digital text collections.</data>
      <data key="d3">chunk-d7d53ab63937232bbcc4be9c7080dd31</data>
    </node>
    <node id="Web-Crawled Corpus">
      <data key="d0">Web-Crawled Corpus</data>
      <data key="d1">category</data>
      <data key="d2">The Web-Crawled Corpus is a global digital text dataset compiled from crawled websites to examine linguistic and population representation.</data>
      <data key="d3">chunk-d7d53ab63937232bbcc4be9c7080dd31</data>
    </node>
    <node id="Artificial Neural Networks">
      <data key="d0">Artificial Neural Networks</data>
      <data key="d1">category</data>
      <data key="d2">A computational modeling framework in machine learning used to answer complex questions by extracting and reasoning over facts retrieved from knowledge bases.&lt;SEP&gt;Artificial Neural Networks are computational models used in iterative multi-document neural attention frameworks for complex answer prediction and recommendation tasks.&lt;SEP&gt;Artificial Neural Networks is a category of machine learning architectures used to learn latent representations, model attention mechanisms, and solve complex QA and recommendation tasks.</data>
      <data key="d3">chunk-d7d53ab63937232bbcc4be9c7080dd31&lt;SEP&gt;chunk-c53d0ac7fa47d30ce6f399d3ef8b95e7&lt;SEP&gt;chunk-bdef2f67b0ab332d8da79c41fb0e58c7</data>
    </node>
    <node id="Census">
      <data key="d0">Census</data>
      <data key="d1">category</data>
      <data key="d2">Census refers to official demographic surveys conducted by governments that serve as the ground-truth baseline for language usage and population figures.</data>
      <data key="d3">chunk-d7d53ab63937232bbcc4be9c7080dd31</data>
    </node>
    <node id="Internet Usage Statistics">
      <data key="d0">Internet Usage Statistics</data>
      <data key="d1">category</data>
      <data key="d2">Internet Usage Statistics represent connectivity metrics used to weight population figures, which correlate less effectively with Twitter data than GDP weighting.</data>
      <data key="d3">chunk-d7d53ab63937232bbcc4be9c7080dd31</data>
    </node>
    <node id="Iterative Multi-Document Neural Attention">
      <data key="d0">Iterative Multi-Document Neural Attention</data>
      <data key="d1">category</data>
      <data key="d2">Iterative Multi-Document Neural Attention is an artificial neural network model designed to predict multiple answers to complex queries using retrieved knowledge.</data>
      <data key="d3">chunk-d7d53ab63937232bbcc4be9c7080dd31</data>
    </node>
    <node id="Top-N Recommendation">
      <data key="d0">Top-N Recommendation</data>
      <data key="d1">category</data>
      <data key="d2">A classical recommendation task where a system generates a personalized, ranked list of items according to inferred user preferences.&lt;SEP&gt;Top-N Recommendation is an algorithmic task aimed at ranking and presenting the top-n most relevant items or contents to a user based on preferences or dialogue context.&lt;SEP&gt;Top-N Recommendation is an information filtering and retrieval task used to evaluate the proposed neural attention model.&lt;SEP&gt;Top-n recommendation is a recommendation system task focused on generating a ranked list of the most relevant items for a target user.</data>
      <data key="d3">chunk-d7d53ab63937232bbcc4be9c7080dd31&lt;SEP&gt;chunk-c53d0ac7fa47d30ce6f399d3ef8b95e7&lt;SEP&gt;chunk-bdef2f67b0ab332d8da79c41fb0e58c7&lt;SEP&gt;chunk-2425a9bfa1c48f3e56350fa213bdbdab</data>
    </node>
    <node id="Intelligent Agents">
      <data key="d0">Intelligent Agents</data>
      <data key="d1">category</data>
      <data key="d2">Intelligent Agents are computational systems designed to resolve complex user information needs by answering context-aware and preference-based questions.</data>
      <data key="d3">chunk-d7d53ab63937232bbcc4be9c7080dd31</data>
    </node>
    <node id="Recommender Systems">
      <data key="d0">Recommender Systems</data>
      <data key="d1">category</data>
      <data key="d2">Recommender Systems is a domain of artificial intelligence focused on suggesting items or content aligned with user preferences.&lt;SEP&gt;Software systems that provide personalized suggestions and guide users to relevant items within a large space of options based on user preferences.</data>
      <data key="d3">chunk-c53d0ac7fa47d30ce6f399d3ef8b95e7&lt;SEP&gt;chunk-bdef2f67b0ab332d8da79c41fb0e58c7</data>
    </node>
    <node id="Conversational Recommender Systems">
      <data key="d0">Conversational Recommender Systems</data>
      <data key="d1">category</data>
      <data key="d2">An advanced category of recommendation systems that interact with users via natural language dialog to iteratively refine preferences and provide personalized recommendations.&lt;SEP&gt;Conversational Recommender Systems is an interactive category of recommendation systems that engages in dialogue with users to fulfill their dynamic information needs.</data>
      <data key="d3">chunk-c53d0ac7fa47d30ce6f399d3ef8b95e7&lt;SEP&gt;chunk-bdef2f67b0ab332d8da79c41fb0e58c7</data>
    </node>
    <node id="Reddit">
      <data key="d0">Reddit</data>
      <data key="d1">organization</data>
      <data key="d2">An online platform whose user dialog turns are utilized in the bAbI Movie Dialog dataset to benchmark conversational systems.&lt;SEP&gt;Reddit is a social news and discussion website featuring user-submitted content across diverse themed subreddits, utilized as the data source for the Fakeddit dataset.&lt;SEP&gt;Reddit is an online social media and community platform from which subreddits like r/Fakeddit and community comments are derived.&lt;SEP&gt;Reddit is an online social media and discussion platform from which submission titles, thumbnails, and subreddits were extracted to construct a dataset for fake news detection.</data>
      <data key="d3">chunk-6ea04b5a4cb9ba61c65c62ae52138068&lt;SEP&gt;chunk-c53d0ac7fa47d30ce6f399d3ef8b95e7&lt;SEP&gt;chunk-6187c8bb0f977bcb9db2949d166fa2cc&lt;SEP&gt;chunk-261a6f8ccfb17ebb9be72e74900d0a04</data>
    </node>
    <node id="Intelligent Agent">
      <data key="d0">Intelligent Agent</data>
      <data key="d1">category</data>
      <data key="d2">A computational entity capable of understanding user context, preferences, and questions formulated in natural language to retrieve or infer the most relevant answers.</data>
      <data key="d3">chunk-c53d0ac7fa47d30ce6f399d3ef8b95e7</data>
    </node>
    <node id="Factoid Question Answering">
      <data key="d0">Factoid Question Answering</data>
      <data key="d1">category</data>
      <data key="d2">A specialized question answering task focused on retrieving specific, concise facts from a knowledge base to answer user queries.</data>
      <data key="d3">chunk-c53d0ac7fa47d30ce6f399d3ef8b95e7</data>
    </node>
    <node id="Machine Reading and Comprehension">
      <data key="d0">Machine Reading and Comprehension</data>
      <data key="d1">category</data>
      <data key="d2">An artificial intelligence field focused on enabling computational models to read, process, and comprehend natural language text documents.</data>
      <data key="d3">chunk-c53d0ac7fa47d30ce6f399d3ef8b95e7</data>
    </node>
    <node id="Cloze-Style Task">
      <data key="d0">Cloze-Style Task</data>
      <data key="d1">category</data>
      <data key="d2">A fill-in-the-blank question answering task often used to test reading comprehension, where systems predict missing elements based on surrounding context.</data>
      <data key="d3">chunk-c53d0ac7fa47d30ce6f399d3ef8b95e7</data>
    </node>
    <node id="Bidirectional Recurrent Neural Network">
      <data key="d0">Bidirectional Recurrent Neural Network</data>
      <data key="d1">category</data>
      <data key="d2">A class of neural network architecture that encodes sequences in both forward and backward directions, used to generate contextual word representations for queries and documents.</data>
      <data key="d3">chunk-f874c842ec2c36b07a6dd2abcb11dba0</data>
    </node>
    <node id="Gated Recurrent Unit (GRU)">
      <data key="d0">Gated Recurrent Unit (GRU)</data>
      <data key="d1">category</data>
      <data key="d2">A type of recurrent neural network gating mechanism utilized in the bidirectional encoder and to maintain the state across inference steps.</data>
      <data key="d3">chunk-f874c842ec2c36b07a6dd2abcb11dba0</data>
    </node>
    <node id="Iterative Attention Mechanism">
      <data key="d0">Iterative Attention Mechanism</data>
      <data key="d1">category</data>
      <data key="d2">A neural network mechanism used in the inference phase to dynamically extract semantic relationships and compute relevance scores across query and document tokens.</data>
      <data key="d3">chunk-f874c842ec2c36b07a6dd2abcb11dba0</data>
    </node>
    <node id="Feed-Forward Neural Network">
      <data key="d0">Feed-Forward Neural Network</data>
      <data key="d1">category</data>
      <data key="d2">A standard neural network architecture employed as a two-layer gating function to update the inference state by filtering information.</data>
      <data key="d3">chunk-f874c842ec2c36b07a6dd2abcb11dba0</data>
    </node>
    <node id="Rectified Linear Unit (ReLU)">
      <data key="d0">Rectified Linear Unit (ReLU)</data>
      <data key="d1">category</data>
      <data key="d2">An activation function applied in the hidden layer of the feed-forward gating network.</data>
      <data key="d3">chunk-f874c842ec2c36b07a6dd2abcb11dba0</data>
    </node>
    <node id="Encoding Phase">
      <data key="d0">Encoding Phase</data>
      <data key="d1">category</data>
      <data key="d2">The initial stage in the methodology workflow that transforms query and document words into continuous dense representations and contextual embeddings.</data>
      <data key="d3">chunk-f874c842ec2c36b07a6dd2abcb11dba0</data>
    </node>
    <node id="Inference Phase">
      <data key="d0">Inference Phase</data>
      <data key="d1">category</data>
      <data key="d2">The intermediate stage in the workflow that constructs an inference chain and refines semantic relationships between query and documents through iterative attention mechanisms.</data>
      <data key="d3">chunk-f874c842ec2c36b07a6dd2abcb11dba0</data>
    </node>
    <node id="Prediction Phase">
      <data key="d0">Prediction Phase</data>
      <data key="d1">category</data>
      <data key="d2">The final workflow stage that computes a relevance score for candidate answers using the accumulated document attention weights from the inference process.</data>
      <data key="d3">chunk-f874c842ec2c36b07a6dd2abcb11dba0</data>
    </node>
    <node id="Sigmoid Activation Function">
      <data key="d0">Sigmoid Activation Function</data>
      <data key="d1">category</data>
      <data key="d2">A mathematical activation function used in the output layer of the two-layer feed-forward gating network to regulate information flow in the inference GRU.</data>
      <data key="d3">chunk-f874c842ec2c36b07a6dd2abcb11dba0</data>
    </node>
    <node id="Pointer-Sum Loss">
      <data key="d0">Pointer-Sum Loss</data>
      <data key="d1">category</data>
      <data key="d2">A candidate selection loss function referenced from prior literature, contrasted with the paper's attention-weighted relevance scoring approach.</data>
      <data key="d3">chunk-f874c842ec2c36b07a6dd2abcb11dba0</data>
    </node>
    <node id="Query Attentive Read">
      <data key="d0">Query Attentive Read</data>
      <data key="d1">category</data>
      <data key="d2">An attention mechanism applied during each inference step to compute query token relevance and produce a refined query glimpse.</data>
      <data key="d3">chunk-f874c842ec2c36b07a6dd2abcb11dba0</data>
    </node>
    <node id="Document Attentive Read">
      <data key="d0">Document Attentive Read</data>
      <data key="d1">category</data>
      <data key="d2">An attention mechanism applied during each inference step to score document tokens conditioned on the query glimpse and inference state.</data>
      <data key="d3">chunk-f874c842ec2c36b07a6dd2abcb11dba0</data>
    </node>
    <node id="Experimental Evaluation">
      <data key="d0">Experimental Evaluation</data>
      <data key="d1">event</data>
      <data key="d2">An empirical testing phase conducted to assess and compare the performance of the proposed neural network against baseline models on benchmark tasks.</data>
      <data key="d3">chunk-10ce525fd225c14101bb62983a2ac21a</data>
    </node>
    <node id="Multi-Label Classification">
      <data key="d0">Multi-Label Classification</data>
      <data key="d1">category</data>
      <data key="d2">A category of machine learning classification problem where multiple candidate answers or labels are treated as independent and not mutually exclusive.</data>
      <data key="d3">chunk-10ce525fd225c14101bb62983a2ac21a</data>
    </node>
    <node id="Question Answering Task">
      <data key="d0">Question Answering Task</data>
      <data key="d1">category</data>
      <data key="d2">A category of natural language processing task, referred to as the QA task, focused on generating correct answers to queries given document context.</data>
      <data key="d3">chunk-10ce525fd225c14101bb62983a2ac21a</data>
    </node>
    <node id="Recommendation Task">
      <data key="d0">Recommendation Task</data>
      <data key="d1">category</data>
      <data key="d2">A category of information retrieval task, referred to as the Recs task, focused on ranking and recommending relevant items or responses.</data>
      <data key="d3">chunk-10ce525fd225c14101bb62983a2ac21a</data>
    </node>
    <node id="Model Training">
      <data key="d0">Model Training</data>
      <data key="d1">event</data>
      <data key="d2">The computational training procedure of the neural network executed over up to 100 epochs using the ADAM optimizer, backpropagation, and early stopping criteria.</data>
      <data key="d3">chunk-10ce525fd225c14101bb62983a2ac21a</data>
    </node>
    <node id="Evaluation Metric">
      <data key="d0">Evaluation Metric</data>
      <data key="d1">category</data>
      <data key="d2">Standard assessment criteria, specifically HITS@k including HITS@1 and HITS@100, used to measure answer retrieval and ranking accuracy.</data>
      <data key="d3">chunk-10ce525fd225c14101bb62983a2ac21a</data>
    </node>
    <node id="Activation Function">
      <data key="d0">Activation Function</data>
      <data key="d1">category</data>
      <data key="d2">Pointwise non-linear mathematical operations in the neural network, specifically ReLU, sigmoid, and tanh, used to determine activation states and prediction probabilities.</data>
      <data key="d3">chunk-10ce525fd225c14101bb62983a2ac21a</data>
    </node>
    <node id="Loss Function">
      <data key="d0">Loss Function</data>
      <data key="d1">category</data>
      <data key="d2">The mathematical objective function, specifically binary cross-entropy loss, minimized during model optimization to compare predictions against binary target vectors.</data>
      <data key="d3">chunk-10ce525fd225c14101bb62983a2ac21a</data>
    </node>
    <node id="Text Preprocessing">
      <data key="d0">Text Preprocessing</data>
      <data key="d1">category</data>
      <data key="d2">Natural language processing techniques, including word tokenization and stopword removal, used to prepare queries, documents, and answers for the neural model.</data>
      <data key="d3">chunk-10ce525fd225c14101bb62983a2ac21a</data>
    </node>
    <node id="Regularization Technique">
      <data key="d0">Regularization Technique</data>
      <data key="d1">category</data>
      <data key="d2">Machine learning techniques including Dropout, L2 regularization, and gradient clipping applied to stabilize training and prevent overfitting.</data>
      <data key="d3">chunk-10ce525fd225c14101bb62983a2ac21a</data>
    </node>
    <node id="Optimization Method">
      <data key="d0">Optimization Method</data>
      <data key="d1">category</data>
      <data key="d2">Algorithmic optimization techniques, such as the ADAM optimizer, used to update network weights based on computed gradients.</data>
      <data key="d3">chunk-10ce525fd225c14101bb62983a2ac21a</data>
    </node>
    <node id="Larenz Tate">
      <data key="d0">Larenz Tate</data>
      <data key="d1">person</data>
      <data key="d2">Larenz Tate is an actor used as an example query subject in evaluating the neural network model's question answering capabilities.</data>
      <data key="d3">chunk-bdef2f67b0ab332d8da79c41fb0e58c7</data>
    </node>
    <node id="Collaborative Filtering">
      <data key="d0">Collaborative Filtering</data>
      <data key="d1">category</data>
      <data key="d2">Collaborative Filtering is a recommendation system technique that relies on neighborhood information and user behavior to predict preferences.</data>
      <data key="d3">chunk-bdef2f67b0ab332d8da79c41fb0e58c7</data>
    </node>
    <node id="Content-Based Systems">
      <data key="d0">Content-Based Systems</data>
      <data key="d1">category</data>
      <data key="d2">Content-based systems are a category of recommender systems that suggest items by leveraging item descriptions, metadata, and user profile preferences.</data>
      <data key="d3">chunk-bdef2f67b0ab332d8da79c41fb0e58c7</data>
    </node>
    <node id="bAbI">
      <data key="d0">bAbI</data>
      <data key="d1">category</data>
      <data key="d2">bAbI is a synthetic benchmark dataset consisting of elementary reasoning tasks, such as induction, deduction, counting, and yes/no questions, used to evaluate artificial agents.</data>
      <data key="d3">chunk-bdef2f67b0ab332d8da79c41fb0e58c7</data>
    </node>
    <node id="MCTest">
      <data key="d0">MCTest</data>
      <data key="d1">category</data>
      <data key="d2">MCTest is an open-domain machine reading comprehension benchmark requiring systems to answer multiple-choice questions about fictional stories.</data>
      <data key="d3">chunk-bdef2f67b0ab332d8da79c41fb0e58c7</data>
    </node>
    <node id="SQuAD">
      <data key="d0">SQuAD</data>
      <data key="d1">category</data>
      <data key="d2">SQuAD (Stanford Question Answering Dataset) is a reading comprehension benchmark based on Wikipedia articles where answers correspond to text segments.&lt;SEP&gt;Stanford Question Answering Dataset (SQuAD) is a benchmark dataset category referenced as driving advancements in reading comprehension and question answering.</data>
      <data key="d3">chunk-bdef2f67b0ab332d8da79c41fb0e58c7&lt;SEP&gt;chunk-af2c44c466ad216bc8f3bec17868b71f</data>
    </node>
    <node id="Machine Comprehension">
      <data key="d0">Machine Comprehension</data>
      <data key="d1">category</data>
      <data key="d2">Machine comprehension is a subfield of natural language processing and artificial intelligence focused on enabling machines to read, understand, and answer questions about texts.</data>
      <data key="d3">chunk-bdef2f67b0ab332d8da79c41fb0e58c7</data>
    </node>
    <node id="Memory Network">
      <data key="d0">Memory Network</data>
      <data key="d1">category</data>
      <data key="d2">Memory Network is a neural network architecture framework capable of reading from and writing to external memories using attention mechanisms to answer questions.</data>
      <data key="d3">chunk-bdef2f67b0ab332d8da79c41fb0e58c7</data>
    </node>
    <node id="IBM">
      <data key="d0">IBM</data>
      <data key="d1">organization</data>
      <data key="d2">IBM is a multinational technology corporation that supported the cognitive question answering research through the IBM Faculty Award.</data>
      <data key="d3">chunk-2425a9bfa1c48f3e56350fa213bdbdab</data>
    </node>
    <node id="NVIDIA Corporation">
      <data key="d0">NVIDIA Corporation</data>
      <data key="d1">organization</data>
      <data key="d2">NVIDIA Corporation is a technology company that donated the Titan X GPU hardware used to conduct the research.</data>
      <data key="d3">chunk-2425a9bfa1c48f3e56350fa213bdbdab</data>
    </node>
    <node id="Imitation Learning">
      <data key="d0">Imitation Learning</data>
      <data key="d1">category</data>
      <data key="d2">A machine learning category where computational agents learn optimal behaviors by mimicking demonstrated actions or trajectories.&lt;SEP&gt;Imitation Learning is a machine learning technique requiring access to expert policies, evaluated as a computationally expensive alternative to differentiable relaxation.&lt;SEP&gt;Imitation learning is a machine learning paradigm used to directly optimize coreference resolvers against evaluation metrics.</data>
      <data key="d3">chunk-a70218d643d3a2f540abe4bb2afd6986&lt;SEP&gt;chunk-a61fcfaa9d7ad4a6f8c3cbb5352049c7&lt;SEP&gt;chunk-2425a9bfa1c48f3e56350fa213bdbdab</data>
    </node>
    <node id="EMNLP 2016">
      <data key="d0">EMNLP 2016</data>
      <data key="d1">event</data>
      <data key="d2">EMNLP 2016 is an academic natural language processing conference where referenced prior work on reinforcement learning and reward rescaling for coreference resolution was published.&lt;SEP&gt;The 2016 Conference on Empirical Methods in Natural Language Processing, where Clark and Manning presented their coreference resolution model.</data>
      <data key="d3">chunk-3dddef9c6531f0d5588d28af861e6bd4&lt;SEP&gt;chunk-2425a9bfa1c48f3e56350fa213bdbdab</data>
    </node>
    <node id="Clark and Manning">
      <data key="d0">Clark and Manning</data>
      <data key="d1">person</data>
      <data key="d2">Clark and Manning (referenced as clark-m and N16-1114) are researchers whose coreference resolution models, feature sets, and pretraining methodology serve as comparisons and baselines.&lt;SEP&gt;Clark and Manning are natural language processing researchers known for their work on neural coreference resolution systems using reinforcement learning and reward rescaling.</data>
      <data key="d3">chunk-e8c71ebe855cec9ba2150fa3ef2be8c9&lt;SEP&gt;chunk-2425a9bfa1c48f3e56350fa213bdbdab</data>
    </node>
    <node id="MUC Metric">
      <data key="d0">MUC Metric</data>
      <data key="d1">category</data>
      <data key="d2">A link-based coreference evaluation metric considered to be one of the five popular standards, though identified as the least discriminative.&lt;SEP&gt;MUC is a standard link-based evaluation metric used to score coreference resolution systems.</data>
      <data key="d3">chunk-24b23b9abc552137b6cbb1c4cd6b7ea4&lt;SEP&gt;chunk-2425a9bfa1c48f3e56350fa213bdbdab</data>
    </node>
    <node id="B-cubed Metric">
      <data key="d0">B-cubed Metric</data>
      <data key="d1">category</data>
      <data key="d2">B-cubed is a widely used coreference resolution evaluation metric that calculates precision and recall over mention clusters.</data>
      <data key="d3">chunk-2425a9bfa1c48f3e56350fa213bdbdab</data>
    </node>
    <node id="CEAF Metric">
      <data key="d0">CEAF Metric</data>
      <data key="d1">category</data>
      <data key="d2">An entity-based coreference evaluation metric comprising variants like CEAF_e and CEAF_m, known for high computational complexity.&lt;SEP&gt;CEAF is an entity-based evaluation metric for coreference resolution that optimizes alignment between predicted and gold clusters.</data>
      <data key="d3">chunk-24b23b9abc552137b6cbb1c4cd6b7ea4&lt;SEP&gt;chunk-2425a9bfa1c48f3e56350fa213bdbdab</data>
    </node>
    <node id="LEA Metric">
      <data key="d0">LEA Metric</data>
      <data key="d1">category</data>
      <data key="d2">LEA is a link-based entity-aware evaluation metric for coreference resolution that scores resolved entities proportional to their importance.&lt;SEP&gt;Link Entity-Aware evaluation metric that balances discriminativity and interpretability by scoring coreference links across entities.</data>
      <data key="d3">chunk-24b23b9abc552137b6cbb1c4cd6b7ea4&lt;SEP&gt;chunk-2425a9bfa1c48f3e56350fa213bdbdab</data>
    </node>
    <node id="Neural Mention Ranking">
      <data key="d0">Neural Mention Ranking</data>
      <data key="d1">category</data>
      <data key="d2">A modeling framework in coreference resolution that scores and ranks antecedent mentions relative to a target mention using neural scoring functions.</data>
      <data key="d3">chunk-24b23b9abc552137b6cbb1c4cd6b7ea4</data>
    </node>
    <node id="Entity-Centric Resolver">
      <data key="d0">Entity-Centric Resolver</data>
      <data key="d1">category</data>
      <data key="d2">A coreference resolution model architecture that explicitly models and maintains entity-level clusters rather than treating links purely as mention pairs.</data>
      <data key="d3">chunk-24b23b9abc552137b6cbb1c4cd6b7ea4</data>
    </node>
    <node id="B-Cubed Metric">
      <data key="d0">B-Cubed Metric</data>
      <data key="d1">category</data>
      <data key="d2">An evaluation metric for coreference resolution based on mention precision and recall, incorporated directly into the resolver's loss function.</data>
      <data key="d3">chunk-24b23b9abc552137b6cbb1c4cd6b7ea4</data>
    </node>
    <node id="BLANC Metric">
      <data key="d0">BLANC Metric</data>
      <data key="d1">category</data>
      <data key="d2">A link-based coreference evaluation metric used to assess the performance of coreference resolution systems.</data>
      <data key="d3">chunk-24b23b9abc552137b6cbb1c4cd6b7ea4</data>
    </node>
    <node id="Softmax-Margin Loss">
      <data key="d0">Softmax-Margin Loss</data>
      <data key="d1">category</data>
      <data key="d2">A probabilistic loss function applied in mention ranking to incorporate margin penalties for different types of antecedent ranking errors.</data>
      <data key="d3">chunk-24b23b9abc552137b6cbb1c4cd6b7ea4</data>
    </node>
    <node id="Max-Margin Loss">
      <data key="d0">Max-Margin Loss</data>
      <data key="d1">category</data>
      <data key="d2">A traditional margin-based objective function utilized in earlier coreference ranking models, contrasted with probabilistic formulations.</data>
      <data key="d3">chunk-24b23b9abc552137b6cbb1c4cd6b7ea4</data>
    </node>
    <node id="Reward Rescaling">
      <data key="d0">Reward Rescaling</data>
      <data key="d1">category</data>
      <data key="d2">A reinforcement learning and loss modification technique used to train coreference resolution models to optimize task-specific evaluation metrics.&lt;SEP&gt;An optimization technique used in reinforcement learning frameworks for coreference resolution to adjust policy rewards.&lt;SEP&gt;Reward rescaling is a technique used in reinforcement learning-based model training to improve performance across evaluation datasets.</data>
      <data key="d3">chunk-a70218d643d3a2f540abe4bb2afd6986&lt;SEP&gt;chunk-3dddef9c6531f0d5588d28af861e6bd4&lt;SEP&gt;chunk-24b23b9abc552137b6cbb1c4cd6b7ea4</data>
    </node>
    <node id="Differentiable Relaxations">
      <data key="d0">Differentiable Relaxations</data>
      <data key="d1">category</data>
      <data key="d2">Differentiable relaxations are mathematical approximations of non-differentiable evaluation metrics allowing continuous end-to-end optimization.&lt;SEP&gt;Mathematical relaxations designed to permit gradient-based optimization of non-differentiable clustering metrics within neural models.</data>
      <data key="d3">chunk-a70218d643d3a2f540abe4bb2afd6986&lt;SEP&gt;chunk-24b23b9abc552137b6cbb1c4cd6b7ea4</data>
    </node>
    <node id="Coreference Error Types">
      <data key="d0">Coreference Error Types</data>
      <data key="d1">category</data>
      <data key="d2">The categorization of mention ranking mistakes, including false anaphor, false new, wrong link, and no mistake, each associated with specific cost weights.</data>
      <data key="d3">chunk-24b23b9abc552137b6cbb1c4cd6b7ea4</data>
    </node>
    <node id="CoNLL 2012 Shared Task">
      <data key="d0">CoNLL 2012 Shared Task</data>
      <data key="d1">event</data>
      <data key="d2">The CoNLL 2012 Shared Task is a benchmark evaluation event and competition in natural language processing that provided standard datasets for training and testing coreference resolution systems.</data>
      <data key="d3">chunk-e8c71ebe855cec9ba2150fa3ef2be8c9</data>
    </node>
    <node id="B-Cubed">
      <data key="d0">B-Cubed</data>
      <data key="d1">category</data>
      <data key="d2">An item-based evaluation metric that calculates precision and recall for every mention in coreference resolution.&lt;SEP&gt;B-Cubed is an evaluation metric category in natural language processing used to evaluate coreference resolution models, adapted into a differentiable loss function in the research.</data>
      <data key="d3">chunk-e8c71ebe855cec9ba2150fa3ef2be8c9&lt;SEP&gt;chunk-3dddef9c6531f0d5588d28af861e6bd4</data>
    </node>
    <node id="LEA">
      <data key="d0">LEA</data>
      <data key="d1">category</data>
      <data key="d2">A link-based entity-aware evaluation metric for coreference resolution that accounts for both entity size and internal link importance.&lt;SEP&gt;LEA (Link Entity Aware) is an evaluation metric category for coreference resolution, converted into a differentiable loss formulation for resolver optimization.</data>
      <data key="d3">chunk-e8c71ebe855cec9ba2150fa3ef2be8c9&lt;SEP&gt;chunk-3dddef9c6531f0d5588d28af861e6bd4</data>
    </node>
    <node id="BLANC">
      <data key="d0">BLANC</data>
      <data key="d1">category</data>
      <data key="d2">A link-based evaluation metric designed to measure coreference resolution system performance independently of cluster size.&lt;SEP&gt;BLANC is an evaluation metric category used to assess coreference resolution model performance across entity links.</data>
      <data key="d3">chunk-e8c71ebe855cec9ba2150fa3ef2be8c9&lt;SEP&gt;chunk-3dddef9c6531f0d5588d28af861e6bd4</data>
    </node>
    <node id="Entity-Centric Heuristic Cross Entropy Loss">
      <data key="d0">Entity-Centric Heuristic Cross Entropy Loss</data>
      <data key="d1">category</data>
      <data key="d2">Entity-Centric Heuristic Cross Entropy Loss is a loss function category that frames coreference resolution as a multiclass prediction problem incorporating heuristic cost terms for different error types.</data>
      <data key="d3">chunk-e8c71ebe855cec9ba2150fa3ef2be8c9</data>
    </node>
    <node id="Phong Le">
      <data key="d0">Phong Le</data>
      <data key="d1">person</data>
      <data key="d2">Phong Le (lephong) is a computer science and natural language processing researcher whose GitHub repository hosts the source code and trained models for differentiable metric coreference resolution.</data>
      <data key="d3">chunk-e8c71ebe855cec9ba2150fa3ef2be8c9</data>
    </node>
    <node id="Mention-Ranking Heuristic Loss">
      <data key="d0">Mention-Ranking Heuristic Loss</data>
      <data key="d1">category</data>
      <data key="d2">Mention-Ranking Heuristic Loss is a training objective category in coreference resolution that scores antecedent mentions and penalizes specific link error types.</data>
      <data key="d3">chunk-e8c71ebe855cec9ba2150fa3ef2be8c9</data>
    </node>
    <node id="Soft-Cluster Representation">
      <data key="d0">Soft-Cluster Representation</data>
      <data key="d1">category</data>
      <data key="d2">Soft-Cluster Representation is an algorithmic approach category that models mentions as probabilistic distributions over clusters to enable differentiable metric computation.</data>
      <data key="d3">chunk-e8c71ebe855cec9ba2150fa3ef2be8c9</data>
    </node>
    <node id="Temperature Annealing">
      <data key="d0">Temperature Annealing</data>
      <data key="d1">category</data>
      <data key="d2">Temperature Annealing is an optimization strategy category where the softmax temperature begins high and is gradually reduced during training to sharpen probabilistic cluster memberships.</data>
      <data key="d3">chunk-e8c71ebe855cec9ba2150fa3ef2be8c9</data>
    </node>
    <node id="Set Size Function">
      <data key="d0">Set Size Function</data>
      <data key="d1">category</data>
      <data key="d2">Set Size Function is a core mathematical function category used in calculating evaluation metrics such as B-Cubed and LEA.</data>
      <data key="d3">chunk-e8c71ebe855cec9ba2150fa3ef2be8c9</data>
    </node>
    <node id="Link Function">
      <data key="d0">Link Function</data>
      <data key="d1">category</data>
      <data key="d2">Link Function is a mathematical function category quantifying antecedent relations in coreference evaluation metrics.</data>
      <data key="d3">chunk-e8c71ebe855cec9ba2150fa3ef2be8c9</data>
    </node>
    <node id="Mention Ranking">
      <data key="d0">Mention Ranking</data>
      <data key="d1">category</data>
      <data key="d2">Mention ranking is a dominant, computationally efficient paradigm in coreference resolution that evaluates candidate antecedents for a mention through ranking.&lt;SEP&gt;Mention ranking is an algorithmic paradigm in coreference resolution where scores are computed to rank candidate antecedents for mentions.</data>
      <data key="d3">chunk-a70218d643d3a2f540abe4bb2afd6986&lt;SEP&gt;chunk-3dddef9c6531f0d5588d28af861e6bd4</data>
    </node>
    <node id="Entity Centricity">
      <data key="d0">Entity Centricity</data>
      <data key="d1">category</data>
      <data key="d2">Entity centricity is a paradigm in coreference resolution literature focusing on entity-level representations.</data>
      <data key="d3">chunk-3dddef9c6531f0d5588d28af861e6bd4</data>
    </node>
    <node id="Clark">
      <data key="d0">Clark</data>
      <data key="d1">person</data>
      <data key="d2">A researcher who, together with Manning, developed deep neural mention-ranking resolvers and reward rescaling techniques.</data>
      <data key="d3">chunk-3dddef9c6531f0d5588d28af861e6bd4</data>
    </node>
    <node id="Manning">
      <data key="d0">Manning</data>
      <data key="d1">person</data>
      <data key="d2">A researcher who, together with Clark, developed neural network approaches to mention-ranking coreference resolution.</data>
      <data key="d3">chunk-3dddef9c6531f0d5588d28af861e6bd4</data>
    </node>
    <node id="Moosavi">
      <data key="d0">Moosavi</data>
      <data key="d1">person</data>
      <data key="d2">A researcher who, together with Strube, investigated the behavior and comparison of coreference evaluation metrics.</data>
      <data key="d3">chunk-3dddef9c6531f0d5588d28af861e6bd4</data>
    </node>
    <node id="Strube">
      <data key="d0">Strube</data>
      <data key="d1">person</data>
      <data key="d2">A researcher who co-authored work with Marciniak on applying integer linear programming to multi-sentence route directions and language processing subtasks.&lt;SEP&gt;A researcher who co-authored work with Moosavi studying coreference evaluation metrics including B-cubed and LEA.&lt;SEP&gt;Strube is a researcher who co-proposed an integer linear programming approach for language processing tasks.</data>
      <data key="d3">chunk-0e6575c1afc788be74bd028dfc616620&lt;SEP&gt;chunk-3dddef9c6531f0d5588d28af861e6bd4&lt;SEP&gt;chunk-4ccf1d827990dd6a5adc3c9f90a8f419</data>
    </node>
    <node id="CoNLL Metric">
      <data key="d0">CoNLL Metric</data>
      <data key="d1">category</data>
      <data key="d2">The standard benchmark evaluation metric in coreference resolution, typically calculated as the average of MUC, B-cubed, and CEAF F1 scores.</data>
      <data key="d3">chunk-3dddef9c6531f0d5588d28af861e6bd4</data>
    </node>
    <node id="MUC">
      <data key="d0">MUC</data>
      <data key="d1">category</data>
      <data key="d2">A link-based evaluation metric for coreference systems based on the minimum number of links needed to connect coreferent mentions.</data>
      <data key="d3">chunk-3dddef9c6531f0d5588d28af861e6bd4</data>
    </node>
    <node id="CEAF">
      <data key="d0">CEAF</data>
      <data key="d1">category</data>
      <data key="d2">An entity-based coreference evaluation metric that aligns reference and system entities using an optimal one-to-one mapping.</data>
      <data key="d3">chunk-3dddef9c6531f0d5588d28af861e6bd4</data>
    </node>
    <node id="Heuristic Cross Entropy Loss">
      <data key="d0">Heuristic Cross Entropy Loss</data>
      <data key="d1">category</data>
      <data key="d2">A loss formulation used to train baseline mention-ranking models by applying heuristic penalty structures to cross-entropy.</data>
      <data key="d3">chunk-3dddef9c6531f0d5588d28af861e6bd4</data>
    </node>
    <node id="Over-Clustering">
      <data key="d0">Over-Clustering</data>
      <data key="d1">category</data>
      <data key="d2">An error mode in coreference resolution where non-coreferent mentions are erroneously linked together, resulting in false anaphor errors.</data>
      <data key="d3">chunk-3dddef9c6531f0d5588d28af861e6bd4</data>
    </node>
    <node id="Under-Clustering">
      <data key="d0">Under-Clustering</data>
      <data key="d1">category</data>
      <data key="d2">An error mode in coreference resolution where coreferent mentions are mistakenly left unlinked or separated, resulting in false new errors.</data>
      <data key="d3">chunk-3dddef9c6531f0d5588d28af861e6bd4</data>
    </node>
    <node id="Annealing">
      <data key="d0">Annealing</data>
      <data key="d1">category</data>
      <data key="d2">A training and optimization technique proposed to gradually adjust relaxation parameters toward zero during training.</data>
      <data key="d3">chunk-3dddef9c6531f0d5588d28af861e6bd4</data>
    </node>
    <node id="CoNLL">
      <data key="d0">CoNLL</data>
      <data key="d1">organization</data>
      <data key="d2">The Conference on Computational Natural Language Learning, which organizes standard shared tasks and establishes benchmark evaluation frameworks in coreference resolution.</data>
      <data key="d3">chunk-3dddef9c6531f0d5588d28af861e6bd4</data>
    </node>
    <node id="Raquel Fernández">
      <data key="d0">Raquel Fernández</data>
      <data key="d1">person</data>
      <data key="d2">Raquel Fernández is a researcher acknowledged for providing feedback and suggestions on the research project.</data>
      <data key="d3">chunk-a70218d643d3a2f540abe4bb2afd6986</data>
    </node>
    <node id="Wilker Aziz">
      <data key="d0">Wilker Aziz</data>
      <data key="d1">person</data>
      <data key="d2">Wilker Aziz is a researcher acknowledged for contributing suggestions and comments to the study.</data>
      <data key="d3">chunk-a70218d643d3a2f540abe4bb2afd6986</data>
    </node>
    <node id="Nafise Sadat Moosavi">
      <data key="d0">Nafise Sadat Moosavi</data>
      <data key="d1">person</data>
      <data key="d2">Nafise Sadat Moosavi is an academic recognized for offering feedback and comments on the work.</data>
      <data key="d3">chunk-a70218d643d3a2f540abe4bb2afd6986</data>
    </node>
    <node id="Dutch National Science Foundation">
      <data key="d0">Dutch National Science Foundation</data>
      <data key="d1">organization</data>
      <data key="d2">The Dutch National Science Foundation (NWO) is a national research council that financed the project via grant NWO VIDI 639.022.518.</data>
      <data key="d3">chunk-a70218d643d3a2f540abe4bb2afd6986</data>
    </node>
    <node id="Amazon Web Services">
      <data key="d0">Amazon Web Services</data>
      <data key="d1">organization</data>
      <data key="d2">Amazon Web Services (AWS) is a cloud computing provider that supported the research with a grant.</data>
      <data key="d3">chunk-a70218d643d3a2f540abe4bb2afd6986</data>
    </node>
    <node id="CoNLL 2012">
      <data key="d0">CoNLL 2012</data>
      <data key="d1">event</data>
      <data key="d2">CoNLL 2012 is a natural language processing shared task event that provided a benchmark dataset in English and Chinese for coreference resolution.</data>
      <data key="d3">chunk-a70218d643d3a2f540abe4bb2afd6986</data>
    </node>
    <node id="Transfer Learning">
      <data key="d0">Transfer Learning</data>
      <data key="d1">category</data>
      <data key="d2">A machine learning method where knowledge gained from a parent model is transferred to a child model, demonstrated in Uzbek–English neural machine translation.&lt;SEP&gt;A machine learning paradigm where knowledge acquired from training on a data-rich task or language pair is transferred to initialize and improve a model for a data-scarce task.&lt;SEP&gt;A machine learning paradigm where knowledge learned from a high-resource parent task or model is transferred to initialize and constrain training on a related child task with limited data.&lt;SEP&gt;Transfer learning is a machine learning approach where learned parameters from high-resource tasks are transferred to improve performance on low-resource tasks.&lt;SEP&gt;Transfer learning is a machine learning technique applied to NMT by training parent models on high-resource data to assist child models for low-resource languages.</data>
      <data key="d3">chunk-b98e14081bd42f130f547ac6df8114f8&lt;SEP&gt;chunk-7818b9847aa576cb0d1559c6c5e963ca&lt;SEP&gt;chunk-5e8ad7bf1880d82f40811c2078046e6b&lt;SEP&gt;chunk-a70218d643d3a2f540abe4bb2afd6986&lt;SEP&gt;chunk-762be16cab89cb90aaf53d4505452bf5</data>
    </node>
    <node id="Entity-Centric Coreference">
      <data key="d0">Entity-Centric Coreference</data>
      <data key="d1">category</data>
      <data key="d2">Entity-centric coreference resolution is an approach that incorporates cluster-level or entity-level representations rather than relying solely on pairwise mention links.</data>
      <data key="d3">chunk-a70218d643d3a2f540abe4bb2afd6986</data>
    </node>
    <node id="Encoder-Decoder Framework">
      <data key="d0">Encoder-Decoder Framework</data>
      <data key="d1">category</data>
      <data key="d2">A neural network architecture framework composed of an encoder converting input sequences into dense representations and a decoder generating target sequences.&lt;SEP&gt;The encoder-decoder framework is a deep learning architecture commonly used for sequence-to-sequence translation and language processing tasks.</data>
      <data key="d3">chunk-a70218d643d3a2f540abe4bb2afd6986&lt;SEP&gt;chunk-b98e14081bd42f130f547ac6df8114f8</data>
    </node>
    <node id="Low-Resource Languages">
      <data key="d0">Low-Resource Languages</data>
      <data key="d1">category</data>
      <data key="d2">A category of natural languages characterized by limited available parallel training data, such as Uzbek and Hausa.&lt;SEP&gt;A classification of languages with scarce parallel text training data, making vanilla neural translation models prone to underperformance.&lt;SEP&gt;A group of languages with limited available bilingual training datasets, specifically represented in the study by Hausa, Turkish, Uzbek, and Urdu.&lt;SEP&gt;Low-Resource Languages are languages lacking extensive parallel text corpora and digital resources required to train high-accuracy natural language processing models.&lt;SEP&gt;Low-resource languages are non-English and under-resourced languages with scarce parallel corpora and digital linguistic data available for automated translation.</data>
      <data key="d3">chunk-b98e14081bd42f130f547ac6df8114f8&lt;SEP&gt;chunk-aa612722a8775613a3ecb4a189613e3f&lt;SEP&gt;chunk-7818b9847aa576cb0d1559c6c5e963ca&lt;SEP&gt;chunk-116526d304daa442dbc1df519e7f8fc5&lt;SEP&gt;chunk-762be16cab89cb90aaf53d4505452bf5</data>
    </node>
    <node id="Cirecsan">
      <data key="d0">Cirecsan</data>
      <data key="d1">person</data>
      <data key="d2">A researcher cited for pioneering work in transfer learning with convolutional neural networks across character recognition tasks.</data>
      <data key="d3">chunk-b98e14081bd42f130f547ac6df8114f8</data>
    </node>
    <node id="Hausa">
      <data key="d0">Hausa</data>
      <data key="d1">category</data>
      <data key="d2">A low-resource child source language paired with English to evaluate the transfer learning translation approach.&lt;SEP&gt;A low-resource language evaluated in the study for translation into English using transfer learning.&lt;SEP&gt;A low-resource language identified as an experimental child language where choice of parent language could improve results.&lt;SEP&gt;Hausa is a low-resource language evaluated in translation experiments where the transfer NMT model outperformed a strong SBMT baseline.</data>
      <data key="d3">chunk-b98e14081bd42f130f547ac6df8114f8&lt;SEP&gt;chunk-3c17cbdd46b3ef569862a8fa188b4fab&lt;SEP&gt;chunk-762be16cab89cb90aaf53d4505452bf5&lt;SEP&gt;chunk-7818b9847aa576cb0d1559c6c5e963ca</data>
    </node>
    <node id="Uzbek">
      <data key="d0">Uzbek</data>
      <data key="d1">category</data>
      <data key="d2">A low-resource child source language with scarce parallel bilingual training data paired with English.&lt;SEP&gt;A low-resource language evaluated in the study for translation into English using transfer learning.&lt;SEP&gt;A low-resource language paired with English to test transfer learning and embedding alignment methods.&lt;SEP&gt;Uzbek is a low-resource language evaluated in transfer learning experiments paired with English as the target language.</data>
      <data key="d3">chunk-b98e14081bd42f130f547ac6df8114f8&lt;SEP&gt;chunk-3c17cbdd46b3ef569862a8fa188b4fab&lt;SEP&gt;chunk-762be16cab89cb90aaf53d4505452bf5&lt;SEP&gt;chunk-7818b9847aa576cb0d1559c6c5e963ca</data>
    </node>
    <node id="Urdu">
      <data key="d0">Urdu</data>
      <data key="d1">category</data>
      <data key="d2">A low-resource child source language paired with English in the evaluation of transfer learning methods.&lt;SEP&gt;A low-resource language evaluated in the study for translation into English using transfer learning.&lt;SEP&gt;A low-resource language identified as a target child language for transfer learning experiments.&lt;SEP&gt;An Indo-Aryan language examined in translation experiments, sharing high lexical similarity with Hindi.&lt;SEP&gt;Urdu is a language that utilizes an extended Arabic abjad writing system, showing significant translation performance gains with BPE.</data>
      <data key="d3">chunk-b98e14081bd42f130f547ac6df8114f8&lt;SEP&gt;chunk-ba3fa25c5e29c7ea3201eac4d5fbec61&lt;SEP&gt;chunk-acd45458d7c3c63e9891f23252405a17&lt;SEP&gt;chunk-762be16cab89cb90aaf53d4505452bf5&lt;SEP&gt;chunk-3c17cbdd46b3ef569862a8fa188b4fab</data>
    </node>
    <node id="Bleu Score">
      <data key="d0">Bleu Score</data>
      <data key="d1">category</data>
      <data key="d2">A standard evaluation metric for machine translation quality used to measure the performance improvements of various transfer models and baselines.&lt;SEP&gt;An automatic evaluation metric commonly used in machine translation to assess the fluency and accuracy of translated text against reference translations.</data>
      <data key="d3">chunk-b98e14081bd42f130f547ac6df8114f8&lt;SEP&gt;chunk-3c17cbdd46b3ef569862a8fa188b4fab</data>
    </node>
    <node id="Parent Model">
      <data key="d0">Parent Model</data>
      <data key="d1">category</data>
      <data key="d2">A high-resource neural machine translation model whose learned parameters and representations are transferred to initialize and constrain a child model.&lt;SEP&gt;A neural network translation model trained on a large bilingual or monolingual corpus whose parameters and embeddings are transferred to initialize a child model.&lt;SEP&gt;A pre-trained neural machine translation model whose learned representations and weights are transferred to a target child model.</data>
      <data key="d3">chunk-b98e14081bd42f130f547ac6df8114f8&lt;SEP&gt;chunk-3c17cbdd46b3ef569862a8fa188b4fab&lt;SEP&gt;chunk-7818b9847aa576cb0d1559c6c5e963ca</data>
    </node>
    <node id="Child Model">
      <data key="d0">Child Model</data>
      <data key="d1">category</data>
      <data key="d2">A low-resource machine translation model initialized with parameters transferred from a parent model and fine-tuned on limited data.&lt;SEP&gt;A neural machine translation model for a low-resource language pair that is regularized or initialized using a parent model.&lt;SEP&gt;A translation model trained on a low-resource language pair that leverages transferred parameters from a pre-trained parent model.</data>
      <data key="d3">chunk-b98e14081bd42f130f547ac6df8114f8&lt;SEP&gt;chunk-3c17cbdd46b3ef569862a8fa188b4fab&lt;SEP&gt;chunk-7818b9847aa576cb0d1559c6c5e963ca</data>
    </node>
    <node id="String-to-Tree Statistical MT">
      <data key="d0">String-to-Tree Statistical MT</data>
      <data key="d1">category</data>
      <data key="d2">A specific syntax-based statistical machine translation formulation that translates source strings directly into target parse trees.</data>
      <data key="d3">chunk-b98e14081bd42f130f547ac6df8114f8</data>
    </node>
    <node id="Document Classification">
      <data key="d0">Document Classification</data>
      <data key="d1">category</data>
      <data key="d2">An NLP classification task where deep transfer learning techniques have demonstrated positive results.</data>
      <data key="d3">chunk-b98e14081bd42f130f547ac6df8114f8</data>
    </node>
    <node id="Latin Characters">
      <data key="d0">Latin Characters</data>
      <data key="d1">category</data>
      <data key="d2">A writing script used as a source or target task domain in transfer learning experiments for character recognition.</data>
      <data key="d3">chunk-b98e14081bd42f130f547ac6df8114f8</data>
    </node>
    <node id="Chinese Characters">
      <data key="d0">Chinese Characters</data>
      <data key="d1">category</data>
      <data key="d2">A writing script domain evaluated in convolutional transfer learning studies alongside Latin characters.</data>
      <data key="d3">chunk-b98e14081bd42f130f547ac6df8114f8</data>
    </node>
    <node id="WMT 2015">
      <data key="d0">WMT 2015</data>
      <data key="d1">event</data>
      <data key="d2">The 2015 Workshop on Statistical Machine Translation, whose French-English dataset serves as the high-resource training corpus for the parent models.</data>
      <data key="d3">chunk-762be16cab89cb90aaf53d4505452bf5</data>
    </node>
    <node id="ACL-IJCNLP">
      <data key="d0">ACL-IJCNLP</data>
      <data key="d1">event</data>
      <data key="d2">A joint academic conference on natural language processing where foundational work on unknown word replacement was published.</data>
      <data key="d3">chunk-762be16cab89cb90aaf53d4505452bf5</data>
    </node>
    <node id="Noise-Contrastive Estimation">
      <data key="d0">Noise-Contrastive Estimation</data>
      <data key="d1">category</data>
      <data key="d2">A statistical training method used to train the neural language model with a target vocabulary of 100,000 words.&lt;SEP&gt;A statistical training technique applied to train the large-vocabulary LSTM neural language model efficiently.</data>
      <data key="d3">chunk-3c17cbdd46b3ef569862a8fa188b4fab&lt;SEP&gt;chunk-762be16cab89cb90aaf53d4505452bf5</data>
    </node>
    <node id="Transfer NMT">
      <data key="d0">Transfer NMT</data>
      <data key="d1">category</data>
      <data key="d2">A neural machine translation approach that utilizes transfer learning from a parent model to improve translation performance on low-resource child languages.</data>
      <data key="d3">chunk-3c17cbdd46b3ef569862a8fa188b4fab</data>
    </node>
    <node id="SBMT">
      <data key="d0">SBMT</data>
      <data key="d1">category</data>
      <data key="d2">Syntax-Based Machine Translation, a strong baseline translation system against which transfer models and re-scoring techniques are compared.</data>
      <data key="d3">chunk-3c17cbdd46b3ef569862a8fa188b4fab</data>
    </node>
    <node id="French-English">
      <data key="d0">French-English</data>
      <data key="d1">category</data>
      <data key="d2">A high-resource parent language pair used across transfer learning experiments to transfer representations to child language pairs.</data>
      <data key="d3">chunk-3c17cbdd46b3ef569862a8fa188b4fab</data>
    </node>
    <node id="Spanish-English">
      <data key="d0">Spanish-English</data>
      <data key="d1">category</data>
      <data key="d2">A child language pair used in experiments evaluating the impact of different parent languages on transfer learning performance.</data>
      <data key="d3">chunk-3c17cbdd46b3ef569862a8fa188b4fab</data>
    </node>
    <node id="Uzbek-English">
      <data key="d0">Uzbek-English</data>
      <data key="d1">category</data>
      <data key="d2">A low-resource child language pair used to test transfer from parent models such as French-English.</data>
      <data key="d3">chunk-3c17cbdd46b3ef569862a8fa188b4fab</data>
    </node>
    <node id="French'">
      <data key="d0">French'</data>
      <data key="d1">category</data>
      <data key="d2">A synthetic child language designed with the exact distributional and relational properties of French but with randomly shuffled vocabulary.</data>
      <data key="d3">chunk-3c17cbdd46b3ef569862a8fa188b4fab</data>
    </node>
    <node id="Berkeley Aligner">
      <data key="d0">Berkeley Aligner</data>
      <data key="d1">category</data>
      <data key="d2">A statistical alignment tool used to generate word-to-word t-tables between language pairs for dictionary initialization in transfer models.</data>
      <data key="d3">chunk-3c17cbdd46b3ef569862a8fa188b4fab</data>
    </node>
    <node id="English-French">
      <data key="d0">English-French</data>
      <data key="d1">category</data>
      <data key="d2">A language pair used in conjunction with Uzbek-English to build translation tables via the Berkeley Aligner.</data>
      <data key="d3">chunk-3c17cbdd46b3ef569862a8fa188b4fab</data>
    </node>
    <node id="Dictionary Initialization">
      <data key="d0">Dictionary Initialization</data>
      <data key="d1">category</data>
      <data key="d2">A transfer technique where child model input embeddings are seeded using parent embeddings guided by word-to-word t-table probabilities.</data>
      <data key="d3">chunk-3c17cbdd46b3ef569862a8fa188b4fab</data>
    </node>
    <node id="ARL/ARO">
      <data key="d0">ARL/ARO</data>
      <data key="d1">organization</data>
      <data key="d2">ARL/ARO (Army Research Laboratory / Army Research Office) is a military research organization that provided funding under grant W911NF-10-1-0533.</data>
      <data key="d3">chunk-7818b9847aa576cb0d1559c6c5e963ca</data>
    </node>
    <node id="Sutskever">
      <data key="d0">Sutskever</data>
      <data key="d1">person</data>
      <data key="d2">Sutskever is a researcher cited for the foundational 2014 work on the encoder-decoder framework for neural machine translation.</data>
      <data key="d3">chunk-7818b9847aa576cb0d1559c6c5e963ca</data>
    </node>
    <node id="String-to-Tree Statistical Machine Translation">
      <data key="d0">String-to-Tree Statistical Machine Translation</data>
      <data key="d1">category</data>
      <data key="d2">String-to-tree statistical machine translation (SBMT) is a strong statistical baseline translation system compared against and re-scored by NMT models.</data>
      <data key="d3">chunk-7818b9847aa576cb0d1559c6c5e963ca</data>
    </node>
    <node id="French′">
      <data key="d0">French′</data>
      <data key="d1">category</data>
      <data key="d2">French′ is a synthetic child language identical to French except for modified word spellings, created to test the impact of parent–child language similarity in transfer learning.</data>
      <data key="d3">chunk-7818b9847aa576cb0d1559c6c5e963ca</data>
    </node>
    <node id="Recurrent Neural Network Language Model">
      <data key="d0">Recurrent Neural Network Language Model</data>
      <data key="d1">category</data>
      <data key="d2">A monolingual neural language model (RNN LM) trained on English text, used both as an experimental parent model and for re-scoring SBMT outputs.</data>
      <data key="d3">chunk-7818b9847aa576cb0d1559c6c5e963ca</data>
    </node>
    <node id="Distributed Word Representation">
      <data key="d0">Distributed Word Representation</data>
      <data key="d1">category</data>
      <data key="d2">A technique in natural language processing where words are mapped to continuous vectors of real numbers in a low-dimensional space, capturing syntactic and semantic relationships.</data>
      <data key="d3">chunk-5e8ad7bf1880d82f40811c2078046e6b</data>
    </node>
    <node id="Skip-Gram">
      <data key="d0">Skip-Gram</data>
      <data key="d1">category</data>
      <data key="d2">A neural network model and word embedding method (word2vec) trained to predict context words given an input word, known for capturing morpho-syntactic and semantic properties via linear vector operations.&lt;SEP&gt;Skip-gram is a class of neural network models used to generate word vector embeddings from word contexts.</data>
      <data key="d3">chunk-2fd39034576eb8de5d243305db77f4b3&lt;SEP&gt;chunk-5e8ad7bf1880d82f40811c2078046e6b</data>
    </node>
    <node id="SubGram">
      <data key="d0">SubGram</data>
      <data key="d1">category</data>
      <data key="d2">A proposed extension of the Skip-gram model that incorporates character-level substring structure (such as n-grams) into word representations to enhance morpho-syntactic performance without requiring explicit linguistic annotation.&lt;SEP&gt;SubGram is a substring-oriented neural network model architecture extending Skip-gram to learn vector embeddings from character n-grams.&lt;SEP&gt;SubGram is an extension of the Skip-gram model that incorporates substrings of input words to better capture morphosyntactic relations and out-of-vocabulary terms.</data>
      <data key="d3">chunk-2fd39034576eb8de5d243305db77f4b3&lt;SEP&gt;chunk-f3e8fa58e562bb861dae62114ff9c810&lt;SEP&gt;chunk-5e8ad7bf1880d82f40811c2078046e6b</data>
    </node>
    <node id="Continuous Bag-Of-Words">
      <data key="d0">Continuous Bag-Of-Words</data>
      <data key="d1">category</data>
      <data key="d2">A neural network word embedding model (CBOW) related to Skip-gram that predicts a target word from surrounding context words, mentioned as a baseline model augmented with morphological knowledge.</data>
      <data key="d3">chunk-5e8ad7bf1880d82f40811c2078046e6b</data>
    </node>
    <node id="Neural Network">
      <data key="d0">Neural Network</data>
      <data key="d1">category</data>
      <data key="d2">A computational architecture inspired by biological neural networks, used in machine learning for tasks such as representation learning, language modeling, and translation.</data>
      <data key="d3">chunk-5e8ad7bf1880d82f40811c2078046e6b</data>
    </node>
    <node id="Hierarchical Softmax">
      <data key="d0">Hierarchical Softmax</data>
      <data key="d1">category</data>
      <data key="d2">An efficient approximation of the softmax normalization function used in neural networks and word embedding models such as Skip-gram to accelerate training.</data>
      <data key="d3">chunk-5e8ad7bf1880d82f40811c2078046e6b</data>
    </node>
    <node id="Image Annotation">
      <data key="d0">Image Annotation</data>
      <data key="d1">category</data>
      <data key="d2">A computer vision and natural language processing task involving generating textual descriptions or tags for images, which benefits from learned word vectors.</data>
      <data key="d3">chunk-5e8ad7bf1880d82f40811c2078046e6b</data>
    </node>
    <node id="Semantic Relations">
      <data key="d0">Semantic Relations</data>
      <data key="d1">category</data>
      <data key="d2">Semantic relations are a category of linguistic relations dealing with word meanings and analogies, which were tested alongside syntactic relations.&lt;SEP&gt;Semantic relations is a category of word analogies testing conceptual associations such as capitals, currencies, and family terms.</data>
      <data key="d3">chunk-2fd39034576eb8de5d243305db77f4b3&lt;SEP&gt;chunk-f3e8fa58e562bb861dae62114ff9c810</data>
    </node>
    <node id="Syntactic Relations">
      <data key="d0">Syntactic Relations</data>
      <data key="d1">category</data>
      <data key="d2">Syntactic relations is a category of grammatical and morphological word analogies testing inflections like plurals, tenses, and degrees of comparison.</data>
      <data key="d3">chunk-2fd39034576eb8de5d243305db77f4b3</data>
    </node>
    <node id="Vector Embeddings">
      <data key="d0">Vector Embeddings</data>
      <data key="d1">category</data>
      <data key="d2">Vector embeddings are dense mathematical representations of words in continuous vector space that capture linguistic semantics and syntax.</data>
      <data key="d3">chunk-2fd39034576eb8de5d243305db77f4b3</data>
    </node>
    <node id="Rule-Based Baseline">
      <data key="d0">Rule-Based Baseline</data>
      <data key="d1">category</data>
      <data key="d2">Rule-based baseline is a deterministic heuristic system based on regular English morphological suffix and prefix rules used for comparison.</data>
      <data key="d3">chunk-2fd39034576eb8de5d243305db77f4b3</data>
    </node>
    <node id="Morphosyntactic Relations">
      <data key="d0">Morphosyntactic Relations</data>
      <data key="d1">category</data>
      <data key="d2">Morphosyntactic relations refer to linguistic and grammatical transformations situated at the intersection of morphology and syntax.&lt;SEP&gt;Morphosyntactic relations represent a linguistic category focusing on the grammatical and morphological variations of words, tested via question pairs in the evaluation sets.</data>
      <data key="d3">chunk-2fd39034576eb8de5d243305db77f4b3&lt;SEP&gt;chunk-f3e8fa58e562bb861dae62114ff9c810</data>
    </node>
    <node id="Czech Republic">
      <data key="d0">Czech Republic</data>
      <data key="d1">geo</data>
      <data key="d2">A country in Central Europe whose Ministry of Education, Youth and Sports funds the LINDAT/CLARIN project.&lt;SEP&gt;The Czech Republic is a European country whose Ministry of Education, Youth and Sports funded language resources utilized in the research.</data>
      <data key="d3">chunk-3d0343896fcb9bca626f6a9369daf5a8&lt;SEP&gt;chunk-f3e8fa58e562bb861dae62114ff9c810</data>
    </node>
    <node id="Ministry of Education, Youth and Sports">
      <data key="d0">Ministry of Education, Youth and Sports</data>
      <data key="d1">organization</data>
      <data key="d2">The Ministry of Education, Youth and Sports is a Czech government ministry overseeing educational and language research initiatives, including the LINDAT/CLARIN project.</data>
      <data key="d3">chunk-f3e8fa58e562bb861dae62114ff9c810</data>
    </node>
    <node id="LINDAT/CLARIN">
      <data key="d0">LINDAT/CLARIN</data>
      <data key="d1">organization</data>
      <data key="d2">A research project that develops, stores, and distributes language resources used in the research.&lt;SEP&gt;LINDAT/CLARIN is a research infrastructure project in the Czech Republic that develops, stores, and distributes language resources.</data>
      <data key="d3">chunk-3d0343896fcb9bca626f6a9369daf5a8&lt;SEP&gt;chunk-f3e8fa58e562bb861dae62114ff9c810</data>
    </node>
    <node id="QT21">
      <data key="d0">QT21</data>
      <data key="d1">organization</data>
      <data key="d2">QT21 is a research project supported by the European Union's Horizon 2020 programme under grant agreement no. 645452.&lt;SEP&gt;QT21 is an EU-funded research project focused on machine translation and language technologies under the Horizon 2020 programme.</data>
      <data key="d3">chunk-3d0343896fcb9bca626f6a9369daf5a8&lt;SEP&gt;chunk-f3e8fa58e562bb861dae62114ff9c810</data>
    </node>
    <node id="GAUK">
      <data key="d0">GAUK</data>
      <data key="d1">organization</data>
      <data key="d2">GAUK (Grant Agency of Charles University) is a research funding body that supported the study through grant 8502/2016.&lt;SEP&gt;GAUK (Grant Agency of Charles University) is a research funding body that supported the study under grant 8502/2016.</data>
      <data key="d3">chunk-3d0343896fcb9bca626f6a9369daf5a8&lt;SEP&gt;chunk-f3e8fa58e562bb861dae62114ff9c810</data>
    </node>
    <node id="SVV">
      <data key="d0">SVV</data>
      <data key="d1">organization</data>
      <data key="d2">SVV is a university research support program and funding scheme that provided financial backing for the project.</data>
      <data key="d3">chunk-f3e8fa58e562bb861dae62114ff9c810</data>
    </node>
    <node id="Skip-gram">
      <data key="d0">Skip-gram</data>
      <data key="d1">category</data>
      <data key="d2">Skip-gram is a word embedding architecture that predicts context words given a target word, serving as the baseline model.</data>
      <data key="d3">chunk-f3e8fa58e562bb861dae62114ff9c810</data>
    </node>
    <node id="Rule-based Approach">
      <data key="d0">Rule-based Approach</data>
      <data key="d1">category</data>
      <data key="d2">Rule-based approach is a deterministic, heuristic-based NLP methodology used as a baseline that outperforms neural network models on morphosyntactic tasks.</data>
      <data key="d3">chunk-f3e8fa58e562bb861dae62114ff9c810</data>
    </node>
    <node id="Syntactic Questions">
      <data key="d0">Syntactic Questions</data>
      <data key="d1">category</data>
      <data key="d2">Syntactic questions is an analogy test set category evaluating grammatical patterns and morphological transformations between word pairs.</data>
      <data key="d3">chunk-f3e8fa58e562bb861dae62114ff9c810</data>
    </node>
    <node id="Opposites">
      <data key="d0">Opposites</data>
      <data key="d1">category</data>
      <data key="d2">Opposites is a question set category expanded in the test set to cover negation and antonymy across adjectives, nouns, and verbs.</data>
      <data key="d3">chunk-f3e8fa58e562bb861dae62114ff9c810</data>
    </node>
    <node id="Verb Tense">
      <data key="d0">Verb Tense</data>
      <data key="d1">category</data>
      <data key="d2">Verb tense is a morphosyntactic category evaluated through pairs of verb forms and their morphological variations.</data>
      <data key="d3">chunk-f3e8fa58e562bb861dae62114ff9c810</data>
    </node>
    <node id="Ministry of Education, Youth and Sports of the Czech Republic">
      <data key="d0">Ministry of Education, Youth and Sports of the Czech Republic</data>
      <data key="d1">organization</data>
      <data key="d2">A government ministry of the Czech Republic that supported the LINDAT/CLARIN language resource project under project LM2015071.</data>
      <data key="d3">chunk-3d0343896fcb9bca626f6a9369daf5a8</data>
    </node>
    <node id="Sociolinguistics">
      <data key="d0">Sociolinguistics</data>
      <data key="d1">category</data>
      <data key="d2">A branch of linguistics that studies the effect of external social, geographic, and socioeconomic factors on language variation and communication norms.&lt;SEP&gt;Sociolinguistics is an academic field and research domain focusing on the relationships between language variation, social factors, and demographic characteristics.&lt;SEP&gt;Sociolinguistics is the field of study examining linguistic variation and features in relation to socioeconomic status, geography, time, and social networks.&lt;SEP&gt;Sociolinguistics is the scientific field analyzing the relationship between language variation, geographic distribution, and socioeconomic factors.</data>
      <data key="d3">chunk-dc455b4914b59090a3ce9d2a9448259b&lt;SEP&gt;chunk-3d0343896fcb9bca626f6a9369daf5a8&lt;SEP&gt;chunk-5be31c1a19a6e864780cdaa9c6a90013&lt;SEP&gt;chunk-50bb442ab9eb2bd0ac132636b603c20a</data>
    </node>
    <node id="Computational Sociolinguistics">
      <data key="d0">Computational Sociolinguistics</data>
      <data key="d1">category</data>
      <data key="d2">An interdisciplinary research field combining computer science and sociolinguistics to analyze digital interaction patterns and language variation at scale.</data>
      <data key="d3">chunk-3d0343896fcb9bca626f6a9369daf5a8</data>
    </node>
    <node id="Southern France">
      <data key="d0">Southern France</data>
      <data key="d1">geo</data>
      <data key="d2">Southern France is a geographic region whose language use was found to be more standard compared to the North.&lt;SEP&gt;The southern region of France characterized by language closer to standard grammatical conventions and greater vocabulary diversity.&lt;SEP&gt;The southern region of France, identified in the study as exhibiting a spatial pattern with more standard language variants and greater lexical diversity.&lt;SEP&gt;The southern region of France, observed in the sociolinguistic study to have a higher propensity for standard language use compared to the northern region.</data>
      <data key="d3">chunk-3d0343896fcb9bca626f6a9369daf5a8&lt;SEP&gt;chunk-c32a5fa97db65bdeb1930b1f4e52c5ec&lt;SEP&gt;chunk-5be31c1a19a6e864780cdaa9c6a90013&lt;SEP&gt;chunk-50bb442ab9eb2bd0ac132636b603c20a</data>
    </node>
    <node id="Northern France">
      <data key="d0">Northern France</data>
      <data key="d1">geo</data>
      <data key="d2">Northern France is a geographic region whose residents were found to use more non-standard linguistic terms and a smaller vocabulary set compared to the South.&lt;SEP&gt;The northern region of France identified in the study as having lower rates of standard language usage and smaller vocabulary sizes.&lt;SEP&gt;The northern region of France, analyzed in contrast with the southern region in terms of dialectal and standard linguistic usage.</data>
      <data key="d3">chunk-3d0343896fcb9bca626f6a9369daf5a8&lt;SEP&gt;chunk-c32a5fa97db65bdeb1930b1f4e52c5ec&lt;SEP&gt;chunk-5be31c1a19a6e864780cdaa9c6a90013</data>
    </node>
    <node id="Computational Social Science">
      <data key="d0">Computational Social Science</data>
      <data key="d1">category</data>
      <data key="d2">An interdisciplinary research domain integrating computer science and social sciences to analyze digital human behavior and communication.</data>
      <data key="d3">chunk-3d0343896fcb9bca626f6a9369daf5a8</data>
    </node>
    <node id="Linguistic Variables">
      <data key="d0">Linguistic Variables</data>
      <data key="d1">category</data>
      <data key="d2">Linguistic variables are quantitative language markers extracted from user timelines, specifically standard negation rate, plural agreement rate, and vocabulary size.&lt;SEP&gt;Structural or phonetic points in language that permit multiple variants conveying identical reference but carrying distinct social significance.</data>
      <data key="d3">chunk-3d0343896fcb9bca626f6a9369daf5a8&lt;SEP&gt;chunk-5d4f8de99402c910c9db26d32af6e4a4</data>
    </node>
    <node id="Standard Language Variants">
      <data key="d0">Standard Language Variants</data>
      <data key="d1">category</data>
      <data key="d2">Linguistic forms associated with formality, educational attainment, social prestige, and higher socioeconomic status.&lt;SEP&gt;Standardized linguistic forms whose frequency of use was found to correlate with socioeconomic status, geography, and daily activity cycles.</data>
      <data key="d3">chunk-3d0343896fcb9bca626f6a9369daf5a8&lt;SEP&gt;chunk-50bb442ab9eb2bd0ac132636b603c20a</data>
    </node>
    <node id="Non-Standard Language Variants">
      <data key="d0">Non-Standard Language Variants</data>
      <data key="d1">category</data>
      <data key="d2">Vernacular linguistic forms associated with local solidarity, social bonding, and informal communication.</data>
      <data key="d3">chunk-3d0343896fcb9bca626f6a9369daf5a8</data>
    </node>
    <node id="Status Homophily">
      <data key="d0">Status Homophily</data>
      <data key="d1">category</data>
      <data key="d2">Status homophily is a sociological principle describing the tendency of individuals with similar socioeconomic status to associate and connect with one another.&lt;SEP&gt;Status homophily is the sociodynamic tendency for individuals with similar socioeconomic status to connect, interact, and form social ties.&lt;SEP&gt;Status homophily is the sociological phenomenon where individuals from similar socioeconomic classes tend to connect with one another in social networks.&lt;SEP&gt;The principle that people associate with others of similar socioeconomic status, evaluated in social network linguistic analyses.</data>
      <data key="d3">chunk-3d0343896fcb9bca626f6a9369daf5a8&lt;SEP&gt;chunk-5d4f8de99402c910c9db26d32af6e4a4&lt;SEP&gt;chunk-5be31c1a19a6e864780cdaa9c6a90013&lt;SEP&gt;chunk-50bb442ab9eb2bd0ac132636b603c20a</data>
    </node>
    <node id="Zillow.com">
      <data key="d0">Zillow.com</data>
      <data key="d1">organization</data>
      <data key="d2">Zillow.com is an online real estate service utilized in prior research to derive socioeconomic indicators to augment Twitter data.</data>
      <data key="d3">chunk-50bb442ab9eb2bd0ac132636b603c20a</data>
    </node>
    <node id="Socioeconomic Status">
      <data key="d0">Socioeconomic Status</data>
      <data key="d1">category</data>
      <data key="d2">A demographic classification based on metrics such as income, education level, and population density, examined for its correlation with language usage.&lt;SEP&gt;A metric and classification reflecting individuals' economic and social standing, measured through indicators such as income and population density.&lt;SEP&gt;Socioeconomic Status is a demographic categorization proxied by income, which strongly correlates with linguistic patterns and temporal Twitter activity.&lt;SEP&gt;Socioeconomic status (SES) is a composite measure of social and economic position, proxied through income, homeownership, and population density.&lt;SEP&gt;Socioeconomic status (SES) is a social classification metric that correlates with linguistic markers, temporal activity patterns, and social network clustering.&lt;SEP&gt;Socioeconomic status (SES) is an economic and sociological measure of an individual or population's standing, proxied in the study by income per capita, homeownership fraction, and population density.&lt;SEP&gt;Socioeconomic status is a demographic classification representing an individual's social and economic standing, inferred through indicators such as census data and location.&lt;SEP&gt;Socioeconomic status is a major demographic variable analyzed in the study to evaluate its relationship with sociolinguistic features.&lt;SEP&gt;Socioeconomic status refers to an individual's social and economic standing, inferred from income and used to partition users into socioeconomic classes.</data>
      <data key="d3">chunk-c12994d4fcd22c5f917023077969cdab&lt;SEP&gt;chunk-5be31c1a19a6e864780cdaa9c6a90013&lt;SEP&gt;chunk-dc455b4914b59090a3ce9d2a9448259b&lt;SEP&gt;chunk-5d4f8de99402c910c9db26d32af6e4a4&lt;SEP&gt;chunk-3ec2e699c363addb244b4be53103a6f0&lt;SEP&gt;chunk-50bb442ab9eb2bd0ac132636b603c20a&lt;SEP&gt;chunk-c32a5fa97db65bdeb1930b1f4e52c5ec&lt;SEP&gt;chunk-7fdcba40597c8aa146fec00068a7247f</data>
    </node>
    <node id="Standard Occupation Classification">
      <data key="d0">Standard Occupation Classification</data>
      <data key="d1">category</data>
      <data key="d2">The Standard Occupation Classification (SOC) is an occupational classification system used to assign socioeconomic status based on occupational mentions.</data>
      <data key="d3">chunk-50bb442ab9eb2bd0ac132636b603c20a</data>
    </node>
    <node id="Web Content Analysis">
      <data key="d0">Web Content Analysis</data>
      <data key="d1">category</data>
      <data key="d2">A subfield of computational research focused on evaluating text features, metrics, and language markers across online platforms.</data>
      <data key="d3">chunk-50bb442ab9eb2bd0ac132636b603c20a</data>
    </node>
    <node id="Multivariate Analysis">
      <data key="d0">Multivariate Analysis</data>
      <data key="d1">category</data>
      <data key="d2">A statistical methodology employed to analyze multiple variables simultaneously, identifying correlations among linguistic cues, socioeconomic status, and geography.</data>
      <data key="d3">chunk-50bb442ab9eb2bd0ac132636b603c20a</data>
    </node>
    <node id="Linear Regression">
      <data key="d0">Linear Regression</data>
      <data key="d1">category</data>
      <data key="d2">A statistical modeling approach used in the study to evaluate relationships between sociolinguistic variables and demographic factors.&lt;SEP&gt;Linear Regression is a fundamental statistical and supervised learning algorithm used for predictive modeling and sentiment analysis tasks.&lt;SEP&gt;Linear regression is a statistical modeling method used to perform regression analysis on the sociolinguistic dataset.</data>
      <data key="d3">chunk-dc455b4914b59090a3ce9d2a9448259b&lt;SEP&gt;chunk-50bb442ab9eb2bd0ac132636b603c20a&lt;SEP&gt;chunk-3194fa4581f2aaec823530e030775b2e</data>
    </node>
    <node id="Census Data">
      <data key="d0">Census Data</data>
      <data key="d1">category</data>
      <data key="d2">Census data provides official French population distributions across administrative units, used to validate inferred Twitter population distributions.&lt;SEP&gt;Official demographic and socioeconomic survey data collected by governments, combined with social media data to overcome user profile inaccuracies.</data>
      <data key="d3">chunk-dc455b4914b59090a3ce9d2a9448259b&lt;SEP&gt;chunk-50bb442ab9eb2bd0ac132636b603c20a</data>
    </node>
    <node id="Geolocation Metadata">
      <data key="d0">Geolocation Metadata</data>
      <data key="d1">category</data>
      <data key="d2">Geographic coordinate data embedded within social media posts, used by researchers to infer users' home locations.</data>
      <data key="d3">chunk-50bb442ab9eb2bd0ac132636b603c20a</data>
    </node>
    <node id="Lexical Diversity">
      <data key="d0">Lexical Diversity</data>
      <data key="d1">category</data>
      <data key="d2">A linguistic measure of vocabulary set size known to have a positive relationship with socioeconomic status.&lt;SEP&gt;A measure of vocabulary size and range used to evaluate language patterns across different geographic regions and socioeconomic groups.</data>
      <data key="d3">chunk-50bb442ab9eb2bd0ac132636b603c20a&lt;SEP&gt;chunk-c12994d4fcd22c5f917023077969cdab</data>
    </node>
    <node id="Datasift">
      <data key="d0">Datasift</data>
      <data key="d1">organization</data>
      <data key="d2">Datasift is a data provider company that provided access to Twitter PowerTrack API feeds for the research dataset.</data>
      <data key="d3">chunk-dc455b4914b59090a3ce9d2a9448259b</data>
    </node>
    <node id="Gnip">
      <data key="d0">Gnip</data>
      <data key="d1">organization</data>
      <data key="d2">Gnip is a social data provider company that provided Twitter PowerTrack API feeds for the study.</data>
      <data key="d3">chunk-dc455b4914b59090a3ce9d2a9448259b</data>
    </node>
    <node id="Social Network Analysis">
      <data key="d0">Social Network Analysis</data>
      <data key="d1">category</data>
      <data key="d2">Social Network Analysis refers to the methodology used to infer social ties, interactions, and user network structures from mutual mentions.</data>
      <data key="d3">chunk-dc455b4914b59090a3ce9d2a9448259b</data>
    </node>
    <node id="Scikit Learn Toolkit">
      <data key="d0">Scikit Learn Toolkit</data>
      <data key="d1">category</data>
      <data key="d2">The Scikit Learn Toolkit is a machine learning software library used in the study to perform linear regression analysis.</data>
      <data key="d3">chunk-dc455b4914b59090a3ce9d2a9448259b</data>
    </node>
    <node id="Pandas">
      <data key="d0">Pandas</data>
      <data key="d1">category</data>
      <data key="d2">Pandas is a Python data analysis library utilized for data preprocessing in the study.</data>
      <data key="d3">chunk-dc455b4914b59090a3ce9d2a9448259b</data>
    </node>
    <node id="NetworkX">
      <data key="d0">NetworkX</data>
      <data key="d1">category</data>
      <data key="d2">NetworkX is a Python software library used for graph analysis and studying social network structures.</data>
      <data key="d3">chunk-dc455b4914b59090a3ce9d2a9448259b</data>
    </node>
    <node id="MElt">
      <data key="d0">MElt</data>
      <data key="d1">category</data>
      <data key="d2">MElt is a part-of-speech (POS) tagger tested during data preprocessing for the detection of French linguistic markers.</data>
      <data key="d3">chunk-dc455b4914b59090a3ce9d2a9448259b</data>
    </node>
    <node id="French Language">
      <data key="d0">French Language</data>
      <data key="d1">category</data>
      <data key="d2">French is the language studied in the research, specifically focusing on the realization of the negative particle and standard versus non-standard variants.&lt;SEP&gt;The French language is the primary linguistic focus of the study, encompassing 170 million tweets analyzed for sociolinguistic variation.</data>
      <data key="d3">chunk-dc455b4914b59090a3ce9d2a9448259b&lt;SEP&gt;chunk-5be31c1a19a6e864780cdaa9c6a90013</data>
    </node>
    <node id="Geographic Location">
      <data key="d0">Geographic Location</data>
      <data key="d1">category</data>
      <data key="d2">Geographic location is a spatial variable determined via GPS coordinates and used to study spatial sociolinguistic patterns across France.</data>
      <data key="d3">chunk-dc455b4914b59090a3ce9d2a9448259b</data>
    </node>
    <node id="GMT">
      <data key="d0">GMT</data>
      <data key="d1">geo</data>
      <data key="d2">GMT (Greenwich Mean Time) is one of the two timezones defining the geographic and temporal boundaries for user data collection.</data>
      <data key="d3">chunk-dc455b4914b59090a3ce9d2a9448259b</data>
    </node>
    <node id="GMT+1">
      <data key="d0">GMT+1</data>
      <data key="d1">geo</data>
      <data key="d2">GMT+1 is the timezone covering France, used as a filter for selecting Twitter users in the study.</data>
      <data key="d3">chunk-dc455b4914b59090a3ce9d2a9448259b</data>
    </node>
    <node id="National Institute of Statistics and Economic Studies">
      <data key="d0">National Institute of Statistics and Economic Studies</data>
      <data key="d1">organization</data>
      <data key="d2">The National Institute of Statistics and Economic Studies (INSEE) is France's national statistics bureau, which released a fine-grained sociodemographic dataset in December 2016 based on 2010 tax returns.&lt;SEP&gt;The National Institute of Statistics and Economic Studies (INSEE) is the national statistics bureau of France that released a sociodemographic dataset in December 2016 based on 2010 tax returns.</data>
      <data key="d3">chunk-7fdcba40597c8aa146fec00068a7247f</data>
    </node>
    <node id="2010 French Tax Return">
      <data key="d0">2010 French Tax Return</data>
      <data key="d1">event</data>
      <data key="d2">The 2010 French tax return is a nationwide administrative tax data collection event used by INSEE to estimate aggregated sociodemographic indicators across France.&lt;SEP&gt;The 2010 nationwide tax return collection in France, which served as the empirical basis for INSEE's sociodemographic patch estimates.</data>
      <data key="d3">chunk-7fdcba40597c8aa146fec00068a7247f</data>
    </node>
    <node id="French Regions">
      <data key="d0">French Regions</data>
      <data key="d1">geo</data>
      <data key="d2">The 22 administrative regions of France used as a high-level spatial resolution unit to evaluate correlation between inferred and official population distributions.</data>
      <data key="d3">chunk-7fdcba40597c8aa146fec00068a7247f</data>
    </node>
    <node id="Arrondissements of France">
      <data key="d0">Arrondissements of France</data>
      <data key="d1">geo</data>
      <data key="d2">The 322 administrative arrondissement units across France used to assess population distribution correlation at an intermediate geographic level.</data>
      <data key="d3">chunk-7fdcba40597c8aa146fec00068a7247f</data>
    </node>
    <node id="Cantons of France">
      <data key="d0">Cantons of France</data>
      <data key="d1">geo</data>
      <data key="d2">The 4,055 canton-level administrative units across France representing a fine-grained spatial resolution in the population analysis.</data>
      <data key="d3">chunk-7fdcba40597c8aa146fec00068a7247f</data>
    </node>
    <node id="INSEE Dataset Release">
      <data key="d0">INSEE Dataset Release</data>
      <data key="d1">event</data>
      <data key="d2">The December 2016 public release by INSEE of aggregated 200m by 200m patch sociodemographic indicators for the whole French territory.</data>
      <data key="d3">chunk-7fdcba40597c8aa146fec00068a7247f</data>
    </node>
    <node id="Average Yearly Income Per Capita">
      <data key="d0">Average Yearly Income Per Capita</data>
      <data key="d1">category</data>
      <data key="d2">A socioeconomic indicator measured in euros representing cumulative household income divided by the total number of inhabitants within a 200m by 200m square patch.</data>
      <data key="d3">chunk-7fdcba40597c8aa146fec00068a7247f</data>
    </node>
    <node id="Real Estate Ownership Fraction">
      <data key="d0">Real Estate Ownership Fraction</data>
      <data key="d1">category</data>
      <data key="d2">A socioeconomic metric defined as the proportion of real estate owners relative to the total population living within a spatial patch.</data>
      <data key="d3">chunk-7fdcba40597c8aa146fec00068a7247f</data>
    </node>
    <node id="Population Density">
      <data key="d0">Population Density</data>
      <data key="d1">category</data>
      <data key="d2">A demographic indicator within the study whose lower values are consistently indicative of higher socioeconomic status.&lt;SEP&gt;A demographic metric defined as the number of individuals residing within a 200m by 200m (4-hectare) square patch.&lt;SEP&gt;A socioeconomic demographic indicator representing the concentration of individuals in a geographic area, transformed logarithmically for regression analysis.</data>
      <data key="d3">chunk-3ec2e699c363addb244b4be53103a6f0&lt;SEP&gt;chunk-c12994d4fcd22c5f917023077969cdab&lt;SEP&gt;chunk-7fdcba40597c8aa146fec00068a7247f</data>
    </node>
    <node id="Pareto Principle">
      <data key="d0">Pareto Principle</data>
      <data key="d1">category</data>
      <data key="d2">An economic distribution principle positing heavy-tailed inequality in wealth and socioeconomic variables, contrasted with the winzorized empirical indicators.</data>
      <data key="d3">chunk-7fdcba40597c8aa146fec00068a7247f</data>
    </node>
    <node id="INSEE">
      <data key="d0">INSEE</data>
      <data key="d1">organization</data>
      <data key="d2">INSEE (National Institute of Statistics and Economic Studies) is the French statistical agency that provides comprehensive socioeconomic census datasets used as a ground truth and benchmark in the study.&lt;SEP&gt;The French National Institute of Statistics and Economic Studies, referenced as the source for socioeconomic dataset features and population density metrics.&lt;SEP&gt;The National Institute of Statistics and Economic Studies in France, whose socioeconomic maps and indicators were linked to geolocated Twitter data.</data>
      <data key="d3">chunk-3ec2e699c363addb244b4be53103a6f0&lt;SEP&gt;chunk-c12994d4fcd22c5f917023077969cdab&lt;SEP&gt;chunk-5be31c1a19a6e864780cdaa9c6a90013</data>
    </node>
    <node id="French Metropolitan Territory">
      <data key="d0">French Metropolitan Territory</data>
      <data key="d1">geo</data>
      <data key="d2">The geographic territory of metropolitan France across which the study's dataset of geolocated Twitter users and socioeconomic maps were examined.</data>
      <data key="d3">chunk-c12994d4fcd22c5f917023077969cdab</data>
    </node>
    <node id="Standard Negation">
      <data key="d0">Standard Negation</data>
      <data key="d1">category</data>
      <data key="d2">A grammatical linguistic variable measuring adherence to standard versus incorrect negation forms in language usage.&lt;SEP&gt;A linguistic metric evaluating the adherence of users to formal grammatical negation rules across time and geographic departments.&lt;SEP&gt;A linguistic variable in French involving bipartite negation particles whose usage frequency correlates with socioeconomic status.&lt;SEP&gt;A specific linguistic variable measured from user timelines indicating the frequency or rate of using standard forms of grammatical negation.</data>
      <data key="d3">chunk-3ec2e699c363addb244b4be53103a6f0&lt;SEP&gt;chunk-c12994d4fcd22c5f917023077969cdab&lt;SEP&gt;chunk-c32a5fa97db65bdeb1930b1f4e52c5ec&lt;SEP&gt;chunk-5d4f8de99402c910c9db26d32af6e4a4</data>
    </node>
    <node id="Standard Plural Ending">
      <data key="d0">Standard Plural Ending</data>
      <data key="d1">category</data>
      <data key="d2">A written French linguistic variable regarding the use of mute plural markers ('s' or 'x'), studied for omission rates relative to social status.</data>
      <data key="d3">chunk-c12994d4fcd22c5f917023077969cdab</data>
    </node>
    <node id="Spoken French">
      <data key="d0">Spoken French</data>
      <data key="d1">category</data>
      <data key="d2">The oral variety of the French language characterized by features such as the optional omission of the preverbal negative particle 'ne' and the absence of phonetic plural endings on nouns and adjectives.</data>
      <data key="d3">chunk-c12994d4fcd22c5f917023077969cdab</data>
    </node>
    <node id="Written French">
      <data key="d0">Written French</data>
      <data key="d1">category</data>
      <data key="d2">The standard orthographic register of French where bipartite negation is obligatory and plural forms of nouns and adjectives are marked with letters such as 's' or 'x'.</data>
      <data key="d3">chunk-c12994d4fcd22c5f917023077969cdab</data>
    </node>
    <node id="SES Indicators">
      <data key="d0">SES Indicators</data>
      <data key="d1">category</data>
      <data key="d2">Statistical and demographic metrics, such as income and population density, used to measure and evaluate the socioeconomic status of individuals.</data>
      <data key="d3">chunk-c12994d4fcd22c5f917023077969cdab</data>
    </node>
    <node id="Income">
      <data key="d0">Income</data>
      <data key="d1">category</data>
      <data key="d2">An economic indicator analyzed alongside density and other socioeconomic factors to determine individual socioeconomic status.</data>
      <data key="d3">chunk-c12994d4fcd22c5f917023077969cdab</data>
    </node>
    <node id="Language Acquisition">
      <data key="d0">Language Acquisition</data>
      <data key="d1">category</data>
      <data key="d2">A scientific field studying the development of language in humans, demonstrating that child lexicon growth depends on the lexical diversity of caretakers.&lt;SEP&gt;The scientific field of linguistics and psychology studying how individuals acquire language, specifically noting that children's vocabulary growth depends on the lexical diversity of caretakers.</data>
      <data key="d3">chunk-3ec2e699c363addb244b4be53103a6f0&lt;SEP&gt;chunk-c12994d4fcd22c5f917023077969cdab</data>
    </node>
    <node id="Negation Deletion">
      <data key="d0">Negation Deletion</data>
      <data key="d1">category</data>
      <data key="d2">A sociolinguistic phenomenon in spoken French where the initial particle 'ne' is omitted from negative constructions.</data>
      <data key="d3">chunk-c12994d4fcd22c5f917023077969cdab</data>
    </node>
    <node id="Egocentric Social Network">
      <data key="d0">Egocentric Social Network</data>
      <data key="d1">category</data>
      <data key="d2">A network model constructed from users' direct Twitter mentions to map and analyze personal social interactions in relation to language and socioeconomic status.</data>
      <data key="d3">chunk-c12994d4fcd22c5f917023077969cdab</data>
    </node>
    <node id="Vocabulary Set Size">
      <data key="d0">Vocabulary Set Size</data>
      <data key="d1">category</data>
      <data key="d2">A linguistic marker measuring the breadth and quantity of distinct words utilized in an individual's Twitter timeline.&lt;SEP&gt;A metric representing lexical diversity, defined as the normalized number of unique words used by a user or population.&lt;SEP&gt;A static linguistic metric measuring the diversity and breadth of unique words used by speakers within a given administrative department.</data>
      <data key="d3">chunk-3ec2e699c363addb244b4be53103a6f0&lt;SEP&gt;chunk-c32a5fa97db65bdeb1930b1f4e52c5ec&lt;SEP&gt;chunk-5d4f8de99402c910c9db26d32af6e4a4</data>
    </node>
    <node id="Linguistic Variation">
      <data key="d0">Linguistic Variation</data>
      <data key="d1">category</data>
      <data key="d2">The phenomenon of language differences and standard or non-standard expression usage across socioeconomic levels, geographic locations, and social networks.</data>
      <data key="d3">chunk-3ec2e699c363addb244b4be53103a6f0</data>
    </node>
    <node id="Caretakers">
      <data key="d0">Caretakers</data>
      <data key="d1">category</data>
      <data key="d2">Individuals responsible for raising children whose socioeconomic status, educational level, and lexical diversity influence the lexicon growth of children.</data>
      <data key="d3">chunk-3ec2e699c363addb244b4be53103a6f0</data>
    </node>
    <node id="Plural Agreement">
      <data key="d0">Plural Agreement</data>
      <data key="d1">category</data>
      <data key="d2">A linguistic variable measuring the frequency and correctness of plural forms compared to non-standard or incorrect plural expressions.&lt;SEP&gt;A linguistic variable tracking the rate of correct or standard plural grammatical agreements used in user timelines.</data>
      <data key="d3">chunk-3ec2e699c363addb244b4be53103a6f0&lt;SEP&gt;chunk-5d4f8de99402c910c9db26d32af6e4a4</data>
    </node>
    <node id="Average Income">
      <data key="d0">Average Income</data>
      <data key="d1">category</data>
      <data key="d2">An economic indicator reflecting individual or group earnings, found to have the highest correlation with vocabulary set size.</data>
      <data key="d3">chunk-3ec2e699c363addb244b4be53103a6f0</data>
    </node>
    <node id="Education Level">
      <data key="d0">Education Level</data>
      <data key="d1">category</data>
      <data key="d2">A socioeconomic status indicator reflecting formal education, influencing lexical diversity and language usage.</data>
      <data key="d3">chunk-3ec2e699c363addb244b4be53103a6f0</data>
    </node>
    <node id="Departments Of France">
      <data key="d0">Departments Of France</data>
      <data key="d1">geo</data>
      <data key="d2">Administrative territorial divisions of France used to categorize geolocated users for studying regional and spatial linguistic variation.</data>
      <data key="d3">chunk-3ec2e699c363addb244b4be53103a6f0</data>
    </node>
    <node id="Socioeconomic Variation">
      <data key="d0">Socioeconomic Variation</data>
      <data key="d1">category</data>
      <data key="d2">The structural differences in language variants and linguistic competence observed across varying socioeconomic groups.</data>
      <data key="d3">chunk-3ec2e699c363addb244b4be53103a6f0</data>
    </node>
    <node id="Spatial Variation">
      <data key="d0">Spatial Variation</data>
      <data key="d1">category</data>
      <data key="d2">The geographic divergence of linguistic variables across regions caused by historical local dialects, socioeconomic factors, or cross-border influences.</data>
      <data key="d3">chunk-3ec2e699c363addb244b4be53103a6f0</data>
    </node>
    <node id="Standard Language Usage">
      <data key="d0">Standard Language Usage</data>
      <data key="d1">category</data>
      <data key="d2">Standard Language Usage is a linguistic classification reflecting adherence to formal grammar rules, such as standard negation and pluralization.</data>
      <data key="d3">chunk-c32a5fa97db65bdeb1930b1f4e52c5ec</data>
    </node>
    <node id="Linguistic Variability">
      <data key="d0">Linguistic Variability</data>
      <data key="d1">category</data>
      <data key="d2">Linguistic Variability is a research concept describing differences in vocabulary size, grammar standardization, and language usage across geographic, temporal, and social dimensions.</data>
      <data key="d3">chunk-c32a5fa97db65bdeb1930b1f4e52c5ec</data>
    </node>
    <node id="Suburban Paris">
      <data key="d0">Suburban Paris</data>
      <data key="d1">geo</data>
      <data key="d2">The suburban area of Paris marked by sharp socioeconomic segregation between its Eastern and Western sides, displaying linguistic patterns distinct from central Paris.</data>
      <data key="d3">chunk-c32a5fa97db65bdeb1930b1f4e52c5ec</data>
    </node>
    <node id="Standard Plural Agreement">
      <data key="d0">Standard Plural Agreement</data>
      <data key="d1">category</data>
      <data key="d2">A linguistic metric assessing the frequency of grammatically standard pluralization across regions, showing notable longitudinal variation.</data>
      <data key="d3">chunk-c32a5fa97db65bdeb1930b1f4e52c5ec</data>
    </node>
    <node id="Temporal Variation">
      <data key="d0">Temporal Variation</data>
      <data key="d1">category</data>
      <data key="d2">A study dimension examining the periodic hourly and weekly fluctuations in user activity, standard language usage, and socioeconomic demographics.</data>
      <data key="d3">chunk-c32a5fa97db65bdeb1930b1f4e52c5ec</data>
    </node>
    <node id="Social Network">
      <data key="d0">Social Network</data>
      <data key="d1">category</data>
      <data key="d2">Social network refers to the web of mutual mention ties and social interactions connecting individuals.&lt;SEP&gt;The structural arrangement of connected individuals that influences linguistic patterns through various link-formation dynamics.</data>
      <data key="d3">chunk-c32a5fa97db65bdeb1930b1f4e52c5ec&lt;SEP&gt;chunk-5d4f8de99402c910c9db26d32af6e4a4</data>
    </node>
    <node id="Homophily">
      <data key="d0">Homophily</data>
      <data key="d1">category</data>
      <data key="d2">A general social phenomenon where individuals with similar characteristics such as age, gender, interests, or socioeconomic status are more likely to form social connections.&lt;SEP&gt;A social network principle where individuals with similar characteristics such as age, gender, or interests form ties and influence one another.</data>
      <data key="d3">chunk-c32a5fa97db65bdeb1930b1f4e52c5ec&lt;SEP&gt;chunk-5d4f8de99402c910c9db26d32af6e4a4</data>
    </node>
    <node id="Preferential Attachment">
      <data key="d0">Preferential Attachment</data>
      <data key="d1">category</data>
      <data key="d2">A network formation mechanism driving the creation of social ties and community-rich complex structures.&lt;SEP&gt;A network growth mechanism where individuals preferentially form ties with already well-connected nodes, contributing to complex social network structures.</data>
      <data key="d3">chunk-c32a5fa97db65bdeb1930b1f4e52c5ec&lt;SEP&gt;chunk-5d4f8de99402c910c9db26d32af6e4a4</data>
    </node>
    <node id="Focal and Cyclic Closure">
      <data key="d0">Focal and Cyclic Closure</data>
      <data key="d1">category</data>
      <data key="d2">Structural link-creation mechanisms in social networks that foster the emergence of communities and clustered connections.</data>
      <data key="d3">chunk-c32a5fa97db65bdeb1930b1f4e52c5ec</data>
    </node>
    <node id="North">
      <data key="d0">North</data>
      <data key="d1">geo</data>
      <data key="d2">North refers to the northern region of France, where users were observed to use more non-standard linguistic terms and a smaller vocabulary set.</data>
      <data key="d3">chunk-5d4f8de99402c910c9db26d32af6e4a4</data>
    </node>
    <node id="South">
      <data key="d0">South</data>
      <data key="d1">geo</data>
      <data key="d2">South refers to the southern region of France, where users showed higher usage of standard language variants and larger vocabulary compared to the North.</data>
      <data key="d3">chunk-5d4f8de99402c910c9db26d32af6e4a4</data>
    </node>
    <node id="Social Influence">
      <data key="d0">Social Influence</data>
      <data key="d1">category</data>
      <data key="d2">The social process by which connected individuals induce behavioral, linguistic, or opinion similarities in one another over time.</data>
      <data key="d3">chunk-5d4f8de99402c910c9db26d32af6e4a4</data>
    </node>
    <node id="Twitter Mention Network">
      <data key="d0">Twitter Mention Network</data>
      <data key="d1">category</data>
      <data key="d2">A social network structure constructed from mutual mention interactions between geolocated Twitter users in France.&lt;SEP&gt;The empirical graph structure of interactions and mentions among Twitter users utilized to examine peer connectivity and status homophily.</data>
      <data key="d3">chunk-5d4f8de99402c910c9db26d32af6e4a4&lt;SEP&gt;chunk-5be31c1a19a6e864780cdaa9c6a90013</data>
    </node>
    <node id="Configuration Model">
      <data key="d0">Configuration Model</data>
      <data key="d1">category</data>
      <data key="d2">A reference random network model that preserves structural network degree properties while removing social and structural correlations.</data>
      <data key="d3">chunk-5d4f8de99402c910c9db26d32af6e4a4</data>
    </node>
    <node id="Temporal Activity">
      <data key="d0">Temporal Activity</data>
      <data key="d1">category</data>
      <data key="d2">The diurnal variation in user activity across day and night, affecting observed linguistic patterns due to population turnover.</data>
      <data key="d3">chunk-5d4f8de99402c910c9db26d32af6e4a4</data>
    </node>
    <node id="Physical Proximity">
      <data key="d0">Physical Proximity</data>
      <data key="d1">category</data>
      <data key="d2">The geographical closeness of individuals within a spatial area, acting as a contributing factor to social connection and linguistic similarity.</data>
      <data key="d3">chunk-5d4f8de99402c910c9db26d32af6e4a4</data>
    </node>
    <node id="Standard Language">
      <data key="d0">Standard Language</data>
      <data key="d1">category</data>
      <data key="d2">Standard language refers to conventional linguistic variants and vocabulary commonly associated with higher socioeconomic strata and daytime online activity.</data>
      <data key="d3">chunk-5be31c1a19a6e864780cdaa9c6a90013</data>
    </node>
    <node id="Non-Standard Language">
      <data key="d0">Non-Standard Language</data>
      <data key="d1">category</data>
      <data key="d2">Non-standard language refers to informal or vernacular linguistic variants and limited vocabulary sets, observed predominantly at night and among lower socioeconomic strata or regional groups.</data>
      <data key="d3">chunk-5be31c1a19a6e864780cdaa9c6a90013</data>
    </node>
    <node id="Negative Particle in French">
      <data key="d0">Negative Particle in French</data>
      <data key="d1">category</data>
      <data key="d2">A specific grammatical marker in the French language whose variable realization exhibits direct correlations with three distinct indices of socioeconomic status.</data>
      <data key="d3">chunk-5be31c1a19a6e864780cdaa9c6a90013</data>
    </node>
    <node id="Sample Survey of Geolocated Users">
      <data key="d0">Sample Survey of Geolocated Users</data>
      <data key="d1">event</data>
      <data key="d2">An empirical survey conducted on a set of geolocated Twitter users designed to bootstrap socioeconomic data and validate location and status inference models.</data>
      <data key="d3">chunk-5be31c1a19a6e864780cdaa9c6a90013</data>
    </node>
    <node id="Marketing Design">
      <data key="d0">Marketing Design</data>
      <data key="d1">category</data>
      <data key="d2">A commercial and strategic domain identified as a direct practical application for inferring individuals' socioeconomic status from online linguistic and network behaviors.</data>
      <data key="d3">chunk-5be31c1a19a6e864780cdaa9c6a90013</data>
    </node>
    <node id="OpenAI">
      <data key="d0">OpenAI</data>
      <data key="d1">organization</data>
      <data key="d2">OpenAI is an artificial intelligence research organization that developed OpenAI Gym, with which the HoME platform is compatible.&lt;SEP&gt;OpenAI is an artificial intelligence research organization that developed OpenAI Universe and the OpenAI Gym environment interface referenced for reinforcement learning compatibility.</data>
      <data key="d3">chunk-e6e4431e2ead79e10a12d16d49f4d480&lt;SEP&gt;chunk-a61fcfaa9d7ad4a6f8c3cbb5352049c7</data>
    </node>
    <node id="Household Multimodal Environment (HoME)">
      <data key="d0">Household Multimodal Environment (HoME)</data>
      <data key="d1">category</data>
      <data key="d2">HoME is an open-source, simulated 3D household platform designed for artificial agents to learn via multimodal inputs including vision, audio, semantics, and physical interaction.</data>
      <data key="d3">chunk-e6e4431e2ead79e10a12d16d49f4d480</data>
    </node>
    <node id="Virtual Embodiment">
      <data key="d0">Virtual Embodiment</data>
      <data key="d1">category</data>
      <data key="d2">Virtual embodiment is a machine learning paradigm in which artificial agents learn through dynamic, interactive, and multimodal sensory experiences within simulated environments.</data>
      <data key="d3">chunk-e6e4431e2ead79e10a12d16d49f4d480</data>
    </node>
    <node id="Socioeconomic Status (SES)">
      <data key="d0">Socioeconomic Status (SES)</data>
      <data key="d1">category</data>
      <data key="d2">Socioeconomic Status refers to the social and economic indicators, such as income and property ownership, studied for their correlation with linguistic variations.</data>
      <data key="d3">chunk-e6e4431e2ead79e10a12d16d49f4d480</data>
    </node>
    <node id="Linguistic Markers">
      <data key="d0">Linguistic Markers</data>
      <data key="d1">category</data>
      <data key="d2">Linguistic markers are grammatical and lexical variables, such as correct negation, plural usage, and vocabulary size, evaluated across user groups and regions.</data>
      <data key="d3">chunk-e6e4431e2ead79e10a12d16d49f4d480</data>
    </node>
    <node id="SUNCG Dataset">
      <data key="d0">SUNCG Dataset</data>
      <data key="d1">category</data>
      <data key="d2">The SUNCG dataset is a collection of over 45,000 3D house layouts integrated into the HoME platform to facilitate large-scale contextual learning.</data>
      <data key="d3">chunk-e6e4431e2ead79e10a12d16d49f4d480</data>
    </node>
    <node id="OpenAI Gym">
      <data key="d0">OpenAI Gym</data>
      <data key="d1">category</data>
      <data key="d2">OpenAI Gym is a standardized toolkit and interface for developing and comparing reinforcement learning algorithms, supported by HoME.</data>
      <data key="d3">chunk-e6e4431e2ead79e10a12d16d49f4d480</data>
    </node>
    <node id="Language Grounding">
      <data key="d0">Language Grounding</data>
      <data key="d1">category</data>
      <data key="d2">A category of artificial intelligence tasks involving mapping natural language descriptions to real-world contexts, objects, and spatial relationships.&lt;SEP&gt;Language grounding is an AI task involving the connection of linguistic symbols to multimodal sensory inputs, actions, and physical objects.</data>
      <data key="d3">chunk-e6e4431e2ead79e10a12d16d49f4d480&lt;SEP&gt;chunk-a61fcfaa9d7ad4a6f8c3cbb5352049c7</data>
    </node>
    <node id="Sound-Based Navigation">
      <data key="d0">Sound-Based Navigation</data>
      <data key="d1">category</data>
      <data key="d2">Sound-based navigation is an embodied agent task supported by HoME that requires agents to orient and navigate environments using acoustic perception.</data>
      <data key="d3">chunk-e6e4431e2ead79e10a12d16d49f4d480</data>
    </node>
    <node id="Robotics">
      <data key="d0">Robotics</data>
      <data key="d1">category</data>
      <data key="d2">Robotics is a field of artificial intelligence and engineering focused on embodied agents, where contextual simulation environments assist in improving reward quality and control.</data>
      <data key="d3">chunk-e6e4431e2ead79e10a12d16d49f4d480</data>
    </node>
    <node id="Multi-Agent Learning">
      <data key="d0">Multi-Agent Learning</data>
      <data key="d1">category</data>
      <data key="d2">Multi-agent learning is an artificial intelligence domain focused on training multiple agents simultaneously through interaction in a shared environment.</data>
      <data key="d3">chunk-e6e4431e2ead79e10a12d16d49f4d480</data>
    </node>
    <node id="Visual Question Answering">
      <data key="d0">Visual Question Answering</data>
      <data key="d1">category</data>
      <data key="d2">A multimodal machine learning task requiring models to answer textual questions grounded in visual imagery.&lt;SEP&gt;Visual question answering is a multimodal AI task requiring systems to process both visual imagery and natural language queries.</data>
      <data key="d3">chunk-f76f1c0c2ed37a786263a6a6d8b0bb6d&lt;SEP&gt;chunk-e6e4431e2ead79e10a12d16d49f4d480</data>
    </node>
    <node id="Atari Benchmark">
      <data key="d0">Atari Benchmark</data>
      <data key="d1">category</data>
      <data key="d2">The Atari benchmark comprises classic video games used in reinforcement learning to train agents on complex strategies via trial and error.</data>
      <data key="d3">chunk-e6e4431e2ead79e10a12d16d49f4d480</data>
    </node>
    <node id="Go">
      <data key="d0">Go</data>
      <data key="d1">category</data>
      <data key="d2">Go is a researcher who investigated keyword-based approaches and machine learning classifiers such as Maximum Entropy and Naive Bayes on Twitter sentiment.&lt;SEP&gt;Go is an abstract board game used in reinforcement learning to push agents to discover complex strategies through trial-and-error.</data>
      <data key="d3">chunk-e6e4431e2ead79e10a12d16d49f4d480&lt;SEP&gt;chunk-3194fa4581f2aaec823530e030775b2e</data>
    </node>
    <node id="Mention Network">
      <data key="d0">Mention Network</data>
      <data key="d1">category</data>
      <data key="d2">The mention network is a graph structure derived from Twitter user interactions that reflects socioeconomic correlations and community connectivity.</data>
      <data key="d3">chunk-e6e4431e2ead79e10a12d16d49f4d480</data>
    </node>
    <node id="Cognitive Science">
      <data key="d0">Cognitive Science</data>
      <data key="d1">category</data>
      <data key="d2">Cognitive science is an interdisciplinary field studying the mind and concept association, serving as inspiration for context-rich multimodal machine learning.</data>
      <data key="d3">chunk-e6e4431e2ead79e10a12d16d49f4d480</data>
    </node>
    <node id="DeepMind">
      <data key="d0">DeepMind</data>
      <data key="d1">organization</data>
      <data key="d2">DeepMind is an artificial intelligence research laboratory that created DeepMind Lab, a maze-based 3D environment for training learning algorithms.&lt;SEP&gt;DeepMind is an artificial intelligence research organization that developed DeepMind Lab, an interactive 3D platform benchmarked against HoME.</data>
      <data key="d3">chunk-a214a03aad6b4356ff5b17786166ad02&lt;SEP&gt;chunk-a61fcfaa9d7ad4a6f8c3cbb5352049c7</data>
    </node>
    <node id="Stanford">
      <data key="d0">Stanford</data>
      <data key="d1">organization</data>
      <data key="d2">Stanford is a research institution associated with the Stanford Scenes 3D layout dataset referenced in comparison to SUNCG.&lt;SEP&gt;The institution whose typed dependencies framework was extended to formalize realization rules from SPARQL queries.</data>
      <data key="d3">chunk-a0cfc66c51b34132fd3046873eac6d5f&lt;SEP&gt;chunk-a61fcfaa9d7ad4a6f8c3cbb5352049c7</data>
    </node>
    <node id="Household Environments">
      <data key="d0">Household Environments</data>
      <data key="d1">category</data>
      <data key="d2">A category of interactive 3D simulation platforms set within domestic indoor scenes, including HoME, House3D, AI2-THOR, and Matterport3D Simulator, used for embodied AI research.</data>
      <data key="d3">chunk-a61fcfaa9d7ad4a6f8c3cbb5352049c7</data>
    </node>
    <node id="Visual Navigation">
      <data key="d0">Visual Navigation</data>
      <data key="d1">category</data>
      <data key="d2">A category of embodied AI tasks focused on enabling autonomous agents to navigate through indoor spaces based on visual inputs.</data>
      <data key="d3">chunk-a61fcfaa9d7ad4a6f8c3cbb5352049c7</data>
    </node>
    <node id="Object Categories">
      <data key="d0">Object Categories</data>
      <data key="d1">category</data>
      <data key="d2">A semantic classification comprising generic and detailed item classifications present within SUNCG house layouts.</data>
      <data key="d3">chunk-a61fcfaa9d7ad4a6f8c3cbb5352049c7</data>
    </node>
    <node id="Material Categories">
      <data key="d0">Material Categories</data>
      <data key="d1">category</data>
      <data key="d2">A classification of physical textures and surface materials, such as wood or textile, that dictate visual rendering and acoustic properties.&lt;SEP&gt;Material Categories is a set of 20 surface texture classifications, including wood and textile, determined by object surface area in HoME.</data>
      <data key="d3">chunk-a214a03aad6b4356ff5b17786166ad02&lt;SEP&gt;chunk-a61fcfaa9d7ad4a6f8c3cbb5352049c7</data>
    </node>
    <node id="AI Community">
      <data key="d0">AI Community</data>
      <data key="d1">organization</data>
      <data key="d2">The collective global network of researchers and developers working on algorithmic advances, benchmarks, and artificial intelligence simulation environments.</data>
      <data key="d3">chunk-a61fcfaa9d7ad4a6f8c3cbb5352049c7</data>
    </node>
    <node id="Blind Navigation">
      <data key="d0">Blind Navigation</data>
      <data key="d1">category</data>
      <data key="d2">A navigational task category where an agent learns to navigate an environment without visual observation, relying on non-visual modalities such as acoustics.</data>
      <data key="d3">chunk-a61fcfaa9d7ad4a6f8c3cbb5352049c7</data>
    </node>
    <node id="Planning">
      <data key="d0">Planning</data>
      <data key="d1">category</data>
      <data key="d2">An artificial intelligence category focusing on deliberative sequence-of-action generation to achieve predefined goals within an environment.</data>
      <data key="d3">chunk-a61fcfaa9d7ad4a6f8c3cbb5352049c7</data>
    </node>
    <node id="3D Sandboxes">
      <data key="d0">3D Sandboxes</data>
      <data key="d1">category</data>
      <data key="d2">A category of interactive 3D simulation platforms designed to support the development, benchmarking, and training of learning algorithms.</data>
      <data key="d3">chunk-a61fcfaa9d7ad4a6f8c3cbb5352049c7</data>
    </node>
    <node id="Multimodal Learning">
      <data key="d0">Multimodal Learning</data>
      <data key="d1">category</data>
      <data key="d2">A category of machine learning tasks and algorithms that process and integrate multiple sensory data streams, such as audio, vision, and language.</data>
      <data key="d3">chunk-a61fcfaa9d7ad4a6f8c3cbb5352049c7</data>
    </node>
    <node id="Embodied Learning">
      <data key="d0">Embodied Learning</data>
      <data key="d1">category</data>
      <data key="d2">A paradigm of artificial intelligence where virtual agents learn through physical or simulated interaction within realistic spatial environments.</data>
      <data key="d3">chunk-a61fcfaa9d7ad4a6f8c3cbb5352049c7</data>
    </node>
    <node id="Room Types">
      <data key="d0">Room Types</data>
      <data key="d1">category</data>
      <data key="d2">A categorical classification of indoor functional spaces, representing 24 distinct room styles found within domestic house datasets.</data>
      <data key="d3">chunk-a61fcfaa9d7ad4a6f8c3cbb5352049c7</data>
    </node>
    <node id="Color Categories">
      <data key="d0">Color Categories</data>
      <data key="d1">category</data>
      <data key="d2">A semantic category system discretizing object textures into basic, intermediate, and detailed color classifications.</data>
      <data key="d3">chunk-a61fcfaa9d7ad4a6f8c3cbb5352049c7</data>
    </node>
    <node id="Size Categories">
      <data key="d0">Size Categories</data>
      <data key="d1">category</data>
      <data key="d2">A categorical distribution classifying objects into discrete scales such as small, medium, or large based on 3D mesh volume.&lt;SEP&gt;Size Categories is a qualitative categorization classifying objects into small, medium, or large based on mesh volume histograms.</data>
      <data key="d3">chunk-a214a03aad6b4356ff5b17786166ad02&lt;SEP&gt;chunk-a61fcfaa9d7ad4a6f8c3cbb5352049c7</data>
    </node>
    <node id="Simulation-to-Real Transfer">
      <data key="d0">Simulation-to-Real Transfer</data>
      <data key="d1">category</data>
      <data key="d2">A category of machine learning methods focused on adapting models trained within virtual simulators to real-world applications.</data>
      <data key="d3">chunk-a61fcfaa9d7ad4a6f8c3cbb5352049c7</data>
    </node>
    <node id="MILA">
      <data key="d0">MILA</data>
      <data key="d1">organization</data>
      <data key="d2">MILA is an artificial intelligence research institute that provided a collaborative research environment for the HoME project.</data>
      <data key="d3">chunk-a214a03aad6b4356ff5b17786166ad02</data>
    </node>
    <node id="CIFAR">
      <data key="d0">CIFAR</data>
      <data key="d1">organization</data>
      <data key="d2">CIFAR (Canadian Institute for Advanced Research) is a research organization that provided funding and support for the research.</data>
      <data key="d3">chunk-a214a03aad6b4356ff5b17786166ad02</data>
    </node>
    <node id="CHISTERA IGLU">
      <data key="d0">CHISTERA IGLU</data>
      <data key="d1">organization</data>
      <data key="d2">CHISTERA IGLU is a research funding programme/consortium that supported the research project.</data>
      <data key="d3">chunk-a214a03aad6b4356ff5b17786166ad02</data>
    </node>
    <node id="Calcul Québec">
      <data key="d0">Calcul Québec</data>
      <data key="d1">organization</data>
      <data key="d2">Calcul Québec is a high-performance computing organization that provided computational resources for the research.</data>
      <data key="d3">chunk-a214a03aad6b4356ff5b17786166ad02</data>
    </node>
    <node id="Compute Canada">
      <data key="d0">Compute Canada</data>
      <data key="d1">organization</data>
      <data key="d2">Compute Canada is an organization providing advanced research computing infrastructure and support for the project.</data>
      <data key="d3">chunk-a214a03aad6b4356ff5b17786166ad02</data>
    </node>
    <node id="Acronymcreator.net">
      <data key="d0">Acronymcreator.net</data>
      <data key="d1">organization</data>
      <data key="d2">Acronymcreator.net is an online service credited for generating the HoME acronym.</data>
      <data key="d3">chunk-a214a03aad6b4356ff5b17786166ad02</data>
    </node>
    <node id="Nord-Pas de Calais">
      <data key="d0">Nord-Pas de Calais</data>
      <data key="d1">geo</data>
      <data key="d2">Nord-Pas de Calais is a region in France associated with the CPER/FEDER research project funding.</data>
      <data key="d3">chunk-a214a03aad6b4356ff5b17786166ad02</data>
    </node>
    <node id="Slavic Languages">
      <data key="d0">Slavic Languages</data>
      <data key="d1">category</data>
      <data key="d2">A branch of Indo-European languages including Polish and Czech, characterized in the study by high morphological generalization and smaller nominal paradigms.&lt;SEP&gt;A genealogical language family including Polish, Czech, Russian, Slovak, and Ukrainian, examined for morphological mapping and bilingual lexicon induction.&lt;SEP&gt;A major European language family containing Polish and Czech, analyzed through morphologically complete dictionaries in the study.&lt;SEP&gt;Slavic Languages is a linguistic group analyzed in the bilingual lexicon induction experiments to evaluate performance on highly inflectional systems.&lt;SEP&gt;Slavic languages are a branch of Indo-European languages sharing common ancestry, demonstrating linguistic relatedness.&lt;SEP&gt;The Slavic language family consists of genetically-related languages including Polish, Czech, Russian, Slovak, and Ukrainian, selected for evaluating morphological generalization in BLI models.</data>
      <data key="d3">chunk-0ca3ab8f8c0dca0a40d79a8ee4226255&lt;SEP&gt;chunk-874a0fecf572a7885d7353d9aa510123&lt;SEP&gt;chunk-a214a03aad6b4356ff5b17786166ad02&lt;SEP&gt;chunk-9896f0582e2237c4a0dd8169f6817110&lt;SEP&gt;chunk-00381e9f572e2f4c1655790b19b827fd&lt;SEP&gt;chunk-a857415cf32d5d04b955b0da8d697209</data>
    </node>
    <node id="Indo-Aryan Languages">
      <data key="d0">Indo-Aryan Languages</data>
      <data key="d1">category</data>
      <data key="d2">A branch of the Indo-European language family represented in the study by languages such as Hindi, Bengali, Punjabi, and Urdu.&lt;SEP&gt;Indo-Aryan languages are a language family sharing common ancestry, exemplifying languages with high lexical and structural similarities.</data>
      <data key="d3">chunk-a214a03aad6b4356ff5b17786166ad02&lt;SEP&gt;chunk-5cf9480461a20dfddfe7c1ed32cfa07c</data>
    </node>
    <node id="Indian Subcontinent">
      <data key="d0">Indian Subcontinent</data>
      <data key="d1">geo</data>
      <data key="d2">The Indian subcontinent is a geographic region identified as a linguistic area where prolonged language contact led to convergence of linguistic properties.</data>
      <data key="d3">chunk-a214a03aad6b4356ff5b17786166ad02</data>
    </node>
    <node id="Balkan">
      <data key="d0">Balkan</data>
      <data key="d1">geo</data>
      <data key="d2">The Balkan is a geographic region forming a linguistic area characterized by language contact and convergence.</data>
      <data key="d3">chunk-a214a03aad6b4356ff5b17786166ad02</data>
    </node>
    <node id="South-East Asia">
      <data key="d0">South-East Asia</data>
      <data key="d1">geo</data>
      <data key="d2">South-East Asia is a geographic region featuring prominent cultural and communication ties among speakers of related languages.</data>
      <data key="d3">chunk-a214a03aad6b4356ff5b17786166ad02</data>
    </node>
    <node id="FEDER">
      <data key="d0">FEDER</data>
      <data key="d1">organization</data>
      <data key="d2">FEDER (European Regional Development Fund) is a European institutional funding body that supported advanced data science and technology research.</data>
      <data key="d3">chunk-a214a03aad6b4356ff5b17786166ad02</data>
    </node>
    <node id="CPER">
      <data key="d0">CPER</data>
      <data key="d1">organization</data>
      <data key="d2">CPER (Contrat de Plan État-Région) is an institutional planning and funding framework in France that supported the research through the Nord-Pas de Calais program.</data>
      <data key="d3">chunk-a214a03aad6b4356ff5b17786166ad02</data>
    </node>
    <node id="Standard Average European">
      <data key="d0">Standard Average European</data>
      <data key="d1">geo</data>
      <data key="d2">Standard Average European is a recognized linguistic area in Europe where sustained contact resulted in convergent linguistic and structural features across multiple languages.</data>
      <data key="d3">chunk-a214a03aad6b4356ff5b17786166ad02</data>
    </node>
    <node id="Object Semantic Categories">
      <data key="d0">Object Semantic Categories</data>
      <data key="d1">category</data>
      <data key="d2">Object Semantic Categories are the 187 fine-grained object classes derived from SUNCG (such as bathtub, wall, armchair, accordion, and xbox) used for semantic scene representation in HoME.</data>
      <data key="d3">chunk-a214a03aad6b4356ff5b17786166ad02</data>
    </node>
    <node id="Related Languages">
      <data key="d0">Related Languages</data>
      <data key="d1">category</data>
      <data key="d2">A linguistic classification of languages sharing high lexical similarity, cognates, and lateral borrowings but often lacking parallel training corpora.&lt;SEP&gt;Related Languages is a linguistic classification of languages that exhibit lexical and structural similarities due to shared genetic ancestry or prolonged contact.</data>
      <data key="d3">chunk-a214a03aad6b4356ff5b17786166ad02&lt;SEP&gt;chunk-ffaa7abbd8709e94a9523e6b922ac96b</data>
    </node>
    <node id="Writing Systems">
      <data key="d0">Writing Systems</data>
      <data key="d1">category</data>
      <data key="d2">Writing Systems are graphical systems for representing verbal communication, categorized into vowel-based orthographies and non-vowel systems.</data>
      <data key="d3">chunk-a214a03aad6b4356ff5b17786166ad02</data>
    </node>
    <node id="Lingua Franca">
      <data key="d0">Lingua Franca</data>
      <data key="d1">category</data>
      <data key="d2">Lingua Franca is a category representing bridge languages adopted for common communication between speakers of different native tongues, exemplified by English.</data>
      <data key="d3">chunk-a214a03aad6b4356ff5b17786166ad02</data>
    </node>
    <node id="Kunchukuttan">
      <data key="d0">Kunchukuttan</data>
      <data key="d1">person</data>
      <data key="d2">A researcher who described a method for mapping characters across Indic scripts, which was implemented in the Indic NLP Library.&lt;SEP&gt;A researcher who proposed orthographic syllables as a linguistically-motivated variable-length unit for machine translation between related languages.&lt;SEP&gt;Kunchukuttan is a researcher cited for demonstrating that orthographic syllable-level translation models are robust against domain changes.</data>
      <data key="d3">chunk-5cf9480461a20dfddfe7c1ed32cfa07c&lt;SEP&gt;chunk-ffaa7abbd8709e94a9523e6b922ac96b&lt;SEP&gt;chunk-acd45458d7c3c63e9891f23252405a17</data>
    </node>
    <node id="Orthographic Syllables">
      <data key="d0">Orthographic Syllables</data>
      <data key="d1">category</data>
      <data key="d2">A linguistic unit representation previously used in machine translation experiments, compared directly against Byte Pair Encoding.&lt;SEP&gt;A linguistically motivated variable-length subword unit approximating a syllable, used as a benchmark unit in machine translation.&lt;SEP&gt;A rule-based linguistic subword translation unit consisting of consonant-vowel sequences.&lt;SEP&gt;A subword representation unit based on orthographic syllabification rules, compared against Byte Pair Encoding across different writing systems.&lt;SEP&gt;Orthographic Syllables (OS) are subword translation units whose effectiveness is limited to writing systems that explicitly represent vowels.</data>
      <data key="d3">chunk-ea126b0da9c38f85b697b36cd33629f5&lt;SEP&gt;chunk-ba3fa25c5e29c7ea3201eac4d5fbec61&lt;SEP&gt;chunk-acd45458d7c3c63e9891f23252405a17&lt;SEP&gt;chunk-5cf9480461a20dfddfe7c1ed32cfa07c&lt;SEP&gt;chunk-ffaa7abbd8709e94a9523e6b922ac96b</data>
    </node>
    <node id="Subword Units">
      <data key="d0">Subword Units</data>
      <data key="d1">category</data>
      <data key="d2">Basic units of translation below the word level, including morphemes, syllables, character n-grams, and BPE units, designed to exploit lexical similarity.</data>
      <data key="d3">chunk-ffaa7abbd8709e94a9523e6b922ac96b</data>
    </node>
    <node id="Transliteration">
      <data key="d0">Transliteration</data>
      <data key="d1">category</data>
      <data key="d2">A technique of converting source language words into target language scripts, used for handling named entities and untranslated words.</data>
      <data key="d3">chunk-ffaa7abbd8709e94a9523e6b922ac96b</data>
    </node>
    <node id="Hindi">
      <data key="d0">Hindi</data>
      <data key="d1">category</data>
      <data key="d2">An Indo-Aryan language examined in translation experiments, sharing high lexical similarity with Urdu.&lt;SEP&gt;An Indo-Aryan language used as an example of lexical similarity in cognate and shared word forms with related languages like Marathi.&lt;SEP&gt;Hindi is an Indo-Aryan language examined in cross-lingual contact and translation pairs with Malayalam.</data>
      <data key="d3">chunk-ba3fa25c5e29c7ea3201eac4d5fbec61&lt;SEP&gt;chunk-ffaa7abbd8709e94a9523e6b922ac96b&lt;SEP&gt;chunk-acd45458d7c3c63e9891f23252405a17</data>
    </node>
    <node id="Marathi">
      <data key="d0">Marathi</data>
      <data key="d1">category</data>
      <data key="d2">An Indo-Aryan language exhibiting lexical similarity and shared cognates with Hindi.&lt;SEP&gt;Marathi is an Indo-Aryan language evaluated in translation pairs with Konkani.</data>
      <data key="d3">chunk-ffaa7abbd8709e94a9523e6b922ac96b&lt;SEP&gt;chunk-acd45458d7c3c63e9891f23252405a17</data>
    </node>
    <node id="Parallel Corpora">
      <data key="d0">Parallel Corpora</data>
      <data key="d1">category</data>
      <data key="d2">Text datasets containing aligned source and target language translations, noted as being scarce for most related languages.</data>
      <data key="d3">chunk-ffaa7abbd8709e94a9523e6b922ac96b</data>
    </node>
    <node id="Lexical Similarity">
      <data key="d0">Lexical Similarity</data>
      <data key="d1">category</data>
      <data key="d2">A linguistic metric assessing the degree of shared vocabulary and cognates between source and target language pairs.&lt;SEP&gt;An evaluation category reflecting surface-level word and token overlap between model predictions and gold standard references.&lt;SEP&gt;The linguistic property whereby related languages share words with similar orthographic or phonetic forms and meanings.</data>
      <data key="d3">chunk-24fec6e6dba96ab2ffdd4b5fac402b39&lt;SEP&gt;chunk-ffaa7abbd8709e94a9523e6b922ac96b&lt;SEP&gt;chunk-ea126b0da9c38f85b697b36cd33629f5</data>
    </node>
    <node id="Cognates">
      <data key="d0">Cognates</data>
      <data key="d1">category</data>
      <data key="d2">Words in related languages that share a common origin and similar form and meaning, critical for subword-level machine translation.</data>
      <data key="d3">chunk-ffaa7abbd8709e94a9523e6b922ac96b</data>
    </node>
    <node id="Character N-gram">
      <data key="d0">Character N-gram</data>
      <data key="d1">category</data>
      <data key="d2">A subword unit choice based on fixed-length character sequences, which suffers from data sparsity when applied at higher orders.</data>
      <data key="d3">chunk-ffaa7abbd8709e94a9523e6b922ac96b</data>
    </node>
    <node id="Wordpieces">
      <data key="d0">Wordpieces</data>
      <data key="d1">category</data>
      <data key="d2">A data-driven subword segmentation unit proposed for neural machine translation architectures.</data>
      <data key="d3">chunk-ffaa7abbd8709e94a9523e6b922ac96b</data>
    </node>
    <node id="Huffman Encoding">
      <data key="d0">Huffman Encoding</data>
      <data key="d1">category</data>
      <data key="d2">A data compression method whose principles have been applied to derive subword units for neural machine translation.</data>
      <data key="d3">chunk-ffaa7abbd8709e94a9523e6b922ac96b</data>
    </node>
    <node id="Bulgarian-Macedonian">
      <data key="d0">Bulgarian-Macedonian</data>
      <data key="d1">category</data>
      <data key="d2">A pair of closely related Slavic languages previously studied in character-level statistical machine translation.</data>
      <data key="d3">chunk-ffaa7abbd8709e94a9523e6b922ac96b</data>
    </node>
    <node id="Indonesian-Malay">
      <data key="d0">Indonesian-Malay</data>
      <data key="d1">category</data>
      <data key="d2">A pair of closely related Austronesian languages previously evaluated using character-level translation models.</data>
      <data key="d3">chunk-ffaa7abbd8709e94a9523e6b922ac96b</data>
    </node>
    <node id="Spanish-Catalan">
      <data key="d0">Spanish-Catalan</data>
      <data key="d1">category</data>
      <data key="d2">A pair of closely related Romance languages evaluated in character-level statistical machine translation research.</data>
      <data key="d3">chunk-ffaa7abbd8709e94a9523e6b922ac96b</data>
    </node>
    <node id="Character-Level SMT">
      <data key="d0">Character-Level SMT</data>
      <data key="d1">category</data>
      <data key="d2">A statistical machine translation approach using individual characters as basic translation units.</data>
      <data key="d3">chunk-ffaa7abbd8709e94a9523e6b922ac96b</data>
    </node>
    <node id="Indo-Aryan">
      <data key="d0">Indo-Aryan</data>
      <data key="d1">category</data>
      <data key="d2">A subgroup of the Indo-European language family examined in the translation experiments.</data>
      <data key="d3">chunk-ba3fa25c5e29c7ea3201eac4d5fbec61</data>
    </node>
    <node id="Slavic">
      <data key="d0">Slavic</data>
      <data key="d1">category</data>
      <data key="d2">A subgroup of the Indo-European language family examined in the translation experiments.</data>
      <data key="d3">chunk-ba3fa25c5e29c7ea3201eac4d5fbec61</data>
    </node>
    <node id="Germanic">
      <data key="d0">Germanic</data>
      <data key="d1">category</data>
      <data key="d2">A subgroup of the Indo-European language family examined in the translation experiments.</data>
      <data key="d3">chunk-ba3fa25c5e29c7ea3201eac4d5fbec61</data>
    </node>
    <node id="Altaic">
      <data key="d0">Altaic</data>
      <data key="d1">category</data>
      <data key="d2">A language family grouping used in the study to denote the relationship between Japanese and Korean.</data>
      <data key="d3">chunk-ba3fa25c5e29c7ea3201eac4d5fbec61</data>
    </node>
    <node id="Japanese">
      <data key="d0">Japanese</data>
      <data key="d1">category</data>
      <data key="d2">A language evaluated in the translation experiments, noted for lexical and grammatical similarities with Korean.&lt;SEP&gt;Japanese is a language employing the logographic Kanji script, studied in translation tasks with Korean.</data>
      <data key="d3">chunk-ba3fa25c5e29c7ea3201eac4d5fbec61&lt;SEP&gt;chunk-acd45458d7c3c63e9891f23252405a17</data>
    </node>
    <node id="Korean">
      <data key="d0">Korean</data>
      <data key="d1">category</data>
      <data key="d2">A language evaluated in the translation experiments, noted for lexical and grammatical similarities with Japanese.&lt;SEP&gt;Korean is a language utilizing the syllabic Hangul script, examined in machine translation alongside Japanese.&lt;SEP&gt;Korean is a natural language for which a structured annotation scheme and lexicon ordering were established in the described dataset.&lt;SEP&gt;The Korean linguistic environment and agglutinative language in which diverse argument expressions, phrases, and morphological tokenization were performed.</data>
      <data key="d3">chunk-3d0d62f131549ff6e8a1545f667c733a&lt;SEP&gt;chunk-ba3fa25c5e29c7ea3201eac4d5fbec61&lt;SEP&gt;chunk-5fa79759ff02333ae3d3a1d802134a1f&lt;SEP&gt;chunk-acd45458d7c3c63e9891f23252405a17</data>
    </node>
    <node id="Malayalam">
      <data key="d0">Malayalam</data>
      <data key="d1">category</data>
      <data key="d2">A language examined in translation experiments and compared with Hindi despite belonging to a different language family.&lt;SEP&gt;Malayalam is a morphologically rich Dravidian language evaluated in translation experiments with Hindi, Telugu, and Tamil.</data>
      <data key="d3">chunk-ba3fa25c5e29c7ea3201eac4d5fbec61&lt;SEP&gt;chunk-acd45458d7c3c63e9891f23252405a17</data>
    </node>
    <node id="Macedonian">
      <data key="d0">Macedonian</data>
      <data key="d1">category</data>
      <data key="d2">A Slavic language exhibiting high lexical similarity with Bulgarian.</data>
      <data key="d3">chunk-ba3fa25c5e29c7ea3201eac4d5fbec61</data>
    </node>
    <node id="Bulgarian">
      <data key="d0">Bulgarian</data>
      <data key="d1">category</data>
      <data key="d2">A Slavic language exhibiting high lexical similarity with Macedonian.</data>
      <data key="d3">chunk-ba3fa25c5e29c7ea3201eac4d5fbec61</data>
    </node>
    <node id="Phrase-Based Statistical Machine Translation">
      <data key="d0">Phrase-Based Statistical Machine Translation</data>
      <data key="d1">category</data>
      <data key="d2">A statistical machine translation paradigm (PBSMT) trained at subword, morpheme, and orthographic syllable levels.&lt;SEP&gt;A subfield of statistical machine translation that models translations of word sequences rather than single words, evaluated as a baseline system in the study.&lt;SEP&gt;Phrase-Based Statistical Machine Translation is a translation framework combined with unsupervised word segmentation in previous Southern African language studies.</data>
      <data key="d3">chunk-ddef736560bcb899db81b75205f4df60&lt;SEP&gt;chunk-116526d304daa442dbc1df519e7f8fc5&lt;SEP&gt;chunk-ba3fa25c5e29c7ea3201eac4d5fbec61</data>
    </node>
    <node id="Character N-grams">
      <data key="d0">Character N-grams</data>
      <data key="d1">category</data>
      <data key="d2">Variable or fixed-length character sequences compared against BPE and orthographic syllables in machine translation context.</data>
      <data key="d3">chunk-ba3fa25c5e29c7ea3201eac4d5fbec61</data>
    </node>
    <node id="Morpheme">
      <data key="d0">Morpheme</data>
      <data key="d1">category</data>
      <data key="d2">A minimal linguistic unit used as a comparison unit and translation segmentation level in PBSMT models.</data>
      <data key="d3">chunk-ba3fa25c5e29c7ea3201eac4d5fbec61</data>
    </node>
    <node id="Alphabetic Writing System">
      <data key="d0">Alphabetic Writing System</data>
      <data key="d1">category</data>
      <data key="d2">A category of writing systems where vowels and consonants are represented by distinct letters.&lt;SEP&gt;A type of writing system that explicitly represents vowels, suitable for rule-based orthographic syllabification.</data>
      <data key="d3">chunk-5cf9480461a20dfddfe7c1ed32cfa07c&lt;SEP&gt;chunk-ba3fa25c5e29c7ea3201eac4d5fbec61</data>
    </node>
    <node id="Abugida Writing System">
      <data key="d0">Abugida Writing System</data>
      <data key="d1">category</data>
      <data key="d2">A category of writing systems where consonant-vowel sequences are written as a unit, and vowels are represented.&lt;SEP&gt;A segmental writing system representing vowels, applicable for orthographic syllabification.</data>
      <data key="d3">chunk-5cf9480461a20dfddfe7c1ed32cfa07c&lt;SEP&gt;chunk-ba3fa25c5e29c7ea3201eac4d5fbec61</data>
    </node>
    <node id="Abjad Writing System">
      <data key="d0">Abjad Writing System</data>
      <data key="d1">category</data>
      <data key="d2">A category of writing systems where vowels are largely omitted or optional, as observed in scripts like Urdu.&lt;SEP&gt;A writing system where the representation of vowels is optional, exemplified by scripts like Urdu.</data>
      <data key="d3">chunk-5cf9480461a20dfddfe7c1ed32cfa07c&lt;SEP&gt;chunk-ba3fa25c5e29c7ea3201eac4d5fbec61</data>
    </node>
    <node id="Logographic Writing System">
      <data key="d0">Logographic Writing System</data>
      <data key="d1">category</data>
      <data key="d2">A category of writing systems that represent words or morphemes rather than individual phonetic sounds, lacking explicit vowel representations.&lt;SEP&gt;A type of writing system in which characters do not represent vowels directly.</data>
      <data key="d3">chunk-5cf9480461a20dfddfe7c1ed32cfa07c&lt;SEP&gt;chunk-ba3fa25c5e29c7ea3201eac4d5fbec61</data>
    </node>
    <node id="Longest Common Subsequence Ratio">
      <data key="d0">Longest Common Subsequence Ratio</data>
      <data key="d1">category</data>
      <data key="d2">A metric (LCSR) computed at character level across parallel training sentences to quantify lexical similarity between language pairs.</data>
      <data key="d3">chunk-ba3fa25c5e29c7ea3201eac4d5fbec61</data>
    </node>
    <node id="Indian Language Corpora Initiative">
      <data key="d0">Indian Language Corpora Initiative</data>
      <data key="d1">organization</data>
      <data key="d2">The Indian Language Corpora Initiative (ILCI) is a multilingual initiative that developed parallel corpora for Indian languages, covering Indo-Aryan and Dravidian language families.</data>
      <data key="d3">chunk-5cf9480461a20dfddfe7c1ed32cfa07c</data>
    </node>
    <node id="Dravidian Languages">
      <data key="d0">Dravidian Languages</data>
      <data key="d1">category</data>
      <data key="d2">A major language family spoken predominantly in South Asia, including morphologically rich languages such as Malayalam, Tamil, and Telugu.</data>
      <data key="d3">chunk-5cf9480461a20dfddfe7c1ed32cfa07c</data>
    </node>
    <node id="Syllabic Writing System">
      <data key="d0">Syllabic Writing System</data>
      <data key="d1">category</data>
      <data key="d2">A category of writing systems in which each symbol represents a syllable, exemplified by the Korean Hangul system where vowels are implicitly embedded in character blocks.</data>
      <data key="d3">chunk-5cf9480461a20dfddfe7c1ed32cfa07c</data>
    </node>
    <node id="Korean Hangul">
      <data key="d0">Korean Hangul</data>
      <data key="d1">category</data>
      <data key="d2">A syllabic writing system used for the Korean language in which consonant and vowel elements are combined into syllabic blocks.</data>
      <data key="d3">chunk-5cf9480461a20dfddfe7c1ed32cfa07c</data>
    </node>
    <node id="Indic Scripts">
      <data key="d0">Indic Scripts</data>
      <data key="d1">category</data>
      <data key="d2">A family of writing systems used across the Indian subcontinent that share structural characteristics and can be mapped across one another.&lt;SEP&gt;Indic scripts are abugida writing systems that permit one-to-one character mappings for joint bilingual BPE models.</data>
      <data key="d3">chunk-5cf9480461a20dfddfe7c1ed32cfa07c&lt;SEP&gt;chunk-acd45458d7c3c63e9891f23252405a17</data>
    </node>
    <node id="Slavic Script">
      <data key="d0">Slavic Script</data>
      <data key="d1">category</data>
      <data key="d2">A script category encompassing writing systems used for Slavic languages, targeted with custom syllabification rules.</data>
      <data key="d3">chunk-5cf9480461a20dfddfe7c1ed32cfa07c</data>
    </node>
    <node id="Phrase-Based SMT">
      <data key="d0">Phrase-Based SMT</data>
      <data key="d1">category</data>
      <data key="d2">Phrase-based Statistical Machine Translation (SMT), a translation framework trained using the Moses system to evaluate subword representations.</data>
      <data key="d3">chunk-5cf9480461a20dfddfe7c1ed32cfa07c</data>
    </node>
    <node id="Moses System">
      <data key="d0">Moses System</data>
      <data key="d1">category</data>
      <data key="d2">An open-source statistical machine translation system used to train phrase-based SMT models.</data>
      <data key="d3">chunk-5cf9480461a20dfddfe7c1ed32cfa07c</data>
    </node>
    <node id="Indic NLP Library">
      <data key="d0">Indic NLP Library</data>
      <data key="d1">category</data>
      <data key="d2">A natural language processing software toolkit providing morphological segmentation models, orthographic syllabification rules, and Brahmi-derived script mapping for Indian languages.</data>
      <data key="d3">chunk-5cf9480461a20dfddfe7c1ed32cfa07c</data>
    </node>
    <node id="OPUS">
      <data key="d0">OPUS</data>
      <data key="d1">organization</data>
      <data key="d2">An open-source collection of parallel corpora from which data such as the OpenSubtitles2016 dataset was retrieved.</data>
      <data key="d3">chunk-5cf9480461a20dfddfe7c1ed32cfa07c</data>
    </node>
    <node id="Batch MIRA">
      <data key="d0">Batch MIRA</data>
      <data key="d1">category</data>
      <data key="d2">A margin-infused relaxed algorithm used for parameter tuning in phrase-based statistical machine translation.</data>
      <data key="d3">chunk-5cf9480461a20dfddfe7c1ed32cfa07c</data>
    </node>
    <node id="LeBLEU">
      <data key="d0">LeBLEU</data>
      <data key="d1">category</data>
      <data key="d2">An evaluation metric variant of BLEU that uses edit-distance based soft-matching of words, particularly suited for morphologically rich languages.&lt;SEP&gt;LeBLEU is an evaluation metric reflecting translation quality trends consistent with BLEU scores.</data>
      <data key="d3">chunk-5cf9480461a20dfddfe7c1ed32cfa07c&lt;SEP&gt;chunk-acd45458d7c3c63e9891f23252405a17</data>
    </node>
    <node id="Juman">
      <data key="d0">Juman</data>
      <data key="d1">category</data>
      <data key="d2">A morphological analysis and tokenization tool used for processing Japanese text.</data>
      <data key="d3">chunk-5cf9480461a20dfddfe7c1ed32cfa07c</data>
    </node>
    <node id="Mecab">
      <data key="d0">Mecab</data>
      <data key="d1">category</data>
      <data key="d2">A morphological analysis tool used for morpheme-level tokenization of Korean text.&lt;SEP&gt;An open-source text segmentation and morphological analysis tool applied to Korean tokenization.</data>
      <data key="d3">chunk-3d0d62f131549ff6e8a1545f667c733a&lt;SEP&gt;chunk-5cf9480461a20dfddfe7c1ed32cfa07c</data>
    </node>
    <node id="Abjad Writing Systems">
      <data key="d0">Abjad Writing Systems</data>
      <data key="d1">category</data>
      <data key="d2">Abjad writing systems, such as Arabic and extended Arabic for Urdu, represent consonants and do not consistently represent vowels.</data>
      <data key="d3">chunk-acd45458d7c3c63e9891f23252405a17</data>
    </node>
    <node id="Logographic Writing Systems">
      <data key="d0">Logographic Writing Systems</data>
      <data key="d1">category</data>
      <data key="d2">Logographic writing systems represent words or morphemes with symbols, exemplified by Japanese Kanji and Chinese.</data>
      <data key="d3">chunk-acd45458d7c3c63e9891f23252405a17</data>
    </node>
    <node id="Syllabic Writing Systems">
      <data key="d0">Syllabic Writing Systems</data>
      <data key="d1">category</data>
      <data key="d2">Syllabic writing systems represent syllables rather than individual vowels and consonants, exemplified by Korean Hangul.</data>
      <data key="d3">chunk-acd45458d7c3c63e9891f23252405a17</data>
    </node>
    <node id="Abugida Writing Systems">
      <data key="d0">Abugida Writing Systems</data>
      <data key="d1">category</data>
      <data key="d2">Abugida writing systems represent consonant-vowel combinations and fall into the category of scripts that explicitly represent vowels.</data>
      <data key="d3">chunk-acd45458d7c3c63e9891f23252405a17</data>
    </node>
    <node id="Agriculture Domain">
      <data key="d0">Agriculture Domain</data>
      <data key="d1">category</data>
      <data key="d2">A specialized translation domain evaluated in experiments to assess model performance under domain-specific conditions.&lt;SEP&gt;The agriculture domain is a test subject domain consisting of 1,000 sentences used to evaluate the cross-domain robustness of translation models.</data>
      <data key="d3">chunk-ea126b0da9c38f85b697b36cd33629f5&lt;SEP&gt;chunk-acd45458d7c3c63e9891f23252405a17</data>
    </node>
    <node id="Tourism And Health Domains">
      <data key="d0">Tourism And Health Domains</data>
      <data key="d1">category</data>
      <data key="d2">Tourism and health domains are the training domains utilized for evaluating cross-domain translation performance on unrelated test sets.</data>
      <data key="d3">chunk-acd45458d7c3c63e9891f23252405a17</data>
    </node>
    <node id="Tamil">
      <data key="d0">Tamil</data>
      <data key="d1">category</data>
      <data key="d2">Tamil is a Dravidian language tested in machine translation experiments utilizing BPE and OS units.</data>
      <data key="d3">chunk-acd45458d7c3c63e9891f23252405a17</data>
    </node>
    <node id="Telugu">
      <data key="d0">Telugu</data>
      <data key="d1">category</data>
      <data key="d2">Telugu is a Dravidian language evaluated in translation experiments involving Malayalam and subword representation units.</data>
      <data key="d3">chunk-acd45458d7c3c63e9891f23252405a17</data>
    </node>
    <node id="Chinese">
      <data key="d0">Chinese</data>
      <data key="d1">category</data>
      <data key="d2">Chinese is a language that uses a logographic writing system where vowels are not explicitly represented.</data>
      <data key="d3">chunk-acd45458d7c3c63e9891f23252405a17</data>
    </node>
    <node id="Arabic">
      <data key="d0">Arabic</data>
      <data key="d1">category</data>
      <data key="d2">Arabic is a language employing an abjad writing system that does not consistently represent vowels.</data>
      <data key="d3">chunk-acd45458d7c3c63e9891f23252405a17</data>
    </node>
    <node id="Hebrew">
      <data key="d0">Hebrew</data>
      <data key="d1">category</data>
      <data key="d2">Hebrew is a language that employs an abjad writing system.</data>
      <data key="d3">chunk-acd45458d7c3c63e9891f23252405a17</data>
    </node>
    <node id="Syriac">
      <data key="d0">Syriac</data>
      <data key="d1">category</data>
      <data key="d2">Syriac is a language that uses an abjad writing system.</data>
      <data key="d3">chunk-acd45458d7c3c63e9891f23252405a17</data>
    </node>
    <node id="Konkani">
      <data key="d0">Konkani</data>
      <data key="d1">category</data>
      <data key="d2">Konkani is an Indo-Aryan language evaluated in machine translation experiments alongside Marathi.</data>
      <data key="d3">chunk-acd45458d7c3c63e9891f23252405a17</data>
    </node>
    <node id="Alphabetic Writing Systems">
      <data key="d0">Alphabetic Writing Systems</data>
      <data key="d1">category</data>
      <data key="d2">Alphabetic writing systems are scripts that explicitly represent both consonants and vowels, compatible with orthographic syllables.</data>
      <data key="d3">chunk-acd45458d7c3c63e9891f23252405a17</data>
    </node>
    <node id="Word-Level Representation">
      <data key="d0">Word-Level Representation</data>
      <data key="d1">category</data>
      <data key="d2">Word-level representation is a baseline machine translation unit that suffers from data sparsity compared to subword units.</data>
      <data key="d3">chunk-acd45458d7c3c63e9891f23252405a17</data>
    </node>
    <node id="Morpheme-Level Representation">
      <data key="d0">Morpheme-Level Representation</data>
      <data key="d1">category</data>
      <data key="d2">Morpheme-level representation is a linguistic subword unit evaluated against BPE in translation tasks.</data>
      <data key="d3">chunk-acd45458d7c3c63e9891f23252405a17</data>
    </node>
    <node id="Department of Electronics &amp; Information Technology">
      <data key="d0">Department of Electronics &amp; Information Technology</data>
      <data key="d1">organization</data>
      <data key="d2">A department of the Government of India that provided institutional and funding support for the research.</data>
      <data key="d3">chunk-ea126b0da9c38f85b697b36cd33629f5</data>
    </node>
    <node id="Technology Development for Indian Languages Programme">
      <data key="d0">Technology Development for Indian Languages Programme</data>
      <data key="d1">organization</data>
      <data key="d2">A government initiative under the Government of India that supported research in natural language processing and machine translation.</data>
      <data key="d3">chunk-ea126b0da9c38f85b697b36cd33629f5</data>
    </node>
    <node id="Indian Languages">
      <data key="d0">Indian Languages</data>
      <data key="d1">category</data>
      <data key="d2">A collection of related languages spanning diverse families and writing systems used as experimental testbeds for translation units.</data>
      <data key="d3">chunk-ea126b0da9c38f85b697b36cd33629f5</data>
    </node>
    <node id="Multimodal Attribute Extraction">
      <data key="d0">Multimodal Attribute Extraction</data>
      <data key="d1">category</data>
      <data key="d2">A proposed information extraction task aimed at extracting entity attributes from mixed-media inputs such as text, images, video, and audio.</data>
      <data key="d3">chunk-ea126b0da9c38f85b697b36cd33629f5</data>
    </node>
    <node id="Govt. of India">
      <data key="d0">Govt. of India</data>
      <data key="d1">organization</data>
      <data key="d2">The central government of India, overseeing ministries and technological development initiatives including TDIL and DeitY.</data>
      <data key="d3">chunk-ea126b0da9c38f85b697b36cd33629f5</data>
    </node>
    <node id="Word-Level Representations">
      <data key="d0">Word-Level Representations</data>
      <data key="d1">category</data>
      <data key="d2">Translation modeling units based on whole words, suffering from data sparsity when limited parallel corpora are available.</data>
      <data key="d3">chunk-ea126b0da9c38f85b697b36cd33629f5</data>
    </node>
    <node id="Morpheme-Level Representations">
      <data key="d0">Morpheme-Level Representations</data>
      <data key="d1">category</data>
      <data key="d2">Translation units based on morphological segments of words, which show low correlation with lexical similarity.</data>
      <data key="d3">chunk-ea126b0da9c38f85b697b36cd33629f5</data>
    </node>
    <node id="Pivot Based MT">
      <data key="d0">Pivot Based MT</data>
      <data key="d1">category</data>
      <data key="d2">A machine translation methodology utilizing intermediate pivot languages to facilitate translation between related languages.</data>
      <data key="d3">chunk-ea126b0da9c38f85b697b36cd33629f5</data>
    </node>
    <node id="Domain Adaptation">
      <data key="d0">Domain Adaptation</data>
      <data key="d1">category</data>
      <data key="d2">A transfer learning technique used in machine translation to adapt models across different subject areas and data distributions.</data>
      <data key="d3">chunk-ea126b0da9c38f85b697b36cd33629f5</data>
    </node>
    <node id="ITRANS">
      <data key="d0">ITRANS</data>
      <data key="d1">category</data>
      <data key="d2">An Indian language transliteration scheme used to encode Indic scripts into standard ASCII characters.</data>
      <data key="d3">chunk-ea126b0da9c38f85b697b36cd33629f5</data>
    </node>
    <node id="Weakly Supervised Learning">
      <data key="d0">Weakly Supervised Learning</data>
      <data key="d1">category</data>
      <data key="d2">A machine learning paradigm utilizing partially labeled, noisy, or heuristic supervision, applied to train multimodal attribute extractors.</data>
      <data key="d3">chunk-ea126b0da9c38f85b697b36cd33629f5</data>
    </node>
    <node id="Mixed-Media Data">
      <data key="d0">Mixed-Media Data</data>
      <data key="d1">category</data>
      <data key="d2">Unstructured and semi-structured contextual information comprising combinations of text, images, video, and audio.</data>
      <data key="d3">chunk-ea126b0da9c38f85b697b36cd33629f5</data>
    </node>
    <node id="Diffbot">
      <data key="d0">Diffbot</data>
      <data key="d1">organization</data>
      <data key="d2">Diffbot is a technology company whose Product API is utilized to automatically extract attribute-value pairs from structured web data to build knowledge bases.&lt;SEP&gt;Diffbot is a technology company whose Product API was used to collect commercial product items from e-commerce sites for the Multimodal Attribute Extraction dataset.&lt;SEP&gt;Diffbot is a technology company whose Product API was used to extract mixed-media product data across e-commerce platforms for research.</data>
      <data key="d3">chunk-af2c44c466ad216bc8f3bec17868b71f&lt;SEP&gt;chunk-261a6f8ccfb17ebb9be72e74900d0a04</data>
    </node>
    <node id="Mechanical Turk">
      <data key="d0">Mechanical Turk</data>
      <data key="d1">organization</data>
      <data key="d2">Mechanical Turk is a crowdsourcing platform and service used by the researchers to conduct human evaluation on attribute detection across modalities.&lt;SEP&gt;Mechanical Turk is a crowdsourcing platform used to conduct human evaluation studies to assess the difficulty of the multimodal attribute extraction task.</data>
      <data key="d3">chunk-af2c44c466ad216bc8f3bec17868b71f</data>
    </node>
    <node id="Electronic Products">
      <data key="d0">Electronic Products</data>
      <data key="d1">category</data>
      <data key="d2">Electronic Products is a commercial merchandise category included in the Multimodal Attribute Extraction dataset.&lt;SEP&gt;Electronic Products is a product category represented within the Multimodal Attribute Extraction dataset.</data>
      <data key="d3">chunk-af2c44c466ad216bc8f3bec17868b71f</data>
    </node>
    <node id="Jewelry">
      <data key="d0">Jewelry</data>
      <data key="d1">category</data>
      <data key="d2">Jewelry is a merchandise category included in the commercial items collected for the Multimodal Attribute Extraction dataset.&lt;SEP&gt;Jewelry is an e-commerce product category featured among the items in the Multimodal Attribute Extraction dataset.</data>
      <data key="d3">chunk-af2c44c466ad216bc8f3bec17868b71f</data>
    </node>
    <node id="Clothing">
      <data key="d0">Clothing</data>
      <data key="d1">category</data>
      <data key="d2">Clothing is an apparel merchandise category represented within the Multimodal Attribute Extraction dataset.&lt;SEP&gt;Clothing is an apparel product category encompassed within the multimodal e-commerce dataset.</data>
      <data key="d3">chunk-af2c44c466ad216bc8f3bec17868b71f</data>
    </node>
    <node id="Vehicles">
      <data key="d0">Vehicles</data>
      <data key="d1">category</data>
      <data key="d2">Vehicles is a high-value commercial product category present in the dataset.&lt;SEP&gt;Vehicles is a product category covered in the diverse collection of items in the dataset.</data>
      <data key="d3">chunk-af2c44c466ad216bc8f3bec17868b71f</data>
    </node>
    <node id="Real Estate">
      <data key="d0">Real Estate</data>
      <data key="d1">category</data>
      <data key="d2">Real Estate is a commercial item category featured within the multimodal product dataset.&lt;SEP&gt;Real Estate is a commercial listing category included in the diverse Multimodal Attribute Extraction dataset.</data>
      <data key="d3">chunk-af2c44c466ad216bc8f3bec17868b71f</data>
    </node>
    <node id="Imagenet">
      <data key="d0">Imagenet</data>
      <data key="d1">category</data>
      <data key="d2">ImageNet is a benchmark computer vision dataset and resource category referenced for revolutionizing object recognition.</data>
      <data key="d3">chunk-af2c44c466ad216bc8f3bec17868b71f</data>
    </node>
    <node id="Unstructured Text Documents">
      <data key="d0">Unstructured Text Documents</data>
      <data key="d1">category</data>
      <data key="d2">Unstructured Text Documents represents a category of data sources including job postings, scientific papers, news articles, and emails traditionally utilized in information extraction.</data>
      <data key="d3">chunk-af2c44c466ad216bc8f3bec17868b71f</data>
    </node>
    <node id="Semi-Structured Web Pages">
      <data key="d0">Semi-Structured Web Pages</data>
      <data key="d1">category</data>
      <data key="d2">Semi-Structured Web Pages is a multimodal data type category on the web that contains varied knowledge outside strict tabular schemas.</data>
      <data key="d3">chunk-af2c44c466ad216bc8f3bec17868b71f</data>
    </node>
    <node id="Attribute Extraction">
      <data key="d0">Attribute Extraction</data>
      <data key="d1">category</data>
      <data key="d2">A machine learning task and research area focused on identifying and extracting attribute-value pairs from unstructured or semi-structured data, extended to multimodal settings involving text and images.</data>
      <data key="d3">chunk-f76f1c0c2ed37a786263a6a6d8b0bb6d</data>
    </node>
    <node id="Multimodal Machine Learning">
      <data key="d0">Multimodal Machine Learning</data>
      <data key="d1">category</data>
      <data key="d2">A domain of machine learning research involving models and architectures that process, combine, and reason across multiple modalities of information such as images, text, and metadata.&lt;SEP&gt;A subfield of artificial intelligence that involves unifying, processing, and learning from multiple modalities of information, such as visual and textual data.</data>
      <data key="d3">chunk-f76f1c0c2ed37a786263a6a6d8b0bb6d&lt;SEP&gt;chunk-261a6f8ccfb17ebb9be72e74900d0a04</data>
    </node>
    <node id="Object Recognition">
      <data key="d0">Object Recognition</data>
      <data key="d1">category</data>
      <data key="d2">A core computer vision task focused on identifying and classifying objects present within visual images.</data>
      <data key="d3">chunk-f76f1c0c2ed37a786263a6a6d8b0bb6d</data>
    </node>
    <node id="Diff">
      <data key="d0">Diff</data>
      <data key="d1">organization</data>
      <data key="d2">An organization or automated web-data extraction platform used to extract structured attribute-value pairs from product pages to build knowledge bases.</data>
      <data key="d3">chunk-f76f1c0c2ed37a786263a6a6d8b0bb6d</data>
    </node>
    <node id="Gated Multimodal Unit">
      <data key="d0">Gated Multimodal Unit</data>
      <data key="d1">category</data>
      <data key="d2">An advanced neural fusion mechanism designed to selectively combine multimodal inputs, such as visual and textual representations, through gating.</data>
      <data key="d3">chunk-f76f1c0c2ed37a786263a6a6d8b0bb6d</data>
    </node>
    <node id="Naïve Bayes">
      <data key="d0">Naïve Bayes</data>
      <data key="d1">category</data>
      <data key="d2">A family of probabilistic classifiers based on Bayes' theorem, applied to retail product attribute extraction using seed data.</data>
      <data key="d3">chunk-f76f1c0c2ed37a786263a6a6d8b0bb6d</data>
    </node>
    <node id="Hidden Markov Model">
      <data key="d0">Hidden Markov Model</data>
      <data key="d1">category</data>
      <data key="d2">A statistical Markov model with unobserved states, utilized in sequence labeling approaches for extracting product attributes.</data>
      <data key="d3">chunk-f76f1c0c2ed37a786263a6a6d8b0bb6d</data>
    </node>
    <node id="Maximum Entropy Model">
      <data key="d0">Maximum Entropy Model</data>
      <data key="d1">category</data>
      <data key="d2">A log-linear probabilistic classification model used in statistical machine learning for sequence tagging and attribute extraction.</data>
      <data key="d3">chunk-f76f1c0c2ed37a786263a6a6d8b0bb6d</data>
    </node>
    <node id="Crowdsourcing">
      <data key="d0">Crowdsourcing</data>
      <data key="d1">category</data>
      <data key="d2">A distributed sourcing model involving human workers used to manually verify, filter, and label attribute-value pairs to reduce noise.&lt;SEP&gt;Crowdsourcing is a data collection and annotation methodology that enlists groups of online participants to label data and generate evaluation sets.</data>
      <data key="d3">chunk-f76f1c0c2ed37a786263a6a6d8b0bb6d&lt;SEP&gt;chunk-261a6f8ccfb17ebb9be72e74900d0a04</data>
    </node>
    <node id="Semi-Supervised Learning">
      <data key="d0">Semi-Supervised Learning</data>
      <data key="d1">category</data>
      <data key="d2">A machine learning paradigm that combines a small amount of labeled data with a large amount of unlabeled data, often employing bootstrapping in attribute extraction.</data>
      <data key="d3">chunk-f76f1c0c2ed37a786263a6a6d8b0bb6d</data>
    </node>
    <node id="Multimodal Information Extraction">
      <data key="d0">Multimodal Information Extraction</data>
      <data key="d1">category</data>
      <data key="d2">A subfield of artificial intelligence and data mining focused on extracting structured knowledge, such as product attributes, from multiple modes of data including text and images.</data>
      <data key="d3">chunk-261a6f8ccfb17ebb9be72e74900d0a04</data>
    </node>
    <node id="E-Commerce">
      <data key="d0">E-Commerce</data>
      <data key="d1">category</data>
      <data key="d2">The domain of online commercial trade, serving as the source environment from which multimodal product descriptions, images, and attribute datasets are gathered.</data>
      <data key="d3">chunk-261a6f8ccfb17ebb9be72e74900d0a04</data>
    </node>
    <node id="Fake News">
      <data key="d0">Fake News</data>
      <data key="d1">category</data>
      <data key="d2">Fabricated or misleading information disseminated across online social networks and offline communities, negatively influencing culture and political discourse.&lt;SEP&gt;Fake News is a overarching category of false, deceptive, or misleading information appearing in text, image, or multimodal formats.</data>
      <data key="d3">chunk-6187c8bb0f977bcb9db2949d166fa2cc&lt;SEP&gt;chunk-261a6f8ccfb17ebb9be72e74900d0a04</data>
    </node>
    <node id="Fake News Detection">
      <data key="d0">Fake News Detection</data>
      <data key="d1">category</data>
      <data key="d2">A research area in machine learning and data science dedicated to building automated systems and classification benchmarks to detect misinformation.&lt;SEP&gt;Fake News Detection is a research domain and task category focused on developing computational models to identify false, misleading, and fabricated news content.</data>
      <data key="d3">chunk-6ea04b5a4cb9ba61c65c62ae52138068&lt;SEP&gt;chunk-261a6f8ccfb17ebb9be72e74900d0a04</data>
    </node>
    <node id="Misinformation">
      <data key="d0">Misinformation</data>
      <data key="d1">category</data>
      <data key="d2">Misinformation refers to false or misleading information spread across digitized communication networks, driving political polarization and social disruption.</data>
      <data key="d3">chunk-261a6f8ccfb17ebb9be72e74900d0a04</data>
    </node>
    <node id="Fact-Checking">
      <data key="d0">Fact-Checking</data>
      <data key="d1">category</data>
      <data key="d2">Fact-checking is the verification process of investigating claims and news stories, often lacking or inadequate in standard social media environments.</data>
      <data key="d3">chunk-261a6f8ccfb17ebb9be72e74900d0a04</data>
    </node>
    <node id="Culture">
      <data key="d0">Culture</data>
      <data key="d1">category</data>
      <data key="d2">Culture represents social institutions and shared human behaviors, noted as being adversely impacted by the proliferation of fake news.</data>
      <data key="d3">chunk-261a6f8ccfb17ebb9be72e74900d0a04</data>
    </node>
    <node id="Celebrity">
      <data key="d0">Celebrity</data>
      <data key="d1">category</data>
      <data key="d2">Celebrity is a domain of popular culture and public figures that frequently forms the subject matter of fake news datasets and stories.</data>
      <data key="d3">chunk-261a6f8ccfb17ebb9be72e74900d0a04</data>
    </node>
    <node id="Knowledge Base Construction">
      <data key="d0">Knowledge Base Construction</data>
      <data key="d1">category</data>
      <data key="d2">Knowledge Base Construction is the machine learning and data extraction process of building structured repositories of information from unstructured and multimodal web data.</data>
      <data key="d3">chunk-261a6f8ccfb17ebb9be72e74900d0a04</data>
    </node>
    <node id="Multimodal Reasoning">
      <data key="d0">Multimodal Reasoning</data>
      <data key="d1">category</data>
      <data key="d2">Multimodal reasoning is an artificial intelligence research discipline focused on drawing joint inferences across multiple diverse modes such as vision, text, and structure.</data>
      <data key="d3">chunk-261a6f8ccfb17ebb9be72e74900d0a04</data>
    </node>
    <node id="Pushshift.io">
      <data key="d0">Pushshift.io</data>
      <data key="d1">organization</data>
      <data key="d2">Pushshift.io is a service and API provider used to collect historical submission and comment data from Reddit.</data>
      <data key="d3">chunk-6187c8bb0f977bcb9db2949d166fa2cc</data>
    </node>
    <node id="True">
      <data key="d0">True</data>
      <data key="d1">category</data>
      <data key="d2">True is a classification category representing content that is accurate and in accordance with real-world facts.</data>
      <data key="d3">chunk-6187c8bb0f977bcb9db2949d166fa2cc</data>
    </node>
    <node id="Satire/Parody">
      <data key="d0">Satire/Parody</data>
      <data key="d1">category</data>
      <data key="d2">Satire/Parody is a category of content that presents contemporary information with a satirical or humorous tone, making it false.</data>
      <data key="d3">chunk-6187c8bb0f977bcb9db2949d166fa2cc</data>
    </node>
    <node id="Misleading Content">
      <data key="d0">Misleading Content</data>
      <data key="d1">category</data>
      <data key="d2">Misleading Content is a category representing information intentionally manipulated to deceive or mislead an audience.&lt;SEP&gt;Misleading Content is a classification category applied to certain online submissions whose text or captions mislead the audience.</data>
      <data key="d3">chunk-6ea04b5a4cb9ba61c65c62ae52138068&lt;SEP&gt;chunk-6187c8bb0f977bcb9db2949d166fa2cc</data>
    </node>
    <node id="Imposter Content">
      <data key="d0">Imposter Content</data>
      <data key="d1">category</data>
      <data key="d2">Imposter Content is a category characterized by bot-generated or impersonated material, such as posts from automated simulator accounts.</data>
      <data key="d3">chunk-6187c8bb0f977bcb9db2949d166fa2cc</data>
    </node>
    <node id="False Connection">
      <data key="d0">False Connection</data>
      <data key="d1">category</data>
      <data key="d2">False Connection is a classification category in the fake news dataset wherein submission images do not accurately support or correlate with their accompanying text descriptions.&lt;SEP&gt;False Connection is a multimodal category where images or media do not accurately correspond to or support their text descriptions.</data>
      <data key="d3">chunk-6ea04b5a4cb9ba61c65c62ae52138068&lt;SEP&gt;chunk-6187c8bb0f977bcb9db2949d166fa2cc</data>
    </node>
    <node id="The Onion">
      <data key="d0">The Onion</data>
      <data key="d1">organization</data>
      <data key="d2">The Onion is a prominent satirical digital media and news organization whose content and style are represented in satirical submissions.</data>
      <data key="d3">chunk-6187c8bb0f977bcb9db2949d166fa2cc</data>
    </node>
    <node id="Waterford Whispers News">
      <data key="d0">Waterford Whispers News</data>
      <data key="d1">organization</data>
      <data key="d2">Waterford Whispers News is a satirical news website and media outlet whose content forms part of the satire subreddits.</data>
      <data key="d3">chunk-6187c8bb0f977bcb9db2949d166fa2cc</data>
    </node>
    <node id="BuzzFeed News">
      <data key="d0">BuzzFeed News</data>
      <data key="d1">organization</data>
      <data key="d2">BuzzFeed News is a digital news organization referenced in relation to image and news verification datasets (BUZZFEEDNEWS, BUZZFACE).</data>
      <data key="d3">chunk-6187c8bb0f977bcb9db2949d166fa2cc</data>
    </node>
    <node id="Celebrity Gossip">
      <data key="d0">Celebrity Gossip</data>
      <data key="d1">category</data>
      <data key="d2">Celebrity Gossip is a specialized topic category commonly appearing in domain-specific fake news data collections.</data>
      <data key="d3">chunk-6187c8bb0f977bcb9db2949d166fa2cc</data>
    </node>
    <node id="2-Way Classification">
      <data key="d0">2-Way Classification</data>
      <data key="d1">category</data>
      <data key="d2">2-Way Classification is a binary classification framework categorizing submissions simply as fake or true.</data>
      <data key="d3">chunk-6187c8bb0f977bcb9db2949d166fa2cc</data>
    </node>
    <node id="3-Way Classification">
      <data key="d0">3-Way Classification</data>
      <data key="d1">category</data>
      <data key="d2">3-Way Classification is a categorical scheme dividing content into completely true, fake news with true text, and fake news with false text.</data>
      <data key="d3">chunk-6187c8bb0f977bcb9db2949d166fa2cc</data>
    </node>
    <node id="5-Way Classification">
      <data key="d0">5-Way Classification</data>
      <data key="d1">category</data>
      <data key="d2">5-Way Classification is a fine-grained categorization framework that groups content into true and four distinct fake news categories.</data>
      <data key="d3">chunk-6187c8bb0f977bcb9db2949d166fa2cc</data>
    </node>
    <node id="Fake News With True Text">
      <data key="d0">Fake News With True Text</data>
      <data key="d1">category</data>
      <data key="d2">Fake News with True Text is a category within the 3-way classification schema denoting misleading samples where the textual component is factually true in the real world.</data>
      <data key="d3">chunk-6187c8bb0f977bcb9db2949d166fa2cc</data>
    </node>
    <node id="Fake News With False Text">
      <data key="d0">Fake News With False Text</data>
      <data key="d1">category</data>
      <data key="d2">Fake News with False Text is a category within the 3-way classification schema indicating fake news items containing false textual content.</data>
      <data key="d3">chunk-6187c8bb0f977bcb9db2949d166fa2cc</data>
    </node>
    <node id="Completely True">
      <data key="d0">Completely True</data>
      <data key="d1">category</data>
      <data key="d2">Completely True is a category in the 3-way classification framework designating verified, fully accurate news submissions.</data>
      <data key="d3">chunk-6187c8bb0f977bcb9db2949d166fa2cc</data>
    </node>
    <node id="Non-Canonical Directives">
      <data key="d0">Non-Canonical Directives</data>
      <data key="d1">category</data>
      <data key="d2">A category of conversational utterances, questions, or commands that deviate from standard syntactic forms, complicating automated intent extraction.&lt;SEP&gt;Non-Canonical Directives is a linguistic and conversational category of indirect or non-standard user commands and requests that modern dialogue systems must interpret.&lt;SEP&gt;Non-canonical directives are speech acts that convey requests or commands in indirect or non-standard linguistic forms.</data>
      <data key="d3">chunk-b4b68de1cadc95909044e7f23fe3d8cb&lt;SEP&gt;chunk-6ea04b5a4cb9ba61c65c62ae52138068&lt;SEP&gt;chunk-18770431e1f17cd9efc7aedcdb98d303</data>
    </node>
    <node id="Misleadingthumbnails">
      <data key="d0">Misleadingthumbnails</data>
      <data key="d1">category</data>
      <data key="d2">Misleadingthumbnails is a Reddit community and content category featuring images whose thumbnails appear to depict something completely different from the actual full image.</data>
      <data key="d3">chunk-6ea04b5a4cb9ba61c65c62ae52138068</data>
    </node>
    <node id="Confusing_perspective">
      <data key="d0">Confusing_perspective</data>
      <data key="d1">category</data>
      <data key="d2">Confusing_perspective is a Reddit community and content category dedicated to images displaying confusing optical perspectives or misleading angles.</data>
      <data key="d3">chunk-6ea04b5a4cb9ba61c65c62ae52138068</data>
    </node>
    <node id="Pareidolia">
      <data key="d0">Pareidolia</data>
      <data key="d1">category</data>
      <data key="d2">Pareidolia is a Reddit community and content category containing images of everyday objects and patterns perceived as faces or recognizable figures.</data>
      <data key="d3">chunk-6ea04b5a4cb9ba61c65c62ae52138068</data>
    </node>
    <node id="Fakehistoryporn">
      <data key="d0">Fakehistoryporn</data>
      <data key="d1">category</data>
      <data key="d2">Fakehistoryporn is a Reddit community and content category that features humorous or satirical historical posts pairing real or unrelated photos with fake historical captions.</data>
      <data key="d3">chunk-6ea04b5a4cb9ba61c65c62ae52138068</data>
    </node>
    <node id="Savedyouaclick">
      <data key="d0">Savedyouaclick</data>
      <data key="d1">category</data>
      <data key="d2">Savedyouaclick is a Reddit community and content category dedicated to debunking and revealing the true contents behind clickbait headlines.</data>
      <data key="d3">chunk-6ea04b5a4cb9ba61c65c62ae52138068</data>
    </node>
    <node id="PsBattle">
      <data key="d0">PsBattle</data>
      <data key="d1">category</data>
      <data key="d2">PsBattle (Photoshop Battles) is a Reddit community and content category where users submit images to be humorously or creatively edited by other users.</data>
      <data key="d3">chunk-6ea04b5a4cb9ba61c65c62ae52138068</data>
    </node>
    <node id="Subsimulatorgpt2">
      <data key="d0">Subsimulatorgpt2</data>
      <data key="d1">category</data>
      <data key="d2">Subsimulatorgpt2 is an automated Reddit community and content category composed of posts generated by GPT-2 artificial intelligence models simulating various subreddits.</data>
      <data key="d3">chunk-6ea04b5a4cb9ba61c65c62ae52138068</data>
    </node>
    <node id="Online Safety Benchmark Award">
      <data key="d0">Online Safety Benchmark Award</data>
      <data key="d1">event</data>
      <data key="d2">The Online Safety Benchmark Award is a funding recognition and award program sponsored by Facebook to support research in online safety and content moderation.</data>
      <data key="d3">chunk-6ea04b5a4cb9ba61c65c62ae52138068</data>
    </node>
    <node id="Multimodal Classification">
      <data key="d0">Multimodal Classification</data>
      <data key="d1">category</data>
      <data key="d2">Multimodal Classification is a machine learning classification category where predictions are made by jointly learning from multiple input types, such as text and images.</data>
      <data key="d3">chunk-6ea04b5a4cb9ba61c65c62ae52138068</data>
    </node>
    <node id="Intent Classification">
      <data key="d0">Intent Classification</data>
      <data key="d1">category</data>
      <data key="d2">A classification task in natural language processing aimed at identifying the core objective or intention behind user utterances.</data>
      <data key="d3">chunk-18770431e1f17cd9efc7aedcdb98d303</data>
    </node>
    <node id="Slot-Filling">
      <data key="d0">Slot-Filling</data>
      <data key="d1">category</data>
      <data key="d2">A standard natural language understanding task involving the extraction of specific parameters and arguments from user input.</data>
      <data key="d3">chunk-18770431e1f17cd9efc7aedcdb98d303</data>
    </node>
    <node id="Speech Act">
      <data key="d0">Speech Act</data>
      <data key="d1">category</data>
      <data key="d2">A linguistic and pragmatic category representing the communicative function and intent of an utterance, structured into a multi-class taxonomy on Twitter.&lt;SEP&gt;A pragmatic linguistic category representing the intended communicative action of an utterance, critical for accurate argument inference in the evaluated NLP tasks.&lt;SEP&gt;A pragmatic linguistic concept where utterances perform actions or express conversational intents such as requests, commands, or questions.&lt;SEP&gt;Linguistic pragmatic categories defining utterance types whose correct identification directly affects intent argument inference.&lt;SEP&gt;Speech acts are a linguistic concept framing speech as action, adapted into a multi-class taxonomy for classifying tweets.</data>
      <data key="d3">chunk-05fedd4164c9b7124d9a3db12915651a&lt;SEP&gt;chunk-1e9f52662c01528fd8d607b1462c48df&lt;SEP&gt;chunk-3d0d62f131549ff6e8a1545f667c733a&lt;SEP&gt;chunk-24fec6e6dba96ab2ffdd4b5fac402b39&lt;SEP&gt;chunk-18770431e1f17cd9efc7aedcdb98d303</data>
    </node>
    <node id="Korean Language">
      <data key="d0">Korean Language</data>
      <data key="d1">category</data>
      <data key="d2">A natural language highlighted as the primary language of the corpus and study, noted for real-world non-canonical utterances.&lt;SEP&gt;An agglutinative, head-final language characterized by scrambling, investigated as a low-resource linguistic setting for intent comprehension.</data>
      <data key="d3">chunk-159ff4436a1c0b10a07d168b9d3ad6b6&lt;SEP&gt;chunk-18770431e1f17cd9efc7aedcdb98d303</data>
    </node>
    <node id="Question Set">
      <data key="d0">Question Set</data>
      <data key="d1">category</data>
      <data key="d2">A structured semantic representation used to capture the intent arguments of questions in dialog systems.</data>
      <data key="d3">chunk-18770431e1f17cd9efc7aedcdb98d303</data>
    </node>
    <node id="To-Do-List">
      <data key="d0">To-Do-List</data>
      <data key="d1">category</data>
      <data key="d2">A structured semantic representation used to capture the intent arguments of commands and action directives in dialog systems.</data>
      <data key="d3">chunk-18770431e1f17cd9efc7aedcdb98d303</data>
    </node>
    <node id="Amazon Echo">
      <data key="d0">Amazon Echo</data>
      <data key="d1">category</data>
      <data key="d2">A brand of smart speaker and conversational agent developed by Amazon that processes user voice commands and questions.</data>
      <data key="d3">chunk-18770431e1f17cd9efc7aedcdb98d303</data>
    </node>
    <node id="Google Home">
      <data key="d0">Google Home</data>
      <data key="d1">category</data>
      <data key="d2">A line of voice-enabled smart speakers and virtual assistant devices developed by Google for household interaction.</data>
      <data key="d3">chunk-18770431e1f17cd9efc7aedcdb98d303</data>
    </node>
    <node id="Poppa Joe">
      <data key="d0">Poppa Joe</data>
      <data key="d1">person</data>
      <data key="d2">A person addressed in a conversational declarative question example ('poppa joe you want me to go now') used to illustrate machine interpretation difficulties.</data>
      <data key="d3">chunk-18770431e1f17cd9efc7aedcdb98d303</data>
    </node>
    <node id="Entity Recognition">
      <data key="d0">Entity Recognition</data>
      <data key="d1">category</data>
      <data key="d2">A natural language processing technique focused on identifying and classifying named entities within unstructured text.</data>
      <data key="d3">chunk-18770431e1f17cd9efc7aedcdb98d303</data>
    </node>
    <node id="Formal Semantics">
      <data key="d0">Formal Semantics</data>
      <data key="d1">category</data>
      <data key="d2">A linguistic and mathematical discipline providing theoretical foundations for understanding sentence meaning and utterance representations.</data>
      <data key="d3">chunk-18770431e1f17cd9efc7aedcdb98d303</data>
    </node>
    <node id="Task-Oriented Systems">
      <data key="d0">Task-Oriented Systems</data>
      <data key="d1">category</data>
      <data key="d2">Conversational dialogue systems specifically designed to identify intents and execute predefined actions or transactions.</data>
      <data key="d3">chunk-18770431e1f17cd9efc7aedcdb98d303</data>
    </node>
    <node id="Non-Task-Oriented Dialogues">
      <data key="d0">Non-Task-Oriented Dialogues</data>
      <data key="d1">category</data>
      <data key="d2">Open-ended conversational dialogues that do not assume predefined action domains and rely on natural language argument representations.</data>
      <data key="d3">chunk-18770431e1f17cd9efc7aedcdb98d303</data>
    </node>
    <node id="Directive Utterances">
      <data key="d0">Directive Utterances</data>
      <data key="d1">category</data>
      <data key="d2">A functional category of speech acts in natural language processing that includes questions and commands, requiring intent extraction and comprehension.</data>
      <data key="d3">chunk-159ff4436a1c0b10a07d168b9d3ad6b6</data>
    </node>
    <node id="Questions">
      <data key="d0">Questions</data>
      <data key="d1">category</data>
      <data key="d2">A subcategory of directive utterances encompassing interrogatives such as yes/no, alternative, and wh- questions, as well as embedded and declarative questions.&lt;SEP&gt;Questions are an utterance category subclassified into yes/no, alternative, and wh- questions for argument extraction.</data>
      <data key="d3">chunk-159ff4436a1c0b10a07d168b9d3ad6b6&lt;SEP&gt;chunk-b4b68de1cadc95909044e7f23fe3d8cb</data>
    </node>
    <node id="Commands">
      <data key="d0">Commands</data>
      <data key="d1">category</data>
      <data key="d2">A subcategory of directive utterances encompassing imperatives, requests, prohibitions, and conditional directives.&lt;SEP&gt;Commands are an utterance category treated analogously to to-do lists and rewritten into actionable clauses.</data>
      <data key="d3">chunk-159ff4436a1c0b10a07d168b9d3ad6b6&lt;SEP&gt;chunk-b4b68de1cadc95909044e7f23fe3d8cb</data>
    </node>
    <node id="SQL Generation">
      <data key="d0">SQL Generation</data>
      <data key="d1">category</data>
      <data key="d2">A structured query language generation task in computational linguistics related to semantic parsing and code generation from natural language.</data>
      <data key="d3">chunk-159ff4436a1c0b10a07d168b9d3ad6b6</data>
    </node>
    <node id="Berant">
      <data key="d0">Berant</data>
      <data key="d1">person</data>
      <data key="d2">A researcher whose semantic parsing methodology serves as a reference for re-using extracted natural language terms as building blocks.</data>
      <data key="d3">chunk-159ff4436a1c0b10a07d168b9d3ad6b6</data>
    </node>
    <node id="Cho">
      <data key="d0">Cho</data>
      <data key="d1">person</data>
      <data key="d2">A researcher cited (Cho et al., 2018b) for work establishing a structured annotation scheme for the Korean language.&lt;SEP&gt;A researcher whose speech corpus work is referenced as part of the corpus annotation process.&lt;SEP&gt;Cho is a researcher and lead author of a 2018 study detailing a structured annotation scheme for the Korean language.&lt;SEP&gt;Cho is a researcher referenced in connection with the construction of a Korean single utterance corpus for identifying directives.</data>
      <data key="d3">chunk-159ff4436a1c0b10a07d168b9d3ad6b6&lt;SEP&gt;chunk-c79b21dbff7cd9735a0e14b1f97d11d4&lt;SEP&gt;chunk-5fa79759ff02333ae3d3a1d802134a1f&lt;SEP&gt;chunk-b4b68de1cadc95909044e7f23fe3d8cb</data>
    </node>
    <node id="Powell">
      <data key="d0">Powell</data>
      <data key="d1">person</data>
      <data key="d2">An individual referenced within an illustrative example of an embedded question.</data>
      <data key="d3">chunk-159ff4436a1c0b10a07d168b9d3ad6b6</data>
    </node>
    <node id="Carney">
      <data key="d0">Carney</data>
      <data key="d1">person</data>
      <data key="d2">An individual referenced alongside Powell within an illustrative example of an embedded question.</data>
      <data key="d3">chunk-159ff4436a1c0b10a07d168b9d3ad6b6</data>
    </node>
    <node id="Robotics Domain">
      <data key="d0">Robotics Domain</data>
      <data key="d1">category</data>
      <data key="d2">An application domain in artificial intelligence where command extraction has historically been investigated.</data>
      <data key="d3">chunk-159ff4436a1c0b10a07d168b9d3ad6b6</data>
    </node>
    <node id="Seq2seq Architecture">
      <data key="d0">Seq2seq Architecture</data>
      <data key="d1">category</data>
      <data key="d2">A sequence-to-sequence neural network model family commonly employed in semantic parsing, SQL generation, and machine translation tasks.</data>
      <data key="d3">chunk-159ff4436a1c0b10a07d168b9d3ad6b6</data>
    </node>
    <node id="Non-directive Utterances">
      <data key="d0">Non-directive Utterances</data>
      <data key="d1">category</data>
      <data key="d2">A classification of speech acts encompassing fragments and declarative statements, contrasted with questions and commands.</data>
      <data key="d3">chunk-159ff4436a1c0b10a07d168b9d3ad6b6</data>
    </node>
    <node id="Smart Speaker Commands">
      <data key="d0">Smart Speaker Commands</data>
      <data key="d1">category</data>
      <data key="d2">Real-world conversational spoken inputs given to smart home devices, which frequently exhibit non-canonical syntactic structures.</data>
      <data key="d3">chunk-159ff4436a1c0b10a07d168b9d3ad6b6</data>
    </node>
    <node id="Imperatives">
      <data key="d0">Imperatives</data>
      <data key="d1">category</data>
      <data key="d2">A grammatical structure featuring covert subjects or modal auxiliaries used primarily to express commands and requests.</data>
      <data key="d3">chunk-159ff4436a1c0b10a07d168b9d3ad6b6</data>
    </node>
    <node id="Interrogatives">
      <data key="d0">Interrogatives</data>
      <data key="d1">category</data>
      <data key="d2">A grammatical class of sentences characterized by features such as do-support, wh-movement, or embedded predicates, used to express questions.</data>
      <data key="d3">chunk-159ff4436a1c0b10a07d168b9d3ad6b6</data>
    </node>
    <node id="Declarative Questions">
      <data key="d0">Declarative Questions</data>
      <data key="d1">category</data>
      <data key="d2">A subcategory of questions that have the syntactic structure of a declarative sentence but function pragmatically as questions.</data>
      <data key="d3">chunk-159ff4436a1c0b10a07d168b9d3ad6b6</data>
    </node>
    <node id="Conditionalized Imperatives">
      <data key="d0">Conditionalized Imperatives</data>
      <data key="d1">category</data>
      <data key="d2">Imperative constructions combined with conditional clauses, categorized as commands based on whether the condition maintains or negates the required action.</data>
      <data key="d3">chunk-159ff4436a1c0b10a07d168b9d3ad6b6</data>
    </node>
    <node id="Intent Arguments">
      <data key="d0">Intent Arguments</data>
      <data key="d1">category</data>
      <data key="d2">Extracted semantic units or parameters representing the underlying communicative goal of non-canonical directive utterances.&lt;SEP&gt;Intent arguments are semantic components extracted from utterances to represent the underlying directive or conversational intent.</data>
      <data key="d3">chunk-159ff4436a1c0b10a07d168b9d3ad6b6&lt;SEP&gt;chunk-b4b68de1cadc95909044e7f23fe3d8cb</data>
    </node>
    <node id="Hawaii">
      <data key="d0">Hawaii</data>
      <data key="d1">geo</data>
      <data key="d2">Hawaii is an island location referenced in an example alternative question comparing temperatures.</data>
      <data key="d3">chunk-b4b68de1cadc95909044e7f23fe3d8cb</data>
    </node>
    <node id="Guam">
      <data key="d0">Guam</data>
      <data key="d1">geo</data>
      <data key="d2">Guam is an island territory referenced in an example alternative question comparing temperatures.</data>
      <data key="d3">chunk-b4b68de1cadc95909044e7f23fe3d8cb</data>
    </node>
    <node id="Treadstone">
      <data key="d0">Treadstone</data>
      <data key="d1">organization</data>
      <data key="d2">Treadstone is an organization or program referenced within an example wh- question utterance.</data>
      <data key="d3">chunk-b4b68de1cadc95909044e7f23fe3d8cb</data>
    </node>
    <node id="Yes/No Questions">
      <data key="d0">Yes/No Questions</data>
      <data key="d1">category</data>
      <data key="d2">A question category whose candidate answers are constrained to yes or no and extracted using an if-clause.</data>
      <data key="d3">chunk-b4b68de1cadc95909044e7f23fe3d8cb</data>
    </node>
    <node id="Alternative Questions">
      <data key="d0">Alternative Questions</data>
      <data key="d1">category</data>
      <data key="d2">A category of utterance type included in the corpus construction alongside wh-questions.&lt;SEP&gt;A question category structured around options, annotated using whether-or clauses and candidate answer lists.</data>
      <data key="d3">chunk-b4b68de1cadc95909044e7f23fe3d8cb&lt;SEP&gt;chunk-3d0d62f131549ff6e8a1545f667c733a</data>
    </node>
    <node id="Wh- Questions">
      <data key="d0">Wh- Questions</data>
      <data key="d1">category</data>
      <data key="d2">A question category that seeks specific information, extracted beginning with lexicons corresponding to wh- particles.</data>
      <data key="d3">chunk-b4b68de1cadc95909044e7f23fe3d8cb</data>
    </node>
    <node id="Prohibitions">
      <data key="d0">Prohibitions</data>
      <data key="d1">category</data>
      <data key="d2">A negative directive command category representing prohibited actions, rewritten using 'not to' structures.</data>
      <data key="d3">chunk-b4b68de1cadc95909044e7f23fe3d8cb</data>
    </node>
    <node id="Coreference">
      <data key="d0">Coreference</data>
      <data key="d1">category</data>
      <data key="d2">A linguistic phenomenon in conversational utterances involving pronouns and anaphora that require resolution and standardization during annotation.</data>
      <data key="d3">chunk-b4b68de1cadc95909044e7f23fe3d8cb</data>
    </node>
    <node id="Spatial Dependencies">
      <data key="d0">Spatial Dependencies</data>
      <data key="d1">category</data>
      <data key="d2">Contextual spatial references, such as specific locations or demonstratives like 'there', that must be captured in intent arguments.</data>
      <data key="d3">chunk-b4b68de1cadc95909044e7f23fe3d8cb</data>
    </node>
    <node id="Temporal Dependencies">
      <data key="d0">Temporal Dependencies</data>
      <data key="d1">category</data>
      <data key="d2">Contextual temporal references, such as timing indicators like 'tomorrow' or 'then', requiring preservation in intent extraction.</data>
      <data key="d3">chunk-b4b68de1cadc95909044e7f23fe3d8cb</data>
    </node>
    <node id="Subjective Factors">
      <data key="d0">Subjective Factors</data>
      <data key="d1">category</data>
      <data key="d2">Elements reflecting current thoughts or personal views of dialog participants within non-task-oriented conversations.</data>
      <data key="d3">chunk-b4b68de1cadc95909044e7f23fe3d8cb</data>
    </node>
    <node id="Speaker">
      <data key="d0">Speaker</data>
      <data key="d1">person</data>
      <data key="d2">The conversational participant producing an utterance, systematically substituted for first-person pronouns during annotation.</data>
      <data key="d3">chunk-b4b68de1cadc95909044e7f23fe3d8cb</data>
    </node>
    <node id="Addressee">
      <data key="d0">Addressee</data>
      <data key="d1">person</data>
      <data key="d2">The conversational participant receiving an utterance, systematically substituted for second-person pronouns during annotation.</data>
      <data key="d3">chunk-b4b68de1cadc95909044e7f23fe3d8cb</data>
    </node>
    <node id="Three Native Speakers">
      <data key="d0">Three Native Speakers</data>
      <data key="d1">person</data>
      <data key="d2">A group of annotators who performed the tagging of questions and commands to evaluate inter-annotator agreement.</data>
      <data key="d3">chunk-b4b68de1cadc95909044e7f23fe3d8cb</data>
    </node>
    <node id="Corpus Tagging Process">
      <data key="d0">Corpus Tagging Process</data>
      <data key="d1">event</data>
      <data key="d2">The annotation and labeling effort conducted by native speakers to tag directives and non-directives, achieving an IAA score of 0.85.</data>
      <data key="d3">chunk-b4b68de1cadc95909044e7f23fe3d8cb</data>
    </node>
    <node id="Directive Utterance">
      <data key="d0">Directive Utterance</data>
      <data key="d1">category</data>
      <data key="d2">A speech act category encompassing questions and commands designed to convey an intention or prompt an action from the addressee.</data>
      <data key="d3">chunk-42649e0b92cf01b8b9c2ef6df74b94a8</data>
    </node>
    <node id="Strong Requirement">
      <data key="d0">Strong Requirement</data>
      <data key="d1">category</data>
      <data key="d2">A linguistic utterance category introduced in corpus annotation describing the co-existence of a prohibitive expression and a canonical requirement.</data>
      <data key="d3">chunk-42649e0b92cf01b8b9c2ef6df74b94a8</data>
    </node>
    <node id="Prohibition">
      <data key="d0">Prohibition</data>
      <data key="d1">category</data>
      <data key="d2">A speech act category representing an injunction, restriction, or disallowance expressed in an utterance.&lt;SEP&gt;An utterance category characterized by expressions that forbid or discourage an action.</data>
      <data key="d3">chunk-24fec6e6dba96ab2ffdd4b5fac402b39&lt;SEP&gt;chunk-42649e0b92cf01b8b9c2ef6df74b94a8</data>
    </node>
    <node id="Alternative Question">
      <data key="d0">Alternative Question</data>
      <data key="d1">category</data>
      <data key="d2">A question category targeted during corpus augmentation to balance utterance types for automated processing.</data>
      <data key="d3">chunk-42649e0b92cf01b8b9c2ef6df74b94a8</data>
    </node>
    <node id="Wh-Question">
      <data key="d0">Wh-Question</data>
      <data key="d1">category</data>
      <data key="d2">A question utterance category requiring the abstraction of wh-related concepts to extract intent arguments.</data>
      <data key="d3">chunk-42649e0b92cf01b8b9c2ef6df74b94a8</data>
    </node>
    <node id="Speaker/Addressee Classification">
      <data key="d0">Speaker/Addressee Classification</data>
      <data key="d1">category</data>
      <data key="d2">A five-category coreference classification scheme comprising only the speaker, only the addressee, both, none, and unknown.</data>
      <data key="d3">chunk-42649e0b92cf01b8b9c2ef6df74b94a8</data>
    </node>
    <node id="Corpus Annotation">
      <data key="d0">Corpus Annotation</data>
      <data key="d1">event</data>
      <data key="d2">The process of tagging directives, questions, and commands, and establishing speaker and addressee coreference notations.</data>
      <data key="d3">chunk-42649e0b92cf01b8b9c2ef6df74b94a8</data>
    </node>
    <node id="Corpus Augmentation">
      <data key="d0">Corpus Augmentation</data>
      <data key="d1">event</data>
      <data key="d2">The process of expanding dataset size and balancing utterance types via human-aided sentence rewriting across defined topics.</data>
      <data key="d3">chunk-42649e0b92cf01b8b9c2ef6df74b94a8</data>
    </node>
    <node id="Question">
      <data key="d0">Question</data>
      <data key="d1">category</data>
      <data key="d2">A functional utterance category tagged during corpus development to identify interrogative speech acts requiring information or confirmation.&lt;SEP&gt;A speech act category signifying an inquiry or information request, identified as the third most frequent speech act in entity and event topics.</data>
      <data key="d3">chunk-f0e231c4e3067b98ab534052d00f25e1&lt;SEP&gt;chunk-42649e0b92cf01b8b9c2ef6df74b94a8</data>
    </node>
    <node id="Command">
      <data key="d0">Command</data>
      <data key="d1">category</data>
      <data key="d2">A speech act category representing imperative utterances and directives requesting specific actions.</data>
      <data key="d3">chunk-42649e0b92cf01b8b9c2ef6df74b94a8</data>
    </node>
    <node id="Head-Final Language">
      <data key="d0">Head-Final Language</data>
      <data key="d1">category</data>
      <data key="d2">A linguistic classification describing languages, such as Korean, where the syntactic head typically occurs at the end of a phrase.&lt;SEP&gt;A linguistic typology category classifying languages such as Korean where syntactically governing elements appear at the end of phrases or clauses, impacting tail prediction in autoregressive models.</data>
      <data key="d3">chunk-24fec6e6dba96ab2ffdd4b5fac402b39&lt;SEP&gt;chunk-42649e0b92cf01b8b9c2ef6df74b94a8</data>
    </node>
    <node id="Head-First Language">
      <data key="d0">Head-First Language</data>
      <data key="d1">category</data>
      <data key="d2">A linguistic typological category where syntactic heads precede their complements, contrasted with head-final languages.</data>
      <data key="d3">chunk-42649e0b92cf01b8b9c2ef6df74b94a8</data>
    </node>
    <node id="Mail">
      <data key="d0">Mail</data>
      <data key="d1">category</data>
      <data key="d2">A functional domain topic used in generating intent argument sentences for the corpus at a defined ratio.&lt;SEP&gt;A topic domain category utilized in constructing the smart agent corpus.</data>
      <data key="d3">chunk-3d0d62f131549ff6e8a1545f667c733a&lt;SEP&gt;chunk-42649e0b92cf01b8b9c2ef6df74b94a8</data>
    </node>
    <node id="Schedule">
      <data key="d0">Schedule</data>
      <data key="d1">category</data>
      <data key="d2">A calendar and time management topic category used for balancing utterances in corpus construction.&lt;SEP&gt;A functional topic category used for calendar and agenda-related intent arguments.</data>
      <data key="d3">chunk-3d0d62f131549ff6e8a1545f667c733a&lt;SEP&gt;chunk-42649e0b92cf01b8b9c2ef6df74b94a8</data>
    </node>
    <node id="House Control">
      <data key="d0">House Control</data>
      <data key="d1">category</data>
      <data key="d2">A smart home device management topic category used to structure dataset sentences for smart agent applications.&lt;SEP&gt;A topic category encompassing smart home automation directives and queries.</data>
      <data key="d3">chunk-3d0d62f131549ff6e8a1545f667c733a&lt;SEP&gt;chunk-42649e0b92cf01b8b9c2ef6df74b94a8</data>
    </node>
    <node id="Weather">
      <data key="d0">Weather</data>
      <data key="d1">category</data>
      <data key="d2">A topic domain category used for weather-related intent arguments and utterance creation.&lt;SEP&gt;An environmental domain category used as a topical theme in corpus augmentation sentences.</data>
      <data key="d3">chunk-3d0d62f131549ff6e8a1545f667c733a&lt;SEP&gt;chunk-42649e0b92cf01b8b9c2ef6df74b94a8</data>
    </node>
    <node id="Free Topics">
      <data key="d0">Free Topics</data>
      <data key="d1">category</data>
      <data key="d2">An open-domain topic category covering diverse subjects, such as algebra concepts, used to diversify the corpus.&lt;SEP&gt;An open-ended topical category making up a significant portion of sentences generated during dataset augmentation.</data>
      <data key="d3">chunk-3d0d62f131549ff6e8a1545f667c733a&lt;SEP&gt;chunk-42649e0b92cf01b8b9c2ef6df74b94a8</data>
    </node>
    <node id="Native Speakers">
      <data key="d0">Native Speakers</data>
      <data key="d1">person</data>
      <data key="d2">A group of three native Korean speakers who conducted the tagging process for questions and commands.</data>
      <data key="d3">chunk-42649e0b92cf01b8b9c2ef6df74b94a8</data>
    </node>
    <node id="Tagging Of Questions And Commands">
      <data key="d0">Tagging Of Questions And Commands</data>
      <data key="d1">event</data>
      <data key="d2">An annotation activity performed by three native speakers that achieved an inter-annotator agreement score of kappa 0.85.</data>
      <data key="d3">chunk-42649e0b92cf01b8b9c2ef6df74b94a8</data>
    </node>
    <node id="Human-Aided Sentence Rewriting">
      <data key="d0">Human-Aided Sentence Rewriting</data>
      <data key="d1">event</data>
      <data key="d2">A text expansion activity wherein human annotators rewrite sentences from intent arguments to augment and balance the corpus.</data>
      <data key="d3">chunk-42649e0b92cf01b8b9c2ef6df74b94a8</data>
    </node>
    <node id="Wh-Questions">
      <data key="d0">Wh-Questions</data>
      <data key="d1">category</data>
      <data key="d2">A category of utterance type focused on information-seeking questions, constructed in the dataset using nominalized intent arguments without direct wh-particles.</data>
      <data key="d3">chunk-3d0d62f131549ff6e8a1545f667c733a</data>
    </node>
    <node id="BERT-Based Scoring System">
      <data key="d0">BERT-Based Scoring System</data>
      <data key="d1">category</data>
      <data key="d2">An evaluation metric category utilizing pre-trained language models to evaluate semantic similarity in text generation.</data>
      <data key="d3">chunk-3d0d62f131549ff6e8a1545f667c733a</data>
    </node>
    <node id="Participants">
      <data key="d0">Participants</data>
      <data key="d1">person</data>
      <data key="d2">Human subjects requested by researchers to compose ten diverse utterances per phrase during the paraphrasing process.</data>
      <data key="d3">chunk-3d0d62f131549ff6e8a1545f667c733a</data>
    </node>
    <node id="Smart Agents">
      <data key="d0">Smart Agents</data>
      <data key="d1">category</data>
      <data key="d2">Automated conversational systems whose advancement is the primary objective of constructing the corpus.</data>
      <data key="d3">chunk-3d0d62f131549ff6e8a1545f667c733a</data>
    </node>
    <node id="Seq2seq">
      <data key="d0">Seq2seq</data>
      <data key="d1">category</data>
      <data key="d2">Sequence-to-sequence framework employed to infer intent arguments directly from input sentences.</data>
      <data key="d3">chunk-3d0d62f131549ff6e8a1545f667c733a</data>
    </node>
    <node id="KoNLPy">
      <data key="d0">KoNLPy</data>
      <data key="d1">category</data>
      <data key="d2">A Python natural language processing library providing a wrapper to access Mecab for tokenization.</data>
      <data key="d3">chunk-3d0d62f131549ff6e8a1545f667c733a</data>
    </node>
    <node id="Paraphrasing">
      <data key="d0">Paraphrasing</data>
      <data key="d1">category</data>
      <data key="d2">A monolingual translation process in which single arguments are converted into multiple diverse surface utterances.</data>
      <data key="d3">chunk-3d0d62f131549ff6e8a1545f667c733a</data>
    </node>
    <node id="Experiments">
      <data key="d0">Experiments</data>
      <data key="d1">event</data>
      <data key="d2">Empirical evaluations conducted to measure solving times, scalability, and text quality between ILP models and their approximations.&lt;SEP&gt;The sequence of automated testing procedures assessing model formats, seq2seq architectures, and quantitative evaluation metrics.</data>
      <data key="d3">chunk-3d0d62f131549ff6e8a1545f667c733a&lt;SEP&gt;chunk-623c9cfea2f0f1560eb4ea4b48d419c4</data>
    </node>
    <node id="Requirement">
      <data key="d0">Requirement</data>
      <data key="d1">category</data>
      <data key="d2">A speech act category indicating an instruction, mandate, or necessary action expressed within an utterance.</data>
      <data key="d3">chunk-24fec6e6dba96ab2ffdd4b5fac402b39</data>
    </node>
    <node id="Wh- Question">
      <data key="d0">Wh- Question</data>
      <data key="d1">category</data>
      <data key="d2">A category of interrogative sentences evaluated as complex input utterances for speech act and argument inference.</data>
      <data key="d3">chunk-24fec6e6dba96ab2ffdd4b5fac402b39</data>
    </node>
    <node id="RNN Seq2seq with Attention">
      <data key="d0">RNN Seq2seq with Attention</data>
      <data key="d1">category</data>
      <data key="d2">A recurrent sequence-to-sequence neural model category evaluated in the experiments, which suffered from word repetition collapse during inference.</data>
      <data key="d3">chunk-24fec6e6dba96ab2ffdd4b5fac402b39</data>
    </node>
    <node id="Department Store Sale Event">
      <data key="d0">Department Store Sale Event</data>
      <data key="d1">event</data>
      <data key="d2">A commercial sale event referenced in an evaluated Korean test sentence where a person is instructed to wait in advance.</data>
      <data key="d3">chunk-24fec6e6dba96ab2ffdd4b5fac402b39</data>
    </node>
    <node id="PhD Graduation">
      <data key="d0">PhD Graduation</data>
      <data key="d1">event</data>
      <data key="d2">An academic milestone event mentioned as a point of comparison in an evaluated test sentence.</data>
      <data key="d3">chunk-24fec6e6dba96ab2ffdd4b5fac402b39</data>
    </node>
    <node id="BERTScore">
      <data key="d0">BERTScore</data>
      <data key="d1">category</data>
      <data key="d2">A metric category for automatic semantic similarity evaluation based on pre-trained BERT embeddings, used to measure the alignment between model outputs and gold standard data.</data>
      <data key="d3">chunk-24fec6e6dba96ab2ffdd4b5fac402b39</data>
    </node>
    <node id="ROUGE-1">
      <data key="d0">ROUGE-1</data>
      <data key="d1">category</data>
      <data key="d2">An evaluation metric category measuring character-level and lexical overlap against reference text, preventing bias from formatting differences.</data>
      <data key="d3">chunk-24fec6e6dba96ab2ffdd4b5fac402b39</data>
    </node>
    <node id="Pre-Trained Language Models">
      <data key="d0">Pre-Trained Language Models</data>
      <data key="d1">category</data>
      <data key="d2">A category of neural models trained on broad corpora that encode general linguistic common sense, utilized in semantic similarity scoring.</data>
      <data key="d3">chunk-24fec6e6dba96ab2ffdd4b5fac402b39</data>
    </node>
    <node id="Out-of-Vocabulary Terms">
      <data key="d0">Out-of-Vocabulary Terms</data>
      <data key="d1">category</data>
      <data key="d2">A linguistic and computational category designating words absent from the model's training vocabulary, causing inference decoding confusion.</data>
      <data key="d3">chunk-24fec6e6dba96ab2ffdd4b5fac402b39</data>
    </node>
    <node id="Loanword">
      <data key="d0">Loanword</data>
      <data key="d1">category</data>
      <data key="d2">A linguistic category of words borrowed from foreign languages, such as 'sale' in Korean, that often appear as out-of-vocabulary terms in test sets.</data>
      <data key="d3">chunk-24fec6e6dba96ab2ffdd4b5fac402b39</data>
    </node>
    <node id="Auto-Regressive Inference">
      <data key="d0">Auto-Regressive Inference</data>
      <data key="d1">category</data>
      <data key="d2">A sequence generation category in neural models where subsequent token prediction is conditioned on prior tokens, presenting challenges for clause-tail stability.</data>
      <data key="d3">chunk-24fec6e6dba96ab2ffdd4b5fac402b39</data>
    </node>
    <node id="Department Store">
      <data key="d0">Department Store</data>
      <data key="d1">organization</data>

    </node>
    <node id="Popović">
      <data key="d0">Popović</data>
      <data key="d1">person</data>
      <data key="d2">A researcher who classified five major types of errors occurring in machine translation systems.&lt;SEP&gt;Popović is a researcher who categorized five primary types of persistent translation errors in modern machine translation systems.</data>
      <data key="d3">chunk-7f598ed7171b8214c363358a6167512f&lt;SEP&gt;chunk-fe22bfea47113bef8076ac67e7587b69</data>

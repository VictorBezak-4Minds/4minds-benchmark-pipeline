    </node>
    <node id="Entity And Relation Extraction">
      <data key="d0">Entity And Relation Extraction</data>
      <data key="d1">category</data>
      <data key="d2">Entity and relation extraction is an information extraction task category in natural language processing aimed at identifying entities and their semantic relationships from unstructured text.</data>
      <data key="d3">chunk-236f5016d3aa81277cabc5c947f1ca64</data>
    </node>
    <node id="Coronary Angiography">
      <data key="d0">Coronary Angiography</data>
      <data key="d1">category</data>
      <data key="d2">Coronary angiography is a medical examination and procedure category, whose textual diagnostic reports serve as domain-specific text for clinical information extraction.</data>
      <data key="d3">chunk-236f5016d3aa81277cabc5c947f1ca64</data>
    </node>
    <node id="Relation Classification">
      <data key="d0">Relation Classification</data>
      <data key="d1">category</data>
      <data key="d2">A natural language processing task (RC) focused on determining semantic relations between identified entities in text.&lt;SEP&gt;An information extraction sub-task category focused on identifying the specific semantic relationships between identified entities.&lt;SEP&gt;An information extraction task that determines and classifies semantic relationships between recognized entities in a text.&lt;SEP&gt;Relation classification is a natural language processing task focused on categorizing semantic connections and relationships between identified entities in text.</data>
      <data key="d3">chunk-57acb1a29c2b86c001f999352f15c3cc&lt;SEP&gt;chunk-cfda2df27b2b2e8e0d65e1812ca700fd&lt;SEP&gt;chunk-f1fb2eeb8c8333a70050efefb9412104&lt;SEP&gt;chunk-236f5016d3aa81277cabc5c947f1ca64</data>
    </node>
    <node id="Clinical Decision Making">
      <data key="d0">Clinical Decision Making</data>
      <data key="d1">category</data>
      <data key="d2">A medical decision-making process category supported by integrated electronic health records.&lt;SEP&gt;Clinical decision making is a healthcare process category supported by information extracted from electronic health records to guide patient diagnosis and treatment.</data>
      <data key="d3">chunk-cfda2df27b2b2e8e0d65e1812ca700fd&lt;SEP&gt;chunk-236f5016d3aa81277cabc5c947f1ca64</data>
    </node>
    <node id="Entity and Relation Extraction">
      <data key="d0">Entity and Relation Extraction</data>
      <data key="d1">category</data>
      <data key="d2">A core task category in natural language processing and medical data mining aimed at extracting relational entity triples from unstructured text.</data>
      <data key="d3">chunk-cfda2df27b2b2e8e0d65e1812ca700fd</data>
    </node>
    <node id="Pipeline Processing">
      <data key="d0">Pipeline Processing</data>
      <data key="d1">category</data>
      <data key="d2">A system architecture category that decomposes information extraction into sequential, independent sub-tasks such as named entity recognition followed by relation classification.</data>
      <data key="d3">chunk-cfda2df27b2b2e8e0d65e1812ca700fd</data>
    </node>
    <node id="Joint Learning">
      <data key="d0">Joint Learning</data>
      <data key="d1">category</data>
      <data key="d2">A machine learning paradigm category in which related tasks, such as named entity recognition and relation classification, are trained simultaneously to capture joint features.&lt;SEP&gt;A machine learning paradigm where models for named entity recognition and relation classification are trained concurrently to share representations.</data>
      <data key="d3">chunk-f1fb2eeb8c8333a70050efefb9412104&lt;SEP&gt;chunk-cfda2df27b2b2e8e0d65e1812ca700fd</data>
    </node>

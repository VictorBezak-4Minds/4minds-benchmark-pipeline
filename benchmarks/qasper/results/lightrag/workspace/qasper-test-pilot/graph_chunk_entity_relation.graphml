    <node id="Bi-GRUs">
      <data key="d0">Bi-GRUs</data>
      <data key="d1">category</data>
      <data key="d2">Bidirectional Gated Recurrent Units, an established recurrent neural network architecture utilized as an experimental baseline.</data>

    </node>
    <node id="Obituarymining1">
      <data key="d0">Obituarymining1</data>
      <data key="d1">person</data>
      <data key="d2">Obituarymining1 refers to researchers who evaluated the extraction of personal identifying information from obituaries to prevent identity theft.</data>
      <data key="d3">chunk-dc1405d1609fdbebb00fe9dd18235f8e</data>
    </node>

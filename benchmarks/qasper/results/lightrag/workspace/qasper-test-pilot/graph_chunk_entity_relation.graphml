    </node>
    <node id="Article">
      <data key="d0">Article</data>
      <data key="d1">category</data>
      <data key="d2">Article is a grammatical category comprising definite and indefinite determiners used in slot annotations with agreement constraints.</data>
      <data key="d3">chunk-d2133007f11cdae6d7728268eadeba6c</data>
    </node>
    <node id="Preposition">
      <data key="d0">Preposition</data>
      <data key="d1">category</data>
      <data key="d2">Preposition is a grammatical category of connector words used in slot sequences of sentence plans and nl names.</data>
      <data key="d3">chunk-d2133007f11cdae6d7728268eadeba6c</data>
    </node>
    <node id="Pronoun">
      <data key="d0">Pronoun</data>
      <data key="d1">category</data>
      <data key="d2">Pronoun is a grammatical category used by the referring expression generation component to refer to entities based on gender and number.&lt;SEP&gt;Pronoun is a linguistic category of referring expression considered by the generation system as an alternative to repeating full natural language names.</data>
      <data key="d3">chunk-d2133007f11cdae6d7728268eadeba6c&lt;SEP&gt;chunk-5dc202cbcb7ba0bcd01a26bba74ac644</data>

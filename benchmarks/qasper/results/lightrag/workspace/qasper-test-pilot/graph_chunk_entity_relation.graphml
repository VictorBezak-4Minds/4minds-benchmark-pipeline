      <data key="d1">organization</data>
      <data key="d2">A French research platform and pharmacoepidemiology initiative funded by the French Medicines Agency to monitor drug use and safety.</data>
      <data key="d3">chunk-0ced0d535e26b1f8838eba4645dd259b</data>
    </node>

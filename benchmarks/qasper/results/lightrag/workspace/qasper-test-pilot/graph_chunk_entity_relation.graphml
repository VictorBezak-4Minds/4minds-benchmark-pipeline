      <data key="d0">Open Information Extraction</data>
      <data key="d1">category</data>
      <data key="d2">A natural language processing information extraction technique used to extract event triples from textual corpora.&lt;SEP&gt;A natural language processing technique used to extract structured event representations, such as actors, actions, and objects, directly from unstructured text.</data>
      <data key="d3">chunk-a8fecfb2a0e52c8eb6b888c9cbd44d9c&lt;SEP&gt;chunk-c9d3fbec1ae6ff5c0cac8214c21ddda4</data>
    </node>

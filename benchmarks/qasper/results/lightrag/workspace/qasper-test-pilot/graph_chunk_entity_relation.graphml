      <data key="d1">category</data>
      <data key="d2">An optimization algorithm used to compute gradients and update neural network model parameters to minimize loss.</data>
      <data key="d3">chunk-02f0f311662379cfa30789a001aeb981</data>
    </node>
    <node id="Sentence Representation Learning">
      <data key="d0">Sentence Representation Learning</data>
      <data key="d1">category</data>
      <data key="d2">A natural language processing task and category of methods aimed at encoding full sentences into dense numerical vectors.</data>
      <data key="d3">chunk-02f0f311662379cfa30789a001aeb981</data>
    </node>
    <node id="Language Modelling">
      <data key="d0">Language Modelling</data>
      <data key="d1">category</data>
      <data key="d2">A core natural language processing task predicting sequence probabilities, in which BiLSTMs achieve state-of-the-art performance.&lt;SEP&gt;A fundamental NLP task focused on modeling the probability distribution of sequences of words, evaluated using metrics such as word perplexity.&lt;SEP&gt;Language modelling is a natural language processing downstream task in which character-level models have achieved reductions in word perplexity.</data>
      <data key="d3">chunk-cd3a4a211bb43ab387afa7488082157d&lt;SEP&gt;chunk-02f0f311662379cfa30789a001aeb981&lt;SEP&gt;chunk-4117dfdbcf8427f9aa5d8d43444fb707</data>
    </node>
    <node id="Syntactic Parsing">
      <data key="d0">Syntactic Parsing</data>
      <data key="d1">category</data>
      <data key="d2">A natural language processing task analyzing grammatical sentence structure, in which BiLSTMs achieve state-of-the-art performance.&lt;SEP&gt;A natural language processing task involving the analysis and determination of the grammatical syntax structure of sentences.</data>
      <data key="d3">chunk-f76f1c0c2ed37a786263a6a6d8b0bb6d&lt;SEP&gt;chunk-02f0f311662379cfa30789a001aeb981</data>
    </node>
    <node id="Forward LSTM Component">
      <data key="d0">Forward LSTM Component</data>
      <data key="d1">category</data>
      <data key="d2">A unidirectional recurrent neural network component that processes input word sequences in a forward, left-to-right direction.</data>
      <data key="d3">chunk-02f0f311662379cfa30789a001aeb981</data>
    </node>
    <node id="Backward LSTM Component">
      <data key="d0">Backward LSTM Component</data>
      <data key="d1">category</data>
      <data key="d2">A unidirectional recurrent neural network component that processes input word sequences in a backward, right-to-left direction.</data>
      <data key="d3">chunk-02f0f311662379cfa30789a001aeb981</data>
    </node>
    <node id="Ranking Type Loss Function">
      <data key="d0">Ranking Type Loss Function</data>
      <data key="d1">category</data>
      <data key="d2">A loss formulation designed to train intent embeddings by optimizing the similarity score of a correct intent vector relative to a randomly chosen incorrect intent vector.</data>
      <data key="d3">chunk-02f0f311662379cfa30789a001aeb981</data>
    </node>
    <node id="Sentiment Polarity">
      <data key="d0">Sentiment Polarity</data>
      <data key="d1">category</data>
      <data key="d2">A numerical categorization scheme (positive as 1, negative as -1) reflecting the emotional valence of an event based on normalized emotion words.&lt;SEP&gt;Sentiment Polarity is a classification category denoting whether an event or word exhibits positive or negative sentiment.</data>
      <data key="d3">chunk-a8fecfb2a0e52c8eb6b888c9cbd44d9c&lt;SEP&gt;chunk-02f0f311662379cfa30789a001aeb981</data>
    </node>

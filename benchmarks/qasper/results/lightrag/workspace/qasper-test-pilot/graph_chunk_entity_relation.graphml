    </node>
    <node id="Hu">
      <data key="d0">Hu</data>
      <data key="d1">person</data>
      <data key="d2">A researcher who introduced a data-driven approach to prune zero-activation neurons iteratively based on intermediate feature maps.&lt;SEP&gt;Hu is a computer science researcher and co-creator of the Hu-Liu opinion lexicon used for sentiment analysis.&lt;SEP&gt;Hu is a researcher who proposed hierarchical LSTM models to predict events by generating descriptive word sequences.</data>
      <data key="d3">chunk-289c3be854417f1af5a604180e6310cc&lt;SEP&gt;chunk-7655d654b459dfdba7d9c1f562898a07&lt;SEP&gt;chunk-c9d3fbec1ae6ff5c0cac8214c21ddda4</data>

    </node>
    <node id="TextCNNs">
      <data key="d0">TextCNNs</data>
      <data key="d1">category</data>
      <data key="d2">A convolutional neural network architecture for text processing employed as an arbitrator model to evaluate dialogue interaction decisions.&lt;SEP&gt;A convolutional neural network model used for text classification, serving as both a baseline and an arbitrator architecture.</data>
      <data key="d3">chunk-e97e9e342e051e03614c8dcaa59a2bbc&lt;SEP&gt;chunk-cfa367d5347172364eadcba53c1dc471</data>

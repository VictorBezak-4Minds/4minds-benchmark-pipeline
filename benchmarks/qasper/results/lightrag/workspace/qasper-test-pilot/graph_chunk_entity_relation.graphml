      <data key="d1">organization</data>
      <data key="d2">A research system or group that achieved a high F-score in 2016 using dictionary-based annotation methods without spelling correction.</data>
      <data key="d3">chunk-0ced0d535e26b1f8838eba4645dd259b</data>
    </node>
    <node id="Agence Nationale de Sécurité du Médicament et des Produits de Santé">
      <data key="d0">Agence Nationale de Sécurité du Médicament et des Produits de Santé</data>
      <data key="d1">organization</data>
      <data key="d2">The official French regulatory agency (ANSM) responsible for the safety of health products and medicines, funding the DRUGS-SAFE platform.</data>
      <data key="d3">chunk-0ced0d535e26b1f8838eba4645dd259b</data>
    </node>
    <node id="Dictionary-Based Approach">
      <data key="d0">Dictionary-Based Approach</data>
      <data key="d1">category</data>
      <data key="d2">A natural language processing and text matching methodology that uses structured vocabularies, dictionaries, and token trees to assign medical codes to clinical text.</data>
      <data key="d3">chunk-0ced0d535e26b1f8838eba4645dd259b</data>
    </node>
    <node id="Levenshtein Method">
      <data key="d0">Levenshtein Method</data>
      <data key="d1">category</data>
      <data key="d2">A string metric and fuzzy matching algorithm used to calculate edit distance and identify compound or split words such as medical terms.</data>
      <data key="d3">chunk-0ced0d535e26b1f8838eba4645dd259b</data>
    </node>
    <node id="Pharmacoepidemiology">
      <data key="d0">Pharmacoepidemiology</data>
      <data key="d1">category</data>
      <data key="d2">The study of the uses and effects of drugs in populations, which forms the core focus of the DRUGS-SAFE platform.</data>
      <data key="d3">chunk-0ced0d535e26b1f8838eba4645dd259b</data>
    </node>
    <node id="Sentiment Classes">
      <data key="d0">Sentiment Classes</data>
      <data key="d1">category</data>
      <data key="d2">A three-tier categorical classification system consisting of negative, neutral, and positive sentiment labels, perceived as ordered by human annotators.&lt;SEP&gt;Discrete, ordered categories—specifically negative, neutral, and positive—used to quantify emotional perception in text.&lt;SEP&gt;The ordered sentiment classification categories (negative, neutral, and positive) evaluated by human annotators in Twitter sentiment analysis.</data>
      <data key="d3">chunk-8756bb2d18f7993da0c11080bc5f15a1&lt;SEP&gt;chunk-02b1ce0e6302d1e78683fc67d2a9ca7b&lt;SEP&gt;chunk-0ced0d535e26b1f8838eba4645dd259b</data>
    </node>
    <node id="Inter-Annotator Agreement">
      <data key="d0">Inter-Annotator Agreement</data>
      <data key="d1">category</data>
      <data key="d2">A measurement category assessing the consistency and reliability of labels assigned to identical tweets by two different annotators.&lt;SEP&gt;A metric and quality criterion measuring consistency between different human annotators when labeling the same texts for sentiment.&lt;SEP&gt;A metric quantifying consensus among multiple human annotators labeling the same data, serving as an upper bound benchmark for automated classification performance.&lt;SEP&gt;A performance benchmark and reliability metric quantifying the consensus between different annotators labeling identical tweets.&lt;SEP&gt;A statistical measure used to quantify the consistency and quality of annotations produced by human coders on training datasets.&lt;SEP&gt;A statistical metric used to measure agreement between different human annotators and to establish an upper bound for classifier performance.&lt;SEP&gt;An evaluation metric calculated from multiple annotations of the same tweet by different annotators, used to assess the objective difficulty of the sentiment annotation task.</data>
      <data key="d3">chunk-0ced0d535e26b1f8838eba4645dd259b&lt;SEP&gt;chunk-d6c58bb9dd0e817dbe019ee67fada1a4&lt;SEP&gt;chunk-e932637d56f9b77201dab132c9f4834c&lt;SEP&gt;chunk-8b53c4d2b0ae2737239adca2c184b25d&lt;SEP&gt;chunk-8756bb2d18f7993da0c11080bc5f15a1&lt;SEP&gt;chunk-02b1ce0e6302d1e78683fc67d2a9ca7b&lt;SEP&gt;chunk-dacb70558821cf911a6e2c412a464f07</data>
    </node>
    <node id="Dodds">
      <data key="d0">Dodds</data>
      <data key="d1">person</data>
      <data key="d2">A researcher, cited alongside collaborators, who conducted a massive study collecting millions of human sentiment assessments for common words across multiple languages.</data>
      <data key="d3">chunk-8756bb2d18f7993da0c11080bc5f15a1</data>
    </node>
    <node id="Lexicon-Based Approach">
      <data key="d0">Lexicon-Based Approach</data>
      <data key="d1">category</data>
      <data key="d2">A methodology in sentiment analysis where the sentiment of a text is determined using a predefined set of sentiment-bearing words.&lt;SEP&gt;A sentiment classification method utilizing precompiled dictionaries of sentiment values to categorize text polarity.</data>
      <data key="d3">chunk-8756bb2d18f7993da0c11080bc5f15a1&lt;SEP&gt;chunk-c672772b311a70f628b5b6b878eb3f37</data>
    </node>
    <node id="SentiWordNet">
      <data key="d0">SentiWordNet</data>
      <data key="d1">category</data>
      <data key="d2">A widely known semi-automatically constructed sentiment lexicon containing over 100,000 English words.</data>
      <data key="d3">chunk-8756bb2d18f7993da0c11080bc5f15a1</data>
    </node>
    <node id="Self-Annotator Agreement">
      <data key="d0">Self-Annotator Agreement</data>
      <data key="d1">category</data>
      <data key="d2">A metric measuring the internal consistency of an individual annotator over time, used to monitor and improve dataset quality.</data>
      <data key="d3">chunk-8756bb2d18f7993da0c11080bc5f15a1</data>
    </node>
    <node id="Twitter Sentiment Classification">
      <data key="d0">Twitter Sentiment Classification</data>
      <data key="d1">category</data>
      <data key="d2">The specialized task of automatically classifying sentiment in Twitter posts using machine learning or lexicon-based methods.</data>
      <data key="d3">chunk-8756bb2d18f7993da0c11080bc5f15a1</data>
    </node>
    <node id="Evaluation Measures">
      <data key="d0">Evaluation Measures</data>
      <data key="d1">category</data>
      <data key="d2">Statistical metrics employed to evaluate annotator agreement and compare the performance of machine learning classifiers.</data>
      <data key="d3">chunk-8756bb2d18f7993da0c11080bc5f15a1</data>
    </node>
    <node id="Emojis Dataset">
      <data key="d0">Emojis Dataset</data>
      <data key="d1">category</data>
      <data key="d2">A dataset covering emoji sentiment annotations, which is subsumed by the 13 language datasets analyzed in the study.&lt;SEP&gt;An application dataset analyzed in the study, characterized by having an exceptionally low self-annotator agreement compared to inter-annotator agreement due to Spanish annotations.&lt;SEP&gt;An application dataset focused on emojis where inter-annotator agreement was exceptionally higher than self-agreement.&lt;SEP&gt;The Emojis Dataset is an application dataset composed of tweets containing emojis extracted across multilingual sentiment corpora.</data>
      <data key="d3">chunk-02b1ce0e6302d1e78683fc67d2a9ca7b&lt;SEP&gt;chunk-3f37521f7c9c4230a9fe0c9f8b7f1604&lt;SEP&gt;chunk-5e3a78f135f3def0507e047f402598df&lt;SEP&gt;chunk-dacb70558821cf911a6e2c412a464f07</data>
    </node>
    <node id="Facebook(it) Dataset">
      <data key="d0">Facebook(it) Dataset</data>
      <data key="d1">category</data>
      <data key="d2">An Italian-language application dataset from Facebook exhibiting high self-agreement and inter-annotator agreement, yet leaving a gap to classifier performance.&lt;SEP&gt;An application dataset within the study originating from Facebook, exhibiting both high inter-annotator agreement and high self-agreement.</data>
      <data key="d3">chunk-02b1ce0e6302d1e78683fc67d2a9ca7b&lt;SEP&gt;chunk-5e3a78f135f3def0507e047f402598df</data>
    </node>
    <node id="TwoPlaneSVMbin">
      <data key="d0">TwoPlaneSVMbin</data>
      <data key="d1">category</data>
      <data key="d2">A machine learning classifier explicitly designed for ordered classes, ranked among the top performers and chosen for interpreting study results.&lt;SEP&gt;A machine learning classifier used to evaluate sentiment classification performance across incrementally sized labeled datasets.&lt;SEP&gt;A specific SVM-based sentiment classification model selected for subsequent analyses due to its consistent placement among the top-performing classifiers.&lt;SEP&gt;TwoPlaneSVMbin is a refined version of TwoPlaneSVM that partitions the feature space around both hyperplanes into bins to determine majority classes and prediction confidence.</data>
      <data key="d3">chunk-02b1ce0e6302d1e78683fc67d2a9ca7b&lt;SEP&gt;chunk-5e3a78f135f3def0507e047f402598df&lt;SEP&gt;chunk-2e9d6cd8b1a1f2b1ece006c42d145e4d&lt;SEP&gt;chunk-2cf0072fd347c405b3a96e6f40b88278</data>
    </node>
    <node id="Albanian Dataset">
      <data key="d0">Albanian Dataset</data>
      <data key="d1">category</data>
      <data key="d2">A language-specific sentiment dataset analyzed in the study that exhibited low self-agreement and low inter-annotator agreement (below 0.2), indicating low annotator quality.&lt;SEP&gt;A sentiment dataset in the Albanian language that exhibited low annotator self-agreement, inter-annotator agreement below 0.2, and classifier performance barely above random.&lt;SEP&gt;A specific language dataset analyzed in the sentiment study, observed to have very low annotator agreement and poor annotation quality.</data>
      <data key="d3">chunk-02b1ce0e6302d1e78683fc67d2a9ca7b&lt;SEP&gt;chunk-5e3a78f135f3def0507e047f402598df&lt;SEP&gt;chunk-dacb70558821cf911a6e2c412a464f07</data>
    </node>
    <node id="Spanish Dataset">
      <data key="d0">Spanish Dataset</data>
      <data key="d1">category</data>
      <data key="d2">A language-specific sentiment dataset analyzed in the study with low agreement values below 0.2, pointing to lower-quality manual annotations that also influenced the Emojis application dataset.&lt;SEP&gt;A sentiment dataset consisting of over 250,000 tweets in Spanish characterized by very low self- and inter-annotator agreement and poor annotation quality.&lt;SEP&gt;A specific language dataset analyzed in the sentiment study that exhibits poor annotation quality and atypical agreement behavior.</data>
      <data key="d3">chunk-02b1ce0e6302d1e78683fc67d2a9ca7b&lt;SEP&gt;chunk-5e3a78f135f3def0507e047f402598df&lt;SEP&gt;chunk-dacb70558821cf911a6e2c412a464f07</data>
    </node>
    <node id="English Texts">
      <data key="d0">English Texts</data>
      <data key="d1">category</data>
      <data key="d2">The dominant linguistic category in previous related work on automated sentiment classification of Twitter posts.</data>
      <data key="d3">chunk-02b1ce0e6302d1e78683fc67d2a9ca7b</data>
    </node>
    <node id="10-Fold Cross-Validation">
      <data key="d0">10-Fold Cross-Validation</data>
      <data key="d1">category</data>
      <data key="d2">10-Fold Cross-Validation is a model evaluation technique, specifically applied here in a blocked and stratified form suitable for time-ordered data.&lt;SEP&gt;A standard machine learning evaluation procedure where the labeled dataset is partitioned into ten folds to iteratively train and evaluate classification models.</data>
      <data key="d3">chunk-02b1ce0e6302d1e78683fc67d2a9ca7b&lt;SEP&gt;chunk-2cf0072fd347c405b3a96e6f40b88278</data>
    </node>
    <node id="Friedman-Nemenyi Test">
      <data key="d0">Friedman-Nemenyi Test</data>
      <data key="d1">category</data>
      <data key="d2">A standard non-parametric statistical test applied to evaluate and compare the performance differences among six machine learning sentiment classifiers.&lt;SEP&gt;A statistical post-hoc test used to determine significant differences in performance among multiple classifiers.&lt;SEP&gt;The Friedman-Nemenyi Test is a statistical evaluation test used to rank multiple classifiers and determine if differences among them are statistically significant.</data>
      <data key="d3">chunk-02b1ce0e6302d1e78683fc67d2a9ca7b&lt;SEP&gt;chunk-2e9d6cd8b1a1f2b1ece006c42d145e4d&lt;SEP&gt;chunk-6b6698485050fd363980b75ae23a237b</data>
    </node>
    <node id="Bootstrapping">
      <data key="d0">Bootstrapping</data>
      <data key="d1">category</data>
      <data key="d2">A statistical resampling method used to estimate confidence intervals for annotator agreement measures.&lt;SEP&gt;Bootstrapping is a statistical resampling method used to approximate sampling distributions and compute 95% confidence intervals for agreement metrics.</data>
      <data key="d3">chunk-02b1ce0e6302d1e78683fc67d2a9ca7b&lt;SEP&gt;chunk-3f37521f7c9c4230a9fe0c9f8b7f1604</data>
    </node>
    <node id="Self-Agreement">
      <data key="d0">Self-Agreement</data>
      <data key="d1">category</data>
      <data key="d2">A measurement category assessing the consistency of annotations when the same annotator labels the same tweet multiple times.&lt;SEP&gt;A metric assessing how consistently an individual annotator labels duplicate items, used to filter out low-quality annotations.&lt;SEP&gt;A metric measuring the internal consistency and reliability of an individual annotator labeling duplicate tweets over time.&lt;SEP&gt;A quality evaluation metric measuring the consistency of a single annotator when labeling the same sample of tweets multiple times.&lt;SEP&gt;An evaluation metric calculated from repeated annotations of the same tweet by the same annotator, serving as an indicator of individual annotator quality and consistency.</data>
      <data key="d3">chunk-d6c58bb9dd0e817dbe019ee67fada1a4&lt;SEP&gt;chunk-e932637d56f9b77201dab132c9f4834c&lt;SEP&gt;chunk-8b53c4d2b0ae2737239adca2c184b25d&lt;SEP&gt;chunk-02b1ce0e6302d1e78683fc67d2a9ca7b&lt;SEP&gt;chunk-dacb70558821cf911a6e2c412a464f07</data>
    </node>
    <node id="Financial Markets">
      <data key="d0">Financial Markets</data>
      <data key="d1">category</data>
      <data key="d2">A specialized topical domain noted as an example where domain-specific vocabulary and task difficulty (such as predicting stock movements) cause annotator disagreement.&lt;SEP&gt;An application domain for sentiment classification models focusing on stock movements, financial terms, and Dow Jones commentary.</data>
      <data key="d3">chunk-02b1ce0e6302d1e78683fc67d2a9ca7b&lt;SEP&gt;chunk-8b53c4d2b0ae2737239adca2c184b25d</data>
    </node>
    <node id="Environmental Issues">
      <data key="d0">Environmental Issues</data>
      <data key="d1">category</data>
      <data key="d2">A domain covering topics such as climate change, fossil fuels, and fracking, utilized to evaluate domain-specific sentiment classification.&lt;SEP&gt;A topical domain cited as contrasting with financial markets, illustrating how different domain vocabularies contribute to annotator disagreement.&lt;SEP&gt;An application domain encompassing topics such as climate change, fossil fuels, and fracking evaluated via sentiment classification.</data>
      <data key="d3">chunk-02b1ce0e6302d1e78683fc67d2a9ca7b&lt;SEP&gt;chunk-8b53c4d2b0ae2737239adca2c184b25d&lt;SEP&gt;chunk-d6c58bb9dd0e817dbe019ee67fada1a4</data>
    </node>
    <node id="Language Datasets">
      <data key="d0">Language Datasets</data>
      <data key="d1">category</data>
      <data key="d2">A collection of 13 multilingual tweet datasets totaling 1.6 million tweets annotated by 83 native speakers to study sentiment classifier performance and agreement limits.</data>
      <data key="d3">chunk-5e3a78f135f3def0507e047f402598df</data>
    </node>
    <node id="English Dataset">
      <data key="d0">English Dataset</data>
      <data key="d1">category</data>
      <data key="d2">A sentiment analysis dataset of English tweets that demonstrated a persistent performance gap between the classifier and inter-annotator agreement.</data>
      <data key="d3">chunk-5e3a78f135f3def0507e047f402598df</data>
    </node>
    <node id="Polish Dataset">
      <data key="d0">Polish Dataset</data>
      <data key="d1">category</data>
      <data key="d2">A sentiment analysis dataset of Polish tweets that reaches peak classifier performance at approximately 150,000 labeled tweets, achieving performance close to its inter-annotator agreement.&lt;SEP&gt;A sentiment dataset of over 200,000 Polish tweets where classifier performance plateaued and approached the inter-annotator agreement upper bound at around 150,000 tweets.</data>
      <data key="d3">chunk-5e3a78f135f3def0507e047f402598df&lt;SEP&gt;chunk-e932637d56f9b77201dab132c9f4834c</data>
    </node>
    <node id="Russian Dataset">
      <data key="d0">Russian Dataset</data>
      <data key="d1">category</data>
      <data key="d2">A sentiment dataset of approximately 90,000 tweets labeled by a single annotator where classifier performance continued to rise with larger training sets.</data>
      <data key="d3">chunk-5e3a78f135f3def0507e047f402598df</data>
    </node>
    <node id="Slovak Dataset">
      <data key="d0">Slovak Dataset</data>
      <data key="d1">category</data>
      <data key="d2">A sentiment dataset containing around 60,000 labeled tweets from a single annotator exhibiting continuing classifier performance improvements.&lt;SEP&gt;A specific language dataset analyzed in the study where normalized agreement exhibited exceptional behavior regarding class distinction difficulty.</data>
      <data key="d3">chunk-5e3a78f135f3def0507e047f402598df&lt;SEP&gt;chunk-dacb70558821cf911a6e2c412a464f07</data>
    </node>
    <node id="DJIA30 Dataset">
      <data key="d0">DJIA30 Dataset</data>
      <data key="d1">category</data>
      <data key="d2">An application dataset related to the Dow Jones Industrial Average 30 where sentiment classifier performance approached its inter-annotator agreement limit.</data>
      <data key="d3">chunk-5e3a78f135f3def0507e047f402598df</data>
    </node>
    <node id="Environment Dataset">
      <data key="d0">Environment Dataset</data>
      <data key="d1">category</data>
      <data key="d2">An application domain sentiment dataset characterized by a notable gap between classifier performance and inter-annotator agreement.</data>
      <data key="d3">chunk-5e3a78f135f3def0507e047f402598df</data>
    </node>
    <node id="Bulgarian Dataset">
      <data key="d0">Bulgarian Dataset</data>
      <data key="d1">category</data>
      <data key="d2">A sentiment analysis dataset of Bulgarian tweets reaching peak classifier performance at 40,000 tweets, but characterized by a very low inter-annotator agreement.&lt;SEP&gt;A sentiment dataset in the Bulgarian language characterized by inter-annotator agreement between 0.3 and 0.4 and relatively low classifier performance around 0.4.</data>
      <data key="d3">chunk-5e3a78f135f3def0507e047f402598df&lt;SEP&gt;chunk-e932637d56f9b77201dab132c9f4834c</data>
    </node>
    <node id="German Dataset">
      <data key="d0">German Dataset</data>
      <data key="d1">category</data>
      <data key="d2">A sentiment analysis dataset of German tweets where over 90% of annotations were performed by two annotators with high disagreement and disparate annotation quality.&lt;SEP&gt;A sentiment dataset in the German language showing inter-annotator agreement between 0.3 and 0.4 and classifier performance around 0.4.</data>
      <data key="d3">chunk-5e3a78f135f3def0507e047f402598df&lt;SEP&gt;chunk-e932637d56f9b77201dab132c9f4834c</data>
    </node>
    <node id="Ser/Cro/Bos Dataset">
      <data key="d0">Ser/Cro/Bos Dataset</data>
      <data key="d1">category</data>
      <data key="d2">A joint sentiment analysis dataset combining Serbian, Croatian, and Bosnian tweets, characterized by low inter-annotator agreement and high classifier performance variability.&lt;SEP&gt;A sentiment dataset covering Serbian, Croatian, and Bosnian languages with inter-annotator agreement between 0.3 and 0.4 and relatively low classifier performance around 0.4.&lt;SEP&gt;The Ser/Cro/Bos Dataset is a multilingual language dataset split into Serbian, Croatian, and Bosnian constituent language files for sentiment analysis.</data>
      <data key="d3">chunk-3f37521f7c9c4230a9fe0c9f8b7f1604&lt;SEP&gt;chunk-5e3a78f135f3def0507e047f402598df&lt;SEP&gt;chunk-e932637d56f9b77201dab132c9f4834c</data>
    </node>
    <node id="Portuguese Dataset">
      <data key="d0">Portuguese Dataset</data>
      <data key="d1">category</data>
      <data key="d2">A sentiment analysis dataset of Portuguese tweets annotated by a single annotator, which exhibits an initial performance peak at 50,000 tweets followed by high performance variability.&lt;SEP&gt;A sentiment dataset in Portuguese with a single annotator, lacking inter-annotator agreement metrics and having classifier performance around 0.4.</data>
      <data key="d3">chunk-5e3a78f135f3def0507e047f402598df&lt;SEP&gt;chunk-e932637d56f9b77201dab132c9f4834c</data>
    </node>
    <node id="Slovenian Dataset">
      <data key="d0">Slovenian Dataset</data>
      <data key="d1">category</data>
      <data key="d2">A sentiment analysis dataset of Slovenian tweets whose classifier performance peaks at 70,000 tweets, with an inter-annotator agreement nearly 10 percentage points lower than Polish.&lt;SEP&gt;A sentiment dataset in the Slovenian language where classifier performance in the range 0.4–0.6 approached the upper bound set by inter-annotator agreement.</data>
      <data key="d3">chunk-5e3a78f135f3def0507e047f402598df&lt;SEP&gt;chunk-e932637d56f9b77201dab132c9f4834c</data>
    </node>
    <node id="Swedish Dataset">
      <data key="d0">Swedish Dataset</data>
      <data key="d1">category</data>
      <data key="d2">A sentiment dataset in Swedish labeled by a single annotator without measured inter-annotator agreement.</data>
      <data key="d3">chunk-5e3a78f135f3def0507e047f402598df</data>
    </node>
    <node id="Hungarian Dataset">
      <data key="d0">Hungarian Dataset</data>
      <data key="d1">category</data>
      <data key="d2">A sentiment dataset in Hungarian labeled by only one annotator, preventing direct calculation of inter-annotator agreement.</data>
      <data key="d3">chunk-5e3a78f135f3def0507e047f402598df</data>
    </node>
    <node id="Application Datasets">
      <data key="d0">Application Datasets</data>
      <data key="d1">category</data>
      <data key="d2">A group of four application-specific sentiment datasets, including Facebook(it), DJIA30, Environment, and Emojis, analyzed alongside language datasets.</data>
      <data key="d3">chunk-5e3a78f135f3def0507e047f402598df</data>
    </node>
    <node id="83 Native Speakers">
      <data key="d0">83 Native Speakers</data>
      <data key="d1">person</data>
      <data key="d2">A pool of 83 native speaker annotators hired to label 1.6 million tweets across 13 languages, totaling an estimated effort of 38 person-months.</data>
      <data key="d3">chunk-5e3a78f135f3def0507e047f402598df</data>
    </node>
    <node id="Annotator A">
      <data key="d0">Annotator A</data>
      <data key="d1">person</data>
      <data key="d2">Annotator A is one of the two primary annotators for the German tweet dataset, characterized by a lower self-agreement score of 0.590 and dataset performance peaking at 30,000 tweets.</data>
      <data key="d3">chunk-e932637d56f9b77201dab132c9f4834c</data>
    </node>
    <node id="Annotator B">
      <data key="d0">Annotator B</data>
      <data key="d1">person</data>
      <data key="d2">Annotator B is one of the two primary annotators for the German tweet dataset, characterized by a higher self-agreement score of 0.760 and consistently increasing classifier performance.</data>
      <data key="d3">chunk-e932637d56f9b77201dab132c9f4834c</data>
    </node>
    <node id="Serbian Dataset">
      <data key="d0">Serbian Dataset</data>
      <data key="d1">category</data>
      <data key="d2">A component dataset comprising 73,783 Serbian tweets annotated by 11 annotators with low inter-annotator and self-agreement scores.</data>
      <data key="d3">chunk-e932637d56f9b77201dab132c9f4834c</data>
    </node>
    <node id="Croatian Dataset">
      <data key="d0">Croatian Dataset</data>
      <data key="d1">category</data>
      <data key="d2">A component dataset comprising 97,291 Croatian tweets annotated by a single annotator with high self-agreement (0.781) and strong classifier performance peaking at 50,000 tweets.</data>
      <data key="d3">chunk-e932637d56f9b77201dab132c9f4834c</data>
    </node>
    <node id="Bosnian Dataset">
      <data key="d0">Bosnian Dataset</data>
      <data key="d1">category</data>
      <data key="d2">A component dataset comprising 44,583 Bosnian tweets annotated by a single annotator with high self-agreement (0.722) and steadily increasing classifier performance.</data>
      <data key="d3">chunk-e932637d56f9b77201dab132c9f4834c</data>
    </node>
    <node id="Croatian Annotator">
      <data key="d0">Croatian Annotator</data>
      <data key="d1">person</data>
      <data key="d2">The sole human annotator who labeled the entire Croatian tweet dataset, exhibiting high self-agreement across repeated annotations.</data>
      <data key="d3">chunk-e932637d56f9b77201dab132c9f4834c</data>
    </node>
    <node id="Bosnian Annotator">
      <data key="d0">Bosnian Annotator</data>
      <data key="d1">person</data>
      <data key="d2">The single annotator responsible for labeling all tweets in the Bosnian dataset, showing strong annotation consistency and high self-agreement.</data>
      <data key="d3">chunk-e932637d56f9b77201dab132c9f4834c</data>
    </node>
    <node id="Portuguese Annotator">
      <data key="d0">Portuguese Annotator</data>
      <data key="d1">person</data>
      <data key="d2">The single annotator engaged to annotate the Portuguese dataset, resulting in an absence of inter-annotator agreement metrics.</data>
      <data key="d3">chunk-e932637d56f9b77201dab132c9f4834c</data>
    </node>
    <node id="Serbian Annotators">
      <data key="d0">Serbian Annotators</data>
      <data key="d1">person</data>
      <data key="d2">A group of 11 annotators who labeled the Serbian dataset, where two annotators accounted for over 40% of annotations but exhibited poor overall agreement.</data>
      <data key="d3">chunk-e932637d56f9b77201dab132c9f4834c</data>
    </node>
    <node id="Sentiment Classifier">
      <data key="d0">Sentiment Classifier</data>
      <data key="d1">category</data>
      <data key="d2">A machine learning model trained on sentiment-labeled tweets whose performance ceiling is closely related to annotation agreement.</data>
      <data key="d3">chunk-e932637d56f9b77201dab132c9f4834c</data>
    </node>
    <node id="Joint Ser/Cro/Bos Model">
      <data key="d0">Joint Ser/Cro/Bos Model</data>
      <data key="d1">category</data>
      <data key="d2">A unified classifier trained on a merged dataset of Serbian, Croatian, and Bosnian tweets, marked by high performance variability.</data>
      <data key="d3">chunk-e932637d56f9b77201dab132c9f4834c</data>
    </node>
    <node id="Croatian Classifier">
      <data key="d0">Croatian Classifier</data>
      <data key="d1">category</data>
      <data key="d2">An individual sentiment model trained solely on Croatian tweets, achieving peak performance at 50,000 tweets.</data>
      <data key="d3">chunk-e932637d56f9b77201dab132c9f4834c</data>
    </node>
    <node id="Bosnian Classifier">
      <data key="d0">Bosnian Classifier</data>
      <data key="d1">category</data>
      <data key="d2">An individual sentiment classifier trained solely on Bosnian tweets, demonstrating continuous performance growth up to 40,000 tweets.</data>
      <data key="d3">chunk-e932637d56f9b77201dab132c9f4834c</data>
    </node>
    <node id="Serbian Classifier">
      <data key="d0">Serbian Classifier</data>
      <data key="d1">category</data>
      <data key="d2">An individual sentiment classification model trained solely on Serbian tweets, converging to a relatively low agreement plateau at 70,000 tweets.</data>
      <data key="d3">chunk-e932637d56f9b77201dab132c9f4834c</data>
    </node>
    <node id="Serbian Language">
      <data key="d0">Serbian Language</data>
      <data key="d1">category</data>
      <data key="d2">A South Slavic language analyzed in short Twitter posts, closely related to Croatian and Bosnian.</data>
      <data key="d3">chunk-e932637d56f9b77201dab132c9f4834c</data>
    </node>
    <node id="Croatian Language">
      <data key="d0">Croatian Language</data>
      <data key="d1">category</data>
      <data key="d2">A South Slavic language analyzed in sentiment classification, structurally similar to Serbian and Bosnian.</data>
      <data key="d3">chunk-e932637d56f9b77201dab132c9f4834c</data>
    </node>
    <node id="Bosnian Language">
      <data key="d0">Bosnian Language</data>
      <data key="d1">category</data>
      <data key="d2">A South Slavic language evaluated in the study, displaying high linguistic similarity to Serbian and Croatian.</data>
      <data key="d3">chunk-e932637d56f9b77201dab132c9f4834c</data>
    </node>
    <node id="Portuguese Government">
      <data key="d0">Portuguese Government</data>
      <data key="d1">organization</data>
      <data key="d2">The Portuguese Government is the governing body that approved additional austerity measures in November 2013 affecting the public sector to prevent an international bailout.</data>
      <data key="d3">chunk-8b53c4d2b0ae2737239adca2c184b25d</data>
    </node>
    <node id="Dow Jones">
      <data key="d0">Dow Jones</data>
      <data key="d1">organization</data>
      <data key="d2">Dow Jones refers to the financial market index and entity whose related stock discussions on Twitter were analyzed for domain-specific sentiment.</data>
      <data key="d3">chunk-8b53c4d2b0ae2737239adca2c184b25d</data>
    </node>
    <node id="Austerity Measures Approval">
      <data key="d0">Austerity Measures Approval</data>
      <data key="d1">event</data>
      <data key="d2">An event in November 2013 where the Portuguese government approved additional public sector austerity measures to avoid a second international bailout, causing significant social media backlash.</data>
      <data key="d3">chunk-8b53c4d2b0ae2737239adca2c184b25d</data>
    </node>
    <node id="Second International Bailout">
      <data key="d0">Second International Bailout</data>
      <data key="d1">event</data>
      <data key="d2">An impending financial bailout that the Portuguese government worked to avoid through the implementation of austerity policies.</data>
      <data key="d3">chunk-8b53c4d2b0ae2737239adca2c184b25d</data>
    </node>
    <node id="Public Sector">
      <data key="d0">Public Sector</data>
      <data key="d1">organization</data>
      <data key="d2">The sector of the Portuguese economy composed of government-controlled enterprises and public services, primarily affected by the 2013 austerity measures.</data>
      <data key="d3">chunk-8b53c4d2b0ae2737239adca2c184b25d</data>
    </node>
    <node id="Spanish Dataset Annotator">
      <data key="d0">Spanish Dataset Annotator</data>
      <data key="d1">person</data>
      <data key="d2">The primary individual who annotated over 95% of the Spanish Twitter dataset, exhibiting low self-agreement and poor annotation quality.</data>
      <data key="d3">chunk-8b53c4d2b0ae2737239adca2c184b25d</data>
    </node>
    <node id="Albanian Main Annotator">
      <data key="d0">Albanian Main Annotator</data>
      <data key="d1">person</data>
      <data key="d2">The primary human annotator who labeled over 22% of the Albanian Twitter dataset, showing low self-agreement and inter-annotator agreement.</data>
      <data key="d3">chunk-8b53c4d2b0ae2737239adca2c184b25d</data>
    </node>
    <node id="Stock Price Prediction">
      <data key="d0">Stock Price Prediction</data>
      <data key="d1">category</data>
      <data key="d2">An application area where domain-specific sentiment classification models are deployed to forecast market trends and financial performance.</data>
      <data key="d3">chunk-8b53c4d2b0ae2737239adca2c184b25d</data>
    </node>
    <node id="Elections Monitoring">
      <data key="d0">Elections Monitoring</data>
      <data key="d1">category</data>
      <data key="d2">An application area where sentiment classification models are applied to monitor public opinion and electoral dynamics on social media.</data>
      <data key="d3">chunk-8b53c4d2b0ae2737239adca2c184b25d</data>
    </node>
    <node id="Climate Change">
      <data key="d0">Climate Change</data>
      <data key="d1">category</data>
      <data key="d2">An environmental issue examined within the domain-specific sentiment classification dataset.&lt;SEP&gt;An environmental subject studied as part of domain-specific sentiment classification research.</data>
      <data key="d3">chunk-8b53c4d2b0ae2737239adca2c184b25d&lt;SEP&gt;chunk-d6c58bb9dd0e817dbe019ee67fada1a4</data>
    </node>
    <node id="Fossil Fuels">
      <data key="d0">Fossil Fuels</data>
      <data key="d1">category</data>
      <data key="d2">A specific environmental subject included in the domain-specific tweet analysis for sentiment scoring.&lt;SEP&gt;An energy and environmental topic evaluated within the domain-specific sentiment analysis dataset.</data>
      <data key="d3">chunk-8b53c4d2b0ae2737239adca2c184b25d&lt;SEP&gt;chunk-d6c58bb9dd0e817dbe019ee67fada1a4</data>
    </node>
    <node id="Fracking">
      <data key="d0">Fracking</data>
      <data key="d1">category</data>
      <data key="d2">A specific industrial extraction process analyzed as a distinct topical component of environmental sentiment analysis.&lt;SEP&gt;An environmental issue cited as part of the domain-specific sentiment analysis dataset.</data>
      <data key="d3">chunk-8b53c4d2b0ae2737239adca2c184b25d&lt;SEP&gt;chunk-d6c58bb9dd0e817dbe019ee67fada1a4</data>
    </node>
    <node id="Emojis">
      <data key="d0">Emojis</data>
      <data key="d1">category</data>
      <data key="d2">Ideograms and smileys used in digital messages, studied to evaluate how contextual tweet sentiment is attributed to them.</data>
      <data key="d3">chunk-d6c58bb9dd0e817dbe019ee67fada1a4</data>
    </node>
    <node id="Spanish Language Dataset">
      <data key="d0">Spanish Language Dataset</data>
      <data key="d1">category</data>
      <data key="d2">A subset of approximately 20,000 Spanish tweets containing emojis, noted for having very low self-agreement among annotators.</data>
      <data key="d3">chunk-d6c58bb9dd0e817dbe019ee67fada1a4</data>
    </node>
    <node id="General English Sentiment Classification Model">
      <data key="d0">General English Sentiment Classification Model</data>
      <data key="d1">category</data>
      <data key="d2">A classification model trained on 90,000 general English tweets used to compare against domain-specific models.</data>
      <data key="d3">chunk-d6c58bb9dd0e817dbe019ee67fada1a4</data>
    </node>
    <node id="Three-Class Sentiment Problem">
      <data key="d0">Three-Class Sentiment Problem</data>
      <data key="d1">category</data>
      <data key="d2">An ordered sentiment classification framework categorizing text into negative, neutral, and positive classes.</data>
      <data key="d3">chunk-d6c58bb9dd0e817dbe019ee67fada1a4</data>
    </node>
    <node id="Training Data Quality">
      <data key="d0">Training Data Quality</data>
      <data key="d1">category</data>
      <data key="d2">A key research dimension evaluated via annotator self-agreement and inter-annotator agreement that strongly impacts model performance.</data>
      <data key="d3">chunk-d6c58bb9dd0e817dbe019ee67fada1a4</data>
    </node>
    <node id="Twitter Acquisition">
      <data key="d0">Twitter Acquisition</data>
      <data key="d1">event</data>
      <data key="d2">The collection process during which over 3 million tweets were gathered, exhibiting sampling distribution differences between training and application sets.</data>
      <data key="d3">chunk-d6c58bb9dd0e817dbe019ee67fada1a4</data>
    </node>
    <node id="Gama System">
      <data key="d0">Gama System</data>
      <data key="d1">organization</data>
      <data key="d2">A company that collected most of the tweet datasets analyzed in the study.&lt;SEP&gt;Gama System is an organization that collaborated on collecting tweets in European languages using its PerceptionAnalytics platform.</data>
      <data key="d3">chunk-2e9d6cd8b1a1f2b1ece006c42d145e4d&lt;SEP&gt;chunk-c672772b311a70f628b5b6b878eb3f37</data>
    </node>
    <node id="Sowa Labs">
      <data key="d0">Sowa Labs</data>
      <data key="d1">organization</data>
      <data key="d2">A company that provided the Goldfinch platform used for sentiment annotations in the study.&lt;SEP&gt;Sowa Labs is an organization that developed and provided the Goldfinch platform for sentiment annotation of short texts.</data>
      <data key="d3">chunk-2e9d6cd8b1a1f2b1ece006c42d145e4d&lt;SEP&gt;chunk-c672772b311a70f628b5b6b878eb3f37</data>
    </node>
    <node id="Dodds et al.">
      <data key="d0">Dodds et al.</data>
      <data key="d1">person</data>
      <data key="d2">Dodds et al. refers to researchers who published multilingual sentiment data that can be used to construct sentiment lexicons.</data>
      <data key="d3">chunk-c672772b311a70f628b5b6b878eb3f37</data>
    </node>
    <node id="Sentiment Categories">
      <data key="d0">Sentiment Categories</data>
      <data key="d1">category</data>
      <data key="d2">Sentiment categories are basic classification labels consisting of negative, neutral, and positive attitudes assigned to text.</data>
      <data key="d3">chunk-c672772b311a70f628b5b6b878eb3f37</data>
    </node>
    <node id="Emotion Categories">
      <data key="d0">Emotion Categories</data>
      <data key="d1">category</data>
      <data key="d2">Emotion categories are finer-grained emotional states such as joy, sadness, and anger used in advanced text analysis.</data>
      <data key="d3">chunk-c672772b311a70f628b5b6b878eb3f37</data>
    </node>
    <node id="Joint Project with Gama System">
      <data key="d0">Joint Project with Gama System</data>
      <data key="d1">event</data>
      <data key="d2">A collaborative data collection initiative conducted between April 2013 and February 2015 to gather tweets across thirteen European languages using PerceptionAnalytics.</data>
      <data key="d3">chunk-c672772b311a70f628b5b6b878eb3f37</data>
    </node>
    <node id="Human Annotators">
      <data key="d0">Human Annotators</data>
      <data key="d1">person</data>
      <data key="d2">A collective group of 83 native-speaking annotators recruited to evaluate, resolve, and label over 1.6 million tweets with sentiment values.</data>
      <data key="d3">chunk-c672772b311a70f628b5b6b878eb3f37</data>
    </node>
    <node id="Entity-Based Sentiment Analysis">
      <data key="d0">Entity-Based Sentiment Analysis</data>
      <data key="d1">category</data>
      <data key="d2">A fine-grained sentiment analysis technique that determines attitudes directed toward specific entities or topics rather than whole posts.</data>
      <data key="d3">chunk-c672772b311a70f628b5b6b878eb3f37</data>
    </node>
    <node id="Figurative Language">
      <data key="d0">Figurative Language</data>
      <data key="d1">category</data>
      <data key="d2">A linguistic category encompassing forms of expression such as irony and sarcasm found in social media posts.</data>
      <data key="d3">chunk-c672772b311a70f628b5b6b878eb3f37</data>
    </node>
    <node id="CLARIN.SI">
      <data key="d0">CLARIN.SI</data>
      <data key="d1">organization</data>
      <data key="d2">CLARIN.SI is a public language resource repository where the 15 language sentiment annotation datasets are hosted and made publicly available.</data>
      <data key="d3">chunk-3f37521f7c9c4230a9fe0c9f8b7f1604</data>
    </node>
    <node id="Annotator Agreement">
      <data key="d0">Annotator Agreement</data>
      <data key="d1">category</data>
      <data key="d2">Annotator Agreement is a statistical and evaluation framework used to measure consensus among human annotators as well as between automated model outputs and gold-standard annotations.</data>
      <data key="d3">chunk-3f37521f7c9c4230a9fe0c9f8b7f1604</data>
    </node>
    <node id="Krippendorff's Alpha-Reliability">
      <data key="d0">Krippendorff's Alpha-Reliability</data>
      <data key="d1">category</data>
      <data key="d2">Krippendorff's Alpha-reliability is a generalized statistical measure of inter-rater agreement applicable to different metric types and numbers of annotators, measuring observed against expected chance disagreement.</data>
      <data key="d3">chunk-3f37521f7c9c4230a9fe0c9f8b7f1604</data>
    </node>
    <node id="F Score">
      <data key="d0">F Score</data>
      <data key="d1">category</data>
      <data key="d2">The F score is an effectiveness metric from information retrieval and machine learning, defined as the harmonic mean of precision and recall and adapted for 3-class sentiment classifier evaluation.</data>
      <data key="d3">chunk-3f37521f7c9c4230a9fe0c9f8b7f1604</data>
    </node>
    <node id="Coincidence Matrix">
      <data key="d0">Coincidence Matrix</data>
      <data key="d1">category</data>
      <data key="d2">A coincidence matrix is a symmetric square contingency matrix that tabulates pairable annotation values from different annotators to compute observed and expected disagreements.&lt;SEP&gt;A symmetric matrix structure used to compute evaluation measures and annotator agreement from pairs of sentiment labels.</data>
      <data key="d3">chunk-3f37521f7c9c4230a9fe0c9f8b7f1604&lt;SEP&gt;chunk-dacb70558821cf911a6e2c412a464f07</data>
    </node>
    <node id="Gold Standard">
      <data key="d0">Gold Standard</data>
      <data key="d1">category</data>
      <data key="d2">A gold standard is a benchmark reference dataset constructed from high-agreement human annotations used to train and evaluate automated classification models.&lt;SEP&gt;The benchmark reference dataset of ground-truth sentiment labels against which model predictions and agreement are evaluated.</data>
      <data key="d3">chunk-3f37521f7c9c4230a9fe0c9f8b7f1604&lt;SEP&gt;chunk-dacb70558821cf911a6e2c412a464f07</data>
    </node>
    <node id="15 Language Datasets">
      <data key="d0">15 Language Datasets</data>
      <data key="d1">category</data>
      <data key="d2">The 15 language datasets comprise public sentiment annotation corpora containing labeled tweets partitioned across 15 distinct languages.</data>
      <data key="d3">chunk-3f37521f7c9c4230a9fe0c9f8b7f1604</data>
    </node>
    <node id="Negative Sentiment">
      <data key="d0">Negative Sentiment</data>
      <data key="d1">category</data>
      <data key="d2">Negative sentiment is an extreme classification category representing unfavorable sentiment, positioned at one end of the ordered sentiment scale.</data>
      <data key="d3">chunk-dacb70558821cf911a6e2c412a464f07</data>
    </node>
    <node id="Neutral Sentiment">
      <data key="d0">Neutral Sentiment</data>
      <data key="d1">category</data>
      <data key="d2">Neutral sentiment is the intermediate classification category positioned between the negative and positive classes, presenting higher distinction difficulty for annotators.</data>
      <data key="d3">chunk-dacb70558821cf911a6e2c412a464f07</data>
    </node>
    <node id="Positive Sentiment">
      <data key="d0">Positive Sentiment</data>
      <data key="d1">category</data>
      <data key="d2">Positive sentiment is an extreme classification category representing favorable sentiment, positioned opposite negative sentiment in the ordered scale.</data>
      <data key="d3">chunk-dacb70558821cf911a6e2c412a464f07</data>
    </node>
    <node id="Sentiment Values">
      <data key="d0">Sentiment Values</data>
      <data key="d1">category</data>
      <data key="d2">Sentiment values represent the three-class ordered categorical scale (negative, neutral, positive) used in annotating and evaluating sentiment.</data>
      <data key="d3">chunk-dacb70558821cf911a6e2c412a464f07</data>
    </node>
    <node id="Accuracy Within 1">
      <data key="d0">Accuracy Within 1</data>
      <data key="d1">category</data>
      <data key="d2">A relaxed accuracy evaluation metric that assumes ordered sentiment classes and treats classifications between adjacent categories as acceptable, penalizing only extreme misclassifications.</data>
      <data key="d3">chunk-dacb70558821cf911a6e2c412a464f07</data>
    </node>
    <node id="Annotator">
      <data key="d0">Annotator</data>
      <data key="d1">person</data>
      <data key="d2">A human judge responsible for reading tweets and assigning sentiment labels, whose pairwise decisions determine agreement metrics.</data>
      <data key="d3">chunk-dacb70558821cf911a6e2c412a464f07</data>
    </node>
    <node id="CrowdFlower">
      <data key="d0">CrowdFlower</data>
      <data key="d1">organization</data>
      <data key="d2">CrowdFlower is a crowdsourcing company offering the 'Data for Everyone' collection, which includes publicly available Twitter sentiment datasets.</data>
      <data key="d3">chunk-3194fa4581f2aaec823530e030775b2e</data>
    </node>
    <node id="SemEval-2015">
      <data key="d0">SemEval-2015</data>
      <data key="d1">event</data>
      <data key="d2">SemEval-2015 is an international natural language processing competition that featured a task on Sentiment Analysis on Twitter.</data>
      <data key="d3">chunk-3194fa4581f2aaec823530e030775b2e</data>
    </node>
    <node id="Saif">
      <data key="d0">Saif</data>
      <data key="d1">person</data>
      <data key="d2">Saif is a researcher who, with colleagues, described multiple Twitter sentiment datasets and introduced a dataset with entity-level sentiment labels.</data>
      <data key="d3">chunk-3194fa4581f2aaec823530e030775b2e</data>
    </node>
    <node id="Rosenthal">
      <data key="d0">Rosenthal</data>
      <data key="d1">person</data>
      <data key="d2">Rosenthal is a researcher who provided statistical overviews for the 2013–2015 SemEval datasets.</data>
      <data key="d3">chunk-3194fa4581f2aaec823530e030775b2e</data>
    </node>
    <node id="Haldenwang">
      <data key="d0">Haldenwang</data>
      <data key="d1">person</data>
      <data key="d2">Haldenwang is a researcher who co-presented a publicly available Twitter dataset labeled with positive, negative, uncertain, or spam sentiment.</data>
      <data key="d3">chunk-3194fa4581f2aaec823530e030775b2e</data>
    </node>
    <node id="Vornberger">
      <data key="d0">Vornberger</data>
      <data key="d1">person</data>
      <data key="d2">Vornberger is a researcher who co-presented a publicly available Twitter dataset labeled for sentiment and spam.</data>
      <data key="d3">chunk-3194fa4581f2aaec823530e030775b2e</data>
    </node>
    <node id="Pak">
      <data key="d0">Pak</data>
      <data key="d1">person</data>
      <data key="d2">Pak is a researcher who studied Twitter sentiment classification comparing Naive Bayes, SVM, and Conditional Random Fields.</data>
      <data key="d3">chunk-3194fa4581f2aaec823530e030775b2e</data>
    </node>
    <node id="Paroubek">
      <data key="d0">Paroubek</data>
      <data key="d1">person</data>
      <data key="d2">Paroubek is a researcher who co-authored a study demonstrating that Naive Bayes outperformed SVM and Conditional Random Fields.</data>
      <data key="d3">chunk-3194fa4581f2aaec823530e030775b2e</data>
    </node>
    <node id="Asiaee">
      <data key="d0">Asiaee</data>
      <data key="d1">person</data>
      <data key="d2">Asiaee is a researcher who explored dictionary learning, weighted SVM, k-Nearest-Neighbor, and Naive Bayes for sentiment analysis.</data>
      <data key="d3">chunk-3194fa4581f2aaec823530e030775b2e</data>
    </node>
    <node id="Jiang">
      <data key="d0">Jiang</data>
      <data key="d1">person</data>
      <data key="d2">Jiang is a researcher who applied SVM models for subjectivity and polarity classification of Twitter posts.</data>
      <data key="d3">chunk-3194fa4581f2aaec823530e030775b2e</data>
    </node>
    <node id="Davidov">
      <data key="d0">Davidov</data>
      <data key="d1">person</data>
      <data key="d2">Davidov is a researcher who applied k-Nearest-Neighbor models for Twitter sentiment classification.</data>
      <data key="d3">chunk-3194fa4581f2aaec823530e030775b2e</data>
    </node>
    <node id="Kouloumpis">
      <data key="d0">Kouloumpis</data>
      <data key="d1">person</data>
      <data key="d2">Kouloumpis is a researcher who employed AdaBoost.MH and SVMs for Twitter sentiment classification.</data>
      <data key="d3">chunk-3194fa4581f2aaec823530e030775b2e</data>
    </node>
    <node id="Maximum Entropy">
      <data key="d0">Maximum Entropy</data>
      <data key="d1">category</data>
      <data key="d2">Maximum Entropy is a machine learning classification algorithm commonly applied to text and sentiment analysis.</data>
      <data key="d3">chunk-3194fa4581f2aaec823530e030775b2e</data>
    </node>
    <node id="K-Nearest-Neighbor">
      <data key="d0">K-Nearest-Neighbor</data>
      <data key="d1">category</data>
      <data key="d2">K-Nearest-Neighbor is an instance-based supervised learning algorithm applied to text and sentiment classification.</data>
      <data key="d3">chunk-3194fa4581f2aaec823530e030775b2e</data>
    </node>
    <node id="Decision Trees">
      <data key="d0">Decision Trees</data>
      <data key="d1">category</data>
      <data key="d2">Decision Trees is a non-parametric supervised learning algorithm used for classification and regression tasks, evaluated in sentiment analysis studies.</data>
      <data key="d3">chunk-3194fa4581f2aaec823530e030775b2e</data>
    </node>
    <node id="AdaBoost.MH">
      <data key="d0">AdaBoost.MH</data>
      <data key="d1">category</data>
      <data key="d2">AdaBoost.MH is a multi-class boosting algorithm tested for sentiment classification of Twitter posts.</data>
      <data key="d3">chunk-3194fa4581f2aaec823530e030775b2e</data>
    </node>
    <node id="NeutralZoneSVM">
      <data key="d0">NeutralZoneSVM</data>
      <data key="d1">category</data>
      <data key="d2">NeutralZoneSVM is an extension of the binary SVM classifier that identifies neutral sentiment by detecting tweets close to the decision hyperplane.&lt;SEP&gt;NeutralZoneSVM is an extension of the two-class Support Vector Machine classifier that assumes neutral tweets fall between positive and negative tweets.</data>
      <data key="d3">chunk-2cf0072fd347c405b3a96e6f40b88278&lt;SEP&gt;chunk-3194fa4581f2aaec823530e030775b2e</data>
    </node>
    <node id="LATINO Library">
      <data key="d0">LATINO Library</data>
      <data key="d1">organization</data>
      <data key="d2">An open-source software library for text mining in which classification algorithms and evaluation procedures were implemented by Sašo Rutar.&lt;SEP&gt;LATINO Library is an open-source software project providing a lightweight suite of components for text mining and machine learning applications.</data>
      <data key="d3">chunk-2e9d6cd8b1a1f2b1ece006c42d145e4d&lt;SEP&gt;chunk-3194fa4581f2aaec823530e030775b2e</data>
    </node>
    <node id="TwoPlaneSVM">
      <data key="d0">TwoPlaneSVM</data>
      <data key="d1">category</data>
      <data key="d2">TwoPlaneSVM is an ordinal classification approach consisting of two SVM classifiers separating negative, neutral, and positive classes using two hyperplanes.</data>
      <data key="d3">chunk-2cf0072fd347c405b3a96e6f40b88278</data>
    </node>
    <node id="CascadingSVM">
      <data key="d0">CascadingSVM</data>
      <data key="d1">category</data>
      <data key="d2">CascadingSVM is a two-stage classifier that first separates neutral objective tweets from subjective tweets, and then classifies subjective tweets into negative or positive.</data>
      <data key="d3">chunk-2cf0072fd347c405b3a96e6f40b88278</data>
    </node>
    <node id="ThreePlaneSVM">
      <data key="d0">ThreePlaneSVM</data>
      <data key="d1">category</data>
      <data key="d2">A machine learning classifier evaluated in the study that placed among the top group of indistinguishable classifiers.&lt;SEP&gt;ThreePlaneSVM is a multi-class SVM classifier operating in a one-vs-one setting with three binary classifiers treating sentiment classes as nominal and unordered.</data>
      <data key="d3">chunk-2e9d6cd8b1a1f2b1ece006c42d145e4d&lt;SEP&gt;chunk-2cf0072fd347c405b3a96e6f40b88278</data>
    </node>
    <node id="NaiveBayes">
      <data key="d0">NaiveBayes</data>
      <data key="d1">category</data>
      <data key="d2">NaiveBayes is a standard supervised probabilistic machine learning classifier based on Bayes' theorem used as a baseline.</data>
      <data key="d3">chunk-2cf0072fd347c405b3a96e6f40b88278</data>
    </node>
    <node id="Friedman Test">
      <data key="d0">Friedman Test</data>
      <data key="d1">category</data>
      <data key="d2">The Friedman test is a non-parametric statistical ranking test used to detect significant performance differences across multiple classifiers on multiple datasets.</data>
      <data key="d3">chunk-2cf0072fd347c405b3a96e6f40b88278</data>
    </node>
    <node id="Nemenyi Test">
      <data key="d0">Nemenyi Test</data>
      <data key="d1">category</data>
      <data key="d2">A post-hoc statistical test that computes the critical distance to evaluate pairwise performance differences between all classifiers.&lt;SEP&gt;The Nemenyi test is a post-hoc statistical test used to compute critical distances and perform pairwise comparisons between multiple classifiers after the Friedman test.</data>
      <data key="d3">chunk-2e9d6cd8b1a1f2b1ece006c42d145e4d&lt;SEP&gt;chunk-2cf0072fd347c405b3a96e6f40b88278</data>
    </node>
    <node id="ANOVA">
      <data key="d0">ANOVA</data>
      <data key="d1">category</data>
      <data key="d2">ANOVA is a standard statistical method for testing significant differences among multiple classifiers, of which the Friedman test is a non-parametric counterpart.</data>
      <data key="d3">chunk-2cf0072fd347c405b3a96e6f40b88278</data>
    </node>
    <node id="Latinolib">
      <data key="d0">Latinolib</data>
      <data key="d1">category</data>
      <data key="d2">Latinolib is an open-source software library or suite of text mining and machine learning applications hosted on GitHub.</data>
      <data key="d3">chunk-2cf0072fd347c405b3a96e6f40b88278</data>
    </node>
    <node id="Bonferroni-Dunn Test">
      <data key="d0">Bonferroni-Dunn Test</data>
      <data key="d1">category</data>
      <data key="d2">The Bonferroni-Dunn test is a post-hoc statistical test used to compare a set of classifiers against a single control classifier after a null hypothesis rejection.</data>
      <data key="d3">chunk-2cf0072fd347c405b3a96e6f40b88278</data>
    </node>
    <node id="Delta TF-IDF">
      <data key="d0">Delta TF-IDF</data>
      <data key="d1">category</data>
      <data key="d2">Delta TF-IDF is a feature weighting and vectorization scheme applied to pre-processed text data to construct feature vectors for sentiment classification.</data>
      <data key="d3">chunk-2cf0072fd347c405b3a96e6f40b88278</data>
    </node>
    <node id="ARRS">
      <data key="d0">ARRS</data>
      <data key="d1">organization</data>
      <data key="d2">The Slovenian research agency whose Knowledge Technologies programme partially supported this study.</data>
      <data key="d3">chunk-2e9d6cd8b1a1f2b1ece006c42d145e4d</data>
    </node>
    <node id="Sašo Rutar">
      <data key="d0">Sašo Rutar</data>
      <data key="d1">person</data>
      <data key="d2">A developer and researcher acknowledged for implementing classification algorithms and evaluation procedures in the LATINO text mining library.</data>
      <data key="d3">chunk-2e9d6cd8b1a1f2b1ece006c42d145e4d</data>
    </node>
    <node id="Mojca Mikac">
      <data key="d0">Mojca Mikac</data>
      <data key="d1">person</data>
      <data key="d2">A researcher acknowledged for computing Krippendorff's confidence intervals for the study.</data>

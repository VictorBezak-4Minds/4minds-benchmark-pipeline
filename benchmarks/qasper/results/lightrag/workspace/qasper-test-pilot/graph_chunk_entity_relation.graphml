      <data key="d3">chunk-3e6c6ba3246066dafb17ed3cbf673534</data>
    </node>
    <node id="DARPA">
      <data key="d0">DARPA</data>
      <data key="d1">organization</data>
      <data key="d2">DARPA (Defense Advanced Research Projects Agency) is a United States government agency that provided research funding under grant HR0011-15-C-0115.&lt;SEP&gt;The Defense Advanced Research Projects Agency, a United States government agency that funded the research under grant #HR001117S0026-AIDA-FP-045.</data>
      <data key="d3">chunk-3e6c6ba3246066dafb17ed3cbf673534&lt;SEP&gt;chunk-7818b9847aa576cb0d1559c6c5e963ca</data>
    </node>
    <node id="Wieting">
      <data key="d0">Wieting</data>
      <data key="d1">person</data>
      <data key="d2">A researcher cited for foundational work on character n-grams and word embedding construction in 2016.</data>
      <data key="d3">chunk-3e6c6ba3246066dafb17ed3cbf673534</data>
    </node>
    <node id="Human Activity Prediction">
      <data key="d0">Human Activity Prediction</data>
      <data key="d1">category</data>
      <data key="d2">A computational task aimed at inferring and predicting human behaviors and activities based on user-generated content from social platforms.</data>
      <data key="d3">chunk-3e6c6ba3246066dafb17ed3cbf673534</data>
    </node>
    <node id="Neural Language Model">
      <data key="d0">Neural Language Model</data>
      <data key="d1">category</data>
      <data key="d2">A statistical model using neural networks to learn representations of text sequences and predict language probabilities.&lt;SEP&gt;A two-layer LSTM RNN with 1000 hidden states trained using noise-contrastive estimation and dropout, used for re-scoring translation hypotheses.</data>
      <data key="d3">chunk-3c17cbdd46b3ef569862a8fa188b4fab&lt;SEP&gt;chunk-3e6c6ba3246066dafb17ed3cbf673534</data>
    </node>
    <node id="Penn Treebank">
      <data key="d0">Penn Treebank</data>
      <data key="d1">category</data>
      <data key="d2">A standard benchmark text corpus and dataset widely used for evaluating word-level language modeling performance.&lt;SEP&gt;A widely used benchmark language modeling dataset used to evaluate the perplexity and performance of neural language models.&lt;SEP&gt;A widely used natural language processing benchmark dataset utilized to evaluate the performance of language models.&lt;SEP&gt;Penn Treebank (PTB) is a standard benchmark text corpus and dataset used to evaluate language modeling perplexity.&lt;SEP&gt;Penn Treebank is a benchmark NLP dataset and resource category referenced as a catalyst for driving progress in syntactic parsing.</data>
      <data key="d3">chunk-cc4f52a592e1970d14c92e285c600305&lt;SEP&gt;chunk-3e6c6ba3246066dafb17ed3cbf673534&lt;SEP&gt;chunk-37ae86766195404daaa0c376964357ce&lt;SEP&gt;chunk-ad4815afd1a11fd7bc1c72c7da255e9c&lt;SEP&gt;chunk-af2c44c466ad216bc8f3bec17868b71f</data>
    </node>
    <node id="WikiText-2">
      <data key="d0">WikiText-2</data>
      <data key="d1">category</data>
      <data key="d2">A curated language modeling benchmark dataset extracted from Wikipedia articles used to test neural model perplexity.&lt;SEP&gt;A curated language modeling benchmark dataset extracted from Wikipedia articles.&lt;SEP&gt;A standard benchmark dataset derived from Wikipedia articles used for training and evaluating language modeling systems.&lt;SEP&gt;WikiText-2 (WT2) is a language modeling benchmark dataset consisting of high-quality Wikipedia articles.</data>
      <data key="d3">chunk-3e6c6ba3246066dafb17ed3cbf673534&lt;SEP&gt;chunk-37ae86766195404daaa0c376964357ce&lt;SEP&gt;chunk-ad4815afd1a11fd7bc1c72c7da255e9c&lt;SEP&gt;chunk-cc4f52a592e1970d14c92e285c600305</data>
    </node>
    <node id="WikiText-103">
      <data key="d0">WikiText-103</data>
      <data key="d1">category</data>
      <data key="d2">A large-scale corpus of Wikipedia articles used as a standard benchmark for evaluating neural language modeling architectures.&lt;SEP&gt;A large-scale language modeling benchmark dataset derived from Wikipedia used to assess model capability on long-term dependencies.&lt;SEP&gt;A large-scale language modeling benchmark dataset derived from Wikipedia, characterized by a substantial vocabulary size.&lt;SEP&gt;WikiText-103 (WT103) is a large-scale language modeling dataset derived from Wikipedia used to benchmark perplexity.</data>
      <data key="d3">chunk-3e6c6ba3246066dafb17ed3cbf673534&lt;SEP&gt;chunk-37ae86766195404daaa0c376964357ce&lt;SEP&gt;chunk-ad4815afd1a11fd7bc1c72c7da255e9c&lt;SEP&gt;chunk-cc4f52a592e1970d14c92e285c600305</data>
    </node>
    <node id="Headline Generation">
      <data key="d0">Headline Generation</data>
      <data key="d1">category</data>
      <data key="d2">A natural language generation application task focused on generating concise headlines, used to evaluate neural language models.&lt;SEP&gt;A natural language generation task focusing on producing concise headlines from source text using neural models.&lt;SEP&gt;A natural language processing summarization task aimed at creating concise headlines from sentence-level input.&lt;SEP&gt;A natural language processing task used to evaluate text generation and summarization models via ROUGE scores.&lt;SEP&gt;A text summarization and generation task category evaluated to test the efficacy of the proposed model architectures.&lt;SEP&gt;Headline generation is an application task evaluated in the paper using neural encoder-decoder models to test text generation performance.</data>
      <data key="d3">chunk-90319301f543fcb7182148725008750f&lt;SEP&gt;chunk-cc4f52a592e1970d14c92e285c600305&lt;SEP&gt;chunk-e759311c40b86a32804c73d3e9508819&lt;SEP&gt;chunk-3e6c6ba3246066dafb17ed3cbf673534&lt;SEP&gt;chunk-37ae86766195404daaa0c376964357ce&lt;SEP&gt;chunk-ad4815afd1a11fd7bc1c72c7da255e9c</data>
    </node>
    <node id="Summarization">
      <data key="d0">Summarization</data>
      <data key="d1">category</data>
      <data key="d2">A natural language generation task where neural encoder-decoder language models are applied to condense text while preserving meaning.</data>
      <data key="d3">chunk-3e6c6ba3246066dafb17ed3cbf673534</data>
    </node>
    <node id="Dialogue">
      <data key="d0">Dialogue</data>
      <data key="d1">category</data>
      <data key="d2">An NLP application area where conditional neural language models are used for interactive conversational systems.</data>
      <data key="d3">chunk-3e6c6ba3246066dafb17ed3cbf673534</data>
    </node>
    <node id="Caption Generation">
      <data key="d0">Caption Generation</data>
      <data key="d1">category</data>
      <data key="d2">A natural language generation task focused on producing descriptive text for media, framed as conditional neural language modeling.</data>
      <data key="d3">chunk-3e6c6ba3246066dafb17ed3cbf673534</data>
    </node>
    <node id="Encoder-Decoder Models">
      <data key="d0">Encoder-Decoder Models</data>
      <data key="d1">category</data>
      <data key="d2">A neural network architectural framework that translates input sequences to output sequences, serving as conditional neural language models.</data>
      <data key="d3">chunk-3e6c6ba3246066dafb17ed3cbf673534</data>
    </node>
    <node id="Character N-Gram Embeddings">
      <data key="d0">Character N-Gram Embeddings</data>
      <data key="d1">category</data>
      <data key="d2">Character n-gram embeddings represent subword character sequences, used to enrich word representations and subword embeddings in neural models.&lt;SEP&gt;Subword embedding representations utilized to capture morphological features alongside word embeddings.&lt;SEP&gt;Subword vector representations that capture the internal morphological structure of words to enhance word embeddings and language models.</data>
      <data key="d3">chunk-3e6c6ba3246066dafb17ed3cbf673534&lt;SEP&gt;chunk-af6147035553ac26ef0837a5ab654f4f&lt;SEP&gt;chunk-ad4815afd1a11fd7bc1c72c7da255e9c</data>
    </node>
    <node id="RNN Language Models">
      <data key="d0">RNN Language Models</data>
      <data key="d1">category</data>
      <data key="d2">A specific architecture of neural language models based on recurrent neural networks that encode sequential text into fixed-length vectors to estimate conditional word probabilities.&lt;SEP&gt;Recurrent neural network language models are sequence models enhanced with character n-gram representations to achieve improved perplexity scores.</data>
      <data key="d3">chunk-37ae86766195404daaa0c376964357ce&lt;SEP&gt;chunk-ad4815afd1a11fd7bc1c72c7da255e9c</data>
    </node>
    <node id="Character N-gram Embeddings">
      <data key="d0">Character N-gram Embeddings</data>
      <data key="d1">category</data>
      <data key="d2">A representation technique capturing internal word structures and character sequences to improve vocabulary representations and handle infrequent words.</data>
      <data key="d3">chunk-37ae86766195404daaa0c376964357ce</data>
    </node>
    <node id="Multi-Dimensional Self-Attention">
      <data key="d0">Multi-Dimensional Self-Attention</data>
      <data key="d1">category</data>
      <data key="d2">A neural attention mechanism that computes multi-dimensional attention weights to construct word representations from character n-gram embeddings.&lt;SEP&gt;An attention mechanism category applied to character n-gram embeddings to construct word representations more effectively than scalar self-attention or CNNs.&lt;SEP&gt;An attention mechanism that computes dimension-specific weights across input embeddings to aggregate character n-gram embeddings into a word vector.&lt;SEP&gt;Multi-dimensional self-attention is an attention mechanism used to encode character n-gram embeddings into composite representations.</data>
      <data key="d3">chunk-37ae86766195404daaa0c376964357ce&lt;SEP&gt;chunk-e759311c40b86a32804c73d3e9508819&lt;SEP&gt;chunk-ad4815afd1a11fd7bc1c72c7da255e9c&lt;SEP&gt;chunk-cc4f52a592e1970d14c92e285c600305</data>
    </node>
    <node id="Char-MS-vec">
      <data key="d0">Char-MS-vec</data>
      <data key="d1">category</data>
      <data key="d2">A proposed word embedding constructed by encoding character n-gram embeddings using simplified multi-dimensional self-attention, combined with standard word embeddings as input to language models.</data>
      <data key="d3">chunk-37ae86766195404daaa0c376964357ce</data>
    </node>
    <node id="Character Embeddings">
      <data key="d0">Character Embeddings</data>
      <data key="d1">category</data>
      <data key="d2">Vector representations of single characters used to capture subword morphological structure and concatenated with or transformed into word embeddings.</data>
      <data key="d3">chunk-37ae86766195404daaa0c376964357ce</data>
    </node>
    <node id="Quasi-Recurrent Neural Network">
      <data key="d0">Quasi-Recurrent Neural Network</data>
      <data key="d1">category</data>
      <data key="d2">An alternative recurrent neural network architecture (QRNN) that can serve as the abstract recurrent transition function in language models.</data>
      <data key="d3">chunk-37ae86766195404daaa0c376964357ce</data>
    </node>
    <node id="Neural Encoder-Decoder Model">
      <data key="d0">Neural Encoder-Decoder Model</data>
      <data key="d1">category</data>
      <data key="d2">A neural sequence-to-sequence model architecture evaluated on generation tasks such as machine translation and headline generation.</data>
      <data key="d3">chunk-37ae86766195404daaa0c376964357ce</data>
    </node>
    <node id="Additive Composition">
      <data key="d0">Additive Composition</data>
      <data key="d1">category</data>
      <data key="d2">A compositionality technique that computes the weighted or element-wise sum of subword vectors to construct composite word representations.</data>
      <data key="d3">chunk-37ae86766195404daaa0c376964357ce</data>
    </node>
    <node id="Softmax Function">
      <data key="d0">Softmax Function</data>
      <data key="d1">category</data>
      <data key="d2">A mathematical normalization function applied row-wise in multi-dimensional self-attention to compute attention weight matrices.&lt;SEP&gt;Softmax Function is a mathematical function category used to approximate indicator functions smoothly for set size and link calculations.</data>
      <data key="d3">chunk-e8c71ebe855cec9ba2150fa3ef2be8c9&lt;SEP&gt;chunk-37ae86766195404daaa0c376964357ce</data>
    </node>
    <node id="IWSLT 2016">
      <data key="d0">IWSLT 2016</data>
      <data key="d1">event</data>
      <data key="d2">The International Workshop on Spoken Language Translation 2016, an event providing benchmark datasets for machine translation evaluation.</data>
      <data key="d3">chunk-cc4f52a592e1970d14c92e285c600305</data>
    </node>
    <node id="Word-Level Language Modeling">
      <data key="d0">Word-Level Language Modeling</data>
      <data key="d1">category</data>
      <data key="d2">A fundamental natural language processing task focused on predicting subsequent words in a sequence given preceding context.</data>
      <data key="d3">chunk-cc4f52a592e1970d14c92e285c600305</data>
    </node>
    <node id="English Gigaword">
      <data key="d0">English Gigaword</data>
      <data key="d1">category</data>
      <data key="d2">A comprehensive archive of newswire text data utilized for creating sentence-headline pairs in headline generation tasks.</data>
      <data key="d3">chunk-cc4f52a592e1970d14c92e285c600305</data>
    </node>
    <node id="Word Tying">
      <data key="d0">Word Tying</data>
      <data key="d1">category</data>
      <data key="d2">A parameter-sharing method in language modeling that binds the input word embedding matrix with the output softmax weight matrix.&lt;SEP&gt;A regularization technique in neural language modeling where input and output embedding weights are shared to reduce parameters and prevent over-fitting.</data>
      <data key="d3">chunk-e759311c40b86a32804c73d3e9508819&lt;SEP&gt;chunk-cc4f52a592e1970d14c92e285c600305</data>
    </node>
    <node id="AWD-LSTM">
      <data key="d0">AWD-LSTM</data>
      <data key="d1">category</data>
      <data key="d2">An ASGD Weight-Dropped Long Short-Term Memory neural network architecture used as a competitive baseline for language modeling.</data>
      <data key="d3">chunk-cc4f52a592e1970d14c92e285c600305</data>
    </node>
    <node id="QRNN">
      <data key="d0">QRNN</data>
      <data key="d1">category</data>
      <data key="d2">Quasi-Recurrent Neural Network architecture employed as a strong baseline model for large-scale language modeling on WikiText-103.</data>
      <data key="d3">chunk-cc4f52a592e1970d14c92e285c600305</data>
    </node>
    <node id="Recurrent Highway Networks">
      <data key="d0">Recurrent Highway Networks</data>
      <data key="d1">category</data>
      <data key="d2">A neural network architecture with deep recurrent transition layers compared against standard LSTMs in language modeling tasks.</data>
      <data key="d3">chunk-cc4f52a592e1970d14c92e285c600305</data>
    </node>
    <node id="Averaged Stochastic Gradient Descent">
      <data key="d0">Averaged Stochastic Gradient Descent</data>
      <data key="d1">category</data>
      <data key="d2">An optimization algorithm incorporating historical parameter averaging, used to train weight-dropped LSTM models.</data>
      <data key="d3">chunk-cc4f52a592e1970d14c92e285c600305</data>
    </node>
    <node id="Character N-Gram">
      <data key="d0">Character N-Gram</data>
      <data key="d1">category</data>
      <data key="d2">Contiguous sequences of n characters extracted from words, used to derive subword embeddings via self-attention.</data>
      <data key="d3">chunk-cc4f52a592e1970d14c92e285c600305</data>
    </node>
    <node id="Char-MS-Vec">
      <data key="d0">Char-MS-Vec</data>
      <data key="d1">category</data>
      <data key="d2">A character-level multi-dimensional self-attention vector representation method evaluated across language modeling and machine translation tasks.</data>
      <data key="d3">chunk-cc4f52a592e1970d14c92e285c600305</data>
    </node>
    <node id="Perplexity">
      <data key="d0">Perplexity</data>
      <data key="d1">category</data>
      <data key="d2">A standard statistical evaluation metric used to assess the prediction performance and quality of language models.&lt;SEP&gt;An information-theoretic evaluation and similarity metric derived from cross-entropy, measuring how well a probability model predicts a sample.&lt;SEP&gt;An information-theoretic metric used to measure how well a probability model predicts sample text, frequently used in language modeling and dialogue evaluation.</data>
      <data key="d3">chunk-9539a4c4fcbd235bc0ccbc8f3fd26a81&lt;SEP&gt;chunk-eb3ab7fc50f538bef2c8ddb57a8a6b95&lt;SEP&gt;chunk-cc4f52a592e1970d14c92e285c600305</data>
    </node>
    <node id="NVIDIA">
      <data key="d0">NVIDIA</data>
      <data key="d1">organization</data>
      <data key="d2">A multinational technology corporation known for designing and manufacturing graphics processing units; its TITAN X GPU was utilized to run the neural network model.&lt;SEP&gt;A technology company whose Titan-X GPU hardware was used to execute computations for the sentence simplification models.&lt;SEP&gt;NVIDIA is a technology and computing company whose Tesla P100 hardware was used to benchmark computational speed in the study.&lt;SEP&gt;NVIDIA is a technology company that designs graphics processing units and hardware, including the Tesla P100 GPU utilized in the paper to benchmark training time per epoch.&lt;SEP&gt;NVIDIA is a technology company that donated DGX-1 and Tesla K40 hardware used in the research.&lt;SEP&gt;NVIDIA is a technology company that manufactures graphics processing units, specifically the Titan-X GPU used to execute the model computations.</data>
      <data key="d3">chunk-fab274e4799f62f2fbfabf369fb71267&lt;SEP&gt;chunk-10ce525fd225c14101bb62983a2ac21a&lt;SEP&gt;chunk-a214a03aad6b4356ff5b17786166ad02&lt;SEP&gt;chunk-f52e20fe32ec91903501f1422f3fe621&lt;SEP&gt;chunk-e759311c40b86a32804c73d3e9508819&lt;SEP&gt;chunk-ad4815afd1a11fd7bc1c72c7da255e9c</data>
    </node>
    <node id="Word-Level Language Models">
      <data key="d0">Word-Level Language Models</data>
      <data key="d1">category</data>
      <data key="d2">A class of natural language processing models designed to predict and model sequences of words, evaluated using benchmark corpora such as PTB, WT2, and WT103.</data>
      <data key="d3">chunk-e759311c40b86a32804c73d3e9508819</data>
    </node>
    <node id="Character N-Grams">
      <data key="d0">Character N-Grams</data>
      <data key="d1">category</data>
      <data key="d2">Character n-grams are subword units such as bigrams and trigrams extracted from words to represent their internal morphological structure.&lt;SEP&gt;Sub-word linguistic units used to enrich word representations and assist in capturing the semantic meaning of infrequent words.&lt;SEP&gt;Substrings of length n extracted from words (such as character bigrams and trigrams) used to capture internal morphological structure in word embeddings.</data>
      <data key="d3">chunk-2fd39034576eb8de5d243305db77f4b3&lt;SEP&gt;chunk-5e8ad7bf1880d82f40811c2078046e6b&lt;SEP&gt;chunk-e759311c40b86a32804c73d3e9508819</data>
    </node>
    <node id="PTB Dataset">
      <data key="d0">PTB Dataset</data>
      <data key="d1">category</data>
      <data key="d2">A widely used benchmark corpus in natural language processing used to evaluate language model perplexity, particularly on infrequent words.</data>
      <data key="d3">chunk-e759311c40b86a32804c73d3e9508819</data>
    </node>
    <node id="WT103 Dataset">
      <data key="d0">WT103 Dataset</data>
      <data key="d1">category</data>
      <data key="d2">A large-scale language modeling benchmark dataset derived from Wikipedia articles, used to test state-of-the-art model performance.</data>
      <data key="d3">chunk-e759311c40b86a32804c73d3e9508819</data>
    </node>
    <node id="WT2 Dataset">
      <data key="d0">WT2 Dataset</data>
      <data key="d1">category</data>
      <data key="d2">A standard benchmark corpus for language modeling used alongside PTB and WT103 to evaluate word representation methods.</data>
      <data key="d3">chunk-e759311c40b86a32804c73d3e9508819</data>
    </node>
    <node id="Standard Self-Attention">
      <data key="d0">Standard Self-Attention</data>
      <data key="d1">category</data>
      <data key="d2">An attention mechanism that computes scalar weights for character n-gram embeddings, contrasted with multi-dimensional self-attention.</data>
      <data key="d3">chunk-e759311c40b86a32804c73d3e9508819</data>
    </node>
    <node id="AWD-LSTM-MoS">
      <data key="d0">AWD-LSTM-MoS</data>
      <data key="d1">category</data>
      <data key="d2">A state-of-the-art recurrent language model architecture incorporating Mixture of Softmaxes, evaluated in combination with char3-MS-vec.</data>
      <data key="d3">chunk-e759311c40b86a32804c73d3e9508819</data>
    </node>
    <node id="AWD-LSTM-DOC">
      <data key="d0">AWD-LSTM-DOC</data>
      <data key="d1">category</data>
      <data key="d2">A high-performing baseline language model architecture used to evaluate perplexity improvements on benchmark datasets.</data>
      <data key="d3">chunk-e759311c40b86a32804c73d3e9508819</data>
    </node>
    <node id="Encoder-Decoder Architecture">
      <data key="d0">Encoder-Decoder Architecture</data>
      <data key="d1">category</data>
      <data key="d2">A neural network structural design featuring an encoder and a decoder used for sequence-to-sequence mapping.&lt;SEP&gt;A neural sequence-to-sequence framework applied to machine translation and headline generation tasks.&lt;SEP&gt;Encoder-Decoder Architecture is a deep learning paradigm comprising an utterance-table encoder, turn attention mechanism, and table-aware decoder to translate user interactions into database queries.</data>
      <data key="d3">chunk-56c893ccea72c9785303bae311f29c7b&lt;SEP&gt;chunk-ae11879a44e89506f5f7277c88df7c75&lt;SEP&gt;chunk-e759311c40b86a32804c73d3e9508819</data>
    </node>
    <node id="JSPS">
      <data key="d0">JSPS</data>
      <data key="d1">organization</data>
      <data key="d2">The Japan Society for the Promotion of Science (JSPS) is a research funding agency that supported the study through KAKENHI Grant Number JP18K18119.</data>
      <data key="d3">chunk-ad4815afd1a11fd7bc1c72c7da255e9c</data>
    </node>
    <node id="Kiyono">
      <data key="d0">Kiyono</data>
      <data key="d1">person</data>
      <data key="d2">Kiyono is a researcher who, with colleagues in 2017, provided benchmark test sets and baseline scores for headline generation.&lt;SEP&gt;Researcher who, along with colleagues in 2017, provided headline generation test sets used to benchmark text generation models.</data>
      <data key="d3">chunk-90319301f543fcb7182148725008750f&lt;SEP&gt;chunk-ad4815afd1a11fd7bc1c72c7da255e9c</data>
    </node>
    <node id="Neural Encoder-Decoder Models">
      <data key="d0">Neural Encoder-Decoder Models</data>
      <data key="d1">category</data>
      <data key="d2">Neural encoder-decoder models are deep learning architectures used as conditional neural language models for sequence-to-sequence tasks like translation and headline generation.</data>
      <data key="d3">chunk-ad4815afd1a11fd7bc1c72c7da255e9c</data>
    </node>
    <node id="Conversational Agents">
      <data key="d0">Conversational Agents</data>
      <data key="d1">category</data>
      <data key="d2">A class of computational systems and personal assistants designed to process natural language and communicate interactively with users.&lt;SEP&gt;Automated dialogue systems designed to converse with human users, often facing challenges regarding personality and naturalness.&lt;SEP&gt;Conversational agents are a class of interactive software systems designed to engage in natural language dialogue with human users.&lt;SEP&gt;Conversational agents are interactive computational systems designed for dialogue and user assistance across various applications.&lt;SEP&gt;Dialogue systems and virtual agents designed to converse with humans, which have evolved from rule-based systems to neural sequence-to-sequence models.&lt;SEP&gt;Dialogue systems and virtual assistants that interact with humans using natural language, encompassing goal-oriented and chit-chat systems.&lt;SEP&gt;Software systems, including commercially available smart assistants, that conduct automated dialogue with human users.</data>
      <data key="d3">chunk-90319301f543fcb7182148725008750f&lt;SEP&gt;chunk-eb3ab7fc50f538bef2c8ddb57a8a6b95&lt;SEP&gt;chunk-0f7cfb64157b0b1becf1f72e036758aa&lt;SEP&gt;chunk-298f7bb76f5ebb6d2dd7ddc9afddde09&lt;SEP&gt;chunk-fe97dad1ad4e2f85cc4ac8cf6a70fd65&lt;SEP&gt;chunk-ec69fa32e36eccb757533f339939eb82&lt;SEP&gt;chunk-ad4815afd1a11fd7bc1c72c7da255e9c</data>
    </node>
    <node id="IWSLT16">
      <data key="d0">IWSLT16</data>
      <data key="d1">event</data>
      <data key="d2">The International Workshop on Spoken Language Translation 2016 is an academic event whose dataset was utilized for evaluating machine translation BLEU scores.</data>
      <data key="d3">chunk-ad4815afd1a11fd7bc1c72c7da255e9c</data>
    </node>
    <node id="Byte-Pair-Encoding">
      <data key="d0">Byte-Pair-Encoding</data>
      <data key="d1">category</data>
      <data key="d2">Byte-Pair-Encoding (BPE) is a subword tokenization and vocabulary construction algorithm widely used in natural language processing models.</data>
      <data key="d3">chunk-ad4815afd1a11fd7bc1c72c7da255e9c</data>
    </node>
    <node id="Goal-Oriented Systems">
      <data key="d0">Goal-Oriented Systems</data>
      <data key="d1">category</data>
      <data key="d2">Goal-oriented systems are a category of conversational agents designed to assist users in completing specific tasks.</data>
      <data key="d3">chunk-ad4815afd1a11fd7bc1c72c7da255e9c</data>
    </node>
    <node id="Alan Turing">
      <data key="d0">Alan Turing</data>
      <data key="d1">person</data>
      <data key="d2">English mathematician and computer scientist widely regarded as the father of artificial intelligence, who proposed the Turing test in 1950.</data>
      <data key="d3">chunk-90319301f543fcb7182148725008750f</data>
    </node>
    <node id="O Vinayal">
      <data key="d0">O Vinayal</data>
      <data key="d1">person</data>
      <data key="d2">Researcher who contributed to sequence-to-sequence neural conversational agents and studied the role of personality consistency in conversational AI.</data>
      <data key="d3">chunk-90319301f543fcb7182148725008750f</data>
    </node>
    <node id="Peckham">
      <data key="d0">Peckham</data>
      <data key="d1">person</data>
      <data key="d2">Researcher associated with the 1993 ESPRIT SUNDIAL project on conversational telephone inquiry systems.</data>
      <data key="d3">chunk-90319301f543fcb7182148725008750f</data>
    </node>
    <node id="MIT">
      <data key="d0">MIT</data>
      <data key="d1">organization</data>
      <data key="d2">Massachusetts Institute of Technology, an academic institution where the early pattern-matching dialogue program ELIZA was developed in 1964.</data>
      <data key="d3">chunk-90319301f543fcb7182148725008750f</data>
    </node>
    <node id="Turing Test">
      <data key="d0">Turing Test</data>
      <data key="d1">event</data>
      <data key="d2">A benchmark test of a machine's ability to exhibit intelligent behavior indistinguishable from that of a human, referenced as an analogy for discriminator models in adversarial training.&lt;SEP&gt;A test proposed by Alan Turing in 1950 to evaluate whether a machine can exhibit conversational behavior indistinguishable from a human.&lt;SEP&gt;The Turing Test is a foundational benchmark test evaluating a machine's ability to exhibit intelligent behavior indistinguishable from that of a human.</data>
      <data key="d3">chunk-90319301f543fcb7182148725008750f&lt;SEP&gt;chunk-ec69fa32e36eccb757533f339939eb82&lt;SEP&gt;chunk-eb3ab7fc50f538bef2c8ddb57a8a6b95</data>
    </node>
    <node id="ESPRIT SUNDIAL Project">
      <data key="d0">ESPRIT SUNDIAL Project</data>
      <data key="d1">event</data>
      <data key="d2">A 1993 research project focused on building spontaneous conversational inquiry systems over telephone networks for train and flight information.</data>
      <data key="d3">chunk-90319301f543fcb7182148725008750f</data>
    </node>
    <node id="Goal-Driven Dialogue Systems">
      <data key="d0">Goal-Driven Dialogue Systems</data>
      <data key="d1">category</data>
      <data key="d2">Task-oriented conversational systems designed to handle specific domains such as booking, customer support, and querying.</data>
      <data key="d3">chunk-90319301f543fcb7182148725008750f</data>
    </node>
    <node id="Chit-Chat Models">
      <data key="d0">Chit-Chat Models</data>
      <data key="d1">category</data>
      <data key="d2">Non-goal-driven conversational agents designed for open-ended interaction and entertainment.</data>
      <data key="d3">chunk-90319301f543fcb7182148725008750f</data>
    </node>
    <node id="Sequence To Sequence Learning">
      <data key="d0">Sequence To Sequence Learning</data>
      <data key="d1">category</data>
      <data key="d2">A neural network framework capable of mapping variable-length input sequences to output sequences, revolutionizing neural dialogue modeling.</data>
      <data key="d3">chunk-90319301f543fcb7182148725008750f</data>
    </node>
    <node id="Ball">
      <data key="d0">Ball</data>
      <data key="d1">person</data>
      <data key="d2">A researcher at Microsoft who co-developed the Persona conversational assistant in 1995.&lt;SEP&gt;Researcher who investigated early conversational dialogue techniques and interactive systems in 1995.</data>
      <data key="d3">chunk-90319301f543fcb7182148725008750f&lt;SEP&gt;chunk-fe97dad1ad4e2f85cc4ac8cf6a70fd65</data>
    </node>
    <node id="Neural Networks">
      <data key="d0">Neural Networks</data>
      <data key="d1">category</data>
      <data key="d2">A broad class of computational learning models encompassing architectures such as RNNs, CNNs, and Transformers used in various NLP and vision tasks.&lt;SEP&gt;A class of machine learning models capable of capturing long-term text dependencies, foundational to modern conversational agents.&lt;SEP&gt;Neural networks are machine learning computational models including word embedding architectures like Skip-gram and SubGram.</data>
      <data key="d3">chunk-90319301f543fcb7182148725008750f&lt;SEP&gt;chunk-f3e8fa58e562bb861dae62114ff9c810&lt;SEP&gt;chunk-6b6907deaed642269724a32b0c9ccd9f</data>
    </node>
    <node id="Generative Adversarial Networks">
      <data key="d0">Generative Adversarial Networks</data>
      <data key="d1">category</data>
      <data key="d2">A family of machine learning architectures utilized as an advanced generative approach in conversational dialogue modeling.&lt;SEP&gt;A machine learning framework consisting of generators and discriminators, utilized in text style transfer to separate content and style representations.</data>
      <data key="d3">chunk-009a3d10aa88ab09f7d1c51bd7755ef4&lt;SEP&gt;chunk-90319301f543fcb7182148725008750f</data>
    </node>
    <node id="Rule-Based Methods">
      <data key="d0">Rule-Based Methods</data>
      <data key="d1">category</data>
      <data key="d2">Early dialogue system approaches relying on hand-engineered features and domain-specific linguistic rules.&lt;SEP&gt;Rule-based methods are early dialogue system architectures that depended on domain-specific, hand-engineered features.</data>
      <data key="d3">chunk-90319301f543fcb7182148725008750f&lt;SEP&gt;chunk-eb3ab7fc50f538bef2c8ddb57a8a6b95</data>
    </node>
    <node id="Statistical Approaches">
      <data key="d0">Statistical Approaches</data>
      <data key="d1">category</data>
      <data key="d2">Data-driven methods applied historically in dialogue systems prior to the widespread adoption of deep neural models.</data>
      <data key="d3">chunk-90319301f543fcb7182148725008750f</data>
    </node>
    <node id="Virtual Assistants">
      <data key="d0">Virtual Assistants</data>
      <data key="d1">category</data>
      <data key="d2">Commercial interactive agents and personal assistants carried by users, such as Siri, Allo, Alexa, and Cortana.</data>
      <data key="d3">chunk-90319301f543fcb7182148725008750f</data>
    </node>
    <node id="Maxine Eskenazi">
      <data key="d0">Maxine Eskenazi</data>
      <data key="d1">person</data>
      <data key="d2">A researcher who led a team to develop spoken dialogue systems, including the Let’s Go project focused on transit information for diverse populations.</data>
      <data key="d3">chunk-fe97dad1ad4e2f85cc4ac8cf6a70fd65</data>
    </node>
    <node id="Raux">
      <data key="d0">Raux</data>
      <data key="d1">person</data>
      <data key="d2">A researcher who collaborated on the Let’s Go spoken dialogue project and published multiple evaluations of the system.</data>
      <data key="d3">chunk-fe97dad1ad4e2f85cc4ac8cf6a70fd65</data>
    </node>
    <node id="Schillo">
      <data key="d0">Schillo</data>
      <data key="d1">person</data>
      <data key="d2">A researcher who contributed to application-specific spoken dialogue systems, specifically in-car intelligent personal assistants in 1996.</data>
      <data key="d3">chunk-fe97dad1ad4e2f85cc4ac8cf6a70fd65</data>
    </node>
    <node id="Stent">
      <data key="d0">Stent</data>
      <data key="d1">person</data>
      <data key="d2">A researcher who worked on spoken-language interfaces used to execute military exercises in 1999.</data>
      <data key="d3">chunk-fe97dad1ad4e2f85cc4ac8cf6a70fd65</data>
    </node>
    <node id="Lin">
      <data key="d0">Lin</data>
      <data key="d1">person</data>
      <data key="d2">A researcher who proposed a distributed architecture for cooperative spoken dialogue agents across multiple domains in 1999.</data>
      <data key="d3">chunk-fe97dad1ad4e2f85cc4ac8cf6a70fd65</data>
    </node>
    <node id="Srinivas">
      <data key="d0">Srinivas</data>
      <data key="d1">person</data>
      <data key="d2">A researcher who in 2008 proposed data-driven techniques for dialogue task structures and dialogue act classification.</data>
      <data key="d3">chunk-fe97dad1ad4e2f85cc4ac8cf6a70fd65</data>
    </node>
    <node id="Wizard-of-Oz Experiment">
      <data key="d0">Wizard-of-Oz Experiment</data>
      <data key="d1">event</data>
      <data key="d2">An experimental simulation methodology run by Eskenazi's team to gather user interaction patterns for writing system parsing grammars.</data>
      <data key="d3">chunk-fe97dad1ad4e2f85cc4ac8cf6a70fd65</data>
    </node>
    <node id="Machine Learning Methods">
      <data key="d0">Machine Learning Methods</data>
      <data key="d1">category</data>
      <data key="d2">A class of statistical and data-driven computational algorithms that significantly advanced speech recognition and natural language processing in dialogue systems.</data>
      <data key="d3">chunk-fe97dad1ad4e2f85cc4ac8cf6a70fd65</data>
    </node>
    <node id="Spoken Dialogue Systems">
      <data key="d0">Spoken Dialogue Systems</data>
      <data key="d1">category</data>
      <data key="d2">A category of interactive automated systems designed to converse with human users using natural speech across various domains.&lt;SEP&gt;A class of conversational artificial intelligence systems designed to interact with and assist users using speech and natural language to achieve specific goals.</data>
      <data key="d3">chunk-fe97dad1ad4e2f85cc4ac8cf6a70fd65&lt;SEP&gt;chunk-785a16b34b0c74a5ee4f9f416976a683</data>
    </node>
    <node id="Task-Oriented Dialogs">
      <data key="d0">Task-Oriented Dialogs</data>
      <data key="d1">category</data>
      <data key="d2">A class of conversational interactions focused on accomplishing specific tasks using structured dialog modeling.&lt;SEP&gt;A class of conversational interactions specifically focused on helping users achieve concrete goals, such as scheduling, transit tracking, or inquiries.</data>
      <data key="d3">chunk-fe97dad1ad4e2f85cc4ac8cf6a70fd65&lt;SEP&gt;chunk-c5b6673cfdbb7f8a448709da4e46192b</data>
    </node>
    <node id="Statistical Language Models">
      <data key="d0">Statistical Language Models</data>
      <data key="d1">category</data>
      <data key="d2">Probabilistic modeling techniques, such as n-gram models, used to evaluate and predict sequences of words in speech recognition.&lt;SEP&gt;Statistical language models are probabilistic formulations that approximate the likelihood of word sequences based on observed training data.</data>
      <data key="d3">chunk-3a58f646da20a5dcef84244d40bf423b&lt;SEP&gt;chunk-fe97dad1ad4e2f85cc4ac8cf6a70fd65</data>
    </node>
    <node id="Acoustic Models">
      <data key="d0">Acoustic Models</data>
      <data key="d1">category</data>
      <data key="d2">Statistical representations of speech sounds and acoustic features used in speech recognition to identify spoken phonemes.</data>
      <data key="d3">chunk-fe97dad1ad4e2f85cc4ac8cf6a70fd65</data>
    </node>
    <node id="Context Free Grammar">
      <data key="d0">Context Free Grammar</data>
      <data key="d1">category</data>
      <data key="d2">A formal grammar framework utilized by robust parsers to parse sentence structures and extract domain-specific slots from user speech.</data>
      <data key="d3">chunk-fe97dad1ad4e2f85cc4ac8cf6a70fd65</data>
    </node>
    <node id="Semi-Continuous HMMs">
      <data key="d0">Semi-Continuous HMMs</data>
      <data key="d1">category</data>
      <data key="d2">Semi-continuous Hidden Markov Models used for acoustic speech modeling, representing statistical distributions of speech signals.</data>
      <data key="d3">chunk-fe97dad1ad4e2f85cc4ac8cf6a70fd65</data>
    </node>
    <node id="Flight Inquiry Application">
      <data key="d0">Flight Inquiry Application</data>
      <data key="d1">category</data>
      <data key="d2">An early domain-specific spoken dialogue application focused on flight queries that achieved high task success within narrow constraints.</data>
      <data key="d3">chunk-fe97dad1ad4e2f85cc4ac8cf6a70fd65</data>
    </node>
    <node id="Tour Information Service">
      <data key="d0">Tour Information Service</data>
      <data key="d1">category</data>
      <data key="d2">An application domain implemented via cooperative spoken dialogue agents to provide travelers with tour guidance.</data>
      <data key="d3">chunk-fe97dad1ad4e2f85cc4ac8cf6a70fd65</data>
    </node>
    <node id="In-Car Intelligent Personal Assistant">
      <data key="d0">In-Car Intelligent Personal Assistant</data>
      <data key="d1">category</data>
      <data key="d2">A specialized category of conversational assistants engineered for hands-free interaction within automotive environments.</data>
      <data key="d3">chunk-fe97dad1ad4e2f85cc4ac8cf6a70fd65</data>
    </node>
    <node id="Military Exercises">
      <data key="d0">Military Exercises</data>
      <data key="d1">event</data>
      <data key="d2">Operational defense training simulations executed and commanded via spoken-language interfaces.</data>
      <data key="d3">chunk-fe97dad1ad4e2f85cc4ac8cf6a70fd65</data>
    </node>
    <node id="Srinivas et al.">
      <data key="d0">Srinivas et al.</data>
      <data key="d1">person</data>
      <data key="d2">Researchers who, in 2008, proposed data-driven techniques to build task structures for individual dialogs and for dialog act and task prediction.</data>
      <data key="d3">chunk-c5b6673cfdbb7f8a448709da4e46192b</data>
    </node>
    <node id="Vinyals et al.">
      <data key="d0">Vinyals et al.</data>
      <data key="d1">person</data>
      <data key="d2">Researchers who, in 2015, introduced an end-to-end sequence to sequence learning architecture for conversation agents.</data>
      <data key="d3">chunk-c5b6673cfdbb7f8a448709da4e46192b</data>
    </node>
    <node id="Iulian et al.">
      <data key="d0">Iulian et al.</data>
      <data key="d1">person</data>
      <data key="d2">Researchers who built upon sequence-to-sequence approaches using hierarchical recurrent encoder-decoder models, presented at AAAI 2016.</data>
      <data key="d3">chunk-c5b6673cfdbb7f8a448709da4e46192b</data>
    </node>
    <node id="Sordoni et al.">
      <data key="d0">Sordoni et al.</data>
      <data key="d1">person</data>
      <data key="d2">Researchers who proposed the hierarchical recurrent encoder-decoder (HRED) architecture.</data>
      <data key="d3">chunk-c5b6673cfdbb7f8a448709da4e46192b</data>
    </node>
    <node id="AAAI 2016">
      <data key="d0">AAAI 2016</data>
      <data key="d1">event</data>
      <data key="d2">The 2016 conference of the Association for the Advancement of Artificial Intelligence where Iulian et al. presented their dialogue modeling paper.</data>
      <data key="d3">chunk-c5b6673cfdbb7f8a448709da4e46192b</data>
    </node>
    <node id="Rule-Based Models">
      <data key="d0">Rule-Based Models</data>
      <data key="d1">category</data>
      <data key="d2">Dialogue system approaches that rely on handcrafted, domain-dependent rules, which face scalability and adaptability limitations.</data>
      <data key="d3">chunk-c5b6673cfdbb7f8a448709da4e46192b</data>
    </node>
    <node id="Sequence-to-Sequence Learning">
      <data key="d0">Sequence-to-Sequence Learning</data>
      <data key="d1">category</data>
      <data key="d2">A neural machine learning paradigm mapping input sequences to output sequences, applied to end-to-end dialogue modeling.</data>
      <data key="d3">chunk-c5b6673cfdbb7f8a448709da4e46192b</data>
    </node>
    <node id="Hierarchical Recurrent Encoder-Decoder">
      <data key="d0">Hierarchical Recurrent Encoder-Decoder</data>
      <data key="d1">category</data>
      <data key="d2">An architecture (HRED) that models dialogue hierarchically across tokens and utterances using context and decoder recurrent networks.</data>
      <data key="d3">chunk-c5b6673cfdbb7f8a448709da4e46192b</data>
    </node>
    <node id="MaxEnt Classifier">
      <data key="d0">MaxEnt Classifier</data>
      <data key="d1">category</data>
      <data key="d2">A Maximum Entropy statistical classification model used with feature extraction for dialog act and task classification.</data>
      <data key="d3">chunk-c5b6673cfdbb7f8a448709da4e46192b</data>
    </node>
    <node id="Spoken Dialog Corpora">
      <data key="d0">Spoken Dialog Corpora</data>
      <data key="d1">category</data>
      <data key="d2">Collections of audio or transcript dialog data that enabled the development of data-driven modeling techniques for dialogue systems.</data>
      <data key="d3">chunk-c5b6673cfdbb7f8a448709da4e46192b</data>
    </node>
    <node id="Dialog Act Classification">
      <data key="d0">Dialog Act Classification</data>
      <data key="d1">category</data>
      <data key="d2">A natural language processing task aimed at identifying the pragmatic role or intent of an utterance within a conversation.</data>
      <data key="d3">chunk-c5b6673cfdbb7f8a448709da4e46192b</data>
    </node>
    <node id="Conversation Agents">
      <data key="d0">Conversation Agents</data>
      <data key="d1">category</data>
      <data key="d2">Automated systems or dialogue models capable of conducting conversations with human users.</data>
      <data key="d3">chunk-c5b6673cfdbb7f8a448709da4e46192b</data>
    </node>
    <node id="AAAI">
      <data key="d0">AAAI</data>
      <data key="d1">organization</data>
      <data key="d2">The Association for the Advancement of Artificial Intelligence, a major scientific organization hosting conferences such as AAAI 2016.</data>
      <data key="d3">chunk-c5b6673cfdbb7f8a448709da4e46192b</data>
    </node>
    <node id="Lison et al.">
      <data key="d0">Lison et al.</data>
      <data key="d1">person</data>
      <data key="d2">Researchers who introduced a sample weighting model into neural conversation architectures to handle dialogue corpora limitations such as lack of turn segmentation.</data>
      <data key="d3">chunk-0f7cfb64157b0b1becf1f72e036758aa</data>
    </node>
    <node id="Mei et al.">
      <data key="d0">Mei et al.</data>
      <data key="d1">person</data>
      <data key="d2">Researchers who developed a generative dynamic attention mechanism for RNN language models to improve dialogue coherence.</data>
      <data key="d3">chunk-0f7cfb64157b0b1becf1f72e036758aa</data>
    </node>
    <node id="He et al.">
      <data key="d0">He et al.</data>
      <data key="d1">person</data>
      <data key="d2">Researchers who proposed the Dynamic Knowledge Graph Network (DynoNet) for dialogue modeling.</data>
      <data key="d3">chunk-0f7cfb64157b0b1becf1f72e036758aa</data>
    </node>
    <node id="Lee et al.">
      <data key="d0">Lee et al.</data>
      <data key="d1">person</data>
      <data key="d2">Researchers who proposed a continual learning and adaptive online algorithm approach for conversational agents.</data>
      <data key="d3">chunk-0f7cfb64157b0b1becf1f72e036758aa</data>
    </node>
    <node id="Ghazvininejad et al.">
      <data key="d0">Ghazvininejad et al.</data>
      <data key="d1">person</data>
      <data key="d2">Researchers who proposed a knowledge-grounded conversational model that incorporates external world facts into response generation.</data>
      <data key="d3">chunk-0f7cfb64157b0b1becf1f72e036758aa</data>
    </node>
    <node id="Columbia">
      <data key="d0">Columbia</data>
      <data key="d1">organization</data>
      <data key="d2">An institution mentioned in an example dialogue utterance updating entity embeddings within DynoNet.</data>
      <data key="d3">chunk-0f7cfb64157b0b1becf1f72e036758aa</data>
    </node>
    <node id="Foursquare">
      <data key="d0">Foursquare</data>
      <data key="d1">organization</data>
      <data key="d2">A technology company and data platform cited as an external source of world facts for knowledge-grounded dialogue.&lt;SEP&gt;Foursquare is a technology platform and local search service whose entries and reviews serve as a source of external world facts for grounding conversational agents.&lt;SEP&gt;Foursquare is a third-party mobile check-in app whose automated posts were filtered out from the Twitter dataset.</data>
      <data key="d3">chunk-d46bdf96e3fc5df8745fb87337fae5aa&lt;SEP&gt;chunk-8b32cb050de56f58b5792720c6bc3e42&lt;SEP&gt;chunk-0f7cfb64157b0b1becf1f72e036758aa</data>
    </node>
    <node id="Neural Conversation Models">
      <data key="d0">Neural Conversation Models</data>
      <data key="d1">category</data>
      <data key="d2">A category of conversational agents and dialogue systems based on neural network architectures like sequence-to-sequence and hierarchical models.</data>
      <data key="d3">chunk-0f7cfb64157b0b1becf1f72e036758aa</data>
    </node>
    <node id="Language Models">
      <data key="d0">Language Models</data>
      <data key="d1">category</data>
      <data key="d2">A category of models applied to dialogue modeling by treating entire dialogues as continuous sequences.&lt;SEP&gt;A category of pre-trained neural network models endowed with broad prior knowledge and strong contextual representation capabilities.&lt;SEP&gt;Language Models are statistical and probabilistic frameworks used to estimate the probability of word sequences and evaluate textual similarities between accounts.&lt;SEP&gt;Language models, such as BERT, constitute a category of pre-trained neural representations that capture rich contextual semantics across natural language processing tasks.&lt;SEP&gt;Statistical models, including N-gram models, that calculate probabilities of word sequences and were deployed to rank tweets by humor.</data>
      <data key="d3">chunk-0f7cfb64157b0b1becf1f72e036758aa&lt;SEP&gt;chunk-8d534b033667c04cda76230428876daf&lt;SEP&gt;chunk-9539a4c4fcbd235bc0ccbc8f3fd26a81&lt;SEP&gt;chunk-cfda2df27b2b2e8e0d65e1812ca700fd&lt;SEP&gt;chunk-236f5016d3aa81277cabc5c947f1ca64</data>
    </node>
    <node id="Continual Learning">
      <data key="d0">Continual Learning</data>
      <data key="d1">category</data>
      <data key="d2">A machine learning paradigm that allows sequential training across multiple tasks without catastrophic forgetting.</data>
      <data key="d3">chunk-0f7cfb64157b0b1becf1f72e036758aa</data>
    </node>
    <node id="Hierarchical Approaches">
      <data key="d0">Hierarchical Approaches</data>
      <data key="d1">category</data>
      <data key="d2">A class of baseline dialogue models designed to structure conversational context across multiple turns.</data>
      <data key="d3">chunk-0f7cfb64157b0b1becf1f72e036758aa</data>
    </node>
    <node id="Dialogue Corpora">
      <data key="d0">Dialogue Corpora</data>
      <data key="d1">category</data>
      <data key="d2">Large-scale collections of dialogue datasets, such as subtitle-extracted dialogues, used to train conversational models.</data>
      <data key="d3">chunk-0f7cfb64157b0b1becf1f72e036758aa</data>
    </node>
    <node id="Dynamic Attention Mechanism">
      <data key="d0">Dynamic Attention Mechanism</data>
      <data key="d1">category</data>
      <data key="d2">An attention mechanism introduced into RNN language models where the attention scope expands dynamically to enhance dialogue response coherence.</data>
      <data key="d3">chunk-0f7cfb64157b0b1becf1f72e036758aa</data>
    </node>
    <node id="Dynamic Knowledge Graph Network">
      <data key="d0">Dynamic Knowledge Graph Network</data>
      <data key="d1">category</data>
      <data key="d2">A neural dialogue model (DynoNet) proposed by He et al. that tracks dialogue state and structured context as a knowledge graph.</data>
      <data key="d3">chunk-0f7cfb64157b0b1becf1f72e036758aa</data>
    </node>
    <node id="Online Learning">
      <data key="d0">Online Learning</data>
      <data key="d1">category</data>
      <data key="d2">A machine learning paradigm involving adaptive algorithms used to continually learn conversational tasks over time.</data>
      <data key="d3">chunk-0f7cfb64157b0b1becf1f72e036758aa</data>
    </node>
    <node id="Knowledge Grounded Models">
      <data key="d0">Knowledge Grounded Models</data>
      <data key="d1">category</data>
      <data key="d2">Conversational architectures designed to incorporate factual world knowledge and common sense context into generated responses.</data>
      <data key="d3">chunk-0f7cfb64157b0b1becf1f72e036758aa</data>
    </node>
    <node id="Jessica">
      <data key="d0">Jessica</data>
      <data key="d1">person</data>
      <data key="d2">An entity representing a person in the DynoNet knowledge graph example who receives updated context when Columbia is referenced.</data>
      <data key="d3">chunk-0f7cfb64157b0b1becf1f72e036758aa</data>
    </node>
    <node id="Josh">
      <data key="d0">Josh</data>
      <data key="d1">person</data>
      <data key="d2">An entity representing a person in the DynoNet knowledge graph example who receives updated context when Columbia is referenced.</data>
      <data key="d3">chunk-0f7cfb64157b0b1becf1f72e036758aa</data>
    </node>
    <node id="Young et al.">
      <data key="d0">Young et al.</data>
      <data key="d1">person</data>
      <data key="d2">Young et al. are researchers who investigated augmenting conversational agents with commonsense knowledge bases and tri-LSTM encoders.</data>
      <data key="d3">chunk-8b32cb050de56f58b5792720c6bc3e42</data>
    </node>
    <node id="Long et al.">
      <data key="d0">Long et al.</data>
      <data key="d1">person</data>
      <data key="d2">Long et al. are researchers who developed a knowledge-enhanced sequence-to-sequence framework incorporating search engine results to improve customer service dialogs in 2017.</data>
      <data key="d3">chunk-8b32cb050de56f58b5792720c6bc3e42</data>
    </node>
    <node id="English et al.">
      <data key="d0">English et al.</data>
      <data key="d1">person</data>
      <data key="d2">English et al. are researchers who introduced one of the early reinforcement learning approaches for dialogue systems in 2005 using an on-policy Monte Carlo method.</data>
      <data key="d3">chunk-8b32cb050de56f58b5792720c6bc3e42</data>
    </node>
    <node id="Dhingra et al.">
      <data key="d0">Dhingra et al.</data>
      <data key="d1">person</data>
      <data key="d2">Dhingra et al. are researchers who developed KB-InfoBot in 2017, an end-to-end reinforcement learning dialogue agent for querying knowledge bases.</data>
      <data key="d3">chunk-8b32cb050de56f58b5792720c6bc3e42</data>
    </node>
    <node id="Knowledge-Grounded Dialogue Systems">
      <data key="d0">Knowledge-Grounded Dialogue Systems</data>
      <data key="d1">category</data>
      <data key="d2">A category of conversational AI systems that infuse response generation with external factual knowledge, commonsense knowledge bases, or search engine data.</data>
      <data key="d3">chunk-8b32cb050de56f58b5792720c6bc3e42</data>
    </node>
    <node id="Reinforcement Learning Dialogue Models">
      <data key="d0">Reinforcement Learning Dialogue Models</data>
      <data key="d1">category</data>
      <data key="d2">A category of conversational systems that employ reinforcement learning techniques to learn dialogue policies and optimize interaction outcomes.</data>
      <data key="d3">chunk-8b32cb050de56f58b5792720c6bc3e42</data>
    </node>
    <node id="Search Engine">
      <data key="d0">Search Engine</data>
      <data key="d1">category</data>
      <data key="d2">Information retrieval systems queried dynamically to capture external knowledge for enhancing conversational dialogue agents.</data>
      <data key="d3">chunk-8b32cb050de56f58b5792720c6bc3e42</data>
    </node>
    <node id="Sequence-to-Sequence Model">
      <data key="d0">Sequence-to-Sequence Model</data>
      <data key="d1">category</data>
      <data key="d2">A deep learning architecture consisting of encoder and decoder components, extended to conditionally incorporate external knowledge vectors for response generation.&lt;SEP&gt;A neural network architecture for translation whose architectural components are evaluated via ablation analysis.</data>
      <data key="d3">chunk-3c17cbdd46b3ef569862a8fa188b4fab&lt;SEP&gt;chunk-8b32cb050de56f58b5792720c6bc3e42</data>
    </node>
    <node id="Gated Recurrent Unit">
      <data key="d0">Gated Recurrent Unit</data>
      <data key="d1">category</data>
      <data key="d2">A gating mechanism in recurrent neural networks that regulates information flow and captures dependencies in sequences, used in conversational agents and simplification.&lt;SEP&gt;A gating mechanism in recurrent neural networks used to maintain an internal state of dialogue history in end-to-end dialogue agents.&lt;SEP&gt;A recurrent neural network architecture used to model dialogue policies over action spaces.&lt;SEP&gt;Gated Recurrent Unit (GRU) is a specialized recurrent unit in neural networks used in sentence encoders for sequence-to-sequence translation architectures.</data>
      <data key="d3">chunk-8b32cb050de56f58b5792720c6bc3e42&lt;SEP&gt;chunk-ec69fa32e36eccb757533f339939eb82&lt;SEP&gt;chunk-298f7bb76f5ebb6d2dd7ddc9afddde09&lt;SEP&gt;chunk-c2af0dac5bc5afdea73673fd2462c1e7</data>
    </node>
    <node id="Monte Carlo Method">
      <data key="d0">Monte Carlo Method</data>
      <data key="d1">category</data>
      <data key="d2">A class of reinforcement learning algorithms, specifically on-policy Monte Carlo, used to learn dialogue policies without discounting factors.</data>
      <data key="d3">chunk-8b32cb050de56f58b5792720c6bc3e42</data>
    </node>
    <node id="REINFORCE Algorithm">
      <data key="d0">REINFORCE Algorithm</data>
      <data key="d1">category</data>
      <data key="d2">A policy gradient reinforcement learning algorithm used to train neural components and optimize expected rewards in conversational agents.&lt;SEP&gt;A policy gradient reinforcement learning algorithm used to update dialogue policies and neural network parameters end-to-end.&lt;SEP&gt;REINFORCE is a policy gradient reinforcement learning algorithm applied to optimize non-differentiable objectives directly.</data>
      <data key="d3">chunk-8b32cb050de56f58b5792720c6bc3e42&lt;SEP&gt;chunk-ec69fa32e36eccb757533f339939eb82&lt;SEP&gt;chunk-2425a9bfa1c48f3e56350fa213bdbdab</data>
    </node>
    <node id="Belief Tracker">
      <data key="d0">Belief Tracker</data>
      <data key="d1">category</data>
      <data key="d2">A dialogue system component responsible for tracking user goals and internal dialogue states, updated via reinforcement signals.</data>
      <data key="d3">chunk-8b32cb050de56f58b5792720c6bc3e42</data>
    </node>
    <node id="Customer Service Oriented Dialog">
      <data key="d0">Customer Service Oriented Dialog</data>
      <data key="d1">category</data>
      <data key="d2">A domain of multi-turn conversational interaction aimed at assisting users with informative customer service responses.</data>
      <data key="d3">chunk-8b32cb050de56f58b5792720c6bc3e42</data>
    </node>
    <node id="Su et al.">
      <data key="d0">Su et al.</data>
      <data key="d1">person</data>
      <data key="d2">A group of researchers who in 2017 proposed sample-efficient actor-critic reinforcement learning frameworks with supervised demonstration data for dialogue management.</data>
      <data key="d3">chunk-ec69fa32e36eccb757533f339939eb82</data>
    </node>
    <node id="Deep Reinforcement Learning">
      <data key="d0">Deep Reinforcement Learning</data>
      <data key="d1">category</data>
      <data key="d2">A machine learning framework that optimizes agent decisions through reward mechanisms, applied in simplification to evaluate simplicity, relevance, and fluency.&lt;SEP&gt;A subfield of machine learning combining deep learning and reinforcement principles, used to optimize dialogue policies and agent actions.</data>
      <data key="d3">chunk-ec69fa32e36eccb757533f339939eb82&lt;SEP&gt;chunk-298f7bb76f5ebb6d2dd7ddc9afddde09</data>
    </node>
    <node id="Actor-Critic Algorithm">
      <data key="d0">Actor-Critic Algorithm</data>
      <data key="d1">category</data>
      <data key="d2">A class of reinforcement learning algorithms comprising an actor to execute policies and a critic to evaluate actions and calculate value functions.</data>
      <data key="d3">chunk-ec69fa32e36eccb757533f339939eb82</data>
    </node>
    <node id="Generative Adversarial Network">
      <data key="d0">Generative Adversarial Network</data>
      <data key="d1">category</data>
      <data key="d2">A machine learning framework consisting of a generative model and a discriminative model, applied here to produce human-like dialogue utterances.</data>
      <data key="d3">chunk-ec69fa32e36eccb757533f339939eb82</data>
    </node>
    <node id="Open-Domain Dialogue Generation">
      <data key="d0">Open-Domain Dialogue Generation</data>
      <data key="d1">category</data>
      <data key="d2">A conversational AI domain focused on training automated agents to generate human-like sequences and utterances across general contexts.</data>
      <data key="d3">chunk-ec69fa32e36eccb757533f339939eb82</data>
    </node>
    <node id="TRACER">
      <data key="d0">TRACER</data>
      <data key="d1">category</data>
      <data key="d2">A dialogue policy optimization system evaluated under various semantic error rates using supervised learning and reinforcement learning.&lt;SEP&gt;Trust Region Actor-Critic with Experience Replay is a sample-efficient reinforcement learning algorithm developed to stabilize policy learning step sizes and avoid catastrophic model changes.</data>
      <data key="d3">chunk-ec69fa32e36eccb757533f339939eb82&lt;SEP&gt;chunk-298f7bb76f5ebb6d2dd7ddc9afddde09</data>
    </node>
    <node id="eNACER">
      <data key="d0">eNACER</data>
      <data key="d1">category</data>
      <data key="d2">Episodic Natural Actor-Critic with Experience Replay is a sample-efficient reinforcement learning algorithm utilizing natural gradients to speed up policy convergence.</data>
      <data key="d3">chunk-ec69fa32e36eccb757533f339939eb82</data>
    </node>
    <node id="Cold Start Issue">
      <data key="d0">Cold Start Issue</data>
      <data key="d1">category</data>
      <data key="d2">A machine learning challenge where agents perform poorly or fail in early learning stages when initialized randomly without sufficient prior data.</data>
      <data key="d3">chunk-ec69fa32e36eccb757533f339939eb82</data>
    </node>
    <node id="Dialogue Management">
      <data key="d0">Dialogue Management</data>
      <data key="d1">category</data>
      <data key="d2">A subfield of conversational AI focused on tracking dialogue state and selecting system responses or policies.</data>
      <data key="d3">chunk-ec69fa32e36eccb757533f339939eb82</data>
    </node>
    <node id="Off-Policy Learning">
      <data key="d0">Off-Policy Learning</data>
      <data key="d1">category</data>
      <data key="d2">A reinforcement learning paradigm where models utilize replay buffers of past experiences to improve sample efficiency.</data>
      <data key="d3">chunk-ec69fa32e36eccb757533f339939eb82</data>
    </node>
    <node id="Task-Oriented Information Seeking Domain">
      <data key="d0">Task-Oriented Information Seeking Domain</data>
      <data key="d1">category</data>
      <data key="d2">A conversational AI application area where dialogue agents assist users in finding information and accomplishing specific goals.</data>
      <data key="d3">chunk-ec69fa32e36eccb757533f339939eb82</data>
    </node>
    <node id="Policy Gradient Methods">
      <data key="d0">Policy Gradient Methods</data>
      <data key="d1">category</data>
      <data key="d2">A class of reinforcement learning techniques that optimize policy parameters directly via gradient ascent on expected rewards.</data>
      <data key="d3">chunk-ec69fa32e36eccb757533f339939eb82</data>
    </node>
    <node id="Li et al">
      <data key="d0">Li et al</data>
      <data key="d1">person</data>
      <data key="d2">Li et al are researchers who addressed consistency in conversational agents by incorporating persona embeddings into data-driven models to simulate human-like behavior.</data>
      <data key="d3">chunk-eb3ab7fc50f538bef2c8ddb57a8a6b95</data>
    </node>
    <node id="Zhou et al">
      <data key="d0">Zhou et al</data>
      <data key="d1">person</data>
      <data key="d2">Zhou et al are researchers who proposed the Emotional Chatting Machine model to generate grammatically and emotionally consistent dialogue responses.</data>
      <data key="d3">chunk-eb3ab7fc50f538bef2c8ddb57a8a6b95</data>
    </node>
    <node id="Liu et al">
      <data key="d0">Liu et al</data>
      <data key="d1">person</data>
      <data key="d2">Liu et al are researchers who published work in 2016 examining weaknesses in existing dialogue system evaluation metrics and recommending future directions.</data>
      <data key="d3">chunk-eb3ab7fc50f538bef2c8ddb57a8a6b95</data>
    </node>
    <node id="Kiros et al">
      <data key="d0">Kiros et al</data>
      <data key="d1">person</data>
      <data key="d2">Kiros et al are researchers whose 2015 work on distributed sentence representations was cited as a promising basis for dialogue evaluation metrics.</data>
      <data key="d3">chunk-eb3ab7fc50f538bef2c8ddb57a8a6b95</data>
    </node>
    <node id="Emotional Chatting Machine">
      <data key="d0">Emotional Chatting Machine</data>
      <data key="d1">category</data>
      <data key="d2">The Emotional Chatting Machine is a dialogue model architecture designed to generate responses that are both grammatically and emotionally consistent using emotion embeddings.</data>
      <data key="d3">chunk-eb3ab7fc50f538bef2c8ddb57a8a6b95</data>
    </node>
    <node id="Sequence to Sequence Models">
      <data key="d0">Sequence to Sequence Models</data>
      <data key="d1">category</data>
      <data key="d2">Sequence to sequence models are a class of neural network architectures introduced in 2015 that revolutionized conversational agents by handling variable-length utterances.</data>
      <data key="d3">chunk-eb3ab7fc50f538bef2c8ddb57a8a6b95</data>
    </node>
    <node id="Adversarial Training">
      <data key="d0">Adversarial Training</data>
      <data key="d1">category</data>
      <data key="d2">A machine learning training approach explored in sequence generation, noted for potential benefits when high entropy exists in target distributions.&lt;SEP&gt;A machine learning training framework employed to disentangle content representations from style representations.&lt;SEP&gt;A machine learning training scheme used to disentangle latent representations, such as separating content semantics from stylistic features.&lt;SEP&gt;A machine learning training technique involving generative models and discriminators to produce human-like dialogue utterances.&lt;SEP&gt;A regularization and training technique originally proposed by Goodfellow et al. that perturbs data in embedding space to enhance the robustness and generalization of neural networks.&lt;SEP&gt;Adversarial Training is a machine learning regularization technique that incorporates perturbed or adversarial examples during model training to improve generalization and robustness.&lt;SEP&gt;Adversarial Training is a machine learning technique that incorporates adversarial perturbations into model training to enhance robustness and performance.</data>
      <data key="d3">chunk-cb73055a3a263fcef16382513853f022&lt;SEP&gt;chunk-1ca9fdc4a98dc4d2c8f6875739e4d466&lt;SEP&gt;chunk-e90c3963b2880a766180f3aafb75b379&lt;SEP&gt;chunk-eb3ab7fc50f538bef2c8ddb57a8a6b95&lt;SEP&gt;chunk-22000c8a3ad4361f1298f9c99632a667&lt;SEP&gt;chunk-8fa216244e9956f33ee1e83a4b072080&lt;SEP&gt;chunk-47f43d3218257ab88ccde621eadece2c</data>
    </node>
    <node id="Persona Embeddings">
      <data key="d0">Persona Embeddings</data>
      <data key="d1">category</data>
      <data key="d2">Vector representations that encode speaker-specific attributes, identity, and style into dialogue models to maintain conversational consistency.</data>
      <data key="d3">chunk-eb3ab7fc50f538bef2c8ddb57a8a6b95</data>
    </node>
    <node id="BLEU Score">
      <data key="d0">BLEU Score</data>
      <data key="d1">category</data>
      <data key="d2">A standard evaluation metric for machine translation quality used to benchmark various translation units.&lt;SEP&gt;A standard quantitative evaluation metric used to assess the quality of machine translation outputs across models and dataset configurations.&lt;SEP&gt;A word-overlap automated evaluation metric commonly used in text generation tasks, criticized for correlating weakly with human judgments in open-domain dialogue.&lt;SEP&gt;An algorithmic evaluation metric for assessing machine translation quality by comparing system output against reference translations, used to measure performance gains.&lt;SEP&gt;An automated evaluation metric measuring n-gram overlap between generated and reference sentences to quantify style preservation.&lt;SEP&gt;BLEU Score is a standard automated evaluation metric used to assess the quality of machine-translated sentences against reference translations.</data>
      <data key="d3">chunk-eb3ab7fc50f538bef2c8ddb57a8a6b95&lt;SEP&gt;chunk-ea126b0da9c38f85b697b36cd33629f5&lt;SEP&gt;chunk-c2af0dac5bc5afdea73673fd2462c1e7&lt;SEP&gt;chunk-f50b15c876beec2eae8bf6437e8409aa&lt;SEP&gt;chunk-116526d304daa442dbc1df519e7f8fc5&lt;SEP&gt;chunk-8fa216244e9956f33ee1e83a4b072080</data>
    </node>
    <node id="Distributed Sentence Representations">
      <data key="d0">Distributed Sentence Representations</data>
      <data key="d1">category</data>
      <data key="d2">Vector-space semantic representations of full sentences considered a promising direction for dialogue system evaluation.</data>
      <data key="d3">chunk-eb3ab7fc50f538bef2c8ddb57a8a6b95</data>
    </node>
    <node id="Discriminative Evaluation Models">
      <data key="d0">Discriminative Evaluation Models</data>
      <data key="d1">category</data>
      <data key="d2">Data-driven evaluation architectures trained to distinguish between generated machine responses and natural human dialogue.</data>
      <data key="d3">chunk-eb3ab7fc50f538bef2c8ddb57a8a6b95</data>
    </node>
    <node id="Emotion Embeddings">
      <data key="d0">Emotion Embeddings</data>
      <data key="d1">category</data>
      <data key="d2">Representations that capture high-level abstractions of emotion expressions to enable emotionally consistent text generation.</data>
      <data key="d3">chunk-eb3ab7fc50f538bef2c8ddb57a8a6b95</data>
    </node>
    <node id="Munkhdalai">
      <data key="d0">Munkhdalai</data>
      <data key="d1">person</data>
      <data key="d2">A researcher who co-introduced Neural Semantic Encoders (NSE) alongside Yu in 2017.</data>
      <data key="d3">chunk-298f7bb76f5ebb6d2dd7ddc9afddde09</data>
    </node>
    <node id="Yu">
      <data key="d0">Yu</data>
      <data key="d1">person</data>
      <data key="d2">A researcher cited for previous work (Yu et al., 2019b) on CD-Seq2Seq models evaluated on semantic parsing benchmarks.&lt;SEP&gt;A researcher referenced in Yu et al. (2019b) in connection with the CD-Seq2Seq model and text-to-SQL benchmarks.&lt;SEP&gt;A researcher who co-introduced Neural Semantic Encoders (NSE) alongside Munkhdalai in 2017.</data>
      <data key="d3">chunk-298f7bb76f5ebb6d2dd7ddc9afddde09&lt;SEP&gt;chunk-fdb0afdde0d066987770f69fd6c4b0b4&lt;SEP&gt;chunk-c0e641e454fbaf0939a594969a7304c3</data>
    </node>
    <node id="Nisioi">
      <data key="d0">Nisioi</data>
      <data key="d1">person</data>
      <data key="d2">A researcher who implemented standard LSTM-based Seq2seq models for sentence simplification.</data>
      <data key="d3">chunk-298f7bb76f5ebb6d2dd7ddc9afddde09</data>
    </node>
    <node id="Lapata">
      <data key="d0">Lapata</data>
      <data key="d1">person</data>
      <data key="d2">A researcher who collaborated with Barzilay on modeling content selection and sentence aggregation as optimization and integer linear programming problems.&lt;SEP&gt;A researcher who, alongside Zhang, applied deep reinforcement learning to sentence simplification.</data>
      <data key="d3">chunk-298f7bb76f5ebb6d2dd7ddc9afddde09&lt;SEP&gt;chunk-0e6575c1afc788be74bd028dfc616620</data>
    </node>
    <node id="Simple English Wikipedia">
      <data key="d0">Simple English Wikipedia</data>
      <data key="d1">organization</data>
      <data key="d2">An online encyclopedia project providing simplified text corpora widely utilized for training and benchmarking sentence simplification models.&lt;SEP&gt;An online encyclopedia written in basic English (SEW), frequently used as a benchmark corpus for sentence simplification studies.&lt;SEP&gt;Simple English Wikipedia (SEW) is an English-language edition of Wikipedia written in simplified English, used as target data for sentence simplification pairs.</data>
      <data key="d3">chunk-dcb2d684d656e9d9c24124949d2aaf80&lt;SEP&gt;chunk-298f7bb76f5ebb6d2dd7ddc9afddde09&lt;SEP&gt;chunk-fab274e4799f62f2fbfabf369fb71267</data>
    </node>
    <node id="Sentence Simplification">
      <data key="d0">Sentence Simplification</data>
      <data key="d1">category</data>
      <data key="d2">A natural language processing task aimed at reducing the reading difficulty and complexity of text while preserving grammaticality and meaning.&lt;SEP&gt;A natural language processing task focused on modifying complex sentences into simpler versions while preserving their core meaning.&lt;SEP&gt;A natural language processing task focused on reducing the complexity of sentence vocabulary and grammar while preserving core meaning and information.</data>
      <data key="d3">chunk-dcb2d684d656e9d9c24124949d2aaf80&lt;SEP&gt;chunk-298f7bb76f5ebb6d2dd7ddc9afddde09&lt;SEP&gt;chunk-f52e20fe32ec91903501f1422f3fe621</data>
    </node>
    <node id="Neural Semantic Encoders">
      <data key="d0">Neural Semantic Encoders</data>
      <data key="d1">category</data>
      <data key="d2">A memory-augmented recurrent neural network architecture designed to handle long-term dependencies and complex sentence processing.&lt;SEP&gt;Neural Semantic Encoders (NSE) are memory-augmented neural network architectures that allow an encoder to read, compose, and write to an evolving memory matrix, enabling unrestricted access to the entire source sequence.</data>
      <data key="d3">chunk-298f7bb76f5ebb6d2dd7ddc9afddde09&lt;SEP&gt;chunk-fab274e4799f62f2fbfabf369fb71267</data>
    </node>
    <node id="Phrase-Based Machine Translation">
      <data key="d0">Phrase-Based Machine Translation</data>
      <data key="d1">category</data>
      <data key="d2">A statistical machine translation framework that translates sequences of words, previously used as a benchmark for sentence simplification.</data>
      <data key="d3">chunk-298f7bb76f5ebb6d2dd7ddc9afddde09</data>
    </node>
    <node id="Syntax-Based Machine Translation">
      <data key="d0">Syntax-Based Machine Translation</data>
      <data key="d1">category</data>
      <data key="d2">A statistical machine translation framework using string-to-tree models, serving as a baseline and re-scoring target in the study.&lt;SEP&gt;A statistical machine translation paradigm leveraging syntactic structures and parse trees for translation and sentence simplification tasks.</data>
      <data key="d3">chunk-b98e14081bd42f130f547ac6df8114f8&lt;SEP&gt;chunk-298f7bb76f5ebb6d2dd7ddc9afddde09</data>
    </node>
    <node id="Tree-Based Machine Translation">
      <data key="d0">Tree-Based Machine Translation</data>
      <data key="d1">category</data>
      <data key="d2">A statistical machine translation approach using parse tree structures to map complex linguistic forms to simpler sentences.</data>
      <data key="d3">chunk-298f7bb76f5ebb6d2dd7ddc9afddde09</data>
    </node>
    <node id="Attention-Based Encoder-Decoder Model">
      <data key="d0">Attention-Based Encoder-Decoder Model</data>
      <data key="d1">category</data>
      <data key="d2">A neural network paradigm incorporating attention mechanisms into sequence-to-sequence architectures to dynamically focus on relevant parts of source inputs.</data>
      <data key="d3">chunk-298f7bb76f5ebb6d2dd7ddc9afddde09</data>
    </node>
    <node id="NseLstm Model">
      <data key="d0">NseLstm Model</data>
      <data key="d1">category</data>
      <data key="d2">A specific neural sentence simplification architecture combining a Neural Semantic Encoder as encoder and an LSTM as decoder.</data>
      <data key="d3">chunk-298f7bb76f5ebb6d2dd7ddc9afddde09</data>
    </node>
    <node id="DynoNet">
      <data key="d0">DynoNet</data>
      <data key="d1">category</data>
      <data key="d2">A neural dialogue augmentation model designed to improve conversational interaction and agent responses.</data>
      <data key="d3">chunk-298f7bb76f5ebb6d2dd7ddc9afddde09</data>
    </node>
    <node id="Knowledge Grounded Model">
      <data key="d0">Knowledge Grounded Model</data>
      <data key="d1">category</data>
      <data key="d2">A conversational neural architecture that incorporates external real-world factual data to augment utterance generation.</data>
      <data key="d3">chunk-298f7bb76f5ebb6d2dd7ddc9afddde09</data>
    </node>
    <node id="Hierarchical Dialogue Modelling">
      <data key="d0">Hierarchical Dialogue Modelling</data>
      <data key="d1">category</data>
      <data key="d2">An approach to dialogue systems utilizing context RNNs to summarize dialogue history across multiple utterances before decoding.</data>
      <data key="d3">chunk-298f7bb76f5ebb6d2dd7ddc9afddde09</data>
    </node>
    <node id="Text Simplification">
      <data key="d0">Text Simplification</data>
      <data key="d1">category</data>
      <data key="d2">Text simplification is a natural language processing task aimed at reducing the reading difficulty of complex sentences while preserving original meaning and grammatical correctness.</data>
      <data key="d3">chunk-fab274e4799f62f2fbfabf369fb71267</data>
    </node>
    <node id="Attention-based Seq2seq Model">
      <data key="d0">Attention-based Seq2seq Model</data>
      <data key="d1">category</data>
      <data key="d2">An attention-based sequence-to-sequence model is a neural network architecture consisting of an encoder and a decoder with an attention mechanism, used here to translate complex sentences into simplified text.</data>
      <data key="d3">chunk-fab274e4799f62f2fbfabf369fb71267</data>
    </node>
    <node id="Newsela">
      <data key="d0">Newsela</data>
      <data key="d1">organization</data>
      <data key="d2">An educational content organization that produced a corpus of high-quality sentence simplifications written by professional editors, used for training and testing models.&lt;SEP&gt;An educational content platform producing articles simplified to different reading levels, widely used as an evaluation dataset in sentence simplification.&lt;SEP&gt;Newsela is an educational organization with professional editors who write news articles simplified for children across multiple grade levels.</data>
      <data key="d3">chunk-dcb2d684d656e9d9c24124949d2aaf80&lt;SEP&gt;chunk-fab274e4799f62f2fbfabf369fb71267&lt;SEP&gt;chunk-f52e20fe32ec91903501f1422f3fe621</data>
    </node>
    <node id="Newsela Corpus">
      <data key="d0">Newsela Corpus</data>
      <data key="d1">category</data>
      <data key="d2">The Newsela corpus is a high-quality text simplification dataset derived from news articles written by Newsela editors across varying grade levels.</data>
      <data key="d3">chunk-fab274e4799f62f2fbfabf369fb71267</data>
    </node>
    <node id="WikiSmall">
      <data key="d0">WikiSmall</data>
      <data key="d1">category</data>
      <data key="d2">A standard sentence simplification benchmark dataset with a 30K vocabulary size used for training and evaluating text simplification models.&lt;SEP&gt;WikiSmall is a text simplification dataset containing aligned complex-simple sentence pairs extracted from English Wikipedia and Simple English Wikipedia.</data>
      <data key="d3">chunk-fab274e4799f62f2fbfabf369fb71267&lt;SEP&gt;chunk-f52e20fe32ec91903501f1422f3fe621</data>
    </node>
    <node id="WikiLarge">
      <data key="d0">WikiLarge</data>
      <data key="d1">category</data>
      <data key="d2">A large-scale benchmark dataset for sentence simplification with a 30K vocabulary size used for training and evaluating models.&lt;SEP&gt;WikiLarge is a large-scale text simplification corpus compiled from multiple Wikipedia datasets and human-written simplifications.</data>
      <data key="d3">chunk-fab274e4799f62f2fbfabf369fb71267&lt;SEP&gt;chunk-f52e20fe32ec91903501f1422f3fe621</data>
    </node>
    <node id="English Wikipedia">
      <data key="d0">English Wikipedia</data>
      <data key="d1">category</data>
      <data key="d2">English Wikipedia (EW) is a free online encyclopedia in the English language, from which complex source sentences were extracted for simplification datasets.&lt;SEP&gt;English Wikipedia is a free online encyclopedia whose May 2015 text dump was used as the training corpus for the neural network model.</data>
      <data key="d3">chunk-2fd39034576eb8de5d243305db77f4b3&lt;SEP&gt;chunk-fab274e4799f62f2fbfabf369fb71267</data>
    </node>
    <node id="Bidirectional-RNN">
      <data key="d0">Bidirectional-RNN</data>
      <data key="d1">category</data>
      <data key="d2">A Bidirectional-RNN is a variant of recurrent neural networks that processes input sequences in both forward and reverse directions to capture preceding and subsequent words.</data>
      <data key="d3">chunk-fab274e4799f62f2fbfabf369fb71267</data>
    </node>
    <node id="Beam-Search Strategy">
      <data key="d0">Beam-Search Strategy</data>
      <data key="d1">category</data>
      <data key="d2">A beam-search strategy is a heuristic search algorithm used during decoding that tracks a fixed number of highest-scoring candidate sequences at each generation time step.</data>
      <data key="d3">chunk-fab274e4799f62f2fbfabf369fb71267</data>
    </node>
    <node id="Greedy Strategy">
      <data key="d0">Greedy Strategy</data>
      <data key="d1">category</data>
      <data key="d2">A greedy strategy is a search heuristic used during sequence decoding that greedily selects the word candidate with the highest log-probability at each generation step.</data>
      <data key="d3">chunk-fab274e4799f62f2fbfabf369fb71267</data>
    </node>
    <node id="LstmLstm">
      <data key="d0">LstmLstm</data>
      <data key="d1">category</data>
      <data key="d2">A neural sequence-to-sequence model architecture consisting of a two-layer LSTM encoder and a two-layer LSTM decoder.&lt;SEP&gt;LstmLstm is an attention-based sequence-to-sequence model configuration where both the encoder and decoder are implemented with two LSTM layers.</data>
      <data key="d3">chunk-fab274e4799f62f2fbfabf369fb71267&lt;SEP&gt;chunk-f52e20fe32ec91903501f1422f3fe621</data>
    </node>
    <node id="NseLstm">
      <data key="d0">NseLstm</data>
      <data key="d1">category</data>
      <data key="d2">A neural sequence-to-sequence model architecture with an encoder implemented by Neural Semantic Encoders (NSE) and a two-layer LSTM decoder.&lt;SEP&gt;NseLstm is an attention-based sequence-to-sequence model configuration where the encoder is implemented via Neural Semantic Encoders and the decoder is implemented with two LSTM layers.</data>
      <data key="d3">chunk-fab274e4799f62f2fbfabf369fb71267&lt;SEP&gt;chunk-f52e20fe32ec91903501f1422f3fe621</data>
    </node>
    <node id="Titan-X GPU">
      <data key="d0">Titan-X GPU</data>
      <data key="d1">category</data>
      <data key="d2">The NVIDIA Titan-X GPU is a high-performance graphics processing unit utilized to run computational experiments and train the neural text simplification models.</data>
      <data key="d3">chunk-fab274e4799f62f2fbfabf369fb71267</data>
    </node>
    <node id="Neural Seq2seq Models">
      <data key="d0">Neural Seq2seq Models</data>
      <data key="d1">category</data>
      <data key="d2">A class of deep learning sequence-to-sequence models, including LstmLstm and NseLstm, designed and trained to perform sentence simplification.</data>
      <data key="d3">chunk-f52e20fe32ec91903501f1422f3fe621</data>
    </node>
    <node id="Automatic Evaluation Measures">
      <data key="d0">Automatic Evaluation Measures</data>
      <data key="d1">category</data>
      <data key="d2">Algorithmic metrics such as BLEU and SARI used to automatically assess the quality and ngram/lexical accuracy of generated simplifications.</data>
      <data key="d3">chunk-f52e20fe32ec91903501f1422f3fe621</data>
    </node>
    <node id="Human Judgments">
      <data key="d0">Human Judgments</data>
      <data key="d1">category</data>
      <data key="d2">A qualitative evaluation methodology assessing model outputs across fluency, adequacy, and simplicity using volunteer raters on a Likert scale.</data>
      <data key="d3">chunk-f52e20fe32ec91903501f1422f3fe621</data>
    </node>
    <node id="Dress">
      <data key="d0">Dress</data>
      <data key="d1">category</data>
      <data key="d2">A sentence simplification baseline system based on deep reinforcement learning.</data>
      <data key="d3">chunk-f52e20fe32ec91903501f1422f3fe621</data>
    </node>
    <node id="Dress-Ls">
      <data key="d0">Dress-Ls</data>
      <data key="d1">category</data>
      <data key="d2">A sentence simplification model that combines the Dress reinforcement learning model with a lexical simplification component.</data>
      <data key="d3">chunk-f52e20fe32ec91903501f1422f3fe621</data>
    </node>
    <node id="Pbmt-R">
      <data key="d0">Pbmt-R</data>
      <data key="d1">category</data>
      <data key="d2">A phrase-based machine translation (PBMT) simplification model that incorporates dissimilarity-based re-ranking.</data>
      <data key="d3">chunk-f52e20fe32ec91903501f1422f3fe621</data>
    </node>
    <node id="Hybrid">
      <data key="d0">Hybrid</data>
      <data key="d1">category</data>
      <data key="d2">A hybrid semantic-based simplification model combining a sentence simplification model and a monolingual machine translation model.</data>
      <data key="d3">chunk-f52e20fe32ec91903501f1422f3fe621</data>
    </node>
    <node id="Sbmt-Sari">
      <data key="d0">Sbmt-Sari</data>
      <data key="d1">category</data>
      <data key="d2">A syntax-based machine translation (SBMT) simplification model equipped with simplification-specific components, trained on a large corpus.</data>
      <data key="d3">chunk-f52e20fe32ec91903501f1422f3fe621</data>
    </node>
    <node id="Human Evaluators">
      <data key="d0">Human Evaluators</data>
      <data key="d1">person</data>
      <data key="d2">The three volunteer judges who evaluated the simplifications on fluency, adequacy, and simplicity using a Likert scale.</data>
      <data key="d3">chunk-f52e20fe32ec91903501f1422f3fe621</data>
    </node>
    <node id="Professional Editors">
      <data key="d0">Professional Editors</data>
      <data key="d1">person</data>
      <data key="d2">Professional writers and editors responsible for composing the high-quality reference simplifications within the Newsela corpus.</data>
      <data key="d3">chunk-f52e20fe32ec91903501f1422f3fe621</data>
    </node>
    <node id="Emily Druhl">
      <data key="d0">Emily Druhl</data>
      <data key="d1">person</data>
      <data key="d2">An individual acknowledged for providing help with the sentence simplification research.</data>
      <data key="d3">chunk-dcb2d684d656e9d9c24124949d2aaf80</data>
    </node>
    <node id="Jesse Lingeman">
      <data key="d0">Jesse Lingeman</data>
      <data key="d1">person</data>
      <data key="d2">An individual acknowledged for assisting with the research on sentence simplification.</data>
      <data key="d3">chunk-dcb2d684d656e9d9c24124949d2aaf80</data>
    </node>
    <node id="UMass BioNLP Team">
      <data key="d0">UMass BioNLP Team</data>
      <data key="d1">organization</data>
      <data key="d2">A research team at the University of Massachusetts acknowledged for assisting with the sentence simplification research.</data>
      <data key="d3">chunk-dcb2d684d656e9d9c24124949d2aaf80</data>
    </node>
    <node id="Xingxing Zhang">
      <data key="d0">Xingxing Zhang</data>
      <data key="d1">person</data>
      <data key="d2">A researcher acknowledged for participating in valuable discussions related to the sentence simplification study.</data>

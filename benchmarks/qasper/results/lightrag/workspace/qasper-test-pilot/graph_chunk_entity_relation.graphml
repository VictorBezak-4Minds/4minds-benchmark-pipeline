      <data key="d0">Rusu</data>
      <data key="d1">person</data>
      <data key="d2">Rusu is a researcher who studied posthumous articles and negative evaluations of famous deceased individuals in 2017.</data>
      <data key="d3">chunk-9a42d2500d95a11dc6c778a73c5dba9c</data>
    </node>

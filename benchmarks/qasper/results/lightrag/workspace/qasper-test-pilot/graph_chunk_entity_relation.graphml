    </node>
    <node id="TED">
      <data key="d0">TED</data>
      <data key="d1">organization</data>
      <data key="d2">A media organization known for publishing international talks and presentations, used as a source for speech translation corpora.&lt;SEP&gt;TED is a media organization that disseminates spoken presentations (TED Talks), used in the corpus to represent informal spoken language.</data>
      <data key="d3">chunk-6b470fa40233ba7e36a9f7c70bafce9c&lt;SEP&gt;chunk-0c10d3bd2a312359e6f2e1f854a8d2ea</data>
    </node>

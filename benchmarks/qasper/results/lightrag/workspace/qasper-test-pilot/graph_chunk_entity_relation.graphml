    <node id="Hwang">
      <data key="d0">Hwang</data>
      <data key="d1">person</data>
      <data key="d2">Hwang is a researcher referenced for proposing a method to concatenate user utterances and database column headers separated by a [SEP] token for BERT processing.</data>
      <data key="d3">chunk-56c893ccea72c9785303bae311f29c7b</data>
    </node>
    <node id="SQL">
      <data key="d0">SQL</data>
      <data key="d1">category</data>
      <data key="d2">SQL is a category of relational database query languages whose tokens and queries are generated by the model's decoder based on conversational history and schema context.&lt;SEP&gt;Structured Query Language, the target database query language featuring clauses such as SELECT, FROM, GROUP BY, ORDER BY, and WHERE that the models aim to generate.</data>
      <data key="d3">chunk-fdb0afdde0d066987770f69fd6c4b0b4&lt;SEP&gt;chunk-56c893ccea72c9785303bae311f29c7b</data>
    </node>
    <node id="Utterance-Table Encoder">
      <data key="d0">Utterance-Table Encoder</data>
      <data key="d1">category</data>
      <data key="d2">A neural network component designed to jointly encode natural language user utterances and relational database table schemas using bi-LSTMs and co-attention mechanisms.</data>
      <data key="d3">chunk-56c893ccea72c9785303bae311f29c7b</data>
    </node>
    <node id="Table-Aware Decoder">
      <data key="d0">Table-Aware Decoder</data>
      <data key="d1">category</data>
      <data key="d2">A specialized LSTM-based decoding architecture with attention mechanisms that generates database queries by conditioning on user utterances, interaction history, and table schemas.</data>
      <data key="d3">chunk-56c893ccea72c9785303bae311f29c7b</data>
    </node>
    <node id="Turn Attention">
      <data key="d0">Turn Attention</data>
      <data key="d1">category</data>
      <data key="d2">An attention mechanism category designed to capture and focus on information across previous conversational turns in dialogue history.&lt;SEP&gt;An attention mechanism used to capture correlations between the current utterance and prior conversational history by computing dot-product attention over historical dialogue turns.</data>
      <data key="d3">chunk-fdb0afdde0d066987770f69fd6c4b0b4&lt;SEP&gt;chunk-56c893ccea72c9785303bae311f29c7b</data>
    </node>
    <node id="Interaction Encoder">
      <data key="d0">Interaction Encoder</data>
      <data key="d1">category</data>
      <data key="d2">A uni-directional LSTM module layered on top of the utterance encoder that tracks and summarizes sequential conversational dialogue states across turns.</data>
      <data key="d3">chunk-56c893ccea72c9785303bae311f29c7b</data>
    </node>
    <node id="Co-Attention">
      <data key="d0">Co-Attention</data>
      <data key="d1">category</data>
      <data key="d2">A bidirectional attention mechanism that creates mutual dependencies between representations of natural language utterances and database schema column headers.</data>
      <data key="d3">chunk-56c893ccea72c9785303bae311f29c7b</data>
    </node>
    <node id="Cross-Domain Setting">
      <data key="d0">Cross-Domain Setting</data>
      <data key="d1">category</data>
      <data key="d2">A semantic parsing task setting where models must generalize and ground interactions to unseen relational databases with varied schemas.</data>
      <data key="d3">chunk-56c893ccea72c9785303bae311f29c7b</data>
    </node>
    <node id="Context-Dependent Semantic Parsing">
      <data key="d0">Context-Dependent Semantic Parsing</data>
      <data key="d1">category</data>
      <data key="d2">A category of semantic parsing that interprets user utterances across multi-turn interactions, taking into account conversational history and evolving context.</data>
      <data key="d3">chunk-425ff15de9cdf497af29b3dcbbab27df</data>
    </node>
    <node id="Text-to-SQL">
      <data key="d0">Text-to-SQL</data>
      <data key="d1">category</data>
      <data key="d2">A category of natural language processing and semantic parsing tasks focused on translating human language utterances into structured SQL queries.&lt;SEP&gt;A specialized task and domain within semantic parsing that involves translating natural language questions into structured SQL queries over relational databases.</data>
      <data key="d3">chunk-506d24d16d4296b3078ff20115c8082b&lt;SEP&gt;chunk-425ff15de9cdf497af29b3dcbbab27df</data>
    </node>
    <node id="Gu">
      <data key="d0">Gu</data>
      <data key="d1">person</data>
      <data key="d2">A researcher noted for introducing the copy mechanism in neural models for natural language applications such as text summarization and response generation.</data>
      <data key="d3">chunk-425ff15de9cdf497af29b3dcbbab27df</data>
    </node>
    <node id="See">

      <data key="d0">Maple Ridge Legion</data>
      <data key="d1">organization</data>
      <data key="d2">A venue located on 224th Street in Maple Ridge where a Celebration of Life is held.</data>
      <data key="d3">chunk-9645cad08b5b060013cac117d156f888</data>
    </node>
    <node id="Maple Ridge">
      <data key="d0">Maple Ridge</data>
      <data key="d1">geo</data>
      <data key="d2">A geographic location hosting the Maple Ridge Legion referenced in an example funeral announcement.</data>
      <data key="d3">chunk-9645cad08b5b060013cac117d156f888</data>
    </node>
    <node id="Ukrainian Community">
      <data key="d0">Ukrainian Community</data>
      <data key="d1">organization</data>
      <data key="d2">A cultural community whose arts sector was described as being elevated in a tribute example sentence.</data>
      <data key="d3">chunk-9645cad08b5b060013cac117d156f888</data>
    </node>
    <node id="Google News">
      <data key="d0">Google News</data>
      <data key="d1">organization</data>
      <data key="d2">A news aggregation service whose articles and corpora are cited as containing contextual gender bias.&lt;SEP&gt;Google News is a news aggregation service whose 100 billion word corpus was used to train Mikolov's released Skip-gram model.&lt;SEP&gt;Google News is a news aggregator service whose dataset provided pre-trained Word2Vec word embeddings for the evaluated BiLSTM text classification models.</data>
      <data key="d3">chunk-cd215c830f4336951c05421c32e7aed1&lt;SEP&gt;chunk-f3e8fa58e562bb861dae62114ff9c810&lt;SEP&gt;chunk-806c5b143029efcdf6de258a039af615</data>
    </node>
    <node id="Ambiguity">
      <data key="d0">Ambiguity</data>
      <data key="d1">category</data>
      <data key="d2">Ambiguity is an error category accounting for 39% of model classification errors where sentences could reasonably belong to multiple zones.</data>
      <data key="d3">chunk-cd215c830f4336951c05421c32e7aed1</data>
    </node>
    <node id="Annotation">
      <data key="d0">Annotation</data>
      <data key="d1">category</data>
      <data key="d2">Annotation is an error category representing instances where model predictions were correct but original dataset labels were incorrect.</data>
      <data key="d3">chunk-cd215c830f4336951c05421c32e7aed1</data>
    </node>
    <node id="Experimental Setup">
      <data key="d0">Experimental Setup</data>
      <data key="d1">event</data>
      <data key="d2">The experimental procedure conducted on 1008 obituaries to evaluate and compare text classification models.</data>
      <data key="d3">chunk-cd215c830f4336951c05421c32e7aed1</data>
    </node>
    <node id="Error Analysis">
      <data key="d0">Error Analysis</data>
      <data key="d1">event</data>
      <data key="d2">The manual analytical study examining and categorizing classification failures of the best-performing model on the test set.</data>
      <data key="d3">chunk-cd215c830f4336951c05421c32e7aed1</data>
    </node>
    <node id="CNN Model">
      <data key="d0">CNN Model</data>
      <data key="d1">category</data>
      <data key="d2">A convolutional neural network architecture evaluated for obituary text zone classification, achieving the highest macro average F1 score of 0.65.</data>
      <data key="d3">chunk-cd215c830f4336951c05421c32e7aed1</data>
    </node>
    <node id="BiLSTM (BOW)">
      <data key="d0">BiLSTM (BOW)</data>
      <data key="d1">category</data>
      <data key="d2">A bidirectional LSTM model using bag-of-words representation, 100 memory units, softmax activation, and categorical cross-entropy loss.</data>
      <data key="d3">chunk-cd215c830f4336951c05421c32e7aed1</data>
    </node>
    <node id="BiLSTM (W2V)">
      <data key="d0">BiLSTM (W2V)</data>
      <data key="d1">category</data>
      <data key="d2">A bidirectional LSTM model incorporating pre-trained Word2Vec embeddings from Google News.</data>
      <data key="d3">chunk-cd215c830f4336951c05421c32e7aed1</data>
    </node>
    <node id="BiLSTM-CRF">
      <data key="d0">BiLSTM-CRF</data>
      <data key="d1">category</data>
      <data key="d2">A bidirectional LSTM model extending the BiLSTM (W2V) architecture with an added conditional random field output layer.&lt;SEP&gt;A hybrid neural architecture combining bidirectional LSTM networks with conditional random fields for structural sequence tagging.</data>
      <data key="d3">chunk-cd215c830f4336951c05421c32e7aed1&lt;SEP&gt;chunk-be334478ba316675f89bc24ce6e3c03a</data>
    </node>
    <node id="Training Set">
      <data key="d0">Training Set</data>
      <data key="d1">category</data>
      <data key="d2">A partition comprising 70% of the 1008 obituaries used to train the machine learning models.</data>
      <data key="d3">chunk-cd215c830f4336951c05421c32e7aed1</data>
    </node>
    <node id="Test Set">
      <data key="d0">Test Set</data>
      <data key="d1">category</data>
      <data key="d2">A partition comprising 30% of the 1008 obituaries used to evaluate model performance and inspect classification errors.</data>
      <data key="d3">chunk-cd215c830f4336951c05421c32e7aed1</data>
    </node>
    <node id="Validation Set">
      <data key="d0">Validation Set</data>
      <data key="d1">category</data>
      <data key="d2">A dataset split of development data evaluated after each training epoch to determine and select the model with the highest per-class accuracy.&lt;SEP&gt;A subset representing 10% of the training set used for model validation during experiments.</data>
      <data key="d3">chunk-cd215c830f4336951c05421c32e7aed1&lt;SEP&gt;chunk-de8f6faf25c75fd8dcf0e4d67e379249</data>
    </node>
    <node id="Errors Tagged As Other">
      <data key="d0">Errors Tagged As Other</data>
      <data key="d1">category</data>
      <data key="d2">An error analysis classification covering 42% of model mistakes that are diverse, harder to explain, or caused by misleading predictive words.</data>
      <data key="d3">chunk-cd215c830f4336951c05421c32e7aed1</data>
    </node>
    <node id="Token-Based IOB Scheme">
      <data key="d0">Token-Based IOB Scheme</data>
      <data key="d1">category</data>
      <data key="d2">A sequence labeling scheme adopted for BiLSTM models to map the dominantly predicted class within a sentence to the entire sentence.</data>
      <data key="d3">chunk-cd215c830f4336951c05421c32e7aed1</data>
    </node>
    <node id="Societal Memory">
      <data key="d0">Societal Memory</data>
      <data key="d1">category</data>
      <data key="d2">A proposed annotation class designed to capture expressions regarding what the broader community will miss following a loss.</data>
      <data key="d3">chunk-be334478ba316675f89bc24ce6e3c03a</data>
    </node>
    <node id="Wish">
      <data key="d0">Wish</data>
      <data key="d1">category</data>
      <data key="d2">A proposed sub-category intended to be split from the Other class to refine obituary annotation.</data>
      <data key="d3">chunk-be334478ba316675f89bc24ce6e3c03a</data>
    </node>
    <node id="Quote">
      <data key="d0">Quote</data>
      <data key="d1">category</data>
      <data key="d2">A proposed sub-category suggested to be partitioned from the Other class in the annotation scheme.</data>
      <data key="d3">chunk-be334478ba316675f89bc24ce6e3c03a</data>
    </node>
    <node id="Trolls">
      <data key="d0">Trolls</data>
      <data key="d1">category</data>
      <data key="d2">A category of suspicious online accounts that disguise their identities to spread hate, incitement, and deceptive messages.&lt;SEP&gt;Trolls are online suspicious accounts disguised as regular users to spread hate, fake news, and deceptive messages aimed at polarizing communities.</data>
      <data key="d3">chunk-075e25354814630ae73f42287e577734&lt;SEP&gt;chunk-be334478ba316675f89bc24ce6e3c03a</data>
    </node>
    <node id="BOW Model">
      <data key="d0">BOW Model</data>
      <data key="d1">category</data>
      <data key="d2">A bag-of-words feature representation model combined with BiLSTM for classifying obituary sentences.</data>
      <data key="d3">chunk-be334478ba316675f89bc24ce6e3c03a</data>
    </node>
    <node id="Topic Modeler">
      <data key="d0">Topic Modeler</data>
      <data key="d1">category</data>
      <data key="d2">An algorithmic text modeling approach suggested for future comparative structural analysis against manual obituary annotations.</data>
      <data key="d3">chunk-be334478ba316675f89bc24ce6e3c03a</data>
    </node>
    <node id="Emotion Classes">
      <data key="d0">Emotion Classes</data>
      <data key="d1">category</data>
      <data key="d2">Proposed affective categories for future post-annotation of the obituary corpus to study emotional connotations.</data>
      <data key="d3">chunk-be334478ba316675f89bc24ce6e3c03a</data>
    </node>
    <node id="Fleiss">
      <data key="d0">Fleiss</data>
      <data key="d1">person</data>
      <data key="d2">Statistician associated with Fleiss' kappa, the inter-annotator agreement metric used to evaluate obituary annotation reliability.</data>
      <data key="d3">chunk-be334478ba316675f89bc24ce6e3c03a</data>
    </node>
    <node id="Internet Research Agency">
      <data key="d0">Internet Research Agency</data>
      <data key="d1">organization</data>
      <data key="d2">The Internet Research Agency (IRA) is a Russian organization that ran suspicious online troll campaigns aimed at spreading disinformation and influencing political events, notably the 2016 US presidential elections.</data>
      <data key="d3">chunk-075e25354814630ae73f42287e577734</data>
    </node>
    <node id="UAE">
      <data key="d0">UAE</data>
      <data key="d1">geo</data>
      <data key="d2">The United Arab Emirates (UAE) is one of the countries identified by Facebook as a source of coordinated inauthentic online campaigns targeting other Middle Eastern nations.</data>
      <data key="d3">chunk-075e25354814630ae73f42287e577734</data>
    </node>
    <node id="Egypt">
      <data key="d0">Egypt</data>
      <data key="d1">geo</data>
      <data key="d2">Egypt is an origin country identified by Facebook in mid-2019 for spreading fake news to support ideological agendas in neighboring Middle Eastern countries.</data>
      <data key="d3">chunk-075e25354814630ae73f42287e577734</data>
    </node>
    <node id="Saudi Arabia">
      <data key="d0">Saudi Arabia</data>
      <data key="d1">geo</data>
      <data key="d2">Saudi Arabia is an origin country detected by Facebook for running fake-identity accounts and pages targeting other Middle Eastern countries.</data>
      <data key="d3">chunk-075e25354814630ae73f42287e577734</data>
    </node>
    <node id="Qatar">
      <data key="d0">Qatar</data>
      <data key="d1">geo</data>
      <data key="d2">Qatar is a Middle Eastern country targeted by fake news and coordinated influence operations originating from the UAE, Egypt, and Saudi Arabia.</data>
      <data key="d3">chunk-075e25354814630ae73f42287e577734</data>
    </node>
    <node id="Palestine">
      <data key="d0">Palestine</data>
      <data key="d1">geo</data>
      <data key="d2">Palestine is a location targeted by disinformation campaigns on Facebook originating from the UAE, Egypt, and Saudi Arabia.</data>
      <data key="d3">chunk-075e25354814630ae73f42287e577734</data>
    </node>
    <node id="Lebanon">
      <data key="d0">Lebanon</data>
      <data key="d1">geo</data>
      <data key="d2">Lebanon is a Middle Eastern country targeted by ideological fake news campaigns conducted via Facebook.</data>
      <data key="d3">chunk-075e25354814630ae73f42287e577734</data>
    </node>
    <node id="Jordan">
      <data key="d0">Jordan</data>
      <data key="d1">geo</data>
      <data key="d2">Jordan is a Middle Eastern country targeted by deceptive online campaigns originating from the UAE, Egypt, and Saudi Arabia.</data>
      <data key="d3">chunk-075e25354814630ae73f42287e577734</data>
    </node>
    <node id="2016 US Presidential Elections">
      <data key="d0">2016 US Presidential Elections</data>
      <data key="d1">event</data>
      <data key="d2">The 2016 US presidential elections is a major political contest used to evaluate the accuracy of forecasting outcomes from Twitter data.&lt;SEP&gt;The 2016 US presidential elections was a major political event in the United States used as a source for data queries and tweet analysis.&lt;SEP&gt;The 2016 US presidential elections was a nationwide political contest in the United States used as a source for data queries and election-related tweet analysis.&lt;SEP&gt;The 2016 US presidential elections were a major political event targeted by the Russian Internet Research Agency's disinformation and trolling campaigns to influence results and polarize public opinion.&lt;SEP&gt;The general election in the United States evaluated state by state for both final candidates.</data>
      <data key="d3">chunk-075e25354814630ae73f42287e577734&lt;SEP&gt;chunk-6493a9a6ebb59ca9af8c494e6ec25637&lt;SEP&gt;chunk-97953bb0d586e46165fea699da6cf781&lt;SEP&gt;chunk-e3643b20dc5e5b3d9faa14743574ec5c</data>
    </node>
    <node id="Pizzagate">
      <data key="d0">Pizzagate</data>
      <data key="d1">event</data>
      <data key="d2">Pizzagate is a well-known disinformation and fake news controversy that occurred in the United States around the presidential elections.</data>
      <data key="d3">chunk-075e25354814630ae73f42287e577734</data>
    </node>
    <node id="Brexit">
      <data key="d0">Brexit</data>
      <data key="d1">event</data>
      <data key="d2">Brexit refers to the United Kingdom's withdrawal from the European Union, an event around which IRA trolls shared related links and tweets.</data>
      <data key="d3">chunk-075e25354814630ae73f42287e577734</data>
    </node>
    <node id="Robots">
      <data key="d0">Robots</data>
      <data key="d1">category</data>
      <data key="d2">Robots, or bots, are a category of automated online suspicious accounts used on social networks.</data>
      <data key="d3">chunk-075e25354814630ae73f42287e577734</data>
    </node>
    <node id="Cyborgs">
      <data key="d0">Cyborgs</data>
      <data key="d1">category</data>
      <data key="d2">Cyborgs are a category of suspicious accounts combining human operation and automated software, similar in some respects to trolls.</data>
      <data key="d3">chunk-075e25354814630ae73f42287e577734</data>
    </node>
    <node id="Human Spammers">
      <data key="d0">Human Spammers</data>
      <data key="d1">category</data>
      <data key="d2">Human spammers are a category of suspicious online accounts manually operated by human users to distribute deceptive or unwanted content.</data>
      <data key="d3">chunk-075e25354814630ae73f42287e577734</data>
    </node>
    <node id="Software-Assisted Human Workers">
      <data key="d0">Software-Assisted Human Workers</data>
      <data key="d1">category</data>
      <data key="d2">A classification of suspicious accounts describing individuals who operate online with automated tool assistance rather than purely autonomous bots, representing IRA trolls.</data>
      <data key="d3">chunk-075e25354814630ae73f42287e577734</data>
    </node>
    <node id="Legitimate Accounts">
      <data key="d0">Legitimate Accounts</data>
      <data key="d1">category</data>
      <data key="d2">Regular, authentic social media users used as a baseline and control group in contrast to troll accounts for training detection models.</data>
      <data key="d3">chunk-075e25354814630ae73f42287e577734</data>
    </node>
    <node id="Left Ideological Trolls">
      <data key="d0">Left Ideological Trolls</data>
      <data key="d1">category</data>
      <data key="d2">A subgroup of IRA troll accounts operating under left-wing political orientations to influence discourse and target specific audiences.</data>
      <data key="d3">chunk-075e25354814630ae73f42287e577734</data>
    </node>
    <node id="Right Ideological Trolls">
      <data key="d0">Right Ideological Trolls</data>
      <data key="d1">category</data>
      <data key="d2">A subgroup of IRA troll accounts operating under right-wing political orientations to spread propaganda and foster polarization.</data>
      <data key="d3">chunk-075e25354814630ae73f42287e577734</data>
    </node>
    <node id="IRA">
      <data key="d0">IRA</data>
      <data key="d1">organization</data>
      <data key="d2">The Internet Research Agency (IRA) is an organization based in Russia whose trolls engaged in social media manipulation and disinformation campaigns, often mimicking US citizens on Twitter.&lt;SEP&gt;The Internet Research Agency (IRA) is an organization known for deploying automated or coordinated social media troll accounts to influence online discourse.&lt;SEP&gt;The Internet Research Agency (IRA) is an organization known for operating Russian troll accounts to influence public opinion and discourse on social media platforms such as Twitter and Facebook.&lt;SEP&gt;The Internet Research Agency (IRA), a Russian entity whose trolls engaged in social media manipulation, hashtag games, and political discourse on Twitter.</data>
      <data key="d3">chunk-56672a5cb0c14c3d38c148dbe5205622&lt;SEP&gt;chunk-fdb05b2a1cbb63e80256245c9da202fa&lt;SEP&gt;chunk-1f30e651d33c86668592dd08985152d4&lt;SEP&gt;chunk-3befbff7111b99c10b6944ee4347d22e</data>
    </node>
    <node id="Donald Trump">
      <data key="d0">Donald Trump</data>
      <data key="d1">person</data>
      <data key="d2">A political figure referenced in the study whose support was leveraged as a key thematic topic by IRA trolls.&lt;SEP&gt;A prominent political figure referenced in user prediction statements on Twitter regarding election wins.&lt;SEP&gt;Donald Trump is a US political figure referenced in the 2016 presidential election hashtags and a extracted topic theme ('Supporting Trump').&lt;SEP&gt;Donald Trump is a public figure whose multilingual Wikipedia articles in English and Tamil are used as a case study for sentence alignment and parallel extraction.&lt;SEP&gt;Donald Trump is an individual whose Wikipedia biographical article in English and Tamil is referenced as an example for phrase and sentence alignment.</data>
      <data key="d3">chunk-1f30e651d33c86668592dd08985152d4&lt;SEP&gt;chunk-cfa367d5347172364eadcba53c1dc471&lt;SEP&gt;chunk-116526d304daa442dbc1df519e7f8fc5&lt;SEP&gt;chunk-3befbff7111b99c10b6944ee4347d22e&lt;SEP&gt;chunk-5fff775482c4d8a3088b428b10d9f761</data>
    </node>
    <node id="Hillary Clinton">
      <data key="d0">Hillary Clinton</data>
      <data key="d1">person</data>
      <data key="d2">Hillary Clinton is a US political figure referenced in the 2016 election hashtags and an extracted topic theme ('Attacking Hillary').</data>
      <data key="d3">chunk-1f30e651d33c86668592dd08985152d4</data>
    </node>
    <node id="2016 US Presidential Election">
      <data key="d0">2016 US Presidential Election</data>
      <data key="d1">event</data>
      <data key="d2">The 2016 US Presidential Election was a major political event including presidential debates and election day targeted heavily by IRA troll activity.</data>
      <data key="d3">chunk-1f30e651d33c86668592dd08985152d4</data>
    </node>
    <node id="Latent Dirichlet Allocation">
      <data key="d0">Latent Dirichlet Allocation</data>
      <data key="d1">category</data>
      <data key="d2">A generative statistical topic model used in unsupervised approaches to discover latent topics and word classes from text reviews.&lt;SEP&gt;An unsupervised generative statistical topic modeling technique used to discover latent semantic topics across a corpus of documents.&lt;SEP&gt;Latent Dirichlet Allocation (LDA) is an algorithm and topic modeling category used to extract thematic topics from textual datasets.</data>
      <data key="d3">chunk-f76f1c0c2ed37a786263a6a6d8b0bb6d&lt;SEP&gt;chunk-1f30e651d33c86668592dd08985152d4&lt;SEP&gt;chunk-707d9bb0e2896feb599f211f8cc655a0</data>
    </node>
    <node id="NRC Emotion Lexicon">
      <data key="d0">NRC Emotion Lexicon</data>
      <data key="d1">category</data>
      <data key="d2">The NRC emotion lexicon is a lexical resource containing approximately 14,000 words categorized into eight Plutchik's emotions and positive/negative sentiment.</data>
      <data key="d3">chunk-1f30e651d33c86668592dd08985152d4</data>
    </node>
    <node id="US 2016 Presidential Debates">
      <data key="d0">US 2016 Presidential Debates</data>
      <data key="d1">event</data>
      <data key="d2">The series of televised debates—including the first, second, third, and vice presidential debates—held in late 2016 that represented a focal period for troll activity.</data>
      <data key="d3">chunk-1f30e651d33c86668592dd08985152d4</data>
    </node>
    <node id="Robert Plutchik">
      <data key="d0">Robert Plutchik</data>
      <data key="d1">person</data>
      <data key="d2">Robert Plutchik is the psychologist whose model of eight basic emotions forms the framework for the NRC emotion lexicon used in the text analysis.</data>
      <data key="d3">chunk-1f30e651d33c86668592dd08985152d4</data>
    </node>
    <node id="Police Shootings">
      <data key="d0">Police Shootings</data>
      <data key="d1">category</data>
      <data key="d2">A thematic category extracted via topic modeling, characterized by keywords such as police, officers, cops, shooting, and gun.</data>
      <data key="d3">chunk-1f30e651d33c86668592dd08985152d4</data>
    </node>
    <node id="Islam And War">
      <data key="d0">Islam And War</data>
      <data key="d1">category</data>
      <data key="d2">A thematic category identified through LDA topic modeling reflecting discussion topics present in the Twitter dataset.</data>
      <data key="d3">chunk-1f30e651d33c86668592dd08985152d4</data>
    </node>
    <node id="Black People">
      <data key="d0">Black People</data>
      <data key="d1">category</data>
      <data key="d2">A demographic group referenced as a subject targeted by divisive themes in IRA troll campaigns.&lt;SEP&gt;A thematic category extracted by the LDA model representing racial discussion themes targeted in online posts.</data>
      <data key="d3">chunk-1f30e651d33c86668592dd08985152d4&lt;SEP&gt;chunk-3befbff7111b99c10b6944ee4347d22e</data>
    </node>
    <node id="Civil Rights">
      <data key="d0">Civil Rights</data>
      <data key="d1">category</data>
      <data key="d2">A thematic category extracted from tweets representing civil liberties and societal issues analyzed in the study.</data>
      <data key="d3">chunk-1f30e651d33c86668592dd08985152d4</data>
    </node>
    <node id="Crimes">
      <data key="d0">Crimes</data>
      <data key="d1">category</data>
      <data key="d2">A thematic category extracted via topic modeling focusing on violent crimes, including crimes against women and children.</data>
      <data key="d3">chunk-1f30e651d33c86668592dd08985152d4</data>
    </node>
    <node id="Stance Detection">
      <data key="d0">Stance Detection</data>
      <data key="d1">category</data>
      <data key="d2">A Natural Language Processing task and analytical method used to identify the attitude or position of a user or tweet reply toward specific topics or threads.&lt;SEP&gt;A natural language processing feature and analytical technique used to determine user positions relative to specific extracted topics.&lt;SEP&gt;An NLP research task aimed at determining the stance or opinion of a post author toward a specific target, which can benefit from named entity features.</data>
      <data key="d3">chunk-f717f876f65432fa813fac20ad6a7ddb&lt;SEP&gt;chunk-56672a5cb0c14c3d38c148dbe5205622&lt;SEP&gt;chunk-1f30e651d33c86668592dd08985152d4</data>
    </node>
    <node id="Emotion Analysis">
      <data key="d0">Emotion Analysis</data>
      <data key="d1">category</data>
      <data key="d2">A computational task dedicated to evaluating and quantifying emotional states and valence intensity in text.&lt;SEP&gt;A textual feature analysis category used to identify emotional manipulation, sentiment changes, and fear-spreading behaviors in user tweets.</data>
      <data key="d3">chunk-b31134945186e62e7effccb3ba89b180&lt;SEP&gt;chunk-1f30e651d33c86668592dd08985152d4</data>
    </node>
    <node id="IRA Campaign">
      <data key="d0">IRA Campaign</data>
      <data key="d1">event</data>
      <data key="d2">An online influence operation originating in Russia where IRA troll accounts concealed their identities and posted tweets targeting various topics on Twitter.</data>
      <data key="d3">chunk-56672a5cb0c14c3d38c148dbe5205622</data>
    </node>
    <node id="Stance Cues">
      <data key="d0">Stance Cues</data>
      <data key="d1">category</data>
      <data key="d2">A category of lexicon-based features used to detect user stance regarding topics, covering categories such as belief, denial, doubt, fake, knowledge, negation, question, and report.</data>
      <data key="d3">chunk-56672a5cb0c14c3d38c148dbe5205622</data>
    </node>
    <node id="Bias Cues">
      <data key="d0">Bias Cues</data>
      <data key="d1">category</data>
      <data key="d2">A category of lexical features designed to capture bias in text, including assertive verbs, factive verbs, implicative verbs, hedges, and report verbs.</data>
      <data key="d3">chunk-56672a5cb0c14c3d38c148dbe5205622</data>
    </node>
    <node id="LIWC">
      <data key="d0">LIWC</data>
      <data key="d1">category</data>
      <data key="d2">A collection of linguistic categories derived from the Linguistic Inquiry and Word Count dictionary, including pronoun, anxiety, cognitive mechanism, and insight.&lt;SEP&gt;Linguistic Inquiry and Word Count, an analytical framework and feature set used to analyze psychological and emotional dimensions of tweet texts.</data>
      <data key="d3">chunk-56672a5cb0c14c3d38c148dbe5205622&lt;SEP&gt;chunk-fdb05b2a1cbb63e80256245c9da202fa</data>
    </node>
    <node id="Morality Cues">
      <data key="d0">Morality Cues</data>
      <data key="d1">category</data>
      <data key="d2">A set of feature categories based on the morality foundation theory, covering care, harm, fairness, cheating, loyalty, betrayal, authority, subversion, sanctity, and degradation.</data>
      <data key="d3">chunk-56672a5cb0c14c3d38c148dbe5205622</data>
    </node>
    <node id="Native Language Identification">
      <data key="d0">Native Language Identification</data>
      <data key="d1">category</data>
      <data key="d2">A text representation feature category used to identify syntactic patterns of non-native English speakers to detect IRA trolls.</data>
      <data key="d3">chunk-56672a5cb0c14c3d38c148dbe5205622</data>
    </node>
    <node id="Stylistic Features">
      <data key="d0">Stylistic Features</data>
      <data key="d1">category</data>
      <data key="d2">An authorship attribution feature category measuring attributes like counts of special characters, URLs, hashtags, mentions, uppercase ratio, and tweet length.</data>
      <data key="d3">chunk-56672a5cb0c14c3d38c148dbe5205622</data>
    </node>
    <node id="Authorship Attribution">
      <data key="d0">Authorship Attribution</data>
      <data key="d1">category</data>
      <data key="d2">A domain in computational linguistics focused on identifying the author of a text based on stylistic and syntactic markers.</data>
      <data key="d3">chunk-56672a5cb0c14c3d38c148dbe5205622</data>
    </node>
    <node id="Morality Foundation Theory">
      <data key="d0">Morality Foundation Theory</data>
      <data key="d1">category</data>
      <data key="d2">A theoretical framework categorizing human moral reasoning into foundations such as care, harm, fairness, cheating, loyalty, betrayal, authority, subversion, sanctity, and degradation.</data>
      <data key="d3">chunk-56672a5cb0c14c3d38c148dbe5205622</data>
    </node>
    <node id="Syntactic Dependency Relations">
      <data key="d0">Syntactic Dependency Relations</data>
      <data key="d1">category</data>
      <data key="d2">A structural syntactic feature category (DEPREL) capturing grammatical relationships between words in sentences.</data>
      <data key="d3">chunk-56672a5cb0c14c3d38c148dbe5205622</data>
    </node>
    <node id="Bag Of Stopwords">
      <data key="d0">Bag Of Stopwords</data>
      <data key="d1">category</data>
      <data key="d2">A textual feature category tracking the frequency and presence of common function words to analyze language use patterns.</data>
      <data key="d3">chunk-56672a5cb0c14c3d38c148dbe5205622</data>
    </node>
    <node id="Factive Verbs">
      <data key="d0">Factive Verbs</data>
      <data key="d1">category</data>
      <data key="d2">A linguistic bias cue category consisting of verbs that presuppose the truth of their complement clauses.</data>
      <data key="d3">chunk-56672a5cb0c14c3d38c148dbe5205622</data>
    </node>
    <node id="Assertive Verbs">
      <data key="d0">Assertive Verbs</data>
      <data key="d1">category</data>
      <data key="d2">A linguistic cue category denoting verbs that express certainty or truth claims in text.</data>
      <data key="d3">chunk-56672a5cb0c14c3d38c148dbe5205622</data>
    </node>
    <node id="Implicative Verbs">
      <data key="d0">Implicative Verbs</data>
      <data key="d1">category</data>
      <data key="d2">A category of verbs used as bias cues that imply the truth or falsehood of their complements.</data>
      <data key="d3">chunk-56672a5cb0c14c3d38c148dbe5205622</data>
    </node>
    <node id="Hedges">
      <data key="d0">Hedges</data>
      <data key="d1">category</data>
      <data key="d2">A linguistic cue category of mitigating words or phrases used to express ambiguity, caution, or uncertainty.</data>
      <data key="d3">chunk-56672a5cb0c14c3d38c148dbe5205622</data>
    </node>
    <node id="Flip-Flop Behavior">
      <data key="d0">Flip-Flop Behavior</data>
      <data key="d1">category</data>
      <data key="d2">A behavioral pattern observed in IRA trolls characterized by rapid alternation of stances or personas across different themes.</data>
      <data key="d3">chunk-56672a5cb0c14c3d38c148dbe5205622</data>
    </node>
    <node id="Hashtag Game">
      <data key="d0">Hashtag Game</data>
      <data key="d1">event</data>
      <data key="d2">A popular interactive word game played on Twitter where users append a hashtag and respond to implied prompts, adapted by IRA trolls to conduct targeted attacks.&lt;SEP&gt;A popular word game activity on Twitter where users append hashtags to tweets to answer questions, utilized by IRA trolls to spread offensive messaging.</data>
      <data key="d3">chunk-56672a5cb0c14c3d38c148dbe5205622&lt;SEP&gt;chunk-3befbff7111b99c10b6944ee4347d22e</data>
    </node>
    <node id="Logistic Regression">
      <data key="d0">Logistic Regression</data>
      <data key="d1">category</data>
      <data key="d2">A statistical machine learning classification algorithm selected as the primary model due to achieving the highest weighted average F1 score.&lt;SEP&gt;A supervised machine learning classification algorithm that yielded the highest macro F1 score in the evaluation experiments.&lt;SEP&gt;Logistic Regression is a statistical and machine learning classification algorithm utilized for modeling categorical outcomes.&lt;SEP&gt;Logistic Regression is a statistical and machine learning classifier evaluated by S Jayaraman et al. for cuisine classification.</data>
      <data key="d3">chunk-bc715f7f0042435219a9937b5527ecef&lt;SEP&gt;chunk-56672a5cb0c14c3d38c148dbe5205622&lt;SEP&gt;chunk-6b6698485050fd363980b75ae23a237b&lt;SEP&gt;chunk-1e9f52662c01528fd8d607b1462c48df</data>
    </node>
    <node id="Tweet2vec">
      <data key="d0">Tweet2vec</data>
      <data key="d1">category</data>
      <data key="d2">A character-based Bidirectional Gated Recurrent baseline model used to represent tweet content for classification comparison.</data>
      <data key="d3">chunk-56672a5cb0c14c3d38c148dbe5205622</data>
    </node>
    <node id="SpaCy">
      <data key="d0">SpaCy</data>
      <data key="d1">organization</data>
      <data key="d2">An open-source natural language processing software library and organization providing off-the-shelf POS tagging and syntactic parsing tools.</data>
      <data key="d3">chunk-56672a5cb0c14c3d38c148dbe5205622</data>
    </node>
    <node id="Russians">
      <data key="d0">Russians</data>
      <data key="d1">category</data>
      <data key="d2">A linguistic and national group studied for distinct grammatical and prepositional writing characteristics when tweeting in English.</data>
      <data key="d3">chunk-3befbff7111b99c10b6944ee4347d22e</data>
    </node>
    <node id="Islam and War">
      <data key="d0">Islam and War</data>
      <data key="d1">category</data>
      <data key="d2">A thematic category analyzed in IRA tweets characterized by elevated levels of fear emotion and attacks on immigrants.</data>
      <data key="d3">chunk-3befbff7111b99c10b6944ee4347d22e</data>
    </node>
    <node id="Supporting Trump">
      <data key="d0">Supporting Trump</data>
      <data key="d1">category</data>
      <data key="d2">A thematic tweet category associated with higher joy and lower fear emotions, reflecting emotional flip-flop behavior by IRA trolls.</data>
      <data key="d3">chunk-3befbff7111b99c10b6944ee4347d22e</data>
    </node>
    <node id="Immigrants">
      <data key="d0">Immigrants</data>
      <data key="d1">category</data>
      <data key="d2">A demographic group frequently targeted, attacked, and discussed in divisive tweets and hashtag games by IRA trolls.</data>
      <data key="d3">chunk-3befbff7111b99c10b6944ee4347d22e</data>
    </node>
    <node id="Muslims">
      <data key="d0">Muslims</data>
      <data key="d1">category</data>
      <data key="d2">A religious group referenced in tweets under the 'Islam and War' theme in discussions regarding Islamophobia and security.</data>
      <data key="d3">chunk-3befbff7111b99c10b6944ee4347d22e</data>
    </node>
    <node id="Regular Users">
      <data key="d0">Regular Users</data>
      <data key="d1">category</data>
      <data key="d2">A baseline category of authentic social media users evaluated against IRA trolls in comparative linguistic and behavioral analyses.&lt;SEP&gt;Ordinary Twitter users whose behaviors, network profiles, and writing styles were compared to those of IRA trolls.</data>
      <data key="d3">chunk-fdb05b2a1cbb63e80256245c9da202fa&lt;SEP&gt;chunk-3befbff7111b99c10b6944ee4347d22e</data>
    </node>
    <node id="RickMad">
      <data key="d0">RickMad</data>
      <data key="d1">person</data>
      <data key="d2">A Twitter user account referenced in sample tweets illustrating the 'Islam and War' theme.</data>
      <data key="d3">chunk-3befbff7111b99c10b6944ee4347d22e</data>
    </node>
    <node id="NLI Features">
      <data key="d0">NLI Features</data>
      <data key="d1">category</data>
      <data key="d2">Native Language Identification features based on textual style used to identify Russian language markers and classify IRA troll accounts.&lt;SEP&gt;Stylometric and Natural Language Inference-based linguistic features proposed to identify IRA troll accounts based on their writing style.</data>
      <data key="d3">chunk-fdb05b2a1cbb63e80256245c9da202fa&lt;SEP&gt;chunk-3befbff7111b99c10b6944ee4347d22e</data>
    </node>
    <node id="Emotions Features">
      <data key="d0">Emotions Features</data>
      <data key="d1">category</data>
      <data key="d2">A classification feature set measuring emotional cues such as fear and joy across thematic topics in tweets.</data>
      <data key="d3">chunk-3befbff7111b99c10b6944ee4347d22e</data>
    </node>
    <node id="Network Features">
      <data key="d0">Network Features</data>
      <data key="d1">category</data>
      <data key="d2">A baseline feature set derived from account-level metrics such as follower and followee counts used to evaluate troll identification.</data>
      <data key="d3">chunk-3befbff7111b99c10b6944ee4347d22e</data>
    </node>
    <node id="Hillary">
      <data key="d0">Hillary</data>
      <data key="d1">person</data>
      <data key="d2">Hillary refers to Hillary Clinton, a political figure targeted by specific attack themes and narratives propagated by IRA troll accounts.</data>
      <data key="d3">chunk-fdb05b2a1cbb63e80256245c9da202fa</data>
    </node>
    <node id="Trump">
      <data key="d0">Trump</data>
      <data key="d1">person</data>
      <data key="d2">Donald Trump, a political contender whose primary loss in Maine was identified as a surprise outcome.&lt;SEP&gt;Trump refers to Donald Trump, a political figure featured prominently in supportive messaging campaigns run by IRA troll accounts.</data>
      <data key="d3">chunk-cfb7408eee446a3d2ef83758361e2613&lt;SEP&gt;chunk-fdb05b2a1cbb63e80256245c9da202fa</data>
    </node>
    <node id="IRA Trolls">
      <data key="d0">IRA Trolls</data>
      <data key="d1">category</data>
      <data key="d2">A category of deceptive and suspicious social media accounts linked to the Internet Research Agency, analyzed for behavioral, linguistic, and emotional anomalies.</data>
      <data key="d3">chunk-fdb05b2a1cbb63e80256245c9da202fa</data>
    </node>
    <node id="Personalized Language Models">
      <data key="d0">Personalized Language Models</data>
      <data key="d1">category</data>
      <data key="d2">A category of language models in speech recognition tailored to individual users by incorporating user-specific entities such as contact lists, locations, or media titles.&lt;SEP&gt;Specialized language models tailored to individual user context, such as user contact lists, used in dynamic WFST decoding.</data>
      <data key="d3">chunk-3f30bf0da65382dcb7b8ad1db0f03843&lt;SEP&gt;chunk-fdb05b2a1cbb63e80256245c9da202fa</data>
    </node>
    <node id="Dynamic WFST Decoder">
      <data key="d0">Dynamic WFST Decoder</data>
      <data key="d1">category</data>
      <data key="d2">A category of speech recognition decoders that composes graph components dynamically on-demand, suitable for handling personalized and dynamic language models.&lt;SEP&gt;A class of speech recognition decoders based on dynamic weighted finite state transducers designed to efficiently load and decode personalized language models on the fly.</data>
      <data key="d3">chunk-fdb05b2a1cbb63e80256245c9da202fa&lt;SEP&gt;chunk-7994dd4a5f0c1996cedd50a0545ebc9a</data>
    </node>
    <node id="Two-Layer Cache Mechanism">
      <data key="d0">Two-Layer Cache Mechanism</data>
      <data key="d1">category</data>
      <data key="d2">A proposed caching architecture comprising a public cache and a private cache designed to accelerate dynamic WFST decoding with personalized language models.</data>
      <data key="d3">chunk-fdb05b2a1cbb63e80256245c9da202fa</data>
    </node>
    <node id="Public Cache">
      <data key="d0">Public Cache</data>
      <data key="d1">category</data>
      <data key="d2">A globally shared cache layer within the two-layer cache mechanism that stores the static portion of the WFST graph across all users.&lt;SEP&gt;A shared, static cache layer representing pre-composed states ($T_P$) that can be accessed by all concurrent threads during decoding.</data>
      <data key="d3">chunk-9dacf09330ac9f65bece416e803b0daa&lt;SEP&gt;chunk-fdb05b2a1cbb63e80256245c9da202fa</data>
    </node>
    <node id="Private Cache">
      <data key="d0">Private Cache</data>
      <data key="d1">category</data>
      <data key="d2">A thread-specific dynamic cache layer ($T_D$) constructed on-the-fly to hold personalized states and user-specific updates throughout a dialog session.&lt;SEP&gt;A user-specific cache layer within the two-layer cache mechanism that stores the graph representing a personalized language model shared only by utterances from a particular user.</data>
      <data key="d3">chunk-9dacf09330ac9f65bece416e803b0daa&lt;SEP&gt;chunk-fdb05b2a1cbb63e80256245c9da202fa</data>
    </node>
    <node id="Pre-Initialization Methods">
      <data key="d0">Pre-Initialization Methods</data>
      <data key="d1">category</data>
      <data key="d2">Techniques including breadth-first search and data-driven exploration of decoder states used to optimize graph caching and reduce speech decoding time.</data>
      <data key="d3">chunk-fdb05b2a1cbb63e80256245c9da202fa</data>
    </node>
    <node id="Breadth-First Search">
      <data key="d0">Breadth-First Search</data>
      <data key="d1">category</data>
      <data key="d2">A graph traversal algorithm category utilized for offline pre-initialization graph expansion without requiring pre-calculated state statistics.&lt;SEP&gt;A graph traversal algorithmic technique used in the distance-based pre-composition method to visit and pre-compose states within a specified boundary.&lt;SEP&gt;An algorithmic graph traversal strategy employed as a pre-initialization method for dynamic WFST decoders.</data>
      <data key="d3">chunk-9dacf09330ac9f65bece416e803b0daa&lt;SEP&gt;chunk-fdb05b2a1cbb63e80256245c9da202fa&lt;SEP&gt;chunk-7994dd4a5f0c1996cedd50a0545ebc9a</data>
    </node>
    <node id="Calling Speech Recognition Task">
      <data key="d0">Calling Speech Recognition Task</data>
      <data key="d1">event</data>
      <data key="d2">An experimental evaluation task involving speech recognition on voice calls using a personalized contact list.</data>
      <data key="d3">chunk-fdb05b2a1cbb63e80256245c9da202fa</data>
    </node>
    <node id="HCLG Graph">
      <data key="d0">HCLG Graph</data>
      <data key="d1">category</data>
      <data key="d2">A statically composed WFST decoding graph formed by combining graphs representing HMM states (H), context-dependent phones (C), lexicons (L), and grammar/language models (G).</data>
      <data key="d3">chunk-fdb05b2a1cbb63e80256245c9da202fa</data>
    </node>
    <node id="Attacking Hillary Theme">
      <data key="d0">Attacking Hillary Theme</data>
      <data key="d1">category</data>
      <data key="d2">A specific narrative category and topic theme in the social media classification study focused on tweets hostile to Hillary Clinton.</data>
      <data key="d3">chunk-fdb05b2a1cbb63e80256245c9da202fa</data>
    </node>
    <node id="Supporting Trump Theme">
      <data key="d0">Supporting Trump Theme</data>
      <data key="d1">category</data>
      <data key="d2">A topic theme in the social media study focused on tweets expressing support for Donald Trump.</data>
      <data key="d3">chunk-fdb05b2a1cbb63e80256245c9da202fa</data>
    </node>
    <node id="Statically Composed Graph">
      <data key="d0">Statically Composed Graph</data>
      <data key="d1">category</data>
      <data key="d2">A category of speech recognition graph representation constructed offline, characterized by high compute and memory requirements for large vocabularies and difficulty handling personalization.</data>
      <data key="d3">chunk-7994dd4a5f0c1996cedd50a0545ebc9a</data>
    </node>
    <node id="Personalized Language Model">
      <data key="d0">Personalized Language Model</data>
      <data key="d1">category</data>
      <data key="d2">A category of language model tailored to individual user data and voice assistant tasks such as phone calls, messaging contacts, or playing music.&lt;SEP&gt;A personalized language model is a specialized class of language models customized with individual user information, such as contact lists.</data>
      <data key="d3">chunk-cdcec1aad44f0e059edddb969db938a4&lt;SEP&gt;chunk-7994dd4a5f0c1996cedd50a0545ebc9a</data>
    </node>
    <node id="Class Language Model">
      <data key="d0">Class Language Model</data>
      <data key="d1">category</data>
      <data key="d2">A category of language model that incorporates class tags to represent dynamic entity placeholders, functioning as a background grammar transducer.&lt;SEP&gt;A category of language models that replaces specific class labels in a generic root structure with class-specific transducers to support dynamic or personalized vocabularies.</data>
      <data key="d3">chunk-9dacf09330ac9f65bece416e803b0daa&lt;SEP&gt;chunk-7994dd4a5f0c1996cedd50a0545ebc9a</data>
    </node>
    <node id="Calling Domain">
      <data key="d0">Calling Domain</data>
      <data key="d1">category</data>
      <data key="d2">An application domain category in speech recognition focused on phone call tasks used to evaluate decoding efficiency and graph pre-initialization.&lt;SEP&gt;The calling domain is a category of speech interaction tasks consisting of voice commands to place calls to specific contacts.</data>
      <data key="d3">chunk-cdcec1aad44f0e059edddb969db938a4&lt;SEP&gt;chunk-7994dd4a5f0c1996cedd50a0545ebc9a</data>
    </node>
    <node id="Two-Layer Pre-Initialization Mechanism">
      <data key="d0">Two-Layer Pre-Initialization Mechanism</data>
      <data key="d1">category</data>
      <data key="d2">A proposed decoder optimization architecture that separates public graph pre-composition from private, user-specific FST states to avoid per-user dynamic expansion and enable graph sharing across service threads.</data>
      <data key="d3">chunk-7994dd4a5f0c1996cedd50a0545ebc9a</data>
    </node>
    <node id="Lazy Composition">
      <data key="d0">Lazy Composition</data>
      <data key="d1">category</data>
      <data key="d2">An on-demand graph composition technique in dynamic speech recognition decoders where transitions are computed only as needed during runtime.</data>
      <data key="d3">chunk-7994dd4a5f0c1996cedd50a0545ebc9a</data>
    </node>
    <node id="Data-Driven Approach">
      <data key="d0">Data-Driven Approach</data>
      <data key="d1">category</data>
      <data key="d2">An offline graph pre-initialization method where a small sample of utterances is processed through the decoder to determine active states, outperforming breadth-first search.</data>
      <data key="d3">chunk-7994dd4a5f0c1996cedd50a0545ebc9a</data>
    </node>
    <node id="FST Replacement Algorithm">
      <data key="d0">FST Replacement Algorithm</data>
      <data key="d1">category</data>
      <data key="d2">An algorithmic method used to replace class labels in a generic root class language model transducer with class-specific transducers.</data>
      <data key="d3">chunk-7994dd4a5f0c1996cedd50a0545ebc9a</data>
    </node>
    <node id="Voice Assistant">
      <data key="d0">Voice Assistant</data>
      <data key="d1">category</data>
      <data key="d2">A category of interactive voice applications performing user-specific tasks such as messaging, making phone calls, or playing music.</data>
      <data key="d3">chunk-7994dd4a5f0c1996cedd50a0545ebc9a</data>
    </node>
    <node id="Weighted Finite-State Transducer">
      <data key="d0">Weighted Finite-State Transducer</data>
      <data key="d1">category</data>
      <data key="d2">A mathematical graph model category defined over semirings with states and labeled transitions used for speech recognition decoding and language modeling.</data>
      <data key="d3">chunk-7994dd4a5f0c1996cedd50a0545ebc9a</data>
    </node>
    <node id="Multi-Threaded Service">
      <data key="d0">Multi-Threaded Service</data>
      <data key="d1">category</data>
      <data key="d2">An architectural category of server systems that handles multiple concurrent requests and benefits from sharing pre-composed public FST graphs across threads.</data>
      <data key="d3">chunk-7994dd4a5f0c1996cedd50a0545ebc9a</data>
    </node>
    <node id="Finite-State Transducer">
      <data key="d0">Finite-State Transducer</data>
      <data key="d1">category</data>
      <data key="d2">A category of automata models used in speech recognition and language processing to represent transitions, inputs, outputs, and compositions such as $G_c$, $G_p$, and recognition graphs.</data>
      <data key="d3">chunk-9dacf09330ac9f65bece416e803b0daa</data>
    </node>
    <node id="Pre-Composition Algorithm">
      <data key="d0">Pre-Composition Algorithm</data>
      <data key="d1">category</data>
      <data key="d2">A category of optimization algorithms that pre-computes partial graph compositions prior to decoding search to reduce run-time factor in large vocabulary systems.</data>
      <data key="d3">chunk-9dacf09330ac9f65bece416e803b0daa</data>
    </node>
    <node id="On-The-Fly Composition">
      <data key="d0">On-The-Fly Composition</data>
      <data key="d1">category</data>
      <data key="d2">A category of dynamic composition methods where graph states are composed in real-time during decoding search.</data>
      <data key="d3">chunk-9dacf09330ac9f65bece416e803b0daa</data>
    </node>
    <node id="Two-Layered Cached FST">
      <data key="d0">Two-Layered Cached FST</data>
      <data key="d1">category</data>
      <data key="d2">A category of decoding architectures combining a static public cache for shared pre-composed states with a dynamic private cache for user-specific states.</data>
      <data key="d3">chunk-9dacf09330ac9f65bece416e803b0daa</data>
    </node>
    <node id="Distance-Based Method">
      <data key="d0">Distance-Based Method</data>
      <data key="d1">category</data>
      <data key="d2">A category of pre-composition methods that utilizes breadth-first search to iterate over and compose states within a specific distance threshold.</data>
      <data key="d3">chunk-9dacf09330ac9f65bece416e803b0daa</data>
    </node>
    <node id="Lookahead Filter">
      <data key="d0">Lookahead Filter</data>
      <data key="d1">category</data>
      <data key="d2">A category of graph filtering algorithms used during composition and decoding stages to optimize search space and efficiency.</data>
      <data key="d3">chunk-9dacf09330ac9f65bece416e803b0daa</data>
    </node>
    <node id="OpenFst Framework">
      <data key="d0">OpenFst Framework</data>
      <data key="d1">organization</data>
      <data key="d2">An open-source library and developer framework used for constructing, combining, optimizing, and searching weighted finite-state transducers.</data>
      <data key="d3">chunk-9dacf09330ac9f65bece416e803b0daa</data>
    </node>
    <node id="State Frequency Composition">
      <data key="d0">State Frequency Composition</data>
      <data key="d1">category</data>
      <data key="d2">A partial composition technique that selects states for pre-initialization based on their frequency of occurrence in training or decoding data.</data>
      <data key="d3">chunk-9dacf09330ac9f65bece416e803b0daa</data>
    </node>
    <node id="Run Time Factor">
      <data key="d0">Run Time Factor</data>
      <data key="d1">category</data>
      <data key="d2">A computational efficiency metric in speech recognition systems indicating the ratio between decoding processing time and speech duration.</data>
      <data key="d3">chunk-9dacf09330ac9f65bece416e803b0daa</data>
    </node>
    <node id="State Table">
      <data key="d0">State Table</data>
      <data key="d1">category</data>
      <data key="d2">A shared mapping data structure used to maintain consistent state indexing across cached layers and add-on dynamic compositions.</data>
      <data key="d3">chunk-9dacf09330ac9f65bece416e803b0daa</data>
    </node>
    <node id="Dialog Session">
      <data key="d0">Dialog Session</data>
      <data key="d1">event</data>
      <data key="d2">An interactive conversation session during which a user's private cache persists and accumulates composed states to accelerate subsequent utterances.</data>
      <data key="d3">chunk-9dacf09330ac9f65bece416e803b0daa</data>
    </node>
    <node id="Jun Liu">
      <data key="d0">Jun Liu</data>
      <data key="d1">person</data>
      <data key="d2">Jun Liu is a person referenced in an example voice command utterance, 'Please call Jun Liu now', used to illustrate contact name recognition.</data>
      <data key="d3">chunk-cdcec1aad44f0e059edddb969db938a4</data>
    </node>
    <node id="Non-Calling Domains">
      <data key="d0">Non-Calling Domains</data>
      <data key="d1">category</data>
      <data key="d2">Non-calling domains are common voice command categories including weather, time, and music, tested alongside calling interactions.</data>
      <data key="d3">chunk-cdcec1aad44f0e059edddb969db938a4</data>
    </node>
    <node id="Out-Of-Vocabulary Words">
      <data key="d0">Out-Of-Vocabulary Words</data>
      <data key="d1">category</data>
      <data key="d2">Out-of-vocabulary (OOV) words are lexical items, especially rare or diverse contact names, that are missing from the standard speech recognition lexicon.&lt;SEP&gt;Out-of-vocabulary (OOV) words are unseen morphological inflections not present in training corpora, used to test model generalization.&lt;SEP&gt;Out-of-vocabulary (OOV) words constitute a category of unseen word forms used to evaluate the generalization capacity of embedding models like SubGram.</data>
      <data key="d3">chunk-cdcec1aad44f0e059edddb969db938a4&lt;SEP&gt;chunk-f3e8fa58e562bb861dae62114ff9c810&lt;SEP&gt;chunk-a857415cf32d5d04b955b0da8d697209</data>
    </node>
    <node id="Distance Based Method">
      <data key="d0">Distance Based Method</data>
      <data key="d1">category</data>
      <data key="d2">A pre-composition method category that uses naive breadth-first-search (BFS) to iterate over decoding FST states within a specified distance from the start state.</data>
      <data key="d3">chunk-cdcec1aad44f0e059edddb969db938a4</data>
    </node>
    <node id="Data-Driven Warm-Up">
      <data key="d0">Data-Driven Warm-Up</data>
      <data key="d1">category</data>
      <data key="d2">A pre-composition method category that uses real utterances and an empty contact FST during a warm-up decoding phase to expand frequently encountered states.</data>
      <data key="d3">chunk-cdcec1aad44f0e059edddb969db938a4</data>
    </node>
    <node id="Monophone FST">
      <data key="d0">Monophone FST</data>
      <data key="d1">category</data>
      <data key="d2">A finite-state transducer category representing words as monophone sequences to handle out-of-vocabulary contact name recognition.</data>
      <data key="d3">chunk-cdcec1aad44f0e059edddb969db938a4</data>
    </node>
    <node id="Contact FST">
      <data key="d0">Contact FST</data>
      <data key="d1">category</data>
      <data key="d2">A class-based finite-state transducer representing personalized contact names, incorporated into the decoding search graph.</data>
      <data key="d3">chunk-cdcec1aad44f0e059edddb969db938a4</data>
    </node>
    <node id="Hybrid LSTM-HMM Framework">
      <data key="d0">Hybrid LSTM-HMM Framework</data>
      <data key="d1">category</data>
      <data key="d2">A speech recognition architecture category combining long short-term memory acoustic modeling with hidden Markov models.</data>
      <data key="d3">chunk-cdcec1aad44f0e059edddb969db938a4</data>
    </node>
    <node id="Speech Recognition Experiments">
      <data key="d0">Speech Recognition Experiments</data>
      <data key="d1">event</data>
      <data key="d2">A series of empirical evaluations conducted on multi-domain speech datasets to measure real-time factor and word error rate.</data>
      <data key="d3">chunk-cdcec1aad44f0e059edddb969db938a4</data>
    </node>
    <node id="Virtual Dialog Sessions">
      <data key="d0">Virtual Dialog Sessions</data>
      <data key="d1">category</data>
      <data key="d2">A dialogue grouping structure consisting of one, two, or five conversational turns used to evaluate caching benefits.</data>
      <data key="d3">chunk-cdcec1aad44f0e059edddb969db938a4</data>
    </node>
    <node id="Real-Time Factor">
      <data key="d0">Real-Time Factor</data>
      <data key="d1">category</data>
      <data key="d2">A speech processing speed metric category defined as decoding time divided by audio duration.</data>
      <data key="d3">chunk-cdcec1aad44f0e059edddb969db938a4</data>
    </node>
    <node id="Word Error Rate">
      <data key="d0">Word Error Rate</data>
      <data key="d1">category</data>
      <data key="d2">A standard speech recognition accuracy metric category measuring transcription errors.</data>
      <data key="d3">chunk-cdcec1aad44f0e059edddb969db938a4</data>
    </node>
    <node id="Weather Domain">
      <data key="d0">Weather Domain</data>
      <data key="d1">category</data>
      <data key="d2">A common non-calling voice command domain category evaluated in the experiments.</data>
      <data key="d3">chunk-cdcec1aad44f0e059edddb969db938a4</data>
    </node>
    <node id="Music Domain">
      <data key="d0">Music Domain</data>
      <data key="d1">category</data>
      <data key="d2">A non-calling voice interaction domain category evaluated in the experiments.</data>
      <data key="d3">chunk-cdcec1aad44f0e059edddb969db938a4</data>
    </node>
    <node id="Time Domain">
      <data key="d0">Time Domain</data>
      <data key="d1">category</data>
      <data key="d2">A non-calling voice query domain category evaluated in the experiments.</data>
      <data key="d3">chunk-cdcec1aad44f0e059edddb969db938a4</data>
    </node>
    <node id="Mike Seltzer">
      <data key="d0">Mike Seltzer</data>
      <data key="d1">person</data>
      <data key="d2">Mike Seltzer is a speech and machine learning researcher acknowledged for providing useful discussions on the dynamic WFST decoding study.</data>
      <data key="d3">chunk-3f30bf0da65382dcb7b8ad1db0f03843</data>
    </node>
    <node id="Christian Fuegen">
      <data key="d0">Christian Fuegen</data>
      <data key="d1">person</data>
      <data key="d2">Christian Fuegen is a researcher acknowledged for participating in useful discussions regarding the WFST decoding research.</data>
      <data key="d3">chunk-3f30bf0da65382dcb7b8ad1db0f03843</data>
    </node>
    <node id="Julian Chan">
      <data key="d0">Julian Chan</data>
      <data key="d1">person</data>
      <data key="d2">Julian Chan is a contributor acknowledged for discussions concerning the dynamic WFST decoding optimization work.</data>
      <data key="d3">chunk-3f30bf0da65382dcb7b8ad1db0f03843</data>
    </node>
    <node id="Dan Povey">
      <data key="d0">Dan Povey</data>
      <data key="d1">person</data>
      <data key="d2">Dan Povey is a renowned speech recognition researcher acknowledged for contributing useful discussions to the WFST decoding research.</data>
      <data key="d3">chunk-3f30bf0da65382dcb7b8ad1db0f03843</data>
    </node>
    <node id="WFST Decoding">
      <data key="d0">WFST Decoding</data>
      <data key="d1">category</data>
      <data key="d2">Weighted Finite-State Transducer (WFST) decoding is a category of speech recognition algorithms analyzed for computational efficiency, real-time factor, and memory usage across dynamic and pre-composed graph configurations.</data>
      <data key="d3">chunk-3f30bf0da65382dcb7b8ad1db0f03843</data>
    </node>
    <node id="Human Activities">
      <data key="d0">Human Activities</data>
      <data key="d1">category</data>
      <data key="d2">A category of everyday actions and behaviors performed and reported by individuals in daily life, such as taking a picture or teaching someone.&lt;SEP&gt;Human Activities is a category of self-reported actions, behaviors, and events gathered via surveys and tweets to be clustered and semantically analyzed.&lt;SEP&gt;Human activities comprise everyday actions, behaviors, and lifestyle choices that reflect individual interests, psychological values, and future decisions.</data>
      <data key="d3">chunk-3f30bf0da65382dcb7b8ad1db0f03843&lt;SEP&gt;chunk-93563dc9f12ccbb699c3788e68ce1708&lt;SEP&gt;chunk-a22507f0961c9cfd8c5355551b99d5f0</data>
    </node>
    <node id="User-Generated Content">
      <data key="d0">User-Generated Content</data>
      <data key="d1">category</data>
      <data key="d2">A class of unstructured digital textual information created by internet and social media users, utilized for geographic and demographic analysis.&lt;SEP&gt;Content created and shared by online users, such as tweets, utilized for modeling and predicting behavioral patterns.&lt;SEP&gt;User-generated content consists of tweets, profile text, and historical posts authored by users, serving as the input data for predictive modeling.&lt;SEP&gt;User-generated content is a category of text-based media created by social media users, including posts and self-descriptions, used to infer behaviors and traits.</data>
      <data key="d3">chunk-3e6c6ba3246066dafb17ed3cbf673534&lt;SEP&gt;chunk-3f30bf0da65382dcb7b8ad1db0f03843&lt;SEP&gt;chunk-de8f6faf25c75fd8dcf0e4d67e379249&lt;SEP&gt;chunk-a06cb5cf31459df4733b688cf007ff6d</data>
    </node>
    <node id="Personality Traits">
      <data key="d0">Personality Traits</data>
      <data key="d1">category</data>
      <data key="d2">Personality traits are psychological characteristics, such as self-esteem and interpersonal affect, that influence the types of activities individuals engage in.</data>
      <data key="d3">chunk-3f30bf0da65382dcb7b8ad1db0f03843</data>
    </node>
    <node id="Social Media Users">
      <data key="d0">Social Media Users</data>
      <data key="d1">category</data>
      <data key="d2">A demographic group of online users who generate textual content about their everyday activities and personal profiles.</data>
      <data key="d3">chunk-3f30bf0da65382dcb7b8ad1db0f03843</data>
    </node>
    <node id="University Students">
      <data key="d0">University Students</data>
      <data key="d1">category</data>
      <data key="d2">A demographic group studied in behavioral research whose personality traits such as interpersonal affect and self-esteem correlate with activities like attending parties.</data>
      <data key="d3">chunk-3f30bf0da65382dcb7b8ad1db0f03843</data>
    </node>
    <node id="Pre-Composition Methods">
      <data key="d0">Pre-Composition Methods</data>
      <data key="d1">category</data>
      <data key="d2">Algorithmic graph construction strategies in WFST decoding designed to reduce real-time factor and marginal memory usage.</data>
      <data key="d3">chunk-3f30bf0da65382dcb7b8ad1db0f03843</data>
    </node>
    <node id="Naive BFS">
      <data key="d0">Naive BFS</data>
      <data key="d1">category</data>
      <data key="d2">A breadth-first search graph pre-composition method that pre-composes states close to the start state to improve decoding speed.</data>
      <data key="d3">chunk-3f30bf0da65382dcb7b8ad1db0f03843</data>
    </node>
    <node id="Data-Driven Warmup">
      <data key="d0">Data-Driven Warmup</data>
      <data key="d1">category</data>
      <data key="d2">An optimized pre-composition technique that utilizes empirical data to improve marginal memory efficiency and real-time factor in WFST decoding graphs.</data>
      <data key="d3">chunk-3f30bf0da65382dcb7b8ad1db0f03843</data>
    </node>
    <node id="Multi-Turn Dialog Sessions">
      <data key="d0">Multi-Turn Dialog Sessions</data>
      <data key="d1">category</data>
      <data key="d2">Interactive conversational sessions consisting of multiple user turns where caching mechanisms provide significant decoding time reductions.</data>
      <data key="d3">chunk-3f30bf0da65382dcb7b8ad1db0f03843</data>
    </node>
    <node id="Sentence Embedding Framework">
      <data key="d0">Sentence Embedding Framework</data>
      <data key="d1">category</data>
      <data key="d2">A natural language processing framework engineered to capture the semantic meaning of everyday human activities and group them into clusters.</data>
      <data key="d3">chunk-3f30bf0da65382dcb7b8ad1db0f03843</data>
    </node>
    <node id="Neural Network Model">
      <data key="d0">Neural Network Model</data>
      <data key="d1">category</data>
      <data key="d2">A machine learning model trained to predict user activity clusters based on historical posts, self-descriptions, and inferred user traits.</data>
      <data key="d3">chunk-3f30bf0da65382dcb7b8ad1db0f03843</data>
    </node>
    <node id="Human Behavior Modeling">
      <data key="d0">Human Behavior Modeling</data>
      <data key="d1">category</data>
      <data key="d2">A computational research domain focused on understanding, modeling, and predicting human activities, traits, and decisions at scale.</data>
      <data key="d3">chunk-3f30bf0da65382dcb7b8ad1db0f03843</data>
    </node>
    <node id="Activity Clusters">
      <data key="d0">Activity Clusters</data>
      <data key="d1">category</data>
      <data key="d2">A semantic grouping and summarization framework designed to categorize a large space of self-reported human activities into distinct clusters of variable granularity.&lt;SEP&gt;Semantic groupings of related human actions and behaviors created via clustering algorithms.</data>
      <data key="d3">chunk-ec629d6b4012dc860d6ce7b45913df22&lt;SEP&gt;chunk-93563dc9f12ccbb699c3788e68ce1708</data>
    </node>
    <node id="Personal Values">
      <data key="d0">Personal Values</data>
      <data key="d1">category</data>
      <data key="d2">A category of social and psychological variables examined for their relationships with everyday human behaviors and activities.&lt;SEP&gt;A set of 50 value dimensions derived from a hierarchical lexicon used as user attribute features to aid activity prediction.&lt;SEP&gt;Inferred or known personal principles and attributes that serve as feature representations for users in prediction tasks.</data>
      <data key="d3">chunk-ec629d6b4012dc860d6ce7b45913df22&lt;SEP&gt;chunk-93563dc9f12ccbb699c3788e68ce1708&lt;SEP&gt;chunk-5dea45043b79c2ffac532444762989fc</data>
    </node>
    <node id="Thrillers">
      <data key="d0">Thrillers</data>
      <data key="d1">category</data>
      <data key="d2">A movie category associated with individuals who value stimulation, referenced as an example of human behavior and preference modeling.</data>
      <data key="d3">chunk-93563dc9f12ccbb699c3788e68ce1708</data>
    </node>
    <node id="Event2Mind Dataset">
      <data key="d0">Event2Mind Dataset</data>
      <data key="d1">category</data>
      <data key="d2">A dataset containing phrasal event descriptions annotated for intent and reaction, used to generate first-person past-tense activity queries.</data>
      <data key="d3">chunk-93563dc9f12ccbb699c3788e68ce1708</data>
    </node>
    <node id="Computer Vision Community">
      <data key="d0">Computer Vision Community</data>
      <data key="d1">organization</data>
      <data key="d2">An academic and scientific research community cited for traditionally defining activities through fine-grained, visual action sequences.</data>
      <data key="d3">chunk-93563dc9f12ccbb699c3788e68ce1708</data>
    </node>
    <node id="Activity Surveys">
      <data key="d0">Activity Surveys</data>
      <data key="d1">category</data>
      <data key="d2">A collection of short surveys administered to gather first-hand user reports of activities, serving as one of the two main sources of activity queries.</data>
      <data key="d3">chunk-93563dc9f12ccbb699c3788e68ce1708</data>
    </node>
    <node id="Christmas Morning">
      <data key="d0">Christmas Morning</data>
      <data key="d1">event</data>
      <data key="d2">An event example cited from dataset instances that represents an environmental state or seasonal occurrence rather than an individual human activity.</data>
      <data key="d3">chunk-93563dc9f12ccbb699c3788e68ce1708</data>
    </node>
    <node id="Larger-Scale Events">
      <data key="d0">Larger-Scale Events</data>
      <data key="d1">event</data>
      <data key="d2">A category of events characterized by the participation or attention of numerous users occurring at a specific time and location, contrasted with individual human activities.</data>
      <data key="d3">chunk-93563dc9f12ccbb699c3788e68ce1708</data>
    </node>
    <node id="Non-Visual Activities">
      <data key="d0">Non-Visual Activities</data>
      <data key="d1">category</data>
      <data key="d2">Activities such as making vacation plans or having a dream that do not involve observable visual body movements but represent valid daily human actions.</data>
      <data key="d3">chunk-93563dc9f12ccbb699c3788e68ce1708</data>
    </node>
    <node id="Social Media Platforms">
      <data key="d0">Social Media Platforms</data>
      <data key="d1">category</data>
      <data key="d2">Online platforms, such as Twitter, where people publicly share conversational messages, opinions, and real-world everyday behaviors in natural language.</data>
      <data key="d3">chunk-93563dc9f12ccbb699c3788e68ce1708</data>
    </node>
    <node id="Amazon Mechanical Turk">
      <data key="d0">Amazon Mechanical Turk</data>
      <data key="d1">organization</data>
      <data key="d2">Amazon Mechanical Turk is a crowdsourcing marketplace used to recruit English-speaking human judges for the account-matching evaluation experiment.&lt;SEP&gt;Amazon Mechanical Turk is a crowdsourcing microtask platform operated by Amazon used to gather veridicality and desire annotations for tweets.&lt;SEP&gt;Amazon Mechanical Turk is a crowdsourcing platform used by the researchers to recruit crowd workers (Turkers) for annotating tweet veridicality and author desire.&lt;SEP&gt;Amazon Mechanical Turk is a crowdsourcing platform used to collect survey responses regarding human activities from 1,000 participants in the United States.&lt;SEP&gt;Amazon Mechanical Turk is a crowdsourcing platform used to conduct preliminary user studies on multimodal attribute extraction.&lt;SEP&gt;Amazon Mechanical Turk is a crowdsourcing platform whose workers created human simplifications for the development and test sets of WikiLarge.</data>
      <data key="d3">chunk-fab274e4799f62f2fbfabf369fb71267&lt;SEP&gt;chunk-f72431d36a16227ea7d1db8d40a9ca21&lt;SEP&gt;chunk-a22507f0961c9cfd8c5355551b99d5f0&lt;SEP&gt;chunk-e3643b20dc5e5b3d9faa14743574ec5c&lt;SEP&gt;chunk-261a6f8ccfb17ebb9be72e74900d0a04</data>
    </node>
    <node id="Short Survey">
      <data key="d0">Short Survey</data>
      <data key="d1">event</data>
      <data key="d2">The Short Survey is a data collection initiative where 1,000 participants across the United States were asked to list five activities they performed in the past week.</data>
      <data key="d3">chunk-a22507f0961c9cfd8c5355551b99d5f0</data>
    </node>
    <node id="Valid Queried Tweets">
      <data key="d0">Valid Queried Tweets</data>
      <data key="d1">category</data>
      <data key="d2">Valid Queried Tweets is a filtered subset of tweets retrieved from Twitter that match human activity phrases in the correct order and without indicators that the activity was not performed.</data>
      <data key="d3">chunk-a22507f0961c9cfd8c5355551b99d5f0</data>
    </node>
    <node id="Additional Tweets">
      <data key="d0">Additional Tweets</data>
      <data key="d1">category</data>
      <data key="d2">Additional Tweets is a category of historical tweets collected from user timelines, used to extract additional past-tense human activity signals.</data>
      <data key="d3">chunk-a22507f0961c9cfd8c5355551b99d5f0</data>
    </node>
    <node id="Queried Tweets">
      <data key="d0">Queried Tweets</data>
      <data key="d1">category</data>
      <data key="d2">Queried Tweets is the raw collection of up to 100 recent matching tweets per activity query gathered using the Twitter Search API prior to filtering.</data>
      <data key="d3">chunk-a22507f0961c9cfd8c5355551b99d5f0</data>
    </node>
    <node id="Additional Activities">
      <data key="d0">Additional Activities</data>
      <data key="d1">category</data>
      <data key="d2">Additional Activities is the noisy set of past-tense activity phrases extracted from users' timeline tweets via regular expression pattern-matching.</data>
      <data key="d3">chunk-a22507f0961c9cfd8c5355551b99d5f0</data>
    </node>
    <node id="Activity Phrase Instance">
      <data key="d0">Activity Phrase Instance</data>
      <data key="d1">category</data>
      <data key="d2">An Activity Phrase Instance is defined as the text matching an activity query along with all following words up to the end of the sentence in a valid queried tweet.</data>
      <data key="d3">chunk-a22507f0961c9cfd8c5355551b99d5f0</data>
    </node>
    <node id="Human Activity Clusters">
      <data key="d0">Human Activity Clusters</data>
      <data key="d1">category</data>
      <data key="d2">Clusters representing distinct types of human behaviors and activities that the deep neural model predicts based on user histories, profiles, and attributes.&lt;SEP&gt;Human Activity Clusters are semantic groupings of activity phrase instances created using vector representations to map the semantic space of activities.</data>
      <data key="d3">chunk-5dea45043b79c2ffac532444762989fc&lt;SEP&gt;chunk-a22507f0961c9cfd8c5355551b99d5f0</data>
    </node>
    <node id="BiLSTM-max Sentence Encoder">
      <data key="d0">BiLSTM-max Sentence Encoder</data>
      <data key="d1">category</data>
      <data key="d2">BiLSTM-max Sentence Encoder is a neural network model trained to generate vector representations capturing relatedness between activity phrases for clustering.</data>
      <data key="d3">chunk-a22507f0961c9cfd8c5355551b99d5f0</data>
    </node>
    <node id="Survey Participants">
      <data key="d0">Survey Participants</data>
      <data key="d1">person</data>
      <data key="d2">Survey Participants refers to the cohort of 1,000 individuals located across the United States recruited to report their weekly activities.</data>
      <data key="d3">chunk-a22507f0961c9cfd8c5355551b99d5f0</data>
    </node>
    <node id="Twitter Users">
      <data key="d0">Twitter Users</data>
      <data key="d1">person</data>
      <data key="d2">Twitter Users represents the account holders who authored valid queried tweets and whose profiles and tweet histories were collected.</data>
      <data key="d3">chunk-a22507f0961c9cfd8c5355551b99d5f0</data>
    </node>
    <node id="Cooking">
      <data key="d0">Cooking</data>
      <data key="d1">category</data>
      <data key="d2">A category of human activity within the semantic space, used as an example of a cluster of related actions that users engage in and report.</data>
      <data key="d3">chunk-ec629d6b4012dc860d6ce7b45913df22</data>
    </node>
    <node id="Pet/Animal Related">
      <data key="d0">Pet/Animal Related</data>
      <data key="d1">category</data>
      <data key="d2">A category of human activity within the semantic space involving pets or animals that a model can predict user participation in.</data>
      <data key="d3">chunk-ec629d6b4012dc860d6ce7b45913df22</data>
    </node>
    <node id="Photography">
      <data key="d0">Photography</data>
      <data key="d1">category</data>
      <data key="d2">An activity cluster category representing photography-related actions, identified as semantically distant from cooking-related activities.</data>
      <data key="d3">chunk-ec629d6b4012dc860d6ce7b45913df22</data>
    </node>
    <node id="Republican">
      <data key="d0">Republican</data>
      <data key="d1">category</data>
      <data key="d2">A political self-identity category mentioned as a term commonly found in user profile descriptions.</data>
      <data key="d3">chunk-ec629d6b4012dc860d6ce7b45913df22</data>
    </node>
    <node id="Atheist">
      <data key="d0">Atheist</data>
      <data key="d1">category</data>
      <data key="d2">A belief or worldview self-identity category mentioned as appearing in user profile descriptions.</data>
      <data key="d3">chunk-ec629d6b4012dc860d6ce7b45913df22</data>
    </node>
    <node id="Tweets">
      <data key="d0">Tweets</data>
      <data key="d1">category</data>
      <data key="d2">Social media posts published on Twitter, used as textual inputs and records of user activity history.</data>
      <data key="d3">chunk-ec629d6b4012dc860d6ce7b45913df22</data>
    </node>
    <node id="User History">
      <data key="d0">User History</data>
      <data key="d1">category</data>
      <data key="d2">A category of historical user data comprising sequential documents, tweets, or activity phrases.&lt;SEP&gt;A data feature category representing a user's past documents and tweets sampled during training to provide behavioral context.&lt;SEP&gt;An input component composed of documents and past tweets detailing activities previously performed by a user.</data>
      <data key="d3">chunk-de8f6faf25c75fd8dcf0e4d67e379249&lt;SEP&gt;chunk-ec629d6b4012dc860d6ce7b45913df22&lt;SEP&gt;chunk-5dea45043b79c2ffac532444762989fc</data>
    </node>
    <node id="User Profile">
      <data key="d0">User Profile</data>
      <data key="d1">category</data>
      <data key="d2">A category of user-provided textual information containing value-related content and personal descriptions.&lt;SEP&gt;A user's plain-text account description expressing personal self-identity, used as input for prediction models.</data>
      <data key="d3">chunk-ec629d6b4012dc860d6ce7b45913df22&lt;SEP&gt;chunk-5dea45043b79c2ffac532444762989fc</data>
    </node>
    <node id="User Attributes">
      <data key="d0">User Attributes</data>
      <data key="d1">category</data>
      <data key="d2">Real-valued feature representations capturing user characteristics, such as personal values, to assist in activity prediction.</data>
      <data key="d3">chunk-ec629d6b4012dc860d6ce7b45913df22</data>
    </node>
    <node id="Nature">
      <data key="d0">Nature</data>
      <data key="d1">category</data>
      <data key="d2">A personal value dimension in the lexicon; users scoring high on Nature frequently tweet about travel activities.</data>
      <data key="d3">chunk-5dea45043b79c2ffac532444762989fc</data>
    </node>
    <node id="Work-Ethic">
      <data key="d0">Work-Ethic</data>
      <data key="d1">category</data>
      <data key="d2">A personal value dimension in the lexicon; users scoring high on Work-Ethic frequently report performing writing-related tasks.</data>
      <data key="d3">chunk-5dea45043b79c2ffac532444762989fc</data>
    </node>
    <node id="Travel">
      <data key="d0">Travel</data>
      <data key="d1">category</data>
      <data key="d2">A category of human activity commonly reported by users with high scores in the Nature value dimension.</data>
      <data key="d3">chunk-5dea45043b79c2ffac532444762989fc</data>
    </node>
    <node id="Writing-Related Tasks">
      <data key="d0">Writing-Related Tasks</data>
      <data key="d1">category</data>
      <data key="d2">A category of human activity commonly reported by users with high scores in the Work-Ethic value dimension.</data>
      <data key="d3">chunk-5dea45043b79c2ffac532444762989fc</data>
    </node>
    <node id="Tweet">
      <data key="d0">Tweet</data>
      <data key="d1">category</data>
      <data key="d2">A category of social media post or document within a user's history analyzed by the activity prediction model.</data>
      <data key="d3">chunk-5dea45043b79c2ffac532444762989fc</data>
    </node>
    <node id="Activity Phrase">
      <data key="d0">Activity Phrase</data>
      <data key="d1">category</data>
      <data key="d2">A category of textual document or statement in a user's history denoting an action or behavior.</data>
      <data key="d3">chunk-5dea45043b79c2ffac532444762989fc</data>
    </node>
    <node id="Fitness Activities">
      <data key="d0">Fitness Activities</data>
      <data key="d1">category</data>
      <data key="d2">A category of physical exercise and health-related human activities, exemplified by visiting the gym.</data>
      <data key="d3">chunk-5dea45043b79c2ffac532444762989fc</data>
    </node>
    <node id="Shopping Activities">
      <data key="d0">Shopping Activities</data>
      <data key="d1">category</data>
      <data key="d2">A category of consumer purchasing behavior, exemplified by purchasing clothing such as pants.</data>
      <data key="d3">chunk-5dea45043b79c2ffac532444762989fc</data>
    </node>
    <node id="Family-Related Activities">
      <data key="d0">Family-Related Activities</data>
      <data key="d1">category</data>
      <data key="d2">A category of interpersonal activities that involve family members, frequently reported by users scoring high on the Family value dimension.</data>
      <data key="d3">chunk-5dea45043b79c2ffac532444762989fc</data>
    </node>
    <node id="Human Activity">
      <data key="d0">Human Activity</data>
      <data key="d1">category</data>
      <data key="d2">Human activity represents the actions, tasks, or behaviors (such as purchasing pants or going to the gym) that the model aims to predict from user-generated text.</data>
      <data key="d3">chunk-de8f6faf25c75fd8dcf0e4d67e379249</data>
    </node>
    <node id="50-Class Setup">
      <data key="d0">50-Class Setup</data>
      <data key="d1">category</data>
      <data key="d2">The 50-class setup is an experimental classification category focusing on predicting the 50 most common human activity clusters.</data>
      <data key="d3">chunk-de8f6faf25c75fd8dcf0e4d67e379249</data>
    </node>
    <node id="806-Class Setup">
      <data key="d0">806-Class Setup</data>
      <data key="d1">category</data>
      <data key="d2">The 806-class setup is a more comprehensive classification category encompassing 805 fine-grained activity clusters and an additional other category.</data>
      <data key="d3">chunk-de8f6faf25c75fd8dcf0e4d67e379249</data>
    </node>
    <node id="Activity Prediction Task">
      <data key="d0">Activity Prediction Task</data>
      <data key="d1">category</data>
      <data key="d2">The machine learning task addressed in the paper, focusing on predicting human activities mentioned in user-generated content based on historical user data.</data>
      <data key="d3">chunk-de8f6faf25c75fd8dcf0e4d67e379249</data>
    </node>
    <node id="Bi-LSTM">
      <data key="d0">Bi-LSTM</data>
      <data key="d1">category</data>
      <data key="d2">A neural network architecture category with max pooling utilized as the document encoder and profile encoder in the experiments.&lt;SEP&gt;Bi-LSTM is a category of bidirectional recurrent neural network architectures used to encode utterance tokens and column headers across multiple layers.&lt;SEP&gt;Bi-LSTM is a medical domain baseline neural network model evaluated on the named entity recognition task.&lt;SEP&gt;Bidirectional Long Short Term Memory neural networks, commonly used for sequence tagging and feature extraction in medical NLP and parameter sharing architectures.</data>
      <data key="d3">chunk-57acb1a29c2b86c001f999352f15c3cc&lt;SEP&gt;chunk-de8f6faf25c75fd8dcf0e4d67e379249&lt;SEP&gt;chunk-8b74404709f6b49b2bef33ca7f921e55&lt;SEP&gt;chunk-56c893ccea72c9785303bae311f29c7b</data>
    </node>
    <node id="Feed-Forward Network">
      <data key="d0">Feed-Forward Network</data>
      <data key="d1">category</data>
      <data key="d2">A neural network classification architecture category consisting of three layers followed by softmax, used to classify user activity clusters.&lt;SEP&gt;Feed-Forward Network (PosFF) is a sub-layer paired with multi-head self-attention layers in transformer and BERT architectures.</data>
      <data key="d3">chunk-de8f6faf25c75fd8dcf0e4d67e379249&lt;SEP&gt;chunk-8273db0372f06b5474e49c6b558bba7b</data>
    </node>
    <node id="Training Data">
      <data key="d0">Training Data</data>
      <data key="d1">category</data>
      <data key="d2">A dataset partition consisting of 200,000 user instances used to train and fit the prediction models.&lt;SEP&gt;Manually annotated collections of text posts used to train machine learning models and determine model performance.</data>
      <data key="d3">chunk-8756bb2d18f7993da0c11080bc5f15a1&lt;SEP&gt;chunk-de8f6faf25c75fd8dcf0e4d67e379249</data>
    </node>
    <node id="Test Data">
      <data key="d0">Test Data</data>
      <data key="d1">category</data>
      <data key="d2">A dataset partition consisting of 10,000 user instances used to evaluate and report final performance scores.</data>
      <data key="d3">chunk-de8f6faf25c75fd8dcf0e4d67e379249</data>
    </node>
    <node id="Ablation Study">
      <data key="d0">Ablation Study</data>
      <data key="d1">event</data>
      <data key="d2">An experimental procedure systematically removing model components such as attributes vectors, profile text, and document history to measure their individual contributions.&lt;SEP&gt;The ablation study is an experimental evaluation event conducted across various training epochs and dropout probabilities to assess model performance.</data>
      <data key="d3">chunk-de8f6faf25c75fd8dcf0e4d67e379249&lt;SEP&gt;chunk-67aef3e225567bceaa8ddbf5e9866527</data>
    </node>
    <node id="Other Class">
      <data key="d0">Other Class</data>
      <data key="d1">category</data>
      <data key="d2">A grouped classification label assigned to activity clusters with fewer than 100 training instances in the 806-class classification problem.</data>
      <data key="d3">chunk-de8f6faf25c75fd8dcf0e4d67e379249</data>
    </node>
    <node id="University of Michigan">
      <data key="d0">University of Michigan</data>
      <data key="d1">organization</data>
      <data key="d2">A public research university whose Advanced Research Computing provided computational resources and services for the human activity prediction research.</data>
      <data key="d3">chunk-3e6c6ba3246066dafb17ed3cbf673534</data>
    </node>
    <node id="Advanced Research Computing">
      <data key="d0">Advanced Research Computing</data>
      <data key="d1">organization</data>

      <data key="d3">chunk-3e6c6ba3246066dafb17ed3cbf673534</data>
    </node>
    <node id="Michigan Institute for Data Science">
      <data key="d0">Michigan Institute for Data Science</data>
      <data key="d1">organization</data>
      <data key="d2">An institute at the University of Michigan that partially supported the research on human activity prediction.</data>
      <data key="d3">chunk-3e6c6ba3246066dafb17ed3cbf673534</data>

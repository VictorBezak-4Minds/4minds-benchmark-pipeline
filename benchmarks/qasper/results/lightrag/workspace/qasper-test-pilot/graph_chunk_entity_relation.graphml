    <node id="NBA">
      <data key="d0">NBA</data>
      <data key="d1">organization</data>
      <data key="d2">The National Basketball Association (NBA) is a professional basketball league whose game box-scores and reports form the basis of the dataset used in the study.&lt;SEP&gt;The National Basketball Association (NBA) is the professional basketball league whose box-score tables and game reports serve as the foundation for the dataset.&lt;SEP&gt;The National Basketball Association, whose game report corpus serves as the source for deriving the unsupervised evaluation dataset.</data>
      <data key="d3">chunk-009a3d10aa88ab09f7d1c51bd7755ef4&lt;SEP&gt;chunk-e90c3963b2880a766180f3aafb75b379&lt;SEP&gt;chunk-c0e641e454fbaf0939a594969a7304c3</data>
    </node>
    <node id="Text Content Manipulation">
      <data key="d0">Text Content Manipulation</data>
      <data key="d1">category</data>
      <data key="d2">A natural language generation task focused on producing text that incorporates structured content records while preserving the writing style of reference sentences.&lt;SEP&gt;A proposed natural language generation task aiming to express structured record content while mimicking the writing style of a reference sentence.&lt;SEP&gt;A text generation task that requires updating or replacing specific content in a sentence while preserving the original writing style and attributes.</data>
      <data key="d3">chunk-08e25f0ce4d7d5635eb6aed1b2807f91&lt;SEP&gt;chunk-e90c3963b2880a766180f3aafb75b379&lt;SEP&gt;chunk-c0e641e454fbaf0939a594969a7304c3</data>
    </node>
    <node id="Text Style Transfer">
      <data key="d0">Text Style Transfer</data>
      <data key="d1">category</data>
      <data key="d2">A field and task category in natural language processing focused on altering the stylistic attributes of text while preserving its underlying meaning.&lt;SEP&gt;A machine learning and natural language processing domain focused on modifying stylistic attributes of text using disentangled representations and controlled generation.&lt;SEP&gt;A natural language processing task focused on altering textual attributes such as sentiment while preserving core semantic content.</data>
      <data key="d3">chunk-009a3d10aa88ab09f7d1c51bd7755ef4&lt;SEP&gt;chunk-8fa216244e9956f33ee1e83a4b072080&lt;SEP&gt;chunk-c0e641e454fbaf0939a594969a7304c3</data>
    </node>

      <data key="d1">category</data>
      <data key="d2">The scholarly domain encompasses academic abstracts and scientific papers traditionally used for keyphrase generation datasets.</data>
      <data key="d3">chunk-f7a0c631645254ecce4e14a53d44a991</data>
    </node>
    <node id="Indo-European Languages">
      <data key="d0">Indo-European Languages</data>
      <data key="d1">category</data>
      <data key="d2">A major language family whose structural patterns have dominated natural language processing tools and dialog management research.&lt;SEP&gt;Indo-European languages are a major language family encompassing Germanic and other language groups evaluated in cross-lingual modeling.</data>
      <data key="d3">chunk-18770431e1f17cd9efc7aedcdb98d303&lt;SEP&gt;chunk-f7a0c631645254ecce4e14a53d44a991</data>
    </node>
    <node id="Scandinavian Languages">
      <data key="d0">Scandinavian Languages</data>
      <data key="d1">category</data>
      <data key="d2">Scandinavian languages are a sub-branch of Germanic languages, including Swedish, Norwegian, Danish, Icelandic, and Faroese, tested in cross-entropy evaluations.</data>
      <data key="d3">chunk-f7a0c631645254ecce4e14a53d44a991</data>
    </node>
    <node id="Chayahuita">
      <data key="d0">Chayahuita</data>
      <data key="d1">category</data>
      <data key="d2">Chayahuita is an indigenous language used as the initial baseline training language in the multilingual neural language model experiment.</data>
      <data key="d3">chunk-f7a0c631645254ecce4e14a53d44a991</data>
    </node>
    <node id="Icelandic">
      <data key="d0">Icelandic</data>
      <data key="d1">category</data>
      <data key="d2">Icelandic is an insular Scandinavian language added during the progressive language model expansion experiments.</data>
      <data key="d3">chunk-f7a0c631645254ecce4e14a53d44a991</data>
    </node>
    <node id="Faroese">

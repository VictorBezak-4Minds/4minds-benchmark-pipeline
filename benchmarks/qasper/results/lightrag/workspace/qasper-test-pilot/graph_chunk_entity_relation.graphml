    </edge>
    <edge source="Triplet Loss" target="Semantic Regularization">
      <data key="d4">7.0</data>
      <data key="d5">Triplet Loss incorporates semantic regularization via a dedicated semantic-loss component to cluster dishes of the same class.</data>
      <data key="d6">objective integration, semantic clustering</data>
      <data key="d7">chunk-f0f9c89ffb57d88b6a05fbcd7d909d7d</data>
    </edge>
    <edge source="Triplet Loss" target="Shared Latent Space">
      <data key="d4">8.0</data>
      <data key="d5">Triplet Loss optimizes the positioning and margin of vectors within the shared latent space.</data>
      <data key="d6">embedding optimization, vector distance</data>
      <data key="d7">chunk-f0f9c89ffb57d88b6a05fbcd7d909d7d</data>
    </edge>
    <edge source="Cosine Similarity Loss" target="Cross-Entropy Classification Loss">
      <data key="d4">8.0</data>
      <data key="d5">Cross-Entropy Classification Loss is added to the Cosine Similarity Loss to form the complete objective function.</data>
      <data key="d6">loss formulation, objective function</data>
      <data key="d7">chunk-f0f9c89ffb57d88b6a05fbcd7d909d7d</data>
    </edge>
    <edge source="Cosine Similarity Loss" target="Shared Latent Space">
      <data key="d4">8.0</data>
      <data key="d5">Cosine Similarity Loss structures the shared latent space by pulling matching pairs closer and pushing non-matching pairs apart.</data>
      <data key="d6">metric learning, embedding space</data>
      <data key="d7">chunk-f0f9c89ffb57d88b6a05fbcd7d909d7d</data>
    </edge>
    <edge source="Cross-Entropy Classification Loss" target="Semantic Regularization">
      <data key="d4">8.0</data>
      <data key="d5">Cross-Entropy Classification Loss implements semantic regularization by penalizing misclassifications across semantic recipe and image classes.</data>
      <data key="d6">regularization, class alignment</data>
      <data key="d7">chunk-f0f9c89ffb57d88b6a05fbcd7d909d7d</data>
    </edge>

      <data key="d7">chunk-bd3cd3db55d1536871b82317efd46a4b</data>
    </edge>
    <edge source="Sanitization" target="Anonymization">
      <data key="d4">8.0</data>
      <data key="d5">Anonymization is one of the primary sanitization procedures utilized to manipulate identifiers in health datasets.</data>
      <data key="d6">classification, procedure</data>
      <data key="d7">chunk-bd3cd3db55d1536871b82317efd46a4b</data>
    </edge>
    <edge source="Sanitization" target="Pseudonymization">
      <data key="d4">8.0</data>
      <data key="d5">Pseudonymization is a distinct procedure within sanitization used to obscure patient identities.</data>
      <data key="d6">classification, procedure</data>
      <data key="d7">chunk-bd3cd3db55d1536871b82317efd46a4b</data>
    </edge>
    <edge source="Sanitization" target="De-Identification">
      <data key="d4">8.0</data>
      <data key="d5">De-identification is recognized alongside anonymization and pseudonymization as a procedure for data sanitization.</data>
      <data key="d6">classification, procedure</data>
      <data key="d7">chunk-bd3cd3db55d1536871b82317efd46a4b</data>
    </edge>
    <edge source="Sanitization" target="Deductive Disclosure">

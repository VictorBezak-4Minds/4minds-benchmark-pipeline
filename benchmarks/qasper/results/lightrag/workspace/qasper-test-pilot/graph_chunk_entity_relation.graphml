    <node id="Granroth">
      <data key="d0">Granroth</data>
      <data key="d1">person</data>
      <data key="d2">Granroth is a researcher who developed compositional event embedding models using neural networks to predict event coherence.</data>
      <data key="d3">chunk-c9d3fbec1ae6ff5c0cac8214c21ddda4</data>
    </node>
    <node id="Pichotta">
      <data key="d0">Pichotta</data>
      <data key="d1">person</data>
      <data key="d2">Pichotta is a researcher who framed event prediction as a sequence-to-sequence problem using recurrent neural network models.</data>
      <data key="d3">chunk-c9d3fbec1ae6ff5c0cac8214c21ddda4</data>
    </node>
    <node id="Narrative Chain">
      <data key="d0">Narrative Chain</data>
      <data key="d1">category</data>
      <data key="d2">An ordered sequence of events sharing a common participating entity, modeled to understand discourse flow and predict subsequent events.</data>
      <data key="d3">chunk-c9d3fbec1ae6ff5c0cac8214c21ddda4</data>
    </node>
    <node id="Hierarchical LSTM">
      <data key="d0">Hierarchical LSTM</data>
      <data key="d1">category</data>
      <data key="d2">A specialized recurrent neural network architecture applied to model structured event dependencies and generate event descriptions.</data>
      <data key="d3">chunk-c9d3fbec1ae6ff5c0cac8214c21ddda4</data>
    </node>
    <node id="Morphological Analysis">
      <data key="d0">Morphological Analysis</data>
      <data key="d1">category</data>
      <data key="d2">Morphological analysis is a linguistic task and domain involving the decomposition and analysis of internal word structure and morphemes.&lt;SEP&gt;Morphological analysis is a natural language processing task focused on identifying and segmenting the internal structure and morphemes of words.&lt;SEP&gt;The NLP analysis and segmentation of words into constituent morphemes to improve vocabulary representation and character-level composition.</data>
      <data key="d3">chunk-275b54efb44b71f0c8102cd8da9ac971&lt;SEP&gt;chunk-fd1654ff6fd1aefc2ac7a0fb3a18a4eb&lt;SEP&gt;chunk-c9d3fbec1ae6ff5c0cac8214c21ddda4</data>
    </node>
    <node id="S&amp;P 500 Index">
      <data key="d0">S&amp;P 500 Index</data>
      <data key="d1">category</data>
      <data key="d2">A prominent benchmark stock market index representing the market performance of 500 leading publicly traded companies in the United States, used as an evaluation target for event embeddings.</data>
      <data key="d3">chunk-c9d3fbec1ae6ff5c0cac8214c21ddda4</data>
    </node>
    <node id="Lazaridou">
      <data key="d0">Lazaridou</data>
      <data key="d1">person</data>
      <data key="d2">A researcher who demonstrated methods for deriving morpheme representations distributionally to obtain word representations.</data>
      <data key="d3">chunk-4117dfdbcf8427f9aa5d8d43444fb707</data>
    </node>
    <node id="Luong">
      <data key="d0">Luong</data>
      <data key="d1">person</data>
      <data key="d2">A researcher cited for developing local attention and feed-input techniques utilized in neural machine translation systems.&lt;SEP&gt;A researcher who trained a morphological composition model based on recursive neural networks.&lt;SEP&gt;A researcher whose published work on unknown word replacement is utilized to enhance the translation performance of the ensemble NMT system.&lt;SEP&gt;Luong is a researcher recognized for developing the Luong attention mechanism utilized in sequence-to-sequence neural network architectures.</data>
      <data key="d3">chunk-8fa216244e9956f33ee1e83a4b072080&lt;SEP&gt;chunk-4117dfdbcf8427f9aa5d8d43444fb707&lt;SEP&gt;chunk-b98e14081bd42f130f547ac6df8114f8&lt;SEP&gt;chunk-762be16cab89cb90aaf53d4505452bf5</data>
    </node>
    <node id="Botha">
      <data key="d0">Botha</data>
      <data key="d1">person</data>
      <data key="d2">A researcher who, alongside Blunsom, developed a language model incorporating morphemes.</data>
      <data key="d3">chunk-4117dfdbcf8427f9aa5d8d43444fb707</data>
    </node>
    <node id="Blunsom">
      <data key="d0">Blunsom</data>
      <data key="d1">person</data>
      <data key="d2">A researcher who co-developed a morpheme-based language model demonstrating improvements in language modelling and machine translation.</data>
      <data key="d3">chunk-4117dfdbcf8427f9aa5d8d43444fb707</data>
    </node>
    <node id="Ballesteros">
      <data key="d0">Ballesteros</data>
      <data key="d1">person</data>
      <data key="d2">A researcher who trained character-level neural network models for syntactic parsing.&lt;SEP&gt;Ballesteros is a researcher who, along with colleagues, trained a character-level neural network model for parsing.</data>
      <data key="d3">chunk-cd3a4a211bb43ab387afa7488082157d&lt;SEP&gt;chunk-4117dfdbcf8427f9aa5d8d43444fb707</data>
    </node>
    <node id="Word Morphology">
      <data key="d0">Word Morphology</data>
      <data key="d1">category</data>
      <data key="d2">A subfield of linguistics and NLP focused on the internal structure of words and their minimal meaningful semantic units, known as morphemes.</data>
      <data key="d3">chunk-4117dfdbcf8427f9aa5d8d43444fb707</data>
    </node>
    <node id="Character-Level Models">
      <data key="d0">Character-Level Models</data>
      <data key="d1">category</data>
      <data key="d2">A category of neural network architectures that process text at the level of individual orthographic characters rather than whole words.&lt;SEP&gt;Character-level models are translation representations that use character mappings, effective primarily for closely related languages.&lt;SEP&gt;Translation units and modeling approaches operating at the level of individual characters, effective primarily for highly similar language pairs.</data>
      <data key="d3">chunk-4117dfdbcf8427f9aa5d8d43444fb707&lt;SEP&gt;chunk-ea126b0da9c38f85b697b36cd33629f5&lt;SEP&gt;chunk-acd45458d7c3c63e9891f23252405a17</data>
    </node>
    <node id="Unsupervised Morphology Induction">
      <data key="d0">Unsupervised Morphology Induction</data>
      <data key="d1">category</data>
      <data key="d2">A category of computational linguistic tasks that aim to infer morphological relations and segmentations without labeled training data.</data>
      <data key="d3">chunk-4117dfdbcf8427f9aa5d8d43444fb707</data>
    </node>
    <node id="S&amp;P 500">
      <data key="d0">S&amp;P 500</data>
      <data key="d1">category</data>
      <data key="d2">A stock market index tracking the performance of 500 leading publicly traded companies in the United States, used in the text as a prediction benchmark.</data>
      <data key="d3">chunk-4117dfdbcf8427f9aa5d8d43444fb707</data>
    </node>
    <node id="CELEX">
      <data key="d0">CELEX</data>
      <data key="d1">organization</data>
      <data key="d2">A standard lexical database providing gold-standard morphological analyses for English, Dutch, and German words.</data>
      <data key="d3">chunk-4117dfdbcf8427f9aa5d8d43444fb707</data>
    </node>
    <node id="Morfessor">
      <data key="d0">Morfessor</data>
      <data key="d1">category</data>
      <data key="d2">A machine learning model and morphological analyzer explicitly designed for unsupervised and semi-supervised morpheme segmentation.&lt;SEP&gt;An external software tool and baseline model widely used for unsupervised and semi-supervised morphological analysis.&lt;SEP&gt;An unsupervised morphological segmentation tool used to induce morpheme representations for machine translation models.&lt;SEP&gt;Morfessor is a family of generative models for unsupervised morphology induction, including Morfessor Baseline and Morfessor EM+Prune.</data>
      <data key="d3">chunk-4117dfdbcf8427f9aa5d8d43444fb707&lt;SEP&gt;chunk-5cf9480461a20dfddfe7c1ed32cfa07c&lt;SEP&gt;chunk-b20ba46b9900c93d13d7e98bc090ac13&lt;SEP&gt;chunk-1ad8b9a3ff673a8919c974c24205949f</data>
    </node>
    <node id="POS Tagging">
      <data key="d0">POS Tagging</data>
      <data key="d1">category</data>
      <data key="d2">Part-of-speech (POS) tagging is an NLP task where character-level models and morphosyntactic features achieve state-of-the-art accuracy.&lt;SEP&gt;Part-of-speech tagging, an NLP task aimed at labeling words in a text with their corresponding grammatical categories.</data>
      <data key="d3">chunk-cd3a4a211bb43ab387afa7488082157d&lt;SEP&gt;chunk-4117dfdbcf8427f9aa5d8d43444fb707</data>
    </node>
    <node id="Distributional Hypothesis">
      <data key="d0">Distributional Hypothesis</data>
      <data key="d1">category</data>
      <data key="d2">A foundational concept in linguistics and semantic modeling stating that words occurring in similar contexts tend to share similar meanings.</data>
      <data key="d3">chunk-4117dfdbcf8427f9aa5d8d43444fb707</data>
    </node>
    <node id="Morpheme Boundary Recovery">
      <data key="d0">Morpheme Boundary Recovery</data>
      <data key="d1">category</data>
      <data key="d2">An evaluation task in morphological analysis that tests a model's ability to identify segmentation boundaries between morphemes in words.&lt;SEP&gt;Morpheme boundary recovery is a natural language processing task focused on identifying segmentation points and intra-word morpheme boundaries.</data>
      <data key="d3">chunk-4117dfdbcf8427f9aa5d8d43444fb707&lt;SEP&gt;chunk-fd1654ff6fd1aefc2ac7a0fb3a18a4eb</data>
    </node>
    <node id="Syntactic Analogy Answering">
      <data key="d0">Syntactic Analogy Answering</data>
      <data key="d1">category</data>
      <data key="d2">An evaluation benchmark in NLP testing whether word representation spaces capture syntactic relationships through vector arithmetic.</data>
      <data key="d3">chunk-4117dfdbcf8427f9aa5d8d43444fb707</data>
    </node>
    <node id="Mikolov">
      <data key="d0">Mikolov</data>
      <data key="d1">person</data>
      <data key="d2">A researcher whose test set of semantic and syntactic question types is referenced in the research evaluation.&lt;SEP&gt;Mikolov is a researcher known for creating the word analogy test set and the original Skip-gram evaluation framework referenced in the text.&lt;SEP&gt;Mikolov is a researcher who, along with colleagues, introduced the Skip-Gram with Negative Sampling (SGNS) objective used in word representation models.&lt;SEP&gt;Mikolov is a researcher whose analogy question generation methodology was adopted in the study and who released a Skip-gram model trained on Google News data.&lt;SEP&gt;Mikolov refers to researcher Tomas Mikolov, whose word vector arithmetic method is used to answer semantic and syntactic analogy questions.</data>
      <data key="d3">chunk-cd3a4a211bb43ab387afa7488082157d&lt;SEP&gt;chunk-2fd39034576eb8de5d243305db77f4b3&lt;SEP&gt;chunk-f3e8fa58e562bb861dae62114ff9c810&lt;SEP&gt;chunk-fd1654ff6fd1aefc2ac7a0fb3a18a4eb&lt;SEP&gt;chunk-3d0343896fcb9bca626f6a9369daf5a8</data>
    </node>
    <node id="Char2Vec">
      <data key="d0">Char2Vec</data>
      <data key="d1">category</data>
      <data key="d2">A character-based word embedding model designed to learn subword representations, morphological segmentations, and semantic vectors directly from characters.&lt;SEP&gt;Char2Vec is a character-level neural embedding model that replaces standard word embedding lookups with an LSTM-based character encoding function to capture morphology and compositional semantics.&lt;SEP&gt;Char2Vec is a character-level recurrent neural network architecture designed to split words into morpheme-like components and learn word representations using bidirectional LSTMs and attention mechanisms.</data>
      <data key="d3">chunk-cd3a4a211bb43ab387afa7488082157d&lt;SEP&gt;chunk-1ad8b9a3ff673a8919c974c24205949f&lt;SEP&gt;chunk-275b54efb44b71f0c8102cd8da9ac971</data>
    </node>
    <node id="Skip-Gram With Negative Sampling">
      <data key="d0">Skip-Gram With Negative Sampling</data>
      <data key="d1">category</data>
      <data key="d2">Skip-Gram with Negative Sampling (SGNS) is an objective function and training method for learning vector representations of words based on co-occurrence with context words.</data>
      <data key="d3">chunk-cd3a4a211bb43ab387afa7488082157d</data>
    </node>
    <node id="Character-Level Neural Network Models">
      <data key="d0">Character-Level Neural Network Models</data>
      <data key="d1">category</data>
      <data key="d2">Character-level neural network models are architectures that derive representations from sequences of characters rather than whole words, capturing morphological properties.</data>
      <data key="d3">chunk-cd3a4a211bb43ab387afa7488082157d</data>
    </node>
    <node id="Recurrent Architecture">
      <data key="d0">Recurrent Architecture</data>
      <data key="d1">category</data>
      <data key="d2">Recurrent neural network architectures are sequence models used to derive word representations from character inputs.</data>
      <data key="d3">chunk-cd3a4a211bb43ab387afa7488082157d</data>
    </node>
    <node id="Classical Word Embedding Models">
      <data key="d0">Classical Word Embedding Models</data>
      <data key="d1">category</data>
      <data key="d2">Classical word embedding models represent entire words as distinct vectors and capture semantic relations and human word similarity judgments.</data>
      <data key="d3">chunk-cd3a4a211bb43ab387afa7488082157d</data>
    </node>
    <node id="Compositional Word Semantics">
      <data key="d0">Compositional Word Semantics</data>
      <data key="d1">category</data>
      <data key="d2">Compositional word semantics refers to the meaning of words formed compositionally from constituent subwords and morphemes, investigated in character-level models.</data>
      <data key="d3">chunk-cd3a4a211bb43ab387afa7488082157d</data>
    </node>
    <node id="Morphological Knowledge">
      <data key="d0">Morphological Knowledge</data>
      <data key="d1">category</data>
      <data key="d2">Morphological knowledge encompasses word structure, prefixes, and suffixes that character-level models seek to incorporate to structure the embedding space.</data>
      <data key="d3">chunk-cd3a4a211bb43ab387afa7488082157d</data>
    </node>
    <node id="Bahdanau">
      <data key="d0">Bahdanau</data>
      <data key="d1">person</data>
      <data key="d2">Bahdanau refers to researcher Dzmitry Bahdanau (Bahdanau et al.), whose attention mechanism formulation is adopted in the model.</data>
      <data key="d3">chunk-275b54efb44b71f0c8102cd8da9ac971</data>
    </node>
    <node id="English Lexicon Project">
      <data key="d0">English Lexicon Project</data>
      <data key="d1">organization</data>
      <data key="d2">The English Lexicon Project is an initiative and lexical database that provided the reference morphological analyses used as gold-standard data.</data>
      <data key="d3">chunk-275b54efb44b71f0c8102cd8da9ac971</data>
    </node>
    <node id="Semantic Similarity">
      <data key="d0">Semantic Similarity</data>
      <data key="d1">category</data>
      <data key="d2">An evaluation category representing the conceptual and contextual meaning equivalence between generated phrases and reference gold data.&lt;SEP&gt;Semantic similarity is an evaluation task in natural language processing measuring how semantically related or close two word representations are.&lt;SEP&gt;Semantic similarity is an evaluation task measuring the correlation between model-generated word representations and human annotator judgments.</data>
      <data key="d3">chunk-24fec6e6dba96ab2ffdd4b5fac402b39&lt;SEP&gt;chunk-fd1654ff6fd1aefc2ac7a0fb3a18a4eb&lt;SEP&gt;chunk-275b54efb44b71f0c8102cd8da9ac971</data>
    </node>
    <node id="Analogy Retrieval">
      <data key="d0">Analogy Retrieval</data>
      <data key="d1">category</data>
      <data key="d2">Analogy retrieval is an evaluation task testing the ability of word embeddings to preserve syntactic and semantic relations across pairs of words.</data>
      <data key="d3">chunk-275b54efb44b71f0c8102cd8da9ac971</data>
    </node>
    <node id="Morphology">
      <data key="d0">Morphology</data>
      <data key="d1">category</data>
      <data key="d2">Morphology is the study of word structure and the formation of words out of smaller meaningful linguistic units known as morphemes.</data>
      <data key="d3">chunk-275b54efb44b71f0c8102cd8da9ac971</data>
    </node>
    <node id="Text8 Corpus">
      <data key="d0">Text8 Corpus</data>
      <data key="d1">category</data>
      <data key="d2">The Text8 corpus is a standard benchmark text dataset comprising the first 100MB of a cleaned-up 2006 Wikipedia dump used for training embedding models.</data>
      <data key="d3">chunk-275b54efb44b71f0c8102cd8da9ac971</data>
    </node>
    <node id="Attention Model">
      <data key="d0">Attention Model</data>
      <data key="d1">category</data>
      <data key="d2">The attention model is a neural mechanism based on Bahdanau et al. that assigns weights to hidden states across character boundaries to capture morphology.</data>
      <data key="d3">chunk-275b54efb44b71f0c8102cd8da9ac971</data>
    </node>
    <node id="Word2Vec">
      <data key="d0">Word2Vec</data>
      <data key="d1">category</data>
      <data key="d2">A category of natural language processing algorithms used to produce dense vector representations of words from large text corpora.&lt;SEP&gt;A foundational framework of shallow, two-layer neural models used to produce distributed continuous vector representations of words.&lt;SEP&gt;A natural language processing word embedding technique trained on the Google News corpus to generate a pre-trained lookup table for the neural network.&lt;SEP&gt;A word embedding model framework used to generate vector representations trained on datasets like WikiGenderBias.&lt;SEP&gt;Word2Vec is a foundational framework for generating distributed word representations, providing context lookup initialization and unigram distributions for training.&lt;SEP&gt;Word2Vec is a word embedding framework used to generate distributed vector representations of text tokens.</data>
      <data key="d3">chunk-ef7b95a2f35faad97942f87543b7ab1f&lt;SEP&gt;chunk-275b54efb44b71f0c8102cd8da9ac971&lt;SEP&gt;chunk-784f828261b96cc3c6df35aff5b1cae5&lt;SEP&gt;chunk-f76f1c0c2ed37a786263a6a6d8b0bb6d&lt;SEP&gt;chunk-806c5b143029efcdf6de258a039af615&lt;SEP&gt;chunk-e3bc49e88e2b4d9c426436c1d272e949</data>
    </node>
    <node id="SGNS">
      <data key="d0">SGNS</data>
      <data key="d1">category</data>
      <data key="d2">Skip-Gram with Negative Sampling (SGNS) is a standard word-level embedding baseline model trained with negative sampling.</data>
      <data key="d3">chunk-275b54efb44b71f0c8102cd8da9ac971</data>
    </node>
    <node id="C2V-NO-ATT">
      <data key="d0">C2V-NO-ATT</data>
      <data key="d1">category</data>
      <data key="d2">C2V-NO-ATT is an ablation baseline version of the Char2Vec model trained without the attention mechanism.</data>
      <data key="d3">chunk-275b54efb44b71f0c8102cd8da9ac971</data>
    </node>
    <node id="Morphological Segmentation">
      <data key="d0">Morphological Segmentation</data>
      <data key="d1">category</data>
      <data key="d2">Morphological Segmentation is the linguistic task of decomposing words into meaningful subword morphemes or morphs.&lt;SEP&gt;Morphological segmentation is a computational linguistics task that splits words into constituent morphemes, evaluated via boundary ranking.&lt;SEP&gt;Morphological segmentation is the natural language processing task of dividing words into morphs, which are surface forms of meaning-bearing sub-word units.</data>
      <data key="d3">chunk-e060c5bbcfa40d71aa9fb0a2e63bff30&lt;SEP&gt;chunk-b20ba46b9900c93d13d7e98bc090ac13&lt;SEP&gt;chunk-275b54efb44b71f0c8102cd8da9ac971</data>
    </node>
    <node id="Mean Average Precision">
      <data key="d0">Mean Average Precision</data>
      <data key="d1">category</data>
      <data key="d2">An evaluation metric (MAP) used to evaluate the precision and ranking of predicted intra-word morpheme boundaries.&lt;SEP&gt;Mean Average Precision (MAP) is an information retrieval ranking evaluation metric used to score the model's recovery of intra-word morpheme boundaries.</data>
      <data key="d3">chunk-1ad8b9a3ff673a8919c974c24205949f&lt;SEP&gt;chunk-275b54efb44b71f0c8102cd8da9ac971</data>
    </node>
    <node id="Border F1">
      <data key="d0">Border F1</data>
      <data key="d1">category</data>
      <data key="d2">Border F1 is a traditional evaluation metric used for hard morphological analyzers to determine the accuracy of detected morpheme boundaries.</data>
      <data key="d3">chunk-275b54efb44b71f0c8102cd8da9ac971</data>
    </node>
    <node id="SVD">
      <data key="d0">SVD</data>
      <data key="d1">category</data>
      <data key="d2">Singular Value Decomposition (SVD) is a matrix factorization method applied to PPMI-weighted co-occurrence matrices to produce count-based vector baselines.</data>
      <data key="d3">chunk-275b54efb44b71f0c8102cd8da9ac971</data>
    </node>
    <node id="PPMI">
      <data key="d0">PPMI</data>
      <data key="d1">category</data>
      <data key="d2">Positive Pointwise Mutual Information (PPMI) is a statistical co-occurrence weighting measure applied before dimensionality reduction.</data>
      <data key="d3">chunk-275b54efb44b71f0c8102cd8da9ac971</data>
    </node>
    <node id="Porter Stemmer">
      <data key="d0">Porter Stemmer</data>
      <data key="d1">category</data>
      <data key="d2">A rule-based algorithmic stemming method that strips suffixes to identify word stems.</data>
      <data key="d3">chunk-1ad8b9a3ff673a8919c974c24205949f</data>
    </node>
    <node id="WordSim353">
      <data key="d0">WordSim353</data>
      <data key="d1">category</data>
      <data key="d2">A standard benchmark dataset composed of common word pairs with human similarity ratings.</data>
      <data key="d3">chunk-1ad8b9a3ff673a8919c974c24205949f</data>
    </node>
    <node id="MEN Dataset">
      <data key="d0">MEN Dataset</data>
      <data key="d1">category</data>
      <data key="d2">A benchmark dataset containing word pairs paired with human similarity judgments to evaluate semantic representations.</data>
      <data key="d3">chunk-1ad8b9a3ff673a8919c974c24205949f</data>
    </node>
    <node id="Rare Word Dataset">
      <data key="d0">Rare Word Dataset</data>
      <data key="d1">category</data>
      <data key="d2">A benchmark semantic similarity dataset (RW) consisting of low-frequency, morphologically complex words and out-of-vocabulary terms.</data>
      <data key="d3">chunk-1ad8b9a3ff673a8919c974c24205949f</data>
    </node>
    <node id="Google Analogy Dataset">
      <data key="d0">Google Analogy Dataset</data>
      <data key="d1">category</data>
      <data key="d2">An analogy evaluation dataset consisting of 19,544 questions divided into semantic and syntactic sections.</data>
      <data key="d3">chunk-1ad8b9a3ff673a8919c974c24205949f</data>
    </node>
    <node id="Character-Based Models">
      <data key="d0">Character-Based Models</data>
      <data key="d1">category</data>
      <data key="d2">A class of natural language processing embedding models that process linguistic data at the character level to leverage subword information.</data>
      <data key="d3">chunk-1ad8b9a3ff673a8919c974c24205949f</data>
    </node>
    <node id="Word-Based Embedding Models">
      <data key="d0">Word-Based Embedding Models</data>
      <data key="d1">category</data>
      <data key="d2">A class of embedding models that represent words as atomic units rather than decomposing them into subword components.</data>
      <data key="d3">chunk-1ad8b9a3ff673a8919c974c24205949f</data>
    </node>
    <node id="C2V Model Without Morphology">
      <data key="d0">C2V Model Without Morphology</data>
      <data key="d1">category</data>
      <data key="d2">A baseline or ablation variant of the Char2Vec model that does not incorporate morphological segmentation capabilities.</data>
      <data key="d3">chunk-1ad8b9a3ff673a8919c974c24205949f</data>
    </node>
    <node id="Morfessor 2.0">
      <data key="d0">Morfessor 2.0</data>
      <data key="d1">category</data>
      <data key="d2">A specific version of Morfessor trained on the corpus with a random split value of 0.9 and early stopping to predict morpheme boundaries.&lt;SEP&gt;An implementation of the Morfessor morphological segmentation framework that features hyper-parameter tuning methods such as grid search and heuristic automatic tuning.&lt;SEP&gt;Morfessor 2.0 is a specific implementation of the Morfessor Baseline method.&lt;SEP&gt;Morfessor 2.0 is an earlier baseline model for morphological segmentation that implements force splitting on both sides of designated characters into single-character morphs.</data>
      <data key="d3">chunk-b076d49bd537ec691f3ab083fc7fd528&lt;SEP&gt;chunk-787a9d7cce59743956093bca0779b549&lt;SEP&gt;chunk-b20ba46b9900c93d13d7e98bc090ac13&lt;SEP&gt;chunk-1ad8b9a3ff673a8919c974c24205949f</data>
    </node>
    <node id="Spearman's Rho">
      <data key="d0">Spearman's Rho</data>
      <data key="d1">category</data>
      <data key="d2">A rank correlation coefficient metric used to evaluate the correlation between model-generated similarity scores and human similarity judgments.</data>
      <data key="d3">chunk-1ad8b9a3ff673a8919c974c24205949f</data>
    </node>
    <node id="Out Of Vocabulary">
      <data key="d0">Out Of Vocabulary</data>
      <data key="d1">category</data>
      <data key="d2">A linguistic and computational category referring to words that do not appear in the training corpus or vocabulary of a model.&lt;SEP&gt;Out of vocabulary refers to words that do not appear in the predefined training dictionary and therefore lack standard vector embeddings in traditional models.</data>
      <data key="d3">chunk-2fd39034576eb8de5d243305db77f4b3&lt;SEP&gt;chunk-1ad8b9a3ff673a8919c974c24205949f</data>
    </node>
    <node id="Random Baseline">
      <data key="d0">Random Baseline</data>
      <data key="d1">category</data>
      <data key="d2">A comparative baseline method that randomly places intra-word morpheme boundaries to evaluate model performance.</data>
      <data key="d3">chunk-1ad8b9a3ff673a8919c974c24205949f</data>
    </node>
    <node id="Affixation">
      <data key="d0">Affixation</data>
      <data key="d1">category</data>
      <data key="d2">A morphological process adding affixes to word stems, evaluated to check if it corresponds to regular linear vector shifts.</data>
      <data key="d3">chunk-1ad8b9a3ff673a8919c974c24205949f</data>
    </node>
    <node id="Spearman">
      <data key="d0">Spearman</data>
      <data key="d1">person</data>
      <data key="d2">Charles Spearman, the statistician associated with the rank correlation metric (Spearman's rho) used in model evaluation.</data>
      <data key="d3">chunk-1ad8b9a3ff673a8919c974c24205949f</data>
    </node>
    <node id="Paris">
      <data key="d0">Paris</data>
      <data key="d1">geo</data>
      <data key="d2">Paris is a prominent French city mentioned as an example of a general place-name location tag filtered out during coordinate preprocessing.&lt;SEP&gt;Paris is the capital city of France, mentioned as an example in capital-country semantic analogy pairs.&lt;SEP&gt;Paris is the capital of France, exhibiting distinct linguistic patterns where standard language usage is higher in the city center compared to its suburban districts.&lt;SEP&gt;Paris is the capital of France, highlighted in the study to examine the local distribution of linguistic markers at the arrondissement level.</data>
      <data key="d3">chunk-dc455b4914b59090a3ce9d2a9448259b&lt;SEP&gt;chunk-c32a5fa97db65bdeb1930b1f4e52c5ec&lt;SEP&gt;chunk-e6e4431e2ead79e10a12d16d49f4d480&lt;SEP&gt;chunk-fd1654ff6fd1aefc2ac7a0fb3a18a4eb</data>
    </node>
    <node id="France">
      <data key="d0">France</data>
      <data key="d1">geo</data>
      <data key="d2">A country in Western Europe whose national census and French Twitter data were combined to study regional and socioeconomic linguistic variation.&lt;SEP&gt;A country mentioned in the context of question answering regarding the nationality of Jean Michel Diot.&lt;SEP&gt;France is a European country exhibiting over-predicted languages within Twitter datasets.&lt;SEP&gt;France is a European country whose national territory, administrative divisions, and population distributions form the geographic scope of the study.&lt;SEP&gt;France is a country divided administratively into 97 départements whose population's linguistic variability on social media was analyzed.&lt;SEP&gt;France is a country in Western Europe where the study's dataset of Twitter users and census sociodemographic information is situated.&lt;SEP&gt;France is a country in Western Europe whose geographic departments and arrondissements were analyzed for the variability of linguistic markers and socioeconomic indicators.&lt;SEP&gt;France is a country in Western Europe whose territory, population distribution, and socioeconomic data across regions, arrondissements, and cantons are analyzed in the study.&lt;SEP&gt;France is a country referenced within the OWL class expression example describing cities located in France.&lt;SEP&gt;France is a country whose online funeral home websites and health records were used for real-time mortality surveillance research.&lt;SEP&gt;France is a country, paired with Paris in capital-country semantic analogy evaluation examples.&lt;SEP&gt;France is the country across which the spatial distribution of socioeconomic indicators and linguistic variation was analyzed.&lt;SEP&gt;France is the country encompassing the geographic territory to which the study's geolocated users and population distributions were restricted and analyzed.&lt;SEP&gt;France is the country whose geolocated Twitter users and socioeconomic indicators were analyzed in the research study.&lt;SEP&gt;The European country whose departments and geolocated users were the subject of the spatial and linguistic variation study.&lt;SEP&gt;The country where the DRUGS-SAFE national platform operates and where drug safety monitoring and related medical coding evaluations take place.&lt;SEP&gt;The country whose death certificates serve as the evaluation corpus for ICD-10 coding in the CLEF eHealth 2018 challenge.</data>
      <data key="d3">chunk-0ced0d535e26b1f8838eba4645dd259b&lt;SEP&gt;chunk-5be31c1a19a6e864780cdaa9c6a90013&lt;SEP&gt;chunk-ae11879a44e89506f5f7277c88df7c75&lt;SEP&gt;chunk-dc455b4914b59090a3ce9d2a9448259b&lt;SEP&gt;chunk-dc1405d1609fdbebb00fe9dd18235f8e&lt;SEP&gt;chunk-d7d53ab63937232bbcc4be9c7080dd31&lt;SEP&gt;chunk-5d4f8de99402c910c9db26d32af6e4a4&lt;SEP&gt;chunk-3ec2e699c363addb244b4be53103a6f0&lt;SEP&gt;chunk-e6e4431e2ead79e10a12d16d49f4d480&lt;SEP&gt;chunk-50bb442ab9eb2bd0ac132636b603c20a&lt;SEP&gt;chunk-fd1654ff6fd1aefc2ac7a0fb3a18a4eb&lt;SEP&gt;chunk-bb5e43262e5e845585236177cb906ef7&lt;SEP&gt;chunk-f717f876f65432fa813fac20ad6a7ddb&lt;SEP&gt;chunk-3d0343896fcb9bca626f6a9369daf5a8&lt;SEP&gt;chunk-c32a5fa97db65bdeb1930b1f4e52c5ec&lt;SEP&gt;chunk-7fdcba40597c8aa146fec00068a7247f</data>
    </node>
    <node id="Berlin">
      <data key="d0">Berlin</data>
      <data key="d1">geo</data>
      <data key="d2">Berlin is the capital city of Germany, cited as an example item in the Google analogy dataset questions.</data>
      <data key="d3">chunk-fd1654ff6fd1aefc2ac7a0fb3a18a4eb</data>
    </node>
    <node id="Semantic Analogy">
      <data key="d0">Semantic Analogy</data>
      <data key="d1">category</data>
      <data key="d2">Semantic analogy is a category of word relationship tasks driven by conceptual and semantic relationships, such as capital-country and currency-country pairs.</data>
      <data key="d3">chunk-fd1654ff6fd1aefc2ac7a0fb3a18a4eb</data>
    </node>
    <node id="Syntactic Analogy">
      <data key="d0">Syntactic Analogy</data>
      <data key="d1">category</data>
      <data key="d2">Syntactic analogy is a category of linguistic evaluation questions based on grammatical and morphological alterations, such as adjective-adverb transformations and negation prefixing.</data>
      <data key="d3">chunk-fd1654ff6fd1aefc2ac7a0fb3a18a4eb</data>
    </node>
    <node id="Multi-Document Summarization">
      <data key="d0">Multi-Document Summarization</data>
      <data key="d1">category</data>
      <data key="d2">Multi-Document Summarization (MDS) is a natural language processing task focused on creating a coherent, condensed summary from a collection of documents on related topics.&lt;SEP&gt;Multi-Document Summarization is a subfield of natural language processing focused on generating concise summaries from multiple source documents.&lt;SEP&gt;Multi-document summarization is a natural language processing task referenced as a research domain focusing on centroid-based baseline methods.&lt;SEP&gt;Multi-document summarization is a natural language processing task that generates a condensed summary from multiple unstructured or structured text documents.</data>
      <data key="d3">chunk-10a2790542b2adb7f0c75f7dd7c8afd2&lt;SEP&gt;chunk-22ae1796dede39736a6ce61ec4cb1e2e&lt;SEP&gt;chunk-fd1654ff6fd1aefc2ac7a0fb3a18a4eb&lt;SEP&gt;chunk-99df0a2940e224839126173e8c2bc846</data>
    </node>
    <node id="Turkish">
      <data key="d0">Turkish</data>
      <data key="d1">category</data>
      <data key="d2">A low-resource child source language evaluated in the transfer learning neural machine translation framework.&lt;SEP&gt;A low-resource language analyzed in transfer learning experiments, where freezing target attention parameters yielded performance gains.&lt;SEP&gt;A low-resource language evaluated in the study for translation into English using transfer learning.&lt;SEP&gt;A natural language evaluated in the Morfessor cost and boundary precision-recall segmentation experiments.&lt;SEP&gt;The Turkish linguistic and geographical context pertaining to the language and texts analyzed in the study.&lt;SEP&gt;Turkish is a Turkic language category tested in the morphological experiments, known for complex agglutinative morphology.&lt;SEP&gt;Turkish is a natural language highlighted as having a significantly richer morphology than English, making it well-suited for morphologically aware embedding models.&lt;SEP&gt;Turkish is an agglutinative language used to assess the morphological segmentation performance of subword models.</data>
      <data key="d3">chunk-b98e14081bd42f130f547ac6df8114f8&lt;SEP&gt;chunk-43d472bd5e8478be39954bdc44e0469e&lt;SEP&gt;chunk-e060c5bbcfa40d71aa9fb0a2e63bff30&lt;SEP&gt;chunk-762be16cab89cb90aaf53d4505452bf5&lt;SEP&gt;chunk-731ed10b120fb04a1b73bc728f12beb5&lt;SEP&gt;chunk-fd1654ff6fd1aefc2ac7a0fb3a18a4eb&lt;SEP&gt;chunk-3c17cbdd46b3ef569862a8fa188b4fab&lt;SEP&gt;chunk-25f6efeef473f49482457fa3064ed4dd</data>
    </node>
    <node id="Character-Level Model">
      <data key="d0">Character-Level Model</data>
      <data key="d1">category</data>
      <data key="d2">Character-level model is an architectural category of representation models that construct word embeddings from subword or character sequences.</data>
      <data key="d3">chunk-fd1654ff6fd1aefc2ac7a0fb3a18a4eb</data>
    </node>
    <node id="Word-Level Model">
      <data key="d0">Word-Level Model</data>
      <data key="d1">category</data>
      <data key="d2">Word-level model is an architectural category of word embedding systems that treat whole words as atomic units.</data>
      <data key="d3">chunk-fd1654ff6fd1aefc2ac7a0fb3a18a4eb</data>
    </node>
    <node id="DUC2004">
      <data key="d0">DUC2004</data>
      <data key="d1">event</data>
      <data key="d2">DUC2004 (Document Understanding Conference 2004) is an evaluation benchmark event and competition dataset used for testing multi-document summarization systems.&lt;SEP&gt;DUC2004 refers to the Document Understanding Conference 2004, an evaluation event and benchmark dataset used for testing multi-document summarization systems.</data>
      <data key="d3">chunk-22ae1796dede39736a6ce61ec4cb1e2e&lt;SEP&gt;chunk-9d061db4b0ef06b5f3c1d715a602dc1d</data>
    </node>
    <node id="Extractive Multi-Document Summarization">
      <data key="d0">Extractive Multi-Document Summarization</data>
      <data key="d1">category</data>
      <data key="d2">Extractive Multi-Document Summarization (MDS) is a natural language processing task focused on summarizing a collection of documents by selecting representative sentences that maximize coverage and minimize redundancy.</data>
      <data key="d3">chunk-9d061db4b0ef06b5f3c1d715a602dc1d</data>
    </node>
    <node id="Centroid-Based Method">
      <data key="d0">Centroid-Based Method</data>
      <data key="d1">category</data>
      <data key="d2">The Centroid-Based Method is an extractive document summarization technique that scores sentences or whole summaries based on vector similarity to a central representation of the document collection.</data>
      <data key="d3">chunk-9d061db4b0ef06b5f3c1d715a602dc1d</data>
    </node>
    <node id="Sentence Ranking">
      <data key="d0">Sentence Ranking</data>
      <data key="d1">category</data>
      <data key="d2">Sentence ranking is an extractive summarization approach that assigns scores to individual sentences and selects the highest-scoring entries to form a summary.</data>
      <data key="d3">chunk-9d061db4b0ef06b5f3c1d715a602dc1d</data>
    </node>
    <node id="Summary-Level Optimization">
      <data key="d0">Summary-Level Optimization</data>
      <data key="d1">category</data>
      <data key="d2">Summary-level optimization is a summarization strategy that evaluates and optimizes entire sets or combinations of sentences together rather than scoring sentences independently.</data>
      <data key="d3">chunk-9d061db4b0ef06b5f3c1d715a602dc1d</data>
    </node>
    <node id="Greedy Algorithm">
      <data key="d0">Greedy Algorithm</data>
      <data key="d1">category</data>
      <data key="d2">A greedy algorithm is an optimization heuristic used in the modified centroid-based summarization method to iteratively construct the highest-scoring summary under length constraints.</data>
      <data key="d3">chunk-9d061db4b0ef06b5f3c1d715a602dc1d</data>
    </node>
    <node id="Bag-Of-Words">
      <data key="d0">Bag-Of-Words</data>
      <data key="d1">category</data>
      <data key="d2">A baseline text representation technique aggregating all tweets from an individual user into a unified document structure.&lt;SEP&gt;A text representation model that simplifies documents to word frequencies, used in prior work for predicting political ideology.&lt;SEP&gt;Bag-of-words is a vector representation model that represents text documents and sentences based on word occurrences without grammar or order.</data>
      <data key="d3">chunk-56672a5cb0c14c3d38c148dbe5205622&lt;SEP&gt;chunk-9d061db4b0ef06b5f3c1d715a602dc1d&lt;SEP&gt;chunk-707d9bb0e2896feb599f211f8cc655a0</data>
    </node>
    <node id="TF-IDF">
      <data key="d0">TF-IDF</data>
      <data key="d1">category</data>
      <data key="d2">A statistical weighting heuristic and vectorization technique that balances Term Frequency with Inverse Document Frequency to assess word importance across documents.&lt;SEP&gt;TF-IDF (Term Frequency-Inverse Document Frequency) is a numerical statistic reflecting word importance used for weighting features in text mining and summarization.&lt;SEP&gt;TF-IDF (Term Frequency-Inverse Document Frequency) is a numerical weighting scheme used to evaluate the relative importance of words within a document collection.&lt;SEP&gt;TF-IDF is an information retrieval and statistical weighting method evaluated among the combined models for cross-platform profile matching, ranking second behind the confusion model.&lt;SEP&gt;Term Frequency-Inverse Document Frequency is a numerical text representation and weighting technique that offsets the frequency of common words against document-wide rarity.</data>
      <data key="d3">chunk-9d061db4b0ef06b5f3c1d715a602dc1d&lt;SEP&gt;chunk-9539a4c4fcbd235bc0ccbc8f3fd26a81&lt;SEP&gt;chunk-f72431d36a16227ea7d1db8d40a9ca21&lt;SEP&gt;chunk-22ae1796dede39736a6ce61ec4cb1e2e&lt;SEP&gt;chunk-bc72a8696f96f81ea7b13e31bd1a5bbb</data>
    </node>
    <node id="ROUGE">
      <data key="d0">ROUGE</data>
      <data key="d1">category</data>
      <data key="d2">A category of automated text evaluation metric commonly applied to summarization and generation tasks.&lt;SEP&gt;ROUGE (Recall-Oriented Understudy for Gisting Evaluation) is a set of standard evaluation metrics used to measure summary quality against reference summaries.&lt;SEP&gt;ROUGE is a standard automated metric suite used to evaluate the quality of text summarization by comparing generated summaries against reference summaries.&lt;SEP&gt;ROUGE is an evaluation metric based on n-gram overlap used to assess headline generation and text summarization performance.</data>
      <data key="d3">chunk-3d0d62f131549ff6e8a1545f667c733a&lt;SEP&gt;chunk-ad4815afd1a11fd7bc1c72c7da255e9c&lt;SEP&gt;chunk-22ae1796dede39736a6ce61ec4cb1e2e&lt;SEP&gt;chunk-9d061db4b0ef06b5f3c1d715a602dc1d</data>
    </node>
    <node id="KL-Divergence">
      <data key="d0">KL-Divergence</data>
      <data key="d1">category</data>
      <data key="d2">Kullback-Leibler divergence is a statistical measure of distance between probability distributions used by summary-level summarization approaches to optimize summary content.</data>
      <data key="d3">chunk-9d061db4b0ef06b5f3c1d715a602dc1d</data>
    </node>
    <node id="Submodular Functions">
      <data key="d0">Submodular Functions</data>
      <data key="d1">category</data>
      <data key="d2">Submodular functions are mathematical set functions that model concepts such as coverage and diversity in summary-level extractive document summarization.</data>
      <data key="d3">chunk-9d061db4b0ef06b5f3c1d715a602dc1d</data>
    </node>
    <node id="Anti-Redundancy Filter">
      <data key="d0">Anti-Redundancy Filter</data>
      <data key="d1">category</data>
      <data key="d2">An Anti-Redundancy Filter is a component in text summarization pipelines designed to suppress redundant sentences and prevent repetitive information.&lt;SEP&gt;An Anti-Redundancy Filter is a summarization component used to prevent candidate summaries from including repetitive information.&lt;SEP&gt;An anti-redundancy filter is a mechanism used in extractive summarization pipelines to prevent redundant or overly similar sentences from entering the final summary.</data>
      <data key="d3">chunk-10a2790542b2adb7f0c75f7dd7c8afd2&lt;SEP&gt;chunk-22ae1796dede39736a6ce61ec4cb1e2e&lt;SEP&gt;chunk-9d061db4b0ef06b5f3c1d715a602dc1d</data>
    </node>
    <node id="Google Analogy Task">
      <data key="d0">Google Analogy Task</data>
      <data key="d1">event</data>
      <data key="d2">The Google analogy task is an evaluation benchmark developed to assess the semantic and syntactic linguistic relationships captured by word and character-level models.</data>
      <data key="d3">chunk-9d061db4b0ef06b5f3c1d715a602dc1d</data>
    </node>
    <node id="Document Understanding Conference">
      <data key="d0">Document Understanding Conference</data>
      <data key="d1">event</data>
      <data key="d2">The Document Understanding Conference (DUC) is an evaluation conference series focused on text summarization and information extraction systems.</data>
      <data key="d3">chunk-10a2790542b2adb7f0c75f7dd7c8afd2</data>
    </node>
    <node id="DUC2004 Task 2">
      <data key="d0">DUC2004 Task 2</data>
      <data key="d1">event</data>
      <data key="d2">DUC2004 Task 2 is a specific multi-document summarization evaluation task and dataset featured at the Document Understanding Conference.</data>
      <data key="d3">chunk-10a2790542b2adb7f0c75f7dd7c8afd2</data>
    </node>
    <node id="CNN">
      <data key="d0">CNN</data>
      <data key="d1">category</data>
      <data key="d2">A class of neural network architectures designed to recognize spatial patterns, adaptable to text processing.&lt;SEP&gt;A convolutional neural network text classification architecture used to segment and assign zone labels to obituary sentences.&lt;SEP&gt;CNN is a convolutional neural network baseline model evaluated on the relation classification task.&lt;SEP&gt;CNN is a major news media organization whose articles, along with the Daily Mail, form a benchmark reading comprehension dataset.&lt;SEP&gt;CNN is a major news organization whose published articles are utilized to build multi-document summarization clusters for evaluation.&lt;SEP&gt;Convolutional Neural Network (CNN) is a deep learning architecture used as a sentence encoder in relation extraction.&lt;SEP&gt;Convolutional Neural Network architecture evaluated in neural relation extraction experiments for mitigating bias.</data>
      <data key="d3">chunk-10a2790542b2adb7f0c75f7dd7c8afd2&lt;SEP&gt;chunk-ef7b95a2f35faad97942f87543b7ab1f&lt;SEP&gt;chunk-bdef2f67b0ab332d8da79c41fb0e58c7&lt;SEP&gt;chunk-6b6907deaed642269724a32b0c9ccd9f&lt;SEP&gt;chunk-8b74404709f6b49b2bef33ca7f921e55&lt;SEP&gt;chunk-be334478ba316675f89bc24ce6e3c03a&lt;SEP&gt;chunk-806c5b143029efcdf6de258a039af615</data>
    </node>
    <node id="Daily Mail">
      <data key="d0">Daily Mail</data>
      <data key="d1">organization</data>
      <data key="d2">Daily Mail is a British news outlet whose published articles are utilized to construct reading comprehension datasets for machine learning benchmarks.&lt;SEP&gt;Daily Mail is a British newspaper and news organization whose content forms part of the CNN/Daily Mail benchmark dataset.</data>
      <data key="d3">chunk-10a2790542b2adb7f0c75f7dd7c8afd2&lt;SEP&gt;chunk-bdef2f67b0ab332d8da79c41fb0e58c7</data>
    </node>
    <node id="CNN/Daily Mail Dataset">
      <data key="d0">CNN/Daily Mail Dataset</data>
      <data key="d1">category</data>
      <data key="d2">The CNN/Daily Mail dataset is a machine reading comprehension benchmark consisting of document-query-answer triples where target entities are masked with placeholders.&lt;SEP&gt;The CNN/Daily Mail dataset is a natural language processing benchmark containing news stories and bullet-point summaries used for tuning summarization models.</data>
      <data key="d3">chunk-10a2790542b2adb7f0c75f7dd7c8afd2&lt;SEP&gt;chunk-bdef2f67b0ab332d8da79c41fb0e58c7</data>
    </node>
    <node id="SumRepo">
      <data key="d0">SumRepo</data>
      <data key="d1">category</data>
      <data key="d2">SumRepo is a benchmark repository and evaluation framework containing collections of generated summaries and baselines for multi-document summarization.&lt;SEP&gt;SumRepo is an open repository of text summaries generated by baseline and state-of-the-art models on the DUC2004 dataset.</data>
      <data key="d3">chunk-10a2790542b2adb7f0c75f7dd7c8afd2&lt;SEP&gt;chunk-22ae1796dede39736a6ce61ec4cb1e2e</data>
    </node>
    <node id="Centroid Model">
      <data key="d0">Centroid Model</data>
      <data key="d1">category</data>
      <data key="d2">The Centroid Model is an extractive multi-document summarization approach that scores and selects sentences based on their similarity to a central pseudo-document vector.</data>
      <data key="d3">chunk-10a2790542b2adb7f0c75f7dd7c8afd2</data>
    </node>
    <node id="KLSum Model">
      <data key="d0">KLSum Model</data>
      <data key="d1">category</data>
      <data key="d2">The KLSum model is a sentence extraction summarization method that minimizes the Kullback-Leibler divergence between input and summary word distributions using a greedy algorithm.</data>
      <data key="d3">chunk-10a2790542b2adb7f0c75f7dd7c8afd2</data>
    </node>
    <node id="DPP Model">
      <data key="d0">DPP Model</data>
      <data key="d1">category</data>
      <data key="d2">Determinantal Point Processes (DPP) is a probabilistic model class used in multi-document summarization that balances quality and diversity.&lt;SEP&gt;The Determinantal Point Processes (DPP) model is a state-of-the-art summarization baseline that models diversity and quality for sentence selection.</data>
      <data key="d3">chunk-10a2790542b2adb7f0c75f7dd7c8afd2&lt;SEP&gt;chunk-22ae1796dede39736a6ce61ec4cb1e2e</data>
    </node>
    <node id="Rouge">
      <data key="d0">Rouge</data>
      <data key="d1">category</data>
      <data key="d2">ROUGE is a standard evaluation metric suite and toolkit used to measure the overlap and recall of n-grams between candidate summaries and reference summaries.</data>
      <data key="d3">chunk-10a2790542b2adb7f0c75f7dd7c8afd2</data>
    </node>
    <node id="Global Centroid Model">
      <data key="d0">Global Centroid Model</data>
      <data key="d1">category</data>
      <data key="d2">The Global Centroid Model is an extractive summarization variant that models sentence selection as finding an optimal collective combination of sentences matching a centroid representation rather than ranking sentences individually.</data>
      <data key="d3">chunk-10a2790542b2adb7f0c75f7dd7c8afd2</data>
    </node>
    <node id="Greedy Sentence Selection Algorithm">
      <data key="d0">Greedy Sentence Selection Algorithm</data>
      <data key="d1">category</data>
      <data key="d2">The Greedy Sentence Selection Algorithm is an iterative heuristic algorithm that builds a summary incrementally by adding the sentence that maximizes similarity to the target centroid vector or objective function.</data>
      <data key="d3">chunk-10a2790542b2adb7f0c75f7dd7c8afd2</data>
    </node>
    <node id="New-TF-IDF Preselection">
      <data key="d0">New-TF-IDF Preselection</data>
      <data key="d1">category</data>
      <data key="d2">New-TF-IDF Preselection is a candidate reduction method that scores sentences by summing the TF-IDF scores of terms introduced for the first time in a document to surface novel information.</data>
      <data key="d3">chunk-10a2790542b2adb7f0c75f7dd7c8afd2</data>
    </node>
    <node id="N-First Preselection">
      <data key="d0">N-First Preselection</data>
      <data key="d1">category</data>
      <data key="d2">N-First Preselection is a candidate selection method that takes the leading N sentences of a document, combining a lead-baseline approach with centroid-based selection.</data>
      <data key="d3">chunk-10a2790542b2adb7f0c75f7dd7c8afd2</data>
    </node>
    <node id="N-Best Preselection">
      <data key="d0">N-Best Preselection</data>
      <data key="d1">category</data>
      <data key="d2">N-Best Preselection is a candidate reduction method that ranks sentences within each document by cosine similarity to the centroid vector and keeps the top scoring sentences.</data>
      <data key="d3">chunk-10a2790542b2adb7f0c75f7dd7c8afd2</data>
    </node>
    <node id="Document Retrieval">
      <data key="d0">Document Retrieval</data>
      <data key="d1">category</data>
      <data key="d2">Document Retrieval refers to the process of finding and returning relevant documents from a collection, such as top-100 search results, which require efficient summarization techniques.</data>
      <data key="d3">chunk-10a2790542b2adb7f0c75f7dd7c8afd2</data>
    </node>
    <node id="Rouge-1">
      <data key="d0">Rouge-1</data>
      <data key="d1">category</data>
      <data key="d2">Rouge-1 is an n-gram overlap recall evaluation metric that measures the proportion of unigrams in reference summaries captured by candidate summaries.</data>
      <data key="d3">chunk-10a2790542b2adb7f0c75f7dd7c8afd2</data>
    </node>
    <node id="Rouge-2">
      <data key="d0">Rouge-2</data>
      <data key="d1">category</data>
      <data key="d2">Rouge-2 is an evaluation metric that measures the proportion of matching bigrams between reference summaries and candidate summaries.</data>
      <data key="d3">chunk-10a2790542b2adb7f0c75f7dd7c8afd2</data>
    </node>
    <node id="Rouge-4">
      <data key="d0">Rouge-4</data>
      <data key="d1">category</data>
      <data key="d2">Rouge-4 is an evaluation metric assessing 4-gram overlap between candidate and reference summaries.</data>
      <data key="d3">chunk-10a2790542b2adb7f0c75f7dd7c8afd2</data>
    </node>
    <node id="ICSI">
      <data key="d0">ICSI</data>
      <data key="d1">organization</data>
      <data key="d2">The International Computer Science Institute (ICSI) is a research institute whose summarization system serves as a baseline standard in multi-document summarization evaluations.</data>
      <data key="d3">chunk-22ae1796dede39736a6ce61ec4cb1e2e</data>
    </node>
    <node id="The Lancet">
      <data key="d0">The Lancet</data>
      <data key="d1">organization</data>
      <data key="d2">A prominent weekly peer-reviewed general medical journal that reports on global health issues, including diet-related diseases and mortality.&lt;SEP&gt;The Lancet is a prominent medical journal that publishes research on global health, dietary habits, and diet-related diseases and mortality.</data>
      <data key="d3">chunk-e6482c4aa158143b58b33b61435191e0&lt;SEP&gt;chunk-22ae1796dede39736a6ce61ec4cb1e2e</data>
    </node>
    <node id="Recipe Retrieval">
      <data key="d0">Recipe Retrieval</data>
      <data key="d1">category</data>
      <data key="d2">A cross-modal computational task focusing on matching or retrieving textual recipes and ingredients corresponding to meal images.&lt;SEP&gt;Recipe Retrieval is a cross-modal information retrieval task where queries such as food images are matched against recipe texts in a shared latent embedding space.&lt;SEP&gt;Recipe Retrieval is a multimodal task in artificial intelligence involving finding relevant recipes and cooking instructions from food image queries.</data>
      <data key="d3">chunk-e6482c4aa158143b58b33b61435191e0&lt;SEP&gt;chunk-22ae1796dede39736a6ce61ec4cb1e2e&lt;SEP&gt;chunk-f0f9c89ffb57d88b6a05fbcd7d909d7d</data>
    </node>
    <node id="Nutrition Assessment">
      <data key="d0">Nutrition Assessment</data>
      <data key="d1">category</data>
      <data key="d2">Nutrition Assessment is the evaluation and estimation of nutrient content in meals to manage health and prevent diet-related diseases.&lt;SEP&gt;The process of estimating and evaluating the nutrient intake and content of meals to support health and dietary management.</data>
      <data key="d3">chunk-e6482c4aa158143b58b33b61435191e0&lt;SEP&gt;chunk-22ae1796dede39736a6ce61ec4cb1e2e</data>
    </node>
    <node id="Centroid-Based Summarization">
      <data key="d0">Centroid-Based Summarization</data>
      <data key="d1">category</data>
      <data key="d2">Centroid-Based Summarization is an extractive summarization method that ranks sentences based on their similarity to a central pseudo-document vector or centroid.</data>
      <data key="d3">chunk-22ae1796dede39736a6ce61ec4cb1e2e</data>
    </node>
    <node id="Global Optimization">
      <data key="d0">Global Optimization</data>
      <data key="d1">category</data>
      <data key="d2">Global Optimization in summarization refers to sentence selection strategies that evaluate candidate summaries as a collective whole rather than via independent sentence ranking.</data>
      <data key="d3">chunk-22ae1796dede39736a6ce61ec4cb1e2e</data>
    </node>
    <node id="Sentence Preselection">
      <data key="d0">Sentence Preselection</data>
      <data key="d1">category</data>
      <data key="d2">Sentence Preselection refers to filtering and restricting the initial pool of candidate sentences per document prior to global summary optimization.</data>
      <data key="d3">chunk-22ae1796dede39736a6ce61ec4cb1e2e</data>
    </node>
    <node id="KL-Divergence Method">
      <data key="d0">KL-Divergence Method</data>
      <data key="d1">category</data>
      <data key="d2">The KL-Divergence Method is an extractive summarization approach that optimizes summaries by minimizing Kullback-Leibler divergence between summary and source document distributions.</data>
      <data key="d3">chunk-22ae1796dede39736a6ce61ec4cb1e2e</data>
    </node>
    <node id="Recipe1M">
      <data key="d0">Recipe1M</data>
      <data key="d1">category</data>
      <data key="d2">Recipe1M is a large-scale multimodal dataset comprising over one million structured recipes and thirteen million meal images.&lt;SEP&gt;Recipe1M is a large-scale multimodal dataset comprising recipes and food images, partitioned into training, validation, and test sets for cross-modal retrieval benchmarks.</data>
      <data key="d3">chunk-22ae1796dede39736a6ce61ec4cb1e2e&lt;SEP&gt;chunk-f0f9c89ffb57d88b6a05fbcd7d909d7d</data>
    </node>
    <node id="Self-Attention">
      <data key="d0">Self-Attention</data>
      <data key="d1">category</data>
      <data key="d2">A category of attention mechanisms that computes representations of a sequence by relating different positions within the same sequence.&lt;SEP&gt;An attention mechanism applied across all column headers to capture structural relationships such as foreign keys within a database schema.&lt;SEP&gt;Self-Attention is an attention mechanism that models dependencies between all positions within a single sequence, used here to encode raw recipe texts directly.</data>
      <data key="d3">chunk-e3bc49e88e2b4d9c426436c1d272e949&lt;SEP&gt;chunk-56c893ccea72c9785303bae311f29c7b&lt;SEP&gt;chunk-22ae1796dede39736a6ce61ec4cb1e2e</data>
    </node>
    <node id="Ingredient Attention">
      <data key="d0">Ingredient Attention</data>
      <data key="d1">category</data>
      <data key="d2">Ingredient Attention is a specialized neural attention mechanism designed to align recipe instructions and preparation steps with individual recipe ingredients.&lt;SEP&gt;Ingredient Attention is an attention-based mechanism applied to instruction representations to project ingredient queries into a shared latent space.</data>
      <data key="d3">chunk-22ae1796dede39736a6ce61ec4cb1e2e&lt;SEP&gt;chunk-f0f9c89ffb57d88b6a05fbcd7d909d7d</data>
    </node>
    <node id="Diet-Related Diseases">
      <data key="d0">Diet-Related Diseases</data>
      <data key="d1">category</data>
      <data key="d2">A classification of health disorders, such as diabetes, linked to global eating behaviors and nutritional imbalances.&lt;SEP&gt;Diet-Related Diseases refers to adverse health conditions, such as cardiovascular diseases or malnutrition, caused by poor dietary and eating habits.</data>
      <data key="d3">chunk-e6482c4aa158143b58b33b61435191e0&lt;SEP&gt;chunk-22ae1796dede39736a6ce61ec4cb1e2e</data>
    </node>
    <node id="Social Media">
      <data key="d0">Social Media</data>
      <data key="d1">category</data>
      <data key="d2">Online platforms and communication channels where users report daily activities, express identities, and share content.&lt;SEP&gt;Online platforms and communication channels whose textual corpora were mined to detect drug mentions in the Drugs-Safe project.&lt;SEP&gt;Social Media encompasses online platforms where users share food culture, meals, and recipes at large scale.&lt;SEP&gt;Social Media is a category of digital communication platforms, including Twitter and Facebook, where user language and thematic focus vary.&lt;SEP&gt;Social media encompasses digitized online communication platforms where user-generated content, news, and multimodal media are broadcast at scale.</data>
      <data key="d3">chunk-ec629d6b4012dc860d6ce7b45913df22&lt;SEP&gt;chunk-9539a4c4fcbd235bc0ccbc8f3fd26a81&lt;SEP&gt;chunk-22ae1796dede39736a6ce61ec4cb1e2e&lt;SEP&gt;chunk-b0d30e05ac4755125277651156c72d63&lt;SEP&gt;chunk-261a6f8ccfb17ebb9be72e74900d0a04</data>
    </node>
    <node id="Online Cooking Platforms">
      <data key="d0">Online Cooking Platforms</data>
      <data key="d1">category</data>
      <data key="d2">Online Cooking Platforms are dedicated digital recipe-sharing repositories and communities that generate vast amounts of culinary and dietary data.</data>
      <data key="d3">chunk-22ae1796dede39736a6ce61ec4cb1e2e</data>
    </node>
    <node id="Bossard">
      <data key="d0">Bossard</data>
      <data key="d1">person</data>
      <data key="d2">A researcher who, along with colleagues, introduced the Food-101 dataset for food recognition.</data>
      <data key="d3">chunk-e6482c4aa158143b58b33b61435191e0</data>
    </node>
    <node id="Wang">
      <data key="d0">Wang</data>
      <data key="d1">person</data>
      <data key="d2">A researcher who introduced the UPMC Food-101 multi-modal dataset that combines image data with textual information.</data>
      <data key="d3">chunk-e6482c4aa158143b58b33b61435191e0</data>
    </node>
    <node id="Salvador">
      <data key="d0">Salvador</data>
      <data key="d1">person</data>
      <data key="d2">A researcher who published the Recipe1M multi-modal dataset and proposed joint learning methods for recipe-text and image representations.</data>
      <data key="d3">chunk-e6482c4aa158143b58b33b61435191e0</data>
    </node>
    <node id="Carvalho">
      <data key="d0">Carvalho</data>
      <data key="d1">person</data>
      <data key="d2">A researcher who proposed a multi-modal embedding method aligning text and image representations in a shared latent space using a joint objective function.</data>
      <data key="d3">chunk-e6482c4aa158143b58b33b61435191e0</data>
    </node>
    <node id="Pittsburgh">
      <data key="d0">Pittsburgh</data>
      <data key="d1">geo</data>
      <data key="d2">A city in Pennsylvania whose bus transit information served as the operational domain for the Let’s Go spoken dialogue project.&lt;SEP&gt;A city in the United States associated with the Pittsburgh Fast-Food Image Dataset (PFID).</data>
      <data key="d3">chunk-e6482c4aa158143b58b33b61435191e0&lt;SEP&gt;chunk-fe97dad1ad4e2f85cc4ac8cf6a70fd65</data>
    </node>
    <node id="Food Recognition">
      <data key="d0">Food Recognition</data>
      <data key="d1">category</data>
      <data key="d2">A computer vision and machine learning domain focused on detecting, categorizing, and estimating properties of food from meal images.</data>
      <data key="d3">chunk-e6482c4aa158143b58b33b61435191e0</data>
    </node>
    <node id="UPMC">
      <data key="d0">UPMC</data>
      <data key="d1">organization</data>
      <data key="d2">An academic and research institution associated with the compilation and release of the UPMC Food-101 multi-modal dataset.</data>
      <data key="d3">chunk-e6482c4aa158143b58b33b61435191e0</data>
    </node>
    <node id="Japan">
      <data key="d0">Japan</data>
      <data key="d1">geo</data>
      <data key="d2">An East Asian country whose distinctive food items and culinary types are represented in specialized food datasets like UEC-100 and UEC-256.</data>
      <data key="d3">chunk-e6482c4aa158143b58b33b61435191e0</data>
    </node>
    <node id="Diabetes">
      <data key="d0">Diabetes</data>
      <data key="d1">category</data>
      <data key="d2">A chronic metabolic diet-related disease mentioned as an explicit condition that automated nutrition assessment tools can support.</data>
      <data key="d3">chunk-e6482c4aa158143b58b33b61435191e0</data>
    </node>
    <node id="Multi-Modal Learning">
      <data key="d0">Multi-Modal Learning</data>
      <data key="d1">category</data>
      <data key="d2">An artificial intelligence paradigm that jointly processes and aligns disparate data modalities, such as visual images and textual recipe instructions, in a shared latent space.</data>
      <data key="d3">chunk-e6482c4aa158143b58b33b61435191e0</data>
    </node>
    <node id="Fast Food">
      <data key="d0">Fast Food</data>
      <data key="d1">category</data>
      <data key="d2">A meal category characterized by quick preparation and convenience, specifically cataloged in the Pittsburgh Fast-Food Image Dataset.</data>
      <data key="d3">chunk-e6482c4aa158143b58b33b61435191e0</data>
    </node>
    <node id="Japanese Food">
      <data key="d0">Japanese Food</data>
      <data key="d1">category</data>
      <data key="d2">A regional cuisine category comprising specific food varieties cataloged in the UEC-100 and UEC-256 datasets.</data>
      <data key="d3">chunk-e6482c4aa158143b58b33b61435191e0</data>
    </node>
    <node id="Meal Classes">
      <data key="d0">Meal Classes</data>
      <data key="d1">category</data>
      <data key="d2">A category of 1,048 semantic classifications assigned to recipes in the Recipe1M dataset to inject additional semantic information into the predictive models.</data>
      <data key="d3">chunk-e3bc49e88e2b4d9c426436c1d272e949</data>
    </node>
    <node id="Input Data Types">
      <data key="d0">Input Data Types</data>
      <data key="d1">category</data>
      <data key="d2">The distinct modalities and categories of data used in the multi-path model architecture, comprising recipe instructions, ingredients, and images.</data>
      <data key="d3">chunk-e3bc49e88e2b4d9c426436c1d272e949</data>
    </node>
    <node id="Attention Mechanisms">
      <data key="d0">Attention Mechanisms</data>
      <data key="d1">category</data>
      <data key="d2">A category of neural architectural mechanisms utilized in the proposed model, including self-attention and ingredient-attention, to focus on relevant text components.</data>
      <data key="d3">chunk-e3bc49e88e2b4d9c426436c1d272e949</data>
    </node>
    <node id="Multi-Modal Food Database">
      <data key="d0">Multi-Modal Food Database</data>
      <data key="d1">category</data>
      <data key="d2">A category of culinary datasets that combine text data such as ingredients and instructions with visual image data, exemplified by Recipe1M.</data>
      <data key="d3">chunk-e3bc49e88e2b4d9c426436c1d272e949</data>
    </node>
    <node id="ImageNet">
      <data key="d0">ImageNet</data>
      <data key="d1">organization</data>
      <data key="d2">The research organization and initiative behind the ImageNet visual database, widely used for benchmarking and pretraining computer vision models.</data>
      <data key="d3">chunk-e3bc49e88e2b4d9c426436c1d272e949</data>
    </node>
    <node id="Joint Embedding Learning Phase">
      <data key="d0">Joint Embedding Learning Phase</data>
      <data key="d1">event</data>
      <data key="d2">The computational training phase during which word embeddings are fine-tuned and text-image representations are aligned in a shared embedding space.</data>
      <data key="d3">chunk-e3bc49e88e2b4d9c426436c1d272e949</data>
    </node>
    <node id="Convolutional Neural Networks">
      <data key="d0">Convolutional Neural Networks</data>
      <data key="d1">category</data>
      <data key="d2">A category of deep learning architectures evaluated as baseline encoders (charCNN) for building word representations from character inputs.&lt;SEP&gt;A category of deep neural network architectures commonly used for computer vision and hierarchical dimensionality reduction.&lt;SEP&gt;A class of deep neural networks used as state-of-the-art models for dialogue state tracking to generalize from annotated dialogues.&lt;SEP&gt;A class of neural network architectures adapted for spatial pattern recognition and sentence-level text classification, including TextCNN models.&lt;SEP&gt;A deep learning architecture applied to extract subword and character-level features to improve neural language models.&lt;SEP&gt;A deep learning architecture previously applied in literature to construct word embeddings from character embeddings.&lt;SEP&gt;Convolutional Neural Networks (CNNs) are a category of deep learning models utilizing convolutional layers, applied in NLP for aspect extraction and sentiment classification.&lt;SEP&gt;Convolutional neural networks (CNNs) are a category of neural networks utilizing sliding filters, applied to NLP tasks through window-based and multi-task models.&lt;SEP&gt;Deep learning architectures (CNNs) widely adopted for text processing and sentiment analysis prior to transformer-based models.</data>
      <data key="d3">chunk-1ca9fdc4a98dc4d2c8f6875739e4d466&lt;SEP&gt;chunk-f148e57eed21f7948ba04d2d12e56d0d&lt;SEP&gt;chunk-785a16b34b0c74a5ee4f9f416976a683&lt;SEP&gt;chunk-37ae86766195404daaa0c376964357ce&lt;SEP&gt;chunk-e759311c40b86a32804c73d3e9508819&lt;SEP&gt;chunk-3e6c6ba3246066dafb17ed3cbf673534&lt;SEP&gt;chunk-e3bc49e88e2b4d9c426436c1d272e949&lt;SEP&gt;chunk-47f43d3218257ab88ccde621eadece2c&lt;SEP&gt;chunk-236f5016d3aa81277cabc5c947f1ca64</data>
    </node>
    <node id="Transformer-Based Encoder">
      <data key="d0">Transformer-Based Encoder</data>
      <data key="d1">category</data>
      <data key="d2">A category of neural network architectures based on self-attention and feed-forward sub-layers, used without recurrent units to encode recipe instructions efficiently.</data>
      <data key="d3">chunk-e3bc49e88e2b4d9c426436c1d272e949</data>
    </node>
    <node id="ResNet-50">
      <data key="d0">ResNet-50</data>
      <data key="d1">category</data>
      <data key="d2">A deep residual convolutional neural network architecture pretrained on ImageNet and adapted to encode recipe image features.&lt;SEP&gt;ResNet-50 is a deep convolutional neural network architecture whose pretrained weights are used as an image feature extraction backbone.</data>
      <data key="d3">chunk-e3bc49e88e2b4d9c426436c1d272e949&lt;SEP&gt;chunk-f0f9c89ffb57d88b6a05fbcd7d909d7d</data>
    </node>
    <node id="Multi-Head Attention">
      <data key="d0">Multi-Head Attention</data>
      <data key="d1">category</data>
      <data key="d2">A category of attention layers that computes multiple attention representations in parallel, forming a core sub-layer of transformer models.&lt;SEP&gt;An attention mechanism in neural network architectures whose layers are visualized during English-to-Setswana translation.</data>
      <data key="d3">chunk-e3bc49e88e2b4d9c426436c1d272e949&lt;SEP&gt;chunk-aa0a1d40aed971d10ad0f0f2c4938cf4</data>
    </node>
    <node id="Joint Embedding Space">
      <data key="d0">Joint Embedding Space</data>
      <data key="d1">category</data>
      <data key="d2">A unified geometric representation space where multimodal features from instructions, ingredients, and images are mapped and aligned.</data>
      <data key="d3">chunk-e3bc49e88e2b4d9c426436c1d272e949</data>
    </node>
    <node id="Convolution Neural Networks">
      <data key="d0">Convolution Neural Networks</data>
      <data key="d1">category</data>
      <data key="d2">Convolution Neural Networks are a class of deep neural networks commonly applied in visual processing and known for step-wise dimensionality reduction.</data>
      <data key="d3">chunk-f0f9c89ffb57d88b6a05fbcd7d909d7d</data>
    </node>
    <node id="Triplet Loss">
      <data key="d0">Triplet Loss</data>
      <data key="d1">category</data>
      <data key="d2">Triplet Loss is an objective function that optimizes embeddings by penalizing non-matching counterparts beyond a specified margin and enforcing semantic clustering.</data>
      <data key="d3">chunk-f0f9c89ffb57d88b6a05fbcd7d909d7d</data>
    </node>
    <node id="Cosine Similarity Loss">
      <data key="d0">Cosine Similarity Loss</data>
      <data key="d1">category</data>
      <data key="d2">Cosine Similarity Loss is a margin-based objective function used to align text and image embeddings by maximizing similarity for positive pairs and minimizing it for negative pairs.</data>
      <data key="d3">chunk-f0f9c89ffb57d88b6a05fbcd7d909d7d</data>
    </node>
    <node id="Skip-Thought">
      <data key="d0">Skip-Thought</data>
      <data key="d1">category</data>
      <data key="d2">Skip-Thought is a sentence embedding technique utilized for instruction text preprocessing in baseline multimodal models.</data>
      <data key="d3">chunk-f0f9c89ffb57d88b6a05fbcd7d909d7d</data>
    </node>
    <node id="Cross-Entropy Classification Loss">
      <data key="d0">Cross-Entropy Classification Loss</data>
      <data key="d1">category</data>
      <data key="d2">Cross-Entropy Classification Loss is a regularization loss function combined with cosine similarity loss to preserve semantic recipe and image classes.</data>
      <data key="d3">chunk-f0f9c89ffb57d88b6a05fbcd7d909d7d</data>
    </node>
    <node id="Semantic Regularization">
      <data key="d0">Semantic Regularization</data>
      <data key="d1">category</data>
      <data key="d2">Semantic Regularization is a machine learning objective aimed at maximizing intra-class correlation and minimizing inter-class correlation across food classes.</data>
      <data key="d3">chunk-f0f9c89ffb57d88b6a05fbcd7d909d7d</data>
    </node>
    <node id="Shared Latent Space">
      <data key="d0">Shared Latent Space</data>
      <data key="d1">category</data>
      <data key="d2">Shared Latent Space is a joint multidimensional vector space where text and image representations are mapped and compared via distance metrics.</data>
      <data key="d3">chunk-f0f9c89ffb57d88b6a05fbcd7d909d7d</data>
    </node>
    <node id="Exponential Decay">
      <data key="d0">Exponential Decay</data>
      <data key="d1">category</data>
      <data key="d2">Exponential Decay is a learning rate scheduling technique used to halve the optimization learning rate every 20 epochs.</data>
      <data key="d3">chunk-f0f9c89ffb57d88b6a05fbcd7d909d7d</data>
    </node>
    <node id="Median Rank">
      <data key="d0">Median Rank</data>
      <data key="d1">category</data>
      <data key="d2">Median Rank is an information retrieval evaluation metric measuring the median ranking position of the ground-truth text match against candidate embeddings.</data>
      <data key="d3">chunk-f0f9c89ffb57d88b6a05fbcd7d909d7d</data>
    </node>
    <node id="Recall At K">
      <data key="d0">Recall At K</data>
      <data key="d1">category</data>
      <data key="d2">Recall At K is a retrieval evaluation metric calculating the percentage of queries where the correct match falls within the top K ranked results.</data>
      <data key="d3">chunk-f0f9c89ffb57d88b6a05fbcd7d909d7d</data>
    </node>
    <node id="Nvidia">
      <data key="d0">Nvidia</data>
      <data key="d1">organization</data>
      <data key="d2">A technology company that produces computing hardware, specifically the Titan X GPUs referenced in the training of recipe retrieval models.</data>
      <data key="d3">chunk-a79abb072d9fc8246078d8f3178dd255</data>
    </node>
    <node id="The Daily Item">
      <data key="d0">The Daily Item</data>
      <data key="d1">organization</data>
      <data key="d2">A US-based publication source from which 475 obituaries were gathered for the dataset.&lt;SEP&gt;A news website and publication based in the USA that hosts and publishes obituaries.&lt;SEP&gt;A newspaper publication from which English obituaries were sourced to construct a research corpus for section recognition.</data>
      <data key="d3">chunk-9645cad08b5b060013cac117d156f888&lt;SEP&gt;chunk-7217bed1354c5a8751d3eab9cd978cbd&lt;SEP&gt;chunk-a79abb072d9fc8246078d8f3178dd255</data>
    </node>
    <node id="The London Free Press">
      <data key="d0">The London Free Press</data>
      <data key="d1">organization</data>
      <data key="d2">A UK-associated publication providing 88 obituaries used in the text classification dataset.&lt;SEP&gt;A newspaper publication utilized as a source of English obituaries for text segmentation and digital humanities research.&lt;SEP&gt;A regional news publication and dedicated website that publishes obituaries from London.</data>
      <data key="d3">chunk-9645cad08b5b060013cac117d156f888&lt;SEP&gt;chunk-7217bed1354c5a8751d3eab9cd978cbd&lt;SEP&gt;chunk-a79abb072d9fc8246078d8f3178dd255</data>
    </node>
    <node id="Digital Humanities">
      <data key="d0">Digital Humanities</data>
      <data key="d1">category</data>
      <data key="d2">An academic field of study that utilizes computational methods to analyze cultural history and humanistic materials, such as historical obituaries.</data>
      <data key="d3">chunk-a79abb072d9fc8246078d8f3178dd255</data>
    </node>
    <node id="Personal Information">
      <data key="d0">Personal Information</data>
      <data key="d1">category</data>
      <data key="d2">A category in obituary annotation identifying demographic and personal facts about the deceased.&lt;SEP&gt;A sentence-level annotation class identifying introductory details in an obituary such as the name, age, cause, and date of death.&lt;SEP&gt;A structural section category within obituaries identifying factual personal details about the deceased.&lt;SEP&gt;An annotation category addressing personal details of the deceased within the obituary structure.&lt;SEP&gt;Personal Information is a structural zoning section in obituaries containing details such as names, birth dates, dates of death, and causes of death.&lt;SEP&gt;Personal Information is an obituary classification category that covers personal facts and details about the deceased.</data>
      <data key="d3">chunk-7217bed1354c5a8751d3eab9cd978cbd&lt;SEP&gt;chunk-9a42d2500d95a11dc6c778a73c5dba9c&lt;SEP&gt;chunk-be334478ba316675f89bc24ce6e3c03a&lt;SEP&gt;chunk-cd215c830f4336951c05421c32e7aed1&lt;SEP&gt;chunk-a79abb072d9fc8246078d8f3178dd255&lt;SEP&gt;chunk-9645cad08b5b060013cac117d156f888</data>
    </node>
    <node id="Biographical Sketch">
      <data key="d0">Biographical Sketch</data>
      <data key="d1">category</data>
      <data key="d2">A category in obituary zoning describing the life story, career, and milestones of the deceased.&lt;SEP&gt;A structural section category within obituaries detailing the life story, achievements, and anecdotes of the deceased person.&lt;SEP&gt;An annotation category identifying sentences detailing life events, milestones such as weddings, and biographical narratives.&lt;SEP&gt;An annotation class capturing a deceased person's life history, including birth details, residence, education, marriage, and occupations.&lt;SEP&gt;Biographical Sketch is an obituary classification category capturing narrative information and historical details of the deceased's life.&lt;SEP&gt;Biographical Sketch is an obituary section category that summarizes the life history, career, and achievements of the deceased.</data>
      <data key="d3">chunk-7217bed1354c5a8751d3eab9cd978cbd&lt;SEP&gt;chunk-9a42d2500d95a11dc6c778a73c5dba9c&lt;SEP&gt;chunk-be334478ba316675f89bc24ce6e3c03a&lt;SEP&gt;chunk-cd215c830f4336951c05421c32e7aed1&lt;SEP&gt;chunk-a79abb072d9fc8246078d8f3178dd255&lt;SEP&gt;chunk-9645cad08b5b060013cac117d156f888</data>
    </node>
    <node id="Characteristics">
      <data key="d0">Characteristics</data>
      <data key="d1">category</data>
      <data key="d2">A structural section category in obituaries highlighting the personal traits, values, and qualities of the deceased.&lt;SEP&gt;An annotation category identifying sentences describing traits or qualities of the deceased.&lt;SEP&gt;An annotation class capturing personal character traits, hobbies, interests, and personal beliefs of the deceased.&lt;SEP&gt;An obituary annotation class representing the traits, qualities, and remembered characteristics of the deceased.&lt;SEP&gt;Characteristics is an obituary classification category capturing traits, qualities, and personal attributes of the deceased.</data>
      <data key="d3">chunk-7217bed1354c5a8751d3eab9cd978cbd&lt;SEP&gt;chunk-cd215c830f4336951c05421c32e7aed1&lt;SEP&gt;chunk-be334478ba316675f89bc24ce6e3c03a&lt;SEP&gt;chunk-a79abb072d9fc8246078d8f3178dd255&lt;SEP&gt;chunk-9645cad08b5b060013cac117d156f888</data>
    </node>
    <node id="Family">
      <data key="d0">Family</data>
      <data key="d1">category</data>
      <data key="d2">A personal value dimension in the lexicon; users scoring high on Family are more likely to report activities involving family members.&lt;SEP&gt;A semantic class in obituary annotation capturing mentions of relatives, family members, and familial support.&lt;SEP&gt;A structural section category in obituaries listing living family members and relatives of the deceased.&lt;SEP&gt;An annotation category covering sentences that mention surviving family members or previously deceased close relatives.&lt;SEP&gt;An annotation class designating mentions of relatives, family members, and kinship ties within an obituary.&lt;SEP&gt;Family is a designated structural section in obituaries containing information about surviving and predeceased relatives.&lt;SEP&gt;Family is an obituary classification category representing text zones that describe the relatives and family background of the deceased.</data>
      <data key="d3">chunk-7217bed1354c5a8751d3eab9cd978cbd&lt;SEP&gt;chunk-9a42d2500d95a11dc6c778a73c5dba9c&lt;SEP&gt;chunk-5dea45043b79c2ffac532444762989fc&lt;SEP&gt;chunk-be334478ba316675f89bc24ce6e3c03a&lt;SEP&gt;chunk-cd215c830f4336951c05421c32e7aed1&lt;SEP&gt;chunk-a79abb072d9fc8246078d8f3178dd255&lt;SEP&gt;chunk-9645cad08b5b060013cac117d156f888</data>
    </node>
    <node id="Funeral Information">
      <data key="d0">Funeral Information</data>
      <data key="d1">category</data>
      <data key="d2">A category in obituary text zoning that encompasses details about memorial services, burials, or funeral arrangements.&lt;SEP&gt;A structural section category in obituaries outlining upcoming memorial, burial, and visitation services.&lt;SEP&gt;An annotation category designating sentences containing details about funeral services, times, locations, and memorial contributions.&lt;SEP&gt;An annotation class denoting details and arrangements concerning the funeral services.&lt;SEP&gt;Funeral Information is an obituary classification category representing details regarding memorial services, viewings, and funeral arrangements.&lt;SEP&gt;Funeral Information is an obituary section category outlining logistics such as the time, date, and location of funeral services.</data>
      <data key="d3">chunk-7217bed1354c5a8751d3eab9cd978cbd&lt;SEP&gt;chunk-9a42d2500d95a11dc6c778a73c5dba9c&lt;SEP&gt;chunk-be334478ba316675f89bc24ce6e3c03a&lt;SEP&gt;chunk-cd215c830f4336951c05421c32e7aed1&lt;SEP&gt;chunk-a79abb072d9fc8246078d8f3178dd255&lt;SEP&gt;chunk-9645cad08b5b060013cac117d156f888</data>
    </node>
    <node id="Desserts">
      <data key="d0">Desserts</data>
      <data key="d1">category</data>
      <data key="d2">A classification of sweet meals comprising ingredients such as chocolate chip, peanut butter, cream cheese, and ice cream clustered together in recipe embedding spaces.</data>
      <data key="d3">chunk-a79abb072d9fc8246078d8f3178dd255</data>
    </node>
    <node id="Gratitude">
      <data key="d0">Gratitude</data>
      <data key="d1">category</data>
      <data key="d2">A distinct structural section category in obituaries expressing appreciation and thanks towards caregivers, family, or community members.&lt;SEP&gt;A semantic class in obituary zoning annotation representing expressions of thanks and appreciation.&lt;SEP&gt;An annotation category applied to obituary sentences expressing appreciation or thanks to doctors, friends, or caregivers.&lt;SEP&gt;Gratitude is a rare obituary classification category designating expressions of thanks and appreciation.</data>
      <data key="d3">chunk-9645cad08b5b060013cac117d156f888&lt;SEP&gt;chunk-cd215c830f4336951c05421c32e7aed1&lt;SEP&gt;chunk-be334478ba316675f89bc24ce6e3c03a&lt;SEP&gt;chunk-a79abb072d9fc8246078d8f3178dd255</data>
    </node>
    <node id="Tribute">
      <data key="d0">Tribute</data>
      <data key="d1">category</data>
      <data key="d2">A structural section category within obituaries dedicated to honoring, commemorating, and memorializing the deceased person.&lt;SEP&gt;An annotation category used for obituary sentences describing major achievements and contributions to society.&lt;SEP&gt;An annotation class designating sentences that highlight major accomplishments, contributions, or societal honors.&lt;SEP&gt;An obituary annotation class representing expressions of honor, respect, and memorial tributes.&lt;SEP&gt;Tribute is a structural zoning category in obituaries dedicated to expressions of honor, memory, and emotional homage to the deceased.&lt;SEP&gt;Tribute is the rarest obituary classification category in the dataset, designating honors and dedications to the deceased.</data>
      <data key="d3">chunk-7217bed1354c5a8751d3eab9cd978cbd&lt;SEP&gt;chunk-9a42d2500d95a11dc6c778a73c5dba9c&lt;SEP&gt;chunk-be334478ba316675f89bc24ce6e3c03a&lt;SEP&gt;chunk-cd215c830f4336951c05421c32e7aed1&lt;SEP&gt;chunk-a79abb072d9fc8246078d8f3178dd255&lt;SEP&gt;chunk-9645cad08b5b060013cac117d156f888</data>
    </node>
    <node id="Other">
      <data key="d0">Other</data>
      <data key="d1">category</data>
      <data key="d2">A broad and diverse catch-all category in the obituary annotation scheme containing sentences that do not fit into primary classes.&lt;SEP&gt;A residual structural section category in obituaries covering aspects of a deceased person not captured by other standard sections.&lt;SEP&gt;An annotation category reserved for obituary sentences that do not fit into the other defined structural categories.&lt;SEP&gt;One of the eight sentence-level classification categories defined for structuring obituary documents that do not fit standard categories.&lt;SEP&gt;Other is an obituary classification category used for miscellaneous sentences not fitting defined obituary zones, as well as an error classification type.</data>
      <data key="d3">chunk-7217bed1354c5a8751d3eab9cd978cbd&lt;SEP&gt;chunk-cd215c830f4336951c05421c32e7aed1&lt;SEP&gt;chunk-be334478ba316675f89bc24ce6e3c03a&lt;SEP&gt;chunk-a79abb072d9fc8246078d8f3178dd255&lt;SEP&gt;chunk-9645cad08b5b060013cac117d156f888</data>
    </node>
    <node id="Sweet Meals">
      <data key="d0">Sweet Meals</data>
      <data key="d1">category</data>
      <data key="d2">A food cluster category in the recipe joint embedding space, containing items like chocolate chip, peanut butter, and ice cream.</data>
      <data key="d3">chunk-a79abb072d9fc8246078d8f3178dd255</data>
    </node>
    <node id="Meal Type">
      <data key="d0">Meal Type</data>
      <data key="d1">category</data>
      <data key="d2">A high-level food category determining cross-modal retrieval accuracy in ingredient attention models.</data>
      <data key="d3">chunk-a79abb072d9fc8246078d8f3178dd255</data>
    </node>
    <node id="Recipe Classes">
      <data key="d0">Recipe Classes</data>
      <data key="d1">category</data>
      <data key="d2">The taxonomic categories of food recipes, including the top ten classes analyzed within Recipe1M.</data>
      <data key="d3">chunk-a79abb072d9fc8246078d8f3178dd255</data>
    </node>
    <node id="Death">
      <data key="d0">Death</data>
      <data key="d1">event</data>
      <data key="d2">The passing of an individual, serving as the central occurrence prompting the writing and publication of an obituary.&lt;SEP&gt;The primary life event announced in an obituary, detailing the context, date, and cause of a person's passing.</data>
      <data key="d3">chunk-7217bed1354c5a8751d3eab9cd978cbd&lt;SEP&gt;chunk-a79abb072d9fc8246078d8f3178dd255</data>
    </node>
    <node id="Funeral">
      <data key="d0">Funeral</data>
      <data key="d1">event</data>
      <data key="d2">A commemorative and ceremonial event whose specific arrangements and details conclude typical obituaries.&lt;SEP&gt;A memorial or burial ceremony announced in obituaries, including visitation and burial services.</data>
      <data key="d3">chunk-7217bed1354c5a8751d3eab9cd978cbd&lt;SEP&gt;chunk-a79abb072d9fc8246078d8f3178dd255</data>
    </node>
    <node id="Visitation">
      <data key="d0">Visitation</data>
      <data key="d1">event</data>
      <data key="d2">A ceremonial gathering preceding a burial or funeral where mourners pay respects to the deceased and family.</data>
      <data key="d3">chunk-a79abb072d9fc8246078d8f3178dd255</data>
    </node>
    <node id="Burial Service">
      <data key="d0">Burial Service</data>
      <data key="d1">event</data>
      <data key="d2">A formal funeral ceremony centered on the interment of the deceased person.</data>
      <data key="d3">chunk-a79abb072d9fc8246078d8f3178dd255</data>
    </node>
    <node id="Legacy.com">
      <data key="d0">Legacy.com</data>
      <data key="d1">organization</data>
      <data key="d2">Legacy.com is an online social networking platform dedicated to publishing obituaries and facilitating interactions between mourners and families of the deceased.</data>
      <data key="d3">chunk-9a42d2500d95a11dc6c778a73c5dba9c</data>
    </node>
    <node id="Remembering.CA">
      <data key="d0">Remembering.CA</data>
      <data key="d1">organization</data>
      <data key="d2">A Canadian obituary portal providing 445 obituaries for the research dataset.&lt;SEP&gt;An aggregator website that compiles and displays obituaries published from various Canadian sources.&lt;SEP&gt;Remembering.CA is a dedicated online social network used for publishing obituaries and allowing mourners to express condolences.</data>
      <data key="d3">chunk-9645cad08b5b060013cac117d156f888&lt;SEP&gt;chunk-7217bed1354c5a8751d3eab9cd978cbd&lt;SEP&gt;chunk-9a42d2500d95a11dc6c778a73c5dba9c</data>
    </node>
    <node id="University of Stuttgart">
      <data key="d0">University of Stuttgart</data>
      <data key="d1">organization</data>
      <data key="d2">A German university whose computer science students evaluated annotation guidelines and labeled obituary data.&lt;SEP&gt;The University of Stuttgart, specifically its Institute for Natural Language Processing (IMS), hosts the research dataset and models for obituary zoning.</data>
      <data key="d3">chunk-9645cad08b5b060013cac117d156f888&lt;SEP&gt;chunk-9a42d2500d95a11dc6c778a73c5dba9c</data>
    </node>

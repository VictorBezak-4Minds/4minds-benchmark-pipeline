      <data key="d3">chunk-f717f876f65432fa813fac20ad6a7ddb</data>
    </node>
    <node id="CépiDC">
      <data key="d0">CépiDC</data>
      <data key="d1">organization</data>
      <data key="d2">CépiDC is an epidemiological center that provided the death certificate corpus and test set used for the ICD-10 coding evaluation task.&lt;SEP&gt;The French epidemiological center responsible for medical cause-of-death data, providing the test set used to evaluate the annotation system.</data>
      <data key="d3">chunk-b0d30e05ac4755125277651156c72d63&lt;SEP&gt;chunk-0ced0d535e26b1f8838eba4645dd259b</data>

      <data key="d0">Hürriyet</data>
      <data key="d1">organization</data>
      <data key="d2">Hürriyet is a major Turkish daily newspaper whose obituary publications from 1970 to 2009 were analyzed in cultural and sociological research.</data>
      <data key="d3">chunk-9a42d2500d95a11dc6c778a73c5dba9c</data>
    </node>

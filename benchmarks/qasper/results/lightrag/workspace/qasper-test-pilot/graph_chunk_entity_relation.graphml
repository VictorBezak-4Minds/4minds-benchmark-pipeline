      <data key="d1">category</data>
      <data key="d2">Exhibit is an ontological class and category of items or artifacts displayed within a museum, represented by individual identifiers such as exhibit49.</data>
      <data key="d3">chunk-d2133007f11cdae6d7728268eadeba6c</data>
    </node>
    <node id="Relation">
      <data key="d0">Relation</data>
      <data key="d1">category</data>
      <data key="d2">Relation is an ontological category describing relationships between entities, such as instanceOf and madeFrom.</data>

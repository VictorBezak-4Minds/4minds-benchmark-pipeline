    <edge source="Doctor" target="Clinical Trial">
      <data key="d4">8.0</data>
      <data key="d5">Doctors discuss whether enrolling in an appropriate clinical trial makes sense for the patient.</data>
      <data key="d6">consultation, medical decision-making</data>
      <data key="d7">chunk-8ec4d44b145ca896ff1216caa90ce5dd</data>
    </edge>
    <edge source="Clinical Trials" target="Chemotherapy">
      <data key="d4">7.0</data>
      <data key="d5">Clinical trials establish which chemotherapy regimens and therapy protocols serve as the standard of care for cancer patients.</data>
      <data key="d6">clinical research, treatment standards</data>
      <data key="d7">chunk-53afdc6713818c4177b64a712ecce11b</data>
    </edge>
    <edge source="Clinical Trials" target="Biomarker Testing">
      <data key="d4">15.0</data>
      <data key="d5">Biomarker testing results help identify clinical trials for which cervical cancer patients may be eligible.&lt;SEP&gt;Results from biomarker testing determine patient eligibility for specific clinical trials.</data>
      <data key="d6">clinical research, eligibility qualification&lt;SEP&gt;trial eligibility, precision oncology</data>
      <data key="d7">chunk-96238b4b361e393ff452a09d1ce26154&lt;SEP&gt;chunk-b3ba7430f3a31330247f52afe7e9c68a</data>
    </edge>
    <edge source="Clinical Trials" target="Targeted Therapy">
      <data key="d4">8.0</data>
      <data key="d5">Clinical trials are actively conducted by researchers to discover new targeted therapies for specific glioma subtypes.</data>
      <data key="d6">clinical research, drug development</data>
      <data key="d7">chunk-bc89a92e9a97781ebca0db50abc34939</data>
    </edge>
    <edge source="Clinical Trials" target="Phase I Clinical Trials">
      <data key="d4">9.0</data>
      <data key="d5">Phase I trials represent the initial stage within the four-phase clinical trial pipeline.</data>
      <data key="d6">trial phase, drug development</data>
      <data key="d7">chunk-c35816f05289661283f683145d9f395f</data>
    </edge>
    <edge source="Clinical Trials" target="Phase II Clinical Trials">
      <data key="d4">9.0</data>
      <data key="d5">Phase II trials constitute the efficacy-evaluating phase of clinical trials.</data>
      <data key="d6">trial phase, efficacy assessment</data>
      <data key="d7">chunk-c35816f05289661283f683145d9f395f</data>
    </edge>
    <edge source="Clinical Trials" target="Phase III Clinical Trials">
      <data key="d4">9.0</data>
      <data key="d5">Phase III trials represent the comparative testing stage in clinical trials before regulatory evaluation.</data>
      <data key="d6">trial phase, comparative evaluation</data>
      <data key="d7">chunk-c35816f05289661283f683145d9f395f</data>
    </edge>
    <edge source="Clinical Trials" target="Phase IV Clinical Trials">
      <data key="d4">9.0</data>
      <data key="d5">Phase IV trials represent post-marketing studies conducted within the clinical trial framework.</data>
      <data key="d6">post-market surveillance, trial phase</data>
      <data key="d7">chunk-c35816f05289661283f683145d9f395f</data>
    </edge>
    <edge source="Chemotherapy" target="Targeted Therapy">
      <data key="d4">15.0</data>
      <data key="d5">Chemotherapy and targeted therapy are distinct medical therapies that can be selected or combined within primary CNS lymphoma treatment plans.&lt;SEP&gt;Targeted therapy is frequently combined with chemotherapy to enhance treatment efficacy against cancer cells.</data>
      <data key="d6">combination therapy, cancer treatment&lt;SEP&gt;combination therapy, systemic treatment</data>
      <data key="d7">chunk-a65ba958750476cc543741efe815c7c4&lt;SEP&gt;chunk-d0f15711706bc171fed17a7fab91b4b6</data>
    </edge>
    <edge source="Chemotherapy" target="Immunotherapy">
      <data key="d4">15.0</data>
      <data key="d5">Chemotherapy is combined with immune checkpoint inhibitor therapies to treat cancers expressing PD-L1.&lt;SEP&gt;Immunotherapy drugs may be administered together with chemotherapy regimens in cancer management.</data>
      <data key="d6">combination therapy, cancer treatment</data>
      <data key="d7">chunk-725b48dc82aad42ba3dc14f4b5207551&lt;SEP&gt;chunk-ea7b3f83164304ee4a562046eb0f5033</data>
    </edge>
    <edge source="Chemotherapy" target="Modified DCF Regimen">
      <data key="d4">9.0</data>
      <data key="d5">The modified DCF regimen is a specific systemic multi-drug chemotherapy regimen.</data>
      <data key="d6">regimen classification, oncology</data>
      <data key="d7">chunk-c35816f05289661283f683145d9f395f</data>
    </edge>
    <edge source="Targeted Therapy" target="Clinical Trial">
      <data key="d4">7.0</data>
      <data key="d5">Targeted therapies are offered and investigated within clinical trials for advanced CSCC cases.</data>
      <data key="d6">clinical research, novel therapeutics</data>
      <data key="d7">chunk-50c5e5d6c7a62da56b73abb9a3384301</data>
    </edge>
    <edge source="Targeted Therapy" target="Biomarker Testing">
      <data key="d4">18.0</data>
      <data key="d5">Biomarker testing identifies targetable genetic alterations to guide the selection of targeted therapies.&lt;SEP&gt;Biomarker testing is recommended to establish whether a patient qualifies for targeted therapy.</data>
      <data key="d6">eligibility determination, clinical testing&lt;SEP&gt;precision medicine, treatment selection</data>
      <data key="d7">chunk-121b68d5de585c87804c9bce3cdc71eb&lt;SEP&gt;chunk-9d383e4798456aa46e381fd2b02f6f96</data>
    </edge>
    <edge source="Targeted Therapy" target="Immunotherapy">
      <data key="d4">8.0</data>
      <data key="d5">Targeted therapy is often combined with immunotherapy as a preferred treatment regimen for metastatic bladder cancer.</data>
      <data key="d6">combination therapy, treatment regimen</data>
      <data key="d7">chunk-48b513355d29308e212a3074ba326b10</data>
    </edge>
    <edge source="Immunotherapy" target="Biomarker Testing">
      <data key="d4">17.0</data>
      <data key="d5">Biomarker testing assesses features like dMMR and MSI-H to determine eligibility for immunotherapy.&lt;SEP&gt;Biomarker testing determines patient eligibility for receiving immunotherapy.</data>
      <data key="d6">eligibility determination, diagnostic screening&lt;SEP&gt;precision medicine, treatment selection</data>
      <data key="d7">chunk-121b68d5de585c87804c9bce3cdc71eb&lt;SEP&gt;chunk-9d383e4798456aa46e381fd2b02f6f96</data>
    </edge>
  </graph>

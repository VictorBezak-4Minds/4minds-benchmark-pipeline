    </edge>
    <edge source="Liver Cancer" target="Biopsy">
      <data key="d4">8.0</data>
      <data key="d5">A biopsy is conducted when necessary to provide definitive tissue confirmation of liver cancer.</data>
      <data key="d6">diagnostic confirmation, pathology</data>
      <data key="d7">chunk-5fdcf47f3da06d3e0213112c96eb93d4</data>
    </edge>
    <edge source="Liver Cancer" target="Blood Tests">
      <data key="d4">8.0</data>
      <data key="d5">Blood test results are evaluated along with imaging and biopsies to formulate liver cancer treatment plans.</data>
      <data key="d6">diagnostic evaluation, treatment planning</data>
      <data key="d7">chunk-5fdcf47f3da06d3e0213112c96eb93d4</data>
    </edge>
    <edge source="Liver Cancer" target="Liver Disease">
      <data key="d4">8.0</data>

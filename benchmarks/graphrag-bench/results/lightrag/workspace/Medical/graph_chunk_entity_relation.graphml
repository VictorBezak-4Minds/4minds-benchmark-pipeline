      <data key="d6">genetic mutation, biomarker analysis</data>
      <data key="d7">chunk-0786666c65b5bf00705439d5cb60d5a0</data>
    </edge>
    <edge source="Hematopathology Review" target="Pathologist">
      <data key="d4">9.0</data>

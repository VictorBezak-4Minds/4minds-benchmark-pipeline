    </edge>
    <edge source="Breast Cancer" target="Ductal Carcinoma">
      <data key="d4">9.0</data>
      <data key="d5">Ductal carcinoma is the most common subtype of breast cancer.</data>
      <data key="d6">disease classification, cancer subtype</data>
      <data key="d7">chunk-1dc8d8e5ed4f165f3e56305a7644ba05</data>
    </edge>

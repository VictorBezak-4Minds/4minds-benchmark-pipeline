      <data key="d6">specialized treatment, clinical expertise</data>
      <data key="d7">chunk-0fb70c1c798caae12ac2d64e61bcbad4</data>
    </edge>
    <edge source="High-Volume Center" target="Multidisciplinary Care Team">
      <data key="d4">8.0</data>
      <data key="d5">The multidisciplinary cancer care team is recommended to work at a high-volume center to leverage collective clinical experience.</data>
      <data key="d6">institutional affiliation, specialized care</data>
      <data key="d7">chunk-0fb70c1c798caae12ac2d64e61bcbad4</data>
    </edge>
    <edge source="Oropharyngeal Cancer" target="NCCN">
      <data key="d4">8.0</data>
      <data key="d5">NCCN publishes specialized patient guidelines and educational app resources on throat and oropharyngeal cancer.</data>
      <data key="d6">clinical guidance, medical resources</data>
      <data key="d7">chunk-f43f96815f23658d5b24fe95ed4bd5ed</data>
    </edge>
    <edge source="Oropharyngeal Cancer" target="Care Team">
      <data key="d4">8.0</data>

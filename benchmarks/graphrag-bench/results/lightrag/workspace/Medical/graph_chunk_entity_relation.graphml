    <edge source="Mirvetuximab Soravtansine-Gynx" target="Antibody Drug Conjugate">
      <data key="d4">9.0</data>
      <data key="d5">Mirvetuximab soravtansine-gynx belongs to the antibody-drug conjugate drug class.</data>
      <data key="d6">pharmacological classification</data>
      <data key="d7">chunk-c622c677deca24391324ecd5f16ce4a3</data>
    </edge>
    <edge source="Surveillance" target="CA-125">
      <data key="d4">8.0</data>
      <data key="d5">CA-125 levels are monitored during post-treatment surveillance to detect possible cancer recurrence.</data>
      <data key="d6">biomarker monitoring, post-treatment surveillance</data>
      <data key="d7">chunk-c622c677deca24391324ecd5f16ce4a3</data>
    </edge>
    <edge source="Surveillance" target="Non-Metastatic Cancer">
      <data key="d4">8.0</data>
      <data key="d5">Surveillance protocols are established after treatment to monitor patients for recurrence of non-metastatic colon cancer.</data>
      <data key="d6">post-treatment monitoring, patient follow-up</data>
      <data key="d7">chunk-ee254e84e63bd35682ed56c41cef9247</data>
    </edge>
    <edge source="Surveillance" target="Oncologist">
      <data key="d4">8.0</data>
      <data key="d5">The oncologist oversees and conducts the patient surveillance process over the follow-up years.</data>
      <data key="d6">medical monitoring, oncology oversight</data>
      <data key="d7">chunk-e247ae57c50c62bded7114986471226e</data>
    </edge>
    <edge source="Surveillance" target="Locally Advanced Cervical Cancer">
      <data key="d4">7.0</data>
      <data key="d5">Patients treated for locally advanced cervical cancer enter a structured surveillance regimen to monitor for recurrence.</data>
      <data key="d6">post-treatment protocol, disease monitoring</data>
      <data key="d7">chunk-e247ae57c50c62bded7114986471226e</data>
    </edge>
    <edge source="Surveillance" target="Small Cell Neuroendocrine Carcinoma of the Cervix">
      <data key="d4">8.0</data>
      <data key="d5">Post-treatment surveillance recommendations apply to common cervical cancers as well as small cell neuroendocrine carcinoma of the cervix.</data>
      <data key="d6">disease monitoring, clinical guidelines</data>
      <data key="d7">chunk-e247ae57c50c62bded7114986471226e</data>
    </edge>
    <edge source="Surveillance" target="NCCN">
      <data key="d4">8.0</data>
      <data key="d5">The NCCN provides clinical guidance outlining post-treatment surveillance recommendations for cervical cancer.</data>
      <data key="d6">clinical guidelines, healthcare standards</data>
      <data key="d7">chunk-e247ae57c50c62bded7114986471226e</data>
    </edge>
    <edge source="Surveillance" target="Physical Exam">
      <data key="d4">9.0</data>
      <data key="d5">Physical exams are an essential clinical component of the overall post-treatment cancer surveillance protocol.</data>
      <data key="d6">medical checkup, recurrence detection</data>
      <data key="d7">chunk-e247ae57c50c62bded7114986471226e</data>
    </edge>
    <edge source="Surveillance" target="Recurrent Anal Cancer">
      <data key="d4">9.0</data>
      <data key="d5">Structured surveillance is implemented to monitor patients following treatment for recurrent anal cancer.</data>
      <data key="d6">post-treatment monitoring, oncologic surveillance</data>
      <data key="d7">chunk-5349eed06f06d7c9bcb541ced69e4664</data>
    </edge>
    <edge source="Surveillance" target="Digital Rectal Exam">
      <data key="d4">9.0</data>
      <data key="d5">Digital rectal exams are a required surveillance tool every 3 to 6 months for patients treated for nodal recurrence without APR.</data>
      <data key="d6">post-treatment surveillance, physical examination</data>
      <data key="d7">chunk-5349eed06f06d7c9bcb541ced69e4664</data>
    </edge>
    <edge source="Surveillance" target="Anoscopy">
      <data key="d4">9.0</data>
      <data key="d5">Anoscopy forms part of the surveillance protocol every 6 to 12 months for 3 years in patients who did not undergo APR.</data>
      <data key="d6">post-treatment surveillance, diagnostic endoscopy</data>
      <data key="d7">chunk-5349eed06f06d7c9bcb541ced69e4664</data>
    </edge>
    <edge source="Surveillance" target="Imaging Surveillance">
      <data key="d4">9.0</data>
      <data key="d5">Imaging surveillance using CT or MRI scans is part of regular follow-up protocol for 3 years following treatment for cancer recurrence.</data>
      <data key="d6">post-treatment surveillance, radiological monitoring</data>
      <data key="d7">chunk-5349eed06f06d7c9bcb541ced69e4664</data>
    </edge>
    <edge source="Immune Checkpoint Inhibitors" target="NCCN">
      <data key="d4">16.0</data>
      <data key="d5">NCCN provides guidelines on immunotherapy side effects specifically for immune checkpoint inhibitors.&lt;SEP&gt;The NCCN publishes patient guideline resources detailing side effects associated with immune checkpoint inhibitors.</data>
      <data key="d6">clinical guidance, treatment information&lt;SEP&gt;clinical guidelines, drug side effects</data>

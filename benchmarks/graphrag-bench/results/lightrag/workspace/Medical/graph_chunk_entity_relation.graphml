      <data key="d6">pharmacology, barrier penetration</data>
      <data key="d7">chunk-bb68daec67dd8f436d82814b0e61ff21</data>
    </edge>
    <edge source="Methotrexate" target="Rituximab">
      <data key="d4">9.0</data>
      <data key="d5">High-dose methotrexate is combined with the immunotherapy drug rituximab for induction therapy in primary CNS lymphoma.</data>
      <data key="d6">combination therapy, medical regimen</data>

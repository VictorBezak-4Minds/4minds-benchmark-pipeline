      <data key="d6">research participation, experimental therapeutics</data>
      <data key="d7">chunk-4966a628b12ecec4187796598764cf23</data>
    </edge>
    <edge source="Primary CNS Lymphoma" target="Biopsy">
      <data key="d4">17.0</data>
      <data key="d5">A biopsy is conducted on suspected brain tissue to reliably diagnose primary CNS lymphoma before steroids are administered.&lt;SEP&gt;A biopsy is considered essential to confirm the diagnosis of primary CNS lymphoma by analyzing tumor tissue or fluid.</data>
      <data key="d6">diagnostic procedure, disease confirmation&lt;SEP&gt;diagnostic procedure, medical testing</data>

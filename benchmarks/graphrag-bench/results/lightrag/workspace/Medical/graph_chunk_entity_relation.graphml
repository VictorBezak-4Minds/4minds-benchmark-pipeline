    <edge source="Ewing Sarcoma" target="Biomarker Testing">
      <data key="d4">8.0</data>
      <data key="d5">Biomarker testing identifies gene fusions and chromosomal translocations characteristic of Ewing sarcoma.</data>
      <data key="d6">genetic identification, disease diagnosis</data>
      <data key="d7">chunk-30c0bb66b1a2f93e89f5342ab1077451</data>
    </edge>
    <edge source="Ewing Sarcoma" target="Chromosomal Translocation">
      <data key="d4">9.0</data>
      <data key="d5">Ewing sarcoma is caused by a somatic chromosomal translocation, typically between chromosomes 11 and 22.</data>
      <data key="d6">oncogenesis, genetic mechanism</data>
      <data key="d7">chunk-30c0bb66b1a2f93e89f5342ab1077451</data>
    </edge>

      <data key="d6">clinical evaluation, diagnostic assessment</data>
      <data key="d7">chunk-c37f547042fc10baabdbfaadf010bce5</data>
    </edge>
    <edge source="Metastatic Breast Cancer" target="Care Team">
      <data key="d4">8.0</data>

  <key id="d4" for="edge" attr.name="weight" attr.type="double" />
  <key id="d3" for="node" attr.name="source_id" attr.type="string" />
  <key id="d2" for="node" attr.name="description" attr.type="string" />
  <key id="d1" for="node" attr.name="entity_type" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_id" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="United States">
      <data key="d0">United States</data>
      <data key="d1">geo</data>
      <data key="d2">A country where significant racial differences and disparities exist in prostate cancer incidence, aggressiveness, and mortality rates.&lt;SEP&gt;The United States is a country where a shortage of bacillus Calmette-Guérin (BCG) has impacted bladder cancer treatments for several years.&lt;SEP&gt;The United States is a country where an HPV vaccine protecting against nine strains is available for individuals aged 45 and under.&lt;SEP&gt;The United States is a country where approximately 3 million cases of basal cell skin cancer are diagnosed annually.&lt;SEP&gt;The United States is a country where distinct racial disparities in prostate cancer diagnosis rates, aggressiveness, and mortality are observed.&lt;SEP&gt;The United States is a country where resources like NCCN Cancer Centers and the National Cancer Institute operate to assist patients with clinical trials and cancer care.&lt;SEP&gt;The United States is a country where resources such as NCCN Cancer Centers and the National Cancer Institute provide access to cancer clinical trials.&lt;SEP&gt;The United States is a country where resources such as NCCN Cancer Centers and the National Cancer Institute provide clinical trial access.&lt;SEP&gt;The United States is a country where several cancer care organizations and clinical trial search services operate.&lt;SEP&gt;The United States is a country where the implementation of Pap smear screenings has led to significantly lower rates of cervical cancer.&lt;SEP&gt;The United States is the country where organizations such as the NCCN and NCI offer cancer care and clinical trial resources.&lt;SEP&gt;The country referenced in relation to male health statistics, where prostate cancer is the second most common cancer among males.&lt;SEP&gt;The country where federal regulatory approval for cancer treatments is governed by the FDA.&lt;SEP&gt;The country where leading cancer centers form the National Comprehensive Cancer Network alliance.&lt;SEP&gt;The nation where NCCN Cancer Centers, the National Cancer Institute, and specific cancer research services operate.&lt;SEP&gt;The nation where the Food and Drug Administration operates and oversees the approval of medical therapies.</data>
      <data key="d3">chunk-64f36a4a5be80c8fa51631db16e52b85&lt;SEP&gt;chunk-6236b93e627d54f73f1c8fe341127e67&lt;SEP&gt;chunk-e74c94f9f2ff33172671e8742338c6d1&lt;SEP&gt;chunk-f6fd03791661f76f6c1a246b2074b2a0&lt;SEP&gt;chunk-8ec4d44b145ca896ff1216caa90ce5dd&lt;SEP&gt;chunk-c6d28b36fe82792dfb86e98ef76b3b04&lt;SEP&gt;chunk-0fb70c1c798caae12ac2d64e61bcbad4&lt;SEP&gt;chunk-b0a584e54ffa22e1c25f839302bcd727&lt;SEP&gt;chunk-b4d036ee5fd77783b9e7ddef3a8477ae&lt;SEP&gt;chunk-c35816f05289661283f683145d9f395f&lt;SEP&gt;chunk-aa251c48fc1fccfe45605a384f743662&lt;SEP&gt;chunk-60426652ddf8265bf75caba550026d38&lt;SEP&gt;chunk-d249262ff9e7e657de99a30199159cdf&lt;SEP&gt;chunk-66dd071b6c2be50e36cee1a1c1bd3b33&lt;SEP&gt;chunk-725b48dc82aad42ba3dc14f4b5207551&lt;SEP&gt;chunk-541f1323a24c5990b4a6408e0c5442ab</data>
    </node>
    <node id="Basal Cell Skin Cancer">
      <data key="d0">Basal Cell Skin Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A form of skin cancer that can recur or metastasize to lymph nodes or distant body parts, requiring diagnosis through physical exams, biopsies, and imaging.&lt;SEP&gt;Basal cell skin cancer, also known as basal cell carcinoma (BCC), is the most common type of skin cancer, arising from abnormal basal cells in the epidermis, primarily caused by UV radiation.</data>
      <data key="d3">chunk-f8eae4d6dadf6a6fbd339efa4dec2172&lt;SEP&gt;chunk-66dd071b6c2be50e36cee1a1c1bd3b33</data>
    </node>
    <node id="Skin Cancer">
      <data key="d0">Skin Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A category of malignancy identified as the most common cancer in American men, ranking ahead of prostate cancer.&lt;SEP&gt;A malignant cancer of the skin mentioned as one of the types of cancer screened by healthcare providers.&lt;SEP&gt;Skin cancer is a broad disease category comprising malignancies that develop in the layers of the skin, most frequently in the epidermis.&lt;SEP&gt;Skin cancer is a distinct form of cancer that develops from skin cells, distinguished from cutaneous lymphomas which develop from abnormal lymphocytes.</data>
      <data key="d3">chunk-196a80cd0ae47fda3849b101cca91a15&lt;SEP&gt;chunk-08475506372bb4ce9ec1bd326caf0fe9&lt;SEP&gt;chunk-66dd071b6c2be50e36cee1a1c1bd3b33&lt;SEP&gt;chunk-0fb70c1c798caae12ac2d64e61bcbad4</data>
    </node>
    <node id="Squamous Cell Skin Cancer">
      <data key="d0">Squamous Cell Skin Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A category of cutaneous malignancy that includes cancer of the vermilion border of the lip, addressed in specific NCCN patient guidelines.&lt;SEP&gt;A common type of skin cancer (also referred to as cutaneous squamous cell carcinoma or CSCC) that can develop locally, regionally, or metastasize to distant body parts.&lt;SEP&gt;A common type of skin cancer, also known as cutaneous squamous cell carcinoma (CSCC), originating in the squamous cells of the epidermis.&lt;SEP&gt;A type of skin cancer (also referred to as CSCC) treated using surgical options, radiation, and various forms of systemic therapy.&lt;SEP&gt;A type of skin cancer originating in squamous cells, also known as CSCC, which can arise from lesions, old wounds, or burns and may spread to other parts of the body.&lt;SEP&gt;Squamous cell skin cancer (also referred to as cutaneous squamous cell carcinoma or CSCC) is a form of skin cancer that can be treated with topical therapies, excision, Mohs surgery, or lymph node procedures.&lt;SEP&gt;Squamous cell skin cancer is a category of skin cancer that originates in the squamous cells located in the upper part of the epidermis.</data>
      <data key="d3">chunk-f6fd03791661f76f6c1a246b2074b2a0&lt;SEP&gt;chunk-f1379433bc205cdec8af2edc77613acb&lt;SEP&gt;chunk-f43f96815f23658d5b24fe95ed4bd5ed&lt;SEP&gt;chunk-64895edc4d35c98b293c555e32022a37&lt;SEP&gt;chunk-e8ac9bf8f198bc5ad54fd1a7b843e810&lt;SEP&gt;chunk-7d994e430bb9890c905d7914fad9c118&lt;SEP&gt;chunk-66dd071b6c2be50e36cee1a1c1bd3b33</data>
    </node>
    <node id="Melanoma">
      <data key="d0">Melanoma</data>
      <data key="d1">category</data>
      <data key="d2">A form of skin cancer associated with inherited mutations in genes like BRCA1 or BRCA2.&lt;SEP&gt;A less common but more aggressive type of skin cancer that originates in melanocytes.&lt;SEP&gt;A severe form of skin cancer associated with inherited germline mutations such as those found in BRCA1 and BRCA2.&lt;SEP&gt;Melanoma is a type of skin cancer that develops in melanocytes, the cells responsible for producing melanin in the epidermis.</data>
      <data key="d3">chunk-f1379433bc205cdec8af2edc77613acb&lt;SEP&gt;chunk-66dd071b6c2be50e36cee1a1c1bd3b33&lt;SEP&gt;chunk-965e5a6bad03f2129a98be4373f99176&lt;SEP&gt;chunk-789ec6c06f8c999ac21c89b085b3fdb7</data>
    </node>
    <node id="Epidermis">
      <data key="d0">Epidermis</data>
      <data key="d1">category</data>
      <data key="d2">The outermost layer of the skin that acts as a waterproof barrier and houses squamous cells, basal cells, and melanocytes.&lt;SEP&gt;The outermost layer of the skin that provides a waterproof barrier, produces melanin, and contains basal cells, squamous cells, and melanocytes.</data>
      <data key="d3">chunk-f1379433bc205cdec8af2edc77613acb&lt;SEP&gt;chunk-66dd071b6c2be50e36cee1a1c1bd3b33</data>
    </node>
    <node id="Dermis">
      <data key="d0">Dermis</data>
      <data key="d1">category</data>
      <data key="d2">The middle layer of the skin composed of connective tissue, blood vessels, oil and sweat glands, nerves, and hair follicles.&lt;SEP&gt;The middle layer of the skin containing connective tissue, hair follicles, and sweat glands.</data>
      <data key="d3">chunk-f1379433bc205cdec8af2edc77613acb&lt;SEP&gt;chunk-66dd071b6c2be50e36cee1a1c1bd3b33</data>
    </node>
    <node id="Hypodermis">
      <data key="d0">Hypodermis</data>
      <data key="d1">category</data>
      <data key="d2">The deepest layer of skin, also called subcutis, composed primarily of fat and connective tissue.&lt;SEP&gt;The deepest tissue layer of the skin consisting of fat and connective tissue.</data>
      <data key="d3">chunk-f1379433bc205cdec8af2edc77613acb&lt;SEP&gt;chunk-66dd071b6c2be50e36cee1a1c1bd3b33</data>
    </node>
    <node id="Basal Cells">
      <data key="d0">Basal Cells</data>
      <data key="d1">category</data>
      <data key="d2">Cells located in the lower epidermis that continuously divide to form new cells and can mutate to cause basal cell skin cancer.&lt;SEP&gt;Cells located in the lower epidermis that divide continuously and mature into squamous cells.</data>
      <data key="d3">chunk-f1379433bc205cdec8af2edc77613acb&lt;SEP&gt;chunk-66dd071b6c2be50e36cee1a1c1bd3b33</data>
    </node>
    <node id="Squamous Cells">
      <data key="d0">Squamous Cells</data>
      <data key="d1">category</data>
      <data key="d2">Flat cells located in the upper section of the epidermis that are continuously replaced by dividing basal cells.&lt;SEP&gt;Thin, flat cells resembling fish scales located in the upper layer of the epidermis as well as other organs such as the lungs, thyroid, and esophagus.</data>
      <data key="d3">chunk-f1379433bc205cdec8af2edc77613acb&lt;SEP&gt;chunk-66dd071b6c2be50e36cee1a1c1bd3b33</data>
    </node>
    <node id="Melanocytes">
      <data key="d0">Melanocytes</data>
      <data key="d1">category</data>
      <data key="d2">Cells found in the epidermis that produce melanin to provide skin pigmentation and protect against ultraviolet radiation.&lt;SEP&gt;Specialized cells in the lower part of the epidermis that produce melanin to provide skin color and protection from ultraviolet rays.</data>
      <data key="d3">chunk-f1379433bc205cdec8af2edc77613acb&lt;SEP&gt;chunk-66dd071b6c2be50e36cee1a1c1bd3b33</data>
    </node>
    <node id="UV Radiation">
      <data key="d0">UV Radiation</data>
      <data key="d1">category</data>
      <data key="d2">Ultraviolet radiation from sunlight or tanning beds that damages cellular DNA and represents the primary cause of basal cell skin cancer.</data>
      <data key="d3">chunk-66dd071b6c2be50e36cee1a1c1bd3b33</data>
    </node>
    <node id="Immune Suppression">
      <data key="d0">Immune Suppression</data>
      <data key="d1">category</data>
      <data key="d2">A medical condition characterized by a weakened immune system, often resulting from organ transplants or autoimmune diseases, that elevates skin cancer risk.</data>
      <data key="d3">chunk-66dd071b6c2be50e36cee1a1c1bd3b33</data>
    </node>
    <node id="Full Skin Exam">
      <data key="d0">Full Skin Exam</data>
      <data key="d1">event</data>
      <data key="d2">A routine clinical examination conducted by a doctor at least once a year following cancer treatment to monitor for recurrence or new lesions.</data>
      <data key="d3">chunk-66dd071b6c2be50e36cee1a1c1bd3b33</data>
    </node>
    <node id="Adrenal Tumors">
      <data key="d0">Adrenal Tumors</data>
      <data key="d1">category</data>
      <data key="d2">A disease category involving growths in the adrenal glands, for which patient management guidelines and specific imaging tests are provided.&lt;SEP&gt;Abnormal growths located on the adrenal glands, evaluated using hormonal and molecular imaging tests.&lt;SEP&gt;Tumors that form in one or both adrenal glands, categorized as benign, functional, or malignant.</data>
      <data key="d3">chunk-aa14ecd19e2d721cb99ea9590f0ede3a&lt;SEP&gt;chunk-f8eae4d6dadf6a6fbd339efa4dec2172&lt;SEP&gt;chunk-f1379433bc205cdec8af2edc77613acb</data>
    </node>
    <node id="Adrenocortical Carcinoma">
      <data key="d0">Adrenocortical Carcinoma</data>
      <data key="d1">category</data>
      <data key="d2">A rare malignancy starting in the adrenal cortex that can be functioning or nonfunctioning and primarily affects children under 5 and adults in their 40s and 50s.&lt;SEP&gt;A very rare malignant adrenal tumor originating in the adrenal cortex, which can be functioning or nonfunctioning.</data>
      <data key="d3">chunk-f8eae4d6dadf6a6fbd339efa4dec2172&lt;SEP&gt;chunk-7102a43dfb62e649d725bc95ba292688</data>
    </node>
    <node id="Neuroblastoma">
      <data key="d0">Neuroblastoma</data>
      <data key="d1">category</data>
      <data key="d2">A rare cancerous adrenal tumor that predominantly affects infants and children aged 5 and under, with the ability to spread to other parts of the body such as bones.&lt;SEP&gt;A rare, cancerous type of adrenal tumor that primarily affects infants and children aged 5 and under.</data>
      <data key="d3">chunk-f8eae4d6dadf6a6fbd339efa4dec2172&lt;SEP&gt;chunk-7102a43dfb62e649d725bc95ba292688</data>
    </node>
    <node id="Cushing Syndrome">
      <data key="d0">Cushing Syndrome</data>
      <data key="d1">category</data>
      <data key="d2">A medical condition caused by an adrenal adenoma that produces excessive amounts of the hormone cortisol.</data>
      <data key="d3">chunk-f8eae4d6dadf6a6fbd339efa4dec2172</data>
    </node>
    <node id="Aldosteronoma">
      <data key="d0">Aldosteronoma</data>
      <data key="d1">category</data>
      <data key="d2">A type of adrenal adenoma that secretes excessive amounts of the hormone aldosterone.</data>
      <data key="d3">chunk-f8eae4d6dadf6a6fbd339efa4dec2172</data>
    </node>
    <node id="Adrenal Glands">
      <data key="d0">Adrenal Glands</data>
      <data key="d1">category</data>
      <data key="d2">Paired endocrine glands located on top of each kidney that produce hormones regulating metabolism, blood pressure, immune response, and stress.</data>
      <data key="d3">chunk-f8eae4d6dadf6a6fbd339efa4dec2172</data>
    </node>
    <node id="Endocrine System">
      <data key="d0">Endocrine System</data>
      <data key="d1">category</data>
      <data key="d2">A system of glands and tissues in the human body that secrete hormones into the bloodstream to regulate cellular and organ function.&lt;SEP&gt;The biological bodily system composed of hormone-producing glands and tissues, including the adrenal glands, responsible for regulating various physiological processes.</data>
      <data key="d3">chunk-f8eae4d6dadf6a6fbd339efa4dec2172&lt;SEP&gt;chunk-7102a43dfb62e649d725bc95ba292688</data>
    </node>
    <node id="Adrenal Cortex">
      <data key="d0">Adrenal Cortex</data>
      <data key="d1">category</data>
      <data key="d2">The outer layer of the adrenal gland responsible for producing steroid hormones such as cortisol, aldosterone, and DHEA.</data>
      <data key="d3">chunk-f8eae4d6dadf6a6fbd339efa4dec2172</data>
    </node>
    <node id="Adrenal Medulla">
      <data key="d0">Adrenal Medulla</data>
      <data key="d1">category</data>
      <data key="d2">The inner region of the adrenal gland that synthesizes catecholamines, including epinephrine, norepinephrine, and dopamine, mediating the stress response.</data>
      <data key="d3">chunk-f8eae4d6dadf6a6fbd339efa4dec2172</data>
    </node>
    <node id="Benign Adrenal Tumors">
      <data key="d0">Benign Adrenal Tumors</data>
      <data key="d1">category</data>
      <data key="d2">Non-cancerous tumors of the adrenal gland that do not metastasize, often discovered incidentally during imaging tests.</data>
      <data key="d3">chunk-f8eae4d6dadf6a6fbd339efa4dec2172</data>
    </node>
    <node id="Functional Adrenal Tumors">
      <data key="d0">Functional Adrenal Tumors</data>
      <data key="d1">category</data>
      <data key="d2">Adrenal tumors that synthesize and release excess hormones, often causing distinct endocrine symptoms.</data>
      <data key="d3">chunk-f8eae4d6dadf6a6fbd339efa4dec2172</data>
    </node>
    <node id="Malignant Adrenal Tumors">
      <data key="d0">Malignant Adrenal Tumors</data>
      <data key="d1">category</data>
      <data key="d2">Rare cancerous neoplasms of the adrenal glands, diagnosed in 300 to 500 individuals annually.</data>
      <data key="d3">chunk-f8eae4d6dadf6a6fbd339efa4dec2172</data>
    </node>
    <node id="Adenoma">
      <data key="d0">Adenoma</data>
      <data key="d1">category</data>
      <data key="d2">A benign epithelial tumor in the adrenal gland that can overproduce specific hormones like aldosterone or cortisol.&lt;SEP&gt;A category of benign polyp arising on the colon inner lining that carries potential to develop into invasive cancer over time.&lt;SEP&gt;An adenoma is a common type of benign polyp in the lining of the colon and rectum that carries the potential to progress into invasive cancer over time.&lt;SEP&gt;An adenoma is a common type of non-cancerous polyp forming on the inner lining of the colon and rectum that can develop into invasive adenocarcinoma.&lt;SEP&gt;An adenoma is the most common type of colon polyp and has the potential over time to develop into invasive colon cancer.&lt;SEP&gt;An adenoma is the most common type of polyp found on the rectal wall, capable of developing into invasive cancer over several years.&lt;SEP&gt;The most common type of adrenal gland tumor, also known as adrenocortical adenoma, which is noncancerous and may be functioning or nonfunctioning.&lt;SEP&gt;The most common type of non-cancerous polyp found in the colon and rectum that has the potential over time to develop into invasive cancer.</data>
      <data key="d3">chunk-bb68daec67dd8f436d82814b0e61ff21&lt;SEP&gt;chunk-f8eae4d6dadf6a6fbd339efa4dec2172&lt;SEP&gt;chunk-7102a43dfb62e649d725bc95ba292688&lt;SEP&gt;chunk-c5bc83f5f4f3e29b7f0a6f4787c3ad83&lt;SEP&gt;chunk-ee254e84e63bd35682ed56c41cef9247&lt;SEP&gt;chunk-925a474b4538dda470bfd817f9d9a17d&lt;SEP&gt;chunk-f2c9770fd98dbbe3c7947601fb3e654c&lt;SEP&gt;chunk-b5cfcc365cd093374564eb27dcbf5b82</data>
    </node>
    <node id="Adrenal Gland Cancer">
      <data key="d0">Adrenal Gland Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A rare cancer affecting approximately 1 to 2 people per million, originating in one or both adrenal glands.</data>
      <data key="d3">chunk-7102a43dfb62e649d725bc95ba292688</data>
    </node>
    <node id="Pheochromocytoma">
      <data key="d0">Pheochromocytoma</data>
      <data key="d1">category</data>
      <data key="d2">A tumor originating in the adrenal medulla that can cause high blood pressure, headaches, rapid heartbeat, and sweating; most are benign but can be cancerous.</data>
      <data key="d3">chunk-7102a43dfb62e649d725bc95ba292688</data>
    </node>
    <node id="Beckwith-Wiedemann Syndrome">
      <data key="d0">Beckwith-Wiedemann Syndrome</data>
      <data key="d1">category</data>
      <data key="d2">A hereditary genetic condition linked to an increased risk of developing adrenal tumors and kidney tumors.</data>
      <data key="d3">chunk-7102a43dfb62e649d725bc95ba292688</data>
    </node>
    <node id="Carney Complex">
      <data key="d0">Carney Complex</data>
      <data key="d1">category</data>
      <data key="d2">A genetic condition identified as a hereditary risk factor for adrenal tumor development.&lt;SEP&gt;Carney complex is an inherited syndrome identified as a risk factor for the development of thyroid cancer.</data>
      <data key="d3">chunk-7102a43dfb62e649d725bc95ba292688&lt;SEP&gt;chunk-18b5e32980f3efa0cd012e2abab9b9fc</data>
    </node>
    <node id="Familial Adenomatous Polyposis">
      <data key="d0">Familial Adenomatous Polyposis</data>
      <data key="d1">category</data>
      <data key="d2">A hereditary condition that can elevate the risk of developing adrenal tumors.&lt;SEP&gt;An inherited genetic disorder category characterized by the development of numerous polyps that significantly elevate the risk of colon cancer.&lt;SEP&gt;An inherited genetic disorder causing hundreds to thousands of precancerous polyps to develop in the colon and rectum, often leading to cancer.&lt;SEP&gt;Familial adenomatous polyposis (FAP) is a rare inherited cancer syndrome characterized by the growth of hundreds to thousands of polyps in the colon and rectum.&lt;SEP&gt;Familial adenomatous polyposis (FAP) is an inherited condition recognized as a syndrome related to an increased risk of thyroid cancer.</data>
      <data key="d3">chunk-85e75e869fcfcb7c5431dbcdd532137f&lt;SEP&gt;chunk-7102a43dfb62e649d725bc95ba292688&lt;SEP&gt;chunk-18b5e32980f3efa0cd012e2abab9b9fc&lt;SEP&gt;chunk-ee254e84e63bd35682ed56c41cef9247&lt;SEP&gt;chunk-925a474b4538dda470bfd817f9d9a17d</data>
    </node>
    <node id="Hereditary Paraganglioma-Pheochromocytoma Syndrome">
      <data key="d0">Hereditary Paraganglioma-Pheochromocytoma Syndrome</data>
      <data key="d1">category</data>
      <data key="d2">A genetic condition predisposing individuals to pheochromocytomas and adrenal tumors.</data>
      <data key="d3">chunk-7102a43dfb62e649d725bc95ba292688</data>
    </node>
    <node id="Li-Fraumeni Syndrome">
      <data key="d0">Li-Fraumeni Syndrome</data>
      <data key="d1">category</data>
      <data key="d2">A hereditary cancer predisposition syndrome associated with an elevated risk of adrenal tumors.&lt;SEP&gt;A hereditary health condition linked to an increased risk of developing pancreatic cancer.</data>
      <data key="d3">chunk-6268b6efa690f6e094e443dca6b4cb52&lt;SEP&gt;chunk-7102a43dfb62e649d725bc95ba292688</data>
    </node>
    <node id="Lynch Syndrome">
      <data key="d0">Lynch Syndrome</data>
      <data key="d1">category</data>
      <data key="d2">A genetic hereditary condition that increases the risk of developing certain tumors, including adrenal tumors.&lt;SEP&gt;A hereditary genetic condition associated with increased susceptibility to ovarian cancer and other malignancies.&lt;SEP&gt;An inherited cancer syndrome caused by genetic mutations in mismatch repair genes, significantly increasing the risk of colon, endometrial, and ovarian cancers.&lt;SEP&gt;An inherited cancer syndrome that is tested for when rectal tumors demonstrate mismatch repair deficiency (dMMR) or high microsatellite instability (MSI-H).&lt;SEP&gt;An inherited genetic condition that increases the risk of cancers in the urinary tract, including bladder cancer.&lt;SEP&gt;An inherited genetic disorder that predisposes individuals to colon, uterine, ovarian, and other cancers.&lt;SEP&gt;An inherited genetic disorder that significantly increases the risk of developing various cancers, including upper urinary tract and bladder cancer.&lt;SEP&gt;An inherited genetic syndrome associated with a higher likelihood of pancreatic cancer.&lt;SEP&gt;An inherited genetic syndrome category associated with an increased hereditary risk for developing colorectal cancer.&lt;SEP&gt;Lynch syndrome is an inherited cancer syndrome caused by mutations in mismatch repair (MMR) genes that places individuals at higher risk for colorectal, endometrial, and ovarian cancers.</data>
      <data key="d3">chunk-77ac570b4029abb181150e0d0975aefb&lt;SEP&gt;chunk-6268b6efa690f6e094e443dca6b4cb52&lt;SEP&gt;chunk-85e75e869fcfcb7c5431dbcdd532137f&lt;SEP&gt;chunk-7102a43dfb62e649d725bc95ba292688&lt;SEP&gt;chunk-7a890e27eba8c63d10f19b85a72fc14a&lt;SEP&gt;chunk-ee254e84e63bd35682ed56c41cef9247&lt;SEP&gt;chunk-ae40f53e9d867c255e1e6901f5cfb058&lt;SEP&gt;chunk-925a474b4538dda470bfd817f9d9a17d&lt;SEP&gt;chunk-8aa2c7020ce6e89888e81972588726e3&lt;SEP&gt;chunk-594536d6aaa61f8f1699ba50bf218a33</data>
    </node>
    <node id="Multiple Endocrine Neoplasia Type 1">
      <data key="d0">Multiple Endocrine Neoplasia Type 1</data>
      <data key="d1">category</data>
      <data key="d2">A hereditary syndrome that predisposes individuals to tumors in endocrine glands, including adrenal tumors.</data>
      <data key="d3">chunk-7102a43dfb62e649d725bc95ba292688</data>
    </node>
    <node id="Multiple Endocrine Neoplasia Type 2">
      <data key="d0">Multiple Endocrine Neoplasia Type 2</data>
      <data key="d1">category</data>
      <data key="d2">A genetic disorder that increases the risk of developing endocrine tumors, including adrenal tumors.</data>
      <data key="d3">chunk-7102a43dfb62e649d725bc95ba292688</data>
    </node>
    <node id="Neurofibromatosis Type 1">
      <data key="d0">Neurofibromatosis Type 1</data>
      <data key="d1">category</data>
      <data key="d2">A hereditary condition predisposing patients to the development of adrenal tumors.</data>
      <data key="d3">chunk-7102a43dfb62e649d725bc95ba292688</data>
    </node>
    <node id="Von Hippel-Lindau Syndrome">
      <data key="d0">Von Hippel-Lindau Syndrome</data>
      <data key="d1">category</data>
      <data key="d2">A genetic condition that predisposes individuals to both adrenal and kidney tumors.</data>
      <data key="d3">chunk-7102a43dfb62e649d725bc95ba292688</data>
    </node>
    <node id="Kidney Cancer">
      <data key="d0">Kidney Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A disease category involving neoplasms originating in the kidneys, including renal cell carcinoma (RCC) subtypes.&lt;SEP&gt;A general category of cancers that originate in the tissues of the kidneys, predominantly comprising renal cell carcinomas.&lt;SEP&gt;A type of cancer associated with some of the same hereditary genetic risk factors as adrenal tumors.</data>
      <data key="d3">chunk-7102a43dfb62e649d725bc95ba292688&lt;SEP&gt;chunk-37bca9f4d2ebaeed359c9b4eb7a0c1de&lt;SEP&gt;chunk-48e138ec8da954a5667dc785e919c86b</data>
    </node>
    <node id="Adrenal Tumor">
      <data key="d0">Adrenal Tumor</data>
      <data key="d1">category</data>
      <data key="d2">An abnormal growth of cells located in one or both of the adrenal glands, which may be benign or malignant, and functioning or nonfunctioning.</data>
      <data key="d3">chunk-7102a43dfb62e649d725bc95ba292688</data>
    </node>
    <node id="Functioning Tumor">
      <data key="d0">Functioning Tumor</data>
      <data key="d1">category</data>
      <data key="d2">A classification of adrenal tumor that produces hormones, leading to diverse systemic symptoms such as weight gain, high blood pressure, or hormonal changes.</data>
      <data key="d3">chunk-7102a43dfb62e649d725bc95ba292688</data>
    </node>
    <node id="Nonfunctioning Tumor">
      <data key="d0">Nonfunctioning Tumor</data>
      <data key="d1">category</data>
      <data key="d2">A classification of adrenal tumor that does not produce excess hormones and typically causes symptoms only if it grows large enough to press on adjacent organs.</data>
      <data key="d3">chunk-7102a43dfb62e649d725bc95ba292688</data>
    </node>
    <node id="Genetic Tests">
      <data key="d0">Genetic Tests</data>
      <data key="d1">category</data>
      <data key="d2">Diagnostic tests that detect inherited gene mutations linked to hereditary cancer syndromes and elevated cancer risks.&lt;SEP&gt;Laboratory tests that analyze DNA to identify inherited mutations, diagnose cancer, and guide clinical treatment planning.&lt;SEP&gt;Medical diagnostic tests that evaluate DNA to identify hereditary mutations associated with an increased risk of developing adrenal tumors.&lt;SEP&gt;Tests used to detect inherited genetic mutations that heighten the risk of prostate cancer.</data>
      <data key="d3">chunk-6268b6efa690f6e094e443dca6b4cb52&lt;SEP&gt;chunk-7102a43dfb62e649d725bc95ba292688&lt;SEP&gt;chunk-67e9c4dc95841db7d0af39e1267ae71b&lt;SEP&gt;chunk-697db1653f51e966e79b92eefeb01ec6</data>
    </node>
    <node id="General Health Tests">
      <data key="d0">General Health Tests</data>
      <data key="d1">category</data>
      <data key="d2">A baseline category of clinical assessments, including vital signs, physical checks, and history taking, used to gauge overall patient health.&lt;SEP&gt;A diagnostic category covering broad physical assessments used to gauge overall patient baseline health before and during cancer care.&lt;SEP&gt;A diagnostic evaluation category encompassing medical history assessments, nutritional assessments, and medication reviews used to guide cancer treatment selection.&lt;SEP&gt;A group of baseline clinical tests and evaluations administered to determine a patient's overall health prior to treatment.&lt;SEP&gt;An overarching category of foundational clinical evaluations, encompassing medical histories and routine screenings, used to understand patient baseline health.&lt;SEP&gt;Baseline clinical evaluations including performance status, medical history, and cardiac assessments used to guide cancer treatment.&lt;SEP&gt;Comprehensive baseline evaluations, including medical history and physical health assessments, conducted prior to oncologic therapy.&lt;SEP&gt;Evaluations of a patient's overall health conducted alongside cancer assessments to aid treatment planning.&lt;SEP&gt;Foundational diagnostic assessments including medical history, family health history, and physical examinations.&lt;SEP&gt;Routine medical examinations and diagnostic assessments conducted to evaluate the overall health status of a patient undergoing tumor evaluation.</data>
      <data key="d3">chunk-a06038ec84f20e873b9e275a23aea8d9&lt;SEP&gt;chunk-6232dd9ed168a1113955e7300645338b&lt;SEP&gt;chunk-c37f547042fc10baabdbfaadf010bce5&lt;SEP&gt;chunk-7102a43dfb62e649d725bc95ba292688&lt;SEP&gt;chunk-cb36cedd3f66584d65304e58b668eeab&lt;SEP&gt;chunk-aa14ecd19e2d721cb99ea9590f0ede3a&lt;SEP&gt;chunk-69e63736c94b8b08a565c3d8679d3b57&lt;SEP&gt;chunk-7390896141393e0b4d1c15df77b5c0a7&lt;SEP&gt;chunk-c77e0d4642a374a51f87e7e25b19281f&lt;SEP&gt;chunk-829d6b7840e9f2c8d97d22d2ce2c43c1</data>
    </node>
    <node id="Primary Care Physician">
      <data key="d0">Primary Care Physician</data>
      <data key="d1">person</data>
      <data key="d2">A Primary Care Physician (PCP) is a general healthcare provider who acts as a partner in a patient's care and assists in making screening decisions.&lt;SEP&gt;A general health provider (PCP) who coordinates overall patient healthcare and requires regular updates about cancer diagnoses and treatment changes.&lt;SEP&gt;A general medical doctor responsible for coordinating a patient's overall ongoing healthcare and maintaining records alongside the oncology care team.&lt;SEP&gt;A general medical practitioner who acts as a long-term care partner and needs to be kept informed about the patient's cancer diagnosis and treatment plans.&lt;SEP&gt;A general medical practitioner who can assist patients in coordinating general health and communicating with the cancer oncology team.&lt;SEP&gt;A general medical practitioner who coordinates overarching patient care and stays informed regarding specialist treatments and test results.&lt;SEP&gt;A general medical practitioner who coordinates with oncologists to oversee patient follow-up and general health during cancer survivorship.&lt;SEP&gt;A general medical practitioner who serves as a partner in patient care, kept informed of cancer diagnosis, treatment plans, and updates.&lt;SEP&gt;A patient's principal doctor responsible for comprehensive healthcare who coordinates with the broader care team.&lt;SEP&gt;A patient's principal general doctor responsible for overall health management, coordination of care, and medical history maintenance.&lt;SEP&gt;A patient's principal general doctor who coordinates long-term healthcare and partners with oncology specialists throughout cancer treatment.&lt;SEP&gt;A patient's principal general medical doctor who coordinates overall healthcare alongside specialized oncology care.&lt;SEP&gt;A patient's principal general practitioner who must be kept informed of oncology diagnoses and treatment updates.&lt;SEP&gt;A patient's regular doctor recommended to be kept informed and actively involved as a partner during cancer diagnosis and treatment.&lt;SEP&gt;A personal doctor who collaborates with the broader care team and remains informed about the patient's ongoing diagnosis and cancer treatment.&lt;SEP&gt;A personal healthcare provider who acts as a key ongoing partner in patient care and is kept informed about diagnoses and treatment regimens.&lt;SEP&gt;A personal healthcare provider who maintains ongoing health history and collaborates with oncology care teams to support patient care.&lt;SEP&gt;A primary care doctor responsible for general medical care, kept updated on a patient's cancer diagnosis and treatment status.&lt;SEP&gt;A primary care physician (PCP) is a general healthcare provider whom patients keep informed about cancer diagnosis, treatment changes, and overall health status.&lt;SEP&gt;The primary care physician (PCP) is the general medical practitioner who coordinates overall patient health and should be updated regarding cancer treatments.</data>
      <data key="d3">chunk-6236b93e627d54f73f1c8fe341127e67&lt;SEP&gt;chunk-7a890e27eba8c63d10f19b85a72fc14a&lt;SEP&gt;chunk-38185832d6395b9952def9a72ecc339d&lt;SEP&gt;chunk-711bee9440e11d7c737bc4a49b880910&lt;SEP&gt;chunk-aa14ecd19e2d721cb99ea9590f0ede3a&lt;SEP&gt;chunk-5fdcf47f3da06d3e0213112c96eb93d4&lt;SEP&gt;chunk-d47a420aa2acde1175ad95bf6dc2e664&lt;SEP&gt;chunk-829d6b7840e9f2c8d97d22d2ce2c43c1&lt;SEP&gt;chunk-64f36a4a5be80c8fa51631db16e52b85&lt;SEP&gt;chunk-db3a86fc5d439d9bfb3845e468a2a551&lt;SEP&gt;chunk-82c7205fc2067a4d00e43fd22276db22&lt;SEP&gt;chunk-a06038ec84f20e873b9e275a23aea8d9&lt;SEP&gt;chunk-a08bd0a819ea613e781d07188a350438&lt;SEP&gt;chunk-1dc8d8e5ed4f165f3e56305a7644ba05&lt;SEP&gt;chunk-ef6586b896c47b361bf4f6aabb4c35d5&lt;SEP&gt;chunk-7606b44d6a30ad0519bc4c10785de79a&lt;SEP&gt;chunk-c37f547042fc10baabdbfaadf010bce5&lt;SEP&gt;chunk-7102a43dfb62e649d725bc95ba292688&lt;SEP&gt;chunk-f9a9eb8b01f29fdf214c10bdffac3203&lt;SEP&gt;chunk-c77e0d4642a374a51f87e7e25b19281f</data>
    </node>
    <node id="Radiologist">
      <data key="d0">Radiologist</data>
      <data key="d1">person</data>
      <data key="d2">A medical doctor and expert in interpreting diagnostic imaging tests who shares results with the care team.&lt;SEP&gt;A medical doctor specializing in interpreting diagnostic imaging tests and generating reports for the patient's care team.&lt;SEP&gt;A medical doctor who specializes in reading and interpreting diagnostic imaging tests to assist in patient evaluation.&lt;SEP&gt;A medical doctor who specializes in reading, interpreting, and reporting the results of diagnostic imaging tests.&lt;SEP&gt;A medical expert specializing in interpreting imaging tests and reporting findings to the patient's physician or care team.&lt;SEP&gt;A medical imaging specialist involved in evaluating diagnostic scans for thyroid cancer management.&lt;SEP&gt;A medical physician who evaluates diagnostic CT scans and communicates the results to the treating oncologist.&lt;SEP&gt;A medical professional who specializes in interpreting diagnostic imaging tests and generating clinical reports for health care providers and patients.&lt;SEP&gt;A medical specialist responsible for analyzing and interpreting imaging tests and preparing diagnostic reports for physicians.&lt;SEP&gt;A medical specialist trained in interpreting imaging tests and issuing diagnostic reports to health care providers.&lt;SEP&gt;A medical specialist who analyzes MRI and CT imaging scans of the nervous system and reports findings to the care team.&lt;SEP&gt;A medical specialist who evaluates diagnostic mammograms and other imaging tests to determine if additional testing is required.&lt;SEP&gt;A medical specialist who examines and interprets nervous system imaging scans such as MRIs and CTs and communicates the findings to the care team.&lt;SEP&gt;A medical specialist who examines medical images, including PET and CT scans, to evaluate tissue structures and tracer uptake.&lt;SEP&gt;A medical specialist who interprets diagnostic imaging results and conveys the findings to the oncologist.&lt;SEP&gt;A medical specialist who interprets imaging scans like CT and MRI and prepares reports for health care providers.&lt;SEP&gt;A medical specialist who interprets imaging test scans and communicates diagnostic findings to the oncologist.&lt;SEP&gt;A radiologist is a medical professional who interprets diagnostic imaging test results and communicates them to the cancer care team.&lt;SEP&gt;A radiologist is a medical specialist who evaluates diagnostic mammograms and determines whether immediate follow-up testing is needed.&lt;SEP&gt;A radiologist is a specialized medical physician who analyzes and interprets imaging studies and issues diagnostic reports for clinical management.&lt;SEP&gt;A specialized medical doctor who interprets and studies imaging scans and forwards findings to the primary doctor to assist in care planning.&lt;SEP&gt;A specialized medical doctor who interprets diagnostic imaging test images and prepares reports for treating physicians.</data>
      <data key="d3">chunk-0bd86bf8fc82f14fa5f7f51d924514e7&lt;SEP&gt;chunk-1e017cd4fd8af1ebbcb582a93fbfe1ea&lt;SEP&gt;chunk-ee254e84e63bd35682ed56c41cef9247&lt;SEP&gt;chunk-aa14ecd19e2d721cb99ea9590f0ede3a&lt;SEP&gt;chunk-67e9c4dc95841db7d0af39e1267ae71b&lt;SEP&gt;chunk-3fbf2f6a3c150687a59f814d94f1d150&lt;SEP&gt;chunk-6eafb110f88c7af38808f77f59ed155d&lt;SEP&gt;chunk-052101b592e186cce702983d2acc67e4&lt;SEP&gt;chunk-db4e8318949a3fda5683c53985c6af05&lt;SEP&gt;chunk-aeafa486bfd320cdaa7811ad75777912&lt;SEP&gt;chunk-925a474b4538dda470bfd817f9d9a17d&lt;SEP&gt;chunk-4724f6acaaa7931560b29614efc2927f&lt;SEP&gt;chunk-5fa7c7369d88ae71c842152510867223&lt;SEP&gt;chunk-705ff2bd04b2b58b98187f60f23a659e&lt;SEP&gt;chunk-49c7ff3a71e74b3f0eb59258541e739e&lt;SEP&gt;chunk-594536d6aaa61f8f1699ba50bf218a33&lt;SEP&gt;chunk-9dc281a303d0d4c5300c0c1c45b739ed&lt;SEP&gt;chunk-a0d4d6b091e033fd01aa721422b68ef5&lt;SEP&gt;chunk-7390896141393e0b4d1c15df77b5c0a7&lt;SEP&gt;chunk-76a038845aaedb9ef7852018f26778b3&lt;SEP&gt;chunk-a2778e34af702d49d5e70867726e14b2&lt;SEP&gt;chunk-67015f3916810c4378b2ed269cc27f29</data>
    </node>
    <node id="Medical History">
      <data key="d0">Medical History</data>
      <data key="d1">category</data>
      <data key="d2">A clinical assessment gathering records of past illnesses, surgeries, treatments, symptoms, and medications to inform patient treatment plans.&lt;SEP&gt;A clinical assessment record of past illness, injury, symptoms, medications, and supplements used to guide treatment decisions.&lt;SEP&gt;A clinical evaluation record category covering lifetime illnesses, prior treatments, medications, supplements, and previous infections like H. pylori.&lt;SEP&gt;A comprehensive clinical consultation where the care team reviews a patient's illnesses, family health history, lifestyle, and symptoms.&lt;SEP&gt;A comprehensive clinical record documenting past illnesses, treatments, symptoms, supplements, and prescription medications to evaluate treatment options.&lt;SEP&gt;A comprehensive lifetime record of illnesses, injuries, prescription medicines, OTC drugs, and supplements used to guide clinical care.&lt;SEP&gt;A comprehensive record of a patient's past health issues, illnesses, injuries, prescription medicines, OTC drugs, and supplements used to guide cancer treatment.&lt;SEP&gt;A comprehensive record of a patient's past illnesses, treatments, injuries, symptoms, and medications used to determine optimal treatment plans.&lt;SEP&gt;A comprehensive record of an individual's past and present health issues, treatments, medications, supplements, and symptoms.&lt;SEP&gt;A medical history is a comprehensive record of a person's prior health issues, illnesses, injuries, treatments, and medications used to determine optimal treatment.&lt;SEP&gt;A record of past illnesses, injuries, medications, and treatments used to assist care teams in determining appropriate cancer treatment.&lt;SEP&gt;A structured clinical assessment capturing a patient's lifelong health issues, treatments, symptoms, prescription drugs, over-the-counter medicines, and supplements.</data>
      <data key="d3">chunk-a06038ec84f20e873b9e275a23aea8d9&lt;SEP&gt;chunk-ae28e3852f4a9f229250fc19eb39036b&lt;SEP&gt;chunk-f43f96815f23658d5b24fe95ed4bd5ed&lt;SEP&gt;chunk-ba28a3ce3534c0655a0d08a953d7f038&lt;SEP&gt;chunk-aa14ecd19e2d721cb99ea9590f0ede3a&lt;SEP&gt;chunk-717174ace5855cc823d51c46c9a70648&lt;SEP&gt;chunk-69e63736c94b8b08a565c3d8679d3b57&lt;SEP&gt;chunk-7390896141393e0b4d1c15df77b5c0a7&lt;SEP&gt;chunk-5846f51c2ca4fae54459ce9c50e3e820&lt;SEP&gt;chunk-c77e0d4642a374a51f87e7e25b19281f&lt;SEP&gt;chunk-d47a420aa2acde1175ad95bf6dc2e664&lt;SEP&gt;chunk-829d6b7840e9f2c8d97d22d2ce2c43c1</data>
    </node>
    <node id="Family Health History">
      <data key="d0">Family Health History</data>
      <data key="d1">category</data>
      <data key="d2">A record of health conditions and diseases present among biological relatives to evaluate genetic and hereditary risks.</data>
      <data key="d3">chunk-aa14ecd19e2d721cb99ea9590f0ede3a</data>
    </node>
    <node id="MRI Scan">
      <data key="d0">MRI Scan</data>
      <data key="d1">category</data>
      <data key="d2">A diagnostic imaging procedure utilizing radio waves and strong magnetic fields to obtain detailed images of prostate cancer, pelvic lymph nodes, and bones.&lt;SEP&gt;A diagnostic imaging test using strong magnets to produce images of the inside of the body without radiation, available in closed or open formats.&lt;SEP&gt;A magnetic resonance imaging scan that uses radio waves and powerful magnetic fields rather than x-rays to create detailed images of internal body structures.&lt;SEP&gt;A magnetic resonance imaging scan that utilizes powerful magnetic fields and radio waves without radiation to produce detailed images of internal tissues.&lt;SEP&gt;A magnetic resonance imaging scan that utilizes powerful magnets and radio waves without x-rays to capture internal body images.&lt;SEP&gt;A magnetic resonance imaging scan used to visualize tumors and lesions in the brain and spinal column in suspected or diagnosed central nervous system lymphoma.&lt;SEP&gt;A magnetic resonance imaging test that utilizes radio waves and strong magnetic fields rather than x-rays to create detailed internal images.&lt;SEP&gt;A magnetic resonance imaging test using radio waves and strong magnets rather than x-rays to visualize internal tissues and cancer spread.&lt;SEP&gt;A medical imaging scan used to determine the exact size and dimensions of the prostate for diagnostic calculations.&lt;SEP&gt;An MRI scan is a diagnostic imaging procedure that utilizes radio waves and powerful magnetic fields rather than radiation to image internal body structures.&lt;SEP&gt;Magnetic resonance imaging scans of the prostate used to detect lesions and combined with ultrasound for targeted sampling.&lt;SEP&gt;Magnetic resonance imaging, an imaging procedure using radio waves and magnets to provide detailed pictures of soft tissues, the prostate, and nearby structures.</data>
      <data key="d3">chunk-705ff2bd04b2b58b98187f60f23a659e&lt;SEP&gt;chunk-975e540ddee1810d43caf8df4adcf205&lt;SEP&gt;chunk-29c9b8b5fd2cd967c48522af79a9598f&lt;SEP&gt;chunk-1d61a5e7031ea811cc4dcc55a0a0e8fa&lt;SEP&gt;chunk-aeafa486bfd320cdaa7811ad75777912&lt;SEP&gt;chunk-fba176235a4410ba8723447134c92579&lt;SEP&gt;chunk-9ad38c9dc069a8ff8df58c42f00eba23&lt;SEP&gt;chunk-aa14ecd19e2d721cb99ea9590f0ede3a&lt;SEP&gt;chunk-67e9c4dc95841db7d0af39e1267ae71b&lt;SEP&gt;chunk-5fa7c7369d88ae71c842152510867223&lt;SEP&gt;chunk-3fbf2f6a3c150687a59f814d94f1d150&lt;SEP&gt;chunk-a2778e34af702d49d5e70867726e14b2</data>
    </node>
    <node id="PET Scan">
      <data key="d0">PET Scan</data>
      <data key="d1">event</data>
      <data key="d2">A PET scan is an imaging test involving a radioactive tracer injected into the bloodstream to locate active cancer cells.&lt;SEP&gt;A diagnostic imaging test using a radioactive sugar tracer to detect actively metabolizing cancer cells.&lt;SEP&gt;A diagnostic scanning procedure using an injected radioactive drug to identify metabolically active cancer cells in the body.&lt;SEP&gt;A positron emission tomography scan that employs radioactive tracers to detect metabolic activity and locate cancer cells.&lt;SEP&gt;A positron emission tomography scan utilizing a radioactive sugar tracer to detect actively growing cancer cells, infection, or inflammation.&lt;SEP&gt;A positron emission tomography scan utilizing a radioactive tracer injected into a vein to identify cancer cells and metabolic activity in the body.&lt;SEP&gt;A positron emission tomography scan utilizing radioactive tracers to visualize active cancer cells, often combined with CT or MRI.&lt;SEP&gt;An imaging test that uses a radioactive tracer to detect active cancer cells and assess their sugar uptake and growth rate.&lt;SEP&gt;An imaging test using injected radioactive tracers to identify active cancer cells, assess metastasis, and evaluate response to treatment.&lt;SEP&gt;Positron emission tomography is a nuclear imaging scan utilizing a radioactive tracer to detect abnormal metabolic activity characteristic of cancer cells.&lt;SEP&gt;Positron emission tomography is a nuclear imaging test using sugar radiotracers to detect cancer cells based on metabolic activity.&lt;SEP&gt;Positron emission tomography scan measuring cellular sugar metabolism, often combined with CT or MRI to evaluate cancer.&lt;SEP&gt;Positron emission tomography scan, a medical imaging technique that uses a radioactive tracer to detect active cancer cells and assess their growth.&lt;SEP&gt;Positron emission tomography, an imaging scan that uses a radioactive tracer to detect cancer cells by measuring sugar metabolism in the body.&lt;SEP&gt;Positron emission tomography, an imaging scan that utilizes an injected radioactive tracer to detect active cancer cells and evaluate metastasis.</data>
      <data key="d3">chunk-705ff2bd04b2b58b98187f60f23a659e&lt;SEP&gt;chunk-50531346164ea7c08dd087a868b3cc2a&lt;SEP&gt;chunk-29c9b8b5fd2cd967c48522af79a9598f&lt;SEP&gt;chunk-aeafa486bfd320cdaa7811ad75777912&lt;SEP&gt;chunk-9ad38c9dc069a8ff8df58c42f00eba23&lt;SEP&gt;chunk-3fbf2f6a3c150687a59f814d94f1d150&lt;SEP&gt;chunk-e5406c28b41e499fad4ae44f2c44fdd7&lt;SEP&gt;chunk-aa14ecd19e2d721cb99ea9590f0ede3a&lt;SEP&gt;chunk-ae40f53e9d867c255e1e6901f5cfb058&lt;SEP&gt;chunk-67e9c4dc95841db7d0af39e1267ae71b&lt;SEP&gt;chunk-30c0bb66b1a2f93e89f5342ab1077451&lt;SEP&gt;chunk-76a038845aaedb9ef7852018f26778b3&lt;SEP&gt;chunk-6eafb110f88c7af38808f77f59ed155d&lt;SEP&gt;chunk-a2778e34af702d49d5e70867726e14b2&lt;SEP&gt;chunk-be6e1cb2fe11f4d9962741c30d446a69</data>
    </node>
    <node id="FDG-PET/CT Scan">
      <data key="d0">FDG-PET/CT Scan</data>
      <data key="d1">category</data>
      <data key="d2">A combined diagnostic scan utilizing a radioactive glucose tracer (18-fluorodeoxyglucose) to identify rapidly metabolizing cancer cells in adrenal tumors.&lt;SEP&gt;A hybrid imaging technique utilizing a radioactive glucose tracer (18-fluorodeoxyglucose) to evaluate cellular metabolic activity and tumor aggressiveness.&lt;SEP&gt;An advanced imaging modality combining fluorodeoxyglucose positron emission tomography and computed tomography, scanning from neck to mid-thigh.</data>
      <data key="d3">chunk-aa14ecd19e2d721cb99ea9590f0ede3a&lt;SEP&gt;chunk-f1379433bc205cdec8af2edc77613acb&lt;SEP&gt;chunk-b3ba7430f3a31330247f52afe7e9c68a</data>
    </node>
    <node id="Contrast Materials">
      <data key="d0">Contrast Materials</data>
      <data key="d1">category</data>
      <data key="d2">Substances (oral or intravenous) used during imaging procedures like CT or MRI to enhance and clarify pictures of internal organs and structures.</data>
      <data key="d3">chunk-aa14ecd19e2d721cb99ea9590f0ede3a</data>
    </node>
    <node id="Heart Disease">
      <data key="d0">Heart Disease</data>
      <data key="d1">category</data>
      <data key="d2">A cardiovascular condition tracked within personal and family medical histories to assess hereditary health risks.&lt;SEP&gt;A category of cardiovascular health conditions assessed as part of a patient's comprehensive family health history.&lt;SEP&gt;A category of cardiovascular illnesses documented as part of family health history to identify hereditary risks.&lt;SEP&gt;A chronic cardiovascular condition tracked as part of family medical history to evaluate hereditary and overall health risks.&lt;SEP&gt;A chronic cardiovascular condition tracked as part of personal and family health histories.&lt;SEP&gt;A group of cardiovascular medical conditions documented during family health history evaluations.</data>
      <data key="d3">chunk-9dc281a303d0d4c5300c0c1c45b739ed&lt;SEP&gt;chunk-711bee9440e11d7c737bc4a49b880910&lt;SEP&gt;chunk-aa14ecd19e2d721cb99ea9590f0ede3a&lt;SEP&gt;chunk-5fdcf47f3da06d3e0213112c96eb93d4&lt;SEP&gt;chunk-69e63736c94b8b08a565c3d8679d3b57&lt;SEP&gt;chunk-7390896141393e0b4d1c15df77b5c0a7</data>
    </node>
    <node id="Diabetes">
      <data key="d0">Diabetes</data>
      <data key="d1">category</data>
      <data key="d2">A chronic metabolic condition screened as part of a patient's medical and family health history.&lt;SEP&gt;A chronic metabolic condition tracked as part of personal and family health histories.&lt;SEP&gt;A chronic metabolic disorder recorded in family health histories to identify hereditary health risks.&lt;SEP&gt;A chronic metabolic disorder tracked in patient and family medical histories.&lt;SEP&gt;A chronic metabolic health condition identified as a risk factor for pancreatic cancer.&lt;SEP&gt;A metabolic condition evaluated during medical and family history collection.&lt;SEP&gt;A metabolic health condition recorded during the patient's family health history review.</data>
      <data key="d3">chunk-6268b6efa690f6e094e443dca6b4cb52&lt;SEP&gt;chunk-9dc281a303d0d4c5300c0c1c45b739ed&lt;SEP&gt;chunk-711bee9440e11d7c737bc4a49b880910&lt;SEP&gt;chunk-aa14ecd19e2d721cb99ea9590f0ede3a&lt;SEP&gt;chunk-5fdcf47f3da06d3e0213112c96eb93d4&lt;SEP&gt;chunk-69e63736c94b8b08a565c3d8679d3b57&lt;SEP&gt;chunk-7390896141393e0b4d1c15df77b5c0a7</data>
    </node>
    <node id="Cancer">
      <data key="d0">Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A broad category of diseases characterized by the uncontrolled growth and proliferation of abnormal cells.&lt;SEP&gt;A broad category of malignant diseases, including AML, that is tracked in patient medical and family histories.&lt;SEP&gt;A broad group of diseases involving abnormal cell growth that can run in families and requires specialized tracking, imaging, and treatments.&lt;SEP&gt;A major disease category involving abnormal cell proliferation that can run in families and affect various organs.</data>
      <data key="d3">chunk-aa14ecd19e2d721cb99ea9590f0ede3a&lt;SEP&gt;chunk-69e63736c94b8b08a565c3d8679d3b57&lt;SEP&gt;chunk-4966a628b12ecec4187796598764cf23&lt;SEP&gt;chunk-7390896141393e0b4d1c15df77b5c0a7</data>
    </node>
    <node id="Stroke">
      <data key="d0">Stroke</data>
      <data key="d1">category</data>
      <data key="d2">A serious medical cerebrovascular event documented as part of personal and family health histories.</data>
      <data key="d3">chunk-aa14ecd19e2d721cb99ea9590f0ede3a</data>
    </node>
    <node id="High Blood Pressure">
      <data key="d0">High Blood Pressure</data>
      <data key="d1">category</data>
      <data key="d2">A common chronic health condition evaluated during physical exams and recorded in health histories.</data>
      <data key="d3">chunk-aa14ecd19e2d721cb99ea9590f0ede3a</data>
    </node>
    <node id="High Cholesterol">
      <data key="d0">High Cholesterol</data>
      <data key="d1">category</data>
      <data key="d2">A chronic metabolic condition recorded when gathering family health history.</data>
      <data key="d3">chunk-aa14ecd19e2d721cb99ea9590f0ede3a</data>
    </node>
    <node id="SSTR-PET Scan">
      <data key="d0">SSTR-PET Scan</data>
      <data key="d1">category</data>
      <data key="d2">A specialized somatostatin receptor positron emission tomography scan used in patients with neuroendocrine and adrenal tumors.</data>
      <data key="d3">chunk-aa14ecd19e2d721cb99ea9590f0ede3a</data>
    </node>
    <node id="Basal Cell Carcinoma">
      <data key="d0">Basal Cell Carcinoma</data>
      <data key="d1">category</data>
      <data key="d2">The most common type of skin cancer, arising from basal cells in the lower epidermis, grouped with squamous cell cancer as nonmelanoma skin cancer.</data>
      <data key="d3">chunk-f1379433bc205cdec8af2edc77613acb</data>
    </node>
    <node id="Nonmelanoma Skin Cancers">
      <data key="d0">Nonmelanoma Skin Cancers</data>
      <data key="d1">category</data>
      <data key="d2">A classification of skin cancers that includes basal cell carcinoma and squamous cell carcinoma, also referred to as keratinocyte carcinomas.</data>
      <data key="d3">chunk-f1379433bc205cdec8af2edc77613acb</data>
    </node>
    <node id="Sun Exposure">
      <data key="d0">Sun Exposure</data>
      <data key="d1">category</data>
      <data key="d2">Ultraviolet radiation from sunlight, recognized as a primary risk factor for squamous cell carcinoma.</data>
      <data key="d3">chunk-f1379433bc205cdec8af2edc77613acb</data>
    </node>
    <node id="Indoor Tanning">
      <data key="d0">Indoor Tanning</data>
      <data key="d1">category</data>
      <data key="d2">The use of artificial tanning devices such as booths and beds, representing a major risk factor for developing skin cancers.</data>
      <data key="d3">chunk-f1379433bc205cdec8af2edc77613acb</data>
    </node>
    <node id="Environmental Toxins">
      <data key="d0">Environmental Toxins</data>
      <data key="d1">category</data>
      <data key="d2">Harmful environmental agents, including tobacco smoke, vehicular exhaust, and arsenic, that induce skin damage and raise the risk of developing squamous cell carcinoma.&lt;SEP&gt;Harmful pollutants including tobacco smoke, vehicle exhaust, and arsenic that can induce skin damage and malignancy.</data>
      <data key="d3">chunk-3821a6febf2d21784059ac62a6e659c1&lt;SEP&gt;chunk-f1379433bc205cdec8af2edc77613acb</data>
    </node>
    <node id="Neuroendocrine Tumors">
      <data key="d0">Neuroendocrine Tumors</data>
      <data key="d1">category</data>
      <data key="d2">Neuroendocrine tumors are a specific category of lung carcinomas distinct from non-small cell lung cancer.&lt;SEP&gt;Tumors that can be evaluated for aggressiveness and progression using metabolic and receptor-targeted imaging scans.</data>
      <data key="d3">chunk-f1379433bc205cdec8af2edc77613acb&lt;SEP&gt;chunk-ef6586b896c47b361bf4f6aabb4c35d5</data>
    </node>
    <node id="SSTR-PET/CT Scan">
      <data key="d0">SSTR-PET/CT Scan</data>
      <data key="d1">category</data>
      <data key="d2">An imaging scan utilizing a tracer targeted to somatostatin receptors on cell surfaces to evaluate certain tumors.</data>
      <data key="d3">chunk-f1379433bc205cdec8af2edc77613acb</data>
    </node>
    <node id="Biochemical Tests">
      <data key="d0">Biochemical Tests</data>
      <data key="d1">category</data>
      <data key="d2">Diagnostic evaluations measuring hormones and substances in blood, urine, or saliva to assess adrenal tumor activity.</data>
      <data key="d3">chunk-f1379433bc205cdec8af2edc77613acb</data>
    </node>
    <node id="PET/MRI">
      <data key="d0">PET/MRI</data>
      <data key="d1">category</data>
      <data key="d2">A hybrid diagnostic imaging technique combining positron emission tomography and magnetic resonance imaging to detect cancer cells.</data>
      <data key="d3">chunk-f1379433bc205cdec8af2edc77613acb</data>
    </node>
    <node id="18-Fluorodeoxyglucose">
      <data key="d0">18-Fluorodeoxyglucose</data>
      <data key="d1">category</data>
      <data key="d2">A radioactive glucose tracer utilized in FDG-PET imaging that is consumed rapidly by active cancer cells.</data>
      <data key="d3">chunk-f1379433bc205cdec8af2edc77613acb</data>
    </node>
    <node id="Somatostatin">
      <data key="d0">Somatostatin</data>
      <data key="d1">category</data>
      <data key="d2">A regulatory hormone in the body that controls the release and activity of other hormones.</data>
      <data key="d3">chunk-f1379433bc205cdec8af2edc77613acb</data>
    </node>
    <node id="Somatostatin Receptors">
      <data key="d0">Somatostatin Receptors</data>
      <data key="d1">category</data>
      <data key="d2">Cell-surface proteins (SSTRs) found on various cells that bind somatostatin and serve as targets for SSTR-PET imaging.</data>
      <data key="d3">chunk-f1379433bc205cdec8af2edc77613acb</data>
    </node>
    <node id="Skin">
      <data key="d0">Skin</data>
      <data key="d1">category</data>
      <data key="d2">The largest human organ, providing protection against microbes, regulating temperature, and mediating sensation across three distinct layers.</data>
      <data key="d3">chunk-f1379433bc205cdec8af2edc77613acb</data>
    </node>
    <node id="Melanin">
      <data key="d0">Melanin</data>
      <data key="d1">category</data>
      <data key="d2">A biological pigment produced by melanocytes that determines the color of skin, hair, and eyes, and protects tissue from UV damage.</data>
      <data key="d3">chunk-f1379433bc205cdec8af2edc77613acb</data>
    </node>
    <node id="Ultraviolet Rays">
      <data key="d0">Ultraviolet Rays</data>
      <data key="d1">category</data>
      <data key="d2">Electromagnetic radiation from sunlight and indoor tanning beds that damages skin and drives cutaneous carcinogenesis.</data>
      <data key="d3">chunk-f1379433bc205cdec8af2edc77613acb</data>
    </node>
    <node id="Scars and Chronic Wounds">
      <data key="d0">Scars and Chronic Wounds</data>
      <data key="d1">category</data>
      <data key="d2">Persistent dermatological injuries, ulcers, and burns that predispose tissue to cutaneous squamous cell carcinoma.</data>
      <data key="d3">chunk-f1379433bc205cdec8af2edc77613acb</data>
    </node>
    <node id="Marjolin Ulcer">
      <data key="d0">Marjolin Ulcer</data>
      <data key="d1">category</data>
      <data key="d2">A form of squamous cell carcinoma that develops from chronic nonhealing wounds, scars, or burn sites.</data>
      <data key="d3">chunk-f1379433bc205cdec8af2edc77613acb</data>
    </node>
    <node id="Lung Cancer">
      <data key="d0">Lung Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A disease characterized by out-of-control growth of abnormal cells that line the airways and tissues of the lungs, primarily divided into non-small cell and small cell lung cancer.&lt;SEP&gt;A disease originating in lung cells, predominantly occurring as carcinomas lining airway surfaces.&lt;SEP&gt;A form of cancer affecting the respiratory system whose risk is significantly elevated by smoking or vaping.&lt;SEP&gt;A form of malignancy whose risk of development is heightened by a history of smoking or vaping nicotine.&lt;SEP&gt;A malignancy of the respiratory system cited as an example of disease caused by risk factors such as cigarette smoking.&lt;SEP&gt;A malignant respiratory disease whose risk of onset is greatly increased by smoking and vaping nicotine.</data>
      <data key="d3">chunk-705ff2bd04b2b58b98187f60f23a659e&lt;SEP&gt;chunk-3d609bd1a55d409470c55ad55e2d125d&lt;SEP&gt;chunk-f1379433bc205cdec8af2edc77613acb&lt;SEP&gt;chunk-9ad38c9dc069a8ff8df58c42f00eba23&lt;SEP&gt;chunk-08475506372bb4ce9ec1bd326caf0fe9&lt;SEP&gt;chunk-7843955573cdc294b34e74019195fafb</data>
    </node>
    <node id="Squamous Cell Carcinoma">
      <data key="d0">Squamous Cell Carcinoma</data>
      <data key="d1">category</data>
      <data key="d2">A common histological type of cervical cancer treated based on stage and risk factors.&lt;SEP&gt;A form of cancer originating in squamous cells, representing the most common histologic type of anal cancer.&lt;SEP&gt;A histological subtype of cervical cancer evaluated to determine surgical eligibility and risk criteria.&lt;SEP&gt;A prevalent form of skin cancer (also referred to as CSCC) that can develop from sun damage, chronic scars, actinic keratoses, or in immunosuppressed individuals.&lt;SEP&gt;A rare, non-urothelial histological category of bladder cancer.&lt;SEP&gt;A subtype of non-small cell lung cancer that accounts for approximately 3 out of 10 lung cancer cases.&lt;SEP&gt;A subtype of non-small cell lung cancer that begins in the flat cells lining the inside of the airway bronchi.&lt;SEP&gt;A type of cancer that can develop in the throat and oropharynx, staged using TNM criteria according to p16 status.&lt;SEP&gt;Squamous cell carcinoma is a rare non-urothelial variant and subtype of bladder cancer.&lt;SEP&gt;Squamous cell carcinoma is a type of NSCLC that develops from cells that line the bronchi.&lt;SEP&gt;Squamous cell carcinoma is one of the most common types of cervical cancer covered by the treatment guidelines.&lt;SEP&gt;Squamous cell carcinoma is the most common form of cervical cancer, developing from squamous cells lining the ectocervix.&lt;SEP&gt;Squamous cell carcinoma is the most common histological type of anal cancer, originating from squamous cells on the skin and surface tissues.&lt;SEP&gt;The most common histological subtype of nasopharyngeal cancer, developing in the flat squamous cells lining the nasopharynx.&lt;SEP&gt;The most common histological subtype of nasopharyngeal cancer, developing in the thin, flat cells of the nasopharyngeal mucus membranes.&lt;SEP&gt;The most common histological type of anal cancer, starting in squamous cells found on skin and tissue surfaces.&lt;SEP&gt;The most common histological type of cervical cancer.&lt;SEP&gt;The most common type of cervical cancer, often considered for ovarian transposition prior to radiation therapy.&lt;SEP&gt;The most common type of mouth cancer, arising from the stratified squamous cells of the oral mucosal epithelium.&lt;SEP&gt;The most common type of mouth cancer, forming in the thin, flat cells of the mucous membranes of the mouth.</data>
      <data key="d3">chunk-8ec4d44b145ca896ff1216caa90ce5dd&lt;SEP&gt;chunk-711bee9440e11d7c737bc4a49b880910&lt;SEP&gt;chunk-e247ae57c50c62bded7114986471226e&lt;SEP&gt;chunk-b4d036ee5fd77783b9e7ddef3a8477ae&lt;SEP&gt;chunk-c9383db20cd696688798a193862cb5cc&lt;SEP&gt;chunk-d47a420aa2acde1175ad95bf6dc2e664&lt;SEP&gt;chunk-bd06bc83e13e7562ce65d6eee1b6024f&lt;SEP&gt;chunk-95c76786e9d6dbf06ddf5d55af0cf658&lt;SEP&gt;chunk-b0bad5ee25cb854c10bdbc9d33b54a1a&lt;SEP&gt;chunk-f43f96815f23658d5b24fe95ed4bd5ed&lt;SEP&gt;chunk-5d8e20e6004dd43ae0f68185383b594d&lt;SEP&gt;chunk-be6e1cb2fe11f4d9962741c30d446a69&lt;SEP&gt;chunk-f2a44e885faf856aa579d824b3cd85e7&lt;SEP&gt;chunk-06384634b72466c480713ee8d57f25ed&lt;SEP&gt;chunk-3821a6febf2d21784059ac62a6e659c1&lt;SEP&gt;chunk-08475506372bb4ce9ec1bd326caf0fe9&lt;SEP&gt;chunk-f9a9eb8b01f29fdf214c10bdffac3203&lt;SEP&gt;chunk-c9bfa651267335dd5e6ae5a24d85a072&lt;SEP&gt;chunk-7843955573cdc294b34e74019195fafb&lt;SEP&gt;chunk-8aa2c7020ce6e89888e81972588726e3</data>
    </node>
    <node id="Actinic Keratoses">
      <data key="d0">Actinic Keratoses</data>
      <data key="d1">category</data>
      <data key="d2">Actinic keratoses are pre-cancerous skin lesions that can be managed with photodynamic therapy, cryotherapy, or topical therapy.&lt;SEP&gt;Pre-cancerous skin lesions that frequently occur in the same area as Bowen’s disease and are treatable with superficial therapies.&lt;SEP&gt;Scaly or rough precancerous skin lesions caused by long-term sun exposure that carry a risk of progressing to squamous cell carcinoma.</data>
      <data key="d3">chunk-3821a6febf2d21784059ac62a6e659c1&lt;SEP&gt;chunk-60426652ddf8265bf75caba550026d38&lt;SEP&gt;chunk-e8ac9bf8f198bc5ad54fd1a7b843e810</data>
    </node>
    <node id="Marjolin’s Ulcer">
      <data key="d0">Marjolin’s Ulcer</data>
      <data key="d1">category</data>
      <data key="d2">A form of squamous cell skin cancer that develops in old wounds, burns, or scars, which can be harder to treat.&lt;SEP&gt;A type of squamous cell carcinoma that develops within chronic, non-healing wounds, ulcers, burns, or scarred skin.</data>
      <data key="d3">chunk-3821a6febf2d21784059ac62a6e659c1&lt;SEP&gt;chunk-e8ac9bf8f198bc5ad54fd1a7b843e810</data>
    </node>
    <node id="Xeroderma Pigmentosum">
      <data key="d0">Xeroderma Pigmentosum</data>
      <data key="d1">category</data>
      <data key="d2">A genetic disorder that elevates sensitivity and cancer risk from radiation, contraindicating radiation treatment.&lt;SEP&gt;A genetic syndrome characterized by the body's inability to repair DNA damage caused by ultraviolet light, significantly elevating skin cancer risk.</data>
      <data key="d3">chunk-3821a6febf2d21784059ac62a6e659c1&lt;SEP&gt;chunk-e9cc65c1c26b9e24bfb2c8c966f734a0</data>
    </node>
    <node id="Recessive Dystrophic Epidermolysis Bullosa">
      <data key="d0">Recessive Dystrophic Epidermolysis Bullosa</data>
      <data key="d1">category</data>
      <data key="d2">A rare, inherited disorder that causes severe skin fragility and blistering, placing affected individuals at high risk for skin cancer.</data>
      <data key="d3">chunk-3821a6febf2d21784059ac62a6e659c1</data>
    </node>
    <node id="Weakened Immune System">
      <data key="d0">Weakened Immune System</data>
      <data key="d1">category</data>
      <data key="d2">An immunocompromised health status resulting from medications or conditions like HIV, lymphoma, or leukemia that increases vulnerability to skin cancer.&lt;SEP&gt;An immunocompromised physical state caused by factors like organ transplants, HIV/AIDS, or corticosteroid use, increasing CSCC incidence and recurrence.</data>
      <data key="d3">chunk-3821a6febf2d21784059ac62a6e659c1&lt;SEP&gt;chunk-a9d0006f1c78fe4fa7bb74b756033104</data>
    </node>
    <node id="Organ Transplantation">
      <data key="d0">Organ Transplantation</data>
      <data key="d1">event</data>
      <data key="d2">A medical procedure requiring recipients to take immunosuppressive medications, which impairs the immune response and elevates skin cancer risk.</data>
      <data key="d3">chunk-3821a6febf2d21784059ac62a6e659c1</data>
    </node>
    <node id="Skin Biopsy">
      <data key="d0">Skin Biopsy</data>
      <data key="d1">category</data>
      <data key="d2">A biopsy procedure that takes a small tissue sample of inflamed skin on the breast.&lt;SEP&gt;A diagnostic procedure involving the removal of a small skin tissue sample for pathological evaluation to identify squamous cell skin cancer.&lt;SEP&gt;A diagnostic procedure where a sample of skin lesion tissue is removed and microscopically analyzed for cancer.&lt;SEP&gt;A general diagnostic procedure involving the extraction of a skin sample to test for malignancies such as cutaneous squamous cell carcinoma.&lt;SEP&gt;A medical diagnostic procedure involving the surgical removal of skin lesion tissue for microscopic examination to definitively diagnose cancer.&lt;SEP&gt;A medical procedure where a sample of inflamed breast skin is excised to diagnose inflammatory breast cancer.</data>
      <data key="d3">chunk-3821a6febf2d21784059ac62a6e659c1&lt;SEP&gt;chunk-e8ac9bf8f198bc5ad54fd1a7b843e810&lt;SEP&gt;chunk-7f9fe20fe42489996573eb1b436128b6&lt;SEP&gt;chunk-6eafb110f88c7af38808f77f59ed155d&lt;SEP&gt;chunk-562e1870b5e20f8648a2e56d960a1148&lt;SEP&gt;chunk-a9d0006f1c78fe4fa7bb74b756033104</data>
    </node>
    <node id="Arsenic">
      <data key="d0">Arsenic</data>
      <data key="d1">category</data>
      <data key="d2">A toxic environmental contaminant found in soil, water, and air that can lead to skin damage and squamous cell carcinoma.</data>
      <data key="d3">chunk-3821a6febf2d21784059ac62a6e659c1</data>
    </node>
    <node id="Lymphoma">
      <data key="d0">Lymphoma</data>
      <data key="d1">category</data>
      <data key="d2">A broad classification of cancer that arises from the uncontrolled proliferation of lymphocytes.&lt;SEP&gt;A category of cancer characterized by the abnormal overgrowth of white blood cells known as lymphocytes.&lt;SEP&gt;A general category of cancer that originates when white blood cells known as lymphocytes grow uncontrollably.&lt;SEP&gt;A type of blood cancer whose presence can compromise the immune system and increase the risk of anal cancer.&lt;SEP&gt;Cancer of the lymph nodes that compromises the immune system and increases an individual's susceptibility to squamous cell skin cancer.</data>
      <data key="d3">chunk-64f36a4a5be80c8fa51631db16e52b85&lt;SEP&gt;chunk-dd58424a14d9942181ba4ca3c1ec81c1&lt;SEP&gt;chunk-4966a628b12ecec4187796598764cf23&lt;SEP&gt;chunk-3821a6febf2d21784059ac62a6e659c1&lt;SEP&gt;chunk-9530f389987c13273449ab22a85170ae</data>
    </node>
    <node id="Chronic Lymphocytic Leukemia">
      <data key="d0">Chronic Lymphocytic Leukemia</data>
      <data key="d1">category</data>
      <data key="d2">A cancer of the white blood cells in bone marrow that weakens the body's immune defenses and elevates skin cancer risk.&lt;SEP&gt;A hematologic malignancy identified as an immunocompromising risk factor for developing anal cancer.&lt;SEP&gt;A slow-growing type of blood cancer occurring in lymphocytes, characterized by an oversupply of abnormal B cells.&lt;SEP&gt;Chronic lymphocytic leukemia (CLL) is a cancer of the blood characterized by elevated white blood cell counts and managed through biomarker testing, staging, and targeted treatments.&lt;SEP&gt;Chronic lymphocytic leukemia (CLL) is a type of blood and bone marrow cancer involving abnormal B cells, characterized by changes in the bone marrow and lymph system.</data>
      <data key="d3">chunk-bc89a92e9a97781ebca0db50abc34939&lt;SEP&gt;chunk-3821a6febf2d21784059ac62a6e659c1&lt;SEP&gt;chunk-9530f389987c13273449ab22a85170ae&lt;SEP&gt;chunk-098a64d7118fc8e1eb3e91ba0124258c&lt;SEP&gt;chunk-67015f3916810c4378b2ed269cc27f29</data>
    </node>
    <node id="HIV/AIDS">
      <data key="d0">HIV/AIDS</data>
      <data key="d1">category</data>
      <data key="d2">Human immunodeficiency virus infection and acquired immunodeficiency syndrome, conditions that severely weaken immunity and raise the risk of squamous cell carcinoma.</data>
      <data key="d3">chunk-3821a6febf2d21784059ac62a6e659c1</data>
    </node>
    <node id="Immunosuppressants">
      <data key="d0">Immunosuppressants</data>
      <data key="d1">category</data>
      <data key="d2">Anti-rejection medications administered following organ transplantation that dampen immune response and reduce the ability to clear HPV.&lt;SEP&gt;Pharmaceutical drugs taken after organ transplantation to prevent organ rejection by diminishing immune function, which in turn elevates skin cancer risk.</data>
      <data key="d3">chunk-3821a6febf2d21784059ac62a6e659c1&lt;SEP&gt;chunk-9530f389987c13273449ab22a85170ae</data>
    </node>
    <node id="Skin Cancer Screening">
      <data key="d0">Skin Cancer Screening</data>
      <data key="d1">event</data>
      <data key="d2">Routine clinical evaluations recommended for high-risk and immunocompromised individuals to detect suspicious skin lesions and skin cancer early.</data>
      <data key="d3">chunk-3821a6febf2d21784059ac62a6e659c1</data>
    </node>
    <node id="Dermatologist">
      <data key="d0">Dermatologist</data>
      <data key="d1">category</data>
      <data key="d2">A medical specialist trained in evaluating, diagnosing, and managing skin disorders, precancerous lesions like actinic keratoses, and skin cancers.</data>
      <data key="d3">chunk-3821a6febf2d21784059ac62a6e659c1</data>
    </node>
    <node id="Skin Shave Biopsy">
      <data key="d0">Skin Shave Biopsy</data>
      <data key="d1">category</data>
      <data key="d2">A diagnostic procedure performed superficially or deeper using a razor-like tool to remove the epidermis and part of the dermis for cancer evaluation.</data>
      <data key="d3">chunk-3821a6febf2d21784059ac62a6e659c1</data>
    </node>
    <node id="Skin Punch Biopsy">
      <data key="d0">Skin Punch Biopsy</data>
      <data key="d1">event</data>
      <data key="d2">A diagnostic procedure where a small circular piece of skin and connective tissue is excised using a hand-held tool to test for cancer.&lt;SEP&gt;A diagnostic skin-sampling procedure performed to detect inherited genetic variations and evaluate leukemia predisposition syndromes.&lt;SEP&gt;A diagnostic surgical technique that extracts a small core of skin and connective tissue using a circular hand-held instrument.&lt;SEP&gt;A skin punch biopsy is a diagnostic medical procedure where a small piece of skin and connective tissue is removed to test DNA unaltered by AML for inherited cancer syndromes.&lt;SEP&gt;A skin punch biopsy is a medical procedure in which a small sample of skin and connective tissue is collected to obtain non-leukemic DNA to test for inherited genetic conditions.</data>
      <data key="d3">chunk-db4e8318949a3fda5683c53985c6af05&lt;SEP&gt;chunk-3821a6febf2d21784059ac62a6e659c1&lt;SEP&gt;chunk-0786666c65b5bf00705439d5cb60d5a0&lt;SEP&gt;chunk-b63f0a9aec8d42c8426ded05a9bf92b4&lt;SEP&gt;chunk-6eafb110f88c7af38808f77f59ed155d</data>
    </node>
    <node id="Excision Biopsy">
      <data key="d0">Excision Biopsy</data>
      <data key="d1">category</data>
      <data key="d2">A surgical diagnostic procedure where all or part of a suspicious skin lesion is removed, often performed in an office or hospital setting.&lt;SEP&gt;A surgical procedure in which all or part of a suspicious skin lesion is removed for laboratory examination.</data>
      <data key="d3">chunk-3821a6febf2d21784059ac62a6e659c1&lt;SEP&gt;chunk-6eafb110f88c7af38808f77f59ed155d</data>
    </node>
    <node id="Cutaneous Squamous Cell Carcinoma">
      <data key="d0">Cutaneous Squamous Cell Carcinoma</data>
      <data key="d1">category</data>
      <data key="d2">A common form of skin cancer arising from squamous cells, also referred to as squamous cell skin cancer or CSCC, with varying levels of risk and treatment paths.&lt;SEP&gt;A form of skin cancer (CSCC) that can present as local, regional, or metastatic, requiring risk assessment and tailored medical interventions.&lt;SEP&gt;A type of skin cancer that can affect the vermilion border of the lip where the skin and lip meet.&lt;SEP&gt;Cutaneous squamous cell carcinoma (CSCC) is a common form of skin cancer that can be classified into risk levels such as low, high, or very high risk.&lt;SEP&gt;Cutaneous squamous cell carcinoma (CSCC) is the second most common type of skin cancer, commonly found on sun-exposed skin, highly treatable, and capable of local or regional spread.</data>
      <data key="d3">chunk-50c5e5d6c7a62da56b73abb9a3384301&lt;SEP&gt;chunk-f43f96815f23658d5b24fe95ed4bd5ed&lt;SEP&gt;chunk-60426652ddf8265bf75caba550026d38&lt;SEP&gt;chunk-6eafb110f88c7af38808f77f59ed155d&lt;SEP&gt;chunk-a9d0006f1c78fe4fa7bb74b756033104</data>
    </node>
    <node id="Actinic Keratosis">
      <data key="d0">Actinic Keratosis</data>
      <data key="d1">category</data>
      <data key="d2">Actinic keratosis is a precancerous skin condition marked by thick, rough, or abnormal skin growths often treated with topical medications, cryotherapy, or curettage.&lt;SEP&gt;Actinic keratosis is an area of scaly or rough skin with a higher probability of progressing into squamous cell skin cancer.</data>
      <data key="d3">chunk-6eafb110f88c7af38808f77f59ed155d&lt;SEP&gt;chunk-7d994e430bb9890c905d7914fad9c118</data>
    </node>
    <node id="Marjolin's Ulcer">
      <data key="d0">Marjolin's Ulcer</data>
      <data key="d1">category</data>
      <data key="d2">Marjolin's ulcer is a variant of squamous cell skin cancer that develops in old wounds, burns, or scars and can be more difficult to treat.</data>
      <data key="d3">chunk-6eafb110f88c7af38808f77f59ed155d</data>
    </node>
    <node id="Local Squamous Cell Skin Cancer">
      <data key="d0">Local Squamous Cell Skin Cancer</data>
      <data key="d1">category</data>
      <data key="d2">Local squamous cell skin cancer refers to CSCC that has not spread beyond the primary site to nearby lymph nodes.</data>
      <data key="d3">chunk-6eafb110f88c7af38808f77f59ed155d</data>
    </node>
    <node id="Regional Squamous Cell Skin Cancer">
      <data key="d0">Regional Squamous Cell Skin Cancer</data>
      <data key="d1">category</data>
      <data key="d2">Regional squamous cell skin cancer refers to CSCC that has spread to nearby lymph nodes, also known as nodal disease.</data>
      <data key="d3">chunk-6eafb110f88c7af38808f77f59ed155d</data>
    </node>
    <node id="MRI">
      <data key="d0">MRI</data>
      <data key="d1">event</data>
      <data key="d2">A diagnostic imaging study with or without contrast performed to evaluate the primary tumor and neck structures.&lt;SEP&gt;A diagnostic scan utilizing radio waves and strong magnetic fields to obtain detailed images of soft tissues, the bladder, pelvis, and nearby organs without radiation.&lt;SEP&gt;A magnetic resonance imaging diagnostic procedure performed with contrast to evaluate suspicious neck lymph nodes.&lt;SEP&gt;Magnetic Resonance Imaging, an advanced imaging technique used for diagnostic evaluation and guiding breast biopsies.&lt;SEP&gt;Magnetic Resonance Imaging, an advanced imaging technique used to visualize the prostate gland and identify tumor locations.&lt;SEP&gt;Magnetic resonance imaging is a diagnostic procedure using radio waves, magnetic fields, and computers to produce detailed internal bodily images.&lt;SEP&gt;Magnetic resonance imaging is a radiation-free diagnostic scan used to detail pelvic soft tissues and check for cancer spread in the brain and surrounding organs.&lt;SEP&gt;Magnetic resonance imaging using radio waves and powerful magnets to provide detailed cross-sectional pictures and evaluate potential cancer spread.&lt;SEP&gt;Magnetic resonance imaging, a diagnostic imaging technique used to detect cancer in the spine and central nervous system.&lt;SEP&gt;Magnetic resonance imaging, a diagnostic scan featuring open or closed magnet designs to examine internal body structures.&lt;SEP&gt;Magnetic resonance imaging, a non-invasive medical diagnostic modality that utilizes magnetic fields to generate internal body pictures in closed or open formats.&lt;SEP&gt;Magnetic resonance imaging, a type of diagnostic imaging test used alongside mammograms to evaluate breast tissue.&lt;SEP&gt;Magnetic resonance imaging, an advanced diagnostic imaging procedure utilizing magnetic fields and radio waves to produce detailed images of soft tissues such as the brain.&lt;SEP&gt;Magnetic resonance imaging, an advanced medical imaging technique used to visualize the brain and central nervous system to detect tumor masses.</data>
      <data key="d3">chunk-8fbedfa2d88a7b3852f4c2bd0bb64af0&lt;SEP&gt;chunk-8a1130b0f6bbe935ceddbafc6ce2740f&lt;SEP&gt;chunk-9dc281a303d0d4c5300c0c1c45b739ed&lt;SEP&gt;chunk-50531346164ea7c08dd087a868b3cc2a&lt;SEP&gt;chunk-49c7ff3a71e74b3f0eb59258541e739e&lt;SEP&gt;chunk-4966a628b12ecec4187796598764cf23&lt;SEP&gt;chunk-38185832d6395b9952def9a72ecc339d&lt;SEP&gt;chunk-e5406c28b41e499fad4ae44f2c44fdd7&lt;SEP&gt;chunk-7f9fe20fe42489996573eb1b436128b6&lt;SEP&gt;chunk-30c0bb66b1a2f93e89f5342ab1077451&lt;SEP&gt;chunk-76a038845aaedb9ef7852018f26778b3&lt;SEP&gt;chunk-1dc8d8e5ed4f165f3e56305a7644ba05&lt;SEP&gt;chunk-6eafb110f88c7af38808f77f59ed155d&lt;SEP&gt;chunk-be6e1cb2fe11f4d9962741c30d446a69</data>
    </node>
    <node id="Needle Biopsy">
      <data key="d0">Needle Biopsy</data>
      <data key="d1">event</data>
      <data key="d2">A diagnostic procedure that collects a small tissue sample from a lymph node using a needle, performed when other biopsies are not safe.&lt;SEP&gt;A medical procedure where a needle is used to extract a sample from enlarged lymph nodes to detect cancer spread.</data>
      <data key="d3">chunk-6eafb110f88c7af38808f77f59ed155d&lt;SEP&gt;chunk-717174ace5855cc823d51c46c9a70648</data>
    </node>
    <node id="Hospital">
      <data key="d0">Hospital</data>
      <data key="d1">organization</data>
      <data key="d2">A medical healthcare facility that provides clinical trials, supportive therapies, counseling, integrative medicine, and multidisciplinary treatment to cancer patients.&lt;SEP&gt;A medical institution where diagnostic imaging, excision biopsies, and surgical cancer treatments are conducted.</data>
      <data key="d3">chunk-6eafb110f88c7af38808f77f59ed155d&lt;SEP&gt;chunk-9e8b25c2957355218780bdfd8b72df45</data>
    </node>
    <node id="Head-to-Toe Skin Exam">
      <data key="d0">Head-to-Toe Skin Exam</data>
      <data key="d1">event</data>
      <data key="d2">A thorough physical screening conducted by a doctor after a CSCC diagnosis to check the body for additional skin lesions.</data>
      <data key="d3">chunk-6eafb110f88c7af38808f77f59ed155d</data>
    </node>
    <node id="Lymph Node Exam">
      <data key="d0">Lymph Node Exam</data>
      <data key="d1">event</data>
      <data key="d2">A physical examination where a doctor palpates lymph nodes to detect swelling or signs of metastatic nodal disease.</data>
      <data key="d3">chunk-6eafb110f88c7af38808f77f59ed155d</data>
    </node>
    <node id="PET/CT Scan">
      <data key="d0">PET/CT Scan</data>
      <data key="d1">event</data>
      <data key="d2">A combined diagnostic imaging procedure that pairs positron emission tomography with computed tomography to accurately pinpoint cancer locations.&lt;SEP&gt;A combined diagnostic procedure pairing positron emission tomography with computed tomography to visualize metabolic cancer activity alongside anatomy.&lt;SEP&gt;A combined diagnostic procedure using a radioactive tracer and CT imaging to locate cancer cells and evaluate whether cancer has spread outside the bladder.&lt;SEP&gt;A diagnostic whole-body imaging technique used to locate cancer and assess the extent of disease in the body.&lt;SEP&gt;A dual-modality diagnostic imaging procedure that combines positron emission tomography and computed tomography to map cancer in the prostate and pelvic lymph nodes.&lt;SEP&gt;A hybrid diagnostic imaging method combining positron emission tomography with computed tomography.&lt;SEP&gt;A hybrid diagnostic imaging modality combining positron emission tomography and computed tomography to generate detailed structural and functional images.&lt;SEP&gt;A hybrid diagnostic imaging procedure combining positron emission tomography with computed tomography.&lt;SEP&gt;A hybrid diagnostic procedure that merges PET and CT imaging to provide detailed structural and metabolic views of prostate cancer and metastasis.&lt;SEP&gt;A hybrid imaging modality that combines positron emission tomography and computed tomography, often utilizing fluorodeoxyglucose.&lt;SEP&gt;A hybrid whole-body imaging examination combining positron emission tomography and computed tomography to locate systemic cancer spread.&lt;SEP&gt;A medical imaging procedure combining a positron emission tomography scan with computed tomography for enhanced diagnostic clarity.</data>
      <data key="d3">chunk-50531346164ea7c08dd087a868b3cc2a&lt;SEP&gt;chunk-27b3a0f53b4be1d525497f87555d7a06&lt;SEP&gt;chunk-975e540ddee1810d43caf8df4adcf205&lt;SEP&gt;chunk-29c9b8b5fd2cd967c48522af79a9598f&lt;SEP&gt;chunk-aeafa486bfd320cdaa7811ad75777912&lt;SEP&gt;chunk-fba176235a4410ba8723447134c92579&lt;SEP&gt;chunk-d0f15711706bc171fed17a7fab91b4b6&lt;SEP&gt;chunk-67e9c4dc95841db7d0af39e1267ae71b&lt;SEP&gt;chunk-30c0bb66b1a2f93e89f5342ab1077451&lt;SEP&gt;chunk-4724f6acaaa7931560b29614efc2927f&lt;SEP&gt;chunk-76a038845aaedb9ef7852018f26778b3&lt;SEP&gt;chunk-6eafb110f88c7af38808f77f59ed155d</data>
    </node>
    <node id="Nodal Disease">
      <data key="d0">Nodal Disease</data>
      <data key="d1">category</data>
      <data key="d2">A clinical classification referring to the presence and involvement of cancer cells in regional lymph nodes, noted as rare in bone cancers.&lt;SEP&gt;A clinical condition in which cancer cells spread through the lymphatic system and cause lymph node enlargement.</data>
      <data key="d3">chunk-6eafb110f88c7af38808f77f59ed155d&lt;SEP&gt;chunk-74f18dd51a0091fc888512458a85b0a1</data>
    </node>
    <node id="Contrast Dye">
      <data key="d0">Contrast Dye</data>
      <data key="d1">category</data>
      <data key="d2">A liquid contrast agent injected into a vein to make organs and deep tissues clearer on CT scans and MRI imaging.</data>
      <data key="d3">chunk-6eafb110f88c7af38808f77f59ed155d</data>
    </node>
    <node id="Radioactive Tracer">
      <data key="d0">Radioactive Tracer</data>
      <data key="d1">category</data>
      <data key="d2">A radiopharmaceutical drug injected through an IV that concentrates in metabolically active cells to reveal cancer on PET scans.&lt;SEP&gt;A radiopharmaceutical substance introduced into the bloodstream to bind to cancer cells or bone tissue, visualizing them during PET and bone scans.</data>
      <data key="d3">chunk-6eafb110f88c7af38808f77f59ed155d&lt;SEP&gt;chunk-aeafa486bfd320cdaa7811ad75777912</data>
    </node>
    <node id="Bowen’s Disease">
      <data key="d0">Bowen’s Disease</data>
      <data key="d1">category</data>
      <data key="d2">The earliest superficial form of squamous cell skin cancer that affects only the top layer of the skin.</data>
      <data key="d3">chunk-e8ac9bf8f198bc5ad54fd1a7b843e810</data>
    </node>
    <node id="Superficial Treatments">
      <data key="d0">Superficial Treatments</data>
      <data key="d1">category</data>
      <data key="d2">A classification of cancer treatments that target only the top layer of skin, including photodynamic therapy, cryotherapy, and topical therapies.</data>
      <data key="d3">chunk-e8ac9bf8f198bc5ad54fd1a7b843e810</data>
    </node>
    <node id="Photodynamic Therapy">
      <data key="d0">Photodynamic Therapy</data>
      <data key="d1">category</data>
      <data key="d2">A superficial cancer treatment utilizing a light-sensitive drug activated by light exposure to destroy cancer cells.&lt;SEP&gt;A therapeutic procedure utilizing light and photosensitizing chemical agents, indicated as a treatment option for actinic keratoses.</data>
      <data key="d3">chunk-e8ac9bf8f198bc5ad54fd1a7b843e810&lt;SEP&gt;chunk-60426652ddf8265bf75caba550026d38</data>
    </node>
    <node id="Cryotherapy">
      <data key="d0">Cryotherapy</data>
      <data key="d1">category</data>
      <data key="d2">A medical procedure using extreme cold to destroy abnormal or pre-cancerous tissue, used in the management of actinic keratoses.&lt;SEP&gt;A superficial treatment modality that freezes and destroys precancerous and cancerous cells using extreme cold, typically liquid nitrogen.&lt;SEP&gt;Cryotherapy is a procedure that destroys abnormal and cancerous skin cells using extreme cold via liquid or a cold instrument.</data>
      <data key="d3">chunk-e8ac9bf8f198bc5ad54fd1a7b843e810&lt;SEP&gt;chunk-7d994e430bb9890c905d7914fad9c118&lt;SEP&gt;chunk-60426652ddf8265bf75caba550026d38</data>
    </node>
    <node id="Topical Therapies">
      <data key="d0">Topical Therapies</data>
      <data key="d1">category</data>
      <data key="d2">Prescription creams and medications applied directly to the skin to treat precancerous lesions and early forms of squamous cell skin cancer.&lt;SEP&gt;Topical therapies are non-invasive medications applied directly to the skin, including 5-fluorouracil, calcipotriene, imiquimod, and tirbanibulin, used to treat actinic keratoses and superficial skin cancer.</data>
      <data key="d3">chunk-e8ac9bf8f198bc5ad54fd1a7b843e810&lt;SEP&gt;chunk-7d994e430bb9890c905d7914fad9c118</data>
    </node>
    <node id="Cancer Care Team">
      <data key="d0">Cancer Care Team</data>
      <data key="d1">organization</data>
      <data key="d2">A multidisciplinary group of medical specialists and the patient that coordinates personalized treatment planning and clinical decisions.&lt;SEP&gt;A multidisciplinary team of medical professionals, specialists, and nurses who coordinate and provide comprehensive care to cancer patients.&lt;SEP&gt;A multidisciplinary team of oncology healthcare providers responsible for treatment planning, risk evaluation, and referrals for patients with cancer.</data>
      <data key="d3">chunk-e8ac9bf8f198bc5ad54fd1a7b843e810&lt;SEP&gt;chunk-bd06bc83e13e7562ce65d6eee1b6024f&lt;SEP&gt;chunk-67015f3916810c4378b2ed269cc27f29</data>
    </node>
    <node id="Dermatologists">
      <data key="d0">Dermatologists</data>
      <data key="d1">category</data>
      <data key="d2">Medical doctors specializing in the diagnosis, examination, and treatment of skin conditions and skin cancers.</data>
      <data key="d3">chunk-e8ac9bf8f198bc5ad54fd1a7b843e810</data>
    </node>
    <node id="Mohs Surgeons">
      <data key="d0">Mohs Surgeons</data>
      <data key="d1">category</data>
      <data key="d2">Specialized dermatologists trained in micrographic Mohs surgery and post-surgical reconstructive procedures.</data>
      <data key="d3">chunk-e8ac9bf8f198bc5ad54fd1a7b843e810</data>
    </node>
    <node id="Surgical Oncologists">
      <data key="d0">Surgical Oncologists</data>
      <data key="d1">category</data>
      <data key="d2">Surgeons specialized in diagnosing and surgically removing tumors, including cancers that have spread beyond the skin.</data>
      <data key="d3">chunk-e8ac9bf8f198bc5ad54fd1a7b843e810</data>
    </node>
    <node id="Medical Oncologists">
      <data key="d0">Medical Oncologists</data>
      <data key="d1">category</data>
      <data key="d2">Physicians specializing in the treatment of cancer using medications such as chemotherapy and systemic therapies.</data>
      <data key="d3">chunk-e8ac9bf8f198bc5ad54fd1a7b843e810</data>
    </node>
    <node id="Pathologists">
      <data key="d0">Pathologists</data>
      <data key="d1">category</data>
      <data key="d2">Doctors who analyze biopsy tissue and cell samples under a microscope to diagnose and stage cancerous tumors.</data>
      <data key="d3">chunk-e8ac9bf8f198bc5ad54fd1a7b843e810</data>
    </node>
    <node id="Plastic Surgeons">
      <data key="d0">Plastic Surgeons</data>
      <data key="d1">category</data>
      <data key="d2">Doctors trained in tumor removal, tissue reconstruction, and repairing deep surgical wounds.</data>
      <data key="d3">chunk-e8ac9bf8f198bc5ad54fd1a7b843e810</data>
    </node>
    <node id="Radiation Oncologists">
      <data key="d0">Radiation Oncologists</data>
      <data key="d1">category</data>
      <data key="d2">Physicians trained in using various types of radiation therapy to treat cancer.</data>
      <data key="d3">chunk-e8ac9bf8f198bc5ad54fd1a7b843e810</data>
    </node>
    <node id="Oncology Nurses">
      <data key="d0">Oncology Nurses</data>
      <data key="d1">category</data>
      <data key="d2">Specialized nurses who administer systemic therapies, manage patient care, and assist patients in navigating side effects.</data>
      <data key="d3">chunk-e8ac9bf8f198bc5ad54fd1a7b843e810</data>
    </node>
    <node id="Head And Neck Surgeons">
      <data key="d0">Head And Neck Surgeons</data>
      <data key="d1">category</data>
      <data key="d2">Specialized surgeons trained to treat cancerous and noncancerous conditions located in deeper structures of the head and neck, including ears, nose, and throat.</data>
      <data key="d3">chunk-e8ac9bf8f198bc5ad54fd1a7b843e810</data>
    </node>
    <node id="Pharmacists">
      <data key="d0">Pharmacists</data>
      <data key="d1">category</data>
      <data key="d2">Healthcare professionals trained to prepare, dispense, and explain medications and their side effects, with some specializing in cancer treatments.</data>
      <data key="d3">chunk-e8ac9bf8f198bc5ad54fd1a7b843e810</data>
    </node>
    <node id="Geneticists">
      <data key="d0">Geneticists</data>
      <data key="d1">category</data>
      <data key="d2">Medical doctors specializing in hereditary traits and genetic disorders who provide counseling and diagnostic evaluation for patients and families.</data>
      <data key="d3">chunk-e8ac9bf8f198bc5ad54fd1a7b843e810</data>
    </node>
    <node id="Lymph Node Biopsy">
      <data key="d0">Lymph Node Biopsy</data>
      <data key="d1">event</data>
      <data key="d2">A diagnostic procedure performed to examine lymph node tissue when the BPDCN subtype of AML is suspected.&lt;SEP&gt;A diagnostic procedure performed to extract and test lymph node tissue when blastic plasmacytoid dendritic cell neoplasm is suspected.&lt;SEP&gt;A diagnostic procedure performed to test lymph node tissue for metastasis when cancer spread through blood or lymph fluid is suspected.</data>
      <data key="d3">chunk-e8ac9bf8f198bc5ad54fd1a7b843e810&lt;SEP&gt;chunk-0786666c65b5bf00705439d5cb60d5a0&lt;SEP&gt;chunk-d73843c009e523101e1464a2b28bc144</data>
    </node>
    <node id="5-Fluorouracil">
      <data key="d0">5-Fluorouracil</data>
      <data key="d1">category</data>
      <data key="d2">5-fluorouracil (5-FU) is a topical chemotherapy medication applied directly to the skin to treat actinic keratoses.&lt;SEP&gt;A topical chemotherapy prescription cream (known by brands such as Carac, Efudex, Fluoroplex) applied directly to the skin to treat early CSCC and actinic keratoses.</data>
      <data key="d3">chunk-e8ac9bf8f198bc5ad54fd1a7b843e810&lt;SEP&gt;chunk-7d994e430bb9890c905d7914fad9c118</data>
    </node>
    <node id="Imiquimod">
      <data key="d0">Imiquimod</data>
      <data key="d1">category</data>
      <data key="d2">A topical prescription cream (marketed as Aldara) applied directly to the skin to treat early cutaneous squamous cell carcinoma and actinic keratoses.&lt;SEP&gt;Imiquimod is a topical immune response modifier cream that stimulates the immune system to eliminate abnormal skin cells.</data>
      <data key="d3">chunk-e8ac9bf8f198bc5ad54fd1a7b843e810&lt;SEP&gt;chunk-7d994e430bb9890c905d7914fad9c118</data>
    </node>
    <node id="Calcipotriene">
      <data key="d0">Calcipotriene</data>
      <data key="d1">category</data>
      <data key="d2">A topical vitamin D derivative cream (brand names Sorilux, Dovonex) that activates the skin's immune system, often co-administered with 5-fluorouracil.&lt;SEP&gt;Calcipotriene (sold under brand names Sorilux and Dovonex) is a topical vitamin D analog that activates the skin's immune system, often combined with 5-fluorouracil.</data>
      <data key="d3">chunk-e8ac9bf8f198bc5ad54fd1a7b843e810&lt;SEP&gt;chunk-7d994e430bb9890c905d7914fad9c118</data>
    </node>
    <node id="Mohs Surgery">
      <data key="d0">Mohs Surgery</data>
      <data key="d1">category</data>
      <data key="d2">A specialized surgical technique and form of PDEMA used to treat local CSCC, particularly if high-risk features are present or initial margins are positive.&lt;SEP&gt;A specialized surgical technique that removes cancerous tissue in stages while examining margins, often used for low-risk and preferred for very high-risk CSCC.&lt;SEP&gt;Also referenced with PDEMA, a specialized surgical procedure used to remove squamous cell skin cancer by precisely checking tissue margins microscopically.&lt;SEP&gt;Mohs surgery is a specialized surgical procedure and the most common form of PDEMA, allowing real-time microscopic evaluation of margins to completely remove skin cancer while sparing healthy tissue.</data>
      <data key="d3">chunk-7d994e430bb9890c905d7914fad9c118&lt;SEP&gt;chunk-50c5e5d6c7a62da56b73abb9a3384301&lt;SEP&gt;chunk-a9d0006f1c78fe4fa7bb74b756033104&lt;SEP&gt;chunk-60426652ddf8265bf75caba550026d38</data>
    </node>
    <node id="Peripheral and Deep En Face Margin Assessment">
      <data key="d0">Peripheral and Deep En Face Margin Assessment</data>
      <data key="d1">category</data>
      <data key="d2">Peripheral and deep en face margin assessment (PDEMA) is a surgical approach commonly used on sensitive anatomical areas to completely examine surgical margins and spare normal tissue.</data>
      <data key="d3">chunk-7d994e430bb9890c905d7914fad9c118</data>
    </node>
    <node id="Curettage and Electrodesiccation">
      <data key="d0">Curettage and Electrodesiccation</data>
      <data key="d1">category</data>
      <data key="d2">A surgical procedure (C&amp;E), often combined with shave excision, recommended for early, small, low-risk cutaneous squamous cell carcinoma.&lt;SEP&gt;Curettage and electrodesiccation (C&amp;E) is a two-step dermatologic procedure involving scraping visible tumor tissue and cauterizing the base, used for early cutaneous squamous cell carcinoma.</data>
      <data key="d3">chunk-7d994e430bb9890c905d7914fad9c118&lt;SEP&gt;chunk-a9d0006f1c78fe4fa7bb74b756033104</data>
    </node>
    <node id="Standard Surgical Excision">
      <data key="d0">Standard Surgical Excision</data>
      <data key="d1">category</data>
      <data key="d2">A conventional surgical procedure involving cutting out the cancer along with a margin of healthy surrounding tissue.&lt;SEP&gt;A surgical treatment involving the removal of the tumor along with margins of surrounding tissue, applied in both low-risk and high-risk CSCC cases.&lt;SEP&gt;A surgical treatment option recommended for removing local CSCC lesions along with margins of healthy tissue.&lt;SEP&gt;Standard surgical excision is a procedure in which a tumor and a surrounding margin of normal skin are surgically removed with a scalpel and evaluated pathologically.</data>
      <data key="d3">chunk-7d994e430bb9890c905d7914fad9c118&lt;SEP&gt;chunk-50c5e5d6c7a62da56b73abb9a3384301&lt;SEP&gt;chunk-a9d0006f1c78fe4fa7bb74b756033104&lt;SEP&gt;chunk-60426652ddf8265bf75caba550026d38</data>
    </node>
    <node id="Lymph Node Dissection">
      <data key="d0">Lymph Node Dissection</data>
      <data key="d1">category</data>
      <data key="d2">A surgical procedure involving the excision of pelvic lymph nodes to evaluate and prevent the spread of cancer cells.&lt;SEP&gt;A surgical procedure performed to remove cancerous lymph nodes, either during an APR or as a standalone surgery.&lt;SEP&gt;A surgical procedure, also called lymphadenectomy, in which lymph nodes are removed and tested to check for the spread of cancer cells.&lt;SEP&gt;Lymph node dissection is an extensive surgical procedure performed under general anesthesia to remove multiple lymph nodes when cancer has spread.</data>
      <data key="d3">chunk-c9bfa651267335dd5e6ae5a24d85a072&lt;SEP&gt;chunk-7d994e430bb9890c905d7914fad9c118&lt;SEP&gt;chunk-5349eed06f06d7c9bcb541ced69e4664&lt;SEP&gt;chunk-e9a7fe3b15f3289198c7114b44890dea</data>
    </node>
    <node id="Sentinel Lymph Node Biopsy">
      <data key="d0">Sentinel Lymph Node Biopsy</data>
      <data key="d1">category</data>
      <data key="d2">A diagnostic procedure (SLNB) using dye and radioactive tracers to locate and evaluate the first lymph nodes where cancer may have spread.&lt;SEP&gt;A diagnostic procedure performed to test the first lymph nodes to which cancer cells are likely to spread from a primary tumor.&lt;SEP&gt;A diagnostic surgical procedure performed to check whether cancer cells have spread to the first receiving lymph nodes.&lt;SEP&gt;A sentinel lymph node biopsy is a surgical procedure that identifies and removes the primary draining lymph nodes to examine them for cancer metastasis.&lt;SEP&gt;A surgical diagnostic procedure involving the injection of a dye or radioactive tracer into the cervix to identify, excise, and test the lymph nodes most likely to contain cancer.&lt;SEP&gt;A surgical procedure in which sentinel lymph nodes are identified, removed, and analyzed to determine whether cancer has spread.&lt;SEP&gt;A surgical procedure in which the sentinel lymph nodes are removed and tested to determine if cancer cells have spread from the primary tumor.&lt;SEP&gt;A surgical procedure to identify and remove the initial lymph node or nodes where cancer cells are most likely to spread from a primary tumor.</data>
      <data key="d3">chunk-e9cc65c1c26b9e24bfb2c8c966f734a0&lt;SEP&gt;chunk-7f9fe20fe42489996573eb1b436128b6&lt;SEP&gt;chunk-fc469adbdd7a41816d59f249439bc726&lt;SEP&gt;chunk-e90bcd28496f1f39a21973656e3e496f&lt;SEP&gt;chunk-c9bfa651267335dd5e6ae5a24d85a072&lt;SEP&gt;chunk-7d994e430bb9890c905d7914fad9c118&lt;SEP&gt;chunk-562e1870b5e20f8648a2e56d960a1148&lt;SEP&gt;chunk-a9d0006f1c78fe4fa7bb74b756033104</data>
    </node>
    <node id="Mohs Surgeon">
      <data key="d0">Mohs Surgeon</data>
      <data key="d1">person</data>
      <data key="d2">A Mohs surgeon is a specialized dermatologic surgeon trained to excise skin cancer layers and immediately examine the tissue margins under a microscope.</data>
      <data key="d3">chunk-7d994e430bb9890c905d7914fad9c118</data>
    </node>
    <node id="Tirbanibulin">
      <data key="d0">Tirbanibulin</data>
      <data key="d1">category</data>
      <data key="d2">Tirbanibulin (sold as Klisyri) is a topical microtubule inhibitor applied to the face or scalp for 5 consecutive days to kill rapid-growing abnormal skin cells.</data>
      <data key="d3">chunk-7d994e430bb9890c905d7914fad9c118</data>
    </node>
    <node id="Hyperkeratosis">
      <data key="d0">Hyperkeratosis</data>
      <data key="d1">category</data>
      <data key="d2">Hyperkeratosis is a condition characterized by thickening of the outer layer of the skin, often seen in rough actinic keratoses.</data>
      <data key="d3">chunk-7d994e430bb9890c905d7914fad9c118</data>
    </node>
    <node id="Topical Tazarotene">
      <data key="d0">Topical Tazarotene</data>
      <data key="d1">category</data>
      <data key="d2">Topical tazarotene is a retinoid medication related to vitamin A used to treat thickened or hyperkeratotic actinic keratoses.</data>
      <data key="d3">chunk-7d994e430bb9890c905d7914fad9c118</data>
    </node>
    <node id="Topical Keratolytics">
      <data key="d0">Topical Keratolytics</data>
      <data key="d1">category</data>
      <data key="d2">Topical keratolytics, including urea, lactic acid, and salicylic acid, are agents used to soften and break down hyperkeratotic skin layers.</data>
      <data key="d3">chunk-7d994e430bb9890c905d7914fad9c118</data>
    </node>
    <node id="Topical Diclofenac">
      <data key="d0">Topical Diclofenac</data>
      <data key="d1">category</data>
      <data key="d2">Topical diclofenac is an agent used as a therapy for actinic keratoses.</data>
      <data key="d3">chunk-7d994e430bb9890c905d7914fad9c118</data>
    </node>
    <node id="Chemical Peels">
      <data key="d0">Chemical Peels</data>
      <data key="d1">category</data>
      <data key="d2">Chemical peels using substances such as trichloroacetic acid are skin-resurfacing treatments applied to actinic keratoses.</data>
      <data key="d3">chunk-7d994e430bb9890c905d7914fad9c118</data>
    </node>
    <node id="Resurfacing Techniques">
      <data key="d0">Resurfacing Techniques</data>
      <data key="d1">category</data>
      <data key="d2">Resurfacing techniques, such as laser treatment and dermabrasion, are physical procedures used to treat actinic keratoses.</data>
      <data key="d3">chunk-7d994e430bb9890c905d7914fad9c118</data>
    </node>
    <node id="Surgeon">
      <data key="d0">Surgeon</data>
      <data key="d1">person</data>
      <data key="d2">A medical doctor who performs surgical operations, including lumpectomies, mastectomies, and the localization and removal of sentinel lymph nodes.&lt;SEP&gt;A medical doctor who performs surgical procedures including tumor excision, sentinel lymph node biopsy, and wound reconstruction.&lt;SEP&gt;A medical doctor who performs surgical procedures such as lobectomy, total thyroidectomy, and lymph node dissections based on intraoperative findings.&lt;SEP&gt;A medical specialist who performs surgical procedures; it is recommended that an experienced surgeon perform the diagnostic biopsy for bone cancer at the treatment center.&lt;SEP&gt;A medical specialist who ultimately diagnosed the nurse patient with inflammatory breast cancer following multiple prior visits.&lt;SEP&gt;A physician responsible for performing surgical operations such as thyroidectomies to excise thyroid tumors.&lt;SEP&gt;A specialized medical professional responsible for performing cancer operations such as mastectomies and sentinel lymph node biopsies.&lt;SEP&gt;A specialized physician who performs transabdominal resections, decides on bowel reattachment timing, and creates colostomies.&lt;SEP&gt;A surgeon is a medical professional who performs colon surgeries such as colectomies, removes abnormal lymph nodes, and determines surgical reconnection feasibility.&lt;SEP&gt;A surgical doctor who uses imaging guidance to excise tissue samples from the prostate gland.&lt;SEP&gt;A surgical specialist who performs tumor resections, Mohs surgery, and sentinel lymph node biopsies.</data>
      <data key="d3">chunk-1e017cd4fd8af1ebbcb582a93fbfe1ea&lt;SEP&gt;chunk-975e540ddee1810d43caf8df4adcf205&lt;SEP&gt;chunk-b8a273f96e02707e2e87fc43353ed57f&lt;SEP&gt;chunk-e9cc65c1c26b9e24bfb2c8c966f734a0&lt;SEP&gt;chunk-37bca9f4d2ebaeed359c9b4eb7a0c1de&lt;SEP&gt;chunk-5846f51c2ca4fae54459ce9c50e3e820&lt;SEP&gt;chunk-6b02315423350f3598288e189fbcb8ae&lt;SEP&gt;chunk-b5cfcc365cd093374564eb27dcbf5b82&lt;SEP&gt;chunk-e90bcd28496f1f39a21973656e3e496f&lt;SEP&gt;chunk-562e1870b5e20f8648a2e56d960a1148&lt;SEP&gt;chunk-a9d0006f1c78fe4fa7bb74b756033104</data>
    </node>
    <node id="Radiation Oncologist">
      <data key="d0">Radiation Oncologist</data>
      <data key="d1">person</data>
      <data key="d2">A doctor specializing in the therapeutic use of ionizing radiation for treating malignancies like anaplastic thyroid cancer.&lt;SEP&gt;A medical doctor specializing in oncology who devises radiation treatment plans and oversees radiation therapy.&lt;SEP&gt;A medical physician specialized in prescribing and administering radiation therapy to treat cancer.&lt;SEP&gt;A medical specialist who oversees radiation therapy for the treatment of cancer.&lt;SEP&gt;A physician specialized in prescribing and overseeing radiotherapy regimens for breast cancer treatment.&lt;SEP&gt;A physician specializing in radiation treatments who evaluates patients, conducts radiation therapy, and discusses potential risks and side effects.&lt;SEP&gt;A radiation oncologist is a cancer specialist who prescribes and plans radiation therapy treatments.&lt;SEP&gt;A specialized doctor who evaluates patients and administers radiation therapy treatments.&lt;SEP&gt;A specialized medical physician responsible for formulating the radiation treatment plan, dosing, and session scheduling.</data>
      <data key="d3">chunk-8fbedfa2d88a7b3852f4c2bd0bb64af0&lt;SEP&gt;chunk-1e017cd4fd8af1ebbcb582a93fbfe1ea&lt;SEP&gt;chunk-cb41559e96b71d2bb4ea207c806e8d5f&lt;SEP&gt;chunk-b0bad5ee25cb854c10bdbc9d33b54a1a&lt;SEP&gt;chunk-db3a86fc5d439d9bfb3845e468a2a551&lt;SEP&gt;chunk-e9cc65c1c26b9e24bfb2c8c966f734a0&lt;SEP&gt;chunk-c9bfa651267335dd5e6ae5a24d85a072&lt;SEP&gt;chunk-dea00cf063e8831db4919330d94b1f2a&lt;SEP&gt;chunk-ecc6c4bcd3cab65fa05ab5f3c55e528d</data>
    </node>
    <node id="Mohs Procedure">
      <data key="d0">Mohs Procedure</data>
      <data key="d1">event</data>
      <data key="d2">A surgical excision technique used to remove cancerous skin tissue, often followed by wound repair or reconstruction.</data>
      <data key="d3">chunk-e9cc65c1c26b9e24bfb2c8c966f734a0</data>
    </node>
    <node id="CSCC">
      <data key="d0">CSCC</data>
      <data key="d1">category</data>
      <data key="d2">Cutaneous squamous cell carcinoma, a type of skin cancer treatable by surgery, radiation therapy, and systemic therapies.</data>
      <data key="d3">chunk-e9cc65c1c26b9e24bfb2c8c966f734a0</data>
    </node>
    <node id="External Beam Radiation Therapy">
      <data key="d0">External Beam Radiation Therapy</data>
      <data key="d1">category</data>
      <data key="d2">A cancer treatment in which a large machine directs high-energy radiation beams at the tumor and surrounding lymph nodes in fractional doses.&lt;SEP&gt;A class of radiation therapy delivered from outside the body via a linear accelerator to target tumors conformally.&lt;SEP&gt;A classification of radiation therapy where a machine directs radiation beams toward the tumor site.&lt;SEP&gt;A common cancer treatment modality (EBRT) that uses radiation, which can cause ovarian damage and cessation of hormone production.&lt;SEP&gt;A form of radiation therapy (EBRT) administered externally in sessions over multiple weeks, frequently given concurrently with chemotherapy or sequentially before brachytherapy.&lt;SEP&gt;A form of radiation therapy (EBRT) utilized for aggressive, anaplastic, recurrent, or metastatic thyroid cancers that cannot be excised surgically.&lt;SEP&gt;A form of radiation therapy (EBRT) where a large machine directs high-energy radiation beams directly at the cancer site.&lt;SEP&gt;A form of radiation therapy delivered from outside the body, used alone or as part of chemoradiation following surgery or when surgery is not feasible.&lt;SEP&gt;A radiation oncology procedure targeting pelvic and abdominal tissue to eliminate cervical cancer cells, often combined with chemotherapy.&lt;SEP&gt;A radiation therapy approach (EBRT) recommended post-surgery or for individualized treatment of cancer recurrences and metastatic growths.&lt;SEP&gt;A radiation therapy technique delivering high-energy rays from outside the body to target cervical tumors.&lt;SEP&gt;A specific form of radiation therapy that directs high-energy radiation beams from a machine outside the body directly at the bladder tumor area.&lt;SEP&gt;A therapeutic treatment using high-energy x-rays or particles delivered from outside the body to destroy cancer cells and relieve symptoms.&lt;SEP&gt;A type of radiation therapy (EBRT) that utilizes a linear accelerator outside the body to deliver radiation to breast tissue and regional lymph nodes.</data>
      <data key="d3">chunk-e74c94f9f2ff33172671e8742338c6d1&lt;SEP&gt;chunk-1e017cd4fd8af1ebbcb582a93fbfe1ea&lt;SEP&gt;chunk-b0bad5ee25cb854c10bdbc9d33b54a1a&lt;SEP&gt;chunk-8ec4d44b145ca896ff1216caa90ce5dd&lt;SEP&gt;chunk-d04ad65c55d0dbbee5061cf3b24030ef&lt;SEP&gt;chunk-e247ae57c50c62bded7114986471226e&lt;SEP&gt;chunk-e9cc65c1c26b9e24bfb2c8c966f734a0&lt;SEP&gt;chunk-9040f5949ae0ff36ce88faa1f4b67ead&lt;SEP&gt;chunk-95c76786e9d6dbf06ddf5d55af0cf658&lt;SEP&gt;chunk-9d0e32bdc49dbab9c2c953abf363e317&lt;SEP&gt;chunk-c9bfa651267335dd5e6ae5a24d85a072&lt;SEP&gt;chunk-e9a7fe3b15f3289198c7114b44890dea&lt;SEP&gt;chunk-48b513355d29308e212a3074ba326b10&lt;SEP&gt;chunk-be6e1cb2fe11f4d9962741c30d446a69</data>
    </node>
    <node id="Brachytherapy">
      <data key="d0">Brachytherapy</data>
      <data key="d1">category</data>
      <data key="d2">A localized radiation therapy modality used as a treatment option for pelvic cancer recurrence, either alone or alongside other therapies.&lt;SEP&gt;A radiation therapy category where a radioactive source is placed in or near the tumor for a defined period.&lt;SEP&gt;An internal radiation procedure delivering localized radiation directly to the cervix or vagina, recommended after or alongside EBRT.&lt;SEP&gt;An internal radiation therapy technique delivering radiation directly into or near the tumor in cervical cancer treatment.&lt;SEP&gt;An internal radiation therapy technique involving placement of radioactive material inside or adjacent to the tumor in the body to deliver targeted high doses of radiation.&lt;SEP&gt;An internal radiation therapy technique involving radioactive material placed inside the body to deliver high radiation doses directly to the tumor.&lt;SEP&gt;Internal radiation therapy delivered directly into or near the tumor site.</data>
      <data key="d3">chunk-8ec4d44b145ca896ff1216caa90ce5dd&lt;SEP&gt;chunk-d04ad65c55d0dbbee5061cf3b24030ef&lt;SEP&gt;chunk-e247ae57c50c62bded7114986471226e&lt;SEP&gt;chunk-e9cc65c1c26b9e24bfb2c8c966f734a0&lt;SEP&gt;chunk-b3ba7430f3a31330247f52afe7e9c68a&lt;SEP&gt;chunk-9d0e32bdc49dbab9c2c953abf363e317&lt;SEP&gt;chunk-e9a7fe3b15f3289198c7114b44890dea</data>
    </node>
    <node id="Adjuvant Therapy">
      <data key="d0">Adjuvant Therapy</data>
      <data key="d1">category</data>
      <data key="d2">A category of treatment administered after primary surgery to destroy remaining cancer cells and reduce recurrence risk.&lt;SEP&gt;Postoperative systemic drug treatment administered following surgery to eliminate remaining microscopic cancer cells.</data>
      <data key="d3">chunk-e9cc65c1c26b9e24bfb2c8c966f734a0&lt;SEP&gt;chunk-9040f5949ae0ff36ce88faa1f4b67ead</data>
    </node>
    <node id="Basal Cell Nevus Syndrome">
      <data key="d0">Basal Cell Nevus Syndrome</data>
      <data key="d1">category</data>
      <data key="d2">A genetic condition that increases the risk of radiation-induced skin cancers, contraindicating radiation therapy.</data>
      <data key="d3">chunk-e9cc65c1c26b9e24bfb2c8c966f734a0</data>
    </node>
    <node id="Lupus">
      <data key="d0">Lupus</data>
      <data key="d1">category</data>
      <data key="d2">A connective tissue disease that may make the administration of radiation therapy medically inappropriate.&lt;SEP&gt;A specific autoimmune disease category cited as an example of a condition that affects immune system regulation.</data>
      <data key="d3">chunk-e9cc65c1c26b9e24bfb2c8c966f734a0&lt;SEP&gt;chunk-dd58424a14d9942181ba4ca3c1ec81c1</data>
    </node>
    <node id="Scleroderma">
      <data key="d0">Scleroderma</data>
      <data key="d1">category</data>
      <data key="d2">A connective tissue disorder that can complicate or contraindicate the use of radiation therapy.</data>
      <data key="d3">chunk-e9cc65c1c26b9e24bfb2c8c966f734a0</data>
    </node>
    <node id="Head And Neck">
      <data key="d0">Head And Neck</data>
      <data key="d1">geo</data>
      <data key="d2">Anatomical region where cutaneous tumors frequently develop and where radiation therapy can be particularly effective.</data>
      <data key="d3">chunk-e9cc65c1c26b9e24bfb2c8c966f734a0</data>
    </node>
    <node id="Scalp">
      <data key="d0">Scalp</data>
      <data key="d1">geo</data>
      <data key="d2">Anatomical site where cutaneous squamous cell carcinoma can occur; tissues here are prone to poor healing if operated on after previous radiation therapy.</data>
      <data key="d3">chunk-e9cc65c1c26b9e24bfb2c8c966f734a0</data>
    </node>
    <node id="Secondary Intention Healing">
      <data key="d0">Secondary Intention Healing</data>
      <data key="d1">category</data>
      <data key="d2">A wound healing method in which surgical wounds are left open without stitches to heal and close naturally over several weeks.</data>
      <data key="d3">chunk-e9cc65c1c26b9e24bfb2c8c966f734a0</data>
    </node>
    <node id="Linear Closure">
      <data key="d0">Linear Closure</data>
      <data key="d1">category</data>
      <data key="d2">A surgical wound closure technique where surrounding skin is altered into an elliptical shape and stitched closed along a line.</data>
      <data key="d3">chunk-e9cc65c1c26b9e24bfb2c8c966f734a0</data>
    </node>
    <node id="Skin Graft">
      <data key="d0">Skin Graft</data>
      <data key="d1">category</data>
      <data key="d2">A reconstructive technique involving the surgical removal of a patch of skin from one body area and transplanting it to repair an open wound.</data>
      <data key="d3">chunk-e9cc65c1c26b9e24bfb2c8c966f734a0</data>
    </node>
    <node id="Flapping">
      <data key="d0">Flapping</data>
      <data key="d1">category</data>
      <data key="d2">A reconstructive surgical technique involving the rearrangement of local tissue to cover a wound and reduce scarring.</data>
      <data key="d3">chunk-e9cc65c1c26b9e24bfb2c8c966f734a0</data>
    </node>
    <node id="Surgical Excision">
      <data key="d0">Surgical Excision</data>
      <data key="d1">event</data>
      <data key="d2">The surgical removal of cancerous tissue, serving as a primary treatment for cutaneous squamous cell carcinoma.</data>
      <data key="d3">chunk-e9cc65c1c26b9e24bfb2c8c966f734a0</data>
    </node>
    <node id="PDEMA">
      <data key="d0">PDEMA</data>
      <data key="d1">category</data>
      <data key="d2">A specialized surgical procedure for cancer tissue removal and margin assessment, often followed by reconstructive wound repair.&lt;SEP&gt;Peripheral and deep en face margin assessment (PDEMA) is a specialized surgical margin evaluation technique, often considered alongside Mohs surgery for treating cutaneous squamous cell carcinoma.&lt;SEP&gt;Peripheral and deep en face margin assessment, a surgical excision technique evaluated alongside Mohs surgery for the treatment of CSCC.</data>
      <data key="d3">chunk-e9cc65c1c26b9e24bfb2c8c966f734a0&lt;SEP&gt;chunk-50c5e5d6c7a62da56b73abb9a3384301&lt;SEP&gt;chunk-a9d0006f1c78fe4fa7bb74b756033104</data>
    </node>
    <node id="General Anesthesia">
      <data key="d0">General Anesthesia</data>
      <data key="d1">category</data>
      <data key="d2">A medically induced state of deep sleep utilized during extensive cancer operations and sentinel lymph node biopsies.&lt;SEP&gt;A state of full sedation and unconsciousness administered during examinations of the bladder and bowel to prevent pain and awareness.</data>
      <data key="d3">chunk-e9cc65c1c26b9e24bfb2c8c966f734a0&lt;SEP&gt;chunk-be6e1cb2fe11f4d9962741c30d446a69</data>
    </node>
    <node id="Electron Beam Radiation">
      <data key="d0">Electron Beam Radiation</data>
      <data key="d1">category</data>
      <data key="d2">A subtype of external beam radiation therapy utilizing electrons to treat superficial tumors.</data>
      <data key="d3">chunk-e9cc65c1c26b9e24bfb2c8c966f734a0</data>
    </node>
    <node id="Photon Beam Radiation">
      <data key="d0">Photon Beam Radiation</data>
      <data key="d1">category</data>
      <data key="d2">A subtype of external beam radiation therapy using high-energy x-rays to treat deeper, invasive tumors.</data>
      <data key="d3">chunk-e9cc65c1c26b9e24bfb2c8c966f734a0</data>
    </node>
    <node id="Protons">
      <data key="d0">Protons</data>
      <data key="d1">category</data>
      <data key="d2">Charged particles utilized as an intense energy beam option within radiation therapy to destroy cancer cells.</data>
      <data key="d3">chunk-e9cc65c1c26b9e24bfb2c8c966f734a0</data>
    </node>
    <node id="Platinum Chemotherapy">
      <data key="d0">Platinum Chemotherapy</data>
      <data key="d1">category</data>
      <data key="d2">A class of chemotherapy agents administered concurrently with external beam radiation therapy during chemoradiation regimens.&lt;SEP&gt;A class of chemotherapy drugs administered concurrently with external beam radiation therapy in chemoradiation protocols.&lt;SEP&gt;A class of chemotherapy medications containing platinum compounds used to treat squamous cell skin cancer.&lt;SEP&gt;A subcategory of chemotherapy drugs containing platinum, such as cisplatin and carboplatin, utilized to treat squamous cell skin cancer and other malignancies.</data>
      <data key="d3">chunk-e247ae57c50c62bded7114986471226e&lt;SEP&gt;chunk-e9cc65c1c26b9e24bfb2c8c966f734a0&lt;SEP&gt;chunk-95c76786e9d6dbf06ddf5d55af0cf658&lt;SEP&gt;chunk-f6fd03791661f76f6c1a246b2074b2a0</data>
    </node>
    <node id="Cisplatin">
      <data key="d0">Cisplatin</data>
      <data key="d1">category</data>
      <data key="d2">A chemotherapy drug used in combination with 5-FU alongside radiation to treat anal cancer.&lt;SEP&gt;A platinum-based chemotherapy drug associated with an increased risk of hypersensitivity reactions with repeated administration.&lt;SEP&gt;A platinum-based chemotherapy drug that serves as the preferred standard agent in chemoradiation for cervical cancer, known for potential nephrotoxic and ototoxic side effects.&lt;SEP&gt;A platinum-based chemotherapy medication used to treat various forms of cancer, including ovarian cancer.&lt;SEP&gt;A specific platinum-based chemotherapy drug administered intravenously to treat cutaneous squamous cell carcinoma and other malignancies.&lt;SEP&gt;An intravenous chemotherapy agent administered on the first day of continuous 5-FU infusions in an alternate anal cancer regimen.</data>
      <data key="d3">chunk-b69d38fafe014cece3427bd0459ae42b&lt;SEP&gt;chunk-6236b93e627d54f73f1c8fe341127e67&lt;SEP&gt;chunk-d04ad65c55d0dbbee5061cf3b24030ef&lt;SEP&gt;chunk-e9cc65c1c26b9e24bfb2c8c966f734a0&lt;SEP&gt;chunk-c622c677deca24391324ecd5f16ce4a3&lt;SEP&gt;chunk-0fdcce851d69aa713ed64ba1895bd5d1</data>
    </node>
    <node id="Carboplatin">
      <data key="d0">Carboplatin</data>
      <data key="d1">category</data>
      <data key="d2">A platinum-based chemotherapy drug commonly prescribed in combination with paclitaxel for the treatment of ovarian cancer.&lt;SEP&gt;A platinum-based chemotherapy drug that carries a risk of life-threatening hypersensitivity reactions with repeat use.&lt;SEP&gt;A platinum-containing chemotherapy medication used alone or in combinations to target advanced squamous cell cancer.&lt;SEP&gt;An alternative platinum-based chemotherapy medication used when cisplatin is contraindicated or considered too harsh.</data>
      <data key="d3">chunk-b69d38fafe014cece3427bd0459ae42b&lt;SEP&gt;chunk-e9cc65c1c26b9e24bfb2c8c966f734a0&lt;SEP&gt;chunk-c622c677deca24391324ecd5f16ce4a3&lt;SEP&gt;chunk-d04ad65c55d0dbbee5061cf3b24030ef</data>
    </node>
    <node id="U.S. Food and Drug Administration">
      <data key="d0">U.S. Food and Drug Administration</data>
      <data key="d1">organization</data>
      <data key="d2">A federal agency responsible for evaluating and approving investigational medical treatments and clinical trials.&lt;SEP&gt;A federal regulatory agency responsible for evaluating clinical trial data and approving safe and effective medical drugs and therapies.&lt;SEP&gt;The U.S. Food and Drug Administration (FDA) is a regulatory agency responsible for approving safe and effective cancer drugs, devices, and treatment approaches tested through clinical trials.&lt;SEP&gt;The U.S. Food and Drug Administration (FDA) is a regulatory agency responsible for evaluating and approving safe and effective medical drugs, devices, and cancer treatment approaches tested through clinical trials.&lt;SEP&gt;The federal regulatory agency responsible for evaluating and approving drugs, medical devices, and treatment methods proven safe and effective in clinical trials.</data>
      <data key="d3">chunk-f6fd03791661f76f6c1a246b2074b2a0&lt;SEP&gt;chunk-0d4cea71149e0e4157126efdaa0ea3e3&lt;SEP&gt;chunk-8ec4d44b145ca896ff1216caa90ce5dd&lt;SEP&gt;chunk-c35816f05289661283f683145d9f395f&lt;SEP&gt;chunk-725b48dc82aad42ba3dc14f4b5207551</data>
    </node>
    <node id="EGFR Inhibitors">
      <data key="d0">EGFR Inhibitors</data>
      <data key="d1">category</data>
      <data key="d2">A class of targeted therapy drugs that inhibit the epidermal growth factor receptor protein on cancer cells to halt cell growth and division, exemplified by cetuximab.</data>
      <data key="d3">chunk-f6fd03791661f76f6c1a246b2074b2a0</data>
    </node>
    <node id="PD-1 Inhibitors">
      <data key="d0">PD-1 Inhibitors</data>
      <data key="d1">category</data>
      <data key="d2">A class of immune checkpoint inhibitors that block the programmed death ligand 1 pathway, including cemiplimab and pembrolizumab, used in cancer immunotherapy.</data>
      <data key="d3">chunk-f6fd03791661f76f6c1a246b2074b2a0</data>
    </node>
    <node id="Immune-Related Adverse Events">
      <data key="d0">Immune-Related Adverse Events</data>
      <data key="d1">category</data>
      <data key="d2">A specific category of adverse side effects triggered by immunotherapy and immune checkpoint inhibitors.</data>
      <data key="d3">chunk-f6fd03791661f76f6c1a246b2074b2a0</data>
    </node>
    <node id="Phase 1 Trials">
      <data key="d0">Phase 1 Trials</data>
      <data key="d1">event</data>
      <data key="d2">Early-stage clinical trial events designed to evaluate the safety, dosage, and side effects of an investigational drug or treatment approach.&lt;SEP&gt;The initial phase of clinical trials evaluating the dosage, safety profile, side effects, and early therapeutic signs of an investigational treatment.</data>
      <data key="d3">chunk-cd2be7a2ce722f07b19c80e6e1690a8e&lt;SEP&gt;chunk-f6fd03791661f76f6c1a246b2074b2a0</data>
    </node>
    <node id="Phase 2 Trials">
      <data key="d0">Phase 2 Trials</data>
      <data key="d1">event</data>
      <data key="d2">A clinical research trial phase focused on assessing the efficacy of an investigational treatment against a specific type of cancer.&lt;SEP&gt;A stage of clinical research evaluating how effectively a drug or therapeutic approach works against a specific type of cancer.&lt;SEP&gt;Mid-stage clinical trial studies evaluating how effectively a new drug or treatment approach works against a specific type of cancer.</data>
      <data key="d3">chunk-cd2be7a2ce722f07b19c80e6e1690a8e&lt;SEP&gt;chunk-541f1323a24c5990b4a6408e0c5442ab&lt;SEP&gt;chunk-f6fd03791661f76f6c1a246b2074b2a0</data>
    </node>
    <node id="Phase 3 Trials">
      <data key="d0">Phase 3 Trials</data>
      <data key="d1">event</data>
      <data key="d2">A comparative clinical trial phase that evaluates an investigational treatment against standard treatments to support potential FDA approval.&lt;SEP&gt;A stage of clinical research comparing a new drug or approach against a standard treatment to establish efficacy for regulatory approval.&lt;SEP&gt;Late-stage clinical trial studies testing investigational treatments directly against standard treatments to support regulatory approval.</data>
      <data key="d3">chunk-cd2be7a2ce722f07b19c80e6e1690a8e&lt;SEP&gt;chunk-541f1323a24c5990b4a6408e0c5442ab&lt;SEP&gt;chunk-f6fd03791661f76f6c1a246b2074b2a0</data>
    </node>
    <node id="Phase 4 Trials">
      <data key="d0">Phase 4 Trials</data>
      <data key="d1">event</data>
      <data key="d2">A stage of clinical research conducted after regulatory approval to monitor long-term safety and therapeutic benefits.&lt;SEP&gt;Post-approval clinical studies monitoring the long-term safety and ongoing benefits of an FDA-approved cancer therapy.&lt;SEP&gt;Post-approval clinical trials designed to assess the long-term safety, benefits, and optimal use of an FDA-approved drug.</data>
      <data key="d3">chunk-cd2be7a2ce722f07b19c80e6e1690a8e&lt;SEP&gt;chunk-541f1323a24c5990b4a6408e0c5442ab&lt;SEP&gt;chunk-f6fd03791661f76f6c1a246b2074b2a0</data>
    </node>
    <node id="Research Team">
      <data key="d0">Research Team</data>
      <data key="d1">organization</data>
      <data key="d2">A group of clinical experts responsible for managing clinical trials, reviewing study details, risks, and benefits with participants, and overseeing informed consent.&lt;SEP&gt;A group of medical experts responsible for managing clinical trials, guiding participants, and conducting informed consent procedures.&lt;SEP&gt;A medical team responsible for collecting research data and coordinating patient care within clinical trials.&lt;SEP&gt;A multidisciplinary group of clinical experts responsible for managing clinical trials, reviewing protocols, and securing informed consent from patients.&lt;SEP&gt;A specialized clinical trials team that collects data, coordinates patient enrollment, and monitors individuals participating in clinical research.&lt;SEP&gt;A specialized group of experts responsible for conducting clinical trials, patient eligibility screening, and informed consent procedures.</data>
      <data key="d3">chunk-cb41559e96b71d2bb4ea207c806e8d5f&lt;SEP&gt;chunk-f6fd03791661f76f6c1a246b2074b2a0&lt;SEP&gt;chunk-8ec4d44b145ca896ff1216caa90ce5dd&lt;SEP&gt;chunk-cd2be7a2ce722f07b19c80e6e1690a8e&lt;SEP&gt;chunk-541f1323a24c5990b4a6408e0c5442ab&lt;SEP&gt;chunk-e90bcd28496f1f39a21973656e3e496f</data>
    </node>
    <node id="NCCN Cancer Centers">
      <data key="d0">NCCN Cancer Centers</data>
      <data key="d1">organization</data>
      <data key="d2">A network of leading cancer institutions across the United States providing specialized care and clinical trials through NCCN.&lt;SEP&gt;NCCN Cancer Centers is a network of cancer centers providing resources and directories to help patients find clinical trials.&lt;SEP&gt;NCCN Cancer Centers is a network of cancer institutions offering cancer care and clinical trial access in the United States.&lt;SEP&gt;NCCN Cancer Centers is an alliance of leading cancer centers providing clinical care and cancer trial resources.&lt;SEP&gt;NCCN Cancer Centers is an organization in the United States that offers information and resources for locating cancer clinical trials.&lt;SEP&gt;NCCN Cancer Centers is an organization providing cancer care resources and clinical trial opportunities in the United States.</data>
      <data key="d3">chunk-6236b93e627d54f73f1c8fe341127e67&lt;SEP&gt;chunk-e74c94f9f2ff33172671e8742338c6d1&lt;SEP&gt;chunk-8ec4d44b145ca896ff1216caa90ce5dd&lt;SEP&gt;chunk-60426652ddf8265bf75caba550026d38&lt;SEP&gt;chunk-725b48dc82aad42ba3dc14f4b5207551&lt;SEP&gt;chunk-541f1323a24c5990b4a6408e0c5442ab</data>
    </node>
    <node id="National Cancer Institute">
      <data key="d0">National Cancer Institute</data>
      <data key="d1">organization</data>
      <data key="d2">A U.S. government organization offering cancer information, research support, and clinical trial search services.&lt;SEP&gt;The National Cancer Institute (NCI) is a U.S. government agency providing resources, support, and clinical trial search services for cancer patients.&lt;SEP&gt;The National Cancer Institute (NCI) is a U.S. government organization providing cancer information and trial registries.&lt;SEP&gt;The National Cancer Institute (NCI) is a U.S. government organization providing cancer information, research, and searchable databases of clinical trials.&lt;SEP&gt;The National Cancer Institute (NCI) is a U.S. government organization that provides resources, clinical trial searches, and support through its Cancer Information Service.&lt;SEP&gt;The National Cancer Institute (NCI) is the principal federal agency for cancer research in the United States, providing clinical trial search tools and resources.&lt;SEP&gt;The federal government's principal agency for cancer research and training, providing comprehensive information on anal cancer.</data>
      <data key="d3">chunk-6236b93e627d54f73f1c8fe341127e67&lt;SEP&gt;chunk-e74c94f9f2ff33172671e8742338c6d1&lt;SEP&gt;chunk-0d4cea71149e0e4157126efdaa0ea3e3&lt;SEP&gt;chunk-8ec4d44b145ca896ff1216caa90ce5dd&lt;SEP&gt;chunk-60426652ddf8265bf75caba550026d38&lt;SEP&gt;chunk-725b48dc82aad42ba3dc14f4b5207551&lt;SEP&gt;chunk-541f1323a24c5990b4a6408e0c5442ab</data>
    </node>
    <node id="Cancer Information Service">
      <data key="d0">Cancer Information Service</data>
      <data key="d1">organization</data>
      <data key="d2">An information service supported by the National Cancer Institute to assist individuals in locating cancer clinical trials.&lt;SEP&gt;The Cancer Information Service (CIS) is a contact and support service provided by the National Cancer Institute to assist individuals in finding clinical trials.&lt;SEP&gt;The Cancer Information Service (CIS) is an information and support service operated by the National Cancer Institute to help individuals find clinical trials.&lt;SEP&gt;The Cancer Information Service (CIS) is an information resource and contact service run by the National Cancer Institute to help patients find clinical trials.&lt;SEP&gt;The Cancer Information Service (CIS) is an informational service offered by the National Cancer Institute to assist patients in finding clinical trials.&lt;SEP&gt;The Cancer Information Service (CIS) is an informational service provided by the National Cancer Institute to help individuals locate clinical trials.</data>
      <data key="d3">chunk-6236b93e627d54f73f1c8fe341127e67&lt;SEP&gt;chunk-e74c94f9f2ff33172671e8742338c6d1&lt;SEP&gt;chunk-8ec4d44b145ca896ff1216caa90ce5dd&lt;SEP&gt;chunk-60426652ddf8265bf75caba550026d38&lt;SEP&gt;chunk-725b48dc82aad42ba3dc14f4b5207551&lt;SEP&gt;chunk-541f1323a24c5990b4a6408e0c5442ab</data>
    </node>
    <node id="U.S. National Library of Medicine">
      <data key="d0">U.S. National Library of Medicine</data>
      <data key="d1">organization</data>
      <data key="d2">A biomedical library and division of the NIH that operates the ClinicalTrials.gov database.&lt;SEP&gt;A federal organization providing worldwide access to clinical research information via ClinicalTrials.gov.&lt;SEP&gt;The U.S. National Library of Medicine (NLM) is a biomedical library and government agency that operates the clinicaltrials.gov database worldwide.&lt;SEP&gt;The U.S. National Library of Medicine (NLM) is an institution providing clinical trial registry resources accessible worldwide via clinicaltrials.gov.&lt;SEP&gt;The U.S. National Library of Medicine (NLM) is an institution providing clinical trial registry services worldwide through clinicaltrials.gov.&lt;SEP&gt;The U.S. National Library of Medicine (NLM) is an institution providing worldwide access to clinical trials via clinicaltrials.gov.&lt;SEP&gt;The U.S. National Library of Medicine (NLM) provides worldwide clinical trial resources via clinicaltrials.gov.</data>
      <data key="d3">chunk-6236b93e627d54f73f1c8fe341127e67&lt;SEP&gt;chunk-e74c94f9f2ff33172671e8742338c6d1&lt;SEP&gt;chunk-0d4cea71149e0e4157126efdaa0ea3e3&lt;SEP&gt;chunk-8ec4d44b145ca896ff1216caa90ce5dd&lt;SEP&gt;chunk-60426652ddf8265bf75caba550026d38&lt;SEP&gt;chunk-725b48dc82aad42ba3dc14f4b5207551&lt;SEP&gt;chunk-541f1323a24c5990b4a6408e0c5442ab</data>
    </node>
    <node id="Low-Risk CSCC">
      <data key="d0">Low-Risk CSCC</data>
      <data key="d1">category</data>
      <data key="d2">A classification of cutaneous squamous cell carcinoma that is localized, early-stage, small, and has not spread to lymph nodes.&lt;SEP&gt;Low-Risk CSCC is a prognostic classification for squamous cell skin cancer with well-defined borders and lower potential for recurrence.</data>
      <data key="d3">chunk-a9d0006f1c78fe4fa7bb74b756033104&lt;SEP&gt;chunk-60426652ddf8265bf75caba550026d38</data>
    </node>
    <node id="High-Risk CSCC">
      <data key="d0">High-Risk CSCC</data>
      <data key="d1">category</data>
      <data key="d2">High-Risk CSCC is a prognostic classification characterized by increased risk of local recurrence due to factors such as tumor size, location, recurrence, or nerve involvement.</data>
      <data key="d3">chunk-60426652ddf8265bf75caba550026d38</data>
    </node>
    <node id="Very High-Risk CSCC">
      <data key="d0">Very High-Risk CSCC</data>
      <data key="d1">category</data>
      <data key="d2">Very High-Risk CSCC is a classification of squamous cell skin cancer with increased risk of both local recurrence and metastasis, often associated with tumors exceeding 4 cm.</data>
      <data key="d3">chunk-60426652ddf8265bf75caba550026d38</data>
    </node>
    <node id="Topical Therapy">
      <data key="d0">Topical Therapy</data>
      <data key="d1">category</data>
      <data key="d2">Medications applied directly to the skin surface to treat pre-cancerous lesions such as actinic keratoses.</data>
      <data key="d3">chunk-60426652ddf8265bf75caba550026d38</data>
    </node>
    <node id="Curettage And Electrodesiccation">
      <data key="d0">Curettage And Electrodesiccation</data>
      <data key="d1">category</data>
      <data key="d2">A surgical technique involving scraping cancer tissue and cauterizing the area with an electric current to treat squamous cell skin cancer.</data>
      <data key="d3">chunk-60426652ddf8265bf75caba550026d38</data>
    </node>
    <node id="Perineural Invasion">
      <data key="d0">Perineural Invasion</data>
      <data key="d1">category</data>
      <data key="d2">A high-risk or very high-risk pathologic feature where cancer cells surround or invade nerves, leading to symptoms like pain, numbness, or vision changes.&lt;SEP&gt;The invasion of cancer cells into nerves, causing symptoms such as pain, burning, loss of sensation, and blurred vision.</data>
      <data key="d3">chunk-a9d0006f1c78fe4fa7bb74b756033104&lt;SEP&gt;chunk-60426652ddf8265bf75caba550026d38</data>
    </node>
    <node id="Recurrent Tumors">
      <data key="d0">Recurrent Tumors</data>
      <data key="d1">category</data>
      <data key="d2">Cancer that returns after treatment at the primary site or elsewhere, classifying a tumor as high-risk squamous cell skin cancer.</data>
      <data key="d3">chunk-60426652ddf8265bf75caba550026d38</data>
    </node>
    <node id="Metastasis">
      <data key="d0">Metastasis</data>
      <data key="d1">category</data>
      <data key="d2">Metastasis is the biological process and spread of kidney cancer cells through blood or lymph vessels to form secondary tumors in distant tissues such as lungs, bones, liver, and brain.&lt;SEP&gt;The biological process and state where cancer cells spread from the primary prostate gland to distant regions such as lymph nodes, bones, the liver, or lungs.&lt;SEP&gt;The biological process by which cancer cells spread from the primary anal tumor to distant anatomical sites such as the liver, lungs, or distant lymph nodes.&lt;SEP&gt;The biological process through which advanced cancer cells spread from their initial site in the prostate to other areas of the body.&lt;SEP&gt;The pathological spread of cancer from the primary site to other areas of the body, such as the lungs or regional lymph nodes.&lt;SEP&gt;The spread of cancer cells from the primary site to other body regions, such as the lungs or regional lymph nodes.&lt;SEP&gt;The spread of cancer cells from the primary skin site to distant organs or lymph nodes, associated with very high-risk CSCC.&lt;SEP&gt;The spread of cancer cells from the primary tumor to other parts of the body such as lymph nodes or the lungs.</data>
      <data key="d3">chunk-3d609bd1a55d409470c55ad55e2d125d&lt;SEP&gt;chunk-6232dd9ed168a1113955e7300645338b&lt;SEP&gt;chunk-a08bd0a819ea613e781d07188a350438&lt;SEP&gt;chunk-0739b33959299ea67072f390ce38bffd&lt;SEP&gt;chunk-697db1653f51e966e79b92eefeb01ec6&lt;SEP&gt;chunk-ea7b3f83164304ee4a562046eb0f5033&lt;SEP&gt;chunk-60426652ddf8265bf75caba550026d38&lt;SEP&gt;chunk-a18089523f6dcd63cfa5664dc1c01618</data>
    </node>
    <node id="High-Risk or Very High-Risk CSCC">
      <data key="d0">High-Risk or Very High-Risk CSCC</data>
      <data key="d1">category</data>
      <data key="d2">A classification of cutaneous squamous cell carcinoma characterized by features such as deep invasion, fibrous connective tissue, or perineural invasion, indicating higher risk of recurrence or metastasis.</data>
      <data key="d3">chunk-a9d0006f1c78fe4fa7bb74b756033104</data>
    </node>
    <node id="CDC">
      <data key="d0">CDC</data>
      <data key="d1">organization</data>
      <data key="d2">The Centers for Disease Control and Prevention (CDC) is a public health agency providing resources and support for tobacco cessation via CDC.gov/tobacco.&lt;SEP&gt;The Centers for Disease Control and Prevention (CDC) provides public health information and smoking cessation support through CDC.gov/tobacco.&lt;SEP&gt;The Centers for Disease Control and Prevention is an organization offering resources and guidance for smoking cessation via CDC.gov/tobacco.&lt;SEP&gt;The Centers for Disease Control and Prevention, a public health agency providing online smoking cessation resources via CDC.gov/tobacco.&lt;SEP&gt;The Centers for Disease Control and Prevention, providing online resources and support for smoking cessation via CDC.gov/tobacco.&lt;SEP&gt;The Centers for Disease Control and Prevention, referenced via CDC.gov/tobacco as an official online resource for tobacco cessation support.</data>
      <data key="d3">chunk-3d609bd1a55d409470c55ad55e2d125d&lt;SEP&gt;chunk-9ad38c9dc069a8ff8df58c42f00eba23&lt;SEP&gt;chunk-a9d0006f1c78fe4fa7bb74b756033104&lt;SEP&gt;chunk-29d1ec9b874dd38ef0f3a4a2081f548e&lt;SEP&gt;chunk-7a890e27eba8c63d10f19b85a72fc14a&lt;SEP&gt;chunk-be6e1cb2fe11f4d9962741c30d446a69</data>
    </node>
    <node id="SmokeFree.gov">
      <data key="d0">SmokeFree.gov</data>
      <data key="d1">organization</data>
      <data key="d2">A government resource and website providing online support and programs for individuals seeking to quit smoking.&lt;SEP&gt;A government-supported online resource providing smoking cessation support and programs.&lt;SEP&gt;An official public health digital resource that provides support, tools, and counseling to help individuals quit smoking.&lt;SEP&gt;An online support initiative and website offering guidance and resources to help individuals quit smoking tobacco.&lt;SEP&gt;An online support service and informational resource dedicated to assisting individuals in quitting smoking.&lt;SEP&gt;An online support website providing resources and guidance to help individuals quit smoking and vaping.&lt;SEP&gt;SmokeFree.gov is an online public health resource providing guidance and support for smoking cessation.&lt;SEP&gt;SmokeFree.gov is an online support resource designed to assist individuals in quitting smoking and vaping.</data>
      <data key="d3">chunk-3d609bd1a55d409470c55ad55e2d125d&lt;SEP&gt;chunk-9ad38c9dc069a8ff8df58c42f00eba23&lt;SEP&gt;chunk-33608457001e818e2b300adae9c6c0d9&lt;SEP&gt;chunk-a9d0006f1c78fe4fa7bb74b756033104&lt;SEP&gt;chunk-7a890e27eba8c63d10f19b85a72fc14a&lt;SEP&gt;chunk-29d1ec9b874dd38ef0f3a4a2081f548e&lt;SEP&gt;chunk-db3a86fc5d439d9bfb3845e468a2a551&lt;SEP&gt;chunk-be6e1cb2fe11f4d9962741c30d446a69</data>
    </node>
    <node id="BeTobaccoFree.gov">
      <data key="d0">BeTobaccoFree.gov</data>
      <data key="d1">organization</data>
      <data key="d2">A government resource and website providing support, tools, and information for quitting tobacco use.&lt;SEP&gt;A government-supported online resource offering information and assistance for tobacco and nicotine cessation.&lt;SEP&gt;A public health information website that offers support, advice, and resources for tobacco and nicotine cessation.&lt;SEP&gt;A web-based initiative and platform that offers counseling and guidance to help individuals quit tobacco use.&lt;SEP&gt;A web-based public health initiative providing cessation resources, guidance, and assistance for tobacco and nicotine users.&lt;SEP&gt;An online public initiative that offers resources and information to help individuals quit tobacco use.&lt;SEP&gt;BeTobaccoFree.gov is an online public health resource providing support and information to help individuals quit tobacco use.&lt;SEP&gt;BeTobaccoFree.gov is an online resource offering information and support for individuals looking to quit tobacco use.</data>
      <data key="d3">chunk-3d609bd1a55d409470c55ad55e2d125d&lt;SEP&gt;chunk-9ad38c9dc069a8ff8df58c42f00eba23&lt;SEP&gt;chunk-33608457001e818e2b300adae9c6c0d9&lt;SEP&gt;chunk-a9d0006f1c78fe4fa7bb74b756033104&lt;SEP&gt;chunk-7a890e27eba8c63d10f19b85a72fc14a&lt;SEP&gt;chunk-29d1ec9b874dd38ef0f3a4a2081f548e&lt;SEP&gt;chunk-db3a86fc5d439d9bfb3845e468a2a551&lt;SEP&gt;chunk-be6e1cb2fe11f4d9962741c30d446a69</data>
    </node>
    <node id="Tumor Grade">
      <data key="d0">Tumor Grade</data>
      <data key="d1">category</data>
      <data key="d2">A classification rating system from 1 to 4 that measures cellular abnormality, growth rate, and invasiveness of a glioma.&lt;SEP&gt;A clinical measurement indicating how fast a cancer is expected to grow and spread based on cellular differentiation under a microscope.&lt;SEP&gt;A histological classification system (G1 to G3) measuring how abnormal tumor cells appear under a microscope compared to normal cells, indicating growth rate and recurrence risk.&lt;SEP&gt;A histological classification system (GX, G1, G2, G3) describing tumor cell abnormality under a microscope and indicating recurrence risk.&lt;SEP&gt;A pathological staging metric describing how abnormal cancer cells appear under microscopic examination.</data>
      <data key="d3">chunk-ffc3446f8ec092af24a460bda94f772f&lt;SEP&gt;chunk-cb41559e96b71d2bb4ea207c806e8d5f&lt;SEP&gt;chunk-0d388da75afb5ea2d01c97e55cb2b872&lt;SEP&gt;chunk-6b02315423350f3598288e189fbcb8ae&lt;SEP&gt;chunk-a9d0006f1c78fe4fa7bb74b756033104</data>
    </node>
    <node id="Lymphovascular Invasion">
      <data key="d0">Lymphovascular Invasion</data>
      <data key="d1">category</data>
      <data key="d2">The presence of cancer cells inside lymph or blood vessels outside the main tumor, increasing the risk of metastasis.</data>
      <data key="d3">chunk-a9d0006f1c78fe4fa7bb74b756033104</data>
    </node>
    <node id="Shave Excision">
      <data key="d0">Shave Excision</data>
      <data key="d1">category</data>
      <data key="d2">A surgical excision method recommended for small, early-stage, low-risk cutaneous squamous cell carcinoma.</data>
      <data key="d3">chunk-a9d0006f1c78fe4fa7bb74b756033104</data>
    </node>
    <node id="Platinum-Based Chemotherapy">
      <data key="d0">Platinum-Based Chemotherapy</data>
      <data key="d1">category</data>
      <data key="d2">A category of chemotherapy drugs containing platinum, such as carboplatin, cisplatin, and oxaliplatin, recommended for ovarian cancer treatment.&lt;SEP&gt;A chemotherapy regimen utilizing platinum-containing drugs such as carboplatin or cisplatin, standard in initial and recurrent ovarian cancer care.&lt;SEP&gt;A class of chemotherapy medications containing platinum, such as cisplatin, effective against bladder cancer but potentially toxic to the kidneys.&lt;SEP&gt;A systemic chemotherapy class commonly used in cervical cancer and administered concurrently in chemoradiation protocols.&lt;SEP&gt;A systemic chemotherapy class commonly used to treat metastatic cervical cancer, frequently utilizing drugs such as cisplatin.&lt;SEP&gt;A systemic chemotherapy regimen recommended in combination with radiation therapy when surgery is not feasible or cancer remains after resection.&lt;SEP&gt;A type of systemic chemotherapy commonly used in combination with radiation or when other systemic therapies are not suitable.&lt;SEP&gt;A type of systemic chemotherapy recommended alongside radiation therapy when surgery fails to eliminate high-risk cancer.&lt;SEP&gt;Platinum-based chemotherapy is a class of first-line systemic cancer treatment used for metastatic anal cancer, utilizing agents like carboplatin, cisplatin, or oxaliplatin.&lt;SEP&gt;Platinum-based chemotherapy is a standard initial systemic chemotherapy class for ovarian cancer preceding maintenance therapy.&lt;SEP&gt;The primary systemic chemotherapy class used for cervical cancer, predominantly utilizing cisplatin, or carboplatin as an alternative.</data>
      <data key="d3">chunk-b69d38fafe014cece3427bd0459ae42b&lt;SEP&gt;chunk-50c5e5d6c7a62da56b73abb9a3384301&lt;SEP&gt;chunk-5349eed06f06d7c9bcb541ced69e4664&lt;SEP&gt;chunk-8ec4d44b145ca896ff1216caa90ce5dd&lt;SEP&gt;chunk-d04ad65c55d0dbbee5061cf3b24030ef&lt;SEP&gt;chunk-c622c677deca24391324ecd5f16ce4a3&lt;SEP&gt;chunk-8b44f0b4da13a804cd1dfb917ac7e981&lt;SEP&gt;chunk-9d0e32bdc49dbab9c2c953abf363e317&lt;SEP&gt;chunk-64895edc4d35c98b293c555e32022a37&lt;SEP&gt;chunk-48b513355d29308e212a3074ba326b10&lt;SEP&gt;chunk-a9d0006f1c78fe4fa7bb74b756033104</data>
    </node>
    <node id="Immune Checkpoint Inhibitor">
      <data key="d0">Immune Checkpoint Inhibitor</data>
      <data key="d1">category</data>
      <data key="d2">A class of immunotherapy agents recommended for eligible patients with advanced or inoperable cutaneous squamous cell carcinoma.&lt;SEP&gt;A class of immunotherapy preferred for eligible patients when radiation is not suitable or to spare healthy organs.&lt;SEP&gt;A specific class of immunotherapy drugs that block checkpoint proteins to help the immune system attack cancer cells, preferred for eligible CSCC patients.</data>
      <data key="d3">chunk-64895edc4d35c98b293c555e32022a37&lt;SEP&gt;chunk-50c5e5d6c7a62da56b73abb9a3384301&lt;SEP&gt;chunk-a9d0006f1c78fe4fa7bb74b756033104</data>
    </node>
    <node id="Local CSCC">
      <data key="d0">Local CSCC</data>
      <data key="d1">category</data>
      <data key="d2">A stage of cutaneous squamous cell carcinoma that has not spread to nearby lymph nodes and is typically treated surgically.&lt;SEP&gt;A stage of cutaneous squamous cell carcinoma that has not spread to nearby lymph nodes or distant parts of the body.&lt;SEP&gt;Local cutaneous squamous cell carcinoma is a classification of skin cancer confined to a localized area, requiring structured follow-up skin exams based on risk levels.</data>
      <data key="d3">chunk-64895edc4d35c98b293c555e32022a37&lt;SEP&gt;chunk-50c5e5d6c7a62da56b73abb9a3384301&lt;SEP&gt;chunk-8b66e38931f28ed6ac9b231faaf202fb</data>
    </node>
    <node id="Regional CSCC">
      <data key="d0">Regional CSCC</data>
      <data key="d1">category</data>
      <data key="d2">A stage of cutaneous squamous cell carcinoma that has spread from the primary site to nearby lymph nodes.&lt;SEP&gt;A stage of cutaneous squamous cell carcinoma that has spread to nearby lymph nodes, requiring comprehensive diagnostic imaging, biopsy, and surgical or systemic intervention.&lt;SEP&gt;Regional cutaneous squamous cell carcinoma is a skin cancer classification where cancer may involve nearby lymph nodes, requiring more frequent physical exams and regular CT scans.</data>
      <data key="d3">chunk-64895edc4d35c98b293c555e32022a37&lt;SEP&gt;chunk-50c5e5d6c7a62da56b73abb9a3384301&lt;SEP&gt;chunk-8b66e38931f28ed6ac9b231faaf202fb</data>
    </node>
    <node id="Curettage And Electrodesiccation (C&amp;E)">
      <data key="d0">Curettage And Electrodesiccation (C&amp;E)</data>
      <data key="d1">category</data>
      <data key="d2">A surgical treatment procedure recommended for local, low-risk cutaneous squamous cell carcinoma.</data>
      <data key="d3">chunk-50c5e5d6c7a62da56b73abb9a3384301</data>
    </node>
    <node id="Cemiplimab-rwlc (Libtayo)">
      <data key="d0">Cemiplimab-rwlc (Libtayo)</data>
      <data key="d1">category</data>
      <data key="d2">An immunotherapy medication recommended prior to surgery for regional CSCC to reduce tumor size and lower surgical risk.</data>
      <data key="d3">chunk-50c5e5d6c7a62da56b73abb9a3384301</data>
    </node>
    <node id="Computed Tomography (CT) Scan">
      <data key="d0">Computed Tomography (CT) Scan</data>
      <data key="d1">category</data>
      <data key="d2">A diagnostic imaging technique used to examine the number, location, and size of lymph nodes affected by regional CSCC.</data>
      <data key="d3">chunk-50c5e5d6c7a62da56b73abb9a3384301</data>
    </node>
    <node id="PET/CT">
      <data key="d0">PET/CT</data>
      <data key="d1">category</data>
      <data key="d2">An advanced imaging modality utilizing injectable agents to evaluate distant metastasis and assist treatment planning for regional CSCC.</data>
      <data key="d3">chunk-50c5e5d6c7a62da56b73abb9a3384301</data>
    </node>
    <node id="Fine-Needle Aspiration (FNA)">
      <data key="d0">Fine-Needle Aspiration (FNA)</data>
      <data key="d1">category</data>
      <data key="d2">A minimally invasive needle biopsy procedure used to detect cancer cells in abnormal or swollen lymph nodes.</data>
      <data key="d3">chunk-50c5e5d6c7a62da56b73abb9a3384301</data>
    </node>
    <node id="Core Needle Biopsy">
      <data key="d0">Core Needle Biopsy</data>
      <data key="d1">category</data>
      <data key="d2">A biopsy method that uses a hollow needle to extract tissue samples, typically performed under light sedation.&lt;SEP&gt;A biopsy method that utilizes a larger needle to extract solid core tissue samples from tumors or affected lymph nodes.&lt;SEP&gt;A biopsy method using a hollow core needle to extract tissue samples from suspicious lymph nodes for CSCC evaluation.&lt;SEP&gt;A biopsy technique using a hollow needle to remove small cylindrical core samples of tissue from a tumor.&lt;SEP&gt;A diagnostic procedure (CNB) utilizing specialized needles to obtain core tissue samples from suspicious masses or lymph nodes.&lt;SEP&gt;A diagnostic procedure using a wide needle to extract a tissue sample from a lymph node without removing the entire node.&lt;SEP&gt;A needle biopsy procedure (CNB) that utilizes a larger, hollow needle to extract a core of tissue from a tumor or lymph node.</data>
      <data key="d3">chunk-d67bee20d5e5400994f8c8f03052dd06&lt;SEP&gt;chunk-50c5e5d6c7a62da56b73abb9a3384301&lt;SEP&gt;chunk-3d609bd1a55d409470c55ad55e2d125d&lt;SEP&gt;chunk-9ad38c9dc069a8ff8df58c42f00eba23&lt;SEP&gt;chunk-0739b33959299ea67072f390ce38bffd&lt;SEP&gt;chunk-7f9fe20fe42489996573eb1b436128b6&lt;SEP&gt;chunk-30c0bb66b1a2f93e89f5342ab1077451</data>
    </node>
    <node id="Head And Neck Tumors">
      <data key="d0">Head And Neck Tumors</data>
      <data key="d1">category</data>
      <data key="d2">A clinical category of CSCC tumors occurring in the head and neck region, often requiring lymph node neck dissections and postoperative adjuvant therapies.</data>
      <data key="d3">chunk-50c5e5d6c7a62da56b73abb9a3384301</data>
    </node>
    <node id="Risk Assessment">
      <data key="d0">Risk Assessment</data>
      <data key="d1">category</data>
      <data key="d2">A clinical evaluation process that categorizes CSCC as low, high, or very high risk based on tumor depth, nerve involvement, and histological grade.&lt;SEP&gt;A clinical evaluation process that gauges the likelihood of cancer spreading or recurring to guide appropriate treatment strategies.&lt;SEP&gt;An evaluation process carried out by patients and healthcare providers to determine an individual's specific chances of developing lung cancer.</data>
      <data key="d3">chunk-08475506372bb4ce9ec1bd326caf0fe9&lt;SEP&gt;chunk-50c5e5d6c7a62da56b73abb9a3384301&lt;SEP&gt;chunk-789ec6c06f8c999ac21c89b085b3fdb7</data>
    </node>
    <node id="Metastatic Squamous Cell Skin Cancer">
      <data key="d0">Metastatic Squamous Cell Skin Cancer</data>
      <data key="d1">category</data>
      <data key="d2">An advanced and uncommon stage of squamous cell skin cancer where cancer cells spread through blood and lymph vessels to other areas of the body.</data>
      <data key="d3">chunk-64895edc4d35c98b293c555e32022a37</data>
    </node>
    <node id="Stereotactic Body Radiotherapy">
      <data key="d0">Stereotactic Body Radiotherapy</data>
      <data key="d1">category</data>
      <data key="d2">A specialized radiation technique (SBRT) delivering precise, high doses of radiation to small areas over a limited number of treatments for symptom relief or tumor ablation.</data>
      <data key="d3">chunk-64895edc4d35c98b293c555e32022a37</data>
    </node>
    <node id="Skin Exam">
      <data key="d0">Skin Exam</data>
      <data key="d1">event</data>
      <data key="d2">Routine post-treatment physical examinations conducted by doctors to detect recurrence or new occurrences of skin cancer.</data>
      <data key="d3">chunk-64895edc4d35c98b293c555e32022a37</data>
    </node>
    <node id="Cancer Doctors">
      <data key="d0">Cancer Doctors</data>
      <data key="d1">person</data>
      <data key="d2">Specialized physicians, such as surgical, medical, and radiation oncologists, who collaborate to evaluate, discuss, and determine individualized treatment plans for cancer patients.</data>
      <data key="d3">chunk-64895edc4d35c98b293c555e32022a37</data>
    </node>
    <node id="Extracapsular Extension">
      <data key="d0">Extracapsular Extension</data>
      <data key="d1">category</data>
      <data key="d2">A pathological condition, also known as extranodal extension, where cancer breaks through the outer capsule of a lymph node, signaling a higher risk of recurrence.</data>
      <data key="d3">chunk-64895edc4d35c98b293c555e32022a37</data>
    </node>
    <node id="Diagnostic Scans">
      <data key="d0">Diagnostic Scans</data>
      <data key="d1">event</data>
      <data key="d2">Imaging examinations covering the upper body, stomach, and pelvis performed to determine disease spread and stage.</data>
      <data key="d3">chunk-64895edc4d35c98b293c555e32022a37</data>
    </node>
    <node id="High-Risk Local CSCC">
      <data key="d0">High-Risk Local CSCC</data>
      <data key="d1">category</data>
      <data key="d2">A clinical classification of localized cutaneous squamous cell carcinoma associated with elevated recurrence risk requiring more frequent monitoring.</data>
      <data key="d3">chunk-64895edc4d35c98b293c555e32022a37</data>
    </node>
    <node id="Low-Risk Local CSCC">
      <data key="d0">Low-Risk Local CSCC</data>
      <data key="d1">category</data>
      <data key="d2">A clinical classification of localized cutaneous squamous cell carcinoma with lower recurrence probability and less frequent follow-up exam schedules.</data>
      <data key="d3">chunk-64895edc4d35c98b293c555e32022a37</data>
    </node>
    <node id="Follow-Up Monitoring">
      <data key="d0">Follow-Up Monitoring</data>
      <data key="d1">category</data>
      <data key="d2">Post-treatment surveillance protocols designed to detect cancer recurrence or secondary skin malignancies through scheduled clinical assessments.</data>
      <data key="d3">chunk-64895edc4d35c98b293c555e32022a37</data>
    </node>
    <node id="Chronic Myeloid Leukemia">
      <data key="d0">Chronic Myeloid Leukemia</data>
      <data key="d1">category</data>
      <data key="d2">A slow-progressing type of blood cancer caused by a chromosomal translocation creating the Philadelphia chromosome and BCR::ABL1 fusion gene.&lt;SEP&gt;Chronic Myeloid Leukemia (CML) is a blood cancer arising from blood stem cells that produce excess myeloid progenitor cells, characterized by the Philadelphia chromosome and the BCR::ABL1 gene.&lt;SEP&gt;Chronic myeloid leukemia (CML) is a type of blood cancer that worsens slowly, caused by an abnormal BCR::ABL1 fusion gene and the Philadelphia chromosome.</data>
      <data key="d3">chunk-06f823f3a91fcbc32c62fac3c6347715&lt;SEP&gt;chunk-8b66e38931f28ed6ac9b231faaf202fb&lt;SEP&gt;chunk-ef6586b896c47b361bf4f6aabb4c35d5</data>
    </node>
    <node id="Blast Phase CML">
      <data key="d0">Blast Phase CML</data>
      <data key="d1">category</data>
      <data key="d2">Blast Phase CML (BP-CML) is an advanced form of Chronic Myeloid Leukemia marked by an elevated number of blast cells (immature myeloid or lymphoid progenitor cells).&lt;SEP&gt;Blast phase CML (BP-CML) is an advanced and aggressive form of chronic myeloid leukemia marked by high amounts of myeloid or lymphoid blasts.&lt;SEP&gt;Blast phase CML (BP-CML) is an advanced form of chronic myeloid leukemia characterized by an increased amount of immature blast cells.</data>
      <data key="d3">chunk-7606b44d6a30ad0519bc4c10785de79a&lt;SEP&gt;chunk-8b66e38931f28ed6ac9b231faaf202fb&lt;SEP&gt;chunk-ef6586b896c47b361bf4f6aabb4c35d5</data>
    </node>
    <node id="Philadelphia Chromosome">
      <data key="d0">Philadelphia Chromosome</data>
      <data key="d1">category</data>
      <data key="d2">A shortened chromosome 22 created from a reciprocal translocation with chromosome 9, serving as the biological hallmark of CML.&lt;SEP&gt;A shortened chromosome 22 created when genetic material translocates between chromosomes 9 and 22; a defining hallmark of chronic myeloid leukemia.&lt;SEP&gt;An abnormal chromosome 22 created by a translocation with chromosome 9, serving as the biological hallmark of CML.&lt;SEP&gt;An abnormal, shortened chromosome 22 resulting from a reciprocal translocation with chromosome 9, pathognomonic for chronic myeloid leukemia.</data>
      <data key="d3">chunk-7606b44d6a30ad0519bc4c10785de79a&lt;SEP&gt;chunk-06f823f3a91fcbc32c62fac3c6347715&lt;SEP&gt;chunk-8b66e38931f28ed6ac9b231faaf202fb&lt;SEP&gt;chunk-ef6586b896c47b361bf4f6aabb4c35d5</data>
    </node>
    <node id="BCR::ABL1">
      <data key="d0">BCR::ABL1</data>
      <data key="d1">category</data>
      <data key="d2">A fused oncogene and resulting protein caused by chromosomal translocation that drives uncontrolled blood cell growth in CML.&lt;SEP&gt;A fusion oncogene formed by chromosomal translocation between chromosomes 9 and 22 that drives chronic myeloid leukemia.&lt;SEP&gt;An abnormal fusion gene formed by the exchange of genetic material between chromosome 9 and chromosome 22, directly causing chronic myeloid leukemia.</data>
      <data key="d3">chunk-06f823f3a91fcbc32c62fac3c6347715&lt;SEP&gt;chunk-8b66e38931f28ed6ac9b231faaf202fb&lt;SEP&gt;chunk-ef6586b896c47b361bf4f6aabb4c35d5</data>
    </node>
    <node id="Bone Marrow">
      <data key="d0">Bone Marrow</data>
      <data key="d1">category</data>
      <data key="d2">Bone marrow is the spongy tissue inside bones responsible for producing blood cells through hematopoietic stem cell differentiation.&lt;SEP&gt;Soft, spongy tissue found in the center of most bones where new blood cells and lymphocytes are produced.&lt;SEP&gt;Spongy tissue inside bones where blood cells, including B lymphocytes, are generated, and where cellular abnormalities in CLL originate.&lt;SEP&gt;The sponge-like tissue located in the center of most bones where blood formation occurs through hematopoietic stem cells.&lt;SEP&gt;The spongy tissue found inside bones responsible for hematopoiesis, containing stem cells that develop into mature blood cells.&lt;SEP&gt;The spongy tissue in the center of most bones where blood stem cells reside and where blood cell formation and differentiation occur.&lt;SEP&gt;The spongy tissue inside bones responsible for producing blood cells, which becomes overcrowded by lymphoblasts in ALL.&lt;SEP&gt;The spongy tissue inside bones where blood cells are produced and where biological changes associated with CLL occur.&lt;SEP&gt;The spongy tissue inside bones where hematopoietic stem cells reside and manufacture blood cells, vulnerable to damage from cancer and intensive therapies.</data>
      <data key="d3">chunk-d67bee20d5e5400994f8c8f03052dd06&lt;SEP&gt;chunk-5d8e20e6004dd43ae0f68185383b594d&lt;SEP&gt;chunk-06f823f3a91fcbc32c62fac3c6347715&lt;SEP&gt;chunk-8b66e38931f28ed6ac9b231faaf202fb&lt;SEP&gt;chunk-bc89a92e9a97781ebca0db50abc34939&lt;SEP&gt;chunk-bd7ea43a74059d6781866faec437f19a&lt;SEP&gt;chunk-098a64d7118fc8e1eb3e91ba0124258c&lt;SEP&gt;chunk-a65ba958750476cc543741efe815c7c4&lt;SEP&gt;chunk-2dc31077c053f79ff82959575d335956</data>
    </node>
    <node id="Blood Stem Cells">
      <data key="d0">Blood Stem Cells</data>
      <data key="d1">category</data>
      <data key="d2">Also called hematopoietic stem cells, these are immature blood-forming cells located in bone marrow that give rise to all types of blood cells.&lt;SEP&gt;Blood or hematopoietic stem cells are early precursor cells located in the bone marrow that differentiate into all mature blood cell types.&lt;SEP&gt;Blood stem cells, or hematopoietic stem cells, are immature self-renewing cells in bone marrow that differentiate into red blood cells, white blood cells, and platelets.&lt;SEP&gt;Early-stage stem cells in the bone marrow from which blood cells arise, identified as the cellular origin of CML through the overproduction of myeloid progenitors.</data>
      <data key="d3">chunk-7606b44d6a30ad0519bc4c10785de79a&lt;SEP&gt;chunk-a99a89bec88823cedf4c1f0cd1a78e81&lt;SEP&gt;chunk-8b66e38931f28ed6ac9b231faaf202fb&lt;SEP&gt;chunk-53e3a9418b1d7916e3c8717a397bbb58</data>
    </node>
    <node id="Progenitor Cells">
      <data key="d0">Progenitor Cells</data>
      <data key="d1">category</data>
      <data key="d2">Intermediary precursor blood cells formed by blood stem cells that subsequently mature into red blood cells, white blood cells, and platelets.&lt;SEP&gt;Intermediary precursor cells derived from hematopoietic stem cells that differentiate into mature blood cell lineages.</data>
      <data key="d3">chunk-06f823f3a91fcbc32c62fac3c6347715&lt;SEP&gt;chunk-8b66e38931f28ed6ac9b231faaf202fb</data>
    </node>
    <node id="Myeloid Progenitor Cells">
      <data key="d0">Myeloid Progenitor Cells</data>
      <data key="d1">category</data>
      <data key="d2">A type of progenitor cell that develops into myeloblasts and other non-lymphoid blood cells; overproduced in chronic myeloid leukemia.&lt;SEP&gt;Hematopoietic precursor cells that develop into myeloblasts and non-lymphoid lineages such as granulocytes, red blood cells, and platelets.&lt;SEP&gt;Intermediate precursor cells in the bone marrow that develop into red blood cells, platelets, and granulocytes, and are directly affected in AML.&lt;SEP&gt;Myeloid progenitor cells are intermediary blood precursor cells in the bone marrow that develop into myeloblasts and non-lymphoid blood cells.&lt;SEP&gt;Myeloid progenitor cells are intermediate blood cells that develop into red blood cells, granulocytes, and platelets, and are directly affected in AML.&lt;SEP&gt;Myeloid progenitor cells are intermediate precursor cells in the bone marrow that develop into myeloblasts and other non-lymphoid blood cell types.&lt;SEP&gt;Precursor blood cells arising from blood stem cells that form myeloblasts and other non-lymphoid blood cells.&lt;SEP&gt;Precursor blood cells that form myeloblasts and non-lymphoid blood cells, produced in abnormally high amounts in CML.</data>
      <data key="d3">chunk-7606b44d6a30ad0519bc4c10785de79a&lt;SEP&gt;chunk-81c87ec3c2682da4d531da53f6e5e18c&lt;SEP&gt;chunk-a99a89bec88823cedf4c1f0cd1a78e81&lt;SEP&gt;chunk-8b66e38931f28ed6ac9b231faaf202fb&lt;SEP&gt;chunk-06f823f3a91fcbc32c62fac3c6347715&lt;SEP&gt;chunk-bd7ea43a74059d6781866faec437f19a&lt;SEP&gt;chunk-53e3a9418b1d7916e3c8717a397bbb58&lt;SEP&gt;chunk-2dc31077c053f79ff82959575d335956</data>
    </node>
    <node id="Lymphoid Progenitor Cells">
      <data key="d0">Lymphoid Progenitor Cells</data>
      <data key="d1">category</data>
      <data key="d2">Hematopoietic intermediary precursor cells that develop into lymphoblasts and mature into lymphocytes.&lt;SEP&gt;Lymphoid progenitor cells are intermediate precursor cells derived from stem cells that develop into lymphoblasts and subsequently differentiate into lymphocytes.&lt;SEP&gt;Lymphoid progenitor cells are precursor blood cells derived from blood stem cells that form lymphoblasts and mature into lymphocytes.&lt;SEP&gt;Lymphoid progenitor cells are precursor cells in bone marrow that develop into lymphoblasts and eventually mature into lymphocytes.&lt;SEP&gt;Precursor blood cells that develop into lymphoblasts and subsequently mature into lymphocytes.</data>
      <data key="d3">chunk-81c87ec3c2682da4d531da53f6e5e18c&lt;SEP&gt;chunk-06f823f3a91fcbc32c62fac3c6347715&lt;SEP&gt;chunk-a99a89bec88823cedf4c1f0cd1a78e81&lt;SEP&gt;chunk-8b66e38931f28ed6ac9b231faaf202fb&lt;SEP&gt;chunk-53e3a9418b1d7916e3c8717a397bbb58</data>
    </node>
    <node id="Blasts">
      <data key="d0">Blasts</data>
      <data key="d1">category</data>
      <data key="d2">Very immature blood cells, including myeloblasts and lymphoblasts, that proliferate excessively in advanced forms of leukemia.</data>
      <data key="d3">chunk-8b66e38931f28ed6ac9b231faaf202fb</data>
    </node>
    <node id="White Blood Cells">
      <data key="d0">White Blood Cells</data>
      <data key="d1">category</data>
      <data key="d2">A category of immune cells, including lymphocytes, that defend the body against infection, pathogens, and cancer.&lt;SEP&gt;Also known as leukocytes or WBCs, these immune system cells fight infections and include granulocytes, monocytes, and lymphocytes.&lt;SEP&gt;Also known as leukocytes, these blood cells are integral to the immune system and function to fight infections.&lt;SEP&gt;Also known as leukocytes, these blood cells include granulocytes, monocytes, and lymphocytes, and function to fight infections.&lt;SEP&gt;Immune cells circulating in blood that protect against infection and disease.&lt;SEP&gt;Immune system cells circulating in the blood, comprising subtypes such as B lymphocytes.&lt;SEP&gt;Leukocytes that fight infections, encompassing granulocytes, monocytes, and lymphocytes.&lt;SEP&gt;White blood cells (leukocytes) are immune cells—including granulocytes, monocytes, and lymphocytes—that fight infections.&lt;SEP&gt;White blood cells (leukocytes), encompassing lymphocytes, granulocytes, and monocytes, are immune cells that fight infections.&lt;SEP&gt;White blood cells, or leukocytes, are immune system cells consisting of granulocytes, monocytes, and lymphocytes that defend the body against infectious diseases.</data>
      <data key="d3">chunk-81c87ec3c2682da4d531da53f6e5e18c&lt;SEP&gt;chunk-a99a89bec88823cedf4c1f0cd1a78e81&lt;SEP&gt;chunk-8b66e38931f28ed6ac9b231faaf202fb&lt;SEP&gt;chunk-06f823f3a91fcbc32c62fac3c6347715&lt;SEP&gt;chunk-bc89a92e9a97781ebca0db50abc34939&lt;SEP&gt;chunk-d9882c04dd7676c6433074e5e393c72e&lt;SEP&gt;chunk-bd7ea43a74059d6781866faec437f19a&lt;SEP&gt;chunk-53e3a9418b1d7916e3c8717a397bbb58&lt;SEP&gt;chunk-b00f93aa3d24d0275d4290db3fb2cca3&lt;SEP&gt;chunk-2dc31077c053f79ff82959575d335956</data>
    </node>
    <node id="Granulocytes">
      <data key="d0">Granulocytes</data>
      <data key="d1">category</data>
      <data key="d2">A group of white blood cells including neutrophils, eosinophils, and basophils that are typically overproduced in chronic myeloid leukemia.&lt;SEP&gt;A specific category of white blood cells involved in immune defense alongside monocytes and lymphocytes.&lt;SEP&gt;A subcategory of white blood cells containing cytoplasmic granules, consisting of neutrophils, eosinophils, and basophils, which are overproduced in CML.&lt;SEP&gt;Granulocytes, also called neutrophils, are a type of white blood cell and immune cell that protect the body against infection.</data>
      <data key="d3">chunk-06f823f3a91fcbc32c62fac3c6347715&lt;SEP&gt;chunk-a99a89bec88823cedf4c1f0cd1a78e81&lt;SEP&gt;chunk-8b66e38931f28ed6ac9b231faaf202fb&lt;SEP&gt;chunk-2dc31077c053f79ff82959575d335956</data>
    </node>
    <node id="Red Blood Cells">
      <data key="d0">Red Blood Cells</data>
      <data key="d1">category</data>
      <data key="d2">Also called erythrocytes or RBCs, these blood cells are responsible for carrying oxygen throughout the body.&lt;SEP&gt;Also known as erythrocytes, these are blood cells that carry oxygen throughout the body and carry away waste.&lt;SEP&gt;Also known as erythrocytes, these blood cells transport oxygen throughout the body and carry away waste.&lt;SEP&gt;Erythrocytes circulating in the bloodstream that carry oxygen throughout the body.&lt;SEP&gt;Erythrocytes found in blood that are responsible for transporting oxygen throughout the body.&lt;SEP&gt;Red blood cells (erythrocytes) are blood cells that transport oxygen throughout the body and carry away waste products.&lt;SEP&gt;Red blood cells (erythrocytes) are blood components formed in bone marrow responsible for carrying oxygen throughout the body.&lt;SEP&gt;Red blood cells, or erythrocytes, are blood cells containing hemoglobin that transport oxygen from the lungs throughout the body.</data>
      <data key="d3">chunk-81c87ec3c2682da4d531da53f6e5e18c&lt;SEP&gt;chunk-a99a89bec88823cedf4c1f0cd1a78e81&lt;SEP&gt;chunk-8b66e38931f28ed6ac9b231faaf202fb&lt;SEP&gt;chunk-06f823f3a91fcbc32c62fac3c6347715&lt;SEP&gt;chunk-d9882c04dd7676c6433074e5e393c72e&lt;SEP&gt;chunk-bd7ea43a74059d6781866faec437f19a&lt;SEP&gt;chunk-53e3a9418b1d7916e3c8717a397bbb58&lt;SEP&gt;chunk-2dc31077c053f79ff82959575d335956</data>
    </node>
    <node id="Platelets">
      <data key="d0">Platelets</data>
      <data key="d1">category</data>
      <data key="d2">A cellular measurement in the blood that assesses clotting capability and the risk of bleeding or bruising.&lt;SEP&gt;Also known as thrombocytes, these blood cell fragments function to control bleeding and clot blood.&lt;SEP&gt;Also known as thrombocytes, these blood cells circulate in plasma and are essential for controlling bleeding and clot formation.&lt;SEP&gt;Also referred to as thrombocytes or PLTs, these blood components are essential for clotting and controlling bleeding.&lt;SEP&gt;Cellular fragments circulating in the blood essential for normal blood clotting and prevention of bleeding.&lt;SEP&gt;Essential blood-clotting cells produced by the bone marrow whose levels may drop during targeted cancer therapies, heightening bruising and bleeding risks.&lt;SEP&gt;Platelets (thrombocytes) are specialized blood components derived from stem cells that prevent and control bleeding.&lt;SEP&gt;Platelets (thrombocytes) are specialized blood components responsible for blood clotting and preventing bleeding.&lt;SEP&gt;Platelets, or thrombocytes, are cellular components of blood crucial for clotting and controlling bleeding.&lt;SEP&gt;Thrombocytes circulating in blood that facilitate blood clotting and prevent excessive bleeding.</data>
      <data key="d3">chunk-81c87ec3c2682da4d531da53f6e5e18c&lt;SEP&gt;chunk-9fa573748870dc50a98a935843997c68&lt;SEP&gt;chunk-a99a89bec88823cedf4c1f0cd1a78e81&lt;SEP&gt;chunk-8b66e38931f28ed6ac9b231faaf202fb&lt;SEP&gt;chunk-06f823f3a91fcbc32c62fac3c6347715&lt;SEP&gt;chunk-d9882c04dd7676c6433074e5e393c72e&lt;SEP&gt;chunk-bd7ea43a74059d6781866faec437f19a&lt;SEP&gt;chunk-53e3a9418b1d7916e3c8717a397bbb58&lt;SEP&gt;chunk-a65ba958750476cc543741efe815c7c4&lt;SEP&gt;chunk-2dc31077c053f79ff82959575d335956</data>
    </node>
    <node id="Plasma">
      <data key="d0">Plasma</data>
      <data key="d1">category</data>
      <data key="d2">A clear, yellowish fluid component of blood, consisting mostly of water, in which various blood cells float.&lt;SEP&gt;A yellowish, water-based fluid component of blood in which various blood cells float.&lt;SEP&gt;Plasma is the yellowish, mostly liquid component of blood that carries blood cells, nutrients, and waste throughout the body.&lt;SEP&gt;The clear, yellowish fluid component of blood consisting mostly of water that suspends blood cells and transports nutrients, proteins, and waste.</data>
      <data key="d3">chunk-bd7ea43a74059d6781866faec437f19a&lt;SEP&gt;chunk-06f823f3a91fcbc32c62fac3c6347715&lt;SEP&gt;chunk-8b66e38931f28ed6ac9b231faaf202fb&lt;SEP&gt;chunk-2dc31077c053f79ff82959575d335956</data>
    </node>
    <node id="Skin Exams">
      <data key="d0">Skin Exams</data>
      <data key="d1">category</data>
      <data key="d2">Regular clinical evaluations performed by doctors to inspect skin and monitor for recurrence or spread of cutaneous squamous cell carcinoma.</data>
      <data key="d3">chunk-8b66e38931f28ed6ac9b231faaf202fb</data>
    </node>
    <node id="Non-Small Cell Lung Cancer">
      <data key="d0">Non-Small Cell Lung Cancer</data>
      <data key="d1">category</data>
      <data key="d2">Non-Small Cell Lung Cancer (NSCLC) is the most common category of lung carcinoma, arising from cells lining the airways inside the lungs.&lt;SEP&gt;Non-small cell lung cancer (NSCLC) is a major group of lung cancers that arise from cells in the lungs, categorized into various types and stages.&lt;SEP&gt;The most common category of lung carcinoma, encompassing subtypes like adenocarcinoma, squamous cell carcinoma, and large cell carcinoma.&lt;SEP&gt;The most common classification of lung cancer, encompassing subtypes such as adenocarcinoma, squamous cell carcinoma, and large cell carcinoma.</data>
      <data key="d3">chunk-bd06bc83e13e7562ce65d6eee1b6024f&lt;SEP&gt;chunk-7843955573cdc294b34e74019195fafb&lt;SEP&gt;chunk-08475506372bb4ce9ec1bd326caf0fe9&lt;SEP&gt;chunk-ef6586b896c47b361bf4f6aabb4c35d5</data>
    </node>
    <node id="Small Cell Lung Cancer">
      <data key="d0">Small Cell Lung Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A fast-dividing, aggressive cancer of neuroendocrine cells lining the airways of the lungs, characterized by small, oval-, oat-shaped cells under a microscope.&lt;SEP&gt;An aggressive, rapidly dividing neuroendocrine lung carcinoma characterized by small, oval- or oat-shaped cells under microscopic examination.&lt;SEP&gt;Small Cell Lung Cancer is a distinct type of lung cancer differentiated from non-small cell lung cancer.</data>
      <data key="d3">chunk-08475506372bb4ce9ec1bd326caf0fe9&lt;SEP&gt;chunk-7843955573cdc294b34e74019195fafb&lt;SEP&gt;chunk-ef6586b896c47b361bf4f6aabb4c35d5</data>
    </node>
    <node id="Lung Carcinoma">
      <data key="d0">Lung Carcinoma</data>
      <data key="d1">category</data>
      <data key="d2">Lung carcinoma is a broad medical category encompassing cancers that originate in the epithelial cells lining the airways of the lungs.</data>
      <data key="d3">chunk-ef6586b896c47b361bf4f6aabb4c35d5</data>
    </node>
    <node id="CML Specialist">
      <data key="d0">CML Specialist</data>
      <data key="d1">person</data>
      <data key="d2">A medical specialist with advanced expertise in diagnosing, managing, and treating chronic myeloid leukemia.&lt;SEP&gt;A physician with specialized expertise in managing and treating chronic myeloid leukemia, often sought out for expert medical opinions.</data>
      <data key="d3">chunk-7606b44d6a30ad0519bc4c10785de79a&lt;SEP&gt;chunk-ef6586b896c47b361bf4f6aabb4c35d5</data>
    </node>
    <node id="Caregiver">
      <data key="d0">Caregiver</data>
      <data key="d1">person</data>
      <data key="d2">A supportive family member, friend, or peer who assists cancer patients with transportation, appointments, note-taking, and emotional care.&lt;SEP&gt;Family members, friends, or peers providing emotional, logisitical, and observational support to patients during cancer care.&lt;SEP&gt;Friends, family members, or peers who provide emotional support, transportation, meal assistance, and help take notes and ask questions during clinical appointments.&lt;SEP&gt;Loved ones and individuals providing ongoing physical, emotional, practical, and medical decision-making support to primary CNS lymphoma patients.</data>
      <data key="d3">chunk-f9a9eb8b01f29fdf214c10bdffac3203&lt;SEP&gt;chunk-4966a628b12ecec4187796598764cf23&lt;SEP&gt;chunk-829d6b7840e9f2c8d97d22d2ce2c43c1&lt;SEP&gt;chunk-ef6586b896c47b361bf4f6aabb4c35d5</data>
    </node>
    <node id="Specialized CML Treatment Centers">
      <data key="d0">Specialized CML Treatment Centers</data>
      <data key="d1">organization</data>
      <data key="d2">Healthcare institutions and oncology clinics experienced in managing complex chronic myeloid leukemia therapies.</data>
      <data key="d3">chunk-ef6586b896c47b361bf4f6aabb4c35d5</data>
    </node>
    <node id="Doctor Visits">
      <data key="d0">Doctor Visits</data>
      <data key="d1">event</data>
      <data key="d2">Clinical appointments where patients consult with care teams, review test results, and establish treatment plans.&lt;SEP&gt;Clinical appointments where patients meet with their care team and specialists to discuss symptoms, review test results, and formulate treatment plans.&lt;SEP&gt;Clinical consultations and medical appointments where patients consult healthcare providers, review test results, and formulate care plans.&lt;SEP&gt;In-person clinical appointments where patients and caregivers consult with the healthcare team regarding diagnosis, test results, and treatment plans.&lt;SEP&gt;In-person clinical appointments where patients and their caregivers consult with their care team, discuss test findings, and formulate treatment plans.</data>
      <data key="d3">chunk-7606b44d6a30ad0519bc4c10785de79a&lt;SEP&gt;chunk-a06038ec84f20e873b9e275a23aea8d9&lt;SEP&gt;chunk-ef6586b896c47b361bf4f6aabb4c35d5&lt;SEP&gt;chunk-1dc8d8e5ed4f165f3e56305a7644ba05&lt;SEP&gt;chunk-c77e0d4642a374a51f87e7e25b19281f</data>
    </node>
    <node id="Telehealth Visits">
      <data key="d0">Telehealth Visits</data>
      <data key="d1">event</data>
      <data key="d2">Remote healthcare consultations conducted by phone or digital video to review patient care and address medical concerns.&lt;SEP&gt;Remote medical consultations conducted via phone or video platforms enabling patients and caregivers to consult with healthcare providers.</data>
      <data key="d3">chunk-7606b44d6a30ad0519bc4c10785de79a&lt;SEP&gt;chunk-ef6586b896c47b361bf4f6aabb4c35d5</data>
    </node>
    <node id="Bone Marrow Tests">
      <data key="d0">Bone Marrow Tests</data>
      <data key="d1">category</data>
      <data key="d2">Clinical diagnostic tests performed to evaluate bone marrow cellularity, genetic changes, and blast cell percentage.&lt;SEP&gt;Diagnostic procedures performed on bone marrow samples to identify causes of low blood cell counts in cancer patients.&lt;SEP&gt;Diagnostic procedures used to evaluate bone marrow pathology, blast percentage, and genetic biomarkers in CML.</data>
      <data key="d3">chunk-7606b44d6a30ad0519bc4c10785de79a&lt;SEP&gt;chunk-67015f3916810c4378b2ed269cc27f29&lt;SEP&gt;chunk-ef6586b896c47b361bf4f6aabb4c35d5</data>
    </node>
    <node id="Early And Locally Advanced NSCLC">
      <data key="d0">Early And Locally Advanced NSCLC</data>
      <data key="d1">category</data>
      <data key="d2">A clinical stage category of non-small cell lung cancer describing disease localized to the lung or spread to nearby airway structures.</data>
      <data key="d3">chunk-ef6586b896c47b361bf4f6aabb4c35d5</data>
    </node>
    <node id="Adenocarcinoma">
      <data key="d0">Adenocarcinoma</data>
      <data key="d1">category</data>
      <data key="d2">A category of invasive colon cancer that originates from an adenomatous polyp.&lt;SEP&gt;A category of stomach cancer that begins in the mucus-producing cells lining the stomach, representing almost all stomach cancers.&lt;SEP&gt;A histological subtype of cervical cancer arising from glandular tissue in the cervix.&lt;SEP&gt;A histological subtype of cervical cancer assessed when evaluating risk criteria for treatment pathways.&lt;SEP&gt;A specific subtype of non-small cell lung cancer.&lt;SEP&gt;Adenocarcinoma is a major type of cervical cancer subject to specific clinical staging and treatment approaches.&lt;SEP&gt;Adenocarcinoma is a malignant cancer that develops specifically within an adenoma.&lt;SEP&gt;Adenocarcinoma is a type of cervical cancer accounting for approximately 20% of cases, arising from mucus-producing glandular cells in the endocervical canal.&lt;SEP&gt;Adenocarcinoma is an uncommon non-urothelial histological type of bladder cancer.&lt;SEP&gt;Adenocarcinoma is the most common histologic type of rectal tumor, typically arising from pre-existing adenomatous polyps.&lt;SEP&gt;Adenocarcinoma is the most common subtype of NSCLC, commonly developing from cells that line the alveoli and produce mucus.&lt;SEP&gt;An adenocarcinoma is a category of colon cancer that specifically originates from an adenoma.&lt;SEP&gt;An uncommon non-urothelial type of bladder cancer developing in glandular cells.&lt;SEP&gt;The most common subtype of non-small cell lung cancer, originating in mucus-producing cells lining the alveoli.&lt;SEP&gt;The most common type of colon cancer, which originates and develops from an adenomatous polyp.&lt;SEP&gt;The specific category of stomach cancer originating in the mucus-secreting cells lining the inside of the stomach wall, representing the majority of gastric cancers.</data>
      <data key="d3">chunk-c77e0d4642a374a51f87e7e25b19281f&lt;SEP&gt;chunk-bb68daec67dd8f436d82814b0e61ff21&lt;SEP&gt;chunk-8ec4d44b145ca896ff1216caa90ce5dd&lt;SEP&gt;chunk-c5bc83f5f4f3e29b7f0a6f4787c3ad83&lt;SEP&gt;chunk-ee254e84e63bd35682ed56c41cef9247&lt;SEP&gt;chunk-b5cfcc365cd093374564eb27dcbf5b82&lt;SEP&gt;chunk-bd06bc83e13e7562ce65d6eee1b6024f&lt;SEP&gt;chunk-08475506372bb4ce9ec1bd326caf0fe9&lt;SEP&gt;chunk-b4d036ee5fd77783b9e7ddef3a8477ae&lt;SEP&gt;chunk-95c76786e9d6dbf06ddf5d55af0cf658&lt;SEP&gt;chunk-e247ae57c50c62bded7114986471226e&lt;SEP&gt;chunk-f9a9eb8b01f29fdf214c10bdffac3203&lt;SEP&gt;chunk-f2c9770fd98dbbe3c7947601fb3e654c&lt;SEP&gt;chunk-8aa2c7020ce6e89888e81972588726e3&lt;SEP&gt;chunk-7843955573cdc294b34e74019195fafb&lt;SEP&gt;chunk-01c80b2d18abb91c5be598d33cf7a33a</data>
    </node>
    <node id="Large Cell Carcinoma">
      <data key="d0">Large Cell Carcinoma</data>
      <data key="d1">category</data>
      <data key="d2">An undifferentiated subtype of non-small cell lung cancer originating in large cells capable of growing anywhere in the lungs.&lt;SEP&gt;An undifferentiated subtype of non-small cell lung cancer that can develop anywhere in the lungs.&lt;SEP&gt;Large cell carcinoma is a subtype of NSCLC that originates from large cells located throughout the respiratory airways.</data>
      <data key="d3">chunk-bd06bc83e13e7562ce65d6eee1b6024f&lt;SEP&gt;chunk-7843955573cdc294b34e74019195fafb&lt;SEP&gt;chunk-08475506372bb4ce9ec1bd326caf0fe9</data>
    </node>
    <node id="Early and Locally Advanced NSCLC">
      <data key="d0">Early and Locally Advanced NSCLC</data>
      <data key="d1">category</data>
      <data key="d2">A classification of lung cancer encompassing stages 1, 2, and 3, where cancer has grown from airways into lung tissue or lymph nodes without spreading to distant organs.</data>
      <data key="d3">chunk-bd06bc83e13e7562ce65d6eee1b6024f</data>
    </node>
    <node id="Metastatic Cancer">
      <data key="d0">Metastatic Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A stage or classification of cervical cancer that has spread beyond its primary site, commonly treated with targeted therapy and immunotherapy.&lt;SEP&gt;Advanced cancer that has spread beyond the primary site to distant organs such as the lungs or distant lymph nodes.&lt;SEP&gt;An advanced disease stage where thyroid cancer spreads to distant organs, such as the lungs, liver, bones, brain, or spinal cord.&lt;SEP&gt;Cancer that has progressed and spread to the tissue lining around the lung or to distant organs, classified as stage 4.&lt;SEP&gt;Very advanced cancer that has spread from its primary origin to distant sites such as the lungs and distant lymph nodes.</data>
      <data key="d3">chunk-5d8e20e6004dd43ae0f68185383b594d&lt;SEP&gt;chunk-8ec4d44b145ca896ff1216caa90ce5dd&lt;SEP&gt;chunk-d9882c04dd7676c6433074e5e393c72e&lt;SEP&gt;chunk-bd06bc83e13e7562ce65d6eee1b6024f&lt;SEP&gt;chunk-9d383e4798456aa46e381fd2b02f6f96</data>
    </node>
    <node id="Lung Nodules">
      <data key="d0">Lung Nodules</data>
      <data key="d1">category</data>
      <data key="d2">Small masses of tissue found in the lungs that can be benign or malignant and are evaluated by medical specialists to determine if they are cancerous.</data>
      <data key="d3">chunk-bd06bc83e13e7562ce65d6eee1b6024f</data>
    </node>
    <node id="Pulmonologist">
      <data key="d0">Pulmonologist</data>
      <data key="d1">category</data>
      <data key="d2">A medical doctor and board-certified specialist with expertise in diagnosing and managing lung diseases.&lt;SEP&gt;A physician specializing in diseases and conditions of the respiratory system who assesses patients with suspected lung cancer.&lt;SEP&gt;A physician who specializes in lung diseases and participates in the diagnosis, evaluation, and management of lung nodules and cancer.</data>
      <data key="d3">chunk-bd06bc83e13e7562ce65d6eee1b6024f&lt;SEP&gt;chunk-7843955573cdc294b34e74019195fafb&lt;SEP&gt;chunk-ecc6c4bcd3cab65fa05ab5f3c55e528d</data>
    </node>
    <node id="Thoracic Radiologist">
      <data key="d0">Thoracic Radiologist</data>
      <data key="d1">category</data>
      <data key="d2">A diagnostic imaging specialist focused on analyzing imaging studies of the chest and thoracic structures.&lt;SEP&gt;A medical doctor specialized in chest imaging to identify and analyze abnormalities such as lung nodules.&lt;SEP&gt;A physician specialized in interpreting diagnostic chest imaging to evaluate lung nodules and chest abnormalities.</data>
      <data key="d3">chunk-bd06bc83e13e7562ce65d6eee1b6024f&lt;SEP&gt;chunk-7843955573cdc294b34e74019195fafb&lt;SEP&gt;chunk-ecc6c4bcd3cab65fa05ab5f3c55e528d</data>
    </node>
    <node id="Thoracic Surgeon">
      <data key="d0">Thoracic Surgeon</data>
      <data key="d1">category</data>
      <data key="d2">A board-certified surgical specialist who performs operations inside the chest cavity.&lt;SEP&gt;A surgeon specialized in performing chest operations, including the surgical removal of cancerous lung tissue.&lt;SEP&gt;A surgical specialist who operates on organs within the chest cavity, including the lungs and esophagus.</data>
      <data key="d3">chunk-bd06bc83e13e7562ce65d6eee1b6024f&lt;SEP&gt;chunk-7843955573cdc294b34e74019195fafb&lt;SEP&gt;chunk-ecc6c4bcd3cab65fa05ab5f3c55e528d</data>
    </node>
    <node id="Stage 1 Lung Cancer">
      <data key="d0">Stage 1 Lung Cancer</data>
      <data key="d1">category</data>
      <data key="d2">Early-stage non-small cell lung cancer where the tumor has grown from the airway into lung tissue without widespread regional nodal involvement.</data>
      <data key="d3">chunk-bd06bc83e13e7562ce65d6eee1b6024f</data>
    </node>
    <node id="Stage 2 and 3 Lung Cancer">
      <data key="d0">Stage 2 and 3 Lung Cancer</data>
      <data key="d1">category</data>
      <data key="d2">Locally advanced stages of non-small cell lung cancer that have invaded lung tissue and may have spread to nearby lymph nodes.</data>
      <data key="d3">chunk-bd06bc83e13e7562ce65d6eee1b6024f</data>
    </node>
    <node id="Stage 4 Lung Cancer">
      <data key="d0">Stage 4 Lung Cancer</data>
      <data key="d1">category</data>
      <data key="d2">Advanced metastatic lung cancer identified at diagnosis where malignant cells have spread to the lung lining or distant organs.</data>
      <data key="d3">chunk-bd06bc83e13e7562ce65d6eee1b6024f</data>
    </node>
    <node id="Stomach Cancer">
      <data key="d0">Stomach Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A category of malignancy originating within the stomach, an organ of the gastrointestinal system.&lt;SEP&gt;A major category of oncological disease that primarily originates as adenocarcinomas in the inner lining of the stomach and can spread through its wall layers.&lt;SEP&gt;A malignancy originating in the stomach, referenced to illustrate that primary cancers metastasizing to the lungs retain their original organ identity.</data>
      <data key="d3">chunk-bd06bc83e13e7562ce65d6eee1b6024f&lt;SEP&gt;chunk-5fdcf47f3da06d3e0213112c96eb93d4&lt;SEP&gt;chunk-01c80b2d18abb91c5be598d33cf7a33a</data>
    </node>
    <node id="Chemoradiation">
      <data key="d0">Chemoradiation</data>
      <data key="d1">category</data>
      <data key="d2">A cancer therapy combining external beam radiation therapy with platinum-based chemotherapy.&lt;SEP&gt;A cancer treatment combining chemotherapy and radiation therapy concurrently, commonly used as initial therapy for anal cancer.&lt;SEP&gt;A cancer treatment combining chemotherapy and radiation therapy, used for locally advanced rectal cancers or as post-surgical therapy.&lt;SEP&gt;A cancer treatment modality combining radiation therapy with chemotherapy to treat cervical cancer.&lt;SEP&gt;A combined oncology treatment regimen consisting of chemotherapy and radiation therapy used for specific cancer stages.&lt;SEP&gt;A combined treatment modality employing both chemotherapy and radiation therapy concurrently, recommended as primary therapy for non-metastatic anal cancer.&lt;SEP&gt;A combined treatment modality of chemotherapy and radiation therapy, recommended as the primary curative regimen for most non-metastatic anal cancers.&lt;SEP&gt;A combined treatment protocol administering external beam radiation therapy and chemotherapy concurrently, commonly prescribed for locally advanced cervical cancer.&lt;SEP&gt;A combined treatment protocol of chemotherapy and radiation therapy given for cervical cancer.&lt;SEP&gt;A combined treatment protocol that administers chemotherapy and radiation therapy together to enhance therapeutic effectiveness.&lt;SEP&gt;A concurrent treatment strategy combining external beam radiation therapy (EBRT) and chemotherapy, typically recommended for locally advanced cervical cancer.&lt;SEP&gt;A multimodal cancer treatment approach that combines radiation therapy with concurrent chemotherapy regimens.&lt;SEP&gt;A multimodal therapeutic procedure combining external beam radiation therapy and platinum-based chemotherapy.&lt;SEP&gt;A primary treatment regimen combining radiation therapy with chemotherapy, recommended for stage III, sphincter-invasive stage II, or high-grade stage I/II perianal and anal canal cancers.&lt;SEP&gt;Chemoradiation is a combination treatment protocol involving chemotherapy and radiation therapy, recommended for most non-metastatic anal cancers.&lt;SEP&gt;Chemoradiation is a combined therapeutic modality involving chemotherapy and radiation therapy frequently utilized in anal cancer treatment.&lt;SEP&gt;Chemoradiation is a combined therapeutic modality utilizing concurrent chemotherapy and radiation therapy.&lt;SEP&gt;Chemoradiation is a combined treatment strategy that administers EBRT and platinum-based chemotherapy concurrently, commonly used for locally advanced cervical cancer.</data>
      <data key="d3">chunk-6236b93e627d54f73f1c8fe341127e67&lt;SEP&gt;chunk-06384634b72466c480713ee8d57f25ed&lt;SEP&gt;chunk-419f40f64b13b1b2d0fac3cfb9fde92a&lt;SEP&gt;chunk-5349eed06f06d7c9bcb541ced69e4664&lt;SEP&gt;chunk-b0bad5ee25cb854c10bdbc9d33b54a1a&lt;SEP&gt;chunk-0d4cea71149e0e4157126efdaa0ea3e3&lt;SEP&gt;chunk-8ec4d44b145ca896ff1216caa90ce5dd&lt;SEP&gt;chunk-d04ad65c55d0dbbee5061cf3b24030ef&lt;SEP&gt;chunk-e247ae57c50c62bded7114986471226e&lt;SEP&gt;chunk-bd06bc83e13e7562ce65d6eee1b6024f&lt;SEP&gt;chunk-b3ba7430f3a31330247f52afe7e9c68a&lt;SEP&gt;chunk-95c76786e9d6dbf06ddf5d55af0cf658&lt;SEP&gt;chunk-37bca9f4d2ebaeed359c9b4eb7a0c1de&lt;SEP&gt;chunk-0fdcce851d69aa713ed64ba1895bd5d1&lt;SEP&gt;chunk-c9bfa651267335dd5e6ae5a24d85a072&lt;SEP&gt;chunk-e9a7fe3b15f3289198c7114b44890dea&lt;SEP&gt;chunk-29b3a349650a8bb55b318dcc6ecb0519&lt;SEP&gt;chunk-48b513355d29308e212a3074ba326b10</data>
    </node>
    <node id="Supportive Care">
      <data key="d0">Supportive Care</data>
      <data key="d1">category</data>
      <data key="d2">A form of medical care focused on relieving symptoms of cancer and the adverse side effects of treatment to improve patient quality of life.&lt;SEP&gt;A range of palliative and comfort-focused resources—including pain management, hospice, and advance care planning—for patients with advanced or metastatic cancer.&lt;SEP&gt;A treatment category designed to manage symptoms and therapy side effects to maintain patient quality of life.&lt;SEP&gt;A type of medical care designed to relieve symptoms, discomfort, and treatment side effects to improve patient quality of life.&lt;SEP&gt;Also known as palliative care, this medical care focuses on relieving symptoms, reducing side effects, and maintaining patient quality of life across any stage of cancer.&lt;SEP&gt;An integral part of cancer care focused on managing symptoms, addressing patient challenges, and providing holistic care throughout treatment.&lt;SEP&gt;Care aimed at comfort and symptom management, available as a treatment option whether a patient is undergoing active cancer treatment or not.&lt;SEP&gt;Care focused on relieving symptoms, managing side effects, and improving quality of life for cancer patients.&lt;SEP&gt;Comprehensive patient care designed to manage symptoms, improve quality of life, and address cancer challenges alongside primary treatments.&lt;SEP&gt;Medical and personal care aimed at managing symptoms, side effects, and health challenges associated with cancer treatment.&lt;SEP&gt;Patient care modalities aimed at managing symptoms, side effects, and overall quality of life during prostate cancer treatment.&lt;SEP&gt;Supportive care is a form of health care focused on relieving symptoms and improving quality of life for cancer patients at any stage.&lt;SEP&gt;Supportive care refers to medical interventions aimed at preventing or managing the side effects of cancer treatment and improving patient well-being.&lt;SEP&gt;Supportive care refers to medical therapies and management strategies designed to alleviate symptoms, side effects, and complications of cancer treatment.&lt;SEP&gt;Supportive care refers to medical treatments and practices focused on managing treatment side effects and improving patient comfort during cancer therapy.&lt;SEP&gt;Therapeutic interventions focused on relieving symptoms, reducing side effects, and supporting quality of life for cancer patients.</data>
      <data key="d3">chunk-6268b6efa690f6e094e443dca6b4cb52&lt;SEP&gt;chunk-29c9b8b5fd2cd967c48522af79a9598f&lt;SEP&gt;chunk-b3958b5f7df8a8fc2661705e37dc1e06&lt;SEP&gt;chunk-a158766f46bf752d6cdfe95c92f14547&lt;SEP&gt;chunk-c5bc83f5f4f3e29b7f0a6f4787c3ad83&lt;SEP&gt;chunk-0fb70c1c798caae12ac2d64e61bcbad4&lt;SEP&gt;chunk-d0f15711706bc171fed17a7fab91b4b6&lt;SEP&gt;chunk-db3a86fc5d439d9bfb3845e468a2a551&lt;SEP&gt;chunk-bd06bc83e13e7562ce65d6eee1b6024f&lt;SEP&gt;chunk-53e3a9418b1d7916e3c8717a397bbb58&lt;SEP&gt;chunk-97836a515d346931beb424ae40a89877&lt;SEP&gt;chunk-9d0e32bdc49dbab9c2c953abf363e317&lt;SEP&gt;chunk-8ba71a5181f3814dffb21d3399441bea&lt;SEP&gt;chunk-e9a7fe3b15f3289198c7114b44890dea&lt;SEP&gt;chunk-9e8b25c2957355218780bdfd8b72df45&lt;SEP&gt;chunk-541f1323a24c5990b4a6408e0c5442ab</data>
    </node>
    <node id="Solid Nodules">
      <data key="d0">Solid Nodules</data>
      <data key="d1">category</data>
      <data key="d2">A type of lung nodule composed entirely of dense soft tissue that requires structured clinical follow-up.</data>
      <data key="d3">chunk-bd06bc83e13e7562ce65d6eee1b6024f</data>
    </node>
    <node id="Subsolid Nodules">
      <data key="d0">Subsolid Nodules</data>
      <data key="d1">category</data>
      <data key="d2">A category of lung nodules with partial or ground-glass density requiring careful monitoring to determine cancer risk.</data>
      <data key="d3">chunk-bd06bc83e13e7562ce65d6eee1b6024f</data>
    </node>
    <node id="Lung Nodule">
      <data key="d0">Lung Nodule</data>
      <data key="d1">category</data>
      <data key="d2">A small mass of tissue located in the lung that requires imaging evaluation to rule out malignancy.</data>
      <data key="d3">chunk-7843955573cdc294b34e74019195fafb</data>
    </node>
    <node id="Tobacco Smoke">
      <data key="d0">Tobacco Smoke</data>
      <data key="d1">category</data>
      <data key="d2">A leading environmental risk factor and major cause of lung cancer, containing over 50 known carcinogenic compounds.</data>
      <data key="d3">chunk-7843955573cdc294b34e74019195fafb</data>
    </node>
    <node id="Lung Cancer Screening">
      <data key="d0">Lung Cancer Screening</data>
      <data key="d1">event</data>
      <data key="d2">A medical detection process aimed at discovering lung cancer in high-risk individuals at an early stage prior to the development of symptoms.&lt;SEP&gt;A preventive medical evaluation recommended for high-risk individuals to identify lung cancer at its earliest, most treatable stages.</data>
      <data key="d3">chunk-08475506372bb4ce9ec1bd326caf0fe9&lt;SEP&gt;chunk-7843955573cdc294b34e74019195fafb</data>
    </node>
    <node id="Carcinoma">
      <data key="d0">Carcinoma</data>
      <data key="d1">category</data>
      <data key="d2">A broad classification of cancers that start in cells lining the inner or outer surfaces of the body.&lt;SEP&gt;A category of cancer that originates in the cells lining the inner or outer surfaces of the body, which includes almost all breast cancers.&lt;SEP&gt;A classification of cancer that originates in the epithelial cells lining the airways, representing almost all primary lung cancers.&lt;SEP&gt;A major cancer type originating in epithelial cells lining inner or outer body surfaces, accounting for almost all breast cancers.&lt;SEP&gt;A subtype of cancer starting in the cells that line the tissues and airways of the lungs, accounting for the vast majority of lung cancers.</data>
      <data key="d3">chunk-a06038ec84f20e873b9e275a23aea8d9&lt;SEP&gt;chunk-48e138ec8da954a5667dc785e919c86b&lt;SEP&gt;chunk-08475506372bb4ce9ec1bd326caf0fe9&lt;SEP&gt;chunk-1dc8d8e5ed4f165f3e56305a7644ba05&lt;SEP&gt;chunk-7843955573cdc294b34e74019195fafb</data>
    </node>
    <node id="Breast Cancer">
      <data key="d0">Breast Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A broad disease category referring to malignant cell growth originating in breast tissue, which can develop in individuals of any gender.&lt;SEP&gt;A broader disease category where cancer begins in the tissues of the breast, such as the ducts or lobules, before potentially spreading into surrounding tissue.&lt;SEP&gt;A cancer category linked to shared inherited germline mutations such as BRCA1 and BRCA2 alongside prostate cancer.&lt;SEP&gt;A cancer originating in breast tissue, for which health care providers may conduct routine screenings.&lt;SEP&gt;A cancer type whose occurrence in a person's family history is associated with an increased risk of developing prostate cancer.&lt;SEP&gt;A category of malignant disease starting in the cells of the breast, which includes ductal carcinoma and lobular carcinoma.&lt;SEP&gt;A disease category characterized by malignant cell growth in breast tissue, primarily originating in the ductal or lobular areas and capable of affecting individuals of any gender.&lt;SEP&gt;A disease category where malignant cells form in breast tissues, commonly starting in the milk ducts or lobules and occurring more frequently in persons assigned female at birth.&lt;SEP&gt;A distinct cancer type that can metastasize to the lungs while retaining its primary breast cancer biological classification.&lt;SEP&gt;A major category of cancer that originates in the cells of the breast, occurring in individuals of all genders.&lt;SEP&gt;A malignancy whose risk is heightened by inherited mutations in genes such as BRCA1 and BRCA2.&lt;SEP&gt;A oncological condition involving malignant breast tumors that can metastasize to distant body parts such as the brain or spine.&lt;SEP&gt;A type of cancer for which biomarker testing, tumor markers, and hereditary genetic risk testing are used to evaluate disease and determine therapy.&lt;SEP&gt;A type of malignancy diagnosed in breast tissue, requiring tailored clinical management, diagnostic screening, and non-hormonal birth control.&lt;SEP&gt;A type of malignancy that can be hormone receptor-positive or HER2-negative, commonly treated with targeted, systemic, and endocrine therapies.&lt;SEP&gt;Breast cancer is a malignancy whose personal or familial history is assessed in connection with hereditary cancer syndromes that also confer risk for thyroid cancer.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408&lt;SEP&gt;chunk-0bd86bf8fc82f14fa5f7f51d924514e7&lt;SEP&gt;chunk-789ec6c06f8c999ac21c89b085b3fdb7&lt;SEP&gt;chunk-c37f547042fc10baabdbfaadf010bce5&lt;SEP&gt;chunk-5846f51c2ca4fae54459ce9c50e3e820&lt;SEP&gt;chunk-1c7418fb993bb3daa95d8563909da1de&lt;SEP&gt;chunk-18b5e32980f3efa0cd012e2abab9b9fc&lt;SEP&gt;chunk-53c0ac935ec10ce8a0839db4ad053ad1&lt;SEP&gt;chunk-08475506372bb4ce9ec1bd326caf0fe9&lt;SEP&gt;chunk-6a93aa507dd7d98a02e8ba92d39e3649&lt;SEP&gt;chunk-965e5a6bad03f2129a98be4373f99176&lt;SEP&gt;chunk-7390896141393e0b4d1c15df77b5c0a7&lt;SEP&gt;chunk-1dc8d8e5ed4f165f3e56305a7644ba05&lt;SEP&gt;chunk-650982a589c2d527bc13923ccd0569ef&lt;SEP&gt;chunk-a2778e34af702d49d5e70867726e14b2&lt;SEP&gt;chunk-7843955573cdc294b34e74019195fafb</data>
    </node>
    <node id="Second-Hand Smoke">
      <data key="d0">Second-Hand Smoke</data>
      <data key="d1">category</data>
      <data key="d2">Inhaled smoke from combustible tobacco products or exhaled by another person, serving as an environmental risk factor for lung cancer.&lt;SEP&gt;Involuntary tobacco smoke exposure from exhaled smoke or burning tobacco products that heightens the risk of developing lung cancer.&lt;SEP&gt;Tobacco smoke exhaled by smokers or burning tobacco products, which increases the risk of lung cancer in non-smokers.</data>
      <data key="d3">chunk-08475506372bb4ce9ec1bd326caf0fe9&lt;SEP&gt;chunk-7843955573cdc294b34e74019195fafb&lt;SEP&gt;chunk-ecc6c4bcd3cab65fa05ab5f3c55e528d</data>
    </node>
    <node id="Radon">
      <data key="d0">Radon</data>
      <data key="d1">category</data>
      <data key="d2">A hazardous environmental radioactive gas identified as a significant risk factor and cause of lung cancer.&lt;SEP&gt;A radioactive chemical substance and environmental carcinogen that increases the risk of lung cancer.</data>
      <data key="d3">chunk-7843955573cdc294b34e74019195fafb&lt;SEP&gt;chunk-ecc6c4bcd3cab65fa05ab5f3c55e528d</data>
    </node>
    <node id="Asbestos">
      <data key="d0">Asbestos</data>
      <data key="d1">category</data>
      <data key="d2">A fibrous mineral and occupational carcinogen associated with elevated risk of developing lung cancer.&lt;SEP&gt;A fibrous mineral carcinogen known to elevate the likelihood of lung cancer, particularly among individuals exposed to tobacco smoke.</data>
      <data key="d3">chunk-7843955573cdc294b34e74019195fafb&lt;SEP&gt;chunk-ecc6c4bcd3cab65fa05ab5f3c55e528d</data>
    </node>
    <node id="Air Pollution">
      <data key="d0">Air Pollution</data>
      <data key="d1">category</data>
      <data key="d2">An environmental risk factor comprised of fine particulates, ozone, nitrogen oxides, and sulfur dioxide that contributes to lung cancer risk.</data>
      <data key="d3">chunk-7843955573cdc294b34e74019195fafb</data>
    </node>
    <node id="Chemopreventive Agents">
      <data key="d0">Chemopreventive Agents</data>
      <data key="d1">category</data>
      <data key="d2">Medical compounds and therapeutic substances under research to prevent cancer development in high-risk individuals.</data>
      <data key="d3">chunk-7843955573cdc294b34e74019195fafb</data>
    </node>
    <node id="Adenosquamous Carcinoma">
      <data key="d0">Adenosquamous Carcinoma</data>
      <data key="d1">category</data>
      <data key="d2">A histological subtype of cervical cancer exhibiting both squamous and glandular cell characteristics.&lt;SEP&gt;A recognized histological subtype of non-small cell lung cancer.&lt;SEP&gt;A recognized subtype of non-small cell lung cancer.&lt;SEP&gt;Adenosquamous carcinoma is a less common cervical cancer subtype containing both squamous and glandular adenocarcinoma cells.&lt;SEP&gt;Adenosquamous carcinoma is a recognized subtype of cervical cancer addressed in the treatment recommendations.</data>
      <data key="d3">chunk-08475506372bb4ce9ec1bd326caf0fe9&lt;SEP&gt;chunk-b4d036ee5fd77783b9e7ddef3a8477ae&lt;SEP&gt;chunk-8ec4d44b145ca896ff1216caa90ce5dd&lt;SEP&gt;chunk-95c76786e9d6dbf06ddf5d55af0cf658</data>
    </node>
    <node id="Sarcomatoid Carcinoma">
      <data key="d0">Sarcomatoid Carcinoma</data>
      <data key="d1">category</data>
      <data key="d2">A recognized subtype of non-small cell lung cancer.</data>
      <data key="d3">chunk-08475506372bb4ce9ec1bd326caf0fe9</data>
    </node>
    <node id="Combined Cell Lung Carcinoma">
      <data key="d0">Combined Cell Lung Carcinoma</data>
      <data key="d1">category</data>
      <data key="d2">A lung cancer variant containing both small cell and non-small cell lung cancer cells, generally treated like small cell lung cancer.</data>
      <data key="d3">chunk-08475506372bb4ce9ec1bd326caf0fe9</data>
    </node>
    <node id="Smoking">
      <data key="d0">Smoking</data>
      <data key="d1">category</data>
      <data key="d2">A behavioral lifestyle habit recognized as the primary risk factor for developing bladder cancer.&lt;SEP&gt;A lifestyle risk factor that contributes to an increased likelihood of developing anal cancer.&lt;SEP&gt;A major lifestyle risk factor category linked to about half of all bladder cancer cases.&lt;SEP&gt;Cigarette smoking is the primary cause and prominent risk factor for small cell lung cancer.&lt;SEP&gt;The consumption of tobacco products, which triples the risk of death from bladder cancer and complicates treatment.</data>
      <data key="d3">chunk-68217ea9e5382d1756c99b5152ea98db&lt;SEP&gt;chunk-7a890e27eba8c63d10f19b85a72fc14a&lt;SEP&gt;chunk-08475506372bb4ce9ec1bd326caf0fe9&lt;SEP&gt;chunk-9530f389987c13273449ab22a85170ae&lt;SEP&gt;chunk-8aa2c7020ce6e89888e81972588726e3</data>
    </node>
    <node id="Small Cell Carcinoma">
      <data key="d0">Small Cell Carcinoma</data>
      <data key="d1">category</data>
      <data key="d2">A rare and aggressive non-urothelial subtype of bladder cancer.&lt;SEP&gt;A specific histological subtype of small cell lung cancer characterized by small and blue-staining cells when examined under a microscope.&lt;SEP&gt;Small cell carcinoma is a rare non-urothelial subtype of bladder cancer.</data>
      <data key="d3">chunk-08475506372bb4ce9ec1bd326caf0fe9&lt;SEP&gt;chunk-8aa2c7020ce6e89888e81972588726e3&lt;SEP&gt;chunk-f9a9eb8b01f29fdf214c10bdffac3203</data>
    </node>
    <node id="Prostate Cancer">
      <data key="d0">Prostate Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A category of cancer affecting the prostate gland, commonly treated with androgen deprivation therapy and various hormone therapies.&lt;SEP&gt;A common cancer occurring in the prostate gland of the male reproductive system, often developing slowly with few early symptoms and having high survival rates when diagnosed early.&lt;SEP&gt;A common cancer that occurs when cells in the prostate gland mutate and multiply out of control, potentially spreading beyond the gland.&lt;SEP&gt;A complex malignancy of the prostate gland that can range from early-stage to advanced-stage, whose growth is typically fueled by male hormones such as testosterone.&lt;SEP&gt;A disease and oncology category characterized by abnormal cell and tumor growth within the prostate gland.&lt;SEP&gt;A disease category characterized by malignant cell growth in the prostate gland and potentially spreading to pelvic lymph nodes or bones.&lt;SEP&gt;A disease characterized by malignant cell growth within the prostate gland, evaluated and categorized using diagnostic markers and grading scales.&lt;SEP&gt;A disease characterized by the growth of cancerous cells in the prostate gland, which may spread to nearby lymph nodes or bones.&lt;SEP&gt;A form of cancer affecting the prostate gland, classified into various risk categories from very low risk to very high risk to direct treatment decisions.&lt;SEP&gt;A form of cancer that originates in the prostate gland and may spread to surrounding lymph nodes, pelvis, and bones.&lt;SEP&gt;A malignant disease affecting the prostate that can metastasize to lymph nodes, bones, or internal organs, evaluated through biopsies, genetic tests, and staging systems.&lt;SEP&gt;A medical condition that develops when cells in the prostate gland grow out of control. It is commonly slow-growing and can be categorized into localized or advanced stages.&lt;SEP&gt;A medical condition that develops when cells in the prostate gland multiply out of control, influenced by age, genetics, and family history.&lt;SEP&gt;A type of cancer affecting the prostate gland, evaluated during regular medical checkups and screenings.&lt;SEP&gt;Prostate cancer is a disease characterized by the uncontrolled growth of cells within the prostate gland, with risk influenced by age, genetics, race, and lifestyle.&lt;SEP&gt;Prostate cancer is a malignant disease originating in the prostate gland cells, which can express prostate-specific membrane antigen (PSMA) and spread to other parts of the body.</data>
      <data key="d3">chunk-9dc281a303d0d4c5300c0c1c45b739ed&lt;SEP&gt;chunk-6232dd9ed168a1113955e7300645338b&lt;SEP&gt;chunk-789ec6c06f8c999ac21c89b085b3fdb7&lt;SEP&gt;chunk-975e540ddee1810d43caf8df4adcf205&lt;SEP&gt;chunk-1d61a5e7031ea811cc4dcc55a0a0e8fa&lt;SEP&gt;chunk-aeafa486bfd320cdaa7811ad75777912&lt;SEP&gt;chunk-1c7418fb993bb3daa95d8563909da1de&lt;SEP&gt;chunk-c6d28b36fe82792dfb86e98ef76b3b04&lt;SEP&gt;chunk-0fb70c1c798caae12ac2d64e61bcbad4&lt;SEP&gt;chunk-b3958b5f7df8a8fc2661705e37dc1e06&lt;SEP&gt;chunk-53c0ac935ec10ce8a0839db4ad053ad1&lt;SEP&gt;chunk-67e9c4dc95841db7d0af39e1267ae71b&lt;SEP&gt;chunk-08475506372bb4ce9ec1bd326caf0fe9&lt;SEP&gt;chunk-965e5a6bad03f2129a98be4373f99176&lt;SEP&gt;chunk-697db1653f51e966e79b92eefeb01ec6&lt;SEP&gt;chunk-b3c0f6d26f2f58ca13201c1a90b0a180</data>
    </node>
    <node id="Health Care Provider">
      <data key="d0">Health Care Provider</data>
      <data key="d1">person</data>
      <data key="d2">A clinical professional responsible for conducting physical examinations, reviewing family and medical history, and managing diagnostic testing.&lt;SEP&gt;A clinical professional responsible for patient care who discusses treatment plans and refers patients for genetic testing.&lt;SEP&gt;A medical clinician or care team member who assesses patient history, orders biomarker and genetic testing, and guides treatment.&lt;SEP&gt;A medical practitioner responsible for patient evaluations, suggesting genetic testing, and making specialist referrals.&lt;SEP&gt;A medical professional or member of the cancer care team who examines the patient, reviews diagnostic reports, and guides cancer treatment plans.&lt;SEP&gt;A medical professional responsible for conducting physical exams, assessing organs and oral cavities, and providing clinical care.&lt;SEP&gt;A medical professional responsible for evaluating patients, conducting physical exams, interpreting tests, and delivering cancer care.&lt;SEP&gt;A medical professional who conducts checkups, assesses individual cancer risks, and advises patients on lung cancer screening eligibility.&lt;SEP&gt;A medical professional who consults with the patient regarding biopsy results, histological findings, and subsequent treatment steps.&lt;SEP&gt;A medical professional who reviews family history, performs examinations, orders diagnostic tests, and refers patients for specialized oncology or genetic evaluations.&lt;SEP&gt;Medical professionals responsible for receiving diagnostic reports, discussing results, and directing patient cancer care.&lt;SEP&gt;The medical practitioner or care team responsible for managing patient diagnosis, treatment decisions, fertility guidance, and reviewing imaging reports.</data>
      <data key="d3">chunk-705ff2bd04b2b58b98187f60f23a659e&lt;SEP&gt;chunk-6b02315423350f3598288e189fbcb8ae&lt;SEP&gt;chunk-052101b592e186cce702983d2acc67e4&lt;SEP&gt;chunk-711bee9440e11d7c737bc4a49b880910&lt;SEP&gt;chunk-08475506372bb4ce9ec1bd326caf0fe9&lt;SEP&gt;chunk-5fdcf47f3da06d3e0213112c96eb93d4&lt;SEP&gt;chunk-965e5a6bad03f2129a98be4373f99176&lt;SEP&gt;chunk-fc469adbdd7a41816d59f249439bc726&lt;SEP&gt;chunk-5fa7c7369d88ae71c842152510867223&lt;SEP&gt;chunk-650982a589c2d527bc13923ccd0569ef&lt;SEP&gt;chunk-7bdde77ad1be3ee9308db3c7703674b0&lt;SEP&gt;chunk-562e1870b5e20f8648a2e56d960a1148</data>
    </node>
    <node id="Scientists">
      <data key="d0">Scientists</data>
      <data key="d1">person</data>
      <data key="d2">Medical researchers and professionals who study cancer behavior and advance treatment options.&lt;SEP&gt;Researchers and medical scholars who have advanced the understanding of prostate cancer, leading to improved detection methods and treatments.&lt;SEP&gt;Researchers who study prostate cancer biology, detection methods, and clinical therapies to improve patient outcomes.</data>
      <data key="d3">chunk-697db1653f51e966e79b92eefeb01ec6&lt;SEP&gt;chunk-08475506372bb4ce9ec1bd326caf0fe9&lt;SEP&gt;chunk-6232dd9ed168a1113955e7300645338b</data>
    </node>
    <node id="Genetic Risk Factors">
      <data key="d0">Genetic Risk Factors</data>
      <data key="d1">category</data>
      <data key="d2">Biological traits and gene variants inherited from parents that influence a person's susceptibility to lung cancer.</data>
      <data key="d3">chunk-08475506372bb4ce9ec1bd326caf0fe9</data>
    </node>
    <node id="Environmental Risk Factors">
      <data key="d0">Environmental Risk Factors</data>
      <data key="d1">category</data>
      <data key="d2">External conditions and hazardous exposures in one's surroundings that elevate the likelihood of developing lung cancer.</data>
      <data key="d3">chunk-08475506372bb4ce9ec1bd326caf0fe9</data>
    </node>
    <node id="Western Countries">
      <data key="d0">Western Countries</data>
      <data key="d1">geo</data>
      <data key="d2">Geographical regions where instances of small cell lung cancer occurring in individuals without a smoking history are relatively rare.</data>
      <data key="d3">chunk-ecc6c4bcd3cab65fa05ab5f3c55e528d</data>
    </node>
    <node id="Small Cell Lung Cancer (SCLC)">
      <data key="d0">Small Cell Lung Cancer (SCLC)</data>
      <data key="d1">category</data>
      <data key="d2">A rapid-growing type of lung cancer primarily caused by cigarette smoking and characterized by early symptom onset and rapid progression.</data>
      <data key="d3">chunk-ecc6c4bcd3cab65fa05ab5f3c55e528d</data>
    </node>
    <node id="Non-Small Cell Lung Cancer (NSCLC)">
      <data key="d0">Non-Small Cell Lung Cancer (NSCLC)</data>
      <data key="d1">category</data>
      <data key="d2">A major classification of lung cancer referenced in patient management guidelines.</data>
      <data key="d3">chunk-ecc6c4bcd3cab65fa05ab5f3c55e528d</data>
    </node>
    <node id="Esophageal Cancer">
      <data key="d0">Esophageal Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A cancer classification applied to tumors that originate in the cardia and extend into the esophagogastric junction.&lt;SEP&gt;A form of cancer that affects the esophagus, which connects the throat to the stomach, distinct from nasopharyngeal cancer.&lt;SEP&gt;A malignancy that begins when cells in the epithelium of the esophagus grow uncontrollably, categorized mainly into adenocarcinomas and squamous cell carcinomas.&lt;SEP&gt;A type of cancer that develops when abnormal cells grow uncontrollably within the layers of the inner lining of the esophagus.</data>
      <data key="d3">chunk-01c80b2d18abb91c5be598d33cf7a33a&lt;SEP&gt;chunk-c9383db20cd696688798a193862cb5cc&lt;SEP&gt;chunk-ecc6c4bcd3cab65fa05ab5f3c55e528d&lt;SEP&gt;chunk-cb36cedd3f66584d65304e58b668eeab</data>
    </node>
    <node id="Paraneoplastic Syndromes">
      <data key="d0">Paraneoplastic Syndromes</data>
      <data key="d1">category</data>
      <data key="d2">A set of symptoms and conditions caused by an abnormal immune or systemic body response to cancers such as small cell lung cancer.</data>
      <data key="d3">chunk-ecc6c4bcd3cab65fa05ab5f3c55e528d</data>
    </node>
    <node id="Digestive System">
      <data key="d0">Digestive System</data>
      <data key="d1">category</data>
      <data key="d2">An anatomical system that breaks down food, absorbs nutrients, and removes waste, encompassing organs such as the esophagus and stomach.&lt;SEP&gt;The anatomical body system that breaks down food, absorbs nutrients, and eliminates waste, encompassing the stomach, liver, and intestines.&lt;SEP&gt;The organ system responsible for eating, chewing, swallowing, and digesting food, beginning at the oral cavity.&lt;SEP&gt;The physiological bodily system responsible for processing food, absorbing nutrients, and eliminating waste, of which the hepatobiliary system is an integral component.</data>
      <data key="d3">chunk-f43f96815f23658d5b24fe95ed4bd5ed&lt;SEP&gt;chunk-5fdcf47f3da06d3e0213112c96eb93d4&lt;SEP&gt;chunk-84367cc8f7a94b97b4b66a1ca127c15f&lt;SEP&gt;chunk-ecc6c4bcd3cab65fa05ab5f3c55e528d</data>
    </node>
    <node id="Assessment Team">
      <data key="d0">Assessment Team</data>
      <data key="d1">category</data>
      <data key="d2">A multidisciplinary group of specialized healthcare professionals that collaborates to diagnose and stage lung cancer.</data>
      <data key="d3">chunk-ecc6c4bcd3cab65fa05ab5f3c55e528d</data>
    </node>
    <node id="Primary Care Provider">
      <data key="d0">Primary Care Provider</data>
      <data key="d1">category</data>
      <data key="d2">A general medical practitioner who is frequently the first clinician to evaluate symptoms and suspect a diagnosis of lung cancer.&lt;SEP&gt;A patient's primary healthcare provider who helps manage co-existing health conditions alongside cancer treatment.&lt;SEP&gt;A primary physician or general provider offering broad-spectrum preventative medical care, routine evaluations, and general treatment.</data>
      <data key="d3">chunk-6a93aa507dd7d98a02e8ba92d39e3649&lt;SEP&gt;chunk-ecc6c4bcd3cab65fa05ab5f3c55e528d&lt;SEP&gt;chunk-b4da30dee72e228147daa825e4f5be72</data>
    </node>
    <node id="Medical Oncologist">
      <data key="d0">Medical Oncologist</data>
      <data key="d1">person</data>
      <data key="d2">A cancer specialist who treats adult malignancies utilizing systemic therapies, including chemotherapy, endocrine therapy, and targeted treatments.&lt;SEP&gt;A doctor specializing in the diagnosis and non-surgical treatment of cancer using targeted therapies and chemotherapy.&lt;SEP&gt;A medical oncologist is a doctor who treats cancer using systemic therapies such as chemotherapy and immunotherapy, often coordinating multidisciplinary patient care.&lt;SEP&gt;A medical oncologist is a physician specializing in the treatment of cancer using systemic therapies and medications.&lt;SEP&gt;A medical oncologist is a physician who treats cancer using systemic drug therapies.&lt;SEP&gt;A physician specializing in cancer management and treatment specifically using chemotherapy.&lt;SEP&gt;A physician specializing in systemic medical treatments and integrated care plans for cancer patients.&lt;SEP&gt;A specialist doctor who treats cancer using chemotherapy and other medications as part of the care team.</data>
      <data key="d3">chunk-1e017cd4fd8af1ebbcb582a93fbfe1ea&lt;SEP&gt;chunk-cb41559e96b71d2bb4ea207c806e8d5f&lt;SEP&gt;chunk-8333423c91919d7adde114b8286cca7e&lt;SEP&gt;chunk-db3a86fc5d439d9bfb3845e468a2a551&lt;SEP&gt;chunk-97836a515d346931beb424ae40a89877&lt;SEP&gt;chunk-b4da30dee72e228147daa825e4f5be72&lt;SEP&gt;chunk-dea00cf063e8831db4919330d94b1f2a&lt;SEP&gt;chunk-ecc6c4bcd3cab65fa05ab5f3c55e528d</data>
    </node>
    <node id="Interventional Radiologist">
      <data key="d0">Interventional Radiologist</data>
      <data key="d1">person</data>
      <data key="d2">A medical specialist performing minimally invasive, image-guided procedures such as tissue biopsies.&lt;SEP&gt;A medical specialist who frequently performs image-guided procedures, such as core needle biopsies under light sedation.&lt;SEP&gt;A specialized physician who performs needle biopsies and places intravenous ports for delivering cancer therapies.</data>
      <data key="d3">chunk-30c0bb66b1a2f93e89f5342ab1077451&lt;SEP&gt;chunk-ecc6c4bcd3cab65fa05ab5f3c55e528d&lt;SEP&gt;chunk-cb41559e96b71d2bb4ea207c806e8d5f</data>
    </node>
    <node id="Carcinogens">
      <data key="d0">Carcinogens</data>
      <data key="d1">category</data>
      <data key="d2">Chemicals and environmental substances capable of causing cancer in living tissue.</data>
      <data key="d3">chunk-ecc6c4bcd3cab65fa05ab5f3c55e528d</data>
    </node>
    <node id="Cigarette Smoking">
      <data key="d0">Cigarette Smoking</data>
      <data key="d1">category</data>
      <data key="d2">The inhalation of combustible tobacco products and the primary causative risk factor for Small Cell Lung Cancer.</data>
      <data key="d3">chunk-ecc6c4bcd3cab65fa05ab5f3c55e528d</data>
    </node>
    <node id="Nicotine Addiction">
      <data key="d0">Nicotine Addiction</data>
      <data key="d1">category</data>
      <data key="d2">A powerful physiological and psychological dependence on nicotine that makes tobacco cessation difficult.</data>
      <data key="d3">chunk-ecc6c4bcd3cab65fa05ab5f3c55e528d</data>
    </node>
    <node id="Airways Of The Lungs">
      <data key="d0">Airways Of The Lungs</data>
      <data key="d1">category</data>
      <data key="d2">The anatomical tract comprising the trachea, bronchi, bronchioli, and alveoli that channels air and exchanges oxygen in the lungs.</data>
      <data key="d3">chunk-ecc6c4bcd3cab65fa05ab5f3c55e528d</data>
    </node>
    <node id="Peristalsis">
      <data key="d0">Peristalsis</data>
      <data key="d1">event</data>
      <data key="d2">Involuntary, coordinated contractions of the muscular wall of the esophagus that push food down toward the stomach.</data>
      <data key="d3">chunk-ecc6c4bcd3cab65fa05ab5f3c55e528d</data>
    </node>
    <node id="North America">
      <data key="d0">North America</data>
      <data key="d1">geo</data>
      <data key="d2">A geographic region where the majority of esophageal cancers diagnosed are adenocarcinomas.&lt;SEP&gt;A geographic region whose Black population with hepatitis B is noted as having increased risk factors for liver cancer without cirrhosis.</data>
      <data key="d3">chunk-d4bc8b1b941d18ac455e5f255e1df8c1&lt;SEP&gt;chunk-cb36cedd3f66584d65304e58b668eeab</data>
    </node>
    <node id="Western Europe">
      <data key="d0">Western Europe</data>
      <data key="d1">geo</data>
      <data key="d2">A geographic region where adenocarcinomas represent the majority of esophageal cancers.</data>
      <data key="d3">chunk-cb36cedd3f66584d65304e58b668eeab</data>
    </node>
    <node id="Eastern Europe">
      <data key="d0">Eastern Europe</data>
      <data key="d1">geo</data>
      <data key="d2">A geographic region where squamous cell carcinoma is a more common form of esophageal cancer.</data>
      <data key="d3">chunk-cb36cedd3f66584d65304e58b668eeab</data>
    </node>
    <node id="Asia">
      <data key="d0">Asia</data>
      <data key="d1">geo</data>
      <data key="d2">A continent and geographical region where nasopharyngeal cancer is noted to occur with higher prevalence.&lt;SEP&gt;A geographic region identified as having a higher occurrence of nasopharyngeal carcinoma.&lt;SEP&gt;A geographic region referenced in relation to Asian males aged 40 and older and Asian females aged 50 and older who have an increased risk of liver cancer when infected with hepatitis B.&lt;SEP&gt;A geographic region where esophageal squamous cell carcinoma is more prevalent.</data>
      <data key="d3">chunk-711bee9440e11d7c737bc4a49b880910&lt;SEP&gt;chunk-d4bc8b1b941d18ac455e5f255e1df8c1&lt;SEP&gt;chunk-c9383db20cd696688798a193862cb5cc&lt;SEP&gt;chunk-cb36cedd3f66584d65304e58b668eeab</data>
    </node>
    <node id="Africa">
      <data key="d0">Africa</data>
      <data key="d1">geo</data>
      <data key="d2">A geographic region referenced in relation to persons of African descent with hepatitis B presenting increased risk for liver cancer.&lt;SEP&gt;A geographic region where esophageal squamous cell carcinoma is more common.&lt;SEP&gt;Africa is the geographic region referenced in relation to populations of African descent who are susceptible to Renal Medullary Carcinoma associated with sickle cell traits.</data>
      <data key="d3">chunk-a08bd0a819ea613e781d07188a350438&lt;SEP&gt;chunk-d4bc8b1b941d18ac455e5f255e1df8c1&lt;SEP&gt;chunk-cb36cedd3f66584d65304e58b668eeab</data>
    </node>
    <node id="Esophageal Squamous Cell Carcinoma">
      <data key="d0">Esophageal Squamous Cell Carcinoma</data>
      <data key="d1">category</data>
      <data key="d2">A subtype of esophageal cancer originating in the thin, flat cells of the inner esophageal lining, commonly found in the upper and middle esophagus.</data>
      <data key="d3">chunk-cb36cedd3f66584d65304e58b668eeab</data>
    </node>
    <node id="Esophageal Adenocarcinoma">
      <data key="d0">Esophageal Adenocarcinoma</data>
      <data key="d1">category</data>
      <data key="d2">A subtype of esophageal cancer that starts in mucus-producing cells of the inner lining, typically occurring in the lower esophagus.</data>
      <data key="d3">chunk-cb36cedd3f66584d65304e58b668eeab</data>
    </node>
    <node id="Barrett Esophagus">
      <data key="d0">Barrett Esophagus</data>
      <data key="d1">category</data>
      <data key="d2">A condition resulting from chronic reflux where squamous cells in the lower esophagus are replaced by abnormal cells, increasing the risk of adenocarcinoma.</data>
      <data key="d3">chunk-cb36cedd3f66584d65304e58b668eeab</data>
    </node>
    <node id="Siewert Types">
      <data key="d0">Siewert Types</data>
      <data key="d1">category</data>
      <data key="d2">A cancer staging classification system used to describe tumor location relative to the esophagus and stomach.</data>
      <data key="d3">chunk-cb36cedd3f66584d65304e58b668eeab</data>
    </node>
    <node id="Early-Stage Esophageal Cancer">
      <data key="d0">Early-Stage Esophageal Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A clinical staging category describing localized esophageal cancer that has not grown beyond the inside lining and has not reached lymph nodes.</data>
      <data key="d3">chunk-cb36cedd3f66584d65304e58b668eeab</data>
    </node>
    <node id="Locoregional Esophageal Cancer">
      <data key="d0">Locoregional Esophageal Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A staging category for esophageal cancer that has invaded the esophageal wall or spread to adjacent lymph nodes and organs.</data>
      <data key="d3">chunk-cb36cedd3f66584d65304e58b668eeab</data>
    </node>
    <node id="Metastatic Esophageal Cancer">
      <data key="d0">Metastatic Esophageal Cancer</data>
      <data key="d1">category</data>
      <data key="d2">An advanced staging category where esophageal cancer has spread via the bloodstream or lymphatic system to distant organs such as the liver or lungs.</data>
      <data key="d3">chunk-cb36cedd3f66584d65304e58b668eeab</data>
    </node>
    <node id="Esophagogastric Junction">
      <data key="d0">Esophagogastric Junction</data>
      <data key="d1">category</data>
      <data key="d2">The anatomical anatomical junction beneath the diaphragm where the esophagus meets the stomach; also referred to as GEJ, where certain boundary tumors are classified and treated as esophageal cancer.</data>
      <data key="d3">chunk-cb36cedd3f66584d65304e58b668eeab</data>
    </node>
    <node id="Nutritional Assessment">
      <data key="d0">Nutritional Assessment</data>
      <data key="d1">category</data>
      <data key="d2">A clinical evaluation category designed to analyze patient nutritional status and needs throughout esophageal cancer diagnosis and treatment.</data>
      <data key="d3">chunk-cb36cedd3f66584d65304e58b668eeab</data>
    </node>
    <node id="Endoscopy Procedures">
      <data key="d0">Endoscopy Procedures</data>
      <data key="d1">category</data>
      <data key="d2">A category of visual diagnostic examinations of the digestive tract used to inspect the stomach lining and collect biopsy specimens.&lt;SEP&gt;Direct visual internal diagnostic procedures used to examine the lining of the esophagus and stomach and obtain tissue samples.</data>
      <data key="d3">chunk-c77e0d4642a374a51f87e7e25b19281f&lt;SEP&gt;chunk-cb36cedd3f66584d65304e58b668eeab</data>
    </node>
    <node id="Genetic Risk Testing">
      <data key="d0">Genetic Risk Testing</data>
      <data key="d1">category</data>
      <data key="d2">A diagnostic testing category used to identify inherited genetic mutations and hereditary cancer predispositions.&lt;SEP&gt;Counseling and genetic screening conducted to determine if a patient has hereditary breast cancer risk factors.&lt;SEP&gt;Diagnostic evaluation aimed at identifying specific gene or chromosome alterations and hereditary risks in leukemia patients.&lt;SEP&gt;Diagnostic testing on blood or saliva designed to detect inherited germline mutations associated with hereditary cancer risks.&lt;SEP&gt;Genetic evaluation procedures assessing inherited risks and molecular profiles pertinent to cancer diagnosis and therapeutic planning.</data>
      <data key="d3">chunk-cb36cedd3f66584d65304e58b668eeab&lt;SEP&gt;chunk-5846f51c2ca4fae54459ce9c50e3e820&lt;SEP&gt;chunk-650982a589c2d527bc13923ccd0569ef&lt;SEP&gt;chunk-c77e0d4642a374a51f87e7e25b19281f&lt;SEP&gt;chunk-82c7205fc2067a4d00e43fd22276db22</data>
    </node>
    <node id="Performance Status">
      <data key="d0">Performance Status</data>
      <data key="d1">category</data>
      <data key="d2">A clinical assessment category used to quantify a patient's functional capacity, daily living capabilities, and general well-being during treatment planning.&lt;SEP&gt;A clinical classification category measuring a patient's overall functional ability and capacity to handle daily activities and cancer treatments.&lt;SEP&gt;A clinical evaluation measuring a patient's capacity to perform day-to-day activities, used to assess treatment tolerance and clinical trial eligibility.&lt;SEP&gt;A clinical measurement scoring a patient's capacity to perform ordinary daily activities such as bathing and eating.&lt;SEP&gt;A clinical metric describing a patient's general fitness and functional ability to perform daily self-care tasks, used to guide treatment plans.&lt;SEP&gt;A general clinical measurement of a patient's functional capacity and overall health used to guide cancer treatment selection.&lt;SEP&gt;A standardized medical categorization evaluating a patient's level of physical functioning, daily activity capability, and treatment tolerability.&lt;SEP&gt;Performance status is a clinical measure of a patient's general fitness and capability to perform daily self-care tasks, often rated using the ECOG scale.&lt;SEP&gt;Performance status is a clinical measure of a patient's overall fitness and capacity to carry out daily living activities, influencing treatment plan selection.&lt;SEP&gt;Performance status is a clinical measurement category reflecting an individual's general level of fitness and ability to conduct daily activities, used in cancer treatment planning.&lt;SEP&gt;Performance status is an assessment metric of a patient's ability to perform daily activities, used to determine treatment tolerance and clinical trial eligibility.</data>
      <data key="d3">chunk-a06038ec84f20e873b9e275a23aea8d9&lt;SEP&gt;chunk-052101b592e186cce702983d2acc67e4&lt;SEP&gt;chunk-49c7ff3a71e74b3f0eb59258541e739e&lt;SEP&gt;chunk-9fa573748870dc50a98a935843997c68&lt;SEP&gt;chunk-d73843c009e523101e1464a2b28bc144&lt;SEP&gt;chunk-cb36cedd3f66584d65304e58b668eeab&lt;SEP&gt;chunk-a0d4d6b091e033fd01aa721422b68ef5&lt;SEP&gt;chunk-3fbf2f6a3c150687a59f814d94f1d150&lt;SEP&gt;chunk-7bdde77ad1be3ee9308db3c7703674b0&lt;SEP&gt;chunk-c77e0d4642a374a51f87e7e25b19281f&lt;SEP&gt;chunk-717174ace5855cc823d51c46c9a70648</data>
    </node>
    <node id="National Comprehensive Cancer Network">
      <data key="d0">National Comprehensive Cancer Network</data>
      <data key="d1">organization</data>
      <data key="d2">A healthcare organization referenced through its 'NCCN Guidelines for Patients' publications covering various cancer types.&lt;SEP&gt;An alliance of cancer centers that publishes patient guidance resources, including the NCCN Guidelines for Patients: Distress During Cancer Care.&lt;SEP&gt;An alliance of leading cancer centers across the United States that develops evidence-based cancer care recommendations and clinical practice guidelines.&lt;SEP&gt;The National Comprehensive Cancer Network (NCCN) is a not-for-profit alliance of cancer centers that publishes clinical practice guidelines and patient education resources.&lt;SEP&gt;The National Comprehensive Cancer Network (NCCN) is an alliance of cancer centers that publishes clinical guidelines and patient educational materials on cancer diagnosis and treatment.&lt;SEP&gt;The National Comprehensive Cancer Network (NCCN) is an alliance of cancer centers that publishes clinical guidelines and patient educational resources, including the NCCN Guidelines for Patients.&lt;SEP&gt;The National Comprehensive Cancer Network (NCCN) is an alliance of cancer centers that publishes clinical guidelines and patient resources on cancer care and fertility preservation.&lt;SEP&gt;The National Comprehensive Cancer Network (NCCN) is an alliance of cancer centers that publishes clinical practice guidelines and patient guides for cancer care and treatment.&lt;SEP&gt;The National Comprehensive Cancer Network (NCCN) is an alliance of leading cancer centers that produces clinical guidelines and patient educational guides, including the NCCN Guidelines for Patients.&lt;SEP&gt;The National Comprehensive Cancer Network (NCCN) is an alliance of leading cancer centers that produces trusted clinical and patient care guidelines based on expert research and practice.&lt;SEP&gt;The National Comprehensive Cancer Network (NCCN) is an alliance of leading cancer centers that publishes clinical guidelines and patient educational resources.&lt;SEP&gt;The National Comprehensive Cancer Network (NCCN) provides authoritative clinical resources, including patient guidelines on cancer treatments and immunotherapy side effects.</data>
      <data key="d3">chunk-f2a44e885faf856aa579d824b3cd85e7&lt;SEP&gt;chunk-64f36a4a5be80c8fa51631db16e52b85&lt;SEP&gt;chunk-81c87ec3c2682da4d531da53f6e5e18c&lt;SEP&gt;chunk-f8639a06098656be20a04fe129660616&lt;SEP&gt;chunk-33608457001e818e2b300adae9c6c0d9&lt;SEP&gt;chunk-c5bc83f5f4f3e29b7f0a6f4787c3ad83&lt;SEP&gt;chunk-a99a89bec88823cedf4c1f0cd1a78e81&lt;SEP&gt;chunk-bd7ea43a74059d6781866faec437f19a&lt;SEP&gt;chunk-db3a86fc5d439d9bfb3845e468a2a551&lt;SEP&gt;chunk-c35816f05289661283f683145d9f395f&lt;SEP&gt;chunk-53e3a9418b1d7916e3c8717a397bbb58&lt;SEP&gt;chunk-2dc31077c053f79ff82959575d335956</data>
    </node>
    <node id="NCCN Foundation">
      <data key="d0">NCCN Foundation</data>
      <data key="d1">organization</data>
      <data key="d2">A foundation dedicated to advancing cancer treatment and supporting patients and families by funding and distributing NCCN Guidelines for Patients.</data>
      <data key="d3">chunk-64f36a4a5be80c8fa51631db16e52b85</data>
    </node>
    <node id="Pfizer Inc.">
      <data key="d0">Pfizer Inc.</data>
      <data key="d1">organization</data>
      <data key="d2">A corporate supporter that provides funding to the NCCN Foundation to help make the NCCN Guidelines for Patients accessible.</data>
      <data key="d3">chunk-64f36a4a5be80c8fa51631db16e52b85</data>
    </node>
    <node id="Hodgkin Lymphoma">
      <data key="d0">Hodgkin Lymphoma</data>
      <data key="d1">category</data>
      <data key="d2">A highly curable form of cancer originating in white blood cells (lymphocytes), typically starting in lymph nodes in the upper body and characterized by Reed-Sternberg cells.&lt;SEP&gt;A lymphoma category marked by abnormal Reed-Sternberg cells, sharing overlapping diagnostic and pathological traits with mediastinal gray zone lymphoma.&lt;SEP&gt;Hodgkin lymphoma is a type of cancer of the lymphatic system, categorized mainly into classic Hodgkin lymphoma and nodular lymphocyte-predominant Hodgkin lymphoma.&lt;SEP&gt;Hodgkin lymphoma is a type of cancer that can potentially develop from CLL through Richter transformation.</data>
      <data key="d3">chunk-098a64d7118fc8e1eb3e91ba0124258c&lt;SEP&gt;chunk-d67bee20d5e5400994f8c8f03052dd06&lt;SEP&gt;chunk-64f36a4a5be80c8fa51631db16e52b85&lt;SEP&gt;chunk-8ba71a5181f3814dffb21d3399441bea</data>
    </node>
    <node id="Non-Hodgkin Lymphoma">
      <data key="d0">Non-Hodgkin Lymphoma</data>
      <data key="d1">category</data>
      <data key="d2">A broad category of blood cancers that develop from lymphocytes, which are white blood cells of the immune system.&lt;SEP&gt;A broad group of blood cancers of lymphocytes, which includes primary mediastinal B-cell lymphoma.&lt;SEP&gt;A classification of lymphatic cancer of which Burkitt lymphoma is a subtype.&lt;SEP&gt;A diverse group of lymphocyte-derived cancers that differ under microscopic examination from Hodgkin lymphoma.&lt;SEP&gt;Non-Hodgkin lymphoma (NHL) is a broad cancer category that originates in lymphocytes within the lymphatic system.&lt;SEP&gt;Non-Hodgkin lymphoma (NHL) is a cancer that develops from lymphocytes when they grow uncontrollably without proper regulation.&lt;SEP&gt;Non-Hodgkin lymphoma is a broad category of lymphatic cancer that includes Burkitt lymphoma.&lt;SEP&gt;Non-Hodgkin lymphoma is a broader classification of lymphatic system cancers that includes Burkitt lymphoma.&lt;SEP&gt;Non-Hodgkin lymphoma is a group of blood and lymphatic cancers that encompasses Burkitt lymphoma.</data>
      <data key="d3">chunk-7606b44d6a30ad0519bc4c10785de79a&lt;SEP&gt;chunk-64f36a4a5be80c8fa51631db16e52b85&lt;SEP&gt;chunk-81c87ec3c2682da4d531da53f6e5e18c&lt;SEP&gt;chunk-829d6b7840e9f2c8d97d22d2ce2c43c1&lt;SEP&gt;chunk-196a80cd0ae47fda3849b101cca91a15&lt;SEP&gt;chunk-53e3a9418b1d7916e3c8717a397bbb58&lt;SEP&gt;chunk-b00f93aa3d24d0275d4290db3fb2cca3&lt;SEP&gt;chunk-8ba71a5181f3814dffb21d3399441bea&lt;SEP&gt;chunk-82c7205fc2067a4d00e43fd22276db22</data>
    </node>
    <node id="Classic Hodgkin Lymphoma">
      <data key="d0">Classic Hodgkin Lymphoma</data>
      <data key="d1">category</data>
      <data key="d2">A major classification and subtype of Hodgkin lymphoma discussed in the clinical management and treatment guidelines.&lt;SEP&gt;Classic Hodgkin lymphoma (CHL) is the most common form of Hodgkin lymphoma, characterized by the presence of Reed-Sternberg cells.</data>
      <data key="d3">chunk-d67bee20d5e5400994f8c8f03052dd06&lt;SEP&gt;chunk-64f36a4a5be80c8fa51631db16e52b85</data>
    </node>
    <node id="NLPHL">
      <data key="d0">NLPHL</data>
      <data key="d1">category</data>
      <data key="d2">Nodular lymphocyte-predominant Hodgkin lymphoma, a distinct subtype of Hodgkin lymphoma with specific treatment protocols.</data>
      <data key="d3">chunk-64f36a4a5be80c8fa51631db16e52b85</data>
    </node>
    <node id="Lymphocytes">
      <data key="d0">Lymphocytes</data>
      <data key="d1">category</data>
      <data key="d2">A category of white blood cells integral to the immune system that fight infections and can become cancerous in lymphoma.&lt;SEP&gt;A major category of white blood cells found in blood, lymph tissue, and organs that help fight and prevent infections and disease.&lt;SEP&gt;A type of white blood cell that forms the primary cellular component of the lymphatic system and can develop into lymphoma when dividing abnormally.&lt;SEP&gt;Disease-fighting white blood cells of the immune system where acute lymphoblastic leukemia originates.&lt;SEP&gt;Infection-fighting white blood cells carried by lymph through the lymphatic system that are central to understanding Hodgkin lymphoma.&lt;SEP&gt;Lymphocytes are a category of disease-fighting white blood cells found in blood and lymph tissue, primarily encompassing B cells, T cells, and natural killer cells.&lt;SEP&gt;Lymphocytes are a subtype of white blood cells comprising B cells, T cells, and natural killer (NK) cells that are central to the immune system and the cell types primarily affected in ALL.&lt;SEP&gt;Lymphocytes are a type of infection-fighting white blood cell found in blood and lymph tissue, divided into B cells, T cells, and natural killer (NK) cells.&lt;SEP&gt;White blood cells of the immune system from which acute lymphoblastic leukemia originates.&lt;SEP&gt;White blood cells responsible for fighting infection that can mutate and proliferate uncontrollably into lymphoma.</data>
      <data key="d3">chunk-7606b44d6a30ad0519bc4c10785de79a&lt;SEP&gt;chunk-d67bee20d5e5400994f8c8f03052dd06&lt;SEP&gt;chunk-64f36a4a5be80c8fa51631db16e52b85&lt;SEP&gt;chunk-81c87ec3c2682da4d531da53f6e5e18c&lt;SEP&gt;chunk-dd58424a14d9942181ba4ca3c1ec81c1&lt;SEP&gt;chunk-5d8e20e6004dd43ae0f68185383b594d&lt;SEP&gt;chunk-a99a89bec88823cedf4c1f0cd1a78e81&lt;SEP&gt;chunk-4966a628b12ecec4187796598764cf23&lt;SEP&gt;chunk-53e3a9418b1d7916e3c8717a397bbb58&lt;SEP&gt;chunk-b00f93aa3d24d0275d4290db3fb2cca3</data>
    </node>
    <node id="Reed-Sternberg Cells">
      <data key="d0">Reed-Sternberg Cells</data>
      <data key="d1">category</data>
      <data key="d2">Abnormally large, often multinucleated lymphocytes that are the distinctive pathological hallmark of Hodgkin lymphoma under microscopic examination.&lt;SEP&gt;Large, distinct diagnostic lymphocytes that characterize classic Hodgkin lymphoma.</data>
      <data key="d3">chunk-d67bee20d5e5400994f8c8f03052dd06&lt;SEP&gt;chunk-64f36a4a5be80c8fa51631db16e52b85</data>
    </node>
    <node id="Lymphatic System">
      <data key="d0">Lymphatic System</data>
      <data key="d1">category</data>
      <data key="d2">A vital component of the immune system composed of tissues, organs, and lymphocytes that helps fight infection and disease.&lt;SEP&gt;An essential organ system and biological network containing lymphocytes and lymph nodes that aids in fighting infections.&lt;SEP&gt;An immune organ network that includes tonsils, thymus, and spleen, housing B cells to fight infections.&lt;SEP&gt;An immune system network consisting of tonsils, thymus, spleen, lymph vessels, and lymph nodes that fights infections.&lt;SEP&gt;The lymphatic system is a vital component of the immune system composed of lymph nodes, vessels, the spleen, thymus, and bone marrow that carries lymph fluid and fights disease.&lt;SEP&gt;The lymphatic system is an organ and tissue network that forms part of the immune system, helping the body fight infection and disease.</data>
      <data key="d3">chunk-d67bee20d5e5400994f8c8f03052dd06&lt;SEP&gt;chunk-64f36a4a5be80c8fa51631db16e52b85&lt;SEP&gt;chunk-bc89a92e9a97781ebca0db50abc34939&lt;SEP&gt;chunk-098a64d7118fc8e1eb3e91ba0124258c&lt;SEP&gt;chunk-67015f3916810c4378b2ed269cc27f29&lt;SEP&gt;chunk-196a80cd0ae47fda3849b101cca91a15</data>
    </node>
    <node id="Imaging Studies">
      <data key="d0">Imaging Studies</data>
      <data key="d1">category</data>
      <data key="d2">A category of visual diagnostic examinations used alongside tissue biopsy and blood tests to evaluate the extent of cancer and shape the treatment plan.&lt;SEP&gt;A clinical category encompassing scans like MRI, CT, and PET used to evaluate internal anatomy and monitor disease spread.&lt;SEP&gt;Diagnostic radiologic scans used to visualize tumors, detect lymph node involvement, and stage cancer.</data>
      <data key="d3">chunk-29c9b8b5fd2cd967c48522af79a9598f&lt;SEP&gt;chunk-64f36a4a5be80c8fa51631db16e52b85&lt;SEP&gt;chunk-f9a9eb8b01f29fdf214c10bdffac3203</data>
    </node>
    <node id="Refractory Or Relapsed CHL">
      <data key="d0">Refractory Or Relapsed CHL</data>
      <data key="d1">category</data>
      <data key="d2">A clinical status of classic Hodgkin lymphoma where the disease either does not respond to initial therapy or returns after remission.</data>
      <data key="d3">chunk-64f36a4a5be80c8fa51631db16e52b85</data>
    </node>
    <node id="MyChart">
      <data key="d0">MyChart</data>
      <data key="d1">organization</data>
      <data key="d2">An electronic patient portal application used to track appointments, view test results, and communicate with healthcare providers.&lt;SEP&gt;An electronic patient portal platform used by healthcare organizations for appointment scheduling, patient records access, and patient-provider communication.&lt;SEP&gt;MyChart is an electronic patient portal platform used by healthcare organizations for patients to review test results, manage appointments, and message healthcare providers.</data>
      <data key="d3">chunk-64f36a4a5be80c8fa51631db16e52b85&lt;SEP&gt;chunk-f9a9eb8b01f29fdf214c10bdffac3203&lt;SEP&gt;chunk-c37f547042fc10baabdbfaadf010bce5</data>
    </node>
    <node id="Nodular Lymphocyte-Predominant Hodgkin Lymphoma">
      <data key="d0">Nodular Lymphocyte-Predominant Hodgkin Lymphoma</data>
      <data key="d1">category</data>
      <data key="d2">Nodular lymphocyte-predominant Hodgkin lymphoma (NLPHL) is a rare form of Hodgkin lymphoma characterized by popcorn-shaped cells that can potentially transform into more aggressive lymphomas.</data>
      <data key="d3">chunk-d67bee20d5e5400994f8c8f03052dd06</data>
    </node>
    <node id="Diffuse Large B-Cell Lymphoma">
      <data key="d0">Diffuse Large B-Cell Lymphoma</data>
      <data key="d1">category</data>
      <data key="d2">An aggressive, fast-growing subtype of non-Hodgkin lymphoma that can develop de novo or result from the transformation of follicular lymphoma.&lt;SEP&gt;Diffuse large B-cell lymphoma (DLBCL) is a fast-growing type of cancer that nodular lymphocyte-predominant Hodgkin lymphoma can transform into.&lt;SEP&gt;Diffuse large B-cell lymphoma (DLBCL) is a subtype of B-cell lymphoma that has distinct germinal centers from follicular lymphoma and influences treatment pathways for higher-grade cases.&lt;SEP&gt;Diffuse large B-cell lymphoma (DLBCL) is an aggressive form of cancer that can develop from CLL as a result of Richter transformation.</data>
      <data key="d3">chunk-098a64d7118fc8e1eb3e91ba0124258c&lt;SEP&gt;chunk-d67bee20d5e5400994f8c8f03052dd06&lt;SEP&gt;chunk-b00f93aa3d24d0275d4290db3fb2cca3&lt;SEP&gt;chunk-829d6b7840e9f2c8d97d22d2ce2c43c1</data>
    </node>
    <node id="Bile Duct Cancer">
      <data key="d0">Bile Duct Cancer</data>
      <data key="d1">category</data>
      <data key="d2">Bile duct cancer is a disease category occurring in the multilayered structures of bile ducts, which can spread to nearby vessels, the liver, or surrounding tissues.&lt;SEP&gt;Bile duct cancer is a malignancy arising in the gallbladder and bile ducts, staged by tumor size and tissue layer invasion.</data>
      <data key="d3">chunk-d67bee20d5e5400994f8c8f03052dd06&lt;SEP&gt;chunk-b00f93aa3d24d0275d4290db3fb2cca3</data>
    </node>
    <node id="Lymph Nodes">
      <data key="d0">Lymph Nodes</data>
      <data key="d1">category</data>
      <data key="d2">Glandular tissue located throughout the body, including neck, armpits, and groin, where SLL and CLL cells can accumulate and cause swelling.&lt;SEP&gt;Small bean-shaped structures distributed throughout the body, particularly in the neck, groin, and armpits, that filter out foreign particles, harmful cells, and cancer cells.&lt;SEP&gt;Vascular and immune filter structures distributed throughout the body that defend against infections and can harbor metastatic tumor cells.</data>
      <data key="d3">chunk-098a64d7118fc8e1eb3e91ba0124258c&lt;SEP&gt;chunk-d67bee20d5e5400994f8c8f03052dd06&lt;SEP&gt;chunk-74f18dd51a0091fc888512458a85b0a1</data>
    </node>
    <node id="T Lymphocytes">
      <data key="d0">T Lymphocytes</data>
      <data key="d1">category</data>
      <data key="d2">A major type of lymphocyte, also called T cells, that matures and develops in the thymus organ.&lt;SEP&gt;Also known as T cells, a class of lymphocytes that fight infections and cancer, and regulate immune responses.&lt;SEP&gt;T lymphocytes, or T cells, are white blood cells that destroy tumor cells and regulate immune responses, but can abnormally develop into cutaneous T-cell lymphoma.</data>
      <data key="d3">chunk-196a80cd0ae47fda3849b101cca91a15&lt;SEP&gt;chunk-d67bee20d5e5400994f8c8f03052dd06&lt;SEP&gt;chunk-b00f93aa3d24d0275d4290db3fb2cca3</data>
    </node>
    <node id="Popcorn-Shaped Cells">
      <data key="d0">Popcorn-Shaped Cells</data>
      <data key="d1">category</data>
      <data key="d2">Distinctive diagnostic cells that characterize nodular lymphocyte-predominant Hodgkin lymphoma.</data>
      <data key="d3">chunk-d67bee20d5e5400994f8c8f03052dd06</data>
    </node>
    <node id="Spleen">
      <data key="d0">Spleen</data>
      <data key="d1">category</data>
      <data key="d2">A lymphatic system organ that fights infection and often accumulates abnormal cells in CLL and SLL.&lt;SEP&gt;The largest organ of the lymphatic system, responsible for producing lymphocytes and filtering and storing blood.</data>
      <data key="d3">chunk-098a64d7118fc8e1eb3e91ba0124258c&lt;SEP&gt;chunk-d67bee20d5e5400994f8c8f03052dd06</data>
    </node>
    <node id="Thymus">
      <data key="d0">Thymus</data>
      <data key="d1">category</data>
      <data key="d2">A small organ situated in the upper chest where lymphocytes develop into T lymphocytes.</data>
      <data key="d3">chunk-d67bee20d5e5400994f8c8f03052dd06</data>
    </node>
    <node id="Tonsils">
      <data key="d0">Tonsils</data>
      <data key="d1">category</data>
      <data key="d2">Small masses of lymph tissue located at the back of the throat that trap disease-causing germs entering through the nose or mouth.</data>
      <data key="d3">chunk-d67bee20d5e5400994f8c8f03052dd06</data>
    </node>
    <node id="Excisional Lymph Node Biopsy">
      <data key="d0">Excisional Lymph Node Biopsy</data>
      <data key="d1">category</data>
      <data key="d2">The preferred diagnostic procedure for Hodgkin lymphoma involving the surgical removal and lab testing of one or more whole lymph nodes.</data>
      <data key="d3">chunk-d67bee20d5e5400994f8c8f03052dd06</data>
    </node>
    <node id="Intrahepatic Bile Duct Cancer">
      <data key="d0">Intrahepatic Bile Duct Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A subtype of bile duct cancer that develops within the bile ducts inside the liver.&lt;SEP&gt;Intrahepatic bile duct cancer is a specific category of bile duct cancer located within the liver.</data>
      <data key="d3">chunk-d67bee20d5e5400994f8c8f03052dd06&lt;SEP&gt;chunk-b00f93aa3d24d0275d4290db3fb2cca3</data>
    </node>
    <node id="Leading Cancer Centers">
      <data key="d0">Leading Cancer Centers</data>
      <data key="d1">organization</data>
      <data key="d2">Leading cancer centers are top-tier medical and research institutions that develop and implement advanced cancer care practices and contribute to clinical guidelines.&lt;SEP&gt;Top oncology medical institutions whose research and clinical practices form the foundation of NCCN treatment guidelines.&lt;SEP&gt;Top-tier medical institutions whose research and clinical practices form the basis of NCCN cancer care guidelines.</data>
      <data key="d3">chunk-d67bee20d5e5400994f8c8f03052dd06&lt;SEP&gt;chunk-121b68d5de585c87804c9bce3cdc71eb&lt;SEP&gt;chunk-2dc31077c053f79ff82959575d335956</data>
    </node>
    <node id="World Health Organization">
      <data key="d0">World Health Organization</data>
      <data key="d1">organization</data>
      <data key="d2">An international public health agency whose fifth classification edition (WHO5) provides diagnostic frameworks for follicular lymphoma and other cancers.&lt;SEP&gt;The World Health Organization (WHO) is an international public health body that established the 2022 WHO classification (WHO5) categorizing follicular lymphoma grades.</data>
      <data key="d3">chunk-b00f93aa3d24d0275d4290db3fb2cca3&lt;SEP&gt;chunk-829d6b7840e9f2c8d97d22d2ce2c43c1</data>
    </node>
    <node id="International Consensus Classification">
      <data key="d0">International Consensus Classification</data>
      <data key="d1">organization</data>
      <data key="d2">An international medical consensus body that establishes classification systems for hematologic malignancies, grouping follicular lymphoma grades 1 and 2 as classic FL.&lt;SEP&gt;The International Consensus Classification (ICC) is an expert medical organization that provides staging and classification guidelines for hematologic malignancies, including follicular lymphoma.</data>
      <data key="d3">chunk-b00f93aa3d24d0275d4290db3fb2cca3&lt;SEP&gt;chunk-829d6b7840e9f2c8d97d22d2ce2c43c1</data>
    </node>
    <node id="Follicular Lymphoma">
      <data key="d0">Follicular Lymphoma</data>
      <data key="d1">category</data>
      <data key="d2">A slow-growing (indolent) form of non-Hodgkin lymphoma that typically forms clusters of abnormal B lymphocytes in the lymph nodes.&lt;SEP&gt;Follicular lymphoma (FL) is a common, slow-growing (indolent) category of non-Hodgkin lymphoma arising from B lymphocytes in germinal centers.</data>
      <data key="d3">chunk-b00f93aa3d24d0275d4290db3fb2cca3&lt;SEP&gt;chunk-829d6b7840e9f2c8d97d22d2ce2c43c1</data>
    </node>
    <node id="Classic Follicular Lymphoma">
      <data key="d0">Classic Follicular Lymphoma</data>
      <data key="d1">category</data>
      <data key="d2">A subtype of follicular lymphoma defined under ICC as grades 1 and 2, often characterized by chromosome translocation or excess BCL2 protein.&lt;SEP&gt;Classic follicular lymphoma (cFL) is a clinical classification category grouping specific lower grades of follicular lymphoma according to WHO and ICC criteria.</data>
      <data key="d3">chunk-b00f93aa3d24d0275d4290db3fb2cca3&lt;SEP&gt;chunk-829d6b7840e9f2c8d97d22d2ce2c43c1</data>
    </node>
    <node id="Burkitt Lymphoma">
      <data key="d0">Burkitt Lymphoma</data>
      <data key="d1">category</data>
      <data key="d2">A form of non-Hodgkin lymphoma that shares cellular characteristics with mature B-cell ALL.&lt;SEP&gt;Burkitt lymphoma (BL) is a subtype of lymphoma noted for possessing different germinal center characteristics than follicular lymphoma.&lt;SEP&gt;Burkitt lymphoma is a form of non-Hodgkin lymphoma that shares essential biological characteristics with Burkitt leukemia.&lt;SEP&gt;Burkitt lymphoma is a type of non-Hodgkin lymphoma that shares essential biological characteristics with mature B-cell ALL.</data>
      <data key="d3">chunk-7606b44d6a30ad0519bc4c10785de79a&lt;SEP&gt;chunk-81c87ec3c2682da4d531da53f6e5e18c&lt;SEP&gt;chunk-53e3a9418b1d7916e3c8717a397bbb58&lt;SEP&gt;chunk-b00f93aa3d24d0275d4290db3fb2cca3&lt;SEP&gt;chunk-82c7205fc2067a4d00e43fd22276db22</data>
    </node>
    <node id="Carcinoma In Situ">
      <data key="d0">Carcinoma In Situ</data>
      <data key="d1">category</data>
      <data key="d2">A non-invasive epithelial lesion (Tis) where cancerous cells remain confined entirely to the squamous epithelial layer without invasion.&lt;SEP&gt;An early-stage cancer designated as Tis where abnormal cells are confined to their site of origin without invading deeper tissues.&lt;SEP&gt;Carcinoma in situ (CIS or Stage 0is) is a flat, non-invasive patch of cancer cells on the bladder lining that is fast-growing, high-grade, and aggressive.&lt;SEP&gt;Carcinoma in situ (Tis) is a pre-invasive neoplastic condition characterized by abnormal cancer cells confined strictly to the squamous epithelial layer.&lt;SEP&gt;Carcinoma in situ (Tis) is a staging category referring to an intraductal, non-invasive primary tumor.&lt;SEP&gt;Stage 0 anal cancer where severely abnormal or malignant cells remain on the surface without invading deeper tissue.</data>
      <data key="d3">chunk-06384634b72466c480713ee8d57f25ed&lt;SEP&gt;chunk-5d8e20e6004dd43ae0f68185383b594d&lt;SEP&gt;chunk-29d1ec9b874dd38ef0f3a4a2081f548e&lt;SEP&gt;chunk-d9882c04dd7676c6433074e5e393c72e&lt;SEP&gt;chunk-b00f93aa3d24d0275d4290db3fb2cca3&lt;SEP&gt;chunk-d249262ff9e7e657de99a30199159cdf</data>
    </node>
    <node id="B Lymphocytes">
      <data key="d0">B Lymphocytes</data>
      <data key="d1">category</data>
      <data key="d2">Also called B cells, a category of white blood cells that produce antibodies and are the cell of origin for follicular lymphoma and other non-Hodgkin lymphomas.&lt;SEP&gt;B lymphocytes, or B cells, are white blood cells that produce antibodies to fight infection, but can develop into lymphoma when abnormal.</data>
      <data key="d3">chunk-196a80cd0ae47fda3849b101cca91a15&lt;SEP&gt;chunk-b00f93aa3d24d0275d4290db3fb2cca3</data>
    </node>
    <node id="Natural Killer Cells">
      <data key="d0">Natural Killer Cells</data>
      <data key="d1">category</data>
      <data key="d2">A major type of lymphocyte capable of killing tumor cells or virus-infected cells without requiring prior sensitization.&lt;SEP&gt;A subtype of lymphocytes capable of identifying and killing tumor cells or virus-infected cells.&lt;SEP&gt;Natural killer (NK) cells are a major type of lymphocyte containing granules with enzymes that kill tumor cells or cells infected with a virus.&lt;SEP&gt;Natural killer (NK) cells are a type of lymphocyte that functions within the immune system to eliminate tumor cells and virus-infected cells.&lt;SEP&gt;Natural killer (NK) cells are lymphocytes capable of killing tumor cells or virus-infected cells.</data>
      <data key="d3">chunk-81c87ec3c2682da4d531da53f6e5e18c&lt;SEP&gt;chunk-a99a89bec88823cedf4c1f0cd1a78e81&lt;SEP&gt;chunk-53e3a9418b1d7916e3c8717a397bbb58&lt;SEP&gt;chunk-b00f93aa3d24d0275d4290db3fb2cca3&lt;SEP&gt;chunk-196a80cd0ae47fda3849b101cca91a15</data>
    </node>
    <node id="Centrocytes">
      <data key="d0">Centrocytes</data>
      <data key="d1">category</data>
      <data key="d2">A category of smaller, slower-dividing B cells found in the light zone of temporary germinal centers within lymph nodes.</data>
      <data key="d3">chunk-b00f93aa3d24d0275d4290db3fb2cca3</data>
    </node>
    <node id="Centroblasts">
      <data key="d0">Centroblasts</data>
      <data key="d1">category</data>
      <data key="d2">A category of larger, rapidly reproducing B cells located in the dark zone of germinal centers whose prevalence determines follicular lymphoma grading.</data>
      <data key="d3">chunk-b00f93aa3d24d0275d4290db3fb2cca3</data>
    </node>
    <node id="Follicular Lymphoma Grade 3B">
      <data key="d0">Follicular Lymphoma Grade 3B</data>
      <data key="d1">category</data>
      <data key="d2">A rare, aggressive subtype of follicular lymphoma, referred to as follicular large B-cell lymphoma in WHO5, which is treated clinically as diffuse large B-cell lymphoma.&lt;SEP&gt;A specific high-grade categorization of follicular lymphoma consisting entirely of centroblasts.</data>
      <data key="d3">chunk-b00f93aa3d24d0275d4290db3fb2cca3&lt;SEP&gt;chunk-829d6b7840e9f2c8d97d22d2ce2c43c1</data>
    </node>
    <node id="Follicular Lymphoma Grade 3A">
      <data key="d0">Follicular Lymphoma Grade 3A</data>
      <data key="d1">category</data>
      <data key="d2">A histological grade of follicular lymphoma containing mixed centrocytes and centroblasts that may be clinically managed as classic FL or DLBCL.&lt;SEP&gt;A specific grade of follicular lymphoma that may be treated either as classic follicular lymphoma or as diffuse large B-cell lymphoma depending on cellular findings and clinical setting.</data>
      <data key="d3">chunk-b00f93aa3d24d0275d4290db3fb2cca3&lt;SEP&gt;chunk-829d6b7840e9f2c8d97d22d2ce2c43c1</data>
    </node>
    <node id="Transformed FL">
      <data key="d0">Transformed FL</data>
      <data key="d1">category</data>
      <data key="d2">A diagnostic categorization for follicular lymphoma that has evolved into an aggressive lymphoma requiring altered treatment pathways.</data>
      <data key="d3">chunk-b00f93aa3d24d0275d4290db3fb2cca3</data>
    </node>
    <node id="Extranodal Disease">
      <data key="d0">Extranodal Disease</data>
      <data key="d1">category</data>
      <data key="d2">A clinical category describing lymphoma tumor involvement outside the lymph nodes, such as in the bone marrow.</data>
      <data key="d3">chunk-b00f93aa3d24d0275d4290db3fb2cca3</data>
    </node>
    <node id="Bile Duct Cancer Stages">
      <data key="d0">Bile Duct Cancer Stages</data>
      <data key="d1">category</data>
      <data key="d2">A clinical classification system measuring tumor size (T) and assessing cancer spread into blood vessels, liver, or distant structures.</data>
      <data key="d3">chunk-b00f93aa3d24d0275d4290db3fb2cca3</data>
    </node>
    <node id="Uncommon Follicular Lymphoma">
      <data key="d0">Uncommon Follicular Lymphoma</data>
      <data key="d1">category</data>
      <data key="d2">A subtype of follicular lymphoma that exhibits uncommon pathologic features or is t(14;18)-negative.</data>
      <data key="d3">chunk-829d6b7840e9f2c8d97d22d2ce2c43c1</data>
    </node>
    <node id="Pediatric-Type Follicular Lymphoma">
      <data key="d0">Pediatric-Type Follicular Lymphoma</data>
      <data key="d1">category</data>
      <data key="d2">A distinct form of follicular lymphoma that typically occurs in children, often presenting as an enlarged lymph node in the head and neck region.</data>
      <data key="d3">chunk-829d6b7840e9f2c8d97d22d2ce2c43c1</data>
    </node>
    <node id="Transformed Follicular Lymphoma">
      <data key="d0">Transformed Follicular Lymphoma</data>
      <data key="d1">category</data>
      <data key="d2">A clinical category where indolent follicular lymphoma converts into an aggressive diffuse large B-cell lymphoma.</data>
      <data key="d3">chunk-829d6b7840e9f2c8d97d22d2ce2c43c1</data>
    </node>
    <node id="Head and Neck Cancer">
      <data key="d0">Head and Neck Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A broad category of cancers originating in various anatomical structures of the head and neck, including the oral cavity, pharynx, larynx, and sinuses.&lt;SEP&gt;A category of cancers arising in the head and neck region, encompassing oral cavity and mouth cancers.&lt;SEP&gt;A group of cancers affecting the head and neck region, including structures like the oropharynx, throat, jaw, teeth, and gums, requiring multidisciplinary pretreatment assessments.&lt;SEP&gt;A group of cancers that affect the mouth, neck, throat, jaw, and adjacent structures, strongly associated with tobacco and nicotine use.&lt;SEP&gt;A group of malignancies affecting the head and neck region, with risk and treatment outcomes significantly influenced by smoking and vaping.&lt;SEP&gt;A group of malignancies affecting the oral and pharyngeal areas linked to human papillomavirus infection.&lt;SEP&gt;Head and neck cancer is a category of malignancies affecting areas such as the oral cavity, throat, and related structures, requiring comprehensive multi-disciplinary pre-treatment evaluations.&lt;SEP&gt;Head and neck cancer refers to a group of cancers affecting the head and neck anatomical structures, with treatments that can impair hearing, airway, and swallowing function.</data>
      <data key="d3">chunk-f2a44e885faf856aa579d824b3cd85e7&lt;SEP&gt;chunk-052101b592e186cce702983d2acc67e4&lt;SEP&gt;chunk-3d609bd1a55d409470c55ad55e2d125d&lt;SEP&gt;chunk-9ad38c9dc069a8ff8df58c42f00eba23&lt;SEP&gt;chunk-33608457001e818e2b300adae9c6c0d9&lt;SEP&gt;chunk-c9383db20cd696688798a193862cb5cc&lt;SEP&gt;chunk-7bdde77ad1be3ee9308db3c7703674b0&lt;SEP&gt;chunk-829d6b7840e9f2c8d97d22d2ce2c43c1</data>
    </node>
    <node id="Mouth Cancer">
      <data key="d0">Mouth Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A form of cancer that develops in parts of the oral cavity and is classified as a subtype of head and neck cancer.&lt;SEP&gt;A form of head and neck cancer that arises in the oral cavity, addressed in patient educational materials.&lt;SEP&gt;A specific form of cancer occurring in the oral cavity for which molecular testing currently provides limited targeted treatment options.&lt;SEP&gt;A subtype of head and neck cancer arising in the oral cavity.&lt;SEP&gt;A type of cancer that develops in the tissues of the oral cavity, categorized under head and neck cancers.&lt;SEP&gt;Also known as oral cavity cancer, it is a subcategory of head and neck cancer that develops in the tissues and structures of the mouth, most commonly starting in squamous cells.&lt;SEP&gt;Mouth cancer is a specific malignancy located in the oral cavity, staged using TNM scores and clinical assessments to determine prognosis and treatment.</data>
      <data key="d3">chunk-28e4e845dfd1390f7f94cfb11bee1526&lt;SEP&gt;chunk-3d609bd1a55d409470c55ad55e2d125d&lt;SEP&gt;chunk-f43f96815f23658d5b24fe95ed4bd5ed&lt;SEP&gt;chunk-5a84075aaac61b0ad85e5f811fc4f24b&lt;SEP&gt;chunk-c9383db20cd696688798a193862cb5cc&lt;SEP&gt;chunk-d47a420aa2acde1175ad95bf6dc2e664&lt;SEP&gt;chunk-829d6b7840e9f2c8d97d22d2ce2c43c1</data>
    </node>
    <node id="B Symptoms">
      <data key="d0">B Symptoms</data>
      <data key="d1">category</data>
      <data key="d2">A clinical group of systemic lymphoma symptoms including fever, night sweats, fatigue, and unexplained weight loss.&lt;SEP&gt;A group of disease-related symptoms including unexplained fevers, drenching night sweats, and unexpected weight loss associated with CLL.</data>
      <data key="d3">chunk-717174ace5855cc823d51c46c9a70648&lt;SEP&gt;chunk-829d6b7840e9f2c8d97d22d2ce2c43c1</data>
    </node>
    <node id="Bone Marrow Aspirate and Biopsy">
      <data key="d0">Bone Marrow Aspirate and Biopsy</data>
      <data key="d1">category</data>
      <data key="d2">A diagnostic medical procedure removing tissue and cell samples from bone marrow to confirm a diagnosis of acute myeloid leukemia.&lt;SEP&gt;A specialized diagnostic procedure sampling marrow tissue used to stage and evaluate follicular lymphoma progression.</data>
      <data key="d3">chunk-29c9b8b5fd2cd967c48522af79a9598f&lt;SEP&gt;chunk-829d6b7840e9f2c8d97d22d2ce2c43c1</data>
    </node>
    <node id="Immunophenotyping">
      <data key="d0">Immunophenotyping</data>
      <data key="d1">category</data>
      <data key="d2">A diagnostic process using antibodies to detect the presence or absence of specific white blood cell antigens and biomarkers.&lt;SEP&gt;A laboratory diagnostic process that uses flow cytometry to identify specific immune and surface markers on cells.&lt;SEP&gt;A laboratory test category that analyzes antigens and markers expressed by cells to identify lymphoma types.&lt;SEP&gt;Immunophenotyping is a laboratory testing method used to analyze biomarkers and cellular characteristics in cutaneous B-cell lymphoma diagnosis.&lt;SEP&gt;Immunophenotyping is an analytical process that uses antibodies to identify specific white blood cell antigens or biomarkers on or inside cells.</data>
      <data key="d3">chunk-829d6b7840e9f2c8d97d22d2ce2c43c1&lt;SEP&gt;chunk-d73843c009e523101e1464a2b28bc144&lt;SEP&gt;chunk-0786666c65b5bf00705439d5cb60d5a0&lt;SEP&gt;chunk-b63f0a9aec8d42c8426ded05a9bf92b4&lt;SEP&gt;chunk-196a80cd0ae47fda3849b101cca91a15</data>
    </node>
    <node id="Health Care Team">
      <data key="d0">Health Care Team</data>
      <data key="d1">organization</data>
      <data key="d2">A group of medical professionals who provide care, perform diagnostic examinations, evaluate patient symptoms, and offer emotional and clinical support.&lt;SEP&gt;The multidisciplinary group of physicians, nurses, and medical professionals collaborating to diagnose, treat, and monitor lymphoma patients.</data>
      <data key="d3">chunk-50531346164ea7c08dd087a868b3cc2a&lt;SEP&gt;chunk-829d6b7840e9f2c8d97d22d2ce2c43c1</data>
    </node>
    <node id="Cancer Center">
      <data key="d0">Cancer Center</data>
      <data key="d1">organization</data>
      <data key="d2">A specialized healthcare facility where oncology imaging tests, such as PET-CT scans, are conducted.&lt;SEP&gt;A specialized medical facility equipped with technology to conduct PET/CT scans and other cancer assessments.&lt;SEP&gt;A specialized medical facility or hospital dedicated to treating cancer patients and providing expertise in specific AML subtypes.&lt;SEP&gt;A specialized medical facility or institution where cancer diagnosis, imaging, and treatments are conducted.&lt;SEP&gt;Specialized medical institutions responsible for diagnostic evaluations, staging, and individualized treatment regimens for lymphoma patients.</data>
      <data key="d3">chunk-7f9fe20fe42489996573eb1b436128b6&lt;SEP&gt;chunk-97836a515d346931beb424ae40a89877&lt;SEP&gt;chunk-76a038845aaedb9ef7852018f26778b3&lt;SEP&gt;chunk-a2778e34af702d49d5e70867726e14b2&lt;SEP&gt;chunk-829d6b7840e9f2c8d97d22d2ce2c43c1</data>
    </node>
    <node id="Head And Neck Cancer">
      <data key="d0">Head And Neck Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A broad group of cancers arising in the head or neck region, including the oral cavity, oropharynx, nasopharynx, hypopharynx, larynx, nasal cavity, and paranasal sinuses.&lt;SEP&gt;A broad group of cancers including throat cancer and nasopharyngeal cancer that can impact overall health and oral health including teeth, jaw, and gums.&lt;SEP&gt;A broader category of cancers affecting the head and neck region, influenced by risk factors such as tobacco and alcohol use.&lt;SEP&gt;A group of cancers occurring in the throat, larynx, or oropharynx, often evaluated using endoscopic tools.&lt;SEP&gt;A group of cancers occurring in the throat, mouth, or neck that can be caused by human papillomavirus infection.&lt;SEP&gt;A group of cancers that arise in the head or neck area, generally not inherited, with tobacco and alcohol as key risk factors.&lt;SEP&gt;Head and neck cancer is a broad group of cancers affecting the head and neck region, including throat cancer, which can impact oral health, teeth, jaw, and general body function.&lt;SEP&gt;Head and neck cancer is a category of cancers affecting the head and neck region, with treatments that can impact the jaw, teeth, gums, and regional lymph nodes.&lt;SEP&gt;Malignancies affecting the head and neck areas that can be triggered by long-term HPV infection.&lt;SEP&gt;Malignancies arising in the head and neck region, monitored with CT imaging and strongly linked to smoking or vaping.</data>
      <data key="d3">chunk-705ff2bd04b2b58b98187f60f23a659e&lt;SEP&gt;chunk-28e4e845dfd1390f7f94cfb11bee1526&lt;SEP&gt;chunk-50531346164ea7c08dd087a868b3cc2a&lt;SEP&gt;chunk-f43f96815f23658d5b24fe95ed4bd5ed&lt;SEP&gt;chunk-f8639a06098656be20a04fe129660616&lt;SEP&gt;chunk-38185832d6395b9952def9a72ecc339d&lt;SEP&gt;chunk-b4d036ee5fd77783b9e7ddef3a8477ae&lt;SEP&gt;chunk-ea7b3f83164304ee4a562046eb0f5033&lt;SEP&gt;chunk-9530f389987c13273449ab22a85170ae&lt;SEP&gt;chunk-d47a420aa2acde1175ad95bf6dc2e664</data>
    </node>
    <node id="Nasopharyngeal Cancer">
      <data key="d0">Nasopharyngeal Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A form of cancer originating in the nasopharynx, which is the upper part of the throat near the nasal cavity.&lt;SEP&gt;A form of head and neck cancer occurring in the upper part of the throat near the nasal cavity.&lt;SEP&gt;A type of head and neck cancer occurring in the nasopharynx that can specifically affect the eyes and related cranial structures.&lt;SEP&gt;Nasopharyngeal cancer (NPC) is a cancer of the nasopharynx that is predominantly EBV-related and staged using TNM scores to determine prognosis and treatment.</data>
      <data key="d3">chunk-ea7b3f83164304ee4a562046eb0f5033&lt;SEP&gt;chunk-f43f96815f23658d5b24fe95ed4bd5ed&lt;SEP&gt;chunk-052101b592e186cce702983d2acc67e4&lt;SEP&gt;chunk-5a84075aaac61b0ad85e5f811fc4f24b</data>
    </node>
    <node id="High-Volume Center">
      <data key="d0">High-Volume Center</data>
      <data key="d1">organization</data>
      <data key="d2">A specialized hospital or medical facility with significant clinical experience and case volume in treating head and neck cancers.&lt;SEP&gt;A specialized medical facility or hospital with extensive clinical experience and a high patient caseload in diagnosing and treating complex conditions such as pancreatic cancer.&lt;SEP&gt;Specialized hospitals or medical treatment centers with high patient volume and clinical experience in treating specific head and neck cancers.</data>
      <data key="d3">chunk-f43f96815f23658d5b24fe95ed4bd5ed&lt;SEP&gt;chunk-0fb70c1c798caae12ac2d64e61bcbad4&lt;SEP&gt;chunk-c9383db20cd696688798a193862cb5cc</data>
    </node>
    <node id="Oropharyngeal Cancer">
      <data key="d0">Oropharyngeal Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A form of throat cancer affecting the oropharynx, including the soft palate, tonsils, back walls of the throat, and the base of the tongue.&lt;SEP&gt;A subtype of head and neck cancer that develops in the middle part of the throat near the mouth (oropharynx).&lt;SEP&gt;A type of head and neck cancer that arises in the middle part of the throat near the mouth.</data>
      <data key="d3">chunk-f43f96815f23658d5b24fe95ed4bd5ed&lt;SEP&gt;chunk-c9383db20cd696688798a193862cb5cc&lt;SEP&gt;chunk-38185832d6395b9952def9a72ecc339d</data>
    </node>
    <node id="Hypopharyngeal Cancer">
      <data key="d0">Hypopharyngeal Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A type of head and neck cancer located in the lower part of the throat near the voice box.</data>
      <data key="d3">chunk-f43f96815f23658d5b24fe95ed4bd5ed</data>
    </node>
    <node id="Laryngeal Cancer">
      <data key="d0">Laryngeal Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A form of throat and head and neck cancer that affects the larynx (voice box), distinct from nasopharyngeal cancer.&lt;SEP&gt;A type of head and neck cancer occurring in the voice box (larynx).</data>
      <data key="d3">chunk-f43f96815f23658d5b24fe95ed4bd5ed&lt;SEP&gt;chunk-c9383db20cd696688798a193862cb5cc</data>
    </node>
    <node id="Nasal Cavity And Paranasal Sinus Cancer">
      <data key="d0">Nasal Cavity And Paranasal Sinus Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A type of head and neck cancer originating in the space behind the nose and the surrounding air cavities.</data>
      <data key="d3">chunk-f43f96815f23658d5b24fe95ed4bd5ed</data>
    </node>
    <node id="Oral Cavity">
      <data key="d0">Oral Cavity</data>
      <data key="d1">category</data>
      <data key="d2">The anatomical region comprising the lips, buccal mucosa, front of the tongue, gums, floor of mouth, hard palate, and retromolar trigone.&lt;SEP&gt;The anatomical structure representing the first part of the digestive and respiratory systems, consisting of lips, gums, tongue, palate, and lining mucosa.</data>
      <data key="d3">chunk-f43f96815f23658d5b24fe95ed4bd5ed&lt;SEP&gt;chunk-d47a420aa2acde1175ad95bf6dc2e664</data>
    </node>
    <node id="Respiratory System">
      <data key="d0">Respiratory System</data>
      <data key="d1">category</data>
      <data key="d2">The anatomical system responsible for breathing, for which the mouth serves as an entry and pathway.</data>
      <data key="d3">chunk-f43f96815f23658d5b24fe95ed4bd5ed</data>
    </node>
    <node id="Depth Of Invasion">
      <data key="d0">Depth Of Invasion</data>
      <data key="d1">category</data>
      <data key="d2">A pathological measurement assessing how deeply a tumor has invaded through the layers of the oral mucosa.</data>
      <data key="d3">chunk-f43f96815f23658d5b24fe95ed4bd5ed</data>
    </node>
    <node id="Local Hospital">
      <data key="d0">Local Hospital</data>
      <data key="d1">organization</data>
      <data key="d2">Community healthcare facilities that offer cancer care, medical appointments, and patient support groups.</data>
      <data key="d3">chunk-d47a420aa2acde1175ad95bf6dc2e664</data>
    </node>
    <node id="Support Groups">
      <data key="d0">Support Groups</data>
      <data key="d1">organization</data>
      <data key="d2">Community or hospital-based groups composed of people diagnosed with cancer, offering shared support and experiences across various stages of care.&lt;SEP&gt;Organizations or community groups offering emotional and social support to individuals undergoing cancer diagnosis and treatment.</data>
      <data key="d3">chunk-44a870810cef881997b741c32ec368fe&lt;SEP&gt;chunk-d47a420aa2acde1175ad95bf6dc2e664</data>
    </node>
    <node id="Family History">
      <data key="d0">Family History</data>
      <data key="d1">category</data>
      <data key="d2">A clinical record of health conditions and cancer diagnoses among biological relatives used to assess hereditary risk factors.&lt;SEP&gt;A clinical risk-assessment category detailing diseases such as cancer, heart disease, and diabetes among biological relatives across generations.&lt;SEP&gt;A diagnostic information category documenting illnesses, cancers, age of onset, and genetic test results among biological relatives to evaluate hereditary risk.&lt;SEP&gt;A family history is a medical record of health conditions, such as cancer, heart disease, and diabetes, occurring in blood relatives.&lt;SEP&gt;A genealogical medical record detailing diseases such as cancer, heart disease, and diabetes among blood relatives to evaluate hereditary risk.&lt;SEP&gt;A medical risk factor indicating the occurrence of bladder cancer or hereditary conditions in relatives.&lt;SEP&gt;A record of health conditions affecting blood relatives, such as cancer, heart disease, and diabetes, to identify potential genetic risk factors.&lt;SEP&gt;A record of health issues and conditions such as cancer, diabetes, and heart disease in blood relatives, collected during cancer treatment planning.&lt;SEP&gt;A record of medical conditions and diagnoses among blood relatives used to evaluate genetic cancer risks and context.&lt;SEP&gt;An inquiry into the medical conditions and cancer diagnoses of blood relatives to evaluate potential hereditary patterns and genetic risk.&lt;SEP&gt;The health record of medical conditions among relatives; having close family members with prostate or related cancers significantly increases disease risk.</data>
      <data key="d3">chunk-a06038ec84f20e873b9e275a23aea8d9&lt;SEP&gt;chunk-ae28e3852f4a9f229250fc19eb39036b&lt;SEP&gt;chunk-1c7418fb993bb3daa95d8563909da1de&lt;SEP&gt;chunk-ba28a3ce3534c0655a0d08a953d7f038&lt;SEP&gt;chunk-8aa2c7020ce6e89888e81972588726e3&lt;SEP&gt;chunk-67e9c4dc95841db7d0af39e1267ae71b&lt;SEP&gt;chunk-69e63736c94b8b08a565c3d8679d3b57&lt;SEP&gt;chunk-7390896141393e0b4d1c15df77b5c0a7&lt;SEP&gt;chunk-5846f51c2ca4fae54459ce9c50e3e820&lt;SEP&gt;chunk-c77e0d4642a374a51f87e7e25b19281f&lt;SEP&gt;chunk-d47a420aa2acde1175ad95bf6dc2e664</data>
    </node>
    <node id="Tobacco And Alcohol Use">
      <data key="d0">Tobacco And Alcohol Use</data>
      <data key="d1">category</data>
      <data key="d2">Established behavioral lifestyle risk factors that increase the likelihood of developing head and neck cancer and negatively affect treatment efficacy and patient survival.&lt;SEP&gt;Known behavioral risk factors that increase the risk of head and neck cancers and negatively impact treatment efficacy and survival.</data>
      <data key="d3">chunk-711bee9440e11d7c737bc4a49b880910&lt;SEP&gt;chunk-d47a420aa2acde1175ad95bf6dc2e664</data>
    </node>
    <node id="Dental Exam">
      <data key="d0">Dental Exam</data>
      <data key="d1">event</data>
      <data key="d2">A clinical evaluation and cleaning recommended prior to certain cancer treatments to assess and protect the jaw, teeth, and gums.&lt;SEP&gt;A dental checkup and cleaning procedure conducted prior to cancer therapy to prevent and manage complications affecting the jaw, teeth, and gums.&lt;SEP&gt;A specialized examination and cleaning of the oral cavity and teeth required to prevent and manage complications caused by head and neck cancer therapies.&lt;SEP&gt;A specialized oral examination and imaging procedure to evaluate teeth, gums, and jaw health before cancer therapy.&lt;SEP&gt;An examination including x-rays (Panorex) or CT scans performed before cancer therapy to evaluate and optimize oral and dental health.</data>
      <data key="d3">chunk-052101b592e186cce702983d2acc67e4&lt;SEP&gt;chunk-38185832d6395b9952def9a72ecc339d&lt;SEP&gt;chunk-711bee9440e11d7c737bc4a49b880910&lt;SEP&gt;chunk-7bdde77ad1be3ee9308db3c7703674b0&lt;SEP&gt;chunk-d47a420aa2acde1175ad95bf6dc2e664</data>
    </node>
    <node id="Endoscopy With Examination Under Anesthesia">
      <data key="d0">Endoscopy With Examination Under Anesthesia</data>
      <data key="d1">event</data>
      <data key="d2">A scoping procedure performed under anesthesia to visually examine the airway and throat structures for treatment planning.&lt;SEP&gt;A specialized diagnostic evaluation performed under anesthesia to inspect the upper aerodigestive tract for cancer staging.</data>
      <data key="d3">chunk-d47a420aa2acde1175ad95bf6dc2e664&lt;SEP&gt;chunk-38185832d6395b9952def9a72ecc339d</data>
    </node>
    <node id="Chest CT">
      <data key="d0">Chest CT</data>
      <data key="d1">category</data>
      <data key="d2">A computed tomography imaging study of the chest used to evaluate disease spread or staging in head and neck cancer patients.</data>
      <data key="d3">chunk-d47a420aa2acde1175ad95bf6dc2e664</data>
    </node>
    <node id="FDG-PET/CT">
      <data key="d0">FDG-PET/CT</data>
      <data key="d1">category</data>
      <data key="d2">A combined functional and anatomical imaging scan used to detect distant cancer metastases in patients with nasopharyngeal carcinoma.&lt;SEP&gt;A hybrid functional and anatomical imaging scan used to detect leukemia occurring outside of the blood and bone marrow.&lt;SEP&gt;A specialized diagnostic scan combining PET and CT using fluorodeoxyglucose to detect cancer in lymph nodes and distant body sites.&lt;SEP&gt;A specific PET/CT imaging test that utilizes the radiotracer fluorodeoxyglucose (FDG) to identify cancerous lesions.&lt;SEP&gt;A specific combined PET/CT scan that utilizes the radiotracer fluorodeoxyglucose to image metabolic activity and cancer cells.&lt;SEP&gt;An advanced hybrid metabolic and anatomical imaging scan used for treatment planning and cancer staging.&lt;SEP&gt;An advanced imaging modality combining PET and CT scans using fluorodeoxyglucose to detect cancer in lymph nodes and distant anatomical sites.&lt;SEP&gt;An advanced imaging modality used as needed to evaluate tumor metabolic activity and staging.&lt;SEP&gt;An advanced imaging scan used to detect extramedullary leukemia occurring outside the blood and bone marrow.&lt;SEP&gt;An advanced imaging scan utilizing the F-18 fluorodeoxyglucose radiotracer to identify cancer across primary, nodal, and distant sites.</data>
      <data key="d3">chunk-705ff2bd04b2b58b98187f60f23a659e&lt;SEP&gt;chunk-50531346164ea7c08dd087a868b3cc2a&lt;SEP&gt;chunk-ae28e3852f4a9f229250fc19eb39036b&lt;SEP&gt;chunk-29c9b8b5fd2cd967c48522af79a9598f&lt;SEP&gt;chunk-9ad38c9dc069a8ff8df58c42f00eba23&lt;SEP&gt;chunk-38185832d6395b9952def9a72ecc339d&lt;SEP&gt;chunk-711bee9440e11d7c737bc4a49b880910&lt;SEP&gt;chunk-69e63736c94b8b08a565c3d8679d3b57&lt;SEP&gt;chunk-30c0bb66b1a2f93e89f5342ab1077451&lt;SEP&gt;chunk-d47a420aa2acde1175ad95bf6dc2e664</data>
    </node>
    <node id="Depression Screening">
      <data key="d0">Depression Screening</data>
      <data key="d1">event</data>
      <data key="d2">A psychosocial evaluation conducted to assess patient mental health and provide emotional care during cancer treatment planning.</data>
      <data key="d3">chunk-d47a420aa2acde1175ad95bf6dc2e664</data>
    </node>
    <node id="Hepatitis B Screening">
      <data key="d0">Hepatitis B Screening</data>
      <data key="d1">event</data>
      <data key="d2">A medical test administered as needed during pre-treatment planning to screen for viral hepatitis infection.</data>
      <data key="d3">chunk-d47a420aa2acde1175ad95bf6dc2e664</data>
    </node>
    <node id="Eastern Cooperative Oncology Group">
      <data key="d0">Eastern Cooperative Oncology Group</data>
      <data key="d1">organization</data>
      <data key="d2">The Eastern Cooperative Oncology Group (ECOG) is a cancer research organization that established the ECOG performance status scale used to evaluate patient fitness and daily functioning.&lt;SEP&gt;The Eastern Cooperative Oncology Group (ECOG) is a clinical oncology organization known for establishing a standardized performance status scale used to evaluate patients' general fitness and ability to perform daily tasks.&lt;SEP&gt;The Eastern Cooperative Oncology Group (ECOG) is a clinical oncology organization that established the ECOG Performance Status scale to assess patients' functional capabilities.&lt;SEP&gt;The Eastern Cooperative Oncology Group (ECOG) is a clinical research organization known for establishing the ECOG performance status scale used to assess patient functional status.&lt;SEP&gt;The Eastern Cooperative Oncology Group (ECOG) is a medical research organization that established the ECOG Performance Status score, used to assess a patient's overall health and ability to tolerate treatments.&lt;SEP&gt;The Eastern Cooperative Oncology Group (ECOG) is a medical research organization that established the performance status scale used by clinicians to assess patient functional capability.&lt;SEP&gt;The Eastern Cooperative Oncology Group (ECOG) is an organization that developed a widely used performance status scale to assess a patient's level of functioning and fitness.</data>
      <data key="d3">chunk-9fa573748870dc50a98a935843997c68&lt;SEP&gt;chunk-33608457001e818e2b300adae9c6c0d9&lt;SEP&gt;chunk-d73843c009e523101e1464a2b28bc144&lt;SEP&gt;chunk-0786666c65b5bf00705439d5cb60d5a0&lt;SEP&gt;chunk-fc469adbdd7a41816d59f249439bc726&lt;SEP&gt;chunk-3fbf2f6a3c150687a59f814d94f1d150&lt;SEP&gt;chunk-7bdde77ad1be3ee9308db3c7703674b0</data>
    </node>
    <node id="Fertility Preservation">
      <data key="d0">Fertility Preservation</data>
      <data key="d1">category</data>
      <data key="d2">A category of medical interventions and procedures undertaken to protect a patient's ability to have biological children before undergoing cancer treatment.&lt;SEP&gt;A category of medical interventions and procedures—such as sperm banking, egg freezing, and ovarian tissue banking—designed to preserve reproductive capabilities before cancer treatment.&lt;SEP&gt;A clinical consideration and set of strategies addressing how cancer treatments affect reproductive function and how patients can preserve fertility.&lt;SEP&gt;A medical and reproductive care category focused on maintaining a patient's ability to have children prior to systemic cancer treatments.&lt;SEP&gt;Clinical consultation and medical interventions undertaken prior to systemic cancer treatment to protect a patient's ability to have children.&lt;SEP&gt;Fertility preservation encompasses clinical measures and interventions taken prior to cancer therapy to protect a patient's ability to have biological children.&lt;SEP&gt;Fertility preservation encompasses medical options and planning discussed with the care team to address fertility risks associated with rectal cancer treatment.&lt;SEP&gt;Fertility preservation encompasses medical techniques such as sperm banking, egg freezing, ovarian tissue banking, and ovarian transposition to protect reproductive ability from gonadotoxic cancer therapies.&lt;SEP&gt;Fertility preservation encompasses options and procedures discussed with specialists to maintain reproductive capability prior to cancer treatments like chemotherapy.&lt;SEP&gt;Interventions and consultations undertaken before cancer treatment begins to safeguard reproductive capabilities against therapy-induced impairment.&lt;SEP&gt;Medical and family planning procedures and counseling offered to patients facing fertility risks from cancer therapies like chemotherapy and radiation.&lt;SEP&gt;Medical options, consultations, and actions taken before cancer therapy to preserve the patient's future reproductive potential.&lt;SEP&gt;Medical procedures and consultations, such as freezing sperm or eggs, undertaken to protect the ability to have children prior to receiving cancer therapies.&lt;SEP&gt;Medical procedures and options—such as sperm banking, egg freezing, and ovarian tissue banking—utilized to safeguard reproductive potential before cancer treatment.</data>
      <data key="d3">chunk-0bd86bf8fc82f14fa5f7f51d924514e7&lt;SEP&gt;chunk-052101b592e186cce702983d2acc67e4&lt;SEP&gt;chunk-06384634b72466c480713ee8d57f25ed&lt;SEP&gt;chunk-9fa573748870dc50a98a935843997c68&lt;SEP&gt;chunk-33608457001e818e2b300adae9c6c0d9&lt;SEP&gt;chunk-d73843c009e523101e1464a2b28bc144&lt;SEP&gt;chunk-ba28a3ce3534c0655a0d08a953d7f038&lt;SEP&gt;chunk-ee254e84e63bd35682ed56c41cef9247&lt;SEP&gt;chunk-cd2be7a2ce722f07b19c80e6e1690a8e&lt;SEP&gt;chunk-5fa7c7369d88ae71c842152510867223&lt;SEP&gt;chunk-f2c9770fd98dbbe3c7947601fb3e654c&lt;SEP&gt;chunk-7bdde77ad1be3ee9308db3c7703674b0&lt;SEP&gt;chunk-67015f3916810c4378b2ed269cc27f29&lt;SEP&gt;chunk-594536d6aaa61f8f1699ba50bf218a33</data>
    </node>
    <node id="Distress">
      <data key="d0">Distress</data>
      <data key="d1">category</data>
      <data key="d2">Distress is a multifaceted negative psychological, emotional, physical, and spiritual experience commonly screened for and managed during cancer care.&lt;SEP&gt;Distress is a multifaceted unpleasant experience of psychological, social, or spiritual nature that cancer patients may encounter throughout their diagnosis and treatment.</data>
      <data key="d3">chunk-7bdde77ad1be3ee9308db3c7703674b0&lt;SEP&gt;chunk-33608457001e818e2b300adae9c6c0d9</data>
    </node>
    <node id="Complete Head and Neck Exam">
      <data key="d0">Complete Head and Neck Exam</data>
      <data key="d1">event</data>
      <data key="d2">A physical examination event where a health care provider evaluates the head, neck, oral cavity, and throat using palpation and specialized instruments.</data>
      <data key="d3">chunk-7bdde77ad1be3ee9308db3c7703674b0</data>
    </node>
    <node id="Distress Screening">
      <data key="d0">Distress Screening</data>
      <data key="d1">event</data>
      <data key="d2">A clinical evaluation assessing psychological and emotional distress in patients diagnosed with cancer.&lt;SEP&gt;A clinical evaluation category designed to identify emotional, psychological, and social distress in patients undergoing cancer testing and treatment.&lt;SEP&gt;A clinical evaluation conducted by the care team to measure a patient's emotional, mental, physical, and spiritual stress following a cancer diagnosis.&lt;SEP&gt;A psychological and clinical evaluation method used to assess patient emotional, mental, and social well-being during diagnosis and care.&lt;SEP&gt;A psychological and emotional assessment tool used during cancer workup to evaluate patient distress and provide psychosocial support.&lt;SEP&gt;A routine clinical assessment conducted by the care team to evaluate and monitor psychological and emotional distress in cancer patients.&lt;SEP&gt;An evaluation conducted by cancer treatment teams to screen for psychological, emotional, social, or spiritual distress such as anxiety and depression.&lt;SEP&gt;An evaluation process to assess emotional, physical, social, or spiritual distress resulting from a cancer diagnosis.</data>
      <data key="d3">chunk-a06038ec84f20e873b9e275a23aea8d9&lt;SEP&gt;chunk-052101b592e186cce702983d2acc67e4&lt;SEP&gt;chunk-c37f547042fc10baabdbfaadf010bce5&lt;SEP&gt;chunk-38185832d6395b9952def9a72ecc339d&lt;SEP&gt;chunk-fc469adbdd7a41816d59f249439bc726&lt;SEP&gt;chunk-5846f51c2ca4fae54459ce9c50e3e820&lt;SEP&gt;chunk-650982a589c2d527bc13923ccd0569ef&lt;SEP&gt;chunk-7bdde77ad1be3ee9308db3c7703674b0</data>
    </node>
    <node id="Endocrine Tests">
      <data key="d0">Endocrine Tests</data>
      <data key="d1">event</data>
      <data key="d2">Blood tests that evaluate hormone levels and function of glands like the thyroid and pituitary, which may be affected by head and neck radiation therapy.&lt;SEP&gt;Diagnostic blood evaluations conducted before and after radiation therapy to check hormone levels and thyroid or pituitary gland function.</data>
      <data key="d3">chunk-7bdde77ad1be3ee9308db3c7703674b0&lt;SEP&gt;chunk-052101b592e186cce702983d2acc67e4</data>
    </node>
    <node id="Hearing Test">
      <data key="d0">Hearing Test</data>
      <data key="d1">event</data>
      <data key="d2">A diagnostic evaluation, often generating an audiogram, used to detect and characterize hearing loss caused by head and neck tumors or their treatment.&lt;SEP&gt;An audiogram test conducted as needed to evaluate hearing health prior to potential ototoxic cancer therapies.&lt;SEP&gt;An audiological evaluation that produces an audiogram to assess potential hearing loss caused by head and neck tumors or their treatments.&lt;SEP&gt;An auditory assessment resulting in an audiogram to evaluate potential hearing impairment caused by head and neck tumors or their treatment.</data>
      <data key="d3">chunk-7bdde77ad1be3ee9308db3c7703674b0&lt;SEP&gt;chunk-33608457001e818e2b300adae9c6c0d9&lt;SEP&gt;chunk-052101b592e186cce702983d2acc67e4&lt;SEP&gt;chunk-38185832d6395b9952def9a72ecc339d</data>
    </node>
    <node id="Nutrition Assessment">
      <data key="d0">Nutrition Assessment</data>
      <data key="d1">event</data>
      <data key="d2">A clinical consultation conducted before cancer therapy starts to evaluate dietary needs and prevent treatment-related malnutrition and weight loss.&lt;SEP&gt;A clinical evaluation category measuring patient nutritional status and dietary needs during cancer diagnosis and treatment.&lt;SEP&gt;A clinical evaluation performed by a dietitian or nutritionist to establish nutritional adequacy prior to starting cancer treatment.&lt;SEP&gt;A pretreatment evaluation by a nutritionist or dietitian to establish an adequate and sustained nutrition and hydration plan.</data>
      <data key="d3">chunk-7bdde77ad1be3ee9308db3c7703674b0&lt;SEP&gt;chunk-33608457001e818e2b300adae9c6c0d9&lt;SEP&gt;chunk-c77e0d4642a374a51f87e7e25b19281f&lt;SEP&gt;chunk-052101b592e186cce702983d2acc67e4</data>
    </node>
    <node id="Speech and Swallowing Assessment">
      <data key="d0">Speech and Swallowing Assessment</data>
      <data key="d1">event</data>
      <data key="d2">A functional clinical evaluation conducted by a speech or swallowing therapist before and after cancer treatment.&lt;SEP&gt;A functional clinical evaluation conducted by a therapist before and after cancer treatment to assess swallowing and speaking capabilities.</data>
      <data key="d3">chunk-7bdde77ad1be3ee9308db3c7703674b0&lt;SEP&gt;chunk-052101b592e186cce702983d2acc67e4</data>
    </node>
    <node id="Cancer Diagnosis">
      <data key="d0">Cancer Diagnosis</data>
      <data key="d1">event</data>
      <data key="d2">The formal identification and staging of cancer in a patient, which triggers multidisciplinary care assessments and potential psychological distress.</data>
      <data key="d3">chunk-7bdde77ad1be3ee9308db3c7703674b0</data>
    </node>
    <node id="Pregnancy Test">
      <data key="d0">Pregnancy Test</data>
      <data key="d1">event</data>
      <data key="d2">A clinical screening administered to patients with ovaries before initiating cancer treatment to avoid harm to a developing baby.&lt;SEP&gt;A diagnostic evaluation performed prior to initiating cancer treatment for patients who can become pregnant to prevent fetal exposure to therapy.&lt;SEP&gt;A diagnostic medical test administered to individuals before cancer therapy to ensure treatments will not harm an unborn baby.&lt;SEP&gt;A diagnostic procedure required prior to starting cancer treatment for patients who have ovaries and are capable of becoming pregnant.&lt;SEP&gt;A diagnostic test administered to individuals capable of pregnancy prior to initiating cancer therapies.&lt;SEP&gt;A screening test performed before starting cancer therapies on individuals with ovaries to ensure pregnancy is not present.</data>
      <data key="d3">chunk-0bd86bf8fc82f14fa5f7f51d924514e7&lt;SEP&gt;chunk-052101b592e186cce702983d2acc67e4&lt;SEP&gt;chunk-5fa7c7369d88ae71c842152510867223&lt;SEP&gt;chunk-3fbf2f6a3c150687a59f814d94f1d150&lt;SEP&gt;chunk-7bdde77ad1be3ee9308db3c7703674b0&lt;SEP&gt;chunk-67015f3916810c4378b2ed269cc27f29</data>
    </node>
    <node id="Social Worker">
      <data key="d0">Social Worker</data>
      <data key="d1">person</data>
      <data key="d2">A mental health and support professional available to assist cancer patients and their families in managing anxiety, depression, and distress.&lt;SEP&gt;Healthcare support professionals who assist cancer survivors in navigating mental health services and financial resources.</data>
      <data key="d3">chunk-7bdde77ad1be3ee9308db3c7703674b0&lt;SEP&gt;chunk-cf41d1c08e8df109ad214d831867a5d9</data>
    </node>
    <node id="Nutritionist or Dietitian">
      <data key="d0">Nutritionist or Dietitian</data>
      <data key="d1">person</data>
      <data key="d2">A clinical dietary expert who evaluates patient nutritional needs and advises on foods and fluids before cancer treatment begins.</data>
      <data key="d3">chunk-7bdde77ad1be3ee9308db3c7703674b0</data>
    </node>
    <node id="Speech or Swallowing Therapist">
      <data key="d0">Speech or Swallowing Therapist</data>
      <data key="d1">person</data>
      <data key="d2">A specialized therapist who tests and helps manage speech and swallowing function before and after cancer therapy.</data>
      <data key="d3">chunk-7bdde77ad1be3ee9308db3c7703674b0</data>
    </node>
    <node id="Fertility Specialist">
      <data key="d0">Fertility Specialist</data>
      <data key="d1">person</data>
      <data key="d2">A healthcare professional consulted before treatment to address fertility preservation for patients undergoing bone cancer therapies.&lt;SEP&gt;A healthcare professional specializing in reproductive medicine consulted by patients wishing to preserve fertility prior to initiating endocrine therapy.&lt;SEP&gt;A medical professional specializing in reproductive health who assists cancer patients with fertility preservation options prior to treatment.&lt;SEP&gt;A reproductive healthcare professional who counsels and assists cancer patients in preserving their ability to conceive children.&lt;SEP&gt;A reproductive medicine professional who consults with patients regarding options and procedures for fertility preservation prior to cancer treatment.&lt;SEP&gt;A reproductive medicine specialist who consults with cancer patients on preservation options prior to gonadotoxic treatments.&lt;SEP&gt;Reproductive medicine practitioners who counsel cancer patients on reproductive risks and strategies to preserve fertility prior to initiating therapy.</data>
      <data key="d3">chunk-6b02315423350f3598288e189fbcb8ae&lt;SEP&gt;chunk-e45947107c74d8a06e350be57a94a408&lt;SEP&gt;chunk-0bd86bf8fc82f14fa5f7f51d924514e7&lt;SEP&gt;chunk-052101b592e186cce702983d2acc67e4&lt;SEP&gt;chunk-33608457001e818e2b300adae9c6c0d9&lt;SEP&gt;chunk-7bdde77ad1be3ee9308db3c7703674b0&lt;SEP&gt;chunk-67015f3916810c4378b2ed269cc27f29</data>
    </node>
    <node id="Barrier Methods">
      <data key="d0">Barrier Methods</data>
      <data key="d1">category</data>
      <data key="d2">Barrier methods represent a category of non-hormonal contraception, including condoms, diaphragms, cervical caps, and contraceptive sponges, used to prevent pregnancy during treatment.&lt;SEP&gt;Non-hormonal contraceptive devices and methods, such as condoms, diaphragms, cervical caps, and contraceptive sponges, used to prevent pregnancy during cancer therapy.&lt;SEP&gt;Non-hormonal contraceptive devices including condoms, diaphragms, cervical caps, and contraceptive sponges recommended to prevent pregnancy during treatment.&lt;SEP&gt;Non-hormonal contraceptive devices, such as condoms, diaphragms, cervical caps, and sponges, used to prevent pregnancy.</data>
      <data key="d3">chunk-3fbf2f6a3c150687a59f814d94f1d150&lt;SEP&gt;chunk-7bdde77ad1be3ee9308db3c7703674b0&lt;SEP&gt;chunk-0bd86bf8fc82f14fa5f7f51d924514e7&lt;SEP&gt;chunk-5fa7c7369d88ae71c842152510867223</data>
    </node>
    <node id="Contraception">
      <data key="d0">Contraception</data>
      <data key="d1">category</data>
      <data key="d2">A category of birth control methods, including non-hormonal barrier methods and IUDs, used to prevent pregnancy during and after cancer treatment.&lt;SEP&gt;Birth control measures necessary during and following cancer treatment to prevent pregnancy due to potential damage to sperm, eggs, or developing fetuses.&lt;SEP&gt;Birth control measures, such as condoms, used to prevent pregnancy during and after cancer treatment due to potential sperm damage.&lt;SEP&gt;Methods of birth control, including barrier methods and intrauterine devices, recommended to prevent pregnancy during and immediately after cancer therapy.&lt;SEP&gt;Pregnancy prevention measures, such as intrauterine devices (IUDs), recommended during cancer treatment to avoid harm to damaged reproductive cells.</data>
      <data key="d3">chunk-705ff2bd04b2b58b98187f60f23a659e&lt;SEP&gt;chunk-0bd86bf8fc82f14fa5f7f51d924514e7&lt;SEP&gt;chunk-ba28a3ce3534c0655a0d08a953d7f038&lt;SEP&gt;chunk-5fa7c7369d88ae71c842152510867223&lt;SEP&gt;chunk-7bdde77ad1be3ee9308db3c7703674b0</data>
    </node>
    <node id="Ultrasound">
      <data key="d0">Ultrasound</data>
      <data key="d1">category</data>
      <data key="d2">A diagnostic imaging modality referenced as a complementary breast examination alongside mammograms and breast MRIs.&lt;SEP&gt;A diagnostic imaging test that uses sound waves to generate pictures of internal organs, recommended every six months for liver cancer screening.&lt;SEP&gt;A diagnostic imaging test using sound waves via transabdominal or transvaginal probes to visualize pelvic organs and determine tumor characteristics.&lt;SEP&gt;A medical imaging test utilizing sound waves to examine internal breast structures and assist in clinical diagnosis.&lt;SEP&gt;A non-invasive diagnostic imaging modality that typically serves as the primary radiological evaluation for suspected ovarian cancer.&lt;SEP&gt;A non-invasive diagnostic imaging procedure utilizing sound waves to visualize the size, shape, and structure of thyroid nodules and neck lymph nodes.&lt;SEP&gt;A non-invasive diagnostic imaging technique using sound waves to visualize internal structures, including the prostate.&lt;SEP&gt;A non-invasive imaging category utilizing sound waves to visualize internal organs, encompassing tests such as echocardiograms.&lt;SEP&gt;A painless diagnostic imaging technique that uses high-energy sound waves and a handheld transducer to produce images of internal body structures.&lt;SEP&gt;A painless diagnostic imaging tool that uses high-energy sound waves to produce images of internal tissues, frequently used on the breast and armpit.&lt;SEP&gt;A painless imaging procedure using high-energy sound waves rather than x-rays to create pictures of internal tissues and guide biopsies.&lt;SEP&gt;A painless imaging technique using high-energy sound waves to capture images of internal organs and guide needle biopsies without using radiation.&lt;SEP&gt;An imaging examination technique used to visualize and guide needle placement during a lymph node biopsy.&lt;SEP&gt;An imaging technique employed to visualize internal structures and guide lymph node biopsies.&lt;SEP&gt;An imaging technique utilizing sound waves to visualize the prostate and guide needle placement during a biopsy.&lt;SEP&gt;An initial diagnostic imaging technique commonly used when ovarian cancer is suspected.&lt;SEP&gt;Ultrasound is the primary diagnostic imaging technique used to examine the thyroid gland and neck for abnormal nodules or cancer.</data>
      <data key="d3">chunk-705ff2bd04b2b58b98187f60f23a659e&lt;SEP&gt;chunk-77ac570b4029abb181150e0d0975aefb&lt;SEP&gt;chunk-8a1130b0f6bbe935ceddbafc6ce2740f&lt;SEP&gt;chunk-9dc281a303d0d4c5300c0c1c45b739ed&lt;SEP&gt;chunk-50531346164ea7c08dd087a868b3cc2a&lt;SEP&gt;chunk-3d609bd1a55d409470c55ad55e2d125d&lt;SEP&gt;chunk-9ad38c9dc069a8ff8df58c42f00eba23&lt;SEP&gt;chunk-18b5e32980f3efa0cd012e2abab9b9fc&lt;SEP&gt;chunk-0739b33959299ea67072f390ce38bffd&lt;SEP&gt;chunk-e5406c28b41e499fad4ae44f2c44fdd7&lt;SEP&gt;chunk-96238b4b361e393ff452a09d1ce26154&lt;SEP&gt;chunk-67e9c4dc95841db7d0af39e1267ae71b&lt;SEP&gt;chunk-6a93aa507dd7d98a02e8ba92d39e3649&lt;SEP&gt;chunk-7f9fe20fe42489996573eb1b436128b6&lt;SEP&gt;chunk-d4bc8b1b941d18ac455e5f255e1df8c1&lt;SEP&gt;chunk-4724f6acaaa7931560b29614efc2927f&lt;SEP&gt;chunk-a2778e34af702d49d5e70867726e14b2</data>
    </node>
    <node id="Panoramic Dental X-Ray">
      <data key="d0">Panoramic Dental X-Ray</data>
      <data key="d1">category</data>
      <data key="d2">A low-dose radiation imaging technique capturing the entire mouth, including the teeth and jaw structures, in a single image.&lt;SEP&gt;A low-dose radiation imaging test that captures the entire mouth, jaw, and teeth in a single image to assist in dental and oral surgical planning.&lt;SEP&gt;A low-radiation dental imaging examination that captures the full mouth, teeth, jaws, and surrounding structures in a single image.</data>
      <data key="d3">chunk-705ff2bd04b2b58b98187f60f23a659e&lt;SEP&gt;chunk-9ad38c9dc069a8ff8df58c42f00eba23&lt;SEP&gt;chunk-50531346164ea7c08dd087a868b3cc2a</data>
    </node>
    <node id="Contrast Material">
      <data key="d0">Contrast Material</data>
      <data key="d1">category</data>
      <data key="d2">A diagnostic substance administered orally or intravenously to enhance the clarity and quality of CT and MRI images.&lt;SEP&gt;A substance administered during diagnostic imaging scans (such as CT and MRI) to enhance and sharpen images of internal organs and structures.&lt;SEP&gt;A temporary substance administered intravenously to enhance organ and tissue clarity on CT and MRI scans.&lt;SEP&gt;Contrast material is a category of chemical substances administered during imaging procedures like CT and MRI scans to enhance image clarity.&lt;SEP&gt;Contrast material is an oral or intravenous substance administered during imaging scans to enhance the quality and clarity of the pictures.&lt;SEP&gt;Specialized medical imaging substances administered to enhance and clarify pictures of internal organs during CT and MRI evaluations.&lt;SEP&gt;Substances administered before imaging tests such as CT or MRI to enhance and clarify pictures of internal body organs and structures.&lt;SEP&gt;Substances administered prior to imaging tests like CT and MRI to improve clarity and enhance images of organs and structures.&lt;SEP&gt;Substances used to improve and enhance diagnostic imaging pictures of internal organs and structures during CT and MRI scans.</data>
      <data key="d3">chunk-705ff2bd04b2b58b98187f60f23a659e&lt;SEP&gt;chunk-052101b592e186cce702983d2acc67e4&lt;SEP&gt;chunk-50531346164ea7c08dd087a868b3cc2a&lt;SEP&gt;chunk-db4e8318949a3fda5683c53985c6af05&lt;SEP&gt;chunk-9ad38c9dc069a8ff8df58c42f00eba23&lt;SEP&gt;chunk-4724f6acaaa7931560b29614efc2927f&lt;SEP&gt;chunk-5fa7c7369d88ae71c842152510867223&lt;SEP&gt;chunk-3fbf2f6a3c150687a59f814d94f1d150&lt;SEP&gt;chunk-a2778e34af702d49d5e70867726e14b2</data>
    </node>
    <node id="Cancer Treatment">
      <data key="d0">Cancer Treatment</data>
      <data key="d1">category</data>
      <data key="d2">A category of medical therapies, including chemotherapy, used to treat cancer that can impact fertility and require preventative health measures.&lt;SEP&gt;The therapeutic regimen administered to treat cancer, which can impact fertility, reproductive organs, and patient performance status.&lt;SEP&gt;Therapeutic medical interventions for cancer that can temporarily or permanently impair fertility and cause fetal harm if pregnancy occurs during treatment.&lt;SEP&gt;Therapies and interventions designed to treat malignancy, which can impact fertility, wound healing, and reproductive health.</data>
      <data key="d3">chunk-705ff2bd04b2b58b98187f60f23a659e&lt;SEP&gt;chunk-0bd86bf8fc82f14fa5f7f51d924514e7&lt;SEP&gt;chunk-3fbf2f6a3c150687a59f814d94f1d150&lt;SEP&gt;chunk-5fa7c7369d88ae71c842152510867223</data>
    </node>
    <node id="Technologist">
      <data key="d0">Technologist</data>
      <data key="d1">person</data>
      <data key="d2">A healthcare specialist who operates imaging equipment such as MRI scanners and screens patients for metal implants and safety risks.&lt;SEP&gt;A medical imaging professional who operates MRI equipment, verifies patient safety regarding metal implants, and collects scans.&lt;SEP&gt;A medical imaging technician who operates MRI machinery and collects scan images from the patient.&lt;SEP&gt;A medical imaging technician who operates scanning machinery such as MRI equipment and collects diagnostic images.&lt;SEP&gt;A medical professional who operates MRI equipment, prepares patients, and collects diagnostic images.&lt;SEP&gt;A medical professional who operates imaging equipment such as the MRI scanner and screens patients for metal.&lt;SEP&gt;A specialized medical technician who operates imaging equipment such as MRI scanners and ensures patient safety around magnetic fields.</data>
      <data key="d3">chunk-705ff2bd04b2b58b98187f60f23a659e&lt;SEP&gt;chunk-29c9b8b5fd2cd967c48522af79a9598f&lt;SEP&gt;chunk-db4e8318949a3fda5683c53985c6af05&lt;SEP&gt;chunk-9ad38c9dc069a8ff8df58c42f00eba23&lt;SEP&gt;chunk-4724f6acaaa7931560b29614efc2927f&lt;SEP&gt;chunk-3fbf2f6a3c150687a59f814d94f1d150&lt;SEP&gt;chunk-a2778e34af702d49d5e70867726e14b2</data>
    </node>
    <node id="Dentist">
      <data key="d0">Dentist</data>
      <data key="d1">person</data>
      <data key="d2">A dental healthcare practitioner who performs panoramic dental x-rays and coordinates oral care before or during treatment.&lt;SEP&gt;A dental healthcare practitioner who routinely performs panoramic dental x-rays to plan oral treatments such as dentures and braces.&lt;SEP&gt;A dental healthcare professional responsible for monitoring and caring for teeth, jaw, and gum health before, during, and after cancer treatments.&lt;SEP&gt;A dental healthcare professional who monitors and treats teeth, jaw, and gum health before, during, and after head and neck cancer therapy.&lt;SEP&gt;A dental healthcare provider responsible for conducting oral cleanings and evaluations before head and neck cancer treatments begin.&lt;SEP&gt;A dental healthcare provider who regularly performs panoramic dental x-rays to evaluate teeth and plan patient treatments.&lt;SEP&gt;A dental professional who performs cleanings, checkups, and necessary dental work prior to cancer treatment to prevent oral health complications.&lt;SEP&gt;An oral health professional responsible for monitoring and caring for teeth, gums, and jaws before, during, and after cancer therapy.</data>
      <data key="d3">chunk-705ff2bd04b2b58b98187f60f23a659e&lt;SEP&gt;chunk-28e4e845dfd1390f7f94cfb11bee1526&lt;SEP&gt;chunk-052101b592e186cce702983d2acc67e4&lt;SEP&gt;chunk-50531346164ea7c08dd087a868b3cc2a&lt;SEP&gt;chunk-3d609bd1a55d409470c55ad55e2d125d&lt;SEP&gt;chunk-9ad38c9dc069a8ff8df58c42f00eba23&lt;SEP&gt;chunk-38185832d6395b9952def9a72ecc339d&lt;SEP&gt;chunk-711bee9440e11d7c737bc4a49b880910</data>
    </node>
    <node id="Oral Surgeon">
      <data key="d0">Oral Surgeon</data>
      <data key="d1">person</data>
      <data key="d2">A specialized dental clinician who uses panoramic dental x-rays for planning surgical interventions like extractions and implants.&lt;SEP&gt;A specialized surgeon who performs surgical dental procedures and utilizes panoramic dental x-rays for procedural planning.&lt;SEP&gt;A surgical dental specialist involved in everyday oral evaluations and surgical treatment planning.&lt;SEP&gt;A surgical dental specialist who conducts panoramic dental x-rays to prepare for procedures including tooth extractions and implants.</data>
      <data key="d3">chunk-705ff2bd04b2b58b98187f60f23a659e&lt;SEP&gt;chunk-9ad38c9dc069a8ff8df58c42f00eba23&lt;SEP&gt;chunk-50531346164ea7c08dd087a868b3cc2a&lt;SEP&gt;chunk-3d609bd1a55d409470c55ad55e2d125d</data>
    </node>
    <node id="Medical Binder">
      <data key="d0">Medical Binder</data>
      <data key="d1">category</data>
      <data key="d2">A personal organizational system used by cancer patients to store medical records, imaging results, insurance cards, and appointment notes.</data>
      <data key="d3">chunk-705ff2bd04b2b58b98187f60f23a659e</data>
    </node>
    <node id="Patient Portal">
      <data key="d0">Patient Portal</data>
      <data key="d1">category</data>
      <data key="d2">A secure digital healthcare access system used to deliver medical reports and imaging results directly from providers to patients.&lt;SEP&gt;An online digital access system that enables patients to view test results, imaging reports, and medical records electronically.</data>
      <data key="d3">chunk-705ff2bd04b2b58b98187f60f23a659e&lt;SEP&gt;chunk-5fa7c7369d88ae71c842152510867223</data>
    </node>
    <node id="Bone Scan">
      <data key="d0">Bone Scan</data>
      <data key="d1">category</data>
      <data key="d2">A bone scan is a diagnostic imaging procedure that utilizes a radioactive tracer to detect whether cancer has metastasized to the skeletal system.&lt;SEP&gt;A bone scan is a nuclear imaging diagnostic procedure using a radiotracer to identify areas of bone damage, tumors, or other skeletal abnormalities.&lt;SEP&gt;A diagnostic imaging study used to detect bone conditions and bone metastases that may be superseded by FDG-PET/CT.&lt;SEP&gt;A diagnostic imaging test that uses an injected radiotracer and a special camera to identify areas of bone damage or cancer.&lt;SEP&gt;A diagnostic nuclear imaging procedure performed when symptoms suggest that cancer has metastasized to the bones.&lt;SEP&gt;A diagnostic nuclear imaging study used to identify cancerous lesions and abnormalities within the skeletal system.&lt;SEP&gt;A nuclear imaging procedure that utilizes a radiotracer to detect bone metastases or abnormalities.&lt;SEP&gt;A nuclear imaging test used to detect abnormalities in the bones, which may be replaced by sodium fluoride PET-CT or FDG PET-CT.&lt;SEP&gt;A nuclear imaging test used to evaluate potential cancer spread to the skeletal system.&lt;SEP&gt;A nuclear imaging test utilizing radioactive tracers to detect bone damage and metastasis resulting from prostate cancer.&lt;SEP&gt;A specialized diagnostic imaging procedure used to evaluate bone health and detect potential skeletal cancer spread.&lt;SEP&gt;A specialized diagnostic imaging test used to evaluate whether cancer has metastasized to the skeletal system.&lt;SEP&gt;A specialized imaging test used to evaluate whether prostate cancer has metastasized to the bones.</data>
      <data key="d3">chunk-705ff2bd04b2b58b98187f60f23a659e&lt;SEP&gt;chunk-9dc281a303d0d4c5300c0c1c45b739ed&lt;SEP&gt;chunk-50531346164ea7c08dd087a868b3cc2a&lt;SEP&gt;chunk-0bd86bf8fc82f14fa5f7f51d924514e7&lt;SEP&gt;chunk-975e540ddee1810d43caf8df4adcf205&lt;SEP&gt;chunk-aeafa486bfd320cdaa7811ad75777912&lt;SEP&gt;chunk-9ad38c9dc069a8ff8df58c42f00eba23&lt;SEP&gt;chunk-7a890e27eba8c63d10f19b85a72fc14a&lt;SEP&gt;chunk-67e9c4dc95841db7d0af39e1267ae71b&lt;SEP&gt;chunk-7f9fe20fe42489996573eb1b436128b6&lt;SEP&gt;chunk-5846f51c2ca4fae54459ce9c50e3e820&lt;SEP&gt;chunk-3fbf2f6a3c150687a59f814d94f1d150&lt;SEP&gt;chunk-a2778e34af702d49d5e70867726e14b2</data>
    </node>
    <node id="Sodium Fluoride PET/CT">
      <data key="d0">Sodium Fluoride PET/CT</data>
      <data key="d1">category</data>
      <data key="d2">A specialized PET/CT scan modality used to identify bone malignancy, which may not be necessary if FDG-PET/CT findings are conclusive.&lt;SEP&gt;A specialized diagnostic scan used to evaluate bone involvement and metastatic cancer.&lt;SEP&gt;An imaging test utilizing a sodium fluoride tracer to examine bone metastasis, which may be superseded by FDG-PET/CT.</data>
      <data key="d3">chunk-705ff2bd04b2b58b98187f60f23a659e&lt;SEP&gt;chunk-9ad38c9dc069a8ff8df58c42f00eba23&lt;SEP&gt;chunk-50531346164ea7c08dd087a868b3cc2a</data>
    </node>
    <node id="Smoking And Vaping">
      <data key="d0">Smoking And Vaping</data>
      <data key="d1">category</data>
      <data key="d2">Inhalation of nicotine products that increases cancer incidence, hinders cancer treatment efficacy, and prevents wound healing.</data>
      <data key="d3">chunk-705ff2bd04b2b58b98187f60f23a659e</data>
    </node>
    <node id="Closed MRI">
      <data key="d0">Closed MRI</data>
      <data key="d1">category</data>
      <data key="d2">A capsule-like magnetic resonance imaging machine where the magnet completely surrounds the patient; more common than open MRI.&lt;SEP&gt;A closed MRI is an imaging machine configuration with a capsule-like, enclosed design where magnets surround the patient.&lt;SEP&gt;A common type of magnetic resonance imaging system where the magnet completely surrounds the patient.&lt;SEP&gt;A magnetic resonance imaging configuration featuring a capsule-like, enclosed cylindrical bore surrounding the patient during examination.&lt;SEP&gt;A type of MRI scanner featuring a capsule-like design where the magnetic coils completely surround the patient.&lt;SEP&gt;An MRI machine with a capsule-like design where the magnet fully surrounds the patient during scanning.&lt;SEP&gt;An enclosed capsule-like magnetic resonance imaging device configuration.</data>
      <data key="d3">chunk-705ff2bd04b2b58b98187f60f23a659e&lt;SEP&gt;chunk-50531346164ea7c08dd087a868b3cc2a&lt;SEP&gt;chunk-db4e8318949a3fda5683c53985c6af05&lt;SEP&gt;chunk-30c0bb66b1a2f93e89f5342ab1077451&lt;SEP&gt;chunk-4724f6acaaa7931560b29614efc2927f&lt;SEP&gt;chunk-5fa7c7369d88ae71c842152510867223&lt;SEP&gt;chunk-a2778e34af702d49d5e70867726e14b2</data>
    </node>
    <node id="Open MRI">
      <data key="d0">Open MRI</data>
      <data key="d1">category</data>
      <data key="d2">A magnetic resonance imaging machine with an open top and bottom, accommodating individuals who experience claustrophobia.&lt;SEP&gt;A type of MRI scanner designed with openings on each end to accommodate patients with claustrophobia.&lt;SEP&gt;A type of magnetic resonance imaging system featuring a magnetic top and bottom with open ends, suitable for individuals with claustrophobia.&lt;SEP&gt;An MRI scanner with magnetic top and bottom plates and open sides, designed for patients with claustrophobia or discomfort in enclosed spaces.&lt;SEP&gt;An alternative magnetic resonance imaging machine with an open structure on both ends, designed to accommodate patients with claustrophobia.&lt;SEP&gt;An open MRI is an imaging scanner configuration featuring an open side design with magnetic top and bottom panels.&lt;SEP&gt;An open-sided magnetic resonance imaging design that accommodates individuals with claustrophobia.</data>
      <data key="d3">chunk-705ff2bd04b2b58b98187f60f23a659e&lt;SEP&gt;chunk-50531346164ea7c08dd087a868b3cc2a&lt;SEP&gt;chunk-db4e8318949a3fda5683c53985c6af05&lt;SEP&gt;chunk-30c0bb66b1a2f93e89f5342ab1077451&lt;SEP&gt;chunk-4724f6acaaa7931560b29614efc2927f&lt;SEP&gt;chunk-5fa7c7369d88ae71c842152510867223&lt;SEP&gt;chunk-a2778e34af702d49d5e70867726e14b2</data>
    </node>
    <node id="Immune Checkpoint Inhibitor Therapy">
      <data key="d0">Immune Checkpoint Inhibitor Therapy</data>
      <data key="d1">category</data>
      <data key="d2">A type of immunotherapy that targets proteins such as PD-1 and PD-L1 to empower the immune system to fight cancer cells.&lt;SEP&gt;An immunotherapeutic treatment class that activates the body's immune cells against cancer, prescribed based on PD-L1 expression levels.&lt;SEP&gt;Immune checkpoint inhibitor therapy is a class of immunotherapy that targets proteins such as PD-1 and PD-L1 to assist the immune system in fighting cancer cells.</data>
      <data key="d3">chunk-f8639a06098656be20a04fe129660616&lt;SEP&gt;chunk-0739b33959299ea67072f390ce38bffd&lt;SEP&gt;chunk-3d609bd1a55d409470c55ad55e2d125d</data>
    </node>
    <node id="Cannabis Use">
      <data key="d0">Cannabis Use</data>
      <data key="d1">category</data>
      <data key="d2">The consumption of cannabis, which can alter the amount of anesthesia required by a patient during surgical procedures.</data>
      <data key="d3">chunk-3d609bd1a55d409470c55ad55e2d125d</data>
    </node>
    <node id="Nicotine">
      <data key="d0">Nicotine</data>
      <data key="d1">category</data>
      <data key="d2">An addictive chemical compound present in tobacco and vaping products that drives dependency and complicates cessation.&lt;SEP&gt;The addictive chemical found in tobacco products that causes withdrawal symptoms and urges to continue smoking or vaping.</data>
      <data key="d3">chunk-9ad38c9dc069a8ff8df58c42f00eba23&lt;SEP&gt;chunk-3d609bd1a55d409470c55ad55e2d125d</data>
    </node>
    <node id="Ear, Nose, and Throat Doctor">
      <data key="d0">Ear, Nose, and Throat Doctor</data>
      <data key="d1">category</data>
      <data key="d2">A specialist (ENT or otolaryngologist) consulted for evaluation and diagnosis of abnormalities in the neck, glands, tongue, or mouth.</data>
      <data key="d3">chunk-3d609bd1a55d409470c55ad55e2d125d</data>
    </node>
    <node id="Fine-Needle Aspiration">
      <data key="d0">Fine-Needle Aspiration</data>
      <data key="d1">event</data>
      <data key="d2">A biopsy procedure (FNA) that uses a thin needle to withdraw fluid or cell samples from a suspected tumor or lymph node.&lt;SEP&gt;A biopsy technique using thin needles to extract fluid or cell samples from a suspicious area.&lt;SEP&gt;A diagnostic biopsy procedure that uses a thin needle to extract fluid or tissue from thyroid nodules, often performed under ultrasound guidance.&lt;SEP&gt;A diagnostic needle biopsy procedure that samples thyroid tissue, capable of suggesting but not definitively diagnosing follicular or oncocytic carcinoma.&lt;SEP&gt;A diagnostic procedure using a thin needle to extract a tissue sample from suspicious or enlarged lymph nodes for testing.&lt;SEP&gt;A minimally invasive biopsy technique (FNA) utilizing fine needles to extract tissue or fluid samples from tumors or lymph nodes.</data>
      <data key="d3">chunk-8a1130b0f6bbe935ceddbafc6ce2740f&lt;SEP&gt;chunk-3d609bd1a55d409470c55ad55e2d125d&lt;SEP&gt;chunk-0739b33959299ea67072f390ce38bffd&lt;SEP&gt;chunk-b8a273f96e02707e2e87fc43353ed57f&lt;SEP&gt;chunk-7f9fe20fe42489996573eb1b436128b6&lt;SEP&gt;chunk-a18089523f6dcd63cfa5664dc1c01618</data>
    </node>
    <node id="MSI-H/dMMR Mutation">
      <data key="d0">MSI-H/dMMR Mutation</data>
      <data key="d1">category</data>
      <data key="d2">A genetic alteration characterized by microsatellite instability or deficient mismatch repair, preventing the normal correction of DNA errors.&lt;SEP&gt;A genetic biomarker state featuring high microsatellite instability or deficient mismatch repair, indicating repair defects in DNA.</data>
      <data key="d3">chunk-30c0bb66b1a2f93e89f5342ab1077451&lt;SEP&gt;chunk-3d609bd1a55d409470c55ad55e2d125d</data>
    </node>
    <node id="PD-L1 Testing">
      <data key="d0">PD-L1 Testing</data>
      <data key="d1">category</data>
      <data key="d2">A biomarker diagnostic test that measures the expression of programmed death ligand 1 protein on cancer cells to determine candidate eligibility for immune checkpoint inhibitor therapy.&lt;SEP&gt;A diagnostic test that assesses programmed death-ligand 1 protein expression via combined positive score (CPS) to determine eligibility for immunotherapy.&lt;SEP&gt;A specialized laboratory assay calculating the Combined Positive Score (CPS) of programmed death ligand 1 to direct immunotherapy selection.</data>
      <data key="d3">chunk-ea7b3f83164304ee4a562046eb0f5033&lt;SEP&gt;chunk-0739b33959299ea67072f390ce38bffd&lt;SEP&gt;chunk-3d609bd1a55d409470c55ad55e2d125d</data>
    </node>
    <node id="Tumor Mutational Burden-High">
      <data key="d0">Tumor Mutational Burden-High</data>
      <data key="d1">category</data>
      <data key="d2">A biomarker profile (TMB-H) identified by 10 or more mutations per million base pairs of tumor DNA, indicative of eligibility for immune checkpoint inhibitors.&lt;SEP&gt;Tumor mutational burden-high (TMB-H) is a genomic classification defined by ten or more mutations per million base pairs of tumor DNA, often treated with immune checkpoint inhibitors.</data>
      <data key="d3">chunk-f8639a06098656be20a04fe129660616&lt;SEP&gt;chunk-3d609bd1a55d409470c55ad55e2d125d</data>
    </node>
    <node id="American Joint Committee On Cancer">
      <data key="d0">American Joint Committee On Cancer</data>
      <data key="d1">organization</data>
      <data key="d2">The American Joint Committee on Cancer (AJCC) is an organization that developed a widely used staging system to evaluate the extent, location, and subtype of cancer.&lt;SEP&gt;The American Joint Committee on Cancer (AJCC) is an organization that established a standardized cancer staging system to classify the extent, location, and subtype of cancer.</data>
      <data key="d3">chunk-28e4e845dfd1390f7f94cfb11bee1526&lt;SEP&gt;chunk-f8639a06098656be20a04fe129660616</data>
    </node>
    <node id="TNM Staging System">
      <data key="d0">TNM Staging System</data>
      <data key="d1">category</data>
      <data key="d2">A cancer staging classification created by the AJCC assessing tumor depth (T), lymph node involvement (N), and distant metastasis (M) to assign cancer stages from 0 to IV.&lt;SEP&gt;A cancer staging framework based on tumor size/extent (T), regional lymph node involvement (N), and metastasis (M), ranging from stage 0 to stage 4.&lt;SEP&gt;A cancer staging system developed by the AJCC based on tumor size and invasion (T), lymph node involvement (N), and distant metastasis (M).&lt;SEP&gt;A standard cancer staging classification system based on tumor size (T), regional lymph node involvement (N), and distant metastasis (M) used to describe breast cancer progression.&lt;SEP&gt;A standard cancer staging system based on tumor size (T), lymph node involvement (N), and distant metastasis (M), evaluated both clinically and pathologically.&lt;SEP&gt;A standardized cancer classification system based on tumor size (T), lymph node involvement (N), and metastasis (M).&lt;SEP&gt;A standardized medical cancer staging classification assessing tumor size, lymph node involvement, and metastasis.&lt;SEP&gt;A standardized medical staging system categorizing tumor extent (T), lymph node involvement (N), and distant metastasis (M).&lt;SEP&gt;The TNM staging system is a classification framework used to stage throat and nasopharyngeal cancer by measuring primary tumor size (T), regional lymph node involvement (N), and distant metastasis (M).&lt;SEP&gt;The TNM staging system is a standardized cancer classification framework used to evaluate tumor extent, such as for squamous cell carcinoma of the nasopharynx.&lt;SEP&gt;The TNM staging system is an anatomic and prognostic cancer classification system that evaluates tumor size (T), lymph node involvement (N), and distant metastasis (M).&lt;SEP&gt;The TNM system is a cancer classification framework based on tumor size and depth (T), lymph node involvement (N), and distant metastasis (M).</data>
      <data key="d3">chunk-3f05c8ea6f7c7b4ba1fb0ff1c1733980&lt;SEP&gt;chunk-28e4e845dfd1390f7f94cfb11bee1526&lt;SEP&gt;chunk-0d388da75afb5ea2d01c97e55cb2b872&lt;SEP&gt;chunk-cb41559e96b71d2bb4ea207c806e8d5f&lt;SEP&gt;chunk-5d8e20e6004dd43ae0f68185383b594d&lt;SEP&gt;chunk-f8639a06098656be20a04fe129660616&lt;SEP&gt;chunk-d9882c04dd7676c6433074e5e393c72e&lt;SEP&gt;chunk-c1c1687a8a20b9c451956cf8bba241cc&lt;SEP&gt;chunk-965e5a6bad03f2129a98be4373f99176&lt;SEP&gt;chunk-d249262ff9e7e657de99a30199159cdf&lt;SEP&gt;chunk-6b02315423350f3598288e189fbcb8ae&lt;SEP&gt;chunk-a18089523f6dcd63cfa5664dc1c01618</data>
    </node>
    <node id="Clinical Stage">
      <data key="d0">Clinical Stage</data>
      <data key="d1">category</data>
      <data key="d2">A cancer staging category assigned prior to treatment based on physical exams, biopsies, and imaging tests.&lt;SEP&gt;A cancer staging classification determined prior to treatment, derived from physical examination, biopsy, and imaging evaluations.&lt;SEP&gt;A staging designation determined prior to definitive treatment based on physical exams, biopsies, and imaging tests, designated with the prefix 'c'.&lt;SEP&gt;Clinical stage is a cancer staging category assigned prior to treatment, based on physical examination, biopsy, and imaging results.&lt;SEP&gt;Clinical stage is a cancer staging classification assigned prior to treatment based on physical examinations, imaging, and biopsy results.&lt;SEP&gt;The cancer stage rating assessed before any treatment begins, designated as cTNM based on clinical evaluations.</data>
      <data key="d3">chunk-3f05c8ea6f7c7b4ba1fb0ff1c1733980&lt;SEP&gt;chunk-28e4e845dfd1390f7f94cfb11bee1526&lt;SEP&gt;chunk-cb41559e96b71d2bb4ea207c806e8d5f&lt;SEP&gt;chunk-0d388da75afb5ea2d01c97e55cb2b872&lt;SEP&gt;chunk-5d8e20e6004dd43ae0f68185383b594d&lt;SEP&gt;chunk-74f18dd51a0091fc888512458a85b0a1</data>
    </node>
    <node id="Pathologic Stage">
      <data key="d0">Pathologic Stage</data>
      <data key="d1">category</data>
      <data key="d2">A cancer staging classification established after surgical resection through laboratory examination of tumor tissue and regional lymph nodes.&lt;SEP&gt;A surgical cancer staging classification determined through microscopic examination of tissue removed during surgery.&lt;SEP&gt;A surgical staging category determined through laboratory examination of tissue removed during surgery, designated with the prefix 'p'.&lt;SEP&gt;Pathologic stage is a surgical staging classification determined by pathological examination of tissue and lymph nodes removed during surgery.&lt;SEP&gt;Pathologic stage, or surgical stage, is a cancer staging category determined through the examination of tissue removed during surgery.&lt;SEP&gt;The surgical stage determined by microscopic examination of tissue removed during surgery, designated as pTNM.</data>
      <data key="d3">chunk-3f05c8ea6f7c7b4ba1fb0ff1c1733980&lt;SEP&gt;chunk-28e4e845dfd1390f7f94cfb11bee1526&lt;SEP&gt;chunk-cb41559e96b71d2bb4ea207c806e8d5f&lt;SEP&gt;chunk-0d388da75afb5ea2d01c97e55cb2b872&lt;SEP&gt;chunk-5d8e20e6004dd43ae0f68185383b594d&lt;SEP&gt;chunk-74f18dd51a0091fc888512458a85b0a1</data>
    </node>
    <node id="Anatomic Staging">
      <data key="d0">Anatomic Staging</data>
      <data key="d1">category</data>
      <data key="d2">A cancer staging category determined strictly by tumor size, lymph node status, and distant metastatic spread.&lt;SEP&gt;A classification of cancer extent based strictly on tumor size (T), regional lymph node involvement (N), and distant metastasis (M).&lt;SEP&gt;A staging method based purely on the physical extent of cancer, determined by tumor size (T), regional lymph node status (N), and distant metastasis (M).</data>
      <data key="d3">chunk-3f05c8ea6f7c7b4ba1fb0ff1c1733980&lt;SEP&gt;chunk-28e4e845dfd1390f7f94cfb11bee1526&lt;SEP&gt;chunk-fc469adbdd7a41816d59f249439bc726</data>
    </node>
    <node id="Prognostic Staging">
      <data key="d0">Prognostic Staging</data>
      <data key="d1">category</data>
      <data key="d2">A cancer staging category that integrates anatomical TNM factors and standard-of-care assumptions to predict disease outcomes.&lt;SEP&gt;A comprehensive staging category incorporating anatomic TNM, tumor grade, and biomarker status (HER2, ER, PR) assuming standard-of-care treatment.&lt;SEP&gt;A staging method that combines anatomic TNM data with other factors such as Epstein-Barr virus levels and standard-of-care assumptions, subdivided into clinical and pathologic stages.</data>
      <data key="d3">chunk-3f05c8ea6f7c7b4ba1fb0ff1c1733980&lt;SEP&gt;chunk-28e4e845dfd1390f7f94cfb11bee1526&lt;SEP&gt;chunk-fc469adbdd7a41816d59f249439bc726</data>
    </node>
    <node id="Locoregional Disease">
      <data key="d0">Locoregional Disease</data>
      <data key="d1">category</data>
      <data key="d2">A classification of cancer describing a tumor that has extended into local tissues, organs, or regional lymph nodes near the oral cavity.&lt;SEP&gt;A classification of cancer spread, also termed local metastasis or locally advanced disease, involving adjacent structures such as the axillary lymph nodes.&lt;SEP&gt;A clinical classification referring to cancer that has spread to nearby tissue, organs, or lymph nodes within the head and neck region.</data>
      <data key="d3">chunk-3f05c8ea6f7c7b4ba1fb0ff1c1733980&lt;SEP&gt;chunk-28e4e845dfd1390f7f94cfb11bee1526&lt;SEP&gt;chunk-c37f547042fc10baabdbfaadf010bce5</data>
    </node>
    <node id="Metastatic Disease">
      <data key="d0">Metastatic Disease</data>
      <data key="d1">category</data>
      <data key="d2">A severe disease classification describing cancer that has spread to distant organs, such as the lungs or liver, or distant lymph nodes.&lt;SEP&gt;An advanced classification of cancer where malignant cells have spread to distant organs, such as the lungs or liver.</data>
      <data key="d3">chunk-3f05c8ea6f7c7b4ba1fb0ff1c1733980&lt;SEP&gt;chunk-28e4e845dfd1390f7f94cfb11bee1526</data>
    </node>
    <node id="Numbered Cancer Stages">
      <data key="d0">Numbered Cancer Stages</data>
      <data key="d1">category</data>
      <data key="d2">A cancer classification framework ranking severity from Stage 0 to Stage 4 based on combined TNM diagnostic scores.</data>
      <data key="d3">chunk-28e4e845dfd1390f7f94cfb11bee1526</data>
    </node>
    <node id="Acute Myeloid Leukemia">
      <data key="d0">Acute Myeloid Leukemia</data>
      <data key="d1">category</data>
      <data key="d2">A fatal type of blood cancer starting in the stem cells of bone marrow, characterized by the accumulation of abnormal, immature white blood cells known as myeloblasts.&lt;SEP&gt;A form of leukemia characterized by genetic abnormalities like core binding factor (CBF) or FLT3 mutations, treated with targeted agents and chemotherapy.&lt;SEP&gt;A type of hematologic cancer starting in the bone marrow that is associated with blasts in the blood and coagulopathy.&lt;SEP&gt;Acute Myeloid Leukemia (AML) is a blood cancer characterized by abnormal myeloid blasts that fail to mature properly, resulting in a buildup in the bone marrow and blood.&lt;SEP&gt;Acute Myeloid Leukemia (AML) is a blood cancer characterized by the buildup of immature white blood cells (myeloblasts) in the bone marrow and blood, preventing normal blood cell production.&lt;SEP&gt;Acute Myeloid Leukemia (AML) is a cancer of the blood and bone marrow characterized by abnormal blood cell production, specific cellular markers, and genetic mutations.&lt;SEP&gt;Acute Myeloid Leukemia (AML) is a category of cancer that originates in the bone marrow and requires specialized diagnostic procedures like bone marrow biopsies and flow cytometry.&lt;SEP&gt;Acute Myeloid Leukemia (AML) is a form of blood and bone marrow cancer characterized by specific chromosomal and genetic abnormalities.&lt;SEP&gt;Acute Myeloid Leukemia (AML) is a form of blood cancer characterized by abnormal white blood cells, distinct cellular biomarkers, and specific genetic mutations.&lt;SEP&gt;Acute Myeloid Leukemia (AML) is a form of cancer that originates in blood stem cells within bone marrow, leading to the rapid proliferation of abnormal myeloblasts.&lt;SEP&gt;Acute Myeloid Leukemia (AML) is a type of blood cancer requiring specialized multidisciplinary treatment and evaluation through various diagnostic tests.&lt;SEP&gt;Acute myeloid leukemia (AML) is a blood cancer that begins in the bone marrow's stem cells and presents with various adult subtypes.&lt;SEP&gt;Acute myeloid leukemia (AML) is a type of blood cancer that starts in the bone marrow stem cells and leads to a buildup of immature myeloblasts.&lt;SEP&gt;Acute myeloid leukemia (AML) is an aggressive cancer of the blood and bone marrow involving excessive immature white blood cells, representing a rare serious complication of cancer therapy.</data>
      <data key="d3">chunk-9fa573748870dc50a98a935843997c68&lt;SEP&gt;chunk-29c9b8b5fd2cd967c48522af79a9598f&lt;SEP&gt;chunk-db4e8318949a3fda5683c53985c6af05&lt;SEP&gt;chunk-06f823f3a91fcbc32c62fac3c6347715&lt;SEP&gt;chunk-d73843c009e523101e1464a2b28bc144&lt;SEP&gt;chunk-8333423c91919d7adde114b8286cca7e&lt;SEP&gt;chunk-d9882c04dd7676c6433074e5e393c72e&lt;SEP&gt;chunk-bd7ea43a74059d6781866faec437f19a&lt;SEP&gt;chunk-8b44f0b4da13a804cd1dfb917ac7e981&lt;SEP&gt;chunk-97836a515d346931beb424ae40a89877&lt;SEP&gt;chunk-b63f0a9aec8d42c8426ded05a9bf92b4&lt;SEP&gt;chunk-0786666c65b5bf00705439d5cb60d5a0&lt;SEP&gt;chunk-82c7205fc2067a4d00e43fd22276db22&lt;SEP&gt;chunk-2dc31077c053f79ff82959575d335956</data>
    </node>
    <node id="Squamous Cell Carcinoma Of The Mouth">
      <data key="d0">Squamous Cell Carcinoma Of The Mouth</data>
      <data key="d1">category</data>
      <data key="d2">A form of mouth cancer originating in the epithelial squamous cells lining the inside of the mouth and lip mucosa, staged using TNM criteria.</data>
      <data key="d3">chunk-d9882c04dd7676c6433074e5e393c72e</data>
    </node>
    <node id="Acute Promyelocytic Leukemia">
      <data key="d0">Acute Promyelocytic Leukemia</data>
      <data key="d1">category</data>
      <data key="d2">A specific subtype of acute myeloid leukemia (AML) characterized by distinct genetic and clinical features.&lt;SEP&gt;Acute Promyelocytic Leukemia (APL) is a rare subtype of Acute Myeloid Leukemia defined by the presence of the abnormal fusion gene PML::RARA.&lt;SEP&gt;Acute promyelocytic leukemia (APL) is a rare subtype of AML defined by the presence of the abnormal PML::RARA fusion gene.</data>
      <data key="d3">chunk-d9882c04dd7676c6433074e5e393c72e&lt;SEP&gt;chunk-bd7ea43a74059d6781866faec437f19a&lt;SEP&gt;chunk-2dc31077c053f79ff82959575d335956</data>
    </node>
    <node id="Blastic Plasmacytoid Dendritic Cell Neoplasm">
      <data key="d0">Blastic Plasmacytoid Dendritic Cell Neoplasm</data>
      <data key="d1">category</data>
      <data key="d2">A rare hematologic neoplasm discussed alongside acute myeloid leukemia subtypes.&lt;SEP&gt;A rare subtype of leukemia related to AML, often prompting lymph node or skin lesion biopsies for confirmation.&lt;SEP&gt;Blastic Plasmacytoid Dendritic Cell Neoplasm (BPDCN) is a specific subtype category of AML that may necessitate lymph node or skin lesion biopsies.&lt;SEP&gt;Blastic Plasmacytoid Dendritic Cell Neoplasm (BPDCN) is an aggressive cancer subtype related to AML that can manifest in blood, bone marrow, lymph nodes, or skin.&lt;SEP&gt;Blastic plasmacytoid dendritic cell neoplasm (BPDCN) is an aggressive subtype or related hematologic neoplasm affecting the blood, bone marrow, lymph nodes, and skin.</data>
      <data key="d3">chunk-d73843c009e523101e1464a2b28bc144&lt;SEP&gt;chunk-d9882c04dd7676c6433074e5e393c72e&lt;SEP&gt;chunk-bd7ea43a74059d6781866faec437f19a&lt;SEP&gt;chunk-0786666c65b5bf00705439d5cb60d5a0&lt;SEP&gt;chunk-2dc31077c053f79ff82959575d335956</data>
    </node>
    <node id="Head And Neck Cancers">
      <data key="d0">Head And Neck Cancers</data>
      <data key="d1">category</data>
      <data key="d2">A broader category of cancers that encompasses cancers of the throat and oropharynx.&lt;SEP&gt;A category of cancers affecting the head and neck region, often spreading to regional cervical lymph nodes.&lt;SEP&gt;A group of cancers that arise in the head or neck region of the body, whose treatment is determined by tumor location.</data>
      <data key="d3">chunk-d9882c04dd7676c6433074e5e393c72e&lt;SEP&gt;chunk-c622c677deca24391324ecd5f16ce4a3&lt;SEP&gt;chunk-711bee9440e11d7c737bc4a49b880910</data>
    </node>
    <node id="Resectable Tumor">
      <data key="d0">Resectable Tumor</data>
      <data key="d1">category</data>
      <data key="d2">A surgical classification denoting a tumor that can be completely removed through surgical intervention.&lt;SEP&gt;A tumor classification indicating that the cancerous mass can be completely removed through surgical intervention.&lt;SEP&gt;A tumor classification indicating the malignant growth can be safely and entirely excised through surgical intervention.</data>
      <data key="d3">chunk-d9882c04dd7676c6433074e5e393c72e&lt;SEP&gt;chunk-5d8e20e6004dd43ae0f68185383b594d&lt;SEP&gt;chunk-3f05c8ea6f7c7b4ba1fb0ff1c1733980</data>
    </node>
    <node id="Unresectable Tumor">
      <data key="d0">Unresectable Tumor</data>
      <data key="d1">category</data>
      <data key="d2">A surgical classification indicating a tumor that cannot be safely or completely removed surgically, often due to involvement of major blood vessels or vital structures.&lt;SEP&gt;A tumor classification indicating that the mass cannot be safely or completely removed surgically, often due to involvement of critical veins, arteries, or structures.&lt;SEP&gt;A tumor classification indicating the growth cannot be completely removed surgically due to involvement of critical structures such as blood vessels.</data>
      <data key="d3">chunk-d9882c04dd7676c6433074e5e393c72e&lt;SEP&gt;chunk-5d8e20e6004dd43ae0f68185383b594d&lt;SEP&gt;chunk-3f05c8ea6f7c7b4ba1fb0ff1c1733980</data>
    </node>
    <node id="Extranodal Extension">
      <data key="d0">Extranodal Extension</data>
      <data key="d1">category</data>
      <data key="d2">A condition where malignant tumor cells penetrate the capsule of a lymph node and invade the surrounding soft tissues.</data>
      <data key="d3">chunk-d9882c04dd7676c6433074e5e393c72e</data>
    </node>
    <node id="Blood">
      <data key="d0">Blood</data>
      <data key="d1">category</data>
      <data key="d2">A specialized biological tissue composed of plasma, red blood cells, white blood cells, and platelets that transports oxygen, nutrients, and waste while supporting immunity.</data>
      <data key="d3">chunk-d9882c04dd7676c6433074e5e393c72e</data>
    </node>
    <node id="Myeloid Blasts">
      <data key="d0">Myeloid Blasts</data>
      <data key="d1">category</data>
      <data key="d2">Immature white blood cells produced in the bone marrow whose maturation arrest leads to acute myeloid leukemia.&lt;SEP&gt;Immature white blood cells whose abnormal presence in the bone marrow or blood (typically 20% or more) serves as the primary diagnostic criterion for AML.&lt;SEP&gt;Myeloid blasts are immature white blood cells that normally mature into granulocytes but accumulate abnormally in bone marrow and blood during AML.</data>
      <data key="d3">chunk-d9882c04dd7676c6433074e5e393c72e&lt;SEP&gt;chunk-ae28e3852f4a9f229250fc19eb39036b&lt;SEP&gt;chunk-2dc31077c053f79ff82959575d335956</data>
    </node>
    <node id="Diagnostic Tests For AML">
      <data key="d0">Diagnostic Tests For AML</data>
      <data key="d1">category</data>
      <data key="d2">A group of clinical procedures and laboratory assessments, including blood tests, bone marrow aspirate and biopsy, and genetic testing, used to detect, confirm, and evaluate AML.</data>
      <data key="d3">chunk-bd7ea43a74059d6781866faec437f19a</data>
    </node>
    <node id="Hematopoietic Stem Cells">
      <data key="d0">Hematopoietic Stem Cells</data>
      <data key="d1">category</data>
      <data key="d2">Early blood-forming cells located in bone marrow that continuously self-renew and differentiate into mature blood cells.&lt;SEP&gt;Hematopoietic stem cells are early blood-forming cells in the bone marrow capable of self-renewal and differentiating into all types of blood cells.&lt;SEP&gt;Hematopoietic stem cells are immature blood-forming precursor cells situated in bone marrow that give rise to all specialized blood cell lineages.&lt;SEP&gt;Immature blood-forming cells originating in bone marrow capable of developing into red blood cells, white blood cells, and platelets.&lt;SEP&gt;Primitive blood-forming stem cells residing within the bone marrow that differentiate into all mature blood cell lineages.</data>
      <data key="d3">chunk-2dc31077c053f79ff82959575d335956&lt;SEP&gt;chunk-81c87ec3c2682da4d531da53f6e5e18c&lt;SEP&gt;chunk-06f823f3a91fcbc32c62fac3c6347715&lt;SEP&gt;chunk-bd7ea43a74059d6781866faec437f19a&lt;SEP&gt;chunk-a65ba958750476cc543741efe815c7c4</data>
    </node>
    <node id="Myeloblasts">
      <data key="d0">Myeloblasts</data>
      <data key="d1">category</data>
      <data key="d2">Immature blood cells formed from myeloid progenitor cells that develop into non-lymphoid blood cells.&lt;SEP&gt;Immature blood cells formed from myeloid progenitor cells, referred to alongside lymphoblasts as blasts in leukemia.&lt;SEP&gt;Immature white blood cells that normally mature into infection-fighting granulocytes, but proliferate abnormally as leukemia blasts in AML.&lt;SEP&gt;Myeloblasts, or myeloid blasts, are immature white blood cells that build up in the bone marrow and blood in patients with AML instead of maturing.</data>
      <data key="d3">chunk-bd7ea43a74059d6781866faec437f19a&lt;SEP&gt;chunk-7606b44d6a30ad0519bc4c10785de79a&lt;SEP&gt;chunk-a99a89bec88823cedf4c1f0cd1a78e81&lt;SEP&gt;chunk-97836a515d346931beb424ae40a89877</data>
    </node>
    <node id="Bone Marrow Aspirate And Biopsy">
      <data key="d0">Bone Marrow Aspirate And Biopsy</data>
      <data key="d1">event</data>
      <data key="d2">A bone marrow aspirate and biopsy is a diagnostic medical procedure where samples of solid bone and liquid marrow are collected to test for leukemia and genetic abnormalities.&lt;SEP&gt;A core diagnostic procedure used to extract bone marrow fluid and tissue to evaluate blast percentage, biomarker status, and genetic mutations.&lt;SEP&gt;A diagnostic procedure performed to sample bone marrow for AML biomarker assessment and genetic testing.&lt;SEP&gt;A diagnostic procedure used to extract and examine bone marrow cells to guide AML diagnosis and treatment decisions.&lt;SEP&gt;Bedside medical procedures where liquid bone marrow and a small bone specimen are extracted, typically from the hip, to diagnose and analyze AML.&lt;SEP&gt;Diagnostic clinical procedures used to extract and examine bone marrow tissue for blast percentage, chromosome abnormalities, and biomarker mutations.</data>
      <data key="d3">chunk-ae28e3852f4a9f229250fc19eb39036b&lt;SEP&gt;chunk-8333423c91919d7adde114b8286cca7e&lt;SEP&gt;chunk-bd7ea43a74059d6781866faec437f19a&lt;SEP&gt;chunk-69e63736c94b8b08a565c3d8679d3b57&lt;SEP&gt;chunk-0786666c65b5bf00705439d5cb60d5a0&lt;SEP&gt;chunk-b63f0a9aec8d42c8426ded05a9bf92b4</data>
    </node>
    <node id="Complete Blood Count">
      <data key="d0">Complete Blood Count</data>
      <data key="d1">category</data>
      <data key="d2">A complete blood count (CBC) is a general diagnostic blood test that measures white blood cells, red blood cells, and platelets.&lt;SEP&gt;A complete blood count is a diagnostic laboratory procedure that measures levels of red blood cells, white blood cells, and platelets.&lt;SEP&gt;A core diagnostic laboratory test that measures red blood cells, white blood cells, platelets, hemoglobin, and blast cells to assess health and disease state.&lt;SEP&gt;A diagnostic blood test measuring levels of red blood cells, white blood cells, and platelets to evaluate patient health and organ function during cancer assessment.&lt;SEP&gt;A routine blood test that measures red blood cells, white blood cells, and platelets to evaluate general health and treatment readiness.&lt;SEP&gt;A routine laboratory blood test measuring cellular components including RBCs, WBCs, and platelets to evaluate hematologic health and disease.&lt;SEP&gt;A standard blood test (CBC) that measures levels of red blood cells, white blood cells, and platelets to check overall health.&lt;SEP&gt;A standard blood test measuring white blood cells, red blood cells, and platelets to evaluate overall health and detect underlying complications.&lt;SEP&gt;A standard blood test that measures red blood cells, white blood cells, and platelets to evaluate general health prior to treatment.&lt;SEP&gt;A standard diagnostic blood test (CBC) that measures levels of red blood cells, white blood cells, and platelets, often paired with a differential to identify blasts.&lt;SEP&gt;A standard laboratory blood test (CBC) recommended to assess blood health and aid treatment planning.&lt;SEP&gt;A standard laboratory blood test category that measures components including hemoglobin, platelets, absolute neutrophil count, and white blood cell differential.&lt;SEP&gt;A standard routine blood test (CBC) recommended during initial medical evaluations for colorectal cancer.</data>
      <data key="d3">chunk-0bd86bf8fc82f14fa5f7f51d924514e7&lt;SEP&gt;chunk-ae28e3852f4a9f229250fc19eb39036b&lt;SEP&gt;chunk-9fa573748870dc50a98a935843997c68&lt;SEP&gt;chunk-85e75e869fcfcb7c5431dbcdd532137f&lt;SEP&gt;chunk-27b3a0f53b4be1d525497f87555d7a06&lt;SEP&gt;chunk-68217ea9e5382d1756c99b5152ea98db&lt;SEP&gt;chunk-fba176235a4410ba8723447134c92579&lt;SEP&gt;chunk-d0f15711706bc171fed17a7fab91b4b6&lt;SEP&gt;chunk-bd7ea43a74059d6781866faec437f19a&lt;SEP&gt;chunk-ee254e84e63bd35682ed56c41cef9247&lt;SEP&gt;chunk-69e63736c94b8b08a565c3d8679d3b57&lt;SEP&gt;chunk-925a474b4538dda470bfd817f9d9a17d&lt;SEP&gt;chunk-3fbf2f6a3c150687a59f814d94f1d150</data>
    </node>
    <node id="AML Specialist">
      <data key="d0">AML Specialist</data>
      <data key="d1">person</data>
      <data key="d2">A medical oncologist or hematologist specializing in the diagnosis and management of acute myeloid leukemia.&lt;SEP&gt;A physician specializing in hematologic malignancies and specifically trained in diagnosing and treating acute myeloid leukemia.&lt;SEP&gt;An AML specialist is a medical professional with expertise in diagnosing, managing, and treating acute myeloid leukemia.</data>
      <data key="d3">chunk-bd7ea43a74059d6781866faec437f19a&lt;SEP&gt;chunk-ae28e3852f4a9f229250fc19eb39036b&lt;SEP&gt;chunk-2dc31077c053f79ff82959575d335956</data>
    </node>
    <node id="AML">
      <data key="d0">AML</data>
      <data key="d1">category</data>
      <data key="d2">Acute Myeloid Leukemia (AML) is a cancer of the blood and bone marrow characterized by abnormal blood cell production, requiring comprehensive diagnostic testing, monitoring, and treatment.&lt;SEP&gt;Acute Myeloid Leukemia (AML) is a type of cancer characterized by leukemic blasts, for which chemotherapy is the standard of care.&lt;SEP&gt;Acute Myeloid Leukemia, a cancer originating in the bone marrow characterized by the abnormal proliferation of myeloid blasts throughout the blood and bones.</data>
      <data key="d3">chunk-69e63736c94b8b08a565c3d8679d3b57&lt;SEP&gt;chunk-53afdc6713818c4177b64a712ecce11b&lt;SEP&gt;chunk-ae28e3852f4a9f229250fc19eb39036b</data>
    </node>
    <node id="Comprehensive Metabolic Panel">
      <data key="d0">Comprehensive Metabolic Panel</data>
      <data key="d1">category</data>
      <data key="d2">A blood chemistry profile evaluating the functional status of vital organs such as the kidneys and liver.&lt;SEP&gt;A blood test assessing chemicals, proteins, and substances in the blood to evaluate organ function such as the kidneys and liver.&lt;SEP&gt;A category of blood tests that evaluates kidney and liver function, electrolytes, creatinine, and blood urea nitrogen levels.&lt;SEP&gt;A comprehensive metabolic panel (CMP) is a blood test measuring chemicals and proteins to evaluate liver and kidney function, assisting in cancer treatment planning.&lt;SEP&gt;A comprehensive metabolic panel (chemistry profile) is a blood test evaluating how well the liver, kidneys, and other organs function.&lt;SEP&gt;A comprehensive metabolic panel is a blood screening test measuring up to 14 chemicals to evaluate kidney and liver function.&lt;SEP&gt;A comprehensive metabolic panel is a diagnostic blood testing procedure that measures substances related to kidney function, liver health, and calcium levels.&lt;SEP&gt;A diagnostic blood panel evaluating blood sugar, calcium, electrolytes, and the function of the liver and kidneys.&lt;SEP&gt;A diagnostic blood panel measuring up to 14 chemicals in the blood to evaluate kidney and liver function.&lt;SEP&gt;A diagnostic blood test (CMP) that evaluates 14 substances in blood plasma to assess liver and kidney function.&lt;SEP&gt;A diagnostic blood test that evaluates kidney and liver function, blood urea nitrogen, creatinine, and electrolyte balance.&lt;SEP&gt;A routine blood panel (CMP) used in the AML workup to check organ function, particularly of the liver and kidneys, alongside electrolyte balance.</data>
      <data key="d3">chunk-0bd86bf8fc82f14fa5f7f51d924514e7&lt;SEP&gt;chunk-ae28e3852f4a9f229250fc19eb39036b&lt;SEP&gt;chunk-9fa573748870dc50a98a935843997c68&lt;SEP&gt;chunk-85e75e869fcfcb7c5431dbcdd532137f&lt;SEP&gt;chunk-68217ea9e5382d1756c99b5152ea98db&lt;SEP&gt;chunk-d0f15711706bc171fed17a7fab91b4b6&lt;SEP&gt;chunk-dea00cf063e8831db4919330d94b1f2a&lt;SEP&gt;chunk-69e63736c94b8b08a565c3d8679d3b57&lt;SEP&gt;chunk-925a474b4538dda470bfd817f9d9a17d&lt;SEP&gt;chunk-3fbf2f6a3c150687a59f814d94f1d150&lt;SEP&gt;chunk-67015f3916810c4378b2ed269cc27f29&lt;SEP&gt;chunk-717174ace5855cc823d51c46c9a70648</data>
    </node>
    <node id="Lumbar Puncture">
      <data key="d0">Lumbar Puncture</data>
      <data key="d1">event</data>
      <data key="d2">A diagnostic procedure performed to examine cerebrospinal fluid, commonly utilized in leukemia staging and evaluation.&lt;SEP&gt;A lumbar puncture, or spinal tap, is a diagnostic procedure performed to sample cerebrospinal fluid from the spinal column to check for malignant cells.&lt;SEP&gt;A lumbar puncture, or spinal tap, is a medical procedure in which a needle is inserted into the lower back to extract spinal fluid to check for leukemia cells.&lt;SEP&gt;A medical procedure performed to evaluate cerebrospinal fluid, utilized when central nervous system involvement is suspected.&lt;SEP&gt;A medical procedure, also known as a spinal tap, where a needle is inserted into the lower back to sample spinal fluid to check for leukemia cells.&lt;SEP&gt;A procedure that removes cerebrospinal fluid to examine it for the presence of cancer cells in primary CNS lymphoma patients.&lt;SEP&gt;A specialized diagnostic procedure included in AML workups to check for leukemic involvement in the central nervous system.</data>
      <data key="d3">chunk-ae28e3852f4a9f229250fc19eb39036b&lt;SEP&gt;chunk-29c9b8b5fd2cd967c48522af79a9598f&lt;SEP&gt;chunk-fba176235a4410ba8723447134c92579&lt;SEP&gt;chunk-d0f15711706bc171fed17a7fab91b4b6&lt;SEP&gt;chunk-69e63736c94b8b08a565c3d8679d3b57&lt;SEP&gt;chunk-97836a515d346931beb424ae40a89877&lt;SEP&gt;chunk-82c7205fc2067a4d00e43fd22276db22</data>
    </node>
    <node id="Liver Function Tests">
      <data key="d0">Liver Function Tests</data>
      <data key="d1">category</data>
      <data key="d2">A clinical testing category that assesses liver health and bile duct patency by measuring chemicals made or processed by the liver.&lt;SEP&gt;A group of blood tests (LFTs) measuring liver-produced chemicals to determine liver health or detect cancer spread.&lt;SEP&gt;A set of diagnostic blood tests assessing liver health by measuring chemicals made or processed by the liver.&lt;SEP&gt;Blood tests that evaluate enzymes and chemicals synthesized or processed by the liver to detect organ impairment or metastatic spread.&lt;SEP&gt;Blood tests that measure liver enzymes to detect liver damage or possible cancer spread, often performed with a blood chemistry profile.</data>
      <data key="d3">chunk-0bd86bf8fc82f14fa5f7f51d924514e7&lt;SEP&gt;chunk-27b3a0f53b4be1d525497f87555d7a06&lt;SEP&gt;chunk-9fa573748870dc50a98a935843997c68&lt;SEP&gt;chunk-96238b4b361e393ff452a09d1ce26154&lt;SEP&gt;chunk-69e63736c94b8b08a565c3d8679d3b57</data>
    </node>
    <node id="Blood Clotting Tests">
      <data key="d0">Blood Clotting Tests</data>
      <data key="d1">event</data>
      <data key="d2">A series of laboratory diagnostic tests designed to evaluate the blood's ability to form clots and identify bleeding risks in AML patients.&lt;SEP&gt;Laboratory tests that evaluate the coagulation system to assess bleeding and clotting risks during AML diagnosis and treatment.</data>
      <data key="d3">chunk-69e63736c94b8b08a565c3d8679d3b57&lt;SEP&gt;chunk-ae28e3852f4a9f229250fc19eb39036b</data>
    </node>
    <node id="Human Leukocyte Antigen Typing">
      <data key="d0">Human Leukocyte Antigen Typing</data>
      <data key="d1">event</data>
      <data key="d2">A specialized genetic and immunological test performed to match patients with potential donors for bone marrow or stem cell transplants.&lt;SEP&gt;A specialized genetic blood test (HLA typing) used to identify matching donors for potential stem cell or bone marrow transplantation.</data>
      <data key="d3">chunk-69e63736c94b8b08a565c3d8679d3b57&lt;SEP&gt;chunk-ae28e3852f4a9f229250fc19eb39036b</data>
    </node>
    <node id="Brain CT Without Contrast">
      <data key="d0">Brain CT Without Contrast</data>
      <data key="d1">event</data>
      <data key="d2">A non-invasive computed tomography brain scan conducted when bleeding in the central nervous system is suspected.</data>
      <data key="d3">chunk-69e63736c94b8b08a565c3d8679d3b57</data>
    </node>
    <node id="Brain MRI With Contrast">
      <data key="d0">Brain MRI With Contrast</data>
      <data key="d1">event</data>
      <data key="d2">A contrast-enhanced magnetic resonance imaging scan of the brain performed to evaluate suspected leukemic meningitis.</data>
      <data key="d3">chunk-69e63736c94b8b08a565c3d8679d3b57</data>
    </node>
    <node id="Heart Tests">
      <data key="d0">Heart Tests</data>
      <data key="d1">category</data>
      <data key="d2">A category of cardiac evaluations conducted to evaluate heart performance and monitor for potential treatment-induced side effects.&lt;SEP&gt;A group of diagnostic evaluations used to determine cardiac function and detect side effects before and during cancer treatments.&lt;SEP&gt;Cardiovascular examinations performed as part of the AML diagnostic workup to evaluate heart function before leukemia treatment begins.&lt;SEP&gt;Diagnostic cardiovascular examinations performed to evaluate cardiac health and ensure the heart can tolerate leukemia therapy.</data>
      <data key="d3">chunk-29c9b8b5fd2cd967c48522af79a9598f&lt;SEP&gt;chunk-69e63736c94b8b08a565c3d8679d3b57&lt;SEP&gt;chunk-4724f6acaaa7931560b29614efc2927f&lt;SEP&gt;chunk-ae28e3852f4a9f229250fc19eb39036b</data>
    </node>
    <node id="Genetic Testing">
      <data key="d0">Genetic Testing</data>
      <data key="d1">event</data>
      <data key="d2">A category of testing used to evaluate inherited genetic mutations received from birth parents, distinct from tumor-only somatic testing.&lt;SEP&gt;A diagnostic blood analysis recommended for all individuals diagnosed with ovarian cancer to detect inherited germline BRCA mutations.&lt;SEP&gt;A diagnostic procedure assessing hereditary and familial cancer risks and genetic alterations in patients with ovarian cancer.&lt;SEP&gt;A diagnostic procedure encompassing hereditary germline testing and somatic tumor testing to detect harmful mutations in DNA.&lt;SEP&gt;A diagnostic procedure performed on blood, saliva, cheek swab, or tumor tissue to identify germline or somatic genetic mutations.&lt;SEP&gt;A diagnostic procedure performed to detect mutations and genetic alterations associated with specific cancers and tumors.&lt;SEP&gt;A diagnostic procedure used to find abnormal gene mutations, distinguishing between inherited germline mutations and acquired somatic mutations.&lt;SEP&gt;A medical diagnostic test performed on individuals or relatives to identify inherited mutations and risk factors for diseases such as cancer.&lt;SEP&gt;Diagnostic tests that analyze genes to guide medical decisions and determine tailored cancer treatment options.&lt;SEP&gt;Genetic testing is a diagnostic medical procedure used to identify specific inherited or acquired gene mutations associated with cancer risk.&lt;SEP&gt;Molecular analysis performed on biopsy tissue samples to assist in diagnosing thyroid cancer types.&lt;SEP&gt;Molecular and genetic laboratory analyses performed on bone marrow or blood to detect mutations and risk factors in leukemia and family history.&lt;SEP&gt;Specialized medical laboratory tests that detect inherited gene mutations to evaluate hereditary disease risks and guide targeted cancer therapies.</data>
      <data key="d3">chunk-77ac570b4029abb181150e0d0975aefb&lt;SEP&gt;chunk-da0bfe00946dcdff3a8a6fb3d73ce6e1&lt;SEP&gt;chunk-44a870810cef881997b741c32ec368fe&lt;SEP&gt;chunk-b3958b5f7df8a8fc2661705e37dc1e06&lt;SEP&gt;chunk-c6d28b36fe82792dfb86e98ef76b3b04&lt;SEP&gt;chunk-0fb70c1c798caae12ac2d64e61bcbad4&lt;SEP&gt;chunk-b8a273f96e02707e2e87fc43353ed57f&lt;SEP&gt;chunk-ae40f53e9d867c255e1e6901f5cfb058&lt;SEP&gt;chunk-69e63736c94b8b08a565c3d8679d3b57&lt;SEP&gt;chunk-965e5a6bad03f2129a98be4373f99176&lt;SEP&gt;chunk-5fdcf47f3da06d3e0213112c96eb93d4&lt;SEP&gt;chunk-b4da30dee72e228147daa825e4f5be72&lt;SEP&gt;chunk-6b02315423350f3598288e189fbcb8ae</data>
    </node>
    <node id="Central Nervous System Bleed">
      <data key="d0">Central Nervous System Bleed</data>
      <data key="d1">category</data>
      <data key="d2">A serious medical complication involving intracranial or spinal hemorrhage that necessitates emergency brain imaging.</data>
      <data key="d3">chunk-69e63736c94b8b08a565c3d8679d3b57</data>
    </node>
    <node id="Leukemic Meningitis">
      <data key="d0">Leukemic Meningitis</data>
      <data key="d1">category</data>
      <data key="d2">A complication characterized by the spread of leukemic cells into the meninges and central nervous system, evaluated by brain MRI.&lt;SEP&gt;A complication of leukemia involving infiltration of the central nervous system membranes, requiring brain MRI assessment.&lt;SEP&gt;A medical complication involving swelling and leukemic infiltration of the membranes surrounding the brain.&lt;SEP&gt;Leukemic meningitis is a neurological complication where leukemia cells infiltrate and cause swelling in the outer lining of the brain.</data>
      <data key="d3">chunk-db4e8318949a3fda5683c53985c6af05&lt;SEP&gt;chunk-69e63736c94b8b08a565c3d8679d3b57&lt;SEP&gt;chunk-4724f6acaaa7931560b29614efc2927f&lt;SEP&gt;chunk-ae28e3852f4a9f229250fc19eb39036b</data>
    </node>
    <node id="Extramedullary Leukemia">
      <data key="d0">Extramedullary Leukemia</data>
      <data key="d1">category</data>
      <data key="d2">A clinical presentation where acute myeloid leukemia cells accumulate outside the bone marrow and peripheral blood.&lt;SEP&gt;A condition where leukemic cells proliferate outside the bone marrow and peripheral blood, assessed via PET/CT imaging.</data>
      <data key="d3">chunk-69e63736c94b8b08a565c3d8679d3b57&lt;SEP&gt;chunk-ae28e3852f4a9f229250fc19eb39036b</data>
    </node>
    <node id="Leukemia">
      <data key="d0">Leukemia</data>
      <data key="d1">category</data>
      <data key="d2">A blood cancer that originates in the bone marrow and can disseminate to lymph nodes, liver, spleen, skin, and central nervous system.&lt;SEP&gt;Leukemia is a general category of blood and bone marrow cancers that impairs normal blood cell production and clotting mechanisms.</data>
      <data key="d3">chunk-d73843c009e523101e1464a2b28bc144&lt;SEP&gt;chunk-4724f6acaaa7931560b29614efc2927f</data>
    </node>
    <node id="Hematopoietic Cell Transplant">
      <data key="d0">Hematopoietic Cell Transplant</data>
      <data key="d1">category</data>
      <data key="d2">A therapeutic procedure and treatment category utilized in managing acute myeloid leukemia.&lt;SEP&gt;An allogeneic hematopoietic cell transplant is a medical treatment event involving donor cell infusion that requires close HLA matching between donor and recipient.&lt;SEP&gt;Hematopoietic cell transplant is a specialized medical treatment option used in the management and treatment of AML.</data>
      <data key="d3">chunk-29c9b8b5fd2cd967c48522af79a9598f&lt;SEP&gt;chunk-d73843c009e523101e1464a2b28bc144&lt;SEP&gt;chunk-97836a515d346931beb424ae40a89877</data>
    </node>
    <node id="HLA Typing">
      <data key="d0">HLA Typing</data>
      <data key="d1">event</data>
      <data key="d2">A diagnostic blood test category that identifies a patient's human leukocyte antigen markers to evaluate donor compatibility for transplants.&lt;SEP&gt;HLA typing is a diagnostic testing procedure performed to identify tissue antigens and establish compatibility between a patient and a potential donor prior to transplantation.</data>
      <data key="d3">chunk-d73843c009e523101e1464a2b28bc144&lt;SEP&gt;chunk-9fa573748870dc50a98a935843997c68</data>
    </node>
    <node id="Bone Marrow Aspirate">
      <data key="d0">Bone Marrow Aspirate</data>
      <data key="d1">event</data>
      <data key="d2">A bedside procedure using a hollow needle to draw liquid bone marrow from the hip bone for cytological and laboratory testing.&lt;SEP&gt;A bone marrow aspirate is a bedside diagnostic procedure in which liquid bone marrow is drawn with a needle to assess cellular composition.&lt;SEP&gt;A diagnostic procedure using a hollow needle and syringe to extract liquid and cells from the bone marrow, typically from the pelvis.</data>
      <data key="d3">chunk-30c0bb66b1a2f93e89f5342ab1077451&lt;SEP&gt;chunk-0786666c65b5bf00705439d5cb60d5a0&lt;SEP&gt;chunk-d73843c009e523101e1464a2b28bc144</data>
    </node>
    <node id="Bone Marrow Biopsy">
      <data key="d0">Bone Marrow Biopsy</data>
      <data key="d1">event</data>
      <data key="d2">A bedside procedure using a wide needle to extract a small core of solid bone and marrow tissue from the pelvis for pathological analysis.&lt;SEP&gt;A bone marrow aspirate and biopsy is a diagnostic procedure that extracts bone marrow tissue and cells to confirm an AML diagnosis and evaluate blast percentage.&lt;SEP&gt;A bone marrow biopsy is a diagnostic procedure using a specialized needle to remove a small piece of bone marrow for histopathological evaluation.&lt;SEP&gt;A clinical procedure that extracts a core sample of bone marrow from the hip bone to evaluate disease status and confirm cancer diagnoses.&lt;SEP&gt;A diagnostic procedure in which a needle is used to extract bone marrow to check whether lymphoma has spread to the bones.&lt;SEP&gt;A procedure using a wider needle to remove a core solid sample of bone marrow tissue, often performed alongside an aspirate.</data>
      <data key="d3">chunk-d73843c009e523101e1464a2b28bc144&lt;SEP&gt;chunk-d0f15711706bc171fed17a7fab91b4b6&lt;SEP&gt;chunk-30c0bb66b1a2f93e89f5342ab1077451&lt;SEP&gt;chunk-0786666c65b5bf00705439d5cb60d5a0&lt;SEP&gt;chunk-97836a515d346931beb424ae40a89877&lt;SEP&gt;chunk-717174ace5855cc823d51c46c9a70648</data>
    </node>
    <node id="Coagulation Panel">
      <data key="d0">Coagulation Panel</data>
      <data key="d1">event</data>
      <data key="d2">A group of diagnostic blood clotting tests, also referred to as a disseminated intravascular coagulation (DIC) panel, that checks coagulation factors.&lt;SEP&gt;A standardized group of blood clotting tests, also referred to as a DIC panel, used to assess coagulation factors and detect clotting dysfunction.</data>
      <data key="d3">chunk-d73843c009e523101e1464a2b28bc144&lt;SEP&gt;chunk-9fa573748870dc50a98a935843997c68</data>
    </node>
    <node id="Flow Cytometry">
      <data key="d0">Flow Cytometry</data>
      <data key="d1">category</data>
      <data key="d2">A laboratory method using light-sensitive dyes and light beams to count, analyze, and detect specific markers on blood and bone marrow cells.&lt;SEP&gt;A specialized laboratory diagnostic procedure used to analyze cellular surface proteins and confirm CLL.&lt;SEP&gt;A specialized laboratory procedure that utilizes dyes and light beams to count, analyze, and detect specific surface markers on cells from blood or bone marrow aspirates.&lt;SEP&gt;A specialized laboratory testing method used to detect patterns of proteins on cell surfaces to determine their immunophenotype for cancer diagnosis.&lt;SEP&gt;Flow cytometry is a laboratory diagnostic method used on blood or bone marrow aspirate samples to detect subtle cellular differences and identify immune cell markers.</data>
      <data key="d3">chunk-d73843c009e523101e1464a2b28bc144&lt;SEP&gt;chunk-0786666c65b5bf00705439d5cb60d5a0&lt;SEP&gt;chunk-b63f0a9aec8d42c8426ded05a9bf92b4&lt;SEP&gt;chunk-098a64d7118fc8e1eb3e91ba0124258c&lt;SEP&gt;chunk-717174ace5855cc823d51c46c9a70648</data>
    </node>
    <node id="Skin Lesion Biopsy">
      <data key="d0">Skin Lesion Biopsy</data>
      <data key="d1">event</data>
      <data key="d2">A diagnostic procedure performed to test skin lesion tissue in cases of suspected BPDCN.&lt;SEP&gt;A surgical or punch removal of skin lesion tissue to test for specific AML variants such as blastic plasmacytoid dendritic cell neoplasm.</data>
      <data key="d3">chunk-0786666c65b5bf00705439d5cb60d5a0&lt;SEP&gt;chunk-d73843c009e523101e1464a2b28bc144</data>
    </node>
    <node id="Coagulopathy">
      <data key="d0">Coagulopathy</data>
      <data key="d1">category</data>
      <data key="d2">A bleeding or clotting disorder resulting from an impaired coagulation process, commonly observed in leukemia patients.&lt;SEP&gt;A category of blood clotting disorder characterized by impaired coagulation, bleeding, bruising, or clot formation, commonly found in leukemia.</data>
      <data key="d3">chunk-d73843c009e523101e1464a2b28bc144&lt;SEP&gt;chunk-9fa573748870dc50a98a935843997c68</data>
    </node>
    <node id="Karnofsky Performance Status">
      <data key="d0">Karnofsky Performance Status</data>
      <data key="d1">category</data>
      <data key="d2">A clinical scale and scoring system used to assess a patient's functional capacity and ability to perform daily activities.&lt;SEP&gt;A clinical scoring system (KPS) used alongside ECOG to evaluate a patient's overall functional ability and guide cancer treatment decisions.&lt;SEP&gt;A standardized clinical rating scale used to quantify a patient's general well-being and ability to carry out everyday activities.&lt;SEP&gt;A standardized medical scoring scale utilized to quantify a patient's functional abilities, activity level, and general fitness.</data>
      <data key="d3">chunk-3fbf2f6a3c150687a59f814d94f1d150&lt;SEP&gt;chunk-0786666c65b5bf00705439d5cb60d5a0&lt;SEP&gt;chunk-d73843c009e523101e1464a2b28bc144&lt;SEP&gt;chunk-9fa573748870dc50a98a935843997c68</data>
    </node>
    <node id="Disseminated Intravascular Coagulation">
      <data key="d0">Disseminated Intravascular Coagulation</data>
      <data key="d1">category</data>
      <data key="d2">A severe clotting disorder evaluated through coagulation panel testing in patients with leukemia.</data>
      <data key="d3">chunk-d73843c009e523101e1464a2b28bc144</data>
    </node>
    <node id="Immunohistochemistry">
      <data key="d0">Immunohistochemistry</data>
      <data key="d1">category</data>
      <data key="d2">A laboratory staining technique (IHC) utilizing chemical markers to visualize specific proteins in cancer or immune cells under a microscope.&lt;SEP&gt;A laboratory staining technique using chemical markers and microscopy to examine the immunophenotype of cells in tissue biopsies.&lt;SEP&gt;A laboratory staining technique using chemical markers to detect estrogen receptors, progesterone receptors, and HER2 protein levels under a microscope.&lt;SEP&gt;Immunohistochemistry (IHC) is a specialized microscopic staining technique that uses chemical markers to assess the immunophenotype of cells from tissue or biopsy samples.</data>
      <data key="d3">chunk-650982a589c2d527bc13923ccd0569ef&lt;SEP&gt;chunk-0786666c65b5bf00705439d5cb60d5a0&lt;SEP&gt;chunk-562e1870b5e20f8648a2e56d960a1148&lt;SEP&gt;chunk-b63f0a9aec8d42c8426ded05a9bf92b4</data>
    </node>
    <node id="Leukemia Predisposition Syndromes">
      <data key="d0">Leukemia Predisposition Syndromes</data>
      <data key="d1">category</data>
      <data key="d2">Hereditary conditions passed down from biological parents that increase the risk of developing leukemia and influence clinical management.&lt;SEP&gt;Leukemia predisposition syndromes are hereditary cancer conditions passed down from parent to child that increase the risk of developing leukemia and can impact treatment.&lt;SEP&gt;Leukemia predisposition syndromes are hereditary cancer syndromes passed down biologically that increase leukemia risk and influence patient response to treatment.</data>
      <data key="d3">chunk-db4e8318949a3fda5683c53985c6af05&lt;SEP&gt;chunk-0786666c65b5bf00705439d5cb60d5a0&lt;SEP&gt;chunk-b63f0a9aec8d42c8426ded05a9bf92b4</data>
    </node>
    <node id="AML Mutation Testing">
      <data key="d0">AML Mutation Testing</data>
      <data key="d1">category</data>
      <data key="d2">AML mutation testing comprises laboratory methods used to identify genetic and chromosomal alterations unique to AML cancer cells in blood or bone marrow.&lt;SEP&gt;AML mutation testing comprises molecular and cytogenetic diagnostic tests—such as karyotype, FISH, NGS, and PCR—used to detect leukemia-specific chromosomal and gene abnormalities to guide therapy and prognosis.</data>
      <data key="d3">chunk-db4e8318949a3fda5683c53985c6af05&lt;SEP&gt;chunk-b63f0a9aec8d42c8426ded05a9bf92b4</data>
    </node>
    <node id="Fluorescence In Situ Hybridization">
      <data key="d0">Fluorescence In Situ Hybridization</data>
      <data key="d1">category</data>
      <data key="d2">Fluorescence in situ hybridization (FISH) is a laboratory cytogenetic test used to identify missing or extra chromosomal material, including the 17p deletion.&lt;SEP&gt;Fluorescence in situ hybridization (FISH) is a laboratory method using dye-labeled probes to identify specific, small genetic abnormalities in DNA without requiring cell growth.&lt;SEP&gt;Fluorescence in situ hybridization (FISH) is a molecular cytogenetic testing technique that uses fluorescent dye probes bound to DNA to identify specific and sub-microscopic chromosomal abnormalities.</data>
      <data key="d3">chunk-db4e8318949a3fda5683c53985c6af05&lt;SEP&gt;chunk-67015f3916810c4378b2ed269cc27f29&lt;SEP&gt;chunk-b63f0a9aec8d42c8426ded05a9bf92b4</data>
    </node>
    <node id="Karyotyping">
      <data key="d0">Karyotyping</data>
      <data key="d1">category</data>
      <data key="d2">Karyotyping is a cytogenetic testing method that visualizes an individual's 23 chromosome pairs from growing cells to identify structural and numerical chromosomal abnormalities.</data>
      <data key="d3">chunk-b63f0a9aec8d42c8426ded05a9bf92b4</data>
    </node>
    <node id="Next-Generation Sequencing">
      <data key="d0">Next-Generation Sequencing</data>
      <data key="d1">category</data>
      <data key="d2">A detailed DNA sequencing diagnostic method used to identify gene mutations that affect gene function.&lt;SEP&gt;A high-throughput laboratory testing technique used to analyze multiple cancer biomarkers simultaneously.&lt;SEP&gt;A high-throughput molecular technique (NGS) used to identify DNA sequence variations and genetic mutations across cancer cells.&lt;SEP&gt;Next-generation sequencing (NGS) is an advanced molecular sequencing method used to analyze DNA sequences and identify specific genetic mutations that guide cancer treatment.&lt;SEP&gt;Next-generation sequencing (NGS) is an advanced molecular testing method that determines DNA sequences and identifies fine genetic mutations.</data>
      <data key="d3">chunk-db4e8318949a3fda5683c53985c6af05&lt;SEP&gt;chunk-9d383e4798456aa46e381fd2b02f6f96&lt;SEP&gt;chunk-4724f6acaaa7931560b29614efc2927f&lt;SEP&gt;chunk-b63f0a9aec8d42c8426ded05a9bf92b4&lt;SEP&gt;chunk-650982a589c2d527bc13923ccd0569ef</data>
    </node>
    <node id="Polymerase Chain Reaction">
      <data key="d0">Polymerase Chain Reaction</data>
      <data key="d1">category</data>
      <data key="d2">A sensitive laboratory process (PCR) that creates millions to billions of copies of DNA, which can subsequently be used for next-generation sequencing.&lt;SEP&gt;A sensitive molecular testing technique that amplifies DNA or RNA to detect minimal residual abnormal cells and gene rearrangements.&lt;SEP&gt;Polymerase chain reaction (PCR) is a molecular testing technique used to examine DNA and identify specific genetic abnormalities and mutations in leukemia cells.&lt;SEP&gt;Polymerase chain reaction (PCR) is a sensitive laboratory technique that amplifies DNA or RNA to detect rare abnormal cells, evaluate treatment response, and monitor gene rearrangements.</data>
      <data key="d3">chunk-650982a589c2d527bc13923ccd0569ef&lt;SEP&gt;chunk-db4e8318949a3fda5683c53985c6af05&lt;SEP&gt;chunk-4724f6acaaa7931560b29614efc2927f&lt;SEP&gt;chunk-b63f0a9aec8d42c8426ded05a9bf92b4</data>
    </node>
    <node id="FLT3">
      <data key="d0">FLT3</data>
      <data key="d1">category</data>
      <data key="d2">FLT3 is a specific gene and receptor tyrosine kinase protein referenced as an example of a biomarker that can undergo mutation in acute myeloid leukemia cells.</data>
      <data key="d3">chunk-b63f0a9aec8d42c8426ded05a9bf92b4</data>
    </node>
    <node id="RUNX1::RUNX1T1">
      <data key="d0">RUNX1::RUNX1T1</data>
      <data key="d1">category</data>
      <data key="d2">RUNX1::RUNX1T1 is a specific gene rearrangement and fusion product resulting from chromosome translocation t(8;21)(q22;q22) in acute myeloid leukemia.</data>
      <data key="d3">chunk-b63f0a9aec8d42c8426ded05a9bf92b4</data>
    </node>
    <node id="Chromosome Translocation">
      <data key="d0">Chromosome Translocation</data>
      <data key="d1">category</data>
      <data key="d2">Chromosome translocation is a structural genetic alteration involving the exchange or switching of material between two distinct chromosomes.</data>
      <data key="d3">chunk-b63f0a9aec8d42c8426ded05a9bf92b4</data>
    </node>
    <node id="Gene Rearrangement">
      <data key="d0">Gene Rearrangement</data>
      <data key="d1">category</data>
      <data key="d2">Gene rearrangement is a genetic alteration occurring at the molecular level where portions of genes are structurally rearranged or fused together.</data>
      <data key="d3">chunk-b63f0a9aec8d42c8426ded05a9bf92b4</data>
    </node>
    <node id="Chromosomal Inversion">
      <data key="d0">Chromosomal Inversion</data>
      <data key="d1">category</data>
      <data key="d2">Chromosomal inversion is a structural genetic abnormality characterized by the switching or reversal of segments within a single chromosome, such as inv(16) and inv(3).</data>
      <data key="d3">chunk-b63f0a9aec8d42c8426ded05a9bf92b4</data>
    </node>
    <node id="Chromosomal Deletion">
      <data key="d0">Chromosomal Deletion</data>
      <data key="d1">category</data>
      <data key="d2">Chromosomal deletion is a structural genetic abnormality where a segment or an entire chromosome or gene is lost or missing, exemplified by del(5q).</data>
      <data key="d3">chunk-b63f0a9aec8d42c8426ded05a9bf92b4</data>
    </node>
    <node id="Gene Amplification">
      <data key="d0">Gene Amplification</data>
      <data key="d1">category</data>
      <data key="d2">Gene amplification is a molecular abnormality where the copy number of a whole or partial chromosome or gene is increased or duplicated.</data>
      <data key="d3">chunk-b63f0a9aec8d42c8426ded05a9bf92b4</data>
    </node>
    <node id="Point Mutation">
      <data key="d0">Point Mutation</data>
      <data key="d1">category</data>
      <data key="d2">Point mutation is a genetic alteration characterized by a change within a specific segment or nucleotide base of a gene.</data>
      <data key="d3">chunk-b63f0a9aec8d42c8426ded05a9bf92b4</data>
    </node>
    <node id="Hematopoietic Cell Donor">
      <data key="d0">Hematopoietic Cell Donor</data>
      <data key="d1">person</data>
      <data key="d2">Hematopoietic cell donors are biological family members evaluated for stem cell or bone marrow donation who may be screened for inherited leukemia predisposition syndromes.</data>
      <data key="d3">chunk-b63f0a9aec8d42c8426ded05a9bf92b4</data>
    </node>
    <node id="Molecular Tumor Profiling">
      <data key="d0">Molecular Tumor Profiling</data>
      <data key="d1">category</data>
      <data key="d2">Molecular tumor profiling, also termed genomic testing or gene expression profiling, refers to diagnostic testing targeting somatic genetic mutations within leukemia cells to predict prognosis and guide therapy.</data>
      <data key="d3">chunk-b63f0a9aec8d42c8426ded05a9bf92b4</data>
    </node>
    <node id="Cardiologist">
      <data key="d0">Cardiologist</data>
      <data key="d1">person</data>
      <data key="d2">A cardiologist is a heart specialist who evaluates cardiac health and monitors potential treatment-related side effects on heart function.&lt;SEP&gt;A medical specialist in heart health who evaluates cardiac function and monitors treatment side effects.</data>
      <data key="d3">chunk-29c9b8b5fd2cd967c48522af79a9598f&lt;SEP&gt;chunk-4724f6acaaa7931560b29614efc2927f</data>
    </node>
    <node id="Karyotype">
      <data key="d0">Karyotype</data>
      <data key="d1">category</data>
      <data key="d2">A diagnostic genetic test that visualizes chromosome pairs from blood or bone marrow samples to identify abnormalities, deletions, or rearrangements.&lt;SEP&gt;A karyotype is a cytogenetic test that evaluates a picture of chromosomes to detect missing, extra, rearranged, or abnormal chromosomal structures.&lt;SEP&gt;A karyotype is a laboratory evaluation that detects chromosomal abnormalities, including complex karyotypes involving three or more unrelated alterations.</data>
      <data key="d3">chunk-db4e8318949a3fda5683c53985c6af05&lt;SEP&gt;chunk-67015f3916810c4378b2ed269cc27f29&lt;SEP&gt;chunk-4724f6acaaa7931560b29614efc2927f</data>
    </node>
    <node id="Computed Tomography Scan">
      <data key="d0">Computed Tomography Scan</data>
      <data key="d1">category</data>
      <data key="d2">A diagnostic imaging test (CT scan) of the chest and abdomen used to determine whether rectal cancer has metastasized to distant organs such as the liver or lungs.&lt;SEP&gt;A type of imaging test using X-rays and computer processing to create detailed cross-sectional pictures of internal body structures.</data>
      <data key="d3">chunk-4724f6acaaa7931560b29614efc2927f&lt;SEP&gt;chunk-594536d6aaa61f8f1699ba50bf218a33</data>
    </node>
    <node id="Magnetic Resonance Imaging Scan">
      <data key="d0">Magnetic Resonance Imaging Scan</data>
      <data key="d1">category</data>
      <data key="d2">A non-radiation imaging modality utilizing radio waves and strong magnetic fields to visualize internal tissues.</data>
      <data key="d3">chunk-4724f6acaaa7931560b29614efc2927f</data>
    </node>
    <node id="Positron Emission Tomography Scan">
      <data key="d0">Positron Emission Tomography Scan</data>
      <data key="d1">category</data>
      <data key="d2">A diagnostic imaging test that uses radioactive tracers to identify active cancer cells based on glucose uptake.</data>
      <data key="d3">chunk-4724f6acaaa7931560b29614efc2927f</data>
    </node>
    <node id="Electrocardiogram">
      <data key="d0">Electrocardiogram</data>
      <data key="d1">category</data>
      <data key="d2">A cardiac test that measures the electrical activity, rate, and rhythm of the heart, including the QTc interval.&lt;SEP&gt;A non-invasive cardiac test that measures electrical heart activity to assess rhythm, rate, and QT intervals.</data>
      <data key="d3">chunk-29c9b8b5fd2cd967c48522af79a9598f&lt;SEP&gt;chunk-4724f6acaaa7931560b29614efc2927f</data>
    </node>
    <node id="Echocardiogram">
      <data key="d0">Echocardiogram</data>
      <data key="d1">category</data>
      <data key="d2">An echocardiogram is an ultrasound-based cardiac diagnostic test used to evaluate heart structure, valve function, and ejection fraction.&lt;SEP&gt;An ultrasound procedure of the heart that records structural details and assesses heart function, such as ejection fraction.&lt;SEP&gt;An ultrasound-based heart test that uses sound waves to create moving images of the heart.</data>
      <data key="d3">chunk-29c9b8b5fd2cd967c48522af79a9598f&lt;SEP&gt;chunk-97836a515d346931beb424ae40a89877&lt;SEP&gt;chunk-4724f6acaaa7931560b29614efc2927f</data>
    </node>
    <node id="Patient">
      <data key="d0">Patient</data>
      <data key="d1">person</data>
      <data key="d2">An individual diagnosed with cervical pre-cancer or cancer, receiving diagnostic staging, treatment, and ongoing surveillance.&lt;SEP&gt;An individual undergoing diagnostic evaluations, biopsies, and treatments, responsible for maintaining personal health records in a medical binder.&lt;SEP&gt;An individual undergoing diagnostic evaluations, imaging, and monitoring for leukemia.&lt;SEP&gt;The individual undergoing evaluation and imaging tests for suspected or diagnosed prostate cancer.</data>
      <data key="d3">chunk-e247ae57c50c62bded7114986471226e&lt;SEP&gt;chunk-aeafa486bfd320cdaa7811ad75777912&lt;SEP&gt;chunk-0739b33959299ea67072f390ce38bffd&lt;SEP&gt;chunk-4724f6acaaa7931560b29614efc2927f</data>
    </node>
    <node id="Reverse Transcriptase PCR">
      <data key="d0">Reverse Transcriptase PCR</data>
      <data key="d1">category</data>
      <data key="d2">A specialized form of polymerase chain reaction used to detect specific genetic rearrangements such as PML::RARA.&lt;SEP&gt;Reverse transcriptase (RT) PCR is a specialized type of polymerase chain reaction used to detect specific gene rearrangements such as PML::RARA.</data>
      <data key="d3">chunk-db4e8318949a3fda5683c53985c6af05&lt;SEP&gt;chunk-4724f6acaaa7931560b29614efc2927f</data>
    </node>
    <node id="Brain CT Scan">
      <data key="d0">Brain CT Scan</data>
      <data key="d1">category</data>
      <data key="d2">A brain CT scan is a diagnostic imaging procedure using x-rays and computer technology to quickly identify bleeding inside the brain.&lt;SEP&gt;A computed tomography scan specifically focused on the brain to detect intracranial bleeding.</data>
      <data key="d3">chunk-db4e8318949a3fda5683c53985c6af05&lt;SEP&gt;chunk-4724f6acaaa7931560b29614efc2927f</data>
    </node>
    <node id="Brain MRI Scan">
      <data key="d0">Brain MRI Scan</data>
      <data key="d1">category</data>
      <data key="d2">A brain MRI scan is an imaging test using magnets and radio waves to evaluate the brain and detect leukemic meningitis or swelling without radiation.&lt;SEP&gt;A magnetic resonance imaging scan of the brain used to detect complications such as leukemic meningitis.</data>
      <data key="d3">chunk-db4e8318949a3fda5683c53985c6af05&lt;SEP&gt;chunk-4724f6acaaa7931560b29614efc2927f</data>
    </node>
    <node id="Prolonged QTc Interval">
      <data key="d0">Prolonged QTc Interval</data>
      <data key="d1">category</data>
      <data key="d2">A cardiac conduction anomaly detected on an ECG where ventricular repolarization is abnormally delayed, potentially caused by cancer therapies.</data>
      <data key="d3">chunk-4724f6acaaa7931560b29614efc2927f</data>
    </node>
    <node id="Multidisciplinary Team">
      <data key="d0">Multidisciplinary Team</data>
      <data key="d1">organization</data>
      <data key="d2">A collaborative group of healthcare professionals, including specialists and care providers, responsible for diagnosing and treating the patient.&lt;SEP&gt;A collaborative team of diverse healthcare and psychosocial professionals who collectively plan, coordinate, and implement individualized breast cancer care.&lt;SEP&gt;A multidisciplinary team (MDT) consists of health care and psychosocial professionals from diverse backgrounds who collaborate to plan and implement cancer treatment.&lt;SEP&gt;A multidisciplinary team (MDT) is a collaborative group of healthcare and psychosocial care professionals from diverse specialties who coordinate, plan, and deliver treatment for cancer patients.&lt;SEP&gt;A specialized group of diverse healthcare providers and experts working together to diagnose, stage, and plan treatment for pancreatic cancer patients.</data>
      <data key="d3">chunk-6268b6efa690f6e094e443dca6b4cb52&lt;SEP&gt;chunk-cb41559e96b71d2bb4ea207c806e8d5f&lt;SEP&gt;chunk-8333423c91919d7adde114b8286cca7e&lt;SEP&gt;chunk-97836a515d346931beb424ae40a89877&lt;SEP&gt;chunk-5846f51c2ca4fae54459ce9c50e3e820</data>
    </node>
    <node id="Hematologist">
      <data key="d0">Hematologist</data>
      <data key="d1">category</data>
      <data key="d2">A hematologist or hematologic oncologist is a medical doctor and expert specializing in the diagnosis and treatment of blood diseases and blood cancers.&lt;SEP&gt;A hematologist or hematologic oncologist is a medical doctor and specialist who diagnoses and treats blood disorders and blood cancers like AML.</data>
      <data key="d3">chunk-8333423c91919d7adde114b8286cca7e&lt;SEP&gt;chunk-97836a515d346931beb424ae40a89877</data>
    </node>
    <node id="Prolonged QTc">
      <data key="d0">Prolonged QTc</data>
      <data key="d1">category</data>
      <data key="d2">Prolonged QTc is a cardiac condition in which the heart muscle takes longer than normal to recharge between beats, potentially leading to dangerous arrhythmias.</data>
      <data key="d3">chunk-97836a515d346931beb424ae40a89877</data>
    </node>
    <node id="Ejection Fraction">
      <data key="d0">Ejection Fraction</data>
      <data key="d1">category</data>
      <data key="d2">Ejection fraction is a measurement of the percentage of blood pumped out of the heart's left side during each contraction, serving as an indicator of cardiac function.</data>
      <data key="d3">chunk-97836a515d346931beb424ae40a89877</data>
    </node>
    <node id="Genetic And Biomarker Tests">
      <data key="d0">Genetic And Biomarker Tests</data>
      <data key="d1">category</data>
      <data key="d2">Genetic and biomarker tests are diagnostic procedures used to detect specific gene mutations and chromosomal abnormalities to determine AML subtype and prognosis.</data>
      <data key="d3">chunk-97836a515d346931beb424ae40a89877</data>
    </node>
    <node id="Insurance Provider">
      <data key="d0">Insurance Provider</data>
      <data key="d1">organization</data>
      <data key="d2">Healthcare insurers responsible for covering the costs of diagnostic tests, treatments, and procedures for cancer patients.</data>
      <data key="d3">chunk-97836a515d346931beb424ae40a89877</data>
    </node>
    <node id="Catheter">
      <data key="d0">Catheter</data>
      <data key="d1">category</data>
      <data key="d2">A medical device consisting of a long, thin tube placed into a large vein, typically in the upper arm, to administer systemic therapy, fluids, and blood products.&lt;SEP&gt;A thin, long tube placed into a large vein, typically in the upper arm, used to administer systemic therapy, fluids, and blood products.</data>
      <data key="d3">chunk-8333423c91919d7adde114b8286cca7e&lt;SEP&gt;chunk-97836a515d346931beb424ae40a89877</data>
    </node>
    <node id="Port">
      <data key="d0">Port</data>
      <data key="d1">category</data>
      <data key="d2">A central venous catheter inserted into an upper chest vein beneath the collarbone to deliver continuous chemotherapy infusions.&lt;SEP&gt;A small, round medical device implanted in the chest to provide venous access for delivering systemic chemotherapy and other therapies.&lt;SEP&gt;A small, round vascular access disc surgically placed in the chest to deliver systemic therapies and medications.</data>
      <data key="d3">chunk-0fdcce851d69aa713ed64ba1895bd5d1&lt;SEP&gt;chunk-8333423c91919d7adde114b8286cca7e&lt;SEP&gt;chunk-97836a515d346931beb424ae40a89877</data>
    </node>
    <node id="Side Effects">
      <data key="d0">Side Effects</data>
      <data key="d1">category</data>
      <data key="d2">Secondary adverse physiological reactions that occur as a result of cancer treatments such as chemotherapy and systemic therapies.</data>
      <data key="d3">chunk-97836a515d346931beb424ae40a89877</data>
    </node>
    <node id="Antimetabolites">
      <data key="d0">Antimetabolites</data>
      <data key="d1">category</data>
      <data key="d2">A class of chemotherapy drugs that includes capecitabine, fluorouracil, gemcitabine, and methotrexate.&lt;SEP&gt;A class of chemotherapy drugs that inhibit the utilization of DNA building blocks to prevent cancer cell replication.&lt;SEP&gt;A class of chemotherapy drugs, including cytarabine, cladribine, clofarabine, fludarabine, and methotrexate, that prevent the building blocks of DNA from being used.</data>
      <data key="d3">chunk-9040f5949ae0ff36ce88faa1f4b67ead&lt;SEP&gt;chunk-8333423c91919d7adde114b8286cca7e&lt;SEP&gt;chunk-53afdc6713818c4177b64a712ecce11b</data>
    </node>
    <node id="Anthracyclines">
      <data key="d0">Anthracyclines</data>
      <data key="d1">category</data>
      <data key="d2">A class of chemotherapy drugs that damage and disrupt DNA replication, leading to cell death in both cancerous and non-cancerous cells.&lt;SEP&gt;A class of chemotherapy drugs that includes doxorubicin, doxorubicin liposomal injection, and epirubicin.&lt;SEP&gt;A class of chemotherapy drugs, including daunorubicin, idarubicin, and mitoxantrone, that disrupt DNA production and may cause cardiac side effects.</data>
      <data key="d3">chunk-9040f5949ae0ff36ce88faa1f4b67ead&lt;SEP&gt;chunk-8333423c91919d7adde114b8286cca7e&lt;SEP&gt;chunk-53afdc6713818c4177b64a712ecce11b</data>
    </node>
    <node id="Hypomethylating Agents">
      <data key="d0">Hypomethylating Agents</data>
      <data key="d1">category</data>
      <data key="d2">A category of therapeutic agents that prevent methyl groups from binding to DNA, helping silenced genes reactivate so leukemic blasts can mature normally.&lt;SEP&gt;A class of drugs that inhibit methyl groups from binding to DNA, allowing silenced genes to reactivate and leukemic blasts to mature.&lt;SEP&gt;A class of therapies, including azacitidine and decitabine, that block methyl groups from DNA to allow leukemic blasts to mature normally.</data>
      <data key="d3">chunk-8333423c91919d7adde114b8286cca7e&lt;SEP&gt;chunk-06f823f3a91fcbc32c62fac3c6347715&lt;SEP&gt;chunk-53afdc6713818c4177b64a712ecce11b</data>
    </node>
    <node id="Ovarian Cancer">
      <data key="d0">Ovarian Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A cancer category associated with inherited germline mutations in genes including BRCA1 and BRCA2.&lt;SEP&gt;A cancer of the ovaries frequently tied to inherited mutations in BRCA1, BRCA2, and related genes.&lt;SEP&gt;A category of gynecologic cancer that commonly begins in the epithelial tissue surrounding the ovaries or in the fallopian tubes.&lt;SEP&gt;A form of cancer affecting the ovaries, characterized by symptoms like bloating, abdominal pain, and pelvic pressure, evaluated through physical exams and imaging to determine clinical stage and surgical eligibility.&lt;SEP&gt;A form of cancer that originates in the ovaries and may spread to the abdomen, lungs, or other parts of the body.&lt;SEP&gt;A group of malignancies affecting the ovaries and related reproductive structures, commonly diagnosed through biopsy, imaging, and surgical evaluation.&lt;SEP&gt;A gynecological cancer characterized by symptoms such as pelvic or abdominal pain, bloating, and difficulty eating, which can be diagnosed and managed through surgery, blood tests, and biomarker testing.&lt;SEP&gt;A gynecological malignancy linked through family medical history to a higher genetic risk of prostate cancer.&lt;SEP&gt;A malignancy affecting the ovaries and pelvic region, categorized into stages I through IV based on spread.&lt;SEP&gt;A malignancy whose risk is substantially increased in individuals carrying inherited BRCA1 or BRCA2 mutations.&lt;SEP&gt;A medical diagnosis and category of malignancy originating in the ovaries, staged from Stage I to Stage IV.&lt;SEP&gt;A type of reproductive cancer associated with increased susceptibility among individuals affected by Lynch syndrome.&lt;SEP&gt;Ovarian cancer is a disease characterized by the abnormal growth of cells in the ovaries, commonly treated with surgery, chemotherapy, and maintenance therapies.&lt;SEP&gt;Ovarian cancer is a malignant condition affecting the ovaries, linked to an increased risk in people with Lynch syndrome.</data>
      <data key="d3">chunk-b69d38fafe014cece3427bd0459ae42b&lt;SEP&gt;chunk-77ac570b4029abb181150e0d0975aefb&lt;SEP&gt;chunk-789ec6c06f8c999ac21c89b085b3fdb7&lt;SEP&gt;chunk-85e75e869fcfcb7c5431dbcdd532137f&lt;SEP&gt;chunk-1c7418fb993bb3daa95d8563909da1de&lt;SEP&gt;chunk-e5406c28b41e499fad4ae44f2c44fdd7&lt;SEP&gt;chunk-96238b4b361e393ff452a09d1ce26154&lt;SEP&gt;chunk-cf2d987135a5936876bc819136e3a5b5&lt;SEP&gt;chunk-ae40f53e9d867c255e1e6901f5cfb058&lt;SEP&gt;chunk-925a474b4538dda470bfd817f9d9a17d&lt;SEP&gt;chunk-8b44f0b4da13a804cd1dfb917ac7e981&lt;SEP&gt;chunk-965e5a6bad03f2129a98be4373f99176&lt;SEP&gt;chunk-650982a589c2d527bc13923ccd0569ef&lt;SEP&gt;chunk-53afdc6713818c4177b64a712ecce11b</data>
    </node>
    <node id="Standard Of Care">
      <data key="d0">Standard Of Care</data>
      <data key="d1">category</data>
      <data key="d2">A clinical classification referring to the best-known, evidence-based treatment regimen for a particular disease derived from past clinical trials.&lt;SEP&gt;The best-known and most widely accepted treatment protocols established through clinical trials.</data>
      <data key="d3">chunk-8333423c91919d7adde114b8286cca7e&lt;SEP&gt;chunk-53afdc6713818c4177b64a712ecce11b</data>
    </node>
    <node id="Preferred Therapies">
      <data key="d0">Preferred Therapies</data>
      <data key="d1">category</data>
      <data key="d2">A classification of cancer treatments supported by the strongest clinical evidence regarding efficacy and safety.&lt;SEP&gt;A treatment categorization designating therapies supported by the strongest clinical evidence of efficacy and safety compared to alternatives.</data>
      <data key="d3">chunk-8333423c91919d7adde114b8286cca7e&lt;SEP&gt;chunk-53afdc6713818c4177b64a712ecce11b</data>
    </node>
    <node id="Multi-Agent Chemotherapy">
      <data key="d0">Multi-Agent Chemotherapy</data>
      <data key="d1">category</data>
      <data key="d2">A chemotherapy regimen category that combines multiple distinct therapeutic agents working through different mechanisms to treat cancer.&lt;SEP&gt;A treatment regimen combining multiple chemotherapy drugs with different mechanisms of action to treat AML.</data>
      <data key="d3">chunk-8333423c91919d7adde114b8286cca7e&lt;SEP&gt;chunk-53afdc6713818c4177b64a712ecce11b</data>
    </node>
    <node id="Intrathecal Chemotherapy">
      <data key="d0">Intrathecal Chemotherapy</data>
      <data key="d1">category</data>
      <data key="d2">A chemotherapy administration method where drugs are injected directly into the cerebrospinal fluid within the spinal canal to treat cancer cells in the central nervous system.&lt;SEP&gt;A specialized chemotherapy administration category where medications are infused directly into the cerebrospinal fluid to treat cancer cells in the CSF or spine.&lt;SEP&gt;A specialized chemotherapy administration method where drugs such as cytarabine or methotrexate are injected directly into spinal fluid.&lt;SEP&gt;A specialized chemotherapy administration route where drugs are infused directly into the cerebrospinal fluid (CSF).&lt;SEP&gt;A specialized chemotherapy category involving injection directly into the spinal fluid surrounding the spine and brain to treat central nervous system involvement.</data>
      <data key="d3">chunk-8fbedfa2d88a7b3852f4c2bd0bb64af0&lt;SEP&gt;chunk-06f823f3a91fcbc32c62fac3c6347715&lt;SEP&gt;chunk-8333423c91919d7adde114b8286cca7e&lt;SEP&gt;chunk-725b48dc82aad42ba3dc14f4b5207551&lt;SEP&gt;chunk-53afdc6713818c4177b64a712ecce11b</data>
    </node>
    <node id="CD33 Protein">
      <data key="d0">CD33 Protein</data>
      <data key="d1">category</data>
      <data key="d2">A cell surface protein category commonly present on leukemic blasts in AML, targeted by conjugated therapies like gemtuzumab ozogamicin.</data>
      <data key="d3">chunk-53afdc6713818c4177b64a712ecce11b</data>
    </node>
    <node id="FLT3 Mutation">
      <data key="d0">FLT3 Mutation</data>
      <data key="d1">category</data>
      <data key="d2">A category of genetic alterations in AML, including FLT3-ITD and FLT3-TKD, targeted by specific kinase inhibitor drugs.&lt;SEP&gt;A category of recurrent genetic mutations in AML, including FLT3-ITD and FLT3-TKD, targeted by specific small-molecule inhibitors.</data>
      <data key="d3">chunk-06f823f3a91fcbc32c62fac3c6347715&lt;SEP&gt;chunk-53afdc6713818c4177b64a712ecce11b</data>
    </node>
    <node id="Core Binding Factor AML">
      <data key="d0">Core Binding Factor AML</data>
      <data key="d1">category</data>
      <data key="d2">A genetic subtype category of AML characterized by CBF abnormalities causing a shortage of mature blood cells.</data>
      <data key="d3">chunk-53afdc6713818c4177b64a712ecce11b</data>
    </node>
    <node id="Female Reproductive System">
      <data key="d0">Female Reproductive System</data>
      <data key="d1">category</data>
      <data key="d2">An anatomical biological system comprising the ovaries, fallopian tubes, uterus, cervix, and vagina involved in reproduction.&lt;SEP&gt;The female reproductive system is a biological organ system comprising the cervix, uterus, vagina, ovaries, and fallopian tubes, functioning together for sexual reproduction.</data>
      <data key="d3">chunk-d249262ff9e7e657de99a30199159cdf&lt;SEP&gt;chunk-53afdc6713818c4177b64a712ecce11b</data>
    </node>
    <node id="Epithelial Ovarian Cancer">
      <data key="d0">Epithelial Ovarian Cancer</data>
      <data key="d1">category</data>
      <data key="d2">The most common classification of ovarian cancer, originating in the outer layer of tissue surrounding the ovaries.&lt;SEP&gt;The predominant category of ovarian cancer arising from the surface epithelial layer of the ovaries or nearby fallopian tubes.</data>
      <data key="d3">chunk-53afdc6713818c4177b64a712ecce11b&lt;SEP&gt;chunk-b4da30dee72e228147daa825e4f5be72</data>
    </node>
    <node id="Treatment Team">
      <data key="d0">Treatment Team</data>
      <data key="d1">organization</data>
      <data key="d2">A multidisciplinary clinical team responsible for managing patient care, selecting biomarker tests, and designing oncology therapy plans.&lt;SEP&gt;A multidisciplinary group of healthcare professionals, including oncologists, nurses, and specialists, responsible for planning and delivering ovarian cancer care.&lt;SEP&gt;A multidisciplinary group of healthcare providers responsible for planning cancer treatment, performing procedures, and managing patient side effects.&lt;SEP&gt;A multidisciplinary medical group including endocrinologists, radiologists, nuclear medicine specialists, surgeons, and oncologists that designs and executes a thyroid cancer treatment plan.&lt;SEP&gt;A multidisciplinary medical group responsible for administering care, monitoring adverse side effects, providing supportive medications, and advising cancer patients.&lt;SEP&gt;A multidisciplinary medical group that utilizes biopsy, pathology, and molecular diagnostic findings to formulate patient care plans.&lt;SEP&gt;A treatment team is a multidisciplinary group of medical professionals providing care, counseling, and surgical management for bladder cancer patients.&lt;SEP&gt;The medical and healthcare providers responsible for monitoring patient symptoms, weighing treatment risks, and determining therapy eligibility.&lt;SEP&gt;The medical care team responsible for delivering standard or systemic therapy, managing side effects, and evaluating eligibility for clinical trials.&lt;SEP&gt;The multidisciplinary group of healthcare professionals managing chemotherapy administration, side effects, and follow-up care.&lt;SEP&gt;The multidisciplinary healthcare team responsible for managing patient care, providing preoperative instructions, and guiding therapy decisions.</data>
      <data key="d3">chunk-8fbedfa2d88a7b3852f4c2bd0bb64af0&lt;SEP&gt;chunk-ffc3446f8ec092af24a460bda94f772f&lt;SEP&gt;chunk-f2a44e885faf856aa579d824b3cd85e7&lt;SEP&gt;chunk-1e017cd4fd8af1ebbcb582a93fbfe1ea&lt;SEP&gt;chunk-5349eed06f06d7c9bcb541ced69e4664&lt;SEP&gt;chunk-8ec4d44b145ca896ff1216caa90ce5dd&lt;SEP&gt;chunk-cf2d987135a5936876bc819136e3a5b5&lt;SEP&gt;chunk-b4da30dee72e228147daa825e4f5be72&lt;SEP&gt;chunk-13e723cb8b0af4bcf2f1b0fd37912cb2&lt;SEP&gt;chunk-562e1870b5e20f8648a2e56d960a1148&lt;SEP&gt;chunk-a65ba958750476cc543741efe815c7c4</data>
    </node>
    <node id="Gynecologic Oncologist">
      <data key="d0">Gynecologic Oncologist</data>
      <data key="d1">person</data>
      <data key="d2">A specialized doctor and surgeon who specializes in surgery and chemotherapy for gynecologic cancers, typically performing initial surgeries.&lt;SEP&gt;A specialized medical practitioner with expertise in performing surgery and administering chemotherapy for female reproductive cancers.&lt;SEP&gt;A surgical specialist with expert training in treating cancers that originate in female reproductive organs.</data>
      <data key="d3">chunk-db3a86fc5d439d9bfb3845e468a2a551&lt;SEP&gt;chunk-77ac570b4029abb181150e0d0975aefb&lt;SEP&gt;chunk-b4da30dee72e228147daa825e4f5be72</data>
    </node>
    <node id="High-Grade Serous Carcinoma">
      <data key="d0">High-Grade Serous Carcinoma</data>
      <data key="d1">category</data>
      <data key="d2">One of the most common and aggressive subtypes of ovarian cancer, typically treated with a combination of surgery and chemotherapy.&lt;SEP&gt;The most common and fast-growing type of epithelial ovarian cancer.</data>
      <data key="d3">chunk-77ac570b4029abb181150e0d0975aefb&lt;SEP&gt;chunk-b4da30dee72e228147daa825e4f5be72</data>
    </node>
    <node id="High-Grade Endometrioid Carcinoma">
      <data key="d0">High-Grade Endometrioid Carcinoma</data>
      <data key="d1">category</data>
      <data key="d2">One of the most common subtypes of epithelial ovarian cancer.&lt;SEP&gt;One of the most common subtypes of ovarian cancer, commonly managed with surgical intervention and chemotherapy.</data>
      <data key="d3">chunk-77ac570b4029abb181150e0d0975aefb&lt;SEP&gt;chunk-b4da30dee72e228147daa825e4f5be72</data>
    </node>
    <node id="Less Common Ovarian Cancers">
      <data key="d0">Less Common Ovarian Cancers</data>
      <data key="d1">category</data>
      <data key="d2">Rare forms of ovarian cancer that can originate in the epithelium, supporting tissues, or reproductive cells.</data>
      <data key="d3">chunk-b4da30dee72e228147daa825e4f5be72</data>
    </node>
    <node id="Primary Peritoneal Cancer">
      <data key="d0">Primary Peritoneal Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A cancer that forms in the lining of the abdominal wall and organs, treated similarly to ovarian cancer.</data>
      <data key="d3">chunk-b4da30dee72e228147daa825e4f5be72</data>
    </node>
    <node id="Fallopian Tube Cancer">
      <data key="d0">Fallopian Tube Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A type of cancer that begins in the fallopian tube, treated under similar protocols as ovarian cancer.</data>
      <data key="d3">chunk-b4da30dee72e228147daa825e4f5be72</data>
    </node>
    <node id="Cancer Grade">
      <data key="d0">Cancer Grade</data>
      <data key="d1">category</data>
      <data key="d2">A classification metric estimating the speed of tumor growth and spreading potential, divided into low grade (LG) and high grade (HG).&lt;SEP&gt;A classification rating indicating how abnormal cancer cells appear under a microscope and how rapidly they may grow and spread.&lt;SEP&gt;A classification scale ranging from GX to G4 assessing cellular differentiation and the likelihood of tumor growth and spread.&lt;SEP&gt;A histologic staging factor that assesses the abnormality of tumor cells under a microscope to predict growth and spread rates.&lt;SEP&gt;A histological measurement describing the degree of abnormality of tumor cells under a microscope, categorized into GX, G1, G2, and G3.</data>
      <data key="d3">chunk-84367cc8f7a94b97b4b66a1ca127c15f&lt;SEP&gt;chunk-a158766f46bf752d6cdfe95c92f14547&lt;SEP&gt;chunk-74f18dd51a0091fc888512458a85b0a1&lt;SEP&gt;chunk-0fdcce851d69aa713ed64ba1895bd5d1&lt;SEP&gt;chunk-b4da30dee72e228147daa825e4f5be72</data>
    </node>
    <node id="Cancer Stage">
      <data key="d0">Cancer Stage</data>
      <data key="d1">category</data>
      <data key="d2">A classification scale from stage 0 to stage 4 describing how deeply a tumor has invaded the bladder wall layers and spread to distant sites.&lt;SEP&gt;A diagnostic categorization describing the extent to which cancer has spread from the ovary throughout the body.</data>
      <data key="d3">chunk-a158766f46bf752d6cdfe95c92f14547&lt;SEP&gt;chunk-b4da30dee72e228147daa825e4f5be72</data>
    </node>
    <node id="Low-Grade Serous Carcinoma">
      <data key="d0">Low-Grade Serous Carcinoma</data>
      <data key="d1">category</data>
      <data key="d2">A less common subtype of epithelial ovarian cancer characterized by slower growth compared to high-grade forms.</data>
      <data key="d3">chunk-b4da30dee72e228147daa825e4f5be72</data>
    </node>
    <node id="Low-Grade Endometrioid Carcinoma">
      <data key="d0">Low-Grade Endometrioid Carcinoma</data>
      <data key="d1">category</data>
      <data key="d2">A less common type of epithelial ovarian cancer.</data>
      <data key="d3">chunk-b4da30dee72e228147daa825e4f5be72</data>
    </node>
    <node id="Carcinosarcoma">
      <data key="d0">Carcinosarcoma</data>
      <data key="d1">category</data>
      <data key="d2">A rare and aggressive type of epithelial ovarian cancer, also known as malignant mixed Mullerian tumors.</data>
      <data key="d3">chunk-b4da30dee72e228147daa825e4f5be72</data>
    </node>
    <node id="Clear Cell Carcinoma">
      <data key="d0">Clear Cell Carcinoma</data>
      <data key="d1">category</data>
      <data key="d2">A less common histology of epithelial ovarian cancer.</data>
      <data key="d3">chunk-b4da30dee72e228147daa825e4f5be72</data>
    </node>
    <node id="Mucinous Carcinoma">
      <data key="d0">Mucinous Carcinoma</data>
      <data key="d1">category</data>
      <data key="d2">A less common subtype of epithelial ovarian cancer.</data>
      <data key="d3">chunk-b4da30dee72e228147daa825e4f5be72</data>
    </node>
    <node id="Borderline Epithelial Tumor">
      <data key="d0">Borderline Epithelial Tumor</data>
      <data key="d1">category</data>
      <data key="d2">An ovarian tumor with low malignant potential classified under less common epithelial ovarian neoplasms.</data>
      <data key="d3">chunk-b4da30dee72e228147daa825e4f5be72</data>
    </node>
    <node id="Malignant Sex-Cord Stromal Tumors">
      <data key="d0">Malignant Sex-Cord Stromal Tumors</data>
      <data key="d1">category</data>
      <data key="d2">A rare category of non-epithelial ovarian cancer arising from the supportive structural tissues of the ovary.</data>
      <data key="d3">chunk-b4da30dee72e228147daa825e4f5be72</data>
    </node>
    <node id="Malignant Germ Cell Tumors">
      <data key="d0">Malignant Germ Cell Tumors</data>
      <data key="d1">category</data>
      <data key="d2">A less common type of non-epithelial ovarian cancer that originates in the reproductive egg cells.</data>
      <data key="d3">chunk-b4da30dee72e228147daa825e4f5be72</data>
    </node>
    <node id="Abdominal And Pelvic Exam">
      <data key="d0">Abdominal And Pelvic Exam</data>
      <data key="d1">event</data>
      <data key="d2">A physical clinical evaluation utilized in the assessment and diagnostic workup of suspected ovarian cancer.</data>
      <data key="d3">chunk-b4da30dee72e228147daa825e4f5be72</data>
    </node>
    <node id="Genetic Counselors">
      <data key="d0">Genetic Counselors</data>
      <data key="d1">person</data>
      <data key="d2">Healthcare professionals on the multidisciplinary care team who specialize in assessing hereditary risk factors and genetic testing for cancer.</data>
      <data key="d3">chunk-b4da30dee72e228147daa825e4f5be72</data>
    </node>
    <node id="Social Workers">
      <data key="d0">Social Workers</data>
      <data key="d1">person</data>
      <data key="d2">Healthcare professionals who assist cancer patients in coping with daily problems, emotional distress, and financial or insurance stresses.&lt;SEP&gt;Supportive care professionals within the treatment team who assist cancer patients with psychosocial, logistical, and emotional needs.</data>
      <data key="d3">chunk-e90bcd28496f1f39a21973656e3e496f&lt;SEP&gt;chunk-b4da30dee72e228147daa825e4f5be72</data>
    </node>
    <node id="Cervical Cancer">
      <data key="d0">Cervical Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A cancer affecting the cervix, diagnosed and evaluated through various biopsies, blood tests, and imaging procedures to guide treatment planning.&lt;SEP&gt;A cancer of the cervix staged using tumor size, lymph node involvement, and distant spread to guide treatment planning.&lt;SEP&gt;A gynecological malignancy that develops in the cervix, commonly diagnosed via cervical biopsy and managed with surgery, radiation, or systemic therapies.&lt;SEP&gt;A malignancy caused by HPV; a medical history of cervical cancer or precancer is a risk factor for anal cancer.&lt;SEP&gt;A malignancy of the cervix caused by HPV, for which screening via Pap or HPV/Pap co-testing is recommended.&lt;SEP&gt;A malignancy of the cervix encompassing types such as squamous cell carcinoma, adenocarcinoma, and adenosquamous carcinoma, staged based on the spread of the tumor.&lt;SEP&gt;A malignancy of the cervix evaluated and staged through diagnostic imaging and physical examinations.&lt;SEP&gt;A malignancy of the cervix known to be caused by persistent infection with high-risk human papillomavirus.&lt;SEP&gt;A malignancy of the cervix requiring structured post-treatment surveillance, monitoring for recurrence, and biomarker profiling for advanced cases.&lt;SEP&gt;A malignancy of the cervix that can spread to pelvic and para-aortic lymph nodes, as well as distant organs such as the liver, lungs, or bones.&lt;SEP&gt;A type of cancer affecting the cervix, specifically screened and detected via a Pap test.&lt;SEP&gt;A type of cancer that develops in the cervix, commonly treated with chemoradiation, brachytherapy, and systemic therapies.&lt;SEP&gt;Cervical cancer is a common malignancy of the female reproductive system that arises from abnormal cellular changes in the cervix, predominantly linked to human papillomavirus (HPV).&lt;SEP&gt;Cervical cancer is a malignancy originating in the cervix, commonly caused by persistent HPV infection and categorized into various histological types including squamous cell carcinoma and adenocarcinoma.&lt;SEP&gt;Cervical cancer is a type of cancer addressed in the text, categorized into specific subtypes and treated using modalities such as surgery, chemoradiation, and systemic therapy.</data>
      <data key="d3">chunk-f2a44e885faf856aa579d824b3cd85e7&lt;SEP&gt;chunk-27b3a0f53b4be1d525497f87555d7a06&lt;SEP&gt;chunk-8ec4d44b145ca896ff1216caa90ce5dd&lt;SEP&gt;chunk-d04ad65c55d0dbbee5061cf3b24030ef&lt;SEP&gt;chunk-e5406c28b41e499fad4ae44f2c44fdd7&lt;SEP&gt;chunk-db3a86fc5d439d9bfb3845e468a2a551&lt;SEP&gt;chunk-b4d036ee5fd77783b9e7ddef3a8477ae&lt;SEP&gt;chunk-c9bfa651267335dd5e6ae5a24d85a072&lt;SEP&gt;chunk-95c76786e9d6dbf06ddf5d55af0cf658&lt;SEP&gt;chunk-b3ba7430f3a31330247f52afe7e9c68a&lt;SEP&gt;chunk-9530f389987c13273449ab22a85170ae&lt;SEP&gt;chunk-d249262ff9e7e657de99a30199159cdf&lt;SEP&gt;chunk-e9a7fe3b15f3289198c7114b44890dea&lt;SEP&gt;chunk-a18089523f6dcd63cfa5664dc1c01618&lt;SEP&gt;chunk-be6e1cb2fe11f4d9962741c30d446a69</data>
    </node>
    <node id="Uterine Cancer">
      <data key="d0">Uterine Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A cancer of the uterus linked to hereditary mutations in DNA mismatch repair genes including MSH2, MSH6, MLH1, and PMS2.&lt;SEP&gt;A cancer of the uterus linked to hereditary mutations in DNA mismatch repair genes such as MSH2, MSH6, MLH1, and PMS2.&lt;SEP&gt;A form of cancer involving the uterus that can be ruled out using an endometrial biopsy.&lt;SEP&gt;Uterine cancer refers to malignancies originating in the uterus, such as endometrial cancer and uterine sarcomas, which are diagnosed and treated differently from cervical cancer.</data>
      <data key="d3">chunk-d249262ff9e7e657de99a30199159cdf&lt;SEP&gt;chunk-965e5a6bad03f2129a98be4373f99176&lt;SEP&gt;chunk-789ec6c06f8c999ac21c89b085b3fdb7&lt;SEP&gt;chunk-e5406c28b41e499fad4ae44f2c44fdd7</data>
    </node>
    <node id="Abdominal Exam">
      <data key="d0">Abdominal Exam</data>
      <data key="d1">event</data>
      <data key="d2">A physical examination where a provider feels areas of the abdomen to check organ size, tenderness, and signs of ascites or fluid buildup.</data>
      <data key="d3">chunk-e5406c28b41e499fad4ae44f2c44fdd7</data>
    </node>
    <node id="Pelvic Exam">
      <data key="d0">Pelvic Exam</data>
      <data key="d1">event</data>
      <data key="d2">A clinical physical exam assessing abnormal changes in the ovaries, cervix, and uterus, often utilizing a speculum.</data>
      <data key="d3">chunk-e5406c28b41e499fad4ae44f2c44fdd7</data>
    </node>
    <node id="Pap Test">
      <data key="d0">Pap Test</data>
      <data key="d1">event</data>
      <data key="d2">A cervical screening procedure involving the collection and testing of cervical cells for abnormalities and cancer.&lt;SEP&gt;A diagnostic procedure where cervical cells are sampled during a pelvic exam to detect cervical cancer or pre-cancer.</data>
      <data key="d3">chunk-a18089523f6dcd63cfa5664dc1c01618&lt;SEP&gt;chunk-e5406c28b41e499fad4ae44f2c44fdd7</data>
    </node>
    <node id="Endometrial Biopsy">
      <data key="d0">Endometrial Biopsy</data>
      <data key="d1">event</data>
      <data key="d2">A procedure sampling the uterine lining during an initial pelvic evaluation to rule out uterine cancer.</data>
      <data key="d3">chunk-e5406c28b41e499fad4ae44f2c44fdd7</data>
    </node>
    <node id="Rectovaginal Exam">
      <data key="d0">Rectovaginal Exam</data>
      <data key="d1">event</data>
      <data key="d2">A physical examination evaluating the rectum and vagina simultaneously to check for cancer spread in the intervening space.</data>
      <data key="d3">chunk-e5406c28b41e499fad4ae44f2c44fdd7</data>
    </node>
    <node id="Transabdominal Ultrasound">
      <data key="d0">Transabdominal Ultrasound</data>
      <data key="d1">event</data>
      <data key="d2">An ultrasound procedure involving gel and an external probe moved over the abdomen and pelvis to create images of internal organs.</data>
      <data key="d3">chunk-e5406c28b41e499fad4ae44f2c44fdd7</data>
    </node>
    <node id="Transvaginal Ultrasound">
      <data key="d0">Transvaginal Ultrasound</data>
      <data key="d1">event</data>
      <data key="d2">An internal imaging procedure where an ultrasound probe is placed into the vagina to provide a clearer view of the ovaries.&lt;SEP&gt;An ultrasound procedure involving an internal probe to examine the cervix and pelvis using sound waves.</data>
      <data key="d3">chunk-be6e1cb2fe11f4d9962741c30d446a69&lt;SEP&gt;chunk-e5406c28b41e499fad4ae44f2c44fdd7</data>
    </node>
    <node id="Clinical Staging">
      <data key="d0">Clinical Staging</data>
      <data key="d1">category</data>
      <data key="d2">A pre-treatment assessment process used to estimate how far ovarian cancer has spread before surgical confirmation.</data>
      <data key="d3">chunk-e5406c28b41e499fad4ae44f2c44fdd7</data>
    </node>
    <node id="Ascites">
      <data key="d0">Ascites</data>
      <data key="d1">category</data>
      <data key="d2">A condition involving abnormal fluid buildup in the abdomen or around the ovaries, assessed during physical examinations for ovarian cancer.</data>
      <data key="d3">chunk-e5406c28b41e499fad4ae44f2c44fdd7</data>
    </node>
    <node id="Healthcare Provider">
      <data key="d0">Healthcare Provider</data>
      <data key="d1">person</data>
      <data key="d2">A medical professional or doctor who examines the patient, evaluates symptoms, performs pelvic exams, and orders diagnostic testing.</data>
      <data key="d3">chunk-e5406c28b41e499fad4ae44f2c44fdd7</data>
    </node>
    <node id="Genetic Counselor">
      <data key="d0">Genetic Counselor</data>
      <data key="d1">person</data>
      <data key="d2">A genetic counselor is a healthcare specialist who discusses family risk and coordinates testing for inherited cancer syndromes related to rectal cancer.&lt;SEP&gt;A healthcare professional specializing in genetics who evaluates familial risk, advises patients, and coordinates hereditary syndrome testing.&lt;SEP&gt;A healthcare specialist with expertise in genetic diseases who assists patients in deciding on germline testing and interpreting test results.&lt;SEP&gt;A medical specialist trained in genetic diseases who guides patients in choosing and interpreting germline tests for inherited cancer risks.&lt;SEP&gt;A specialized healthcare expert trained to assist patients in understanding gene mutations and hereditary disease risks.&lt;SEP&gt;A specialized healthcare professional with expertise in genetic diseases who guides patients through germline testing decisions and results interpretation.&lt;SEP&gt;A specialized healthcare provider who counsels patients on family history, hereditary risk, and genetic testing for inherited cancer conditions.&lt;SEP&gt;A trained healthcare professional who explains genetic testing results and counsels patients regarding hereditary cancer risk.&lt;SEP&gt;An expert who evaluates familial medical history and genetic risk factors to assess their potential implications for a patient's cancer care.</data>
      <data key="d3">chunk-789ec6c06f8c999ac21c89b085b3fdb7&lt;SEP&gt;chunk-85e75e869fcfcb7c5431dbcdd532137f&lt;SEP&gt;chunk-7a890e27eba8c63d10f19b85a72fc14a&lt;SEP&gt;chunk-ae40f53e9d867c255e1e6901f5cfb058&lt;SEP&gt;chunk-965e5a6bad03f2129a98be4373f99176&lt;SEP&gt;chunk-925a474b4538dda470bfd817f9d9a17d&lt;SEP&gt;chunk-fc469adbdd7a41816d59f249439bc726&lt;SEP&gt;chunk-650982a589c2d527bc13923ccd0569ef&lt;SEP&gt;chunk-dea00cf063e8831db4919330d94b1f2a</data>
    </node>
    <node id="Hereditary Ovarian Cancer">
      <data key="d0">Hereditary Ovarian Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A subtype of ovarian cancer caused by inherited genetic mutations passed down from parent to child.</data>
      <data key="d3">chunk-ae40f53e9d867c255e1e6901f5cfb058</data>
    </node>
    <node id="BRCA Mutation">
      <data key="d0">BRCA Mutation</data>
      <data key="d1">category</data>
      <data key="d2">A BRCA mutation is a genetic alteration that impairs DNA repair and enhances tumor sensitivity to PARP inhibitor maintenance therapies.&lt;SEP&gt;A critical genetic mutation biomarker in DNA repair genes that influences ovarian cancer treatment planning and signifies homologous recombination deficiency.&lt;SEP&gt;Genetic alterations in BRCA1 or BRCA2 that guide maintenance therapy choices, particularly PARP inhibitor eligibility.&lt;SEP&gt;Genetic alterations in the BRCA1 or BRCA2 genes that significantly increase the risk of developing hereditary ovarian and breast cancers.</data>
      <data key="d3">chunk-96238b4b361e393ff452a09d1ce26154&lt;SEP&gt;chunk-ae40f53e9d867c255e1e6901f5cfb058&lt;SEP&gt;chunk-c622c677deca24391324ecd5f16ce4a3&lt;SEP&gt;chunk-8b44f0b4da13a804cd1dfb917ac7e981</data>
    </node>
    <node id="Chest X-ray">
      <data key="d0">Chest X-ray</data>
      <data key="d1">event</data>
      <data key="d2">A fast, painless imaging test using low amounts of radiation to check whether cancer has spread to the lungs.</data>
      <data key="d3">chunk-ae40f53e9d867c255e1e6901f5cfb058</data>
    </node>
    <node id="Diagnostic Laparoscopy">
      <data key="d0">Diagnostic Laparoscopy</data>
      <data key="d1">event</data>
      <data key="d2">A minimally invasive surgical procedure used to visually evaluate the extent of cancer within the abdomen and collect tissue samples.</data>
      <data key="d3">chunk-ae40f53e9d867c255e1e6901f5cfb058</data>
    </node>
    <node id="Sedative">
      <data key="d0">Sedative</data>
      <data key="d1">category</data>
      <data key="d2">A class of medication administered to patients to relieve anxiety and promote relaxation during medical procedures in enclosed spaces.</data>
      <data key="d3">chunk-ae40f53e9d867c255e1e6901f5cfb058</data>
    </node>
    <node id="Fine-Needle Aspiration Biopsy">
      <data key="d0">Fine-Needle Aspiration Biopsy</data>
      <data key="d1">event</data>
      <data key="d2">A minimally invasive biopsy technique that utilizes a thin needle to extract a small sample of tumor tissue for pathological testing.</data>
      <data key="d3">chunk-ae40f53e9d867c255e1e6901f5cfb058</data>
    </node>
    <node id="Core Biopsy">
      <data key="d0">Core Biopsy</data>
      <data key="d1">event</data>
      <data key="d2">A biopsy procedure utilizing a hollow needle to remove cylindrical tissue samples from suspicious lesions.</data>
      <data key="d3">chunk-ae40f53e9d867c255e1e6901f5cfb058</data>
    </node>
    <node id="Paracentesis">
      <data key="d0">Paracentesis</data>
      <data key="d1">event</data>
      <data key="d2">A procedural aspiration where a thin needle is inserted through the belly wall to draw peritoneal fluid for diagnostic evaluation.</data>
      <data key="d3">chunk-ae40f53e9d867c255e1e6901f5cfb058</data>
    </node>
    <node id="Maintenance Therapy">
      <data key="d0">Maintenance Therapy</data>
      <data key="d1">category</data>
      <data key="d2">A course of medical treatment administered following primary therapy to prevent cancer progression, relapse, or recurrence.&lt;SEP&gt;A phase of extended cancer treatment designed to prevent recurrence, frequently guided by BRCA mutation status.&lt;SEP&gt;A post-treatment regimen administered for advanced ovarian cancers after effective initial surgery and chemotherapy.&lt;SEP&gt;An extended phase of cancer treatment prescribed after successful primary chemotherapy to sustain disease remission.&lt;SEP&gt;Maintenance therapy consists of periodic scheduled cancer treatments given over months or years to prevent tumor recurrence.&lt;SEP&gt;Maintenance therapy is a systemic treatment category administered after successful initial response to chemotherapy and surgery to prevent recurrence or prolong disease-free survival.&lt;SEP&gt;Ongoing therapeutic regimens administered following initial cancer treatments, often selected based on tumor biomarker characteristics such as BRCA or HRD.</data>
      <data key="d3">chunk-b69d38fafe014cece3427bd0459ae42b&lt;SEP&gt;chunk-77ac570b4029abb181150e0d0975aefb&lt;SEP&gt;chunk-96238b4b361e393ff452a09d1ce26154&lt;SEP&gt;chunk-ae40f53e9d867c255e1e6901f5cfb058&lt;SEP&gt;chunk-c622c677deca24391324ecd5f16ce4a3&lt;SEP&gt;chunk-8b44f0b4da13a804cd1dfb917ac7e981&lt;SEP&gt;chunk-b0a584e54ffa22e1c25f839302bcd727</data>
    </node>
    <node id="Hereditary Cancer">
      <data key="d0">Hereditary Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A group of cancers caused by inherited genetic mutations, including mutations in the BRCA genes.</data>
      <data key="d3">chunk-96238b4b361e393ff452a09d1ce26154</data>
    </node>
    <node id="Homologous Recombination Deficiency (HRD)">
      <data key="d0">Homologous Recombination Deficiency (HRD)</data>
      <data key="d1">category</data>
      <data key="d2">A DNA repair deficiency condition in tumors, occurring with or without BRCA mutations, used to determine eligibility for maintenance therapies.</data>
      <data key="d3">chunk-96238b4b361e393ff452a09d1ce26154</data>
    </node>
    <node id="Tumor Markers">
      <data key="d0">Tumor Markers</data>
      <data key="d1">category</data>
      <data key="d2">Proteins such as CEA and CA 15-3 found in blood or biopsy tissue that may indicate cancer progression or growth.&lt;SEP&gt;Substances found in blood or body tissues, such as CA-125, inhibin, and AFP, used to assist in diagnosing ovarian cancer and monitoring therapeutic response.</data>
      <data key="d3">chunk-96238b4b361e393ff452a09d1ce26154&lt;SEP&gt;chunk-650982a589c2d527bc13923ccd0569ef</data>
    </node>
    <node id="Gastrointestinal Tract Examination">
      <data key="d0">Gastrointestinal Tract Examination</data>
      <data key="d1">category</data>
      <data key="d2">Endoscopic procedures, including colonoscopy and upper endoscopy, utilized to evaluate the digestive system using illuminated camera scopes.</data>
      <data key="d3">chunk-96238b4b361e393ff452a09d1ce26154</data>
    </node>
    <node id="Initial Surgery">
      <data key="d0">Initial Surgery</data>
      <data key="d1">event</data>
      <data key="d2">The primary surgical procedure during which tumor resection and diagnostic biopsies for ovarian cancer are typically conducted.</data>
      <data key="d3">chunk-96238b4b361e393ff452a09d1ce26154</data>
    </node>
    <node id="Registered Dietitian Or Nutritionist">
      <data key="d0">Registered Dietitian Or Nutritionist</data>
      <data key="d1">category</data>
      <data key="d2">A healthcare professional specializing in diet and nutritional planning to optimize patient recovery and treatment outcomes.</data>
      <data key="d3">chunk-96238b4b361e393ff452a09d1ce26154</data>
    </node>
    <node id="Colonoscopy">
      <data key="d0">Colonoscopy</data>
      <data key="d1">event</data>
      <data key="d2">A colonoscopy is a medical examination procedure during which polyps in the colon and rectum can be identified and removed via polypectomy.&lt;SEP&gt;A colonoscopy is an endoscopic medical examination of the colon during which polyps can be detected and removed.&lt;SEP&gt;A colonoscopy is an endoscopic procedure used to examine the colon and rectum, perform polypectomies, and monitor for cancer recurrence during surveillance.&lt;SEP&gt;A diagnostic endoscopic examination where a scope is inserted into the anus to evaluate the rectum and colon.&lt;SEP&gt;A medical examination procedure used to detect, diagnose, and remove polyps or tumors in the colon.&lt;SEP&gt;An endoscopic examination recommended one year following surgical resection for stage 1 colon cancer to monitor for recurrence.&lt;SEP&gt;An endoscopic medical examination of the colon recommended at set intervals for post-treatment surveillance in colon cancer patients.&lt;SEP&gt;An endoscopic screening and surveillance procedure recommended at intervals of 3 to 5 years following rectal cancer treatments.&lt;SEP&gt;An examination procedure used to inspect the colon and rectum and safely remove polyps.</data>
      <data key="d3">chunk-85e75e869fcfcb7c5431dbcdd532137f&lt;SEP&gt;chunk-bb68daec67dd8f436d82814b0e61ff21&lt;SEP&gt;chunk-96238b4b361e393ff452a09d1ce26154&lt;SEP&gt;chunk-c1c1687a8a20b9c451956cf8bba241cc&lt;SEP&gt;chunk-925a474b4538dda470bfd817f9d9a17d&lt;SEP&gt;chunk-37bca9f4d2ebaeed359c9b4eb7a0c1de&lt;SEP&gt;chunk-c9383db20cd696688798a193862cb5cc&lt;SEP&gt;chunk-f2c9770fd98dbbe3c7947601fb3e654c&lt;SEP&gt;chunk-b5cfcc365cd093374564eb27dcbf5b82</data>
    </node>
    <node id="Upper Endoscopy">
      <data key="d0">Upper Endoscopy</data>
      <data key="d1">event</data>
      <data key="d2">An endoscopic imaging procedure where a scope is guided down the throat to inspect the esophagus, stomach, and small bowel.</data>
      <data key="d3">chunk-96238b4b361e393ff452a09d1ce26154</data>
    </node>
    <node id="Complete Blood Count (CBC)">
      <data key="d0">Complete Blood Count (CBC)</data>
      <data key="d1">category</data>
      <data key="d2">A diagnostic blood test measuring red blood cells, white blood cells, and platelets to evaluate general physiological status, infection fighting, and bleeding control.&lt;SEP&gt;A standard blood screening test that measures white blood cells, red blood cells, and platelets, often paired with a differential to assess blood cell balance.&lt;SEP&gt;A standard blood test analyzing red blood cells, white blood cells, and platelets as part of baseline medical evaluation.</data>
      <data key="d3">chunk-96238b4b361e393ff452a09d1ce26154&lt;SEP&gt;chunk-717174ace5855cc823d51c46c9a70648&lt;SEP&gt;chunk-5846f51c2ca4fae54459ce9c50e3e820</data>
    </node>
    <node id="Blood Chemistry Profile">
      <data key="d0">Blood Chemistry Profile</data>
      <data key="d1">category</data>
      <data key="d2">A blood evaluation testing chemical concentrations related to organ function, bone health, and nutritional intake like protein levels.&lt;SEP&gt;A diagnostic blood test measuring levels of various chemicals to evaluate organ function and identify potential cancer spread.</data>
      <data key="d3">chunk-96238b4b361e393ff452a09d1ce26154&lt;SEP&gt;chunk-27b3a0f53b4be1d525497f87555d7a06</data>
    </node>
    <node id="CA-125 Test">
      <data key="d0">CA-125 Test</data>
      <data key="d1">category</data>
      <data key="d2">The primary tumor marker test for ovarian cancer, measuring cancer antigen-125 protein levels in the bloodstream.</data>
      <data key="d3">chunk-96238b4b361e393ff452a09d1ce26154</data>
    </node>
    <node id="Less Common Ovarian Cancers (LCOCs)">
      <data key="d0">Less Common Ovarian Cancers (LCOCs)</data>
      <data key="d1">category</data>
      <data key="d2">A subclass of rare ovarian malignant tumors frequently monitored by specialized tumor markers like inhibin, β-hCG, and AFP.</data>
      <data key="d3">chunk-96238b4b361e393ff452a09d1ce26154</data>
    </node>
    <node id="Recurrent Ovarian Cancer">
      <data key="d0">Recurrent Ovarian Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A clinical presentation where ovarian malignancy returns following initial therapy, warranting expanded biomarker and molecular testing.&lt;SEP&gt;The return or relapse of ovarian cancer after initial treatment, requiring biomarker profiling and tailored therapeutic approaches.</data>
      <data key="d3">chunk-96238b4b361e393ff452a09d1ce26154&lt;SEP&gt;chunk-c622c677deca24391324ecd5f16ce4a3</data>
    </node>
    <node id="Endometriosis">
      <data key="d0">Endometriosis</data>
      <data key="d1">category</data>
      <data key="d2">A non-malignant gynecological disorder capable of elevating CA-125 levels, complicating ovarian cancer differential diagnosis.</data>
      <data key="d3">chunk-96238b4b361e393ff452a09d1ce26154</data>
    </node>
    <node id="Diverticulitis">
      <data key="d0">Diverticulitis</data>
      <data key="d1">category</data>
      <data key="d2">An inflammatory gastrointestinal condition that can benignly elevate serum CA-125 concentrations.</data>
      <data key="d3">chunk-96238b4b361e393ff452a09d1ce26154</data>
    </node>
    <node id="Hysterectomy and Bilateral Salpingo-Oophorectomy (BSO)">
      <data key="d0">Hysterectomy and Bilateral Salpingo-Oophorectomy (BSO)</data>
      <data key="d1">category</data>
      <data key="d2">The most common surgical procedure for ovarian cancer, involving the removal of the uterus, cervix, both ovaries, and both fallopian tubes.</data>
      <data key="d3">chunk-77ac570b4029abb181150e0d0975aefb</data>
    </node>
    <node id="Fertility-Sparing Surgery">
      <data key="d0">Fertility-Sparing Surgery</data>
      <data key="d1">category</data>
      <data key="d2">A surgical approach, such as unilateral salpingo-oophorectomy, that preserves the uterus and allows potential future pregnancy in early-stage disease.</data>
      <data key="d3">chunk-77ac570b4029abb181150e0d0975aefb</data>
    </node>
    <node id="Cytoreductive Surgery">
      <data key="d0">Cytoreductive Surgery</data>
      <data key="d1">category</data>
      <data key="d2">Also referred to as debulking surgery, this procedure aims to remove as much metastatic tumor tissue as possible when cancer has spread beyond the ovaries.</data>
      <data key="d3">chunk-77ac570b4029abb181150e0d0975aefb</data>
    </node>
    <node id="Surgical Staging">
      <data key="d0">Surgical Staging</data>
      <data key="d1">event</data>
      <data key="d2">A comprehensive surgical procedure to sample tissues and organs across the abdomen and pelvis to accurately determine the extent of cancer spread.&lt;SEP&gt;A diagnostic staging system (Stage I, II, or III) based on pathologic analysis of tumor depth and lymph node involvement following surgery.&lt;SEP&gt;A minimally invasive surgical procedure used to remove and examine pelvic and para-aortic lymph nodes to guide radiation and systemic therapy.&lt;SEP&gt;An operative assessment involving tissue and fluid sampling to determine the accurate post-surgery pathologic stage of ovarian cancer.</data>
      <data key="d3">chunk-cf2d987135a5936876bc819136e3a5b5&lt;SEP&gt;chunk-77ac570b4029abb181150e0d0975aefb&lt;SEP&gt;chunk-37bca9f4d2ebaeed359c9b4eb7a0c1de&lt;SEP&gt;chunk-e247ae57c50c62bded7114986471226e</data>
    </node>
    <node id="Laparotomy">
      <data key="d0">Laparotomy</data>
      <data key="d1">category</data>
      <data key="d2">A surgical approach involving an extensive vertical abdominal incision, commonly utilized for comprehensive staging and debulking procedures.&lt;SEP&gt;A surgical procedure involving a traditional large abdominal incision to access pelvic organs.</data>
      <data key="d3">chunk-77ac570b4029abb181150e0d0975aefb&lt;SEP&gt;chunk-e9a7fe3b15f3289198c7114b44890dea</data>
    </node>
    <node id="Laparoscopy">
      <data key="d0">Laparoscopy</data>
      <data key="d1">category</data>
      <data key="d2">A minimally invasive surgical technique performed through small abdominal incisions, utilized in select, localized ovarian cancer cases.</data>
      <data key="d3">chunk-77ac570b4029abb181150e0d0975aefb</data>
    </node>
    <node id="BRCA Genes">
      <data key="d0">BRCA Genes</data>
      <data key="d1">category</data>
      <data key="d2">Genes involved in DNA repair whose inherited mutations represent the most common cause of hereditary ovarian cancer.</data>
      <data key="d3">chunk-77ac570b4029abb181150e0d0975aefb</data>
    </node>
    <node id="Microsatellite Instability (MSI)">
      <data key="d0">Microsatellite Instability (MSI)</data>
      <data key="d1">category</data>
      <data key="d2">A condition of genetic hypermutability identified through molecular biomarker testing.&lt;SEP&gt;A molecular marker reflecting defective DNA mismatch repair, evaluated via tumor tissue testing to guide targeted therapy.</data>
      <data key="d3">chunk-77ac570b4029abb181150e0d0975aefb&lt;SEP&gt;chunk-b3ba7430f3a31330247f52afe7e9c68a</data>
    </node>
    <node id="Mismatch Repair (MMR)">
      <data key="d0">Mismatch Repair (MMR)</data>
      <data key="d1">category</data>
      <data key="d2">A biological mechanism responsible for repairing DNA replication errors; tested on tumor tissue to inform treatment options.&lt;SEP&gt;A cellular DNA repair mechanism evaluated as a biomarker in recurrent cervical cancer.</data>
      <data key="d3">chunk-77ac570b4029abb181150e0d0975aefb&lt;SEP&gt;chunk-b3ba7430f3a31330247f52afe7e9c68a</data>
    </node>
    <node id="HER2 Expression">
      <data key="d0">HER2 Expression</data>
      <data key="d1">category</data>
      <data key="d2">A molecular biomarker tested on tumor tissue to evaluate cancer characteristics and targeted treatment eligibility.</data>
      <data key="d3">chunk-77ac570b4029abb181150e0d0975aefb</data>
    </node>
    <node id="Tumor Mutational Burden (TMB)">
      <data key="d0">Tumor Mutational Burden (TMB)</data>
      <data key="d1">category</data>
      <data key="d2">A genomic biomarker measuring the total number of mutations present in tumor tissue to help determine therapy options.&lt;SEP&gt;A genomic biomarker measuring the total number of mutations present in tumor tissue.</data>
      <data key="d3">chunk-77ac570b4029abb181150e0d0975aefb&lt;SEP&gt;chunk-b3ba7430f3a31330247f52afe7e9c68a</data>
    </node>
    <node id="BRAF V600E Mutation">
      <data key="d0">BRAF V600E Mutation</data>
      <data key="d1">category</data>
      <data key="d2">A specific genetic mutation tested in removed tumor tissue to guide personalized cancer treatment.</data>
      <data key="d3">chunk-77ac570b4029abb181150e0d0975aefb</data>
    </node>
    <node id="Folate Receptor Alpha (FRα) Expression">
      <data key="d0">Folate Receptor Alpha (FRα) Expression</data>
      <data key="d1">category</data>
      <data key="d2">A tumor tissue biomarker evaluated in ovarian cancer to identify eligibility for targeted therapies.</data>
      <data key="d3">chunk-77ac570b4029abb181150e0d0975aefb</data>
    </node>
    <node id="RET Mutations">
      <data key="d0">RET Mutations</data>
      <data key="d1">category</data>
      <data key="d2">Genetic alterations evaluated via tumor biomarker testing to inform targeted therapeutic strategies.</data>
      <data key="d3">chunk-77ac570b4029abb181150e0d0975aefb</data>
    </node>
    <node id="NTRK Gene Fusion">
      <data key="d0">NTRK Gene Fusion</data>
      <data key="d1">category</data>
      <data key="d2">A genetic alteration evaluated in cervical sarcoma to guide targeted therapeutic options.&lt;SEP&gt;A genomic alteration evaluated through tumor tissue testing that can guide targeted oncologic treatment.</data>
      <data key="d3">chunk-77ac570b4029abb181150e0d0975aefb&lt;SEP&gt;chunk-b3ba7430f3a31330247f52afe7e9c68a</data>
    </node>
    <node id="Unilateral Salpingo-Oophorectomy (USO)">
      <data key="d0">Unilateral Salpingo-Oophorectomy (USO)</data>
      <data key="d1">category</data>
      <data key="d2">A fertility-sparing surgical procedure removing one ovary and fallopian tube in appropriate early-stage ovarian cancer cases.</data>
      <data key="d3">chunk-77ac570b4029abb181150e0d0975aefb</data>
    </node>
    <node id="In Vitro Fertilization (IVF)">
      <data key="d0">In Vitro Fertilization (IVF)</data>
      <data key="d1">category</data>
      <data key="d2">An assisted reproductive technology using patient or donor eggs to achieve pregnancy following fertility-sparing procedures or BSO.</data>
      <data key="d3">chunk-77ac570b4029abb181150e0d0975aefb</data>
    </node>
    <node id="American Joint Committee on Cancer">
      <data key="d0">American Joint Committee on Cancer</data>
      <data key="d1">organization</data>
      <data key="d2">An organization that developed a standardized staging system to describe the extent of cancer in the body, including ovarian cancer.&lt;SEP&gt;The American Joint Committee on Cancer (AJCC) is an organization that developed a standardized cancer staging system to determine cancer extent, location, and subtype.&lt;SEP&gt;The American Joint Committee on Cancer (AJCC) is an organization that developed the TNM staging system used for staging anal cancer, including anal canal and perianal tumors.&lt;SEP&gt;The American Joint Committee on Cancer (AJCC) is an organization that developed the tumor, node, metastasis (TNM) staging system used to classify colon cancer.&lt;SEP&gt;The American Joint Committee on Cancer (AJCC) is an organization that formulated a standardized staging system to evaluate the extent, location, and subtype of cancer.</data>
      <data key="d3">chunk-3f05c8ea6f7c7b4ba1fb0ff1c1733980&lt;SEP&gt;chunk-cf2d987135a5936876bc819136e3a5b5&lt;SEP&gt;chunk-c1c1687a8a20b9c451956cf8bba241cc&lt;SEP&gt;chunk-fc469adbdd7a41816d59f249439bc726&lt;SEP&gt;chunk-a18089523f6dcd63cfa5664dc1c01618</data>
    </node>
    <node id="International Federation of Gynecology and Obstetrics">
      <data key="d0">International Federation of Gynecology and Obstetrics</data>
      <data key="d1">organization</data>
      <data key="d2">An international medical organization that established the widely used FIGO staging system for ovarian cancer.&lt;SEP&gt;An international organization that created and maintains the FIGO staging system used globally to stage cervical cancer.</data>
      <data key="d3">chunk-cf2d987135a5936876bc819136e3a5b5&lt;SEP&gt;chunk-db3a86fc5d439d9bfb3845e468a2a551</data>
    </node>
    <node id="FIGO Staging System">
      <data key="d0">FIGO Staging System</data>
      <data key="d1">category</data>
      <data key="d2">A clinical staging classification system developed by FIGO with four primary stages (I to IV) used to determine the extent of cervical cancer.&lt;SEP&gt;A standard cancer classification system established by FIGO that defines ovarian cancer stage according to primary tumor extent, lymph node spread, and distant metastases.</data>
      <data key="d3">chunk-cf2d987135a5936876bc819136e3a5b5&lt;SEP&gt;chunk-db3a86fc5d439d9bfb3845e468a2a551</data>
    </node>
    <node id="AJCC Staging System">
      <data key="d0">AJCC Staging System</data>
      <data key="d1">category</data>
      <data key="d2">A standardized cancer classification system developed by the American Joint Committee on Cancer for evaluating cancer extent.</data>
      <data key="d3">chunk-cf2d987135a5936876bc819136e3a5b5</data>
    </node>
    <node id="Surgical Menopause">
      <data key="d0">Surgical Menopause</data>
      <data key="d1">category</data>
      <data key="d2">A condition of premature menopause induced by the surgical removal of both ovaries, causing a rapid decrease in estrogen levels.&lt;SEP&gt;A sudden, severe menopausal state induced when both ovaries are surgically removed during treatment, leading to an immediate decline in estrogen.</data>
      <data key="d3">chunk-cf2d987135a5936876bc819136e3a5b5&lt;SEP&gt;chunk-e9a7fe3b15f3289198c7114b44890dea</data>
    </node>
    <node id="Deep Vein Thrombosis">
      <data key="d0">Deep Vein Thrombosis</data>
      <data key="d1">category</data>
      <data key="d2">A medical condition involving blood clots, identified as a significant risk after major abdominal cancer surgery.</data>
      <data key="d3">chunk-cf2d987135a5936876bc819136e3a5b5</data>
    </node>
    <node id="Ovarian Cancer Surgery">
      <data key="d0">Ovarian Cancer Surgery</data>
      <data key="d1">event</data>
      <data key="d2">A surgical operation aimed at resecting cancerous tissue, ovaries, uterus, fallopian tubes, omentum, and lymph nodes, as well as providing pathologic staging.</data>
      <data key="d3">chunk-cf2d987135a5936876bc819136e3a5b5</data>
    </node>
    <node id="Interval Cytoreductive Surgery">
      <data key="d0">Interval Cytoreductive Surgery</data>
      <data key="d1">event</data>
      <data key="d2">A surgical procedure conducted after preliminary chemotherapy cycles to debulk remaining ovarian cancer.</data>
      <data key="d3">chunk-cf2d987135a5936876bc819136e3a5b5</data>
    </node>
    <node id="Peritoneal Washing">
      <data key="d0">Peritoneal Washing</data>
      <data key="d1">event</data>
      <data key="d2">A procedure during surgery where the abdominal cavity is rinsed with fluid to collect and evaluate microscopic cancer cells.</data>
      <data key="d3">chunk-cf2d987135a5936876bc819136e3a5b5</data>
    </node>
    <node id="Menopausal Symptom Team">
      <data key="d0">Menopausal Symptom Team</data>
      <data key="d1">organization</data>
      <data key="d2">A specialized group of healthcare providers recommended to consult with patients regarding surgical menopause and hormone replacement therapy options.</data>
      <data key="d3">chunk-cf2d987135a5936876bc819136e3a5b5</data>
    </node>
    <node id="Microscopic Metastases">
      <data key="d0">Microscopic Metastases</data>
      <data key="d1">category</data>
      <data key="d2">Cancer cells that have spread beyond the primary pelvic or ovarian site and can only be detected under a microscope.</data>
      <data key="d3">chunk-cf2d987135a5936876bc819136e3a5b5</data>
    </node>
    <node id="Cardiovascular Disease">
      <data key="d0">Cardiovascular Disease</data>
      <data key="d1">category</data>
      <data key="d2">A category of diseases affecting the heart and blood vessels, noted as a long-term risk associated with insufficient estrogen.&lt;SEP&gt;Heart and blood vessel conditions representing long-term health risks resulting from estrogen deficiency following surgical menopause.</data>
      <data key="d3">chunk-cf2d987135a5936876bc819136e3a5b5&lt;SEP&gt;chunk-c9bfa651267335dd5e6ae5a24d85a072</data>
    </node>
    <node id="Osteoporosis">
      <data key="d0">Osteoporosis</data>
      <data key="d1">category</data>
      <data key="d2">A bone-thinning condition representing a long-term risk of estrogen deprivation caused by surgical removal of both ovaries.&lt;SEP&gt;A condition characterized by bone loss, identified as a long-term risk of estrogen deficiency.</data>
      <data key="d3">chunk-cf2d987135a5936876bc819136e3a5b5&lt;SEP&gt;chunk-c9bfa651267335dd5e6ae5a24d85a072</data>
    </node>
    <node id="Vaginal Atrophy">
      <data key="d0">Vaginal Atrophy</data>
      <data key="d1">category</data>
      <data key="d2">A condition characterized by thinning, drying, and inflammation of vaginal tissues caused by estrogen deficiency following bilateral oophorectomy.&lt;SEP&gt;A medical condition where the vaginal lining becomes thin, dry, and inflamed, commonly linked to low estrogen levels.&lt;SEP&gt;Thinning, drying, and inflammation of the vaginal lining caused by sudden estrogen reduction following surgical menopause.</data>
      <data key="d3">chunk-cf2d987135a5936876bc819136e3a5b5&lt;SEP&gt;chunk-e9a7fe3b15f3289198c7114b44890dea&lt;SEP&gt;chunk-c9bfa651267335dd5e6ae5a24d85a072</data>
    </node>
    <node id="Hormone Replacement Therapy">
      <data key="d0">Hormone Replacement Therapy</data>
      <data key="d1">category</data>
      <data key="d2">A medical treatment providing exogenous hormones to manage severe symptoms and risks associated with surgical menopause.&lt;SEP&gt;A therapeutic category distinct from cancer endocrine therapy, specifically used to manage symptoms associated with menopause.</data>
      <data key="d3">chunk-cf2d987135a5936876bc819136e3a5b5&lt;SEP&gt;chunk-e45947107c74d8a06e350be57a94a408</data>
    </node>
    <node id="Hyperthermic Intraperitoneal Chemotherapy">
      <data key="d0">Hyperthermic Intraperitoneal Chemotherapy</data>
      <data key="d1">event</data>
      <data key="d2">An intraoperative procedure where heated chemotherapy is circulated within the abdominal cavity during interval cytoreductive surgery for stage 3 ovarian cancer.</data>
      <data key="d3">chunk-cf2d987135a5936876bc819136e3a5b5</data>
    </node>
    <node id="FIGO">
      <data key="d0">FIGO</data>
      <data key="d1">organization</data>
      <data key="d2">The International Federation of Gynecology and Obstetrics (FIGO) provides the classification system used worldwide to stage cervical cancer.&lt;SEP&gt;The International Federation of Gynecology and Obstetrics (FIGO), an organization that establishes the standard staging system used to classify ovarian cancer.</data>
      <data key="d3">chunk-b69d38fafe014cece3427bd0459ae42b&lt;SEP&gt;chunk-e9a7fe3b15f3289198c7114b44890dea</data>
    </node>
    <node id="Stage 1 Ovarian Cancer">
      <data key="d0">Stage 1 Ovarian Cancer</data>
      <data key="d1">category</data>
      <data key="d2">An early-stage category of ovarian cancer where the disease is confined to one or both ovaries, subdivided into substages 1A, 1B, and 1C.</data>
      <data key="d3">chunk-b69d38fafe014cece3427bd0459ae42b</data>
    </node>
    <node id="Stage 2 Ovarian Cancer">
      <data key="d0">Stage 2 Ovarian Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A specific stage of ovarian cancer with limited existing research regarding post-initial treatment maintenance therapy using PARP inhibitors.&lt;SEP&gt;A staging category where ovarian cancer involves one or both ovaries and has extended or spread into pelvic organs such as the uterus, fallopian tubes, bladder, or rectum.</data>
      <data key="d3">chunk-b69d38fafe014cece3427bd0459ae42b&lt;SEP&gt;chunk-c622c677deca24391324ecd5f16ce4a3</data>
    </node>
    <node id="Stage 3 Ovarian Cancer">
      <data key="d0">Stage 3 Ovarian Cancer</data>
      <data key="d1">category</data>
      <data key="d2">An advanced staging category where ovarian cancer has spread to the retroperitoneal lymph nodes, abdominal lining, or surface of the liver or spleen.</data>
      <data key="d3">chunk-b69d38fafe014cece3427bd0459ae42b</data>
    </node>
    <node id="Stage 4 Ovarian Cancer">
      <data key="d0">Stage 4 Ovarian Cancer</data>
      <data key="d1">category</data>
      <data key="d2">The most advanced staging category of ovarian cancer characterized by distant metastases, such as malignant pleural effusion or parenchymal liver and spleen metastases.</data>
      <data key="d3">chunk-b69d38fafe014cece3427bd0459ae42b</data>
    </node>
    <node id="Taxanes">
      <data key="d0">Taxanes</data>
      <data key="d1">category</data>
      <data key="d2">A class of chemotherapy drugs that includes docetaxel, paclitaxel, and albumin-bound paclitaxel.&lt;SEP&gt;A class of chemotherapy medications, including paclitaxel and docetaxel, commonly combined with platinum agents to treat ovarian cancer.</data>
      <data key="d3">chunk-b69d38fafe014cece3427bd0459ae42b&lt;SEP&gt;chunk-9040f5949ae0ff36ce88faa1f4b67ead</data>
    </node>
    <node id="Oxaliplatin">
      <data key="d0">Oxaliplatin</data>
      <data key="d1">category</data>
      <data key="d2">A platinum-containing chemotherapy medication used in cancer treatment regimens.</data>
      <data key="d3">chunk-b69d38fafe014cece3427bd0459ae42b</data>
    </node>
    <node id="Paclitaxel">
      <data key="d0">Paclitaxel</data>
      <data key="d1">category</data>
      <data key="d2">A taxane chemotherapy drug commonly administered with carboplatin for ovarian cancer, known for causing peripheral neuropathy.</data>
      <data key="d3">chunk-b69d38fafe014cece3427bd0459ae42b</data>
    </node>
    <node id="Docetaxel">
      <data key="d0">Docetaxel</data>
      <data key="d1">category</data>
      <data key="d2">A taxane class chemotherapy drug used in systemic cancer treatment regimens.</data>
      <data key="d3">chunk-b69d38fafe014cece3427bd0459ae42b</data>
    </node>
    <node id="Bevacizumab">
      <data key="d0">Bevacizumab</data>
      <data key="d1">category</data>
      <data key="d2">A targeted therapy medication that may be added to chemotherapy and continued alone as maintenance therapy.&lt;SEP&gt;A targeted therapy medication, also known as Avastin, that inhibits the formation of new blood vessels supplying tumor cells and can be added to chemotherapy regimens.&lt;SEP&gt;Bevacizumab (Avastin) is a targeted therapy drug that inhibits the growth of new blood vessels feeding tumors, used alongside chemotherapy or as maintenance therapy.</data>
      <data key="d3">chunk-b69d38fafe014cece3427bd0459ae42b&lt;SEP&gt;chunk-c622c677deca24391324ecd5f16ce4a3&lt;SEP&gt;chunk-8b44f0b4da13a804cd1dfb917ac7e981</data>
    </node>
    <node id="Peripheral Neuropathy">
      <data key="d0">Peripheral Neuropathy</data>
      <data key="d1">category</data>
      <data key="d2">A neurological condition and common adverse effect of paclitaxel characterized by nerve damage, tingling, numbness, and pain in the hands and feet.</data>
      <data key="d3">chunk-b69d38fafe014cece3427bd0459ae42b</data>
    </node>
    <node id="Neoadjuvant Therapy">
      <data key="d0">Neoadjuvant Therapy</data>
      <data key="d1">category</data>
      <data key="d2">Preoperative systemic treatment administered before surgical intervention to shrink the tumor and reduce cancer burden.&lt;SEP&gt;Systemic cancer treatment such as chemotherapy administered before surgical intervention to reduce tumor volume.</data>
      <data key="d3">chunk-b69d38fafe014cece3427bd0459ae42b&lt;SEP&gt;chunk-9040f5949ae0ff36ce88faa1f4b67ead</data>
    </node>
    <node id="Adjuvant Chemotherapy">
      <data key="d0">Adjuvant Chemotherapy</data>
      <data key="d1">category</data>
      <data key="d2">Systemic chemotherapy administered following surgical resection to destroy remaining cancer cells and reduce recurrence risk.</data>
      <data key="d3">chunk-b69d38fafe014cece3427bd0459ae42b</data>
    </node>
    <node id="High-Grade Serous Tumors">
      <data key="d0">High-Grade Serous Tumors</data>
      <data key="d1">category</data>
      <data key="d2">An aggressive histological subtype of ovarian tumors that typically requires six cycles of chemotherapy even when diagnosed at stage 1.</data>
      <data key="d3">chunk-b69d38fafe014cece3427bd0459ae42b</data>
    </node>
    <node id="Surgical Spill">
      <data key="d0">Surgical Spill</data>
      <data key="d1">event</data>
      <data key="d2">An intraoperative event occurring when the tumor capsule of an ovary ruptures or breaks open during surgical excision, designating stage 1C1.</data>
      <data key="d3">chunk-b69d38fafe014cece3427bd0459ae42b</data>
    </node>
    <node id="Stage 1C Ovarian Cancer">
      <data key="d0">Stage 1C Ovarian Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A substage of stage 1 ovarian cancer defined by capsule rupture, external surface involvement, or positive peritoneal washings.</data>
      <data key="d3">chunk-b69d38fafe014cece3427bd0459ae42b</data>
    </node>
    <node id="Stage 4A Ovarian Cancer">
      <data key="d0">Stage 4A Ovarian Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A substage of stage 4 ovarian cancer characterized by the presence of malignant cells in pleural effusion fluid around the lungs.</data>
      <data key="d3">chunk-b69d38fafe014cece3427bd0459ae42b</data>
    </node>
    <node id="Stage 4B Ovarian Cancer">
      <data key="d0">Stage 4B Ovarian Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A substage of stage 4 ovarian cancer involving metastasis to distant lymph nodes, inside the liver or spleen, or organs outside the peritoneal cavity.</data>
      <data key="d3">chunk-b69d38fafe014cece3427bd0459ae42b</data>
    </node>
    <node id="Intravenous Chemotherapy">
      <data key="d0">Intravenous Chemotherapy</data>
      <data key="d1">category</data>
      <data key="d2">Intravenous chemotherapy is a route of chemotherapy administration where medication is delivered directly into the bloodstream through a vein or port.</data>
      <data key="d3">chunk-8b44f0b4da13a804cd1dfb917ac7e981</data>
    </node>
    <node id="Intraperitoneal Chemotherapy">
      <data key="d0">Intraperitoneal Chemotherapy</data>
      <data key="d1">category</data>
      <data key="d2">Intraperitoneal chemotherapy is a specialized drug administration method where high doses of chemotherapy are delivered directly into the abdomen via a catheter.</data>
      <data key="d3">chunk-8b44f0b4da13a804cd1dfb917ac7e981</data>
    </node>
    <node id="PARP Inhibitors">
      <data key="d0">PARP Inhibitors</data>
      <data key="d1">category</data>
      <data key="d2">A class of targeted cancer therapies that block the PARP repair protein, causing cancer cells with BRCA mutations to die.&lt;SEP&gt;A class of targeted pharmacological therapies used against cancers harboring specific molecular markers and DNA repair defects.&lt;SEP&gt;PARP inhibitors are a class of oral targeted maintenance medications, including olaparib, niraparib, and rucaparib, particularly effective in HRD-positive and BRCA-mutated cancers.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408&lt;SEP&gt;chunk-965e5a6bad03f2129a98be4373f99176&lt;SEP&gt;chunk-8b44f0b4da13a804cd1dfb917ac7e981</data>
    </node>
    <node id="Myelodysplastic Syndrome">
      <data key="d0">Myelodysplastic Syndrome</data>
      <data key="d1">category</data>
      <data key="d2">Myelodysplastic syndrome (MDS) is a rare bone marrow cancer characterized by inadequate production of healthy blood cells, which can progress to acute myeloid leukemia.</data>
      <data key="d3">chunk-8b44f0b4da13a804cd1dfb917ac7e981</data>
    </node>
    <node id="Olaparib">
      <data key="d0">Olaparib</data>
      <data key="d1">category</data>
      <data key="d2">A PARP inhibitor medication used as maintenance therapy for up to two years, either alone or combined with other therapies.&lt;SEP&gt;Olaparib (Lynparza) is an oral PARP inhibitor targeted therapy approved for maintenance treatment in ovarian cancer patients.</data>
      <data key="d3">chunk-c622c677deca24391324ecd5f16ce4a3&lt;SEP&gt;chunk-8b44f0b4da13a804cd1dfb917ac7e981</data>
    </node>
    <node id="Niraparib">
      <data key="d0">Niraparib</data>
      <data key="d1">category</data>
      <data key="d2">A PARP inhibitor medication that may be administered alone for up to three years as maintenance therapy.&lt;SEP&gt;Niraparib (Zejula) is an oral PARP inhibitor prescribed for maintenance therapy following initial chemotherapy.</data>
      <data key="d3">chunk-c622c677deca24391324ecd5f16ce4a3&lt;SEP&gt;chunk-8b44f0b4da13a804cd1dfb917ac7e981</data>
    </node>
    <node id="Rucaparib">
      <data key="d0">Rucaparib</data>
      <data key="d1">category</data>
      <data key="d2">A PARP inhibitor medication administered alone as maintenance therapy for up to two years.&lt;SEP&gt;Rucaparib (Rubraca) is an oral PARP inhibitor utilized as maintenance therapy after initial cancer treatment.</data>
      <data key="d3">chunk-c622c677deca24391324ecd5f16ce4a3&lt;SEP&gt;chunk-8b44f0b4da13a804cd1dfb917ac7e981</data>
    </node>
    <node id="Homologous Recombination Deficiency">
      <data key="d0">Homologous Recombination Deficiency</data>
      <data key="d1">category</data>
      <data key="d2">Homologous recombination deficiency (HRD) is a cellular characteristic of impaired DNA repair in cancers that predicts positive response to PARP inhibitors.</data>
      <data key="d3">chunk-8b44f0b4da13a804cd1dfb917ac7e981</data>
    </node>
    <node id="CA-125 Testing">
      <data key="d0">CA-125 Testing</data>
      <data key="d1">event</data>
      <data key="d2">CA-125 testing is a tumor marker blood evaluation conducted prior to each chemotherapy cycle to assess treatment response.</data>
      <data key="d3">chunk-8b44f0b4da13a804cd1dfb917ac7e981</data>
    </node>
    <node id="Observation">
      <data key="d0">Observation</data>
      <data key="d1">category</data>
      <data key="d2">Observation is a surveillance management strategy without active drug intervention, considered for specific patients showing complete response.</data>
      <data key="d3">chunk-8b44f0b4da13a804cd1dfb917ac7e981</data>
    </node>
    <node id="Platinum-Resistant Cancer">
      <data key="d0">Platinum-Resistant Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A classification of ovarian cancer that does not improve or worsens during platinum-based chemotherapy, or recurs within six months following treatment.</data>
      <data key="d3">chunk-c622c677deca24391324ecd5f16ce4a3</data>
    </node>
    <node id="Platinum-Sensitive Cancer">
      <data key="d0">Platinum-Sensitive Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A classification of ovarian cancer where complete remission is achieved and cancer returns more than six months following platinum-based chemotherapy.</data>
      <data key="d3">chunk-c622c677deca24391324ecd5f16ce4a3</data>
    </node>
    <node id="PARP Inhibitor">
      <data key="d0">PARP Inhibitor</data>
      <data key="d1">category</data>
      <data key="d2">A class of targeted maintenance therapies, including olaparib, niraparib, and rucaparib, used in the treatment and maintenance of ovarian cancer.</data>
      <data key="d3">chunk-c622c677deca24391324ecd5f16ce4a3</data>
    </node>
    <node id="Secondary Cytoreductive Surgery">
      <data key="d0">Secondary Cytoreductive Surgery</data>
      <data key="d1">event</data>
      <data key="d2">A surgical procedure performed in select cases of recurrent platinum-sensitive cancer to remove all visible tumor prior to systemic recurrence treatment.</data>
      <data key="d3">chunk-c622c677deca24391324ecd5f16ce4a3</data>
    </node>
    <node id="Throat Cancer">
      <data key="d0">Throat Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A form of cancer that forms in the throat or oropharynx, located in the back of the mouth and neck.&lt;SEP&gt;A malignancy developing in the head and neck, staged via clinical and pathologic metrics and influenced by HPV/p16 status.&lt;SEP&gt;A malignancy of the throat for which diagnostic endoscopy, biopsies, and p16 HPV testing are recommended.&lt;SEP&gt;A specific malignancy that originates in the oropharynx, primarily presenting as squamous cell carcinoma and affecting structures such as the soft palate, tonsils, throat walls, and tongue base.&lt;SEP&gt;A type of malignancy, specifically squamous cell carcinoma of the oropharynx, often linked to HPV infection and staged using p16 biomarker testing.&lt;SEP&gt;Throat (oropharyngeal) cancer is a malignancy affecting the pharynx and throat area, frequently staged using TNM classification and evaluated with p16 (HPV) testing.&lt;SEP&gt;Throat cancer is a head and neck malignancy frequently associated with Human papillomavirus (HPV) infection.</data>
      <data key="d3">chunk-5d8e20e6004dd43ae0f68185383b594d&lt;SEP&gt;chunk-f8639a06098656be20a04fe129660616&lt;SEP&gt;chunk-5a84075aaac61b0ad85e5f811fc4f24b&lt;SEP&gt;chunk-0739b33959299ea67072f390ce38bffd&lt;SEP&gt;chunk-c622c677deca24391324ecd5f16ce4a3&lt;SEP&gt;chunk-ea7b3f83164304ee4a562046eb0f5033&lt;SEP&gt;chunk-5fa7c7369d88ae71c842152510867223</data>
    </node>
    <node id="Ovarian Cancer Survivor">
      <data key="d0">Ovarian Cancer Survivor</data>
      <data key="d1">person</data>
      <data key="d2">An individual who experienced ovarian cancer and provided reflection on life-affirming personal growth following a life-altering cancer diagnosis.</data>
      <data key="d3">chunk-c622c677deca24391324ecd5f16ce4a3</data>
    </node>
    <node id="Non-Platinum Chemotherapy">
      <data key="d0">Non-Platinum Chemotherapy</data>
      <data key="d1">category</data>
      <data key="d2">Alternative chemotherapy regimens administered when ovarian cancer fails to respond to or recurs rapidly following platinum drugs.&lt;SEP&gt;Chemotherapy alternatives prescribed for individuals with kidney conditions or health issues that preclude platinum-based drugs.</data>
      <data key="d3">chunk-c622c677deca24391324ecd5f16ce4a3&lt;SEP&gt;chunk-48b513355d29308e212a3074ba326b10</data>
    </node>
    <node id="Mirvetuximab Soravtansine-Gynx">
      <data key="d0">Mirvetuximab Soravtansine-Gynx</data>
      <data key="d1">category</data>
      <data key="d2">An antibody-drug conjugate (ADC) targeted therapy preferred for recurrent ovarian tumors expressing the folate receptor alpha biomarker.</data>
      <data key="d3">chunk-c622c677deca24391324ecd5f16ce4a3</data>
    </node>
    <node id="Antibody Drug Conjugate">
      <data key="d0">Antibody Drug Conjugate</data>
      <data key="d1">category</data>
      <data key="d2">A class of targeted therapeutic agents combining monoclonal antibodies with cytotoxic drugs, exemplified by mirvetuximab soravtansine-gynx.</data>
      <data key="d3">chunk-c622c677deca24391324ecd5f16ce4a3</data>
    </node>
    <node id="Hypersensitivity Reaction">
      <data key="d0">Hypersensitivity Reaction</data>
      <data key="d1">event</data>
      <data key="d2">A potentially life-threatening allergic reaction triggered by repeat exposure to platinum chemotherapy agents.</data>
      <data key="d3">chunk-c622c677deca24391324ecd5f16ce4a3</data>
    </node>
    <node id="Surveillance">
      <data key="d0">Surveillance</data>
      <data key="d1">event</data>
      <data key="d2">A post-treatment clinical category involving monitoring and routine follow-up care to check for cancer recurrence.&lt;SEP&gt;A post-treatment clinical follow-up protocol consisting of scheduled tests and procedures to monitor patients for potential cancer recurrence.&lt;SEP&gt;Routine clinical follow-up consisting of periodic physical exams, pelvic exams, and tumor marker monitoring to detect cancer relapse.&lt;SEP&gt;Surveillance refers to the structured follow-up monitoring protocol after recurrence treatment, including imaging, physical exams, and anoscopy.&lt;SEP&gt;The structured clinical follow-up phase following cancer therapy, aimed at detecting potential disease recurrence early.</data>
      <data key="d3">chunk-5349eed06f06d7c9bcb541ced69e4664&lt;SEP&gt;chunk-ee254e84e63bd35682ed56c41cef9247&lt;SEP&gt;chunk-c1c1687a8a20b9c451956cf8bba241cc&lt;SEP&gt;chunk-e247ae57c50c62bded7114986471226e&lt;SEP&gt;chunk-c622c677deca24391324ecd5f16ce4a3</data>
    </node>
    <node id="CA-125">
      <data key="d0">CA-125</data>
      <data key="d1">category</data>
      <data key="d2">A tumor marker checked via blood testing to monitor treatment response and detect recurrence in ovarian cancer.</data>
      <data key="d3">chunk-c622c677deca24391324ecd5f16ce4a3</data>
    </node>
    <node id="Folate Receptor Alpha">
      <data key="d0">Folate Receptor Alpha</data>
      <data key="d1">category</data>
      <data key="d2">A biomarker whose presence on tumor cells indicates suitability for targeted therapy with mirvetuximab soravtansine-gynx.</data>
      <data key="d3">chunk-c622c677deca24391324ecd5f16ce4a3</data>
    </node>
    <node id="Immune Checkpoint Inhibitors">
      <data key="d0">Immune Checkpoint Inhibitors</data>
      <data key="d1">category</data>
      <data key="d2">A class of cancer immunotherapy treatments that may cause side effects covered in patient guidelines.&lt;SEP&gt;A class of immunotherapy drugs that target PD-1 and PD-L1 proteins to restore the immune system's anti-tumor response.&lt;SEP&gt;A class of immunotherapy drugs used in biomarker-guided cancer treatment, associated with distinct immune-related side effects.&lt;SEP&gt;A specific category of immunotherapy drugs, including nivolumab and pembrolizumab, used to treat metastatic anal cancer.</data>
      <data key="d3">chunk-650982a589c2d527bc13923ccd0569ef&lt;SEP&gt;chunk-c622c677deca24391324ecd5f16ce4a3&lt;SEP&gt;chunk-c35816f05289661283f683145d9f395f&lt;SEP&gt;chunk-5a84075aaac61b0ad85e5f811fc4f24b</data>
    </node>
    <node id="Oropharynx">
      <data key="d0">Oropharynx</data>
      <data key="d1">category</data>
      <data key="d2">The anatomical region in the throat comprising the soft palate, tonsils, side and back walls of the throat, and the base of the tongue.&lt;SEP&gt;The anatomical region in the throat including the back of the mouth and soft palate, in which throat cancer can form.</data>
      <data key="d3">chunk-c622c677deca24391324ecd5f16ce4a3&lt;SEP&gt;chunk-38185832d6395b9952def9a72ecc339d</data>
    </node>
    <node id="Head and Neck Cancers">
      <data key="d0">Head and Neck Cancers</data>
      <data key="d1">category</data>
      <data key="d2">A group of cancers originating in the head or neck area, including the oral cavity, oropharynx, nasal cavity, nasopharynx, larynx, and hypopharynx.</data>
      <data key="d3">chunk-5a84075aaac61b0ad85e5f811fc4f24b</data>
    </node>
    <node id="Squamous Cell Carcinoma of the Head and Neck">
      <data key="d0">Squamous Cell Carcinoma of the Head and Neck</data>
      <data key="d1">category</data>
      <data key="d2">Also referred to as SCCHN or HNSCC, this is the most common histological type of head and neck cancer, arising in the thin, flat squamous cells of the mucus membranes.</data>
      <data key="d3">chunk-5a84075aaac61b0ad85e5f811fc4f24b</data>
    </node>
    <node id="Testing for Throat Cancer">
      <data key="d0">Testing for Throat Cancer</data>
      <data key="d1">event</data>
      <data key="d2">The clinical diagnostic evaluation process used prior to treatment planning, which includes general health evaluations, p16 (HPV) testing, imaging, scoping procedures, biopsies, and biomarker testing.</data>
      <data key="d3">chunk-5a84075aaac61b0ad85e5f811fc4f24b</data>
    </node>
    <node id="p16 (HPV) Testing">
      <data key="d0">p16 (HPV) Testing</data>
      <data key="d1">event</data>
      <data key="d2">A diagnostic procedure performed to test for human papillomavirus association in throat cancer.</data>
      <data key="d3">chunk-5a84075aaac61b0ad85e5f811fc4f24b</data>
    </node>
    <node id="Scoping Procedures">
      <data key="d0">Scoping Procedures</data>
      <data key="d1">event</data>
      <data key="d2">Endoscopic diagnostic examinations utilized to visualize the throat and head and neck structures.</data>
      <data key="d3">chunk-5a84075aaac61b0ad85e5f811fc4f24b</data>
    </node>
    <node id="Human Papillomavirus Testing">
      <data key="d0">Human Papillomavirus Testing</data>
      <data key="d1">event</data>
      <data key="d2">A diagnostic biomarker test (often using p16) performed on tumor tissue to detect the presence of HPV in throat cancer.</data>
      <data key="d3">chunk-38185832d6395b9952def9a72ecc339d</data>
    </node>
    <node id="Screening For Depression">
      <data key="d0">Screening For Depression</data>
      <data key="d1">event</data>
      <data key="d2">A mental health assessment recommended as part of the initial evaluation to detect psychological distress or depression.</data>
      <data key="d3">chunk-38185832d6395b9952def9a72ecc339d</data>
    </node>
    <node id="Fertility Counseling">
      <data key="d0">Fertility Counseling</data>
      <data key="d1">event</data>
      <data key="d2">A clinical guidance session addressing fertility preservation and pregnancy prevention during cancer treatment across all genders.</data>
      <data key="d3">chunk-38185832d6395b9952def9a72ecc339d</data>
    </node>
    <node id="Screening For Hepatitis B">
      <data key="d0">Screening For Hepatitis B</data>
      <data key="d1">event</data>
      <data key="d2">An infectious disease laboratory screening recommended before initiating specific cancer treatments.</data>
      <data key="d3">chunk-38185832d6395b9952def9a72ecc339d</data>
    </node>
    <node id="Pre-Anesthesia Exam">
      <data key="d0">Pre-Anesthesia Exam</data>
      <data key="d1">event</data>
      <data key="d2">A medical evaluation conducted prior to administering anesthesia to ensure patient safety during procedures.&lt;SEP&gt;A pre-anesthesia exam is a clinical consultation and airway assessment performed by an anesthesiologist prior to surgery to evaluate perioperative risks.</data>
      <data key="d3">chunk-33608457001e818e2b300adae9c6c0d9&lt;SEP&gt;chunk-38185832d6395b9952def9a72ecc339d</data>
    </node>
    <node id="Speech And Swallowing Evaluation">
      <data key="d0">Speech And Swallowing Evaluation</data>
      <data key="d1">event</data>
      <data key="d2">A functional assessment evaluating swallowing, speech, and nutrition capacity prior to or during treatment.</data>
      <data key="d3">chunk-38185832d6395b9952def9a72ecc339d</data>
    </node>
    <node id="Help To Quit Smoking">
      <data key="d0">Help To Quit Smoking</data>
      <data key="d1">event</data>
      <data key="d2">A supportive intervention designed to help patients cease tobacco use to enhance treatment efficacy and survival.</data>
      <data key="d3">chunk-38185832d6395b9952def9a72ecc339d</data>
    </node>
    <node id="Centers for Disease Control and Prevention">
      <data key="d0">Centers for Disease Control and Prevention</data>
      <data key="d1">organization</data>
      <data key="d2">A public health agency offering smoking cessation resources and guidance via CDC.gov/tobacco.&lt;SEP&gt;The Centers for Disease Control and Prevention (CDC) is a national public health agency referenced for its tobacco cessation support resources.</data>
      <data key="d3">chunk-db3a86fc5d439d9bfb3845e468a2a551&lt;SEP&gt;chunk-33608457001e818e2b300adae9c6c0d9</data>
    </node>
    <node id="ECOG Performance Status">
      <data key="d0">ECOG Performance Status</data>
      <data key="d1">category</data>
      <data key="d2">A functional rating scale from 0 to 5 that evaluates a patient's overall fitness and ability to perform daily self-care and activities.&lt;SEP&gt;ECOG Performance Status is a clinical assessment metric ranging from 0 to 5 that measures a patient's level of physical functioning and ability to perform activities of daily living.</data>
      <data key="d3">chunk-33608457001e818e2b300adae9c6c0d9&lt;SEP&gt;chunk-fc469adbdd7a41816d59f249439bc726</data>
    </node>
    <node id="Smoking and Vaping">
      <data key="d0">Smoking and Vaping</data>
      <data key="d1">category</data>
      <data key="d2">Smoking and vaping refer to tobacco and nicotine consumption behaviors that significantly elevate cancer risk and negatively impact surgical recovery and treatment efficacy.&lt;SEP&gt;Tobacco and nicotine use behaviors that hinder cancer treatment efficacy and increase complications during chemotherapy.</data>
      <data key="d3">chunk-33608457001e818e2b300adae9c6c0d9&lt;SEP&gt;chunk-be6e1cb2fe11f4d9962741c30d446a69</data>
    </node>
    <node id="Head and Neck Cancer Surgery">
      <data key="d0">Head and Neck Cancer Surgery</data>
      <data key="d1">event</data>
      <data key="d2">Head and neck cancer surgery is a complex surgical procedure performed to resect tumors in the head and neck, requiring careful perioperative planning.</data>
      <data key="d3">chunk-33608457001e818e2b300adae9c6c0d9</data>
    </node>
    <node id="Mind and Body Therapists">
      <data key="d0">Mind and Body Therapists</data>
      <data key="d1">person</data>
      <data key="d2">Healthcare professionals integrated into cancer care teams who assist patients in managing emotional and physical distress.</data>
      <data key="d3">chunk-33608457001e818e2b300adae9c6c0d9</data>
    </node>
    <node id="Nutritionist or Dietician">
      <data key="d0">Nutritionist or Dietician</data>
      <data key="d1">person</data>
      <data key="d2">Specialized nutrition professionals who provide dietary recommendations, monitor weight loss, and ensure adequate nutrition prior to and during cancer treatment.</data>
      <data key="d3">chunk-33608457001e818e2b300adae9c6c0d9</data>
    </node>
    <node id="Anesthesiologist">
      <data key="d0">Anesthesiologist</data>
      <data key="d1">person</data>
      <data key="d2">A medical specialist who administers anesthesia to manage pain and consciousness during surgical operations and clinical procedures.&lt;SEP&gt;Medical physician who performs pre-anesthesia airway and health assessments and administers anesthesia during surgical procedures.</data>
      <data key="d3">chunk-dea00cf063e8831db4919330d94b1f2a&lt;SEP&gt;chunk-33608457001e818e2b300adae9c6c0d9</data>
    </node>
    <node id="Hepatitis B and Hepatitis C Screening">
      <data key="d0">Hepatitis B and Hepatitis C Screening</data>
      <data key="d1">event</data>
      <data key="d2">A pre-treatment blood testing procedure conducted to identify previous or active viral hepatitis infection before initiating cancer therapy.</data>
      <data key="d3">chunk-33608457001e818e2b300adae9c6c0d9</data>
    </node>
    <node id="Lung Function Tests">
      <data key="d0">Lung Function Tests</data>
      <data key="d1">event</data>
      <data key="d2">Pulmonary function tests (PFTs) conducted to measure lung volumes, ventilation speed, and gas exchange capacity prior to medical interventions.</data>
      <data key="d3">chunk-33608457001e818e2b300adae9c6c0d9</data>
    </node>
    <node id="Hepatitis B">
      <data key="d0">Hepatitis B</data>
      <data key="d1">category</data>
      <data key="d2">A viral infection spread by contact with blood and bodily fluids that causes chronic liver inflammation, cirrhosis, and liver cancer.&lt;SEP&gt;A viral liver disease that can potentially be reactivated by cancer treatments, causing severe liver injury.</data>
      <data key="d3">chunk-33608457001e818e2b300adae9c6c0d9&lt;SEP&gt;chunk-d4bc8b1b941d18ac455e5f255e1df8c1</data>
    </node>
    <node id="Hepatitis C">
      <data key="d0">Hepatitis C</data>
      <data key="d1">category</data>
      <data key="d2">A viral infection affecting the liver that is evaluated prior to cancer therapy to prevent hepatic complications.&lt;SEP&gt;A viral infection transmitted via bodily fluids that leads to chronic hepatitis, liver scarring, liver failure, and liver cancer.</data>
      <data key="d3">chunk-33608457001e818e2b300adae9c6c0d9&lt;SEP&gt;chunk-d4bc8b1b941d18ac455e5f255e1df8c1</data>
    </node>
    <node id="Anesthesia">
      <data key="d0">Anesthesia</data>
      <data key="d1">category</data>
      <data key="d2">A drug-induced loss of feeling or awareness administered to prevent pain and allow surgical or invasive interventions to proceed safely.</data>
      <data key="d3">chunk-33608457001e818e2b300adae9c6c0d9</data>
    </node>
    <node id="Human Papillomavirus">
      <data key="d0">Human Papillomavirus</data>
      <data key="d1">category</data>
      <data key="d2">A common viral infection that affects skin and mucous membranes and is the primary cause of anal cancer.&lt;SEP&gt;A family of viruses that infect epithelial tissues and mucous membranes, recognized as the primary cause of squamous cell carcinomas of the throat, especially type HPV16.&lt;SEP&gt;A group of over 100 virus strains, including high-risk types such as HPV16, responsible for causing anal, cervical, vaginal, and other cancers, as well as genital warts.&lt;SEP&gt;A virus associated with certain forms of throat and oropharyngeal cancer, distinct from p16-negative cancers.&lt;SEP&gt;Commonly known as HPV, a sexually transmitted virus strongly linked as a major risk factor for developing anal cancer.&lt;SEP&gt;Human papillomavirus (HPV) is a common viral infection recognized as the leading sexually transmitted cause of cervical cancer.</data>
      <data key="d3">chunk-06384634b72466c480713ee8d57f25ed&lt;SEP&gt;chunk-0d4cea71149e0e4157126efdaa0ea3e3&lt;SEP&gt;chunk-5d8e20e6004dd43ae0f68185383b594d&lt;SEP&gt;chunk-9530f389987c13273449ab22a85170ae&lt;SEP&gt;chunk-5fa7c7369d88ae71c842152510867223&lt;SEP&gt;chunk-d249262ff9e7e657de99a30199159cdf</data>
    </node>
    <node id="p16 Testing">
      <data key="d0">p16 Testing</data>
      <data key="d1">category</data>
      <data key="d2">A diagnostic biomarker test that detects overexpression of the p16 protein as a surrogate marker for HPV infection in throat cancer specimens.</data>
      <data key="d3">chunk-5fa7c7369d88ae71c842152510867223</data>
    </node>
    <node id="Hormonal Birth Control">
      <data key="d0">Hormonal Birth Control</data>
      <data key="d1">category</data>
      <data key="d2">A category of contraception methods that may or may not be advised for oncology patients during active cancer therapy.&lt;SEP&gt;Prescription contraceptive options relying on hormones that may or may not be clinically advised for individuals receiving cancer therapy.</data>
      <data key="d3">chunk-3fbf2f6a3c150687a59f814d94f1d150&lt;SEP&gt;chunk-5fa7c7369d88ae71c842152510867223</data>
    </node>
    <node id="Intrauterine Devices">
      <data key="d0">Intrauterine Devices</data>
      <data key="d1">category</data>
      <data key="d2">A form of long-acting reversible contraception (IUDs) considered as an alternative method for pregnancy prevention during therapy.&lt;SEP&gt;Long-acting reversible contraceptive devices inserted into the uterus, noted as an option to evaluate with a healthcare provider during treatment.&lt;SEP&gt;Non-hormonal or hormonal medical contraceptive devices (IUDs) placed in the uterus to prevent pregnancy.</data>
      <data key="d3">chunk-3fbf2f6a3c150687a59f814d94f1d150&lt;SEP&gt;chunk-0bd86bf8fc82f14fa5f7f51d924514e7&lt;SEP&gt;chunk-5fa7c7369d88ae71c842152510867223</data>
    </node>
    <node id="p16 Protein">
      <data key="d0">p16 Protein</data>
      <data key="d1">category</data>
      <data key="d2">A cellular protein encoded on chromosome 9 that regulates and slows cell division, acting as an overexpressed surrogate marker in HPV-driven cancers.</data>
      <data key="d3">chunk-5fa7c7369d88ae71c842152510867223</data>
    </node>
    <node id="HPV Type 16">
      <data key="d0">HPV Type 16</data>
      <data key="d1">category</data>
      <data key="d2">A specific viral genotype of human papillomavirus responsible for approximately 90% of HPV-related throat cancers.</data>
      <data key="d3">chunk-5fa7c7369d88ae71c842152510867223</data>
    </node>
    <node id="Squamous Cell Carcinoma of the Throat">
      <data key="d0">Squamous Cell Carcinoma of the Throat</data>
      <data key="d1">category</data>
      <data key="d2">A specific histological type of cancer arising in the oropharynx, particularly the tonsils and base of the tongue, frequently linked to HPV.</data>
      <data key="d3">chunk-5fa7c7369d88ae71c842152510867223</data>
    </node>
    <node id="Claustrophobia">
      <data key="d0">Claustrophobia</data>
      <data key="d1">category</data>
      <data key="d2">A clinical fear or dread of enclosed spaces that can complicate imaging procedures conducted in closed MRI scanners.&lt;SEP&gt;A psychological condition marked by a fear of enclosed spaces, influencing the choice between open and closed MRI scanners.</data>
      <data key="d3">chunk-a2778e34af702d49d5e70867726e14b2&lt;SEP&gt;chunk-5fa7c7369d88ae71c842152510867223</data>
    </node>
    <node id="Fine-Needle Biopsy">
      <data key="d0">Fine-Needle Biopsy</data>
      <data key="d1">event</data>
      <data key="d2">A diagnostic procedure guided by ultrasound or CT imaging used to collect tissue or cell samples from abnormal areas.&lt;SEP&gt;A diagnostic procedure, also known as fine-needle aspiration (FNA/FNB), that uses thin needles to extract cells from suspicious lesions or lymph nodes.</data>
      <data key="d3">chunk-9ad38c9dc069a8ff8df58c42f00eba23&lt;SEP&gt;chunk-50531346164ea7c08dd087a868b3cc2a</data>
    </node>
    <node id="Endoscopy">
      <data key="d0">Endoscopy</data>
      <data key="d1">category</data>
      <data key="d2">A scoping procedure that uses an endoscope inserted through the mouth or nose to examine internal passages, assess tumors, and guide biopsies.</data>
      <data key="d3">chunk-50531346164ea7c08dd087a868b3cc2a</data>
    </node>
    <node id="Fiberoptic Nasopharyngolaryngoscopy">
      <data key="d0">Fiberoptic Nasopharyngolaryngoscopy</data>
      <data key="d1">event</data>
      <data key="d2">A diagnostic procedure performed on an awake patient using a topical numbing spray to examine the larynx and surrounding structures.</data>
      <data key="d3">chunk-50531346164ea7c08dd087a868b3cc2a</data>
    </node>
    <node id="Laryngoscopy">
      <data key="d0">Laryngoscopy</data>
      <data key="d1">category</data>
      <data key="d2">A category of throat examinations using mirrors or specialized scopes to inspect the voice box, vocal cords, and hypopharynx.</data>
      <data key="d3">chunk-50531346164ea7c08dd087a868b3cc2a</data>
    </node>
    <node id="Indirect Laryngoscopy">
      <data key="d0">Indirect Laryngoscopy</data>
      <data key="d1">event</data>
      <data key="d2">A simple throat examination technique using a light and a small mirror positioned at the back of the throat.</data>
      <data key="d3">chunk-50531346164ea7c08dd087a868b3cc2a</data>
    </node>
    <node id="Fiberoptic Laryngoscopy">
      <data key="d0">Fiberoptic Laryngoscopy</data>
      <data key="d1">event</data>
      <data key="d2">A fast examination performed by inserting a flexible scope through the nose to view the throat and voice box.&lt;SEP&gt;A quick examination using a small flexible scope passed through the nose into the throat to examine the airway under local numbing spray.</data>
      <data key="d3">chunk-50531346164ea7c08dd087a868b3cc2a&lt;SEP&gt;chunk-0739b33959299ea67072f390ce38bffd</data>
    </node>
    <node id="Direct Laryngoscopy">
      <data key="d0">Direct Laryngoscopy</data>
      <data key="d1">event</data>
      <data key="d2">A detailed examination performed under general anesthesia in an operating room using a laryngoscope to examine the throat, determine tumor resectability, and collect biopsies.&lt;SEP&gt;An in-depth endoscopic procedure performed under general anesthesia in an operating room to view the deep throat and obtain tissue biopsies.</data>
      <data key="d3">chunk-50531346164ea7c08dd087a868b3cc2a&lt;SEP&gt;chunk-0739b33959299ea67072f390ce38bffd</data>
    </node>
    <node id="Operating Room">
      <data key="d0">Operating Room</data>
      <data key="d1">geo</data>
      <data key="d2">A sterile hospital surgical suite where direct laryngoscopy is conducted under general anesthesia.</data>
      <data key="d3">chunk-50531346164ea7c08dd087a868b3cc2a</data>
    </node>
    <node id="Esophagoscopy">
      <data key="d0">Esophagoscopy</data>
      <data key="d1">event</data>
      <data key="d2">A procedure performed under anesthesia in an operating room where an endoscope is guided down the throat into the esophagus to look for abnormal growths.</data>
      <data key="d3">chunk-0739b33959299ea67072f390ce38bffd</data>
    </node>
    <node id="Bronchoscopy">
      <data key="d0">Bronchoscopy</data>
      <data key="d1">event</data>
      <data key="d2">A procedure under anesthesia where a scope is inserted through the nose or mouth to examine the trachea and bronchi, detect cancer, or perform treatments.</data>
      <data key="d3">chunk-0739b33959299ea67072f390ce38bffd</data>
    </node>
    <node id="Panendoscopy">
      <data key="d0">Panendoscopy</data>
      <data key="d1">event</data>
      <data key="d2">A comprehensive examination performed under anesthesia that combines laryngoscopy, pharyngoscopy, esophagoscopy, and bronchoscopy to assess the upper aerodigestive tract and obtain tissue biopsies.</data>
      <data key="d3">chunk-0739b33959299ea67072f390ce38bffd</data>
    </node>
    <node id="HPV Testing">
      <data key="d0">HPV Testing</data>
      <data key="d1">event</data>
      <data key="d2">A diagnostic test using p16 biomarker analysis recommended for patients diagnosed with throat cancer.</data>
      <data key="d3">chunk-0739b33959299ea67072f390ce38bffd</data>
    </node>
    <node id="Tumor Histology">
      <data key="d0">Tumor Histology</data>
      <data key="d1">category</data>
      <data key="d2">The specific cancer subtype classification determined by microscopic cellular analysis.</data>
      <data key="d3">chunk-0739b33959299ea67072f390ce38bffd</data>
    </node>
    <node id="MSI-H/dMMR">
      <data key="d0">MSI-H/dMMR</data>
      <data key="d1">category</data>
      <data key="d2">A classification of tumors characterized by high microsatellite instability or deficient mismatch repair.&lt;SEP&gt;A genetic alteration status signifying microsatellite instability-high or deficient mismatch repair within cancer cells.&lt;SEP&gt;A genetic biomarker classification characterized by microsatellite instability-high or deficient mismatch repair in cancer cells.&lt;SEP&gt;A genetic condition characterized by microsatellite instability-high or deficient mismatch repair, leading to uncorrected DNA replication errors in cancer cells.</data>
      <data key="d3">chunk-650982a589c2d527bc13923ccd0569ef&lt;SEP&gt;chunk-6b02315423350f3598288e189fbcb8ae&lt;SEP&gt;chunk-ea7b3f83164304ee4a562046eb0f5033&lt;SEP&gt;chunk-0739b33959299ea67072f390ce38bffd</data>
    </node>
    <node id="Pharyngoscopy">
      <data key="d0">Pharyngoscopy</data>
      <data key="d1">event</data>
      <data key="d2">An endoscopic procedure used to examine the pharynx and oropharynx, often performed as part of a panendoscopy.</data>
      <data key="d3">chunk-0739b33959299ea67072f390ce38bffd</data>
    </node>
    <node id="Primary Tumor">
      <data key="d0">Primary Tumor</data>
      <data key="d1">category</data>
      <data key="d2">A localized initial mass of cancer cells that forms before disease spreads to adjacent tissues or distant organs.&lt;SEP&gt;The initial mass formed by cancer cells at the original anatomical site within the breast tissue before any metastatic spread.&lt;SEP&gt;The initial, localized mass of cancer cells that forms within the breast tissue before invading adjacent structures or spreading.&lt;SEP&gt;The original or main cancerous growth identified during endoscopic evaluations such as direct laryngoscopy.</data>
      <data key="d3">chunk-53c0ac935ec10ce8a0839db4ad053ad1&lt;SEP&gt;chunk-a06038ec84f20e873b9e275a23aea8d9&lt;SEP&gt;chunk-0739b33959299ea67072f390ce38bffd&lt;SEP&gt;chunk-c37f547042fc10baabdbfaadf010bce5</data>
    </node>
    <node id="Cytology">
      <data key="d0">Cytology</data>
      <data key="d1">category</data>
      <data key="d2">The microscopic evaluation of individual cells performed by a pathologist to identify cancer.</data>
      <data key="d3">chunk-0739b33959299ea67072f390ce38bffd</data>
    </node>
    <node id="Tumor P16 (HPV) Testing">
      <data key="d0">Tumor P16 (HPV) Testing</data>
      <data key="d1">category</data>
      <data key="d2">Tumor p16 testing is a biomarker diagnostic test recommended for all patients diagnosed with oropharyngeal throat cancer to guide staging and treatment decisions.</data>
      <data key="d3">chunk-f8639a06098656be20a04fe129660616</data>
    </node>
    <node id="Tumor Mutation Testing">
      <data key="d0">Tumor Mutation Testing</data>
      <data key="d1">category</data>
      <data key="d2">A class of diagnostic testing that analyzes tumor or blood samples to identify non-inherited genetic aberrations that may be treated with targeted therapies.&lt;SEP&gt;A diagnostic category of molecular tests performed on tumor or blood samples to identify specific somatic DNA mutations and genomic aberrations.&lt;SEP&gt;A diagnostic evaluation identifying genetic alterations within a bone tumor to inform tailored cancer treatment strategies.&lt;SEP&gt;A diagnostic procedure testing tumor tissue or blood for somatic DNA mutations, such as PIK3CA, to identify targeted therapy options.&lt;SEP&gt;Tumor mutation testing, or tumor genomic aberration testing, examines tumor tissue or blood for specific acquired DNA alterations that can be targeted by specialized therapies.</data>
      <data key="d3">chunk-f8639a06098656be20a04fe129660616&lt;SEP&gt;chunk-ba28a3ce3534c0655a0d08a953d7f038&lt;SEP&gt;chunk-ea7b3f83164304ee4a562046eb0f5033&lt;SEP&gt;chunk-650982a589c2d527bc13923ccd0569ef&lt;SEP&gt;chunk-6b02315423350f3598288e189fbcb8ae</data>
    </node>
    <node id="Cell-Free DNA Testing">
      <data key="d0">Cell-Free DNA Testing</data>
      <data key="d1">category</data>
      <data key="d2">Cell-free or circulating tumor DNA (ctDNA) testing uses a blood sample to detect tumor cells or tumor DNA fragments to monitor treatment response and cancer recurrence.</data>
      <data key="d3">chunk-f8639a06098656be20a04fe129660616</data>
    </node>
    <node id="P16- Throat Cancer">
      <data key="d0">P16- Throat Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A specific category of squamous cell carcinoma of the throat that tests negative for the p16 protein and is not mediated by human papillomavirus (HPV).</data>
      <data key="d3">chunk-5d8e20e6004dd43ae0f68185383b594d</data>
    </node>
    <node id="Acute Lymphoblastic Leukemia">
      <data key="d0">Acute Lymphoblastic Leukemia</data>
      <data key="d1">category</data>
      <data key="d2">A rapidly progressing blood cancer originating in lymphocytes and lymphoblasts, most frequently diagnosed in pediatric populations.&lt;SEP&gt;A type of cancer of the blood and bone marrow characterized by the overproduction of lymphoblasts, commonly treated with chemotherapy and systemic therapies.&lt;SEP&gt;Acute lymphoblastic leukemia (ALL) is a blood cancer characterized by an overproduction of abnormal lymphoid progenitor cells and lymphoblasts in the bone marrow and blood.&lt;SEP&gt;Acute lymphoblastic leukemia (ALL) is a fast-growing blood cancer in which the bone marrow produces too many immature lymphocytes known as lymphoblasts.&lt;SEP&gt;Acute lymphoblastic leukemia (ALL) is a fast-growing blood cancer that originates in lymphoid progenitor cells and disease-fighting white blood cells known as lymphocytes.&lt;SEP&gt;Acute lymphoblastic leukemia (ALL) is a fast-growing cancer of the blood and bone marrow starting in lymphocytes, commonly diagnosed in infants, children, and young adults.&lt;SEP&gt;Acute lymphoblastic leukemia (ALL) is a rapid-growing type of blood cancer that originates in lymphoid progenitor cells, resulting in an overproduction of immature lymphocytes known as lymphoblasts.</data>
      <data key="d3">chunk-7606b44d6a30ad0519bc4c10785de79a&lt;SEP&gt;chunk-b11b0c66441242d2f687a0c55adee585&lt;SEP&gt;chunk-81c87ec3c2682da4d531da53f6e5e18c&lt;SEP&gt;chunk-5d8e20e6004dd43ae0f68185383b594d&lt;SEP&gt;chunk-a99a89bec88823cedf4c1f0cd1a78e81&lt;SEP&gt;chunk-53e3a9418b1d7916e3c8717a397bbb58&lt;SEP&gt;chunk-82c7205fc2067a4d00e43fd22276db22</data>
    </node>
    <node id="B-ALL">
      <data key="d0">B-ALL</data>
      <data key="d1">category</data>
      <data key="d2">A primary subtype of acute lymphoblastic leukemia that originates in B-cell lineage lymphocytes.&lt;SEP&gt;B-cell acute lymphoblastic leukemia (B-ALL) is a classification of ALL that originates in B-cell precursors and encompasses multiple genetic subtypes.&lt;SEP&gt;B-cell acute lymphoblastic leukemia (B-ALL) is a leukemia subtype originating in B-cell lineage lymphoblasts, distinguished in clinical management from mature B-cell ALL.&lt;SEP&gt;B-cell acute lymphoblastic leukemia (B-ALL) is a subtype of ALL that originates in B-cell lymphocytes and is more common than T-ALL.&lt;SEP&gt;B-cell acute lymphoblastic leukemia (B-ALL) is the most common form of ALL, originating in B-cell lymphocytes.&lt;SEP&gt;B-cell acute lymphoblastic leukemia, the most common type of ALL, encompassing subtypes such as BCR::ABL1-negative, BCR::ABL1-like, and BCR::ABL1-positive.</data>
      <data key="d3">chunk-7606b44d6a30ad0519bc4c10785de79a&lt;SEP&gt;chunk-b11b0c66441242d2f687a0c55adee585&lt;SEP&gt;chunk-5d8e20e6004dd43ae0f68185383b594d&lt;SEP&gt;chunk-c5bc83f5f4f3e29b7f0a6f4787c3ad83&lt;SEP&gt;chunk-53e3a9418b1d7916e3c8717a397bbb58&lt;SEP&gt;chunk-82c7205fc2067a4d00e43fd22276db22</data>
    </node>
    <node id="T-ALL">
      <data key="d0">T-ALL</data>
      <data key="d1">category</data>
      <data key="d2">A primary subtype of acute lymphoblastic leukemia that originates in T-cell lineage lymphocytes.&lt;SEP&gt;T-cell acute lymphoblastic leukemia (T-ALL) is a less common form of ALL that originates in T-cell lymphocytes.&lt;SEP&gt;T-cell acute lymphoblastic leukemia (T-ALL) is a subtype of ALL originating in T-cell lymphocytes that can lead to an enlarged thymus and breathing issues.&lt;SEP&gt;T-cell acute lymphoblastic leukemia (T-ALL) is a subtype of ALL that originates in T-cell lymphocytes and can cause an enlarged thymus and respiratory issues.&lt;SEP&gt;T-cell acute lymphoblastic leukemia (T-ALL) is one of the two primary classifications of acute lymphoblastic leukemia.&lt;SEP&gt;T-cell acute lymphoblastic leukemia, a less common subgroup of ALL that originates in T-cell lymphocytes.</data>
      <data key="d3">chunk-7606b44d6a30ad0519bc4c10785de79a&lt;SEP&gt;chunk-b11b0c66441242d2f687a0c55adee585&lt;SEP&gt;chunk-5d8e20e6004dd43ae0f68185383b594d&lt;SEP&gt;chunk-c5bc83f5f4f3e29b7f0a6f4787c3ad83&lt;SEP&gt;chunk-53e3a9418b1d7916e3c8717a397bbb58&lt;SEP&gt;chunk-82c7205fc2067a4d00e43fd22276db22</data>
    </node>
    <node id="Locoregionally Advanced Cancer">
      <data key="d0">Locoregionally Advanced Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A disease state where tumor growth has extended to tissues, organs, or lymph nodes within the head and neck.</data>
      <data key="d3">chunk-5d8e20e6004dd43ae0f68185383b594d</data>
    </node>
    <node id="Lymphoblasts">
      <data key="d0">Lymphoblasts</data>
      <data key="d1">category</data>
      <data key="d2">Immature lymphocytes that proliferate excessively in acute lymphoblastic leukemia, crowding out healthy bone marrow.&lt;SEP&gt;Immature lymphoid cells produced in bone marrow that overproliferate in acute lymphoblastic leukemia, crowding out normal blood cells.&lt;SEP&gt;Immature white blood cells produced excessively in the bone marrow during acute lymphoblastic leukemia, displacing normal blood-forming cells.&lt;SEP&gt;Lymphoblasts are immature precursor cells that develop into lymphocytes; in acute lymphoblastic leukemia, abnormal lymphoblasts proliferate excessively.&lt;SEP&gt;Lymphoblasts, or blasts, are immature lymphoid cells that multiply abnormally in acute lymphoblastic leukemia, crowding out normal bone marrow and inhibiting healthy blood cell production.</data>
      <data key="d3">chunk-7606b44d6a30ad0519bc4c10785de79a&lt;SEP&gt;chunk-81c87ec3c2682da4d531da53f6e5e18c&lt;SEP&gt;chunk-5d8e20e6004dd43ae0f68185383b594d&lt;SEP&gt;chunk-a99a89bec88823cedf4c1f0cd1a78e81&lt;SEP&gt;chunk-53e3a9418b1d7916e3c8717a397bbb58</data>
    </node>
    <node id="B-Cell Acute Lymphoblastic Leukemia">
      <data key="d0">B-Cell Acute Lymphoblastic Leukemia</data>
      <data key="d1">category</data>
      <data key="d2">B-cell acute lymphoblastic leukemia (B-ALL) is the most common form of ALL, originating in B-cell lymphocytes.</data>
      <data key="d3">chunk-81c87ec3c2682da4d531da53f6e5e18c</data>
    </node>
    <node id="T-Cell Acute Lymphoblastic Leukemia">
      <data key="d0">T-Cell Acute Lymphoblastic Leukemia</data>
      <data key="d1">category</data>
      <data key="d2">T-cell acute lymphoblastic leukemia (T-ALL) is a subtype of ALL originating in T-cell lymphocytes, often causing an enlarged thymus and breathing complications.</data>
      <data key="d3">chunk-81c87ec3c2682da4d531da53f6e5e18c</data>
    </node>
    <node id="Burkitt Leukemia">
      <data key="d0">Burkitt Leukemia</data>
      <data key="d1">category</data>
      <data key="d2">Also called mature B-cell ALL, Burkitt leukemia is a rare subtype of ALL that is essentially the same as Burkitt lymphoma but managed with different treatments.&lt;SEP&gt;Burkitt leukemia is a rare and mature subtype of B-cell acute lymphoblastic leukemia.&lt;SEP&gt;Burkitt leukemia, also known as mature B-cell ALL, is a rare subtype of ALL that is biologically similar to Burkitt lymphoma but managed with distinct treatment protocols.&lt;SEP&gt;Mature B-cell ALL, also known as Burkitt leukemia, is a rare subtype of B-ALL that closely aligns biologically with Burkitt lymphoma but follows distinct treatment approaches.</data>
      <data key="d3">chunk-7606b44d6a30ad0519bc4c10785de79a&lt;SEP&gt;chunk-a99a89bec88823cedf4c1f0cd1a78e81&lt;SEP&gt;chunk-81c87ec3c2682da4d531da53f6e5e18c&lt;SEP&gt;chunk-82c7205fc2067a4d00e43fd22276db22</data>
    </node>
    <node id="B-Cell Lymphoblastic Lymphoma">
      <data key="d0">B-Cell Lymphoblastic Lymphoma</data>
      <data key="d1">category</data>
      <data key="d2">Also referred to as B-LL or B-LBL, a condition where B-cell lymphoblasts proliferate predominantly in lymph nodes rather than bone marrow.&lt;SEP&gt;B-cell lymphoblastic lymphoma (B-LL or B-LBL) is a disease manifestation where B-cell lymphoblasts grow primarily in the lymph nodes instead of bone marrow.</data>
      <data key="d3">chunk-81c87ec3c2682da4d531da53f6e5e18c&lt;SEP&gt;chunk-82c7205fc2067a4d00e43fd22276db22</data>
    </node>
    <node id="T-Cell Lymphoblastic Lymphoma">
      <data key="d0">T-Cell Lymphoblastic Lymphoma</data>
      <data key="d1">category</data>
      <data key="d2">Also known as T-LL or T-LBL, a condition in which T-cell lymphoblasts grow primarily in the thymus instead of bone marrow.&lt;SEP&gt;T-cell lymphoblastic lymphoma (T-LL or T-LBL) is a condition where T-cell lymphoblasts grow mainly in the thymus rather than in the bone marrow.</data>
      <data key="d3">chunk-81c87ec3c2682da4d531da53f6e5e18c&lt;SEP&gt;chunk-82c7205fc2067a4d00e43fd22276db22</data>
    </node>
    <node id="Adolescents and Young Adults">
      <data key="d0">Adolescents and Young Adults</data>
      <data key="d1">category</data>
      <data key="d2">Adolescents and young adults (AYAs) is a cancer patient demographic comprising individuals aged 15 to 39 years at diagnosis who may be treated in pediatric or adult care centers.&lt;SEP&gt;Adolescents and young adults (AYAs) is a patient category defined as individuals aged 15 to 39 years at the time of initial cancer diagnosis who may receive treatment at pediatric or adult cancer centers.</data>
      <data key="d3">chunk-53e3a9418b1d7916e3c8717a397bbb58&lt;SEP&gt;chunk-81c87ec3c2682da4d531da53f6e5e18c</data>
    </node>
    <node id="B Cells">
      <data key="d0">B Cells</data>
      <data key="d1">category</data>
      <data key="d2">A subtype of white blood cells produced in the bone marrow and located in the lymphatic system that fight infections; in CLL, abnormal B cells proliferate uncontrollably.&lt;SEP&gt;B cells, or B lymphocytes, are specialized white blood cells responsible for producing antibodies to protect against infection.&lt;SEP&gt;B cells, or B lymphocytes, are specialized white blood cells that produce antibodies to protect the body against infection.&lt;SEP&gt;Immune cells primarily located in the lymphatic system that undergo malignant transformation in CLL.</data>
      <data key="d3">chunk-098a64d7118fc8e1eb3e91ba0124258c&lt;SEP&gt;chunk-a99a89bec88823cedf4c1f0cd1a78e81&lt;SEP&gt;chunk-81c87ec3c2682da4d531da53f6e5e18c&lt;SEP&gt;chunk-bc89a92e9a97781ebca0db50abc34939</data>
    </node>
    <node id="T Cells">
      <data key="d0">T Cells</data>
      <data key="d1">category</data>
      <data key="d2">T cells, or T lymphocytes, are white blood cells that fight infections, destroy tumor cells, and modulate immune responses.&lt;SEP&gt;T cells, or T lymphocytes, are white blood cells that fight infections, kill tumor cells, and regulate immune system responses.</data>
      <data key="d3">chunk-a99a89bec88823cedf4c1f0cd1a78e81&lt;SEP&gt;chunk-81c87ec3c2682da4d531da53f6e5e18c</data>
    </node>
    <node id="Pediatric Patients">
      <data key="d0">Pediatric Patients</data>
      <data key="d1">category</data>
      <data key="d2">Pediatric patients refers to a clinical demographic consisting of infants, children, and individuals aged 18 years or younger receiving specialized pediatric care.</data>
      <data key="d3">chunk-81c87ec3c2682da4d531da53f6e5e18c</data>
    </node>
    <node id="ALL">
      <data key="d0">ALL</data>
      <data key="d1">category</data>
      <data key="d2">Acute lymphoblastic leukemia (ALL) is a cancer that affects lymphoid progenitor blood cells, leading to an overproduction of lymphoblasts in bone marrow, blood, and other organs.</data>
      <data key="d3">chunk-c5bc83f5f4f3e29b7f0a6f4787c3ad83</data>
    </node>
    <node id="BCR::ABL1-Negative B-ALL">
      <data key="d0">BCR::ABL1-Negative B-ALL</data>
      <data key="d1">category</data>
      <data key="d2">BCR::ABL1-negative or BCR::ABL1-like B-ALL is the most common form of B-ALL, typically treated with clinical trials and multiagent chemotherapy.</data>
      <data key="d3">chunk-c5bc83f5f4f3e29b7f0a6f4787c3ad83</data>
    </node>
    <node id="BCR::ABL1-Positive B-ALL">
      <data key="d0">BCR::ABL1-Positive B-ALL</data>
      <data key="d1">category</data>
      <data key="d2">A subtype of B-cell acute lymphoblastic leukemia driven by the BCR::ABL protein produced by the BCR::ABL1 gene, treated with intensive systemic therapies.&lt;SEP&gt;BCR::ABL1-positive B-ALL is an aggressive subtype of B-ALL driven by the BCR::ABL1 gene fusion, requiring targeted and intensive systemic therapies.</data>
      <data key="d3">chunk-b11b0c66441242d2f687a0c55adee585&lt;SEP&gt;chunk-c5bc83f5f4f3e29b7f0a6f4787c3ad83</data>
    </node>
    <node id="Infant ALL">
      <data key="d0">Infant ALL</data>
      <data key="d1">category</data>
      <data key="d2">A specific classification of acute lymphoblastic leukemia occurring in infants under 12 months of age, requiring specialized treatment approaches.&lt;SEP&gt;Infant ALL is a distinct category of acute lymphoblastic leukemia occurring in children under 12 months of age, requiring specialized treatment protocols.</data>
      <data key="d3">chunk-b11b0c66441242d2f687a0c55adee585&lt;SEP&gt;chunk-c5bc83f5f4f3e29b7f0a6f4787c3ad83</data>
    </node>
    <node id="Rectal Cancer">
      <data key="d0">Rectal Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A disease category involving malignant tumors situated within the rectum, managed through local excision, transabdominal resection, and adjuvant therapies.&lt;SEP&gt;A form of cancer originating in the rectum; although related to colon cancer under colorectal cancer, it follows distinct treatment guidelines.&lt;SEP&gt;A form of colorectal cancer that develops in the rectum, requiring staging via imaging and treatment involving surgery, radiation therapy, and biomarker testing.&lt;SEP&gt;A malignancy of the rectum that can also be treated with abdominoperineal resection (APR).&lt;SEP&gt;A malignancy of the rectum that may also be treated using abdominoperineal resection (APR).&lt;SEP&gt;Rectal cancer is a category of cancer that originates in the rectum, most commonly arising from non-cancerous polyps called adenomas.&lt;SEP&gt;Rectal cancer is a form of cancer that originates on the inner lining of the rectum, commonly developing from polyps or lesions.&lt;SEP&gt;Rectal cancer is a malignancy that begins in the inner lining of the rectum, which can invade pelvic tissue or metastasize if left untreated.</data>
      <data key="d3">chunk-5349eed06f06d7c9bcb541ced69e4664&lt;SEP&gt;chunk-bb68daec67dd8f436d82814b0e61ff21&lt;SEP&gt;chunk-c5bc83f5f4f3e29b7f0a6f4787c3ad83&lt;SEP&gt;chunk-925a474b4538dda470bfd817f9d9a17d&lt;SEP&gt;chunk-37bca9f4d2ebaeed359c9b4eb7a0c1de&lt;SEP&gt;chunk-29b3a349650a8bb55b318dcc6ecb0519&lt;SEP&gt;chunk-f2c9770fd98dbbe3c7947601fb3e654c&lt;SEP&gt;chunk-594536d6aaa61f8f1699ba50bf218a33</data>
    </node>
    <node id="Colorectal Cancer">
      <data key="d0">Colorectal Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A broad classification of gastrointestinal malignancy that includes rectal cancer, noted for increasing incidence rates in younger adult populations.&lt;SEP&gt;A broader disease category encompassing cancers that form in either the colon or rectum.&lt;SEP&gt;A digestive system cancer that predominantly begins in glandular cells as adenocarcinoma, contrasted with anal cancer.&lt;SEP&gt;A major category of cancer that affects the colon or rectum, often beginning as polyps in the lining of the colon.&lt;SEP&gt;A malignant disease of the colon or rectum linked to hereditary mutations in mismatch repair genes including MSH2, MSH6, MLH1, and PMS2.&lt;SEP&gt;Cancer affecting the colon or rectum, associated with germline mutations in MSH2, MSH6, MLH1, and PMS2.&lt;SEP&gt;Colorectal cancer is a malignancy evaluated in personal or family history to identify inherited conditions associated with thyroid cancer.&lt;SEP&gt;Colorectal cancer is an overarching classification encompassing cancers of both the colon and rectum.</data>
      <data key="d3">chunk-f2a44e885faf856aa579d824b3cd85e7&lt;SEP&gt;chunk-789ec6c06f8c999ac21c89b085b3fdb7&lt;SEP&gt;chunk-bb68daec67dd8f436d82814b0e61ff21&lt;SEP&gt;chunk-18b5e32980f3efa0cd012e2abab9b9fc&lt;SEP&gt;chunk-c5bc83f5f4f3e29b7f0a6f4787c3ad83&lt;SEP&gt;chunk-ee254e84e63bd35682ed56c41cef9247&lt;SEP&gt;chunk-965e5a6bad03f2129a98be4373f99176&lt;SEP&gt;chunk-594536d6aaa61f8f1699ba50bf218a33</data>
    </node>
    <node id="Colon Cancer">
      <data key="d0">Colon Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A common and treatable cancer that begins in the large intestine (colon), usually arising from non-cancerous polyps.&lt;SEP&gt;A major type of cancer that begins in the large intestine, typically developing from polyps and categorized by stages and genetic biomarkers.&lt;SEP&gt;A malignancy of the large intestine discussed in the context of post-treatment surveillance protocols across stages 1, 2, and 3.&lt;SEP&gt;A malignancy of the large intestine noted in family health histories linked to elevated cancer risks.&lt;SEP&gt;Colon cancer is a cancer that develops in the colon; while related to rectal cancer under colorectal cancer, it requires distinct treatment protocols.</data>
      <data key="d3">chunk-85e75e869fcfcb7c5431dbcdd532137f&lt;SEP&gt;chunk-bb68daec67dd8f436d82814b0e61ff21&lt;SEP&gt;chunk-1c7418fb993bb3daa95d8563909da1de&lt;SEP&gt;chunk-c5bc83f5f4f3e29b7f0a6f4787c3ad83&lt;SEP&gt;chunk-c9383db20cd696688798a193862cb5cc</data>
    </node>
    <node id="Hyperplastic Polyps">
      <data key="d0">Hyperplastic Polyps</data>
      <data key="d1">category</data>
      <data key="d2">Hyperplastic polyps are non-cancerous growths on the inner lining of the colon and rectum that rarely transform into malignant tumors.&lt;SEP&gt;Non-cancerous growths on the colon lining that rarely develop into colorectal cancer.</data>
      <data key="d3">chunk-bb68daec67dd8f436d82814b0e61ff21&lt;SEP&gt;chunk-c5bc83f5f4f3e29b7f0a6f4787c3ad83</data>
    </node>
    <node id="Inflammatory Polyps">
      <data key="d0">Inflammatory Polyps</data>
      <data key="d1">category</data>
      <data key="d2">Benign growths occurring in the colon and rectum that have minimal risk of progressing to cancer.&lt;SEP&gt;Inflammatory polyps are benign colorectal mucosal growths that rarely progress to cancer.</data>
      <data key="d3">chunk-bb68daec67dd8f436d82814b0e61ff21&lt;SEP&gt;chunk-c5bc83f5f4f3e29b7f0a6f4787c3ad83</data>
    </node>
    <node id="Multiagent Chemotherapy">
      <data key="d0">Multiagent Chemotherapy</data>
      <data key="d1">category</data>
      <data key="d2">Multiagent chemotherapy is a core cancer treatment protocol combining multiple chemotherapeutic agents used in the treatment of acute lymphoblastic leukemia.&lt;SEP&gt;Multiagent chemotherapy is a standard systemic cancer therapy protocol combining multiple chemotherapeutic agents to treat all patients with ALL.</data>
      <data key="d3">chunk-53e3a9418b1d7916e3c8717a397bbb58&lt;SEP&gt;chunk-c5bc83f5f4f3e29b7f0a6f4787c3ad83</data>
    </node>
    <node id="Steroids">
      <data key="d0">Steroids</data>
      <data key="d1">category</data>
      <data key="d2">Steroids are a drug class routinely administered alongside systemic multiagent chemotherapy in the treatment of acute lymphoblastic leukemia.&lt;SEP&gt;Steroids are a primary class of therapeutic medications administered to patients undergoing treatment for ALL.</data>
      <data key="d3">chunk-53e3a9418b1d7916e3c8717a397bbb58&lt;SEP&gt;chunk-c5bc83f5f4f3e29b7f0a6f4787c3ad83</data>
    </node>
    <node id="Pediatric Leukemia Center">
      <data key="d0">Pediatric Leukemia Center</data>
      <data key="d1">organization</data>
      <data key="d2">A pediatric leukemia center is a specialized medical institution experienced in treating children with leukemia.&lt;SEP&gt;A specialized medical facility experienced in treating children diagnosed with leukemia, recommended for expert care and consultations.</data>
      <data key="d3">chunk-b11b0c66441242d2f687a0c55adee585&lt;SEP&gt;chunk-c5bc83f5f4f3e29b7f0a6f4787c3ad83</data>
    </node>
    <node id="Patient Advocacy Groups">
      <data key="d0">Patient Advocacy Groups</data>
      <data key="d1">organization</data>
      <data key="d2">Organizations providing external support, resources, and guidance for cancer patients and their families.&lt;SEP&gt;Patient advocacy groups are non-profit support entities that provide resources, guidance, and assistance for patients and families navigating cancer care.&lt;SEP&gt;Patient advocacy groups are support organizations that offer guidance, resources, and assistance to cancer patients navigating their care.&lt;SEP&gt;Support organizations that offer guidance, resources, and assistance for patients undergoing bone cancer diagnosis and care.</data>
      <data key="d3">chunk-b11b0c66441242d2f687a0c55adee585&lt;SEP&gt;chunk-c5bc83f5f4f3e29b7f0a6f4787c3ad83&lt;SEP&gt;chunk-ba28a3ce3534c0655a0d08a953d7f038&lt;SEP&gt;chunk-2dc31077c053f79ff82959575d335956</data>
    </node>
    <node id="ALL Specialist">
      <data key="d0">ALL Specialist</data>
      <data key="d1">person</data>
      <data key="d2">An ALL specialist is a medical expert focused on diagnosing and managing patients diagnosed with acute lymphoblastic leukemia.</data>
      <data key="d3">chunk-c5bc83f5f4f3e29b7f0a6f4787c3ad83</data>
    </node>
    <node id="Oncologist">
      <data key="d0">Oncologist</data>
      <data key="d1">person</data>
      <data key="d2">A cancer physician who receives diagnostic imaging and biomarker results to determine and direct cancer therapies.&lt;SEP&gt;A cancer specialist physician who reviews blood smears and oversees treatment planning for cancer patients.&lt;SEP&gt;A medical doctor specializing in cancer care who conducts physical examinations, oversees surveillance, and guides treatment strategies.&lt;SEP&gt;A medical specialist responsible for performing physical exams, monitoring recovery, and evaluating symptoms and recurrence during cancer surveillance.&lt;SEP&gt;A physician specializing in cancer care who receives imaging test results and directs cancer treatment plans.&lt;SEP&gt;A physician specializing in cancer treatment who receives imaging interpretation from the radiologist to plan cancer management.&lt;SEP&gt;An oncologist is a physician specializing in cancer care who receives imaging interpretations to help stage the disease and plan patient treatment.</data>
      <data key="d3">chunk-ee254e84e63bd35682ed56c41cef9247&lt;SEP&gt;chunk-e247ae57c50c62bded7114986471226e&lt;SEP&gt;chunk-b3ba7430f3a31330247f52afe7e9c68a&lt;SEP&gt;chunk-925a474b4538dda470bfd817f9d9a17d&lt;SEP&gt;chunk-098a64d7118fc8e1eb3e91ba0124258c&lt;SEP&gt;chunk-67015f3916810c4378b2ed269cc27f29&lt;SEP&gt;chunk-594536d6aaa61f8f1699ba50bf218a33</data>
    </node>
    <node id="Polypectomy">
      <data key="d0">Polypectomy</data>
      <data key="d1">event</data>
      <data key="d2">A minor surgical procedure performed during a colonoscopy to remove polyps and prevent colon cancer.&lt;SEP&gt;A minor surgical procedure performed during a colonoscopy to remove polyps before they can transition into cancer.&lt;SEP&gt;A polypectomy is a minor surgical procedure performed during a colonoscopy to excise polyps from the lining of the colon and rectum.&lt;SEP&gt;A polypectomy is a minor surgical procedure performed during a colonoscopy to remove polyps from the bowel lining.&lt;SEP&gt;A polypectomy is a minor surgical procedure performed during a colonoscopy to remove polyps from the bowel wall.</data>
      <data key="d3">chunk-85e75e869fcfcb7c5431dbcdd532137f&lt;SEP&gt;chunk-bb68daec67dd8f436d82814b0e61ff21&lt;SEP&gt;chunk-925a474b4538dda470bfd817f9d9a17d&lt;SEP&gt;chunk-f2c9770fd98dbbe3c7947601fb3e654c&lt;SEP&gt;chunk-b5cfcc365cd093374564eb27dcbf5b82</data>
    </node>
    <node id="Mismatch Repair Testing">
      <data key="d0">Mismatch Repair Testing</data>
      <data key="d1">event</data>
      <data key="d2">A diagnostic biomarker test analyzing tumor samples for mismatch repair deficiency (dMMR) or microsatellite instability (MSI-H) to guide treatment.&lt;SEP&gt;Mismatch repair testing is a diagnostic laboratory procedure that analyzes rectal tumor tissue for mutations in genes responsible for fixing damaged DNA.</data>
      <data key="d3">chunk-925a474b4538dda470bfd817f9d9a17d&lt;SEP&gt;chunk-85e75e869fcfcb7c5431dbcdd532137f</data>
    </node>
    <node id="Liquid Biopsy">
      <data key="d0">Liquid Biopsy</data>
      <data key="d1">event</data>
      <data key="d2">A category of blood-based diagnostic testing that analyzes circulating tumor DNA to detect remnants of cancer cells.&lt;SEP&gt;A diagnostic procedure where a blood sample is taken to detect circulating cancer cells or tumor DNA.&lt;SEP&gt;A liquid biopsy, or circulating tumor DNA (ctDNA) test, is a blood-based diagnostic procedure under clinical study to identify microscopic rectal cancer cells and recurrence risk.&lt;SEP&gt;A minimally invasive diagnostic test that analyzes a blood sample to detect circulating cancer cells.</data>
      <data key="d3">chunk-975e540ddee1810d43caf8df4adcf205&lt;SEP&gt;chunk-ee254e84e63bd35682ed56c41cef9247&lt;SEP&gt;chunk-925a474b4538dda470bfd817f9d9a17d&lt;SEP&gt;chunk-965e5a6bad03f2129a98be4373f99176</data>
    </node>
    <node id="CEA Test">
      <data key="d0">CEA Test</data>
      <data key="d1">event</data>
      <data key="d2">A CEA blood test measures the level of carcinoembryonic antigen to monitor colorectal cancer spread and response.</data>
      <data key="d3">chunk-925a474b4538dda470bfd817f9d9a17d</data>
    </node>
    <node id="Biomarker">
      <data key="d0">Biomarker</data>
      <data key="d1">category</data>
      <data key="d2">A biological characteristic or molecule measured to evaluate cancer type, behavior, and potential treatment responses.&lt;SEP&gt;A biomarker is a measurable biological indicator or targetable genetic alteration in cancer cells used to guide treatment plans.</data>
      <data key="d3">chunk-9ad38c9dc069a8ff8df58c42f00eba23&lt;SEP&gt;chunk-925a474b4538dda470bfd817f9d9a17d</data>
    </node>
    <node id="Endometrial Cancer">
      <data key="d0">Endometrial Cancer</data>
      <data key="d1">category</data>
      <data key="d2">Cancer of the inner lining of the uterus, for which individuals with Lynch syndrome carry an elevated risk of developing.&lt;SEP&gt;Endometrial cancer is a distinct subtype of uterine cancer that develops within the lining of the uterus.&lt;SEP&gt;Endometrial cancer is a malignancy affecting the uterus lining, known to have elevated incidence in individuals carrying Lynch syndrome mutations.&lt;SEP&gt;Endometrial cancer is a malignancy of the uterine lining evaluated during risk assessments for inherited cancer syndromes linked to thyroid cancer.</data>
      <data key="d3">chunk-d249262ff9e7e657de99a30199159cdf&lt;SEP&gt;chunk-925a474b4538dda470bfd817f9d9a17d&lt;SEP&gt;chunk-18b5e32980f3efa0cd012e2abab9b9fc&lt;SEP&gt;chunk-85e75e869fcfcb7c5431dbcdd532137f</data>
    </node>
    <node id="Hyperplastic Polyp">
      <data key="d0">Hyperplastic Polyp</data>
      <data key="d1">category</data>
      <data key="d2">A hyperplastic polyp is a benign growth in the colon and rectum that rarely transforms into cancer.</data>
      <data key="d3">chunk-925a474b4538dda470bfd817f9d9a17d</data>
    </node>
    <node id="Inflammatory Polyp">
      <data key="d0">Inflammatory Polyp</data>
      <data key="d1">category</data>
      <data key="d2">An inflammatory polyp is a non-cancerous growth on the colorectal inner lining that rarely progresses to malignancy.</data>
      <data key="d3">chunk-925a474b4538dda470bfd817f9d9a17d</data>
    </node>
    <node id="Pelvic MRI">
      <data key="d0">Pelvic MRI</data>
      <data key="d1">category</data>
      <data key="d2">A magnetic resonance imaging test of the pelvis preferred for staging rectal cancer by assessing tumor depth in the rectal wall and lymph node spread.&lt;SEP&gt;Magnetic resonance imaging with contrast centered on the pelvis, recommended after surgery or chemoradiation.&lt;SEP&gt;Pelvic MRI is an advanced diagnostic imaging technique used for staging rectal cancer and monitoring recurrence after surgical procedures.</data>
      <data key="d3">chunk-f2c9770fd98dbbe3c7947601fb3e654c&lt;SEP&gt;chunk-b3ba7430f3a31330247f52afe7e9c68a&lt;SEP&gt;chunk-594536d6aaa61f8f1699ba50bf218a33</data>
    </node>
    <node id="Endorectal Ultrasound">
      <data key="d0">Endorectal Ultrasound</data>
      <data key="d1">category</data>
      <data key="d2">An ultrasound procedure using an inserted probe and sound waves to evaluate rectal cancer extent in the pelvis or guide biopsies, particularly when MRI is not feasible.</data>
      <data key="d3">chunk-594536d6aaa61f8f1699ba50bf218a33</data>
    </node>
    <node id="Ovarian Transposition">
      <data key="d0">Ovarian Transposition</data>
      <data key="d1">category</data>
      <data key="d2">A surgical procedure (oophoropexy) that moves one or both ovaries out of the path of radiation beams to protect hormone production and future pregnancy.&lt;SEP&gt;A surgical procedure (oophoropexy) that repositions the ovaries and fallopian tubes away from the radiation field to preserve fertility.&lt;SEP&gt;A surgical procedure that moves one or both ovaries outside the radiation field to preserve ovarian function and avoid premature menopause.&lt;SEP&gt;A surgical procedure, also known as oophoropexy, that shifts ovaries out of the radiation field to preserve ovarian function.</data>
      <data key="d3">chunk-c9bfa651267335dd5e6ae5a24d85a072&lt;SEP&gt;chunk-06384634b72466c480713ee8d57f25ed&lt;SEP&gt;chunk-be6e1cb2fe11f4d9962741c30d446a69&lt;SEP&gt;chunk-594536d6aaa61f8f1699ba50bf218a33</data>
    </node>
    <node id="Contrast Agent">
      <data key="d0">Contrast Agent</data>
      <data key="d1">category</data>
      <data key="d2">A chemical substance or dye injected into the bloodstream to make tissues, organs, and blood vessels stand out sharply during an MRI scan.&lt;SEP&gt;A diagnostic substance injected intravenously or consumed orally to enhance the clarity and definition of medical imaging scans.&lt;SEP&gt;A substance administered orally or intravenously prior to CT scans to enhance picture clarity, which can occasionally cause allergic reactions.</data>
      <data key="d3">chunk-a18089523f6dcd63cfa5664dc1c01618&lt;SEP&gt;chunk-aeafa486bfd320cdaa7811ad75777912&lt;SEP&gt;chunk-594536d6aaa61f8f1699ba50bf218a33</data>
    </node>
    <node id="Premature Ovarian Insufficiency">
      <data key="d0">Premature Ovarian Insufficiency</data>
      <data key="d1">category</data>
      <data key="d2">A clinical condition also known as radiation-induced premature menopause, caused by radiation damage to the hormone-producing and reproductive function of the ovaries.</data>
      <data key="d3">chunk-594536d6aaa61f8f1699ba50bf218a33</data>
    </node>
    <node id="Sperm Banking">
      <data key="d0">Sperm Banking</data>
      <data key="d1">category</data>
      <data key="d2">A fertility preservation method, medically known as semen cryopreservation, where semen is frozen in liquid nitrogen for future reproductive use.&lt;SEP&gt;A fertility preservation technique (semen cryopreservation) involving freezing semen in liquid nitrogen prior to cancer treatment.&lt;SEP&gt;A method of fertility preservation that involves collecting and freezing semen in liquid nitrogen for future use.</data>
      <data key="d3">chunk-ee254e84e63bd35682ed56c41cef9247&lt;SEP&gt;chunk-06384634b72466c480713ee8d57f25ed&lt;SEP&gt;chunk-594536d6aaa61f8f1699ba50bf218a33</data>
    </node>
    <node id="Egg Freezing">
      <data key="d0">Egg Freezing</data>
      <data key="d1">category</data>
      <data key="d2">A fertility preservation technique (oocyte cryopreservation) involving harvesting and freezing unfertilized eggs before cancer treatment.&lt;SEP&gt;A reproductive preservation procedure, scientifically termed oocyte cryopreservation, in which unfertilized eggs are harvested and frozen for later pregnancy attempts.&lt;SEP&gt;Also called oocyte preservation, a medical procedure in which unfertilized eggs are removed, frozen, and stored for potential future pregnancy.&lt;SEP&gt;Also known as oocyte cryopreservation, a procedure where unfertilized eggs are removed, frozen, and stored for future reproductive use.</data>
      <data key="d3">chunk-ee254e84e63bd35682ed56c41cef9247&lt;SEP&gt;chunk-06384634b72466c480713ee8d57f25ed&lt;SEP&gt;chunk-be6e1cb2fe11f4d9962741c30d446a69&lt;SEP&gt;chunk-594536d6aaa61f8f1699ba50bf218a33</data>
    </node>
    <node id="Ovarian Tissue Banking">
      <data key="d0">Ovarian Tissue Banking</data>
      <data key="d1">category</data>
      <data key="d2">A fertility preservation procedure involving surgical removal and cryopreservation of ovarian tissue containing eggs for future re-implantation.&lt;SEP&gt;A fertility preservation procedure where ovarian tissue containing eggs is removed, cryopreserved, and can later be re-implanted into the body.&lt;SEP&gt;A fertility preservation technique in which ovarian tissue containing eggs is removed, frozen, and preserved for potential reimplantation.</data>
      <data key="d3">chunk-ee254e84e63bd35682ed56c41cef9247&lt;SEP&gt;chunk-06384634b72466c480713ee8d57f25ed&lt;SEP&gt;chunk-594536d6aaa61f8f1699ba50bf218a33</data>
    </node>
    <node id="Mismatch Repair Deficiency">
      <data key="d0">Mismatch Repair Deficiency</data>
      <data key="d1">category</data>
      <data key="d2">A biomarker category (dMMR/MSI-H) evaluated in colon cancer tumors to determine molecular characteristics and guide management.&lt;SEP&gt;A tumor biomarker characteristic (dMMR or MSI-H) resulting in defective DNA mismatch repair, triggering clinical evaluation for hereditary Lynch syndrome.</data>
      <data key="d3">chunk-ee254e84e63bd35682ed56c41cef9247&lt;SEP&gt;chunk-594536d6aaa61f8f1699ba50bf218a33</data>
    </node>
    <node id="Google">
      <data key="d0">Google</data>
      <data key="d1">organization</data>
      <data key="d2">A technology and search engine company referenced regarding patients seeking online diagnostic information.&lt;SEP&gt;A technology company providing online search services, referenced in relation to patients looking up medical diagnoses and statistics on the internet.&lt;SEP&gt;Google is a multinational technology company whose search engine is cautioned against as an unverified source of medical advice ('Dr. Google') for patients seeking health information.</data>
      <data key="d3">chunk-f2c9770fd98dbbe3c7947601fb3e654c&lt;SEP&gt;chunk-4966a628b12ecec4187796598764cf23&lt;SEP&gt;chunk-fa5247d6b8c17e58ab315a0d641c7ad3</data>
    </node>
    <node id="Pedunculated Polyp">
      <data key="d0">Pedunculated Polyp</data>
      <data key="d1">category</data>
      <data key="d2">A pedunculated polyp is a mushroom-shaped growth with a distinct stalk and rounded top that protrudes from the colon wall.&lt;SEP&gt;A pedunculated polyp is a mushroom-shaped growth with a round top and a stalk protruding from the colon wall.</data>
      <data key="d3">chunk-f2c9770fd98dbbe3c7947601fb3e654c&lt;SEP&gt;chunk-b5cfcc365cd093374564eb27dcbf5b82</data>
    </node>
    <node id="Sessile Polyp">
      <data key="d0">Sessile Polyp</data>
      <data key="d1">category</data>
      <data key="d2">A sessile polyp is a flat growth lacking a stalk on the rectal wall, which has a higher likelihood of recurrence following treatment.&lt;SEP&gt;A sessile polyp is a flat growth on the colon wall that lacks a stalk.</data>
      <data key="d3">chunk-f2c9770fd98dbbe3c7947601fb3e654c&lt;SEP&gt;chunk-b5cfcc365cd093374564eb27dcbf5b82</data>
    </node>
    <node id="Malignant Polyp">
      <data key="d0">Malignant Polyp</data>
      <data key="d1">category</data>
      <data key="d2">A malignant polyp is a colon growth in which cancerous cells have begun to develop.&lt;SEP&gt;A malignant polyp is an abnormal growth on the rectal wall in which cancer cells have begun to develop.</data>
      <data key="d3">chunk-f2c9770fd98dbbe3c7947601fb3e654c&lt;SEP&gt;chunk-b5cfcc365cd093374564eb27dcbf5b82</data>
    </node>
    <node id="T1 Tumor">
      <data key="d0">T1 Tumor</data>
      <data key="d1">category</data>
      <data key="d2">A T1 tumor is an early-stage rectal cancer that has not extended beyond the second (muscle) layer of the rectal wall.&lt;SEP&gt;A cancer staging category for smaller rectal tumors that can be treated with abdominal surgery.</data>
      <data key="d3">chunk-f2c9770fd98dbbe3c7947601fb3e654c&lt;SEP&gt;chunk-37bca9f4d2ebaeed359c9b4eb7a0c1de</data>
    </node>
    <node id="T2 Tumor">
      <data key="d0">T2 Tumor</data>
      <data key="d1">category</data>
      <data key="d2">A T2 tumor is a rectal cancer classification where the tumor has invaded into the muscle layer of the rectum.&lt;SEP&gt;A staging category defining rectal tumors that have invaded into the muscular layer of the rectal wall.</data>
      <data key="d3">chunk-f2c9770fd98dbbe3c7947601fb3e654c&lt;SEP&gt;chunk-37bca9f4d2ebaeed359c9b4eb7a0c1de</data>
    </node>
    <node id="Endoscopic Submucosal Dissection">
      <data key="d0">Endoscopic Submucosal Dissection</data>
      <data key="d1">category</data>
      <data key="d2">Endoscopic Submucosal Dissection (ESD), also referred to as endoscopic mucosal resection, is a minimally invasive procedure designed to excise T1 rectal tumors in one piece.</data>
      <data key="d3">chunk-f2c9770fd98dbbe3c7947601fb3e654c</data>
    </node>
    <node id="Transanal Local Excision">
      <data key="d0">Transanal Local Excision</data>
      <data key="d1">category</data>
      <data key="d2">Transanal local excision is a surgical technique for excising low-risk T1 tumors located near the end of the rectum through the anus without removing lymph nodes.</data>
      <data key="d3">chunk-f2c9770fd98dbbe3c7947601fb3e654c</data>
    </node>
    <node id="Transanal Endoscopic Microsurgery">
      <data key="d0">Transanal Endoscopic Microsurgery</data>
      <data key="d1">category</data>
      <data key="d2">Transanal Endoscopic Microsurgery (TEM) is an advanced minimally invasive surgical technique used to remove tumors located higher in the rectum.</data>
      <data key="d3">chunk-f2c9770fd98dbbe3c7947601fb3e654c</data>
    </node>
    <node id="Transanal Minimally Invasive Surgery">
      <data key="d0">Transanal Minimally Invasive Surgery</data>
      <data key="d1">category</data>
      <data key="d2">Transanal Minimally Invasive Surgery (TAMIS) is an advanced technique utilized to excise tumors located higher up in the rectum.</data>
      <data key="d3">chunk-f2c9770fd98dbbe3c7947601fb3e654c</data>
    </node>
    <node id="Microsatellite Stable (MSS)">
      <data key="d0">Microsatellite Stable (MSS)</data>
      <data key="d1">category</data>
      <data key="d2">Microsatellite stable (MSS) is a molecular status classification often evaluated in patients diagnosed with rectal cancer.</data>
      <data key="d3">chunk-f2c9770fd98dbbe3c7947601fb3e654c</data>
    </node>
    <node id="Endoscopic Ultrasound (EUS)">
      <data key="d0">Endoscopic Ultrasound (EUS)</data>
      <data key="d1">category</data>
      <data key="d2">Endoscopic ultrasound (or endorectal ultrasound) is an imaging modality used to assess tumor depth in polyps and monitor patients during post-treatment surveillance.</data>
      <data key="d3">chunk-f2c9770fd98dbbe3c7947601fb3e654c</data>
    </node>
    <node id="Flexible Sigmoidoscopy">
      <data key="d0">Flexible Sigmoidoscopy</data>
      <data key="d1">category</data>
      <data key="d2">Flexible sigmoidoscopy is an endoscopic examination used in post-procedure surveillance following endoscopic submucosal dissection to check for cancer recurrence.</data>
      <data key="d3">chunk-f2c9770fd98dbbe3c7947601fb3e654c</data>
    </node>
    <node id="Proctoscopy">
      <data key="d0">Proctoscopy</data>
      <data key="d1">category</data>
      <data key="d2">A medical procedure using an endoscope to evaluate the anus and rectum for cancer involvement.&lt;SEP&gt;An endoscopic examination of the rectum and bowel under anesthesia to detect cervical cancer extension.&lt;SEP&gt;Proctoscopy is an endoscopic examination of the rectum recommended as a surveillance tool following transanal local excision.</data>
      <data key="d3">chunk-f2c9770fd98dbbe3c7947601fb3e654c&lt;SEP&gt;chunk-e9a7fe3b15f3289198c7114b44890dea&lt;SEP&gt;chunk-be6e1cb2fe11f4d9962741c30d446a69</data>
    </node>
    <node id="Transabdominal Surgery">
      <data key="d0">Transabdominal Surgery</data>
      <data key="d1">category</data>
      <data key="d2">A surgical procedure involving cutting into the abdomen to remove rectal tumors, surrounding tissue, and at least 12 nearby lymph nodes.&lt;SEP&gt;Transabdominal surgery is a major surgical procedure indicated when rectal tumors present high-risk features or invade the muscle layer as T2 tumors.</data>
      <data key="d3">chunk-f2c9770fd98dbbe3c7947601fb3e654c&lt;SEP&gt;chunk-37bca9f4d2ebaeed359c9b4eb7a0c1de</data>
    </node>
    <node id="Early Rectal Cancer">
      <data key="d0">Early Rectal Cancer</data>
      <data key="d1">category</data>
      <data key="d2">Early rectal cancer refers to localized cancerous growths in the rectum that are potentially curable via minimally invasive techniques if detected early.</data>
      <data key="d3">chunk-f2c9770fd98dbbe3c7947601fb3e654c</data>
    </node>
    <node id="Locally Advanced Cancer">
      <data key="d0">Locally Advanced Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A cancer stage classification describing tumors that have extended locally, most commonly treated using chemoradiation.&lt;SEP&gt;A category of advanced rectal cancer that typically warrants treatment using chemoradiation.&lt;SEP&gt;A stage of cervical cancer that has extended beyond early margins and is most commonly managed with chemoradiation.&lt;SEP&gt;Locally advanced cancer describes rectal cancer that has progressed into deeper rectal tissues or nearby nodes without distant metastasis.</data>
      <data key="d3">chunk-f2c9770fd98dbbe3c7947601fb3e654c&lt;SEP&gt;chunk-8ec4d44b145ca896ff1216caa90ce5dd&lt;SEP&gt;chunk-95c76786e9d6dbf06ddf5d55af0cf658&lt;SEP&gt;chunk-37bca9f4d2ebaeed359c9b4eb7a0c1de</data>
    </node>
    <node id="Low Anterior Resection">
      <data key="d0">Low Anterior Resection</data>
      <data key="d1">event</data>
      <data key="d2">A specialized type of transabdominal surgery used to remove tumors located in the mid to upper rectum, often allowing colorectal or coloanal anastomosis.</data>
      <data key="d3">chunk-37bca9f4d2ebaeed359c9b4eb7a0c1de</data>
    </node>
    <node id="Abdominoperineal Resection">
      <data key="d0">Abdominoperineal Resection</data>
      <data key="d1">category</data>
      <data key="d2">A surgical procedure for tumors in the lower rectum that removes the anus, rectum, and surrounding sphincter or pelvic floor muscle, requiring a permanent colostomy.&lt;SEP&gt;A surgical procedure removing the anus, rectum, and nearby tissues, often requiring a colostomy, used for persistent or recurrent anal cancer.&lt;SEP&gt;Abdominoperineal resection (APR) is a major surgical procedure involving the removal of the anus, rectum, and part of the colon, typically followed by a permanent colostomy.&lt;SEP&gt;Abdominoperineal resection (APR) is a radical surgical procedure that removes the anus, rectum, and surrounding tissue, requiring a permanent colostomy.</data>
      <data key="d3">chunk-5349eed06f06d7c9bcb541ced69e4664&lt;SEP&gt;chunk-0d4cea71149e0e4157126efdaa0ea3e3&lt;SEP&gt;chunk-419f40f64b13b1b2d0fac3cfb9fde92a&lt;SEP&gt;chunk-37bca9f4d2ebaeed359c9b4eb7a0c1de</data>
    </node>
    <node id="Local Excision">
      <data key="d0">Local Excision</data>
      <data key="d1">event</data>
      <data key="d2">A conservative surgical procedure that removes the tumor along with a margin of surrounding normal tissue, indicated for certain low-risk perianal cancers.&lt;SEP&gt;A minor surgical procedure to remove localized rectal tumors, after which further treatments may be necessary if high-risk features or muscle invasion are detected.&lt;SEP&gt;A surgical procedure considered for low-grade (G1) and intermediate-grade (G2) perianal cancers to remove the lesion with clear surgical margins.&lt;SEP&gt;A surgical procedure that serves as an alternative to chemoradiation for certain slow-growing stage I and II perianal cancers.</data>
      <data key="d3">chunk-6236b93e627d54f73f1c8fe341127e67&lt;SEP&gt;chunk-0fdcce851d69aa713ed64ba1895bd5d1&lt;SEP&gt;chunk-37bca9f4d2ebaeed359c9b4eb7a0c1de&lt;SEP&gt;chunk-29b3a349650a8bb55b318dcc6ecb0519</data>
    </node>
    <node id="Colostomy Creation">
      <data key="d0">Colostomy Creation</data>
      <data key="d1">event</data>
      <data key="d2">A surgical procedure in which part of the colon is routed through the abdominal wall to create a stoma, either temporarily to allow healing or permanently.</data>
      <data key="d3">chunk-37bca9f4d2ebaeed359c9b4eb7a0c1de</data>
    </node>
    <node id="Colorectal Anastomosis">
      <data key="d0">Colorectal Anastomosis</data>
      <data key="d1">event</data>
      <data key="d2">A surgical reconnection of the colon to the remaining rectum following a low anterior resection to restore near-normal bowel movements.</data>
      <data key="d3">chunk-37bca9f4d2ebaeed359c9b4eb7a0c1de</data>
    </node>
    <node id="Coloanal Anastomosis">
      <data key="d0">Coloanal Anastomosis</data>
      <data key="d1">event</data>
      <data key="d2">A surgical reconnection attaching the colon directly to the anus when the remaining rectum cannot be reconnected.</data>
      <data key="d3">chunk-37bca9f4d2ebaeed359c9b4eb7a0c1de</data>
    </node>
    <node id="Watch And Wait">
      <data key="d0">Watch And Wait</data>
      <data key="d1">category</data>
      <data key="d2">A clinical management strategy and monitoring period during which CLL is closely tracked without immediate therapy.&lt;SEP&gt;A clinical management strategy for CLL where immediate treatment is deferred until symptoms develop or the disease progresses.&lt;SEP&gt;A clinical observation strategy agreed upon by doctor and patient after effective chemoradiation before pursuing further surgery.</data>
      <data key="d3">chunk-098a64d7118fc8e1eb3e91ba0124258c&lt;SEP&gt;chunk-67015f3916810c4378b2ed269cc27f29&lt;SEP&gt;chunk-37bca9f4d2ebaeed359c9b4eb7a0c1de</data>
    </node>
    <node id="T3 Cancer">
      <data key="d0">T3 Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A cancer staging category denoting larger rectal cancers that have not spread to lymph nodes and are eligible for abdominal surgery.</data>
      <data key="d3">chunk-37bca9f4d2ebaeed359c9b4eb7a0c1de</data>
    </node>
    <node id="Stage 1 Cancer">
      <data key="d0">Stage 1 Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A pathologic cancer stage where the rectal tumor has grown into the second or muscle layer without needing further treatment.</data>
      <data key="d3">chunk-37bca9f4d2ebaeed359c9b4eb7a0c1de</data>
    </node>
    <node id="Stage 2 Cancer">
      <data key="d0">Stage 2 Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A pathologic cancer stage where the tumor penetrates through the rectal wall, usually requiring chemotherapy or chemoradiation.</data>
      <data key="d3">chunk-37bca9f4d2ebaeed359c9b4eb7a0c1de</data>
    </node>
    <node id="Stage 3 Cancer">
      <data key="d0">Stage 3 Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A pathologic cancer stage indicating that cancer has spread to nearby lymph nodes, almost always necessitating post-operative chemoradiation or chemotherapy.</data>
      <data key="d3">chunk-37bca9f4d2ebaeed359c9b4eb7a0c1de</data>
    </node>
    <node id="OX Regimen">
      <data key="d0">OX Regimen</data>
      <data key="d1">category</data>
      <data key="d2">A chemotherapy regimen containing oxaliplatin, known to potentially cause peripheral neuropathy in fingers and toes.</data>
      <data key="d3">chunk-37bca9f4d2ebaeed359c9b4eb7a0c1de</data>
    </node>
    <node id="IRI Regimen">
      <data key="d0">IRI Regimen</data>
      <data key="d1">category</data>
      <data key="d2">A chemotherapy regimen containing irinotecan, frequently associated with abdominal cramping, nausea, diarrhea, and hair loss.</data>
      <data key="d3">chunk-37bca9f4d2ebaeed359c9b4eb7a0c1de</data>
    </node>
    <node id="RCC Subtypes">
      <data key="d0">RCC Subtypes</data>
      <data key="d1">category</data>
      <data key="d2">Subtypes of renal cell carcinoma, which represent variants of kidney cancer.</data>
      <data key="d3">chunk-37bca9f4d2ebaeed359c9b4eb7a0c1de</data>
    </node>
    <node id="Renal Cell Carcinoma">
      <data key="d0">Renal Cell Carcinoma</data>
      <data key="d1">category</data>
      <data key="d2">Renal Cell Carcinoma (RCC) is the most common form of kidney cancer, originating in the cells that line the renal tubules in the kidney.&lt;SEP&gt;The most common type of kidney cancer, accounting for approximately 90% of cases, arising from cells that line the renal tubules.</data>
      <data key="d3">chunk-a08bd0a819ea613e781d07188a350438&lt;SEP&gt;chunk-48e138ec8da954a5667dc785e919c86b</data>
    </node>
    <node id="Clear Cell RCC">
      <data key="d0">Clear Cell RCC</data>
      <data key="d1">category</data>
      <data key="d2">Clear Cell RCC (ccRCC) is the most common subtype of Renal Cell Carcinoma, occurring in roughly 7 out of 10 patients, characterized by pale or clear-appearing cells under microscopic histology.&lt;SEP&gt;The most common histological subtype of renal cell carcinoma, accounting for about 70% of RCC cases, characterized by pale or clear-looking cells under microscopy.</data>
      <data key="d3">chunk-a08bd0a819ea613e781d07188a350438&lt;SEP&gt;chunk-48e138ec8da954a5667dc785e919c86b</data>
    </node>
    <node id="Non-Clear Cell RCC">
      <data key="d0">Non-Clear Cell RCC</data>
      <data key="d1">category</data>
      <data key="d2">A grouping of subtypes of renal cell carcinoma that do not exhibit the clear cell histological pattern under microscopy.&lt;SEP&gt;Non-Clear Cell RCC (nccRCC) is a classification encompassing several subtypes of RCC other than clear cell carcinoma, including papillary, chromophobe, and collecting duct variants.</data>
      <data key="d3">chunk-a08bd0a819ea613e781d07188a350438&lt;SEP&gt;chunk-48e138ec8da954a5667dc785e919c86b</data>
    </node>
    <node id="Urothelial Carcinoma">
      <data key="d0">Urothelial Carcinoma</data>
      <data key="d1">category</data>
      <data key="d2">A type of cancer that begins in the cells lining the renal pelvis and ureter, sharing characteristics with bladder cancer.</data>
      <data key="d3">chunk-48e138ec8da954a5667dc785e919c86b</data>
    </node>
    <node id="Wilms Tumor">
      <data key="d0">Wilms Tumor</data>
      <data key="d1">category</data>
      <data key="d2">A type of kidney cancer, also called nephroblastoma, that typically develops in young children.</data>
      <data key="d3">chunk-48e138ec8da954a5667dc785e919c86b</data>
    </node>
    <node id="Renal Sarcoma">
      <data key="d0">Renal Sarcoma</data>
      <data key="d1">category</data>
      <data key="d2">A rare form of cancer that originates in the blood vessels or connective tissue of the kidney.</data>
      <data key="d3">chunk-48e138ec8da954a5667dc785e919c86b</data>
    </node>
    <node id="Irinotecan">
      <data key="d0">Irinotecan</data>
      <data key="d1">category</data>
      <data key="d2">A chemotherapy drug whose presence is indicated by 'IRI' in regimen names, commonly causing side effects such as abdominal cramping, nausea, diarrhea, and hair loss.</data>
      <data key="d3">chunk-48e138ec8da954a5667dc785e919c86b</data>
    </node>
    <node id="Bladder Cancer">
      <data key="d0">Bladder Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A cancer of the bladder that shares many pathological features with urothelial carcinoma.&lt;SEP&gt;A disease category where malignant cells form in the tissues of the bladder, most commonly beginning in the urothelial cells.&lt;SEP&gt;A disease characterized by abnormal cell growth in the inner layer of the bladder, presenting with symptoms such as blood in the urine and categorized across several stages.&lt;SEP&gt;A disease characterized by malignant cell growth in the bladder wall, classified by grade, histological subtype, and stage of muscle invasion.&lt;SEP&gt;A malignancy affecting the urinary bladder and urinary tract that requires specialized diagnostic testing, staging, and treatment.&lt;SEP&gt;A malignancy of the urinary bladder whose treatment depends on cancer stage, grade, and overall health.&lt;SEP&gt;A malignant disease of the urinary bladder and urinary tract investigated and monitored via cystoscopy and imaging scans.&lt;SEP&gt;Bladder cancer is a common cancer in adults that begins when cells in the inner lining (urothelium) of the bladder grow uncontrollably, potentially invading muscle layers and other parts of the body.&lt;SEP&gt;Bladder cancer is a form of cancer requiring treatments such as bladder removal surgery, intravesical therapy, chemotherapy, and immunotherapy.&lt;SEP&gt;Bladder cancer is a malignancy of the urinary bladder, including forms such as muscle-invasive bladder cancer, that requires surgical and therapeutic interventions.&lt;SEP&gt;Bladder cancer is a malignancy originating in the tissues of the urinary bladder, requiring treatments such as surgery, intravesical instillation, or systemic therapies.&lt;SEP&gt;Bladder cancer is a type of cancer affecting the urinary bladder and urinary tract that requires multidisciplinary care, diagnostic testing, and surveillance.&lt;SEP&gt;Bladder cancer is a type of cancer that primarily begins in the urothelial cells lining the bladder wall and is evaluated based on stage and grade.</data>
      <data key="d3">chunk-f2a44e885faf856aa579d824b3cd85e7&lt;SEP&gt;chunk-68217ea9e5382d1756c99b5152ea98db&lt;SEP&gt;chunk-a158766f46bf752d6cdfe95c92f14547&lt;SEP&gt;chunk-29d1ec9b874dd38ef0f3a4a2081f548e&lt;SEP&gt;chunk-7a890e27eba8c63d10f19b85a72fc14a&lt;SEP&gt;chunk-48e138ec8da954a5667dc785e919c86b&lt;SEP&gt;chunk-dea00cf063e8831db4919330d94b1f2a&lt;SEP&gt;chunk-76a038845aaedb9ef7852018f26778b3&lt;SEP&gt;chunk-f9a9eb8b01f29fdf214c10bdffac3203&lt;SEP&gt;chunk-13e723cb8b0af4bcf2f1b0fd37912cb2&lt;SEP&gt;chunk-b0a584e54ffa22e1c25f839302bcd727&lt;SEP&gt;chunk-8aa2c7020ce6e89888e81972588726e3&lt;SEP&gt;chunk-541f1323a24c5990b4a6408e0c5442ab</data>
    </node>
    <node id="Soft Tissue Sarcoma">
      <data key="d0">Soft Tissue Sarcoma</data>
      <data key="d1">category</data>
      <data key="d2">A category of malignant tumors of the connective tissues, referenced in patient guidelines alongside renal sarcoma.&lt;SEP&gt;A major class of sarcomas that develop in supportive body tissues like muscles, fat, nerves, tendons, and blood vessels.</data>
      <data key="d3">chunk-121b68d5de585c87804c9bce3cdc71eb&lt;SEP&gt;chunk-48e138ec8da954a5667dc785e919c86b</data>
    </node>
    <node id="Transitional Cell Cancer">
      <data key="d0">Transitional Cell Cancer</data>
      <data key="d1">category</data>
      <data key="d2">The historical medical designation for urothelial carcinoma, arising in the lining of the urinary tract.</data>
      <data key="d3">chunk-48e138ec8da954a5667dc785e919c86b</data>
    </node>
    <node id="Advanced Kidney Cancer">
      <data key="d0">Advanced Kidney Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A severe stage of renal cancer characterized by tumor growth into and beyond the fibrous tissue of Gerota's fascia.</data>
      <data key="d3">chunk-48e138ec8da954a5667dc785e919c86b</data>
    </node>
    <node id="Urinary System">
      <data key="d0">Urinary System</data>
      <data key="d1">category</data>
      <data key="d2">An organ system consisting of the kidneys, ureters, bladder, and urethra responsible for filtering blood, balancing fluids, and removing waste in the form of urine.</data>
      <data key="d3">chunk-48e138ec8da954a5667dc785e919c86b</data>
    </node>
    <node id="Papillary RCC">
      <data key="d0">Papillary RCC</data>
      <data key="d1">category</data>
      <data key="d2">Papillary RCC (PRCC) is the most common subtype of non-clear cell RCC, found in about 1 out of 10 RCC patients, characterized by long, thin finger-like microscopic structures.</data>
      <data key="d3">chunk-a08bd0a819ea613e781d07188a350438</data>
    </node>
    <node id="Chromophobe RCC">
      <data key="d0">Chromophobe RCC</data>
      <data key="d1">category</data>
      <data key="d2">Chromophobe RCC is a subtype of non-clear cell RCC characterized by pale cells that are larger and structurally distinct from clear cells.</data>
      <data key="d3">chunk-a08bd0a819ea613e781d07188a350438</data>
    </node>
    <node id="Translocation RCC">
      <data key="d0">Translocation RCC</data>
      <data key="d1">category</data>
      <data key="d2">Translocation RCC is an RCC subtype characterized by specific gene fusions that promote cancer, frequently diagnosed in children and younger adults.</data>
      <data key="d3">chunk-a08bd0a819ea613e781d07188a350438</data>
    </node>
    <node id="Collecting Duct RCC">
      <data key="d0">Collecting Duct RCC</data>
      <data key="d1">category</data>
      <data key="d2">Collecting Duct RCC (cdRCC) is a rare subtype of non-clear cell RCC that develops in the cells lining the kidney's collecting ducts or tubules.</data>
      <data key="d3">chunk-a08bd0a819ea613e781d07188a350438</data>
    </node>
    <node id="Renal Medullary Carcinoma">
      <data key="d0">Renal Medullary Carcinoma</data>
      <data key="d1">category</data>
      <data key="d2">Renal Medullary Carcinoma (RMC) is a rare subtype of non-clear cell RCC frequently diagnosed in young individuals of African descent who carry the sickle cell trait or sickle cell disease.</data>
      <data key="d3">chunk-a08bd0a819ea613e781d07188a350438</data>
    </node>
    <node id="Unclassified RCC">
      <data key="d0">Unclassified RCC</data>
      <data key="d1">category</data>
      <data key="d2">Unclassified RCC is a diagnostic category for kidney cancer cells that do not conform to any established subtype or show characteristics of more than one subtype.</data>
      <data key="d3">chunk-a08bd0a819ea613e781d07188a350438</data>
    </node>
    <node id="Sarcomatoid RCC">
      <data key="d0">Sarcomatoid RCC</data>
      <data key="d1">category</data>
      <data key="d2">Sarcomatoid RCC (sRCC) refers to kidney cancers where cells take on the appearance of sarcoma; it can arise from nearly any RCC subtype and tends to be more aggressive and prone to metastasis.</data>
      <data key="d3">chunk-a08bd0a819ea613e781d07188a350438</data>
    </node>
    <node id="Kidney Cancer Diagnosis">
      <data key="d0">Kidney Cancer Diagnosis</data>
      <data key="d1">event</data>
      <data key="d2">Kidney Cancer Diagnosis is the clinical evaluation process utilizing imaging, blood tests, urine tests, biopsy, and biomarker assessments to detect, classify, and stage RCC.</data>
      <data key="d3">chunk-a08bd0a819ea613e781d07188a350438</data>
    </node>
    <node id="Clear Cell Papillary Renal Cell Tumor">
      <data key="d0">Clear Cell Papillary Renal Cell Tumor</data>
      <data key="d1">category</data>
      <data key="d2">Clear Cell Papillary Renal Cell Tumor is a recently defined histological subtype of renal neoplasm.</data>
      <data key="d3">chunk-a08bd0a819ea613e781d07188a350438</data>
    </node>
    <node id="Fumarate Hydratase-Deficient RCC">
      <data key="d0">Fumarate Hydratase-Deficient RCC</data>
      <data key="d1">category</data>
      <data key="d2">Fumarate hydratase-deficient RCC is a recently recognized, rare subtype of renal cell carcinoma characterized by deficient FH enzyme activity.</data>
      <data key="d3">chunk-a08bd0a819ea613e781d07188a350438</data>
    </node>
    <node id="ELOC-Mutated RCC">
      <data key="d0">ELOC-Mutated RCC</data>
      <data key="d1">category</data>
      <data key="d2">ELOC (formerly TCEB1)-mutated RCC is a recently classified molecular subtype of renal cell carcinoma defined by specific ELOC gene alterations.</data>
      <data key="d3">chunk-a08bd0a819ea613e781d07188a350438</data>
    </node>
    <node id="Sarcoma">
      <data key="d0">Sarcoma</data>
      <data key="d1">category</data>
      <data key="d2">A rare classification of cancers that include soft tissue sarcomas and bone sarcomas, making up most primary bone cancers.&lt;SEP&gt;A rare form of malignant tumor that can arise in the cervix, distinguished from common epithelial cervical carcinomas.&lt;SEP&gt;Sarcoma is a broad category of cancer that originates in connective tissues, including muscles, fat, blood vessels, fibrous tissue, and nerves.</data>
      <data key="d3">chunk-b4d036ee5fd77783b9e7ddef3a8477ae&lt;SEP&gt;chunk-a08bd0a819ea613e781d07188a350438&lt;SEP&gt;chunk-121b68d5de585c87804c9bce3cdc71eb</data>
    </node>
    <node id="Sickle Cell Disease">
      <data key="d0">Sickle Cell Disease</data>
      <data key="d1">category</data>
      <data key="d2">Sickle cell disease and sickle cell trait are genetic red blood cell disorders strongly associated with increased risk of developing renal medullary carcinoma.</data>
      <data key="d3">chunk-a08bd0a819ea613e781d07188a350438</data>
    </node>
    <node id="Histology">
      <data key="d0">Histology</data>
      <data key="d1">category</data>
      <data key="d2">A diagnostic classification method based on the microscopic examination of the structure of tumor cells and tissues.&lt;SEP&gt;Histology refers to the microscopic study and characterization of tumor tissue architecture and cell type, essential for determining RCC subtypes and treatment strategies.&lt;SEP&gt;The anatomical study and microscopic classification of cells, tissues, and organs used to determine tumor characteristics and inform treatment planning.&lt;SEP&gt;The microscopic examination and study of tissue and tumor cell morphology used to assign cancer grade.</data>
      <data key="d3">chunk-ffc3446f8ec092af24a460bda94f772f&lt;SEP&gt;chunk-a08bd0a819ea613e781d07188a350438&lt;SEP&gt;chunk-84367cc8f7a94b97b4b66a1ca127c15f&lt;SEP&gt;chunk-562e1870b5e20f8648a2e56d960a1148</data>
    </node>
    <node id="B-Cell ALL">
      <data key="d0">B-Cell ALL</data>
      <data key="d1">category</data>
      <data key="d2">B-cell acute lymphoblastic leukemia (B-ALL) is the most common classification of ALL that originates in B-cell lymphocytes.</data>
      <data key="d3">chunk-a99a89bec88823cedf4c1f0cd1a78e81</data>
    </node>
    <node id="T-Cell ALL">
      <data key="d0">T-Cell ALL</data>
      <data key="d1">category</data>
      <data key="d2">T-cell acute lymphoblastic leukemia (T-ALL) is a major classification of ALL that originates in T-cell lymphocytes.</data>
      <data key="d3">chunk-a99a89bec88823cedf4c1f0cd1a78e81</data>
    </node>
    <node id="Adult Cancer Center">
      <data key="d0">Adult Cancer Center</data>
      <data key="d1">organization</data>
      <data key="d2">A medical facility specialized in treating cancer in adult patients, providing diagnostic, staging, and therapeutic interventions.&lt;SEP&gt;A specialized medical healthcare facility providing adult cancer treatment and related patient care services.</data>
      <data key="d3">chunk-a99a89bec88823cedf4c1f0cd1a78e81&lt;SEP&gt;chunk-82c7205fc2067a4d00e43fd22276db22</data>
    </node>
    <node id="Monocytes">
      <data key="d0">Monocytes</data>
      <data key="d1">category</data>
      <data key="d2">A specific type of white blood cell involved in fighting infections as part of the leukocyte family.</data>
      <data key="d3">chunk-a99a89bec88823cedf4c1f0cd1a78e81</data>
    </node>
    <node id="AYA">
      <data key="d0">AYA</data>
      <data key="d1">category</data>
      <data key="d2">Adolescents and young adults (AYAs) are patients aged 15 to 39 at the time of cancer diagnosis, representing a distinct oncology demographic.</data>
      <data key="d3">chunk-82c7205fc2067a4d00e43fd22276db22</data>
    </node>
    <node id="Pediatric Cancer Center">
      <data key="d0">Pediatric Cancer Center</data>
      <data key="d1">organization</data>
      <data key="d2">A specialized medical institution focusing on the diagnosis, management, and treatment of childhood and adolescent cancers.</data>
      <data key="d3">chunk-82c7205fc2067a4d00e43fd22276db22</data>
    </node>
    <node id="Pediatric Oncologist">
      <data key="d0">Pediatric Oncologist</data>
      <data key="d1">person</data>
      <data key="d2">A specialized medical doctor who diagnoses and treats cancer in infants, children, adolescents, and young adults.</data>
      <data key="d3">chunk-82c7205fc2067a4d00e43fd22276db22</data>
    </node>
    <node id="Adult Oncologist">
      <data key="d0">Adult Oncologist</data>
      <data key="d1">person</data>
      <data key="d2">A physician specializing in the diagnosis and treatment of cancer in adult patients.</data>
      <data key="d3">chunk-82c7205fc2067a4d00e43fd22276db22</data>
    </node>
    <node id="B Cell">
      <data key="d0">B Cell</data>
      <data key="d1">category</data>
      <data key="d2">A type of lymphocyte white blood cell in which B-cell acute lymphoblastic leukemia and related lymphomas originate.</data>
      <data key="d3">chunk-82c7205fc2067a4d00e43fd22276db22</data>
    </node>
    <node id="T Cell">
      <data key="d0">T Cell</data>
      <data key="d1">category</data>
      <data key="d2">A type of lymphocyte white blood cell involved in immune response and the origin of T-ALL and T-LBL malignancies.</data>
      <data key="d3">chunk-82c7205fc2067a4d00e43fd22276db22</data>
    </node>
    <node id="Lymphoblast">
      <data key="d0">Lymphoblast</data>
      <data key="d1">category</data>
      <data key="d2">An immature lymphocyte cell produced in abnormally high amounts in the bone marrow during acute lymphoblastic leukemia.</data>
      <data key="d3">chunk-82c7205fc2067a4d00e43fd22276db22</data>
    </node>
    <node id="Stem Cells">
      <data key="d0">Stem Cells</data>
      <data key="d1">category</data>
      <data key="d2">Progenitor cells located in the bone marrow from which blood cells and acute myeloid leukemia originate.</data>
      <data key="d3">chunk-82c7205fc2067a4d00e43fd22276db22</data>
    </node>
    <node id="Blood Cancer">
      <data key="d0">Blood Cancer</data>
      <data key="d1">category</data>
      <data key="d2">Blood cancer is a broader category of malignancies that disrupt normal blood cell development and function in the bone marrow and bloodstream.</data>
      <data key="d3">chunk-2dc31077c053f79ff82959575d335956</data>
    </node>
    <node id="Lactate Dehydrogenase Test">
      <data key="d0">Lactate Dehydrogenase Test</data>
      <data key="d1">category</data>
      <data key="d2">A blood test measuring LDH levels, utilized in general health evaluations and leukemia workups to assess cellular damage and turnover.&lt;SEP&gt;A blood test measuring the level of the LDH enzyme, which can indicate tissue and cellular damage caused by cancer.&lt;SEP&gt;A diagnostic blood test that measures LDH enzyme released by damaged or rapidly proliferating tumor cells.</data>
      <data key="d3">chunk-3fbf2f6a3c150687a59f814d94f1d150&lt;SEP&gt;chunk-ae28e3852f4a9f229250fc19eb39036b&lt;SEP&gt;chunk-d0f15711706bc171fed17a7fab91b4b6</data>
    </node>
    <node id="Brain CT">
      <data key="d0">Brain CT</data>
      <data key="d1">category</data>
      <data key="d2">A non-contrast computed tomography scan of the head indicated when a central nervous system bleed is suspected in an AML patient.</data>
      <data key="d3">chunk-ae28e3852f4a9f229250fc19eb39036b</data>
    </node>
    <node id="Brain MRI">
      <data key="d0">Brain MRI</data>
      <data key="d1">category</data>
      <data key="d2">A contrast-enhanced magnetic resonance imaging scan of the brain performed when leukemic meningitis is suspected.</data>
      <data key="d3">chunk-ae28e3852f4a9f229250fc19eb39036b</data>
    </node>
    <node id="CNS Bleed">
      <data key="d0">CNS Bleed</data>
      <data key="d1">category</data>
      <data key="d2">A central nervous system hemorrhage, an acute complication screened for using brain CT imaging in symptomatic AML patients.</data>
      <data key="d3">chunk-ae28e3852f4a9f229250fc19eb39036b</data>
    </node>
    <node id="Allogeneic Hematopoietic Cell Transplant">
      <data key="d0">Allogeneic Hematopoietic Cell Transplant</data>
      <data key="d1">event</data>
      <data key="d2">A medical donor cell transplant procedure requiring human leukocyte antigen compatibility to avoid graft rejection or immune reaction.</data>
      <data key="d3">chunk-9fa573748870dc50a98a935843997c68</data>
    </node>
    <node id="Bone Marrow Test">
      <data key="d0">Bone Marrow Test</data>
      <data key="d1">event</data>
      <data key="d2">A clinical procedure in which bone marrow samples are extracted and analyzed to establish a definitive diagnosis of leukemia.&lt;SEP&gt;A diagnostic procedure comprising bone marrow aspirate and biopsy to extract liquid and core cellular samples from the bone marrow.</data>
      <data key="d3">chunk-30c0bb66b1a2f93e89f5342ab1077451&lt;SEP&gt;chunk-9fa573748870dc50a98a935843997c68</data>
    </node>
    <node id="Fertility And Reproductive Specialists">
      <data key="d0">Fertility And Reproductive Specialists</data>
      <data key="d1">person</data>
      <data key="d2">Specialized medical professionals who guide cancer patients through fertility preservation options prior to treatment.</data>
      <data key="d3">chunk-9fa573748870dc50a98a935843997c68</data>
    </node>
    <node id="Blood Relatives">
      <data key="d0">Blood Relatives</data>
      <data key="d1">person</data>
      <data key="d2">Genetically related family members whose tissue or blood samples are tested first to identify a match for an allogeneic stem cell donor.</data>
      <data key="d3">chunk-9fa573748870dc50a98a935843997c68</data>
    </node>
    <node id="White Blood Cell Differential">
      <data key="d0">White Blood Cell Differential</data>
      <data key="d1">category</data>
      <data key="d2">A hematologic laboratory test that counts each specific subtype of white blood cell and detects abnormal blasts.</data>
      <data key="d3">chunk-9fa573748870dc50a98a935843997c68</data>
    </node>
    <node id="Hemoglobin">
      <data key="d0">Hemoglobin</data>
      <data key="d1">category</data>
      <data key="d2">A standard complete blood count metric evaluating oxygen-carrying capacity, used to indicate the need for a red blood cell transfusion.</data>
      <data key="d3">chunk-9fa573748870dc50a98a935843997c68</data>
    </node>
    <node id="Absolute Neutrophil Count">
      <data key="d0">Absolute Neutrophil Count</data>
      <data key="d1">category</data>
      <data key="d2">A laboratory metric measuring neutrophil levels to evaluate a patient's immune defense against bacterial infections.</data>
      <data key="d3">chunk-9fa573748870dc50a98a935843997c68</data>
    </node>
    <node id="Lactate Dehydrogenase">
      <data key="d0">Lactate Dehydrogenase</data>
      <data key="d1">category</data>
      <data key="d2">A cellular enzyme biomarker released into the bloodstream by dying cells or rapidly multiplying tumor cells.</data>
      <data key="d3">chunk-9fa573748870dc50a98a935843997c68</data>
    </node>
    <node id="Red Blood Cell Transfusion">
      <data key="d0">Red Blood Cell Transfusion</data>
      <data key="d1">event</data>
      <data key="d2">A therapeutic medical procedure administered when a patient's hemoglobin levels fall below safe clinical thresholds.</data>
      <data key="d3">chunk-9fa573748870dc50a98a935843997c68</data>
    </node>
    <node id="Performance Status Scales">
      <data key="d0">Performance Status Scales</data>
      <data key="d1">category</data>
      <data key="d2">Measurement systems, such as the ECOG score and Karnofsky Performance Status (KPS), used to assess a patient's functional health and help determine appropriate cancer treatment plans.</data>
      <data key="d3">chunk-0786666c65b5bf00705439d5cb60d5a0</data>
    </node>
    <node id="AML Genetic Changes">
      <data key="d0">AML Genetic Changes</data>
      <data key="d1">category</data>
      <data key="d2">Acquired chromosomal and molecular abnormalities—including deletions, insertions, inversions, point mutations, and translocations—used to classify AML and guide targeted therapies.</data>
      <data key="d3">chunk-0786666c65b5bf00705439d5cb60d5a0</data>
    </node>
    <node id="Hematopathology Review">
      <data key="d0">Hematopathology Review</data>
      <data key="d1">event</data>
      <data key="d2">A diagnostic microscopic review of bone marrow biopsy and aspirate samples to analyze cell size, shape, and overall appearance for AML diagnosis.</data>
      <data key="d3">chunk-0786666c65b5bf00705439d5cb60d5a0</data>
    </node>
    <node id="Molecular Testing">
      <data key="d0">Molecular Testing</data>
      <data key="d1">category</data>
      <data key="d2">A diagnostic classification comprising genomic testing, tumor profiling, gene expression analysis, and tumor sequencing to evaluate DNA mutations and molecular features.&lt;SEP&gt;A specialized laboratory procedure conducted to identify genetic mutations and biomarkers within tumor biopsy tissue.&lt;SEP&gt;Comprehensive diagnostic evaluations—also known as genomic profiling, tumor profiling, or gene expression profiling—used to identify somatic genetic changes and mutations in leukemia cells.</data>
      <data key="d3">chunk-ffc3446f8ec092af24a460bda94f772f&lt;SEP&gt;chunk-0786666c65b5bf00705439d5cb60d5a0&lt;SEP&gt;chunk-562e1870b5e20f8648a2e56d960a1148</data>
    </node>
    <node id="FLT">
      <data key="d0">FLT</data>
      <data key="d1">category</data>
      <data key="d2">A specific mutated gene and protein marker evaluated in AML cells to guide prognostic determination and targeted treatment strategies.</data>
      <data key="d3">chunk-0786666c65b5bf00705439d5cb60d5a0</data>
    </node>
    <node id="Chromosome Translocation And Gene Rearrangement">
      <data key="d0">Chromosome Translocation And Gene Rearrangement</data>
      <data key="d1">category</data>
      <data key="d2">Structural alterations where genetic material switches between chromosomes or genes, exemplified by t(8;21)(q22;q1) and RUNX1::RUNX1T.</data>
      <data key="d3">chunk-0786666c65b5bf00705439d5cb60d5a0</data>
    </node>
    <node id="RUNX1::RUNX1T">
      <data key="d0">RUNX1::RUNX1T</data>
      <data key="d1">category</data>
      <data key="d2">A specific gene rearrangement fusion resulting from a chromosome translocation found in acute myeloid leukemia cells.&lt;SEP&gt;RUNX1::RUNX1T is a genetic mutation and fusion marker associated with acute myeloid leukemia and leukemia predisposition assessment.</data>
      <data key="d3">chunk-db4e8318949a3fda5683c53985c6af05&lt;SEP&gt;chunk-0786666c65b5bf00705439d5cb60d5a0</data>
    </node>
    <node id="PML::RARA">
      <data key="d0">PML::RARA</data>
      <data key="d1">category</data>
      <data key="d2">PML::RARA is a specific gene rearrangement evaluated in leukemia diagnosis and monitored for targeted therapy response.</data>
      <data key="d3">chunk-db4e8318949a3fda5683c53985c6af05</data>
    </node>
    <node id="Hereditary Cancer Syndromes">
      <data key="d0">Hereditary Cancer Syndromes</data>
      <data key="d1">category</data>
      <data key="d2">Hereditary cancer syndromes are inherited genetic conditions passed from parent to child that predispose individuals to cancer development.</data>
      <data key="d3">chunk-db4e8318949a3fda5683c53985c6af05</data>
    </node>
    <node id="Hematopoietic Cell Donors">
      <data key="d0">Hematopoietic Cell Donors</data>
      <data key="d1">person</data>
      <data key="d2">Biological family members evaluated as potential hematopoietic stem cell donors who may be tested for leukemia predisposition syndromes.</data>
      <data key="d3">chunk-db4e8318949a3fda5683c53985c6af05</data>
    </node>
    <node id="Fluorodeoxyglucose">
      <data key="d0">Fluorodeoxyglucose</data>
      <data key="d1">category</data>
      <data key="d2">A radiopharmaceutical tracer composed of fluoride and glucose used in FDG-PET/CT imaging to trace cancer metabolism.&lt;SEP&gt;A radiotracer (FDG) utilized in PET/CT imaging to measure sugar uptake by cells in the body.&lt;SEP&gt;A radiotracer made of fluoride and glucose used in FDG-PET/CT scans to highlight cells taking up high amounts of sugar.</data>
      <data key="d3">chunk-29c9b8b5fd2cd967c48522af79a9598f&lt;SEP&gt;chunk-9ad38c9dc069a8ff8df58c42f00eba23&lt;SEP&gt;chunk-30c0bb66b1a2f93e89f5342ab1077451</data>
    </node>
    <node id="Genetic and Biomarker Tests">
      <data key="d0">Genetic and Biomarker Tests</data>
      <data key="d1">event</data>
      <data key="d2">Laboratory evaluations analyzing gene mutations and chromosomal abnormalities in leukemia cells to determine subtype and prognosis.</data>
      <data key="d3">chunk-29c9b8b5fd2cd967c48522af79a9598f</data>
    </node>
    <node id="Cladribine">
      <data key="d0">Cladribine</data>
      <data key="d1">category</data>
      <data key="d2">An antimetabolite chemotherapy medication (also known as Mavenclad) used in the treatment of leukemia by preventing DNA synthesis.</data>
      <data key="d3">chunk-8333423c91919d7adde114b8286cca7e</data>
    </node>
    <node id="Clofarabine">
      <data key="d0">Clofarabine</data>
      <data key="d1">category</data>
      <data key="d2">An antimetabolite drug (also known as Clolar) used in chemotherapy regimens for leukemia to disrupt cancer cell DNA replication.</data>
      <data key="d3">chunk-8333423c91919d7adde114b8286cca7e</data>
    </node>
    <node id="Cytarabine">
      <data key="d0">Cytarabine</data>
      <data key="d1">category</data>
      <data key="d2">A chemotherapy drug administered in high doses as an alternative treatment strategy for primary CNS lymphoma.&lt;SEP&gt;A core antimetabolite chemotherapy agent (also called Ara-C) administered at varying doses or via intrathecal injection to treat acute myeloid leukemia.&lt;SEP&gt;An antimetabolite chemotherapy medication commonly administered in combination regimens for acute myeloid leukemia.</data>
      <data key="d3">chunk-bb68daec67dd8f436d82814b0e61ff21&lt;SEP&gt;chunk-06f823f3a91fcbc32c62fac3c6347715&lt;SEP&gt;chunk-8333423c91919d7adde114b8286cca7e</data>
    </node>
    <node id="Fludarabine">
      <data key="d0">Fludarabine</data>
      <data key="d1">category</data>
      <data key="d2">An antimetabolite chemotherapy drug that interferes with DNA synthesis in leukemia cells.</data>
      <data key="d3">chunk-8333423c91919d7adde114b8286cca7e</data>
    </node>
    <node id="Methotrexate">
      <data key="d0">Methotrexate</data>
      <data key="d1">category</data>
      <data key="d2">A chemotherapy drug that blocks folate metabolism to inhibit cancer cell growth, frequently used in high doses for primary CNS lymphoma.&lt;SEP&gt;An antimetabolite chemotherapy agent that can be injected into spinal fluid (intrathecally) or given systemically to treat cancer.&lt;SEP&gt;The principal chemotherapy medication utilized in the treatment of primary CNS lymphoma.</data>
      <data key="d3">chunk-bb68daec67dd8f436d82814b0e61ff21&lt;SEP&gt;chunk-9e8b25c2957355218780bdfd8b72df45&lt;SEP&gt;chunk-8333423c91919d7adde114b8286cca7e</data>
    </node>
    <node id="Daunorubicin">
      <data key="d0">Daunorubicin</data>
      <data key="d1">category</data>
      <data key="d2">A traditional chemotherapy drug used in combination with cytarabine and targeted agents to treat acute myeloid leukemia.&lt;SEP&gt;An anthracycline chemotherapy agent that damages DNA to cause leukemic cell death, which carries lifetime dose limits due to cardiac risks.</data>
      <data key="d3">chunk-06f823f3a91fcbc32c62fac3c6347715&lt;SEP&gt;chunk-8333423c91919d7adde114b8286cca7e</data>
    </node>
    <node id="Idarubicin">
      <data key="d0">Idarubicin</data>
      <data key="d1">category</data>
      <data key="d2">An anthracycline medication (Idamycin PFS) used in acute myeloid leukemia treatment regimens.</data>
      <data key="d3">chunk-8333423c91919d7adde114b8286cca7e</data>
    </node>
    <node id="Mitoxantrone">
      <data key="d0">Mitoxantrone</data>
      <data key="d1">category</data>
      <data key="d2">An anthracycline-class drug (Novantrone) employed to disrupt DNA synthesis in cancer cells.</data>
      <data key="d3">chunk-8333423c91919d7adde114b8286cca7e</data>
    </node>
    <node id="CPX-351">
      <data key="d0">CPX-351</data>
      <data key="d1">category</data>
      <data key="d2">A dual-drug liposomal formulation (also known as Vyxeos) combining cytarabine and daunorubicin to deliver antimetabolite and anthracycline therapy together.</data>
      <data key="d3">chunk-8333423c91919d7adde114b8286cca7e</data>
    </node>
    <node id="Azacitidine">
      <data key="d0">Azacitidine</data>
      <data key="d1">category</data>
      <data key="d2">A hypomethylating agent (marketed as Vidaza) used to reverse gene silencing in leukemic cells, allowing them to differentiate into mature normal blood cells.&lt;SEP&gt;A hypomethylating agent that prevents methyl groups from binding to DNA, helping restore normal gene regulation in leukemic blasts.</data>
      <data key="d3">chunk-06f823f3a91fcbc32c62fac3c6347715&lt;SEP&gt;chunk-8333423c91919d7adde114b8286cca7e</data>
    </node>
    <node id="Blood Cells">
      <data key="d0">Blood Cells</data>
      <data key="d1">category</data>
      <data key="d2">Blood cells are specialized cells formed from hematopoietic stem cells in bone marrow, encompassing red blood cells, white blood cells, and platelets.&lt;SEP&gt;Formed elements circulating in blood plasma, categorized primarily into red blood cells, white blood cells, and platelets.</data>
      <data key="d3">chunk-06f823f3a91fcbc32c62fac3c6347715&lt;SEP&gt;chunk-53e3a9418b1d7916e3c8717a397bbb58</data>
    </node>
    <node id="Decitabine">
      <data key="d0">Decitabine</data>
      <data key="d1">category</data>
      <data key="d2">A hypomethylating agent (marketed as Dacogen) that blocks DNA methyl groups to restore normal gene expression and cell maturation in leukemia.</data>
      <data key="d3">chunk-06f823f3a91fcbc32c62fac3c6347715</data>
    </node>
    <node id="Gemtuzumab Ozogamicin">
      <data key="d0">Gemtuzumab Ozogamicin</data>
      <data key="d1">category</data>
      <data key="d2">A targeted therapy conjugate linked to chemotherapy that binds the CD33 surface protein on leukemic blast cells to induce targeted cytotoxic destruction.</data>
      <data key="d3">chunk-06f823f3a91fcbc32c62fac3c6347715</data>
    </node>
    <node id="Gilteritinib">
      <data key="d0">Gilteritinib</data>
      <data key="d1">category</data>
      <data key="d2">A targeted kinase inhibitor used to treat acute myeloid leukemia characterized by specific FLT3 mutations.</data>
      <data key="d3">chunk-06f823f3a91fcbc32c62fac3c6347715</data>
    </node>
    <node id="Quizartinib">
      <data key="d0">Quizartinib</data>
      <data key="d1">category</data>
      <data key="d2">A targeted tyrosine kinase inhibitor indicated for acute myeloid leukemia harboring FLT3-ITD mutations.</data>
      <data key="d3">chunk-06f823f3a91fcbc32c62fac3c6347715</data>
    </node>
    <node id="Midostaurin">
      <data key="d0">Midostaurin</data>
      <data key="d1">category</data>
      <data key="d2">A targeted small-molecule inhibitor used to treat AML carrying FLT3 gene alterations.</data>
      <data key="d3">chunk-06f823f3a91fcbc32c62fac3c6347715</data>
    </node>
    <node id="Sorafenib">
      <data key="d0">Sorafenib</data>
      <data key="d1">category</data>
      <data key="d2">A targeted kinase inhibitor employed in the treatment of acute myeloid leukemia with FLT3-ITD mutations.&lt;SEP&gt;A targeted multikinase inhibitor (marketed as Nexavar) recommended for progressive thyroid cancer that cannot be surgically removed and does not take up iodine.</data>
      <data key="d3">chunk-06f823f3a91fcbc32c62fac3c6347715&lt;SEP&gt;chunk-9d383e4798456aa46e381fd2b02f6f96</data>
    </node>
    <node id="Core Binding Factor">
      <data key="d0">Core Binding Factor</data>
      <data key="d1">category</data>
      <data key="d2">A genetic transcription factor complex whose abnormalities in acute myeloid leukemia cause a deficit in mature blood cell production.</data>
      <data key="d3">chunk-06f823f3a91fcbc32c62fac3c6347715</data>
    </node>
    <node id="CD33">
      <data key="d0">CD33</data>
      <data key="d1">category</data>
      <data key="d2">A cell surface receptor protein prominently expressed on leukemic blasts, serving as a specific target for gemtuzumab ozogamicin.</data>
      <data key="d3">chunk-06f823f3a91fcbc32c62fac3c6347715</data>
    </node>
    <node id="CML">
      <data key="d0">CML</data>
      <data key="d1">category</data>
      <data key="d2">Chronic Myeloid Leukemia (CML) is a blood cancer linked to the BCR::ABL1 fusion gene and the Philadelphia chromosome, characterized by uncontrolled growth of myeloid progenitor cells.</data>
      <data key="d3">chunk-7606b44d6a30ad0519bc4c10785de79a</data>
    </node>
    <node id="Specialized Cancer Centers">
      <data key="d0">Specialized Cancer Centers</data>
      <data key="d1">organization</data>
      <data key="d2">Medical centers with specific clinical expertise and experience in managing and treating Chronic Myeloid Leukemia.</data>
      <data key="d3">chunk-7606b44d6a30ad0519bc4c10785de79a</data>
    </node>
    <node id="Caregivers">
      <data key="d0">Caregivers</data>
      <data key="d1">person</data>
      <data key="d2">Family members, friends, or peers who provide emotional support, meals, transportation, and advocacy during doctor visits for cancer patients.&lt;SEP&gt;Individuals providing personal and emotional care to patients with advanced or metastatic disease.&lt;SEP&gt;Loved ones and supporters providing physical, mental, emotional, and practical care to individuals diagnosed with brain tumors.</data>
      <data key="d3">chunk-7606b44d6a30ad0519bc4c10785de79a&lt;SEP&gt;chunk-8ba71a5181f3814dffb21d3399441bea&lt;SEP&gt;chunk-fa5247d6b8c17e58ab315a0d641c7ad3</data>
    </node>
    <node id="BCR::ABL1 Gene">
      <data key="d0">BCR::ABL1 Gene</data>
      <data key="d1">category</data>
      <data key="d2">A fused abnormal oncogene created by the exchange between chromosomes 9 and 22 that produces an unregulated protein driving CML.</data>
      <data key="d3">chunk-7606b44d6a30ad0519bc4c10785de79a</data>
    </node>
    <node id="Mature B-cell ALL">
      <data key="d0">Mature B-cell ALL</data>
      <data key="d1">category</data>
      <data key="d2">Mature B-cell ALL, also known as Burkitt leukemia, is a rare subtype of ALL that is biologically essentially the same as Burkitt lymphoma but managed with distinct treatment strategies.</data>
      <data key="d3">chunk-53e3a9418b1d7916e3c8717a397bbb58</data>
    </node>
    <node id="B-cell Lymphoblastic Lymphoma">
      <data key="d0">B-cell Lymphoblastic Lymphoma</data>
      <data key="d1">category</data>
      <data key="d2">B-cell lymphoblastic lymphoma (B-LL or B-LBL) is a disease where B-cell lymphoblasts primarily proliferate in the lymph nodes rather than in the bone marrow.</data>
      <data key="d3">chunk-53e3a9418b1d7916e3c8717a397bbb58</data>
    </node>
    <node id="T-cell Lymphoblastic Lymphoma">
      <data key="d0">T-cell Lymphoblastic Lymphoma</data>
      <data key="d1">category</data>
      <data key="d2">T-cell lymphoblastic lymphoma (T-LL or T-LBL) is a condition in which T-cell lymphoblasts grow primarily in the thymus rather than in the bone marrow.</data>
      <data key="d3">chunk-53e3a9418b1d7916e3c8717a397bbb58</data>
    </node>
    <node id="Pediatric ALL">
      <data key="d0">Pediatric ALL</data>
      <data key="d1">category</data>
      <data key="d2">Pediatric ALL refers to acute lymphoblastic leukemia occurring in infants, children, and young adults up to 18 years of age, as well as select adolescents and young adults treated in pediatric oncology settings.</data>
      <data key="d3">chunk-53e3a9418b1d7916e3c8717a397bbb58</data>
    </node>
    <node id="B-Cell Lymphocytes">
      <data key="d0">B-Cell Lymphocytes</data>
      <data key="d1">category</data>
      <data key="d2">B lymphocytes or B cells are white blood cells that produce antibody proteins to protect against infection.</data>
      <data key="d3">chunk-53e3a9418b1d7916e3c8717a397bbb58</data>
    </node>
    <node id="T-Cell Lymphocytes">
      <data key="d0">T-Cell Lymphocytes</data>
      <data key="d1">category</data>
      <data key="d2">T lymphocytes or T cells are specialized immune cells that fight infections, kill tumor cells, and regulate immune responses.</data>
      <data key="d3">chunk-53e3a9418b1d7916e3c8717a397bbb58</data>
    </node>
    <node id="Pediatric Cancer Centers">
      <data key="d0">Pediatric Cancer Centers</data>
      <data key="d1">organization</data>
      <data key="d2">Pediatric cancer centers are specialized healthcare facilities providing oncology treatment tailored for infants, children, and eligible adolescent and young adult patients.</data>
      <data key="d3">chunk-53e3a9418b1d7916e3c8717a397bbb58</data>
    </node>
    <node id="Adult Cancer Centers">
      <data key="d0">Adult Cancer Centers</data>
      <data key="d1">organization</data>
      <data key="d2">Adult cancer centers are specialized medical institutions providing oncology diagnosis and care for adult patients, including some adolescent and young adult populations.</data>
      <data key="d3">chunk-53e3a9418b1d7916e3c8717a397bbb58</data>
    </node>
    <node id="Pancreatic Cancer">
      <data key="d0">Pancreatic Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A cancer that begins in the pancreas, an organ in the digestive system that regulates enzymes and blood sugar levels.&lt;SEP&gt;A complex form of cancer affecting the pancreas, requiring comprehensive diagnostic testing, multidisciplinary staging, and specialized treatment planning.&lt;SEP&gt;A malignancy of the pancreas that is genetically correlated with germline mutations in genes such as BRCA1 and BRCA2.&lt;SEP&gt;A malignant disease that originates in the pancreas, with risk factors including lifestyle habits, chemical exposure, underlying health conditions, and hereditary genetic syndromes.&lt;SEP&gt;A serious abdominal cancer associated with familial cancer syndromes involving BRCA1 and BRCA2 mutations.</data>
      <data key="d3">chunk-6268b6efa690f6e094e443dca6b4cb52&lt;SEP&gt;chunk-b11b0c66441242d2f687a0c55adee585&lt;SEP&gt;chunk-789ec6c06f8c999ac21c89b085b3fdb7&lt;SEP&gt;chunk-0fb70c1c798caae12ac2d64e61bcbad4&lt;SEP&gt;chunk-965e5a6bad03f2129a98be4373f99176</data>
    </node>
    <node id="Pancreatic Ductal Adenocarcinoma">
      <data key="d0">Pancreatic Ductal Adenocarcinoma</data>
      <data key="d1">category</data>
      <data key="d2">The most common form of pancreatic cancer, arising from the exocrine cells that line the ducts of the pancreas.</data>
      <data key="d3">chunk-b11b0c66441242d2f687a0c55adee585</data>
    </node>
    <node id="Pancreatic Neuroendocrine Tumor">
      <data key="d0">Pancreatic Neuroendocrine Tumor</data>
      <data key="d1">category</data>
      <data key="d2">A less common form of pancreatic cancer that originates from the hormone-producing endocrine cells of the pancreas.</data>
      <data key="d3">chunk-b11b0c66441242d2f687a0c55adee585</data>
    </node>
    <node id="BCR::ABL1-Negative Or BCR::ABL1-Like B-ALL">
      <data key="d0">BCR::ABL1-Negative Or BCR::ABL1-Like B-ALL</data>
      <data key="d1">category</data>
      <data key="d2">A common subtype of B-cell acute lymphoblastic leukemia where a clinical trial is often the preferred treatment.</data>
      <data key="d3">chunk-b11b0c66441242d2f687a0c55adee585</data>
    </node>
    <node id="Pancreatic Adenocarcinoma">
      <data key="d0">Pancreatic Adenocarcinoma</data>
      <data key="d1">category</data>
      <data key="d2">A specific form of pancreatic cancer that develops from exocrine cells lining the ducts of the pancreas.</data>
      <data key="d3">chunk-6268b6efa690f6e094e443dca6b4cb52</data>
    </node>
    <node id="Hereditary Breast-Ovarian Cancer Syndrome">
      <data key="d0">Hereditary Breast-Ovarian Cancer Syndrome</data>
      <data key="d1">category</data>
      <data key="d2">A hereditary genetic condition recognized as increasing the risk of developing pancreatic cancer.</data>
      <data key="d3">chunk-6268b6efa690f6e094e443dca6b4cb52</data>
    </node>
    <node id="Peutz-Jeghers Syndrome">
      <data key="d0">Peutz-Jeghers Syndrome</data>
      <data key="d1">category</data>
      <data key="d2">A genetic condition identified as a hereditary risk factor for developing pancreatic cancer.</data>
      <data key="d3">chunk-6268b6efa690f6e094e443dca6b4cb52</data>
    </node>
    <node id="Familial Malignant Melanoma Syndrome">
      <data key="d0">Familial Malignant Melanoma Syndrome</data>
      <data key="d1">category</data>
      <data key="d2">Also known as melanoma-pancreatic cancer syndrome or FAMMM, a hereditary condition that elevates the risk of pancreatic cancer.</data>
      <data key="d3">chunk-6268b6efa690f6e094e443dca6b4cb52</data>
    </node>
    <node id="Hereditary Pancreatitis">
      <data key="d0">Hereditary Pancreatitis</data>
      <data key="d1">category</data>
      <data key="d2">A genetic inflammatory condition of the pancreas known to heighten the risk of pancreatic cancer.</data>
      <data key="d3">chunk-6268b6efa690f6e094e443dca6b4cb52</data>
    </node>
    <node id="Pancreatic Cancer Stages">
      <data key="d0">Pancreatic Cancer Stages</data>
      <data key="d1">category</data>
      <data key="d2">A disease classification system ranging from stage 0 to stage 4 based on tumor size, lymph node involvement, artery invasion, and distant metastasis.</data>
      <data key="d3">chunk-6268b6efa690f6e094e443dca6b4cb52</data>
    </node>
    <node id="Drug Treatment">
      <data key="d0">Drug Treatment</data>
      <data key="d1">category</data>
      <data key="d2">A nonsurgical therapeutic approach that utilizes cancer medications and regimens based on tumor markers to manage cancer progression and alleviate symptoms.</data>
      <data key="d3">chunk-6268b6efa690f6e094e443dca6b4cb52</data>
    </node>
    <node id="Stage 0 Pancreatic Cancer">
      <data key="d0">Stage 0 Pancreatic Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A stage where cancer cells are found only in the innermost layer of the duct wall and have not invaded deeper tissue.</data>
      <data key="d3">chunk-6268b6efa690f6e094e443dca6b4cb52</data>
    </node>
    <node id="Stage 1 Pancreatic Cancer">
      <data key="d0">Stage 1 Pancreatic Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A cancer stage where the tumor is four centimeters or smaller and remains localized completely within the pancreas.</data>
      <data key="d3">chunk-6268b6efa690f6e094e443dca6b4cb52</data>
    </node>
    <node id="Stage 2 Pancreatic Cancer">
      <data key="d0">Stage 2 Pancreatic Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A stage where the tumor exceeds four centimeters or has spread to between one and three nearby lymph nodes.</data>
      <data key="d3">chunk-6268b6efa690f6e094e443dca6b4cb52</data>
    </node>
    <node id="Stage 3 Pancreatic Cancer">
      <data key="d0">Stage 3 Pancreatic Cancer</data>
      <data key="d1">category</data>
      <data key="d2">An advanced local stage where the tumor has invaded nearby major arteries or spread to four or more lymph nodes.</data>
      <data key="d3">chunk-6268b6efa690f6e094e443dca6b4cb52</data>
    </node>
    <node id="Stage 4 Pancreatic Cancer">
      <data key="d0">Stage 4 Pancreatic Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A stage characterized by widespread metastatic dissemination, commonly affecting organs such as the liver, lungs, or abdominal lining.</data>
      <data key="d3">chunk-6268b6efa690f6e094e443dca6b4cb52</data>
    </node>
    <node id="Metastatic Pancreatic Cancer">
      <data key="d0">Metastatic Pancreatic Cancer</data>
      <data key="d1">category</data>
      <data key="d2">Pancreatic cancer that has spread to distant organs and tissues far from the pancreas.</data>
      <data key="d3">chunk-6268b6efa690f6e094e443dca6b4cb52</data>
    </node>
    <node id="Biomarker Tests">
      <data key="d0">Biomarker Tests</data>
      <data key="d1">category</data>
      <data key="d2">A category of specialized blood and urine diagnostic tests—such as 4Kscore, PHI, IsoPSA, ExoDx, and PCA3—used alongside PSA testing to determine the need for further diagnostic intervention.&lt;SEP&gt;A group of diagnostic laboratory evaluations, including FISH, DNA sequencing, and karyotyping, used to identify specific genetic characteristics and mutations to guide cancer treatment.&lt;SEP&gt;Profiling tests performed on cancer tissues to identify specific molecular markers that guide drug regimens and tailored treatments.</data>
      <data key="d3">chunk-67015f3916810c4378b2ed269cc27f29&lt;SEP&gt;chunk-6268b6efa690f6e094e443dca6b4cb52&lt;SEP&gt;chunk-9dc281a303d0d4c5300c0c1c45b739ed</data>
    </node>
    <node id="Imaging">
      <data key="d0">Imaging</data>
      <data key="d1">category</data>
      <data key="d2">Diagnostic procedures used to visualize brain structures, detect tumors, and determine tumor characteristics.&lt;SEP&gt;Diagnostic scanning techniques critical for visualizing tumor size, locating disease, and staging pancreatic cancer.&lt;SEP&gt;Diagnostic scanning techniques, including FDG-PET/CT, CT, and MRI, used to evaluate cancer stage, recurrence, or therapeutic response.&lt;SEP&gt;Medical diagnostic imaging modalities paired with screening tests like PSA or physical exams to assess the prostate.&lt;SEP&gt;Radiological and diagnostic scan procedures utilized to stage bladder cancer and determine whether it has spread.</data>
      <data key="d3">chunk-6268b6efa690f6e094e443dca6b4cb52&lt;SEP&gt;chunk-6232dd9ed168a1113955e7300645338b&lt;SEP&gt;chunk-68217ea9e5382d1756c99b5152ea98db&lt;SEP&gt;chunk-fa5247d6b8c17e58ab315a0d641c7ad3&lt;SEP&gt;chunk-b3ba7430f3a31330247f52afe7e9c68a</data>
    </node>
    <node id="Endoscopic Tests">
      <data key="d0">Endoscopic Tests</data>
      <data key="d1">category</data>
      <data key="d2">Diagnostic procedures using an endoscope to evaluate the pancreas and surrounding structures.&lt;SEP&gt;Internal diagnostic examinations utilized to visualize the gastrointestinal and pancreatic areas to detect abnormalities.</data>
      <data key="d3">chunk-6268b6efa690f6e094e443dca6b4cb52&lt;SEP&gt;chunk-0fb70c1c798caae12ac2d64e61bcbad4</data>
    </node>
    <node id="Multidisciplinary Consult">
      <data key="d0">Multidisciplinary Consult</data>
      <data key="d1">event</data>
      <data key="d2">A collaborative evaluation and consultation session involving diverse medical specialists to evaluate test results and plan treatment.</data>
      <data key="d3">chunk-6268b6efa690f6e094e443dca6b4cb52</data>
    </node>
    <node id="Chronic Inflammation Of The Pancreas">
      <data key="d0">Chronic Inflammation Of The Pancreas</data>
      <data key="d1">category</data>
      <data key="d2">A persistent inflammatory condition of the pancreas that increases the risk of pancreatic cancer development.</data>
      <data key="d3">chunk-6268b6efa690f6e094e443dca6b4cb52</data>
    </node>
    <node id="Pesticides">
      <data key="d0">Pesticides</data>
      <data key="d1">category</data>
      <data key="d2">Cancer-causing chemicals whose significant exposure represents a major environmental risk factor for developing pancreatic cancer.</data>
      <data key="d3">chunk-6268b6efa690f6e094e443dca6b4cb52</data>
    </node>
    <node id="Benign Prostatic Hyperplasia">
      <data key="d0">Benign Prostatic Hyperplasia</data>
      <data key="d1">category</data>
      <data key="d2">A non-cancerous enlargement of the prostate gland (BPH) that shares common urinary symptoms with prostate cancer by compressing the urethra.&lt;SEP&gt;Also called an enlarged prostate, a common non-cancerous condition that causes urinary symptoms similar to prostate cancer by pressing against the bladder and urethra.</data>
      <data key="d3">chunk-1c7418fb993bb3daa95d8563909da1de&lt;SEP&gt;chunk-0fb70c1c798caae12ac2d64e61bcbad4</data>
    </node>
    <node id="Multidisciplinary Care Team">
      <data key="d0">Multidisciplinary Care Team</data>
      <data key="d1">organization</data>
      <data key="d2">A collaborative group of diverse physicians, specialists, and allied health providers who work and communicate together to coordinate and deliver comprehensive cancer patient care.&lt;SEP&gt;A collaborative group of healthcare providers and specialists responsible for assessing, planning, and administering comprehensive treatment for a bladder cancer patient.&lt;SEP&gt;A multidisciplinary care team is a collaborative group of various medical specialists and care providers working together to diagnose, treat, and manage bladder cancer.&lt;SEP&gt;A specialized group of medical providers from various fields (such as oncologists, radiologists, surgeons, and counselors) collaborating at high-volume centers to evaluate and treat cancer patients.</data>
      <data key="d3">chunk-68217ea9e5382d1756c99b5152ea98db&lt;SEP&gt;chunk-9e8b25c2957355218780bdfd8b72df45&lt;SEP&gt;chunk-dea00cf063e8831db4919330d94b1f2a&lt;SEP&gt;chunk-0fb70c1c798caae12ac2d64e61bcbad4</data>
    </node>
    <node id="Consult Meeting">
      <data key="d0">Consult Meeting</data>
      <data key="d1">event</data>
      <data key="d2">A collaborative clinical session where the multidisciplinary care team reviews medical records, evaluates test results, and determines personalized care and treatment plans for a patient.</data>
      <data key="d3">chunk-0fb70c1c798caae12ac2d64e61bcbad4</data>
    </node>
    <node id="Jaundice">
      <data key="d0">Jaundice</data>
      <data key="d1">category</data>
      <data key="d2">A clinical condition and medical symptom characterized by the yellowing of the skin and eyes, frequently serving as an early indicator of pancreatic cancer.</data>
      <data key="d3">chunk-0fb70c1c798caae12ac2d64e61bcbad4</data>
    </node>
    <node id="Erectile Dysfunction">
      <data key="d0">Erectile Dysfunction</data>
      <data key="d1">category</data>
      <data key="d2">A condition characterized by difficulty achieving an erection, identified as one of the potential symptoms associated with prostate issues.&lt;SEP&gt;A condition characterized by difficulty achieving or maintaining an erection, noted as a potential symptom of prostate conditions.&lt;SEP&gt;A male reproductive health condition characterized by difficulty achieving or maintaining an erection, noted as a potential symptom of prostate disorders.</data>
      <data key="d3">chunk-1c7418fb993bb3daa95d8563909da1de&lt;SEP&gt;chunk-c6d28b36fe82792dfb86e98ef76b3b04&lt;SEP&gt;chunk-0fb70c1c798caae12ac2d64e61bcbad4</data>
    </node>
    <node id="Early-Stage Prostate Cancer">
      <data key="d0">Early-Stage Prostate Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A clinical classification of prostate cancer that has not spread beyond the prostate gland, often referred to as localized prostate cancer.&lt;SEP&gt;A localized presentation of prostate cancer with low risk of metastasis, often not requiring extensive diagnostic imaging tests.&lt;SEP&gt;Also referred to as localized prostate cancer, this stage remains confined within the prostate gland, has high survival rates, and is often curable.&lt;SEP&gt;Early-stage prostate cancer, also known as localized prostate cancer, refers to cancer that has not spread beyond the prostate gland and is typically highly treatable.</data>
      <data key="d3">chunk-aeafa486bfd320cdaa7811ad75777912&lt;SEP&gt;chunk-c6d28b36fe82792dfb86e98ef76b3b04&lt;SEP&gt;chunk-aa251c48fc1fccfe45605a384f743662&lt;SEP&gt;chunk-6232dd9ed168a1113955e7300645338b</data>
    </node>
    <node id="Advanced-Stage Prostate Cancer">
      <data key="d0">Advanced-Stage Prostate Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A clinical classification of prostate cancer that has spread outside the prostate to surrounding areas or distant body parts such as bones, liver, lungs, and distant lymph nodes.&lt;SEP&gt;A severe progression of prostate cancer where malignant cells spread beyond the prostate gland to other parts of the body through metastasis.&lt;SEP&gt;A severe stage of prostate cancer where cancer cells may spread outside the prostate gland to other areas of the body.&lt;SEP&gt;A stage of prostate cancer that has spread outside the prostate to regional areas, lymph nodes, bones, or other organs such as the liver or lungs; also known as metastatic prostate cancer.&lt;SEP&gt;Advanced-stage prostate cancer refers to cancer that has spread outside the prostate to regional lymph nodes or metastasized to distant organs and bones.</data>
      <data key="d3">chunk-6232dd9ed168a1113955e7300645338b&lt;SEP&gt;chunk-1c7418fb993bb3daa95d8563909da1de&lt;SEP&gt;chunk-c6d28b36fe82792dfb86e98ef76b3b04&lt;SEP&gt;chunk-aa251c48fc1fccfe45605a384f743662&lt;SEP&gt;chunk-697db1653f51e966e79b92eefeb01ec6</data>
    </node>
    <node id="Risk Factors For Prostate Cancer">
      <data key="d0">Risk Factors For Prostate Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A group of conditions and attributes, including age over 65, family history, genetic mutations like BRCA2, race, obesity, and diet, that increase the likelihood of developing prostate cancer.&lt;SEP&gt;Factors associated with an increased likelihood of developing prostate cancer, notably advancing age (especially 65 and older) and family medical history.</data>
      <data key="d3">chunk-1c7418fb993bb3daa95d8563909da1de&lt;SEP&gt;chunk-c6d28b36fe82792dfb86e98ef76b3b04</data>
    </node>
    <node id="Prostate">
      <data key="d0">Prostate</data>
      <data key="d1">category</data>
      <data key="d2">The prostate is an organ and gland in the male reproductive system located beneath the bladder that produces semen and prostate-specific antigen (PSA).</data>
      <data key="d3">chunk-c6d28b36fe82792dfb86e98ef76b3b04</data>
    </node>
    <node id="BRCA2 Gene">
      <data key="d0">BRCA2 Gene</data>
      <data key="d1">category</data>
      <data key="d2">The BRCA2 gene is a specific gene whose inherited mutations or abnormalities are linked to an increased risk of prostate cancer and other cancers.</data>
      <data key="d3">chunk-c6d28b36fe82792dfb86e98ef76b3b04</data>
    </node>
    <node id="Prostate-Specific Antigen">
      <data key="d0">Prostate-Specific Antigen</data>
      <data key="d1">category</data>
      <data key="d2">A protein produced by the prostate gland whose elevated presence in blood can serve as an indicator of prostate issues or cancer.&lt;SEP&gt;Prostate-specific antigen (PSA) is a protein produced by the prostate gland that nourishes and assists in the transmission of semen.</data>
      <data key="d3">chunk-9dc281a303d0d4c5300c0c1c45b739ed&lt;SEP&gt;chunk-c6d28b36fe82792dfb86e98ef76b3b04</data>
    </node>
    <node id="Semen">
      <data key="d0">Semen</data>
      <data key="d1">category</data>
      <data key="d2">Semen is a reproductive fluid composed of secretions from the prostate and seminal vesicles along with sperm from the testicles.</data>
      <data key="d3">chunk-c6d28b36fe82792dfb86e98ef76b3b04</data>
    </node>
    <node id="Urethra">
      <data key="d0">Urethra</data>
      <data key="d1">category</data>
      <data key="d2">A tube carrying urine and semen from the bladder and reproductive structures out of the body, surrounded by the prostate gland.&lt;SEP&gt;The urethra is a tube that transports urine from the bladder out of the body and carries semen during ejaculation, surrounded by the prostate.</data>
      <data key="d3">chunk-1c7418fb993bb3daa95d8563909da1de&lt;SEP&gt;chunk-c6d28b36fe82792dfb86e98ef76b3b04</data>
    </node>
    <node id="Bladder">
      <data key="d0">Bladder</data>
      <data key="d1">category</data>
      <data key="d2">An organ in the pelvis that stores urine, situated directly above the prostate gland.&lt;SEP&gt;The bladder is an organ in the urinary system that stores urine, situated directly above the prostate.</data>
      <data key="d3">chunk-1c7418fb993bb3daa95d8563909da1de&lt;SEP&gt;chunk-c6d28b36fe82792dfb86e98ef76b3b04</data>
    </node>
    <node id="Seminal Vesicles">
      <data key="d0">Seminal Vesicles</data>
      <data key="d1">category</data>
      <data key="d2">Glands located above the prostate and behind the bladder that make and store fluid that contributes to semen.&lt;SEP&gt;The seminal vesicles are two glands located above the prostate and behind the bladder that produce fluid contributing to semen.</data>
      <data key="d3">chunk-1c7418fb993bb3daa95d8563909da1de&lt;SEP&gt;chunk-c6d28b36fe82792dfb86e98ef76b3b04</data>
    </node>
    <node id="Regional Prostate Cancer">
      <data key="d0">Regional Prostate Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A form of advanced-stage prostate cancer that has spread beyond the prostate into other regions of the pelvis.&lt;SEP&gt;A subcategory of prostate cancer where the disease has extended from the prostate gland to nearby areas like adjacent lymph nodes, but no farther.&lt;SEP&gt;Regional prostate cancer, also known as locally advanced prostate cancer, is cancer that has grown from the prostate gland to nearby lymph nodes but not further.</data>
      <data key="d3">chunk-c6d28b36fe82792dfb86e98ef76b3b04&lt;SEP&gt;chunk-aa251c48fc1fccfe45605a384f743662&lt;SEP&gt;chunk-6232dd9ed168a1113955e7300645338b</data>
    </node>
    <node id="Metastatic Prostate Cancer">
      <data key="d0">Metastatic Prostate Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A clinical category of prostate cancer describing cancer cells that have traveled through the bloodstream or lymphatic system to distant organs or tissues.&lt;SEP&gt;An advanced stage of prostate cancer where malignant cells have spread beyond the primary tumor to regional lymph nodes or bones.&lt;SEP&gt;Metastatic prostate cancer is an advanced stage where cancer cells spread from the prostate to bones, lymph nodes, liver, lungs, and other distant body parts.&lt;SEP&gt;Metastatic prostate cancer refers to advanced prostate cancer that has spread outside the prostate to bones, pelvic lymph nodes, or other organs.</data>
      <data key="d3">chunk-975e540ddee1810d43caf8df4adcf205&lt;SEP&gt;chunk-67e9c4dc95841db7d0af39e1267ae71b&lt;SEP&gt;chunk-c6d28b36fe82792dfb86e98ef76b3b04&lt;SEP&gt;chunk-aa251c48fc1fccfe45605a384f743662</data>
    </node>
    <node id="Early Detection Screening">
      <data key="d0">Early Detection Screening</data>
      <data key="d1">event</data>
      <data key="d2">Diagnostic tests designed to detect prostate cancer at an early stage, which are advised earlier and more frequently for high-risk demographics such as Black males.&lt;SEP&gt;Early detection screening involves clinical diagnostic tests to detect prostate cancer early, especially vital for higher-risk groups.</data>
      <data key="d3">chunk-c6d28b36fe82792dfb86e98ef76b3b04&lt;SEP&gt;chunk-aa251c48fc1fccfe45605a384f743662</data>
    </node>
    <node id="Black Males">
      <data key="d0">Black Males</data>
      <data key="d1">category</data>
      <data key="d2">A demographic group in the United States disproportionately affected by higher incidence, more aggressive onset, and double the mortality rate from prostate cancer compared to white males.&lt;SEP&gt;A demographic group in the United States noted to have a higher incidence of prostate cancer, earlier onset, more aggressive disease, and double the mortality rate compared to white males.</data>
      <data key="d3">chunk-c6d28b36fe82792dfb86e98ef76b3b04&lt;SEP&gt;chunk-aa251c48fc1fccfe45605a384f743662</data>
    </node>
    <node id="White Males">
      <data key="d0">White Males</data>
      <data key="d1">category</data>
      <data key="d2">A demographic group compared in epidemiological studies against Black, Hispanic, and Asian males regarding prostate cancer rates and mortality.&lt;SEP&gt;A demographic group used as a comparative baseline in the United States regarding prostate cancer risk, age of onset, and mortality rates.</data>
      <data key="d3">chunk-c6d28b36fe82792dfb86e98ef76b3b04&lt;SEP&gt;chunk-aa251c48fc1fccfe45605a384f743662</data>
    </node>
    <node id="Diet And Lifestyle">
      <data key="d0">Diet And Lifestyle</data>
      <data key="d1">category</data>
      <data key="d2">Health habits and lifestyle factors, such as dietary fat intake, exercise, smoking, and obesity, that influence the risk, progression, and aggressiveness of prostate cancer.&lt;SEP&gt;Modifiable personal habits and health factors—such as dietary fat intake, consumption of fruits and vegetables, smoking, obesity, and physical exercise—that affect prostate cancer incidence and progression.</data>
      <data key="d3">chunk-c6d28b36fe82792dfb86e98ef76b3b04&lt;SEP&gt;chunk-aa251c48fc1fccfe45605a384f743662</data>
    </node>
    <node id="Health Care Providers">
      <data key="d0">Health Care Providers</data>
      <data key="d1">person</data>
      <data key="d2">A professional category encompassing specialists, radiologists, gynecologists, pathologists, and primary care clinicians who evaluate, diagnose, and treat diseases such as breast cancer.&lt;SEP&gt;Medical professionals and clinical teams responsible for conducting screening tests, evaluating cancer aggressiveness, and designing personalized cancer therapies.&lt;SEP&gt;Medical professionals and doctors who evaluate symptoms, conduct screening tests, and manage prostate cancer diagnosis and care.&lt;SEP&gt;Medical professionals responsible for administering tests, diagnosing disease stages, planning treatment options, and monitoring patient recovery.&lt;SEP&gt;Medical professionals responsible for diagnosing, evaluating symptoms, and recommending specialized testing or treatments for prostate disorders.</data>
      <data key="d3">chunk-6232dd9ed168a1113955e7300645338b&lt;SEP&gt;chunk-1c7418fb993bb3daa95d8563909da1de&lt;SEP&gt;chunk-c6d28b36fe82792dfb86e98ef76b3b04&lt;SEP&gt;chunk-6a93aa507dd7d98a02e8ba92d39e3649&lt;SEP&gt;chunk-aa251c48fc1fccfe45605a384f743662</data>
    </node>
    <node id="Cancer Researchers">
      <data key="d0">Cancer Researchers</data>
      <data key="d1">person</data>
      <data key="d2">Scientists and medical investigators working to understand the underlying causes and cellular mechanisms of prostate cancer.&lt;SEP&gt;Scientists and specialists investigating the causes, biological factors, and treatment therapies of prostate cancer.</data>
      <data key="d3">chunk-1c7418fb993bb3daa95d8563909da1de&lt;SEP&gt;chunk-c6d28b36fe82792dfb86e98ef76b3b04</data>
    </node>
    <node id="Active Surveillance">
      <data key="d0">Active Surveillance</data>
      <data key="d1">category</data>
      <data key="d2">A clinical monitoring strategy for managing prostate cancer that involves periodic confirmatory biopsies without immediate treatment.&lt;SEP&gt;A disease management approach that closely monitors cancer growth through tests and imaging rather than immediately initiating aggressive treatment.&lt;SEP&gt;A management strategy for early-stage prostate cancer involving regular monitoring and testing without immediate treatment, aiming to avoid treatment side effects.&lt;SEP&gt;A non-surgical management method involving regular ultrasound monitoring for small, low-risk papillary thyroid tumors.&lt;SEP&gt;A non-surgical management strategy involving regular monitoring of very-low-risk thyroid cancers instead of immediate surgical intervention.</data>
      <data key="d3">chunk-8a1130b0f6bbe935ceddbafc6ce2740f&lt;SEP&gt;chunk-e74c94f9f2ff33172671e8742338c6d1&lt;SEP&gt;chunk-6232dd9ed168a1113955e7300645338b&lt;SEP&gt;chunk-aeafa486bfd320cdaa7811ad75777912&lt;SEP&gt;chunk-b3c0f6d26f2f58ca13201c1a90b0a180</data>
    </node>
    <node id="Prostate-Specific Antigen Test">
      <data key="d0">Prostate-Specific Antigen Test</data>
      <data key="d1">category</data>
      <data key="d2">A diagnostic blood test measuring the level of PSA protein to detect or monitor prostate cancer and evaluate treatment response.</data>
      <data key="d3">chunk-6232dd9ed168a1113955e7300645338b</data>
    </node>
    <node id="Digital Rectal Exam">
      <data key="d0">Digital Rectal Exam</data>
      <data key="d1">event</data>
      <data key="d2">A clinical physical examination (DRE) of the lower rectum and anus recommended every 3 to 6 months for surveillance after recurrence treatment in patients who did not undergo APR.&lt;SEP&gt;A clinical physical examination of the rectum used as a screening tool to detect abnormal signs of prostate cancer.&lt;SEP&gt;A physical clinical examination used to feel for irregular or hardened areas on the prostate indicative of a tumor.&lt;SEP&gt;A physical diagnostic examination in which a physician inserts a gloved, lubricated finger into the anus and rectum to check for growths or abnormalities.&lt;SEP&gt;A physical examination in which a doctor inserts a gloved finger into the rectum to check the size, texture, and abnormalities of the prostate gland.&lt;SEP&gt;A physical examination of the lower rectum performed repeatedly after diagnosis to evaluate anal cancer.&lt;SEP&gt;A physical examination procedure in which a doctor manually palpates the prostate gland through the rectum to detect hardening, irregularities, or tumors.&lt;SEP&gt;A physical examination procedure utilized to evaluate the size and texture of the prostate gland.&lt;SEP&gt;A standard physical examination method used to detect prostate abnormalities, frequently paired with the PSA test.</data>
      <data key="d3">chunk-9dc281a303d0d4c5300c0c1c45b739ed&lt;SEP&gt;chunk-789ec6c06f8c999ac21c89b085b3fdb7&lt;SEP&gt;chunk-6232dd9ed168a1113955e7300645338b&lt;SEP&gt;chunk-5349eed06f06d7c9bcb541ced69e4664&lt;SEP&gt;chunk-aeafa486bfd320cdaa7811ad75777912&lt;SEP&gt;chunk-9530f389987c13273449ab22a85170ae&lt;SEP&gt;chunk-697db1653f51e966e79b92eefeb01ec6&lt;SEP&gt;chunk-a18089523f6dcd63cfa5664dc1c01618&lt;SEP&gt;chunk-b3c0f6d26f2f58ca13201c1a90b0a180</data>
    </node>
    <node id="Hormone Therapy">
      <data key="d0">Hormone Therapy</data>
      <data key="d1">category</data>
      <data key="d2">A category of medical treatment for cancer that blocks or reduces hormones such as testosterone to control disease progression.&lt;SEP&gt;A systemic cancer treatment used to manage both early-stage and advanced-stage prostate cancer.&lt;SEP&gt;A systemic treatment option utilized in the management of advanced-stage prostate cancer to slow disease growth and extend survival.&lt;SEP&gt;A systemic, whole-body treatment for prostate cancer that works by adding, blocking, or removing hormones, specifically reducing or inhibiting androgens.</data>
      <data key="d3">chunk-b3958b5f7df8a8fc2661705e37dc1e06&lt;SEP&gt;chunk-53c0ac935ec10ce8a0839db4ad053ad1&lt;SEP&gt;chunk-aa251c48fc1fccfe45605a384f743662&lt;SEP&gt;chunk-6232dd9ed168a1113955e7300645338b</data>
    </node>
    <node id="Prostate Cancer Screening Tests">
      <data key="d0">Prostate Cancer Screening Tests</data>
      <data key="d1">category</data>
      <data key="d2">A group of initial medical examinations, including PSA tests and digital rectal exams, used to detect prostate abnormalities in undiagnosed individuals.</data>
      <data key="d3">chunk-6232dd9ed168a1113955e7300645338b</data>
    </node>
    <node id="Diagnostic Tests">
      <data key="d0">Diagnostic Tests</data>
      <data key="d1">category</data>
      <data key="d2">A broad group of medical assessments, including imaging scans, biopsies, and genetic tests, used to confirm, stage, and monitor cancer.&lt;SEP&gt;A class of medical tests and scans used to identify prostate cancer and assess whether it has spread.&lt;SEP&gt;Confirmatory medical evaluations performed following initial screening to establish a prostate cancer diagnosis and determine its stage.</data>
      <data key="d3">chunk-697db1653f51e966e79b92eefeb01ec6&lt;SEP&gt;chunk-67e9c4dc95841db7d0af39e1267ae71b&lt;SEP&gt;chunk-6232dd9ed168a1113955e7300645338b</data>
    </node>
    <node id="Enlarged Prostate">
      <data key="d0">Enlarged Prostate</data>
      <data key="d1">category</data>
      <data key="d2">A benign medical condition affecting the prostate that can elevate PSA levels in the blood.&lt;SEP&gt;A non-cancerous condition affecting the prostate gland that can cause elevated PSA levels.&lt;SEP&gt;A physical condition where the prostate increases in size due to cancer or benign factors, leading to elevated production of PSA.</data>
      <data key="d3">chunk-697db1653f51e966e79b92eefeb01ec6&lt;SEP&gt;chunk-1d61a5e7031ea811cc4dcc55a0a0e8fa&lt;SEP&gt;chunk-6232dd9ed168a1113955e7300645338b</data>
    </node>
    <node id="Urinary Tract Infection">
      <data key="d0">Urinary Tract Infection</data>
      <data key="d1">category</data>
      <data key="d2">A bacterial or other microbial infection of the urinary tract, identified as the most common non-cancerous cause of blood in urine.&lt;SEP&gt;An infection of the urinary system that can cause elevated PSA levels independently of prostate cancer.&lt;SEP&gt;An infection of the urinary system that serves as a non-cancerous cause of elevated PSA levels.</data>
      <data key="d3">chunk-697db1653f51e966e79b92eefeb01ec6&lt;SEP&gt;chunk-8aa2c7020ce6e89888e81972588726e3&lt;SEP&gt;chunk-6232dd9ed168a1113955e7300645338b</data>
    </node>
    <node id="PSA Testing">
      <data key="d0">PSA Testing</data>
      <data key="d1">event</data>
      <data key="d2">A clinical blood testing procedure that measures prostate-specific antigen levels to screen for potential prostate abnormalities or cancer.</data>
      <data key="d3">chunk-9dc281a303d0d4c5300c0c1c45b739ed</data>
    </node>
    <node id="Prostate Gland">
      <data key="d0">Prostate Gland</data>
      <data key="d1">category</data>
      <data key="d2">A male reproductive organ located in the pelvis, subject to cancer development and targeted during biopsy procedures.&lt;SEP&gt;A male reproductive organ that produces prostate-specific antigen and can develop cancerous cell growth.&lt;SEP&gt;A male reproductive organ that produces prostate-specific antigen and is evaluated during prostate exams and cancer screenings.&lt;SEP&gt;A pingpong ball-sized gland in the male reproductive system located below the bladder in the pelvis that produces fluid to nourish and transport sperm.</data>
      <data key="d3">chunk-697db1653f51e966e79b92eefeb01ec6&lt;SEP&gt;chunk-b3c0f6d26f2f58ca13201c1a90b0a180&lt;SEP&gt;chunk-9dc281a303d0d4c5300c0c1c45b739ed&lt;SEP&gt;chunk-1c7418fb993bb3daa95d8563909da1de</data>
    </node>
    <node id="Blood Test">
      <data key="d0">Blood Test</data>
      <data key="d1">event</data>
      <data key="d2">A clinical procedure where blood is drawn via a needle from a vein to analyze cells, proteins, and disease biomarkers.&lt;SEP&gt;A laboratory test evaluating blood samples to detect physical dysfunction or clues of serious illnesses such as cancer.</data>
      <data key="d3">chunk-9dc281a303d0d4c5300c0c1c45b739ed&lt;SEP&gt;chunk-7a890e27eba8c63d10f19b85a72fc14a</data>
    </node>
    <node id="Urine Test">
      <data key="d0">Urine Test</data>
      <data key="d1">event</data>
      <data key="d2">A diagnostic analysis of urine to check for signs of malfunction, hematuria, or urinary system cancer.&lt;SEP&gt;A diagnostic procedure examining urine samples to detect specific biomarkers associated with prostate cancer risk.</data>
      <data key="d3">chunk-9dc281a303d0d4c5300c0c1c45b739ed&lt;SEP&gt;chunk-7a890e27eba8c63d10f19b85a72fc14a</data>
    </node>
    <node id="4Kscore">
      <data key="d0">4Kscore</data>
      <data key="d1">category</data>
      <data key="d2">A specialized blood biomarker test used to assess the risk of aggressive prostate cancer and determine if a biopsy is warranted.</data>
      <data key="d3">chunk-9dc281a303d0d4c5300c0c1c45b739ed</data>
    </node>
    <node id="PHI">
      <data key="d0">PHI</data>
      <data key="d1">category</data>
      <data key="d2">Prostate Health Index, a blood biomarker test used alongside PSA levels to refine prostate cancer risk evaluation.</data>
      <data key="d3">chunk-9dc281a303d0d4c5300c0c1c45b739ed</data>
    </node>
    <node id="IsoPSA">
      <data key="d0">IsoPSA</data>
      <data key="d1">category</data>
      <data key="d2">A blood biomarker test evaluating structural forms of PSA to differentiate cancer risk from benign conditions.</data>
      <data key="d3">chunk-9dc281a303d0d4c5300c0c1c45b739ed</data>
    </node>
    <node id="ExoDx">
      <data key="d0">ExoDx</data>
      <data key="d1">category</data>
      <data key="d2">A non-invasive urine biomarker test used to assess the risk of high-grade prostate cancer.</data>
      <data key="d3">chunk-9dc281a303d0d4c5300c0c1c45b739ed</data>
    </node>
    <node id="miR Sentinel">
      <data key="d0">miR Sentinel</data>
      <data key="d1">category</data>
      <data key="d2">A non-invasive urine-based microRNA biomarker test used to detect and assess prostate cancer.</data>
      <data key="d3">chunk-9dc281a303d0d4c5300c0c1c45b739ed</data>
    </node>
    <node id="MPS">
      <data key="d0">MPS</data>
      <data key="d1">category</data>
      <data key="d2">Michigan Prostate Score, a urine-based biomarker test combining urine markers and PSA to evaluate prostate cancer risk.</data>
      <data key="d3">chunk-9dc281a303d0d4c5300c0c1c45b739ed</data>
    </node>
    <node id="PCA3">
      <data key="d0">PCA3</data>
      <data key="d1">category</data>
      <data key="d2">A prostate-specific non-coding RNA urine test used as a biomarker for prostate cancer detection.</data>
      <data key="d3">chunk-9dc281a303d0d4c5300c0c1c45b739ed</data>
    </node>
    <node id="SelectMDx">
      <data key="d0">SelectMDx</data>
      <data key="d1">category</data>
      <data key="d2">A urine biomarker gene-expression test that assesses the risk of aggressive prostate cancer to guide biopsy decisions.</data>
      <data key="d3">chunk-9dc281a303d0d4c5300c0c1c45b739ed</data>
    </node>
    <node id="CT">
      <data key="d0">CT</data>
      <data key="d1">category</data>
      <data key="d2">Computed Tomography, an imaging test providing cross-sectional anatomical pictures to detect cancer spread.</data>
      <data key="d3">chunk-9dc281a303d0d4c5300c0c1c45b739ed</data>
    </node>
    <node id="PET">
      <data key="d0">PET</data>
      <data key="d1">category</data>
      <data key="d2">Positron Emission Tomography, a nuclear imaging technique used to observe metabolic processes and detect cancer metastasis.</data>
      <data key="d3">chunk-9dc281a303d0d4c5300c0c1c45b739ed</data>
    </node>
    <node id="Laboratory">
      <data key="d0">Laboratory</data>
      <data key="d1">organization</data>
      <data key="d2">A diagnostic medical facility where blood and urine samples, cells, and proteins are examined for signs of disease.&lt;SEP&gt;A specialized diagnostic facility where brain biopsy tissue samples are examined by neuropathologists.</data>
      <data key="d3">chunk-ffc3446f8ec092af24a460bda94f772f&lt;SEP&gt;chunk-9dc281a303d0d4c5300c0c1c45b739ed</data>
    </node>
    <node id="PSMA/PET Scan">
      <data key="d0">PSMA/PET Scan</data>
      <data key="d1">event</data>
      <data key="d2">A specialized PET scan targeting prostate-specific membrane antigen to detect cancer recurrence or spread to lymph nodes and other organs.</data>
      <data key="d3">chunk-aeafa486bfd320cdaa7811ad75777912</data>
    </node>
    <node id="PSA Test">
      <data key="d0">PSA Test</data>
      <data key="d1">event</data>
      <data key="d2">A blood screening test that measures the concentration of prostate-specific antigen to detect prostate issues or evaluate cancer treatment response.&lt;SEP&gt;A diagnostic blood test that measures prostate-specific antigen levels to identify signs of prostate cancer and determine risk stratification.&lt;SEP&gt;A diagnostic laboratory test measuring prostate-specific antigen in the blood, used to assess prostate health and determine cancer risk.&lt;SEP&gt;A routine blood test that measures prostate-specific antigen levels in the bloodstream.</data>
      <data key="d3">chunk-697db1653f51e966e79b92eefeb01ec6&lt;SEP&gt;chunk-1d61a5e7031ea811cc4dcc55a0a0e8fa&lt;SEP&gt;chunk-aeafa486bfd320cdaa7811ad75777912&lt;SEP&gt;chunk-789ec6c06f8c999ac21c89b085b3fdb7</data>
    </node>
    <node id="PET/MRI Scan">
      <data key="d0">PET/MRI Scan</data>
      <data key="d1">event</data>
      <data key="d2">A combined diagnostic imaging scan integrating positron emission tomography with magnetic resonance imaging for comprehensive cancer staging.&lt;SEP&gt;A combined imaging method integrating positron emission tomography and magnetic resonance imaging to provide comprehensive diagnostic views.</data>
      <data key="d3">chunk-67e9c4dc95841db7d0af39e1267ae71b&lt;SEP&gt;chunk-aeafa486bfd320cdaa7811ad75777912</data>
    </node>
    <node id="Prostate-Specific Membrane Antigen">
      <data key="d0">Prostate-Specific Membrane Antigen</data>
      <data key="d1">category</data>
      <data key="d2">A protein abundantly produced on the surface of prostate cancer cells, targeted by specialized imaging agents in PSMA/PET scans.&lt;SEP&gt;Prostate-specific membrane antigen (PSMA) is a protein found in high quantities on the surface of prostate cancer cells, serving as a target for imaging tracers and therapies.</data>
      <data key="d3">chunk-975e540ddee1810d43caf8df4adcf205&lt;SEP&gt;chunk-aeafa486bfd320cdaa7811ad75777912</data>
    </node>
    <node id="Urologist">
      <data key="d0">Urologist</data>
      <data key="d1">person</data>
      <data key="d2">A medical doctor specializing in the diagnosis and treatment of diseases of the urinary system and male reproductive organs, who performs prostate biopsies.&lt;SEP&gt;A medical doctor specializing in the urinary system who performs cystoscopies, takes biopsies, and removes small cancerous growths.&lt;SEP&gt;A medical specialist in diseases of the urinary tract who stages and treats bladder cancer and discusses options with patients.&lt;SEP&gt;A surgical specialist who guides instruments through the urethra to perform TURBT procedures and treat bladder cancer.&lt;SEP&gt;A urologist is a medical specialist focused on the urinary system and male reproductive organs who performs cystoscopies and collects urine samples.&lt;SEP&gt;A urologist is a medical specialist focused on the urinary system and male reproductive organs who performs prostate biopsies.&lt;SEP&gt;A urologist is a surgical medical specialist specializing in diseases of the urinary tract who guides surgical interventions and care for bladder cancer patients.</data>
      <data key="d3">chunk-f2a44e885faf856aa579d824b3cd85e7&lt;SEP&gt;chunk-975e540ddee1810d43caf8df4adcf205&lt;SEP&gt;chunk-a158766f46bf752d6cdfe95c92f14547&lt;SEP&gt;chunk-76a038845aaedb9ef7852018f26778b3&lt;SEP&gt;chunk-13e723cb8b0af4bcf2f1b0fd37912cb2&lt;SEP&gt;chunk-b3c0f6d26f2f58ca13201c1a90b0a180&lt;SEP&gt;chunk-dea00cf063e8831db4919330d94b1f2a</data>
    </node>
    <node id="Testing Lab">
      <data key="d0">Testing Lab</data>
      <data key="d1">organization</data>
      <data key="d2">A medical laboratory facility where biopsy samples are sent to be analyzed and tested for cancer by pathologists.</data>
      <data key="d3">chunk-b3c0f6d26f2f58ca13201c1a90b0a180</data>
    </node>
    <node id="Prostate Biopsy">
      <data key="d0">Prostate Biopsy</data>
      <data key="d1">event</data>
      <data key="d2">A prostate biopsy is an invasive medical procedure in which core tissue samples are extracted from the prostate gland to diagnose cancer.&lt;SEP&gt;An invasive diagnostic procedure where tissue core samples are removed from the prostate to confirm and evaluate prostate cancer.</data>
      <data key="d3">chunk-975e540ddee1810d43caf8df4adcf205&lt;SEP&gt;chunk-b3c0f6d26f2f58ca13201c1a90b0a180</data>
    </node>
    <node id="Transperineal Biopsy">
      <data key="d0">Transperineal Biopsy</data>
      <data key="d1">event</data>
      <data key="d2">A biopsy method where a needle is inserted through the perineum (the skin between the anus and scrotum) to obtain prostate core samples under ultrasound guidance.&lt;SEP&gt;A specific prostate biopsy procedure in which a needle is inserted through the perineum into the prostate using ultrasound guidance.</data>
      <data key="d3">chunk-975e540ddee1810d43caf8df4adcf205&lt;SEP&gt;chunk-b3c0f6d26f2f58ca13201c1a90b0a180</data>
    </node>
    <node id="Confirmatory Biopsy">
      <data key="d0">Confirmatory Biopsy</data>
      <data key="d1">event</data>
      <data key="d2">A follow-up biopsy typically performed within a year during active surveillance to check for changes over time.</data>
      <data key="d3">chunk-b3c0f6d26f2f58ca13201c1a90b0a180</data>
    </node>
    <node id="Germline Testing">
      <data key="d0">Germline Testing</data>
      <data key="d1">category</data>
      <data key="d2">A genetic evaluation conducted to identify inherited genetic mutations across all cells in an individual's body.&lt;SEP&gt;A type of genetic testing performed using blood, urine, or saliva to identify inherited gene mutations that increase cancer risk.&lt;SEP&gt;A type of genetic testing that analyzes blood, saliva, urine, or tumor samples to detect inherited mutations linked to cancer risk.</data>
      <data key="d3">chunk-b3958b5f7df8a8fc2661705e37dc1e06&lt;SEP&gt;chunk-b3c0f6d26f2f58ca13201c1a90b0a180&lt;SEP&gt;chunk-7a890e27eba8c63d10f19b85a72fc14a</data>
    </node>
    <node id="Genetic Mutation">
      <data key="d0">Genetic Mutation</data>
      <data key="d1">category</data>
      <data key="d2">An abnormal change in DNA sequences that can disrupt protein production and potentially lead to diseases like cancer.</data>
      <data key="d3">chunk-b3c0f6d26f2f58ca13201c1a90b0a180</data>
    </node>
    <node id="Germline Mutation">
      <data key="d0">Germline Mutation</data>
      <data key="d1">category</data>
      <data key="d2">An inherited gene mutation passed from biological parents to children, identifiable via genetic testing of blood or saliva.&lt;SEP&gt;An inherited genetic mutation present in every cell of the body passed down through family lines.</data>
      <data key="d3">chunk-b3c0f6d26f2f58ca13201c1a90b0a180&lt;SEP&gt;chunk-30c0bb66b1a2f93e89f5342ab1077451</data>
    </node>
    <node id="Somatic Mutation">
      <data key="d0">Somatic Mutation</data>
      <data key="d1">category</data>
      <data key="d2">A genetic alteration that occurs independently within tumor cells rather than being inherited.&lt;SEP&gt;A non-inherited genetic alteration occurring from errors during cell division while tissues grow, such as chromosomal translocations in Ewing sarcoma.&lt;SEP&gt;An acquired genetic alteration that occurs spontaneously or via environmental factors later in life in specific cells, rather than being inherited.&lt;SEP&gt;An acquired genetic mutation that occurs spontaneously in specific cells later in life rather than being inherited.&lt;SEP&gt;Non-inherited genetic alterations or changes occurring within tumor cells.</data>
      <data key="d3">chunk-b3958b5f7df8a8fc2661705e37dc1e06&lt;SEP&gt;chunk-30c0bb66b1a2f93e89f5342ab1077451&lt;SEP&gt;chunk-965e5a6bad03f2129a98be4373f99176&lt;SEP&gt;chunk-6b02315423350f3598288e189fbcb8ae&lt;SEP&gt;chunk-b3c0f6d26f2f58ca13201c1a90b0a180</data>
    </node>
    <node id="BRCA1">
      <data key="d0">BRCA1</data>
      <data key="d1">category</data>
      <data key="d2">A gene involved in DNA repair; mutations in this gene elevate the risk of prostate, breast, ovarian, pancreatic, and skin cancers.&lt;SEP&gt;A specific gene evaluated in prostate cancer germline testing for characteristic mutations linked to increased cancer risk.&lt;SEP&gt;A tumor suppressor gene that, when mutated, elevates the risk of breast, ovarian, prostate, colorectal, pancreatic, and melanoma cancers.</data>
      <data key="d3">chunk-650982a589c2d527bc13923ccd0569ef&lt;SEP&gt;chunk-b3c0f6d26f2f58ca13201c1a90b0a180&lt;SEP&gt;chunk-965e5a6bad03f2129a98be4373f99176</data>
    </node>
    <node id="BRCA2">
      <data key="d0">BRCA2</data>
      <data key="d1">category</data>
      <data key="d2">A key tumor suppressor and DNA repair gene frequently analyzed in hereditary and somatic testing for prostate and other cancers.&lt;SEP&gt;A specific gene evaluated in prostate cancer germline testing for inherited mutations associated with cancer risk.&lt;SEP&gt;A tumor suppressor gene whose mutations increase susceptibility to breast, ovarian, and other hereditary cancers.</data>
      <data key="d3">chunk-650982a589c2d527bc13923ccd0569ef&lt;SEP&gt;chunk-b3c0f6d26f2f58ca13201c1a90b0a180&lt;SEP&gt;chunk-965e5a6bad03f2129a98be4373f99176</data>
    </node>
    <node id="Pelvis">
      <data key="d0">Pelvis</data>
      <data key="d1">geo</data>
      <data key="d2">A basin-shaped anatomical structure supporting the spine, with distinct segmental staging parameters for bone tumors.&lt;SEP&gt;An anatomical region of the human body used as a boundary marker in staging distant metastases in prostate cancer.&lt;SEP&gt;An anatomical region of the human body where prostate cancer and pelvic lymph nodes are located.&lt;SEP&gt;The anatomical pelvic region encompassing the anal canal, bladder, reproductive organs, and regional lymph nodes targeted during radiation therapy.</data>
      <data key="d3">chunk-b0bad5ee25cb854c10bdbc9d33b54a1a&lt;SEP&gt;chunk-b3958b5f7df8a8fc2661705e37dc1e06&lt;SEP&gt;chunk-b3c0f6d26f2f58ca13201c1a90b0a180&lt;SEP&gt;chunk-74f18dd51a0091fc888512458a85b0a1</data>
    </node>
    <node id="Pelvic Lymph Node">
      <data key="d0">Pelvic Lymph Node</data>
      <data key="d1">geo</data>
      <data key="d2">An anatomical location in the pelvic region where prostate cancer can spread, detectable as a bright red spot on imaging.</data>
      <data key="d3">chunk-b3c0f6d26f2f58ca13201c1a90b0a180</data>
    </node>
    <node id="Rectum">
      <data key="d0">Rectum</data>
      <data key="d1">geo</data>
      <data key="d2">An anatomical site where an ultrasound or visual probe is inserted to image the prostate and guide biopsy needles.</data>
      <data key="d3">chunk-b3c0f6d26f2f58ca13201c1a90b0a180</data>
    </node>
    <node id="Perineum">
      <data key="d0">Perineum</data>
      <data key="d1">geo</data>
      <data key="d2">The anatomical skin area between the anus and the scrotum through which a needle is inserted during a transperineal biopsy.</data>
      <data key="d3">chunk-b3c0f6d26f2f58ca13201c1a90b0a180</data>
    </node>
    <node id="Bone">
      <data key="d0">Bone</data>
      <data key="d1">geo</data>
      <data key="d2">Skeletal anatomical structures examined with cameras and tracers to identify damage from cancer spread or treatment.</data>
      <data key="d3">chunk-b3c0f6d26f2f58ca13201c1a90b0a180</data>
    </node>
    <node id="Molecular Biomarker Testing">
      <data key="d0">Molecular Biomarker Testing</data>
      <data key="d1">event</data>
      <data key="d2">A diagnostic laboratory procedure, also called genomic testing or tumor profiling, that evaluates biopsy samples to assess cancer aggressiveness and potential spread.&lt;SEP&gt;A genetic diagnostic procedure used in prostate cancer care alongside germline testing to analyze tumor markers.</data>
      <data key="d3">chunk-b3c0f6d26f2f58ca13201c1a90b0a180&lt;SEP&gt;chunk-789ec6c06f8c999ac21c89b085b3fdb7</data>
    </node>
    <node id="PSA Level">
      <data key="d0">PSA Level</data>
      <data key="d1">category</data>
      <data key="d2">A diagnostic measurement indicating the amount of prostate-specific antigen in the blood, used to evaluate potential prostate cancer risk.&lt;SEP&gt;Prostate-Specific Antigen level measured in clinical tests, where high amounts can indicate potential prostate cancer.</data>
      <data key="d3">chunk-1d61a5e7031ea811cc4dcc55a0a0e8fa&lt;SEP&gt;chunk-b3c0f6d26f2f58ca13201c1a90b0a180</data>
    </node>
    <node id="ATM">
      <data key="d0">ATM</data>
      <data key="d1">category</data>
      <data key="d2">A gene involved in DNA repair and cell division regulation, tested in both germline and tumor profiling.&lt;SEP&gt;A specific gene evaluated in prostate cancer germline testing for inherited mutations associated with increased cancer risk.</data>
      <data key="d3">chunk-b3c0f6d26f2f58ca13201c1a90b0a180&lt;SEP&gt;chunk-965e5a6bad03f2129a98be4373f99176</data>
    </node>
    <node id="CHEK2">
      <data key="d0">CHEK2</data>
      <data key="d1">category</data>
      <data key="d2">A specific human gene tested during germline cancer testing for alterations that elevate disease risk.&lt;SEP&gt;A tumor suppressor gene that provides instructions for producing a protein that prevents cells from dividing too rapidly.</data>
      <data key="d3">chunk-b3c0f6d26f2f58ca13201c1a90b0a180&lt;SEP&gt;chunk-965e5a6bad03f2129a98be4373f99176</data>
    </node>
    <node id="MLH1">
      <data key="d0">MLH1</data>
      <data key="d1">category</data>
      <data key="d2">A human gene analyzed during germline genetic evaluations to detect inherited mutations linked to cancer risk.&lt;SEP&gt;A mismatch repair gene associated with increased risk of colorectal, uterine, and prostate cancers.</data>
      <data key="d3">chunk-b3c0f6d26f2f58ca13201c1a90b0a180&lt;SEP&gt;chunk-965e5a6bad03f2129a98be4373f99176</data>
    </node>
    <node id="MSH2">
      <data key="d0">MSH2</data>
      <data key="d1">category</data>
      <data key="d2">A DNA mismatch repair gene linked to hereditary predispositions for cancers including colorectal, uterine, and prostate cancer.&lt;SEP&gt;A gene evaluated during genetic germline tests to determine risk profiles for prostate and other cancers.</data>
      <data key="d3">chunk-b3c0f6d26f2f58ca13201c1a90b0a180&lt;SEP&gt;chunk-965e5a6bad03f2129a98be4373f99176</data>
    </node>
    <node id="MSH6">
      <data key="d0">MSH6</data>
      <data key="d1">category</data>
      <data key="d2">A DNA mismatch repair gene monitored in genetic panels for prostate and other gastrointestinal/gynecological cancers.&lt;SEP&gt;A specific gene analyzed in germline genetic testing for mutations contributing to hereditary cancer risk.</data>
      <data key="d3">chunk-b3c0f6d26f2f58ca13201c1a90b0a180&lt;SEP&gt;chunk-965e5a6bad03f2129a98be4373f99176</data>
    </node>
    <node id="PALB2">
      <data key="d0">PALB2</data>
      <data key="d1">category</data>
      <data key="d2">A gene checked during germline screening for mutations linked to inherited susceptibility to prostate cancer.&lt;SEP&gt;A gene that collaborates with BRCA2 in DNA repair, implicated in hereditary prostate cancer risk and targeted therapy suitability.</data>
      <data key="d3">chunk-b3c0f6d26f2f58ca13201c1a90b0a180&lt;SEP&gt;chunk-965e5a6bad03f2129a98be4373f99176</data>
    </node>
    <node id="PMS2">
      <data key="d0">PMS2</data>
      <data key="d1">category</data>
      <data key="d2">A DNA repair gene linked with hereditary cancer syndromes and tested alongside MLH1, MSH2, and MSH6.&lt;SEP&gt;A gene examined in genetic germline panels for prostate cancer to identify hereditary risk mutations.</data>
      <data key="d3">chunk-b3c0f6d26f2f58ca13201c1a90b0a180&lt;SEP&gt;chunk-965e5a6bad03f2129a98be4373f99176</data>
    </node>
    <node id="Germline Mutations">
      <data key="d0">Germline Mutations</data>
      <data key="d1">category</data>
      <data key="d2">Inherited genetic mutations present in every cell of the body, such as mutations in BRCA1, BRCA2, ATM, and CHEK2, associated with elevated risk for multiple cancers.</data>
      <data key="d3">chunk-789ec6c06f8c999ac21c89b085b3fdb7</data>
    </node>
    <node id="Genetic Germline Testing">
      <data key="d0">Genetic Germline Testing</data>
      <data key="d1">category</data>
      <data key="d2">A diagnostic genetic testing procedure performed on blood, urine, or saliva to detect inherited mutations linked to prostate and other cancers.</data>
      <data key="d3">chunk-789ec6c06f8c999ac21c89b085b3fdb7</data>
    </node>
    <node id="Risk Groups">
      <data key="d0">Risk Groups</data>
      <data key="d1">category</data>
      <data key="d2">A clinical classification system that categorizes prostate cancer from very low risk to very high risk to determine prognosis and treatment strategy.</data>
      <data key="d3">chunk-789ec6c06f8c999ac21c89b085b3fdb7</data>
    </node>
    <node id="Ashkenazi Jewish Ancestry">
      <data key="d0">Ashkenazi Jewish Ancestry</data>
      <data key="d1">category</data>
      <data key="d2">A hereditary demographic category that serves as a clinical indication recommending germline genetic testing in prostate cancer patients.&lt;SEP&gt;An ethnic background identified as a risk factor prompting recommendations for inherited gene testing in prostate cancer patients.</data>
      <data key="d3">chunk-965e5a6bad03f2129a98be4373f99176&lt;SEP&gt;chunk-789ec6c06f8c999ac21c89b085b3fdb7</data>
    </node>
    <node id="Intestinal Cancer">
      <data key="d0">Intestinal Cancer</data>
      <data key="d1">category</data>
      <data key="d2">Cancer of the intestines whose family history serves as a clinical indication for germline genetic testing in prostate cancer patients.</data>
      <data key="d3">chunk-789ec6c06f8c999ac21c89b085b3fdb7</data>
    </node>
    <node id="Nomograms">
      <data key="d0">Nomograms</data>
      <data key="d1">category</data>
      <data key="d2">Statistical prognostic assessment tools utilized by clinicians to calculate disease trajectory and assess risk in prostate cancer.</data>
      <data key="d3">chunk-789ec6c06f8c999ac21c89b085b3fdb7</data>
    </node>
    <node id="Life Expectancy">
      <data key="d0">Life Expectancy</data>
      <data key="d1">category</data>
      <data key="d2">A clinical prognostic parameter considered alongside risk groups to determine the necessity and timing of prostate cancer treatment.</data>
      <data key="d3">chunk-789ec6c06f8c999ac21c89b085b3fdb7</data>
    </node>
    <node id="Grade Group">
      <data key="d0">Grade Group</data>
      <data key="d1">category</data>
      <data key="d2">A five-tier classification system (ranging from 1 to 5) designed to interpret Gleason scores and indicate the aggressiveness of prostate cancer.&lt;SEP&gt;A pathological grading categorization based on biopsy findings used alongside PSA levels and stage to determine a patient's risk group.</data>
      <data key="d3">chunk-1d61a5e7031ea811cc4dcc55a0a0e8fa&lt;SEP&gt;chunk-789ec6c06f8c999ac21c89b085b3fdb7</data>
    </node>
    <node id="Tumor Stage">
      <data key="d0">Tumor Stage</data>
      <data key="d1">category</data>
      <data key="d2">A clinical classification metric reflecting tumor extent and spread, used as a key component to establish prostate cancer risk groups.&lt;SEP&gt;A clinical metric reflecting the extent and progression of a tumor, evaluated alongside PSA levels, Grade Group, and biopsy findings to determine patient risk.</data>
      <data key="d3">chunk-1d61a5e7031ea811cc4dcc55a0a0e8fa&lt;SEP&gt;chunk-789ec6c06f8c999ac21c89b085b3fdb7</data>
    </node>
    <node id="Medical Providers">
      <data key="d0">Medical Providers</data>
      <data key="d1">organization</data>
      <data key="d2">Healthcare professionals and clinical personnel who evaluate cancer risk, discuss family history, and order diagnostic tests.</data>
      <data key="d3">chunk-789ec6c06f8c999ac21c89b085b3fdb7</data>
    </node>
    <node id="Risk Group">
      <data key="d0">Risk Group</data>
      <data key="d1">category</data>
      <data key="d2">A medical classification category that serves as the basis for a patient's prostate cancer prognosis and treatment planning, determined by PSA level, Grade Group, tumor stage, and biopsy results.</data>
      <data key="d3">chunk-1d61a5e7031ea811cc4dcc55a0a0e8fa</data>
    </node>
    <node id="PSA Density">
      <data key="d0">PSA Density</data>
      <data key="d1">category</data>
      <data key="d2">A diagnostic metric calculated by dividing the PSA level by the size of the prostate to adjust for prostate volume when evaluating cancer risk.</data>
      <data key="d3">chunk-1d61a5e7031ea811cc4dcc55a0a0e8fa</data>
    </node>
    <node id="Gleason Score">
      <data key="d0">Gleason Score</data>
      <data key="d1">category</data>
      <data key="d2">A grading metric ranging from 6 to 10 that combines the two most common Gleason cell patterns to estimate the aggressiveness and spread of prostate cancer.&lt;SEP&gt;A scoring system based on microscopic biopsy patterns of cancer cells, used to assign a patient's cancer into specific Grade Groups.</data>
      <data key="d3">chunk-1d61a5e7031ea811cc4dcc55a0a0e8fa&lt;SEP&gt;chunk-1c7418fb993bb3daa95d8563909da1de</data>
    </node>
    <node id="Gleason Pattern">
      <data key="d0">Gleason Pattern</data>
      <data key="d1">category</data>
      <data key="d2">A microscopic classification scale assigned to cancer cells based on how abnormal they appear compared to healthy prostate cells.</data>
      <data key="d3">chunk-1d61a5e7031ea811cc4dcc55a0a0e8fa</data>
    </node>
    <node id="Prognosis">
      <data key="d0">Prognosis</data>
      <data key="d1">category</data>
      <data key="d2">A medical prediction describing the likely course and outcome of a disease, which directly guides therapeutic and treatment decisions.&lt;SEP&gt;The clinical medical prediction of the likely progression, outcome, and course of a diagnosed illness.</data>
      <data key="d3">chunk-67e9c4dc95841db7d0af39e1267ae71b&lt;SEP&gt;chunk-1d61a5e7031ea811cc4dcc55a0a0e8fa</data>
    </node>
    <node id="Transrectal Ultrasound">
      <data key="d0">Transrectal Ultrasound</data>
      <data key="d1">event</data>
      <data key="d2">An imaging diagnostic procedure performed to measure the size and volume of the prostate gland.&lt;SEP&gt;Transrectal ultrasound (TRUS) is an imaging procedure using high-energy sound waves via a rectal probe to visualize the prostate and guide biopsy needles.</data>
      <data key="d3">chunk-975e540ddee1810d43caf8df4adcf205&lt;SEP&gt;chunk-1d61a5e7031ea811cc4dcc55a0a0e8fa</data>
    </node>
    <node id="Vigorous Exercise">
      <data key="d0">Vigorous Exercise</data>
      <data key="d1">event</data>
      <data key="d2">Strenuous physical activity that can cause a temporary elevation of PSA levels in the bloodstream.</data>
      <data key="d3">chunk-1d61a5e7031ea811cc4dcc55a0a0e8fa</data>
    </node>
    <node id="Grade Group System">
      <data key="d0">Grade Group System</data>
      <data key="d1">category</data>
      <data key="d2">A pathological categorization system ranging from Grade Group 1 (lowest risk) to Grade Group 5 (highest risk) used to determine prostate cancer aggressiveness.</data>
      <data key="d3">chunk-1c7418fb993bb3daa95d8563909da1de</data>
    </node>
    <node id="Male Reproductive System">
      <data key="d0">Male Reproductive System</data>
      <data key="d1">category</data>
      <data key="d2">The biological organ system that includes the prostate gland, seminal vesicles, testicles, and penis.</data>
      <data key="d3">chunk-1c7418fb993bb3daa95d8563909da1de</data>
    </node>
    <node id="Ejaculation">
      <data key="d0">Ejaculation</data>
      <data key="d1">event</data>
      <data key="d2">The biological process during sexual reproduction in which semen is propelled through the urethra and released from the body.</data>
      <data key="d3">chunk-1c7418fb993bb3daa95d8563909da1de</data>
    </node>
    <node id="Age">
      <data key="d0">Age</data>
      <data key="d1">category</data>
      <data key="d2">The primary demographic risk factor for prostate cancer, with diagnoses occurring most frequently in men aged 65 and older.</data>
      <data key="d3">chunk-1c7418fb993bb3daa95d8563909da1de</data>
    </node>
    <node id="Grade Group 1">
      <data key="d0">Grade Group 1</data>
      <data key="d1">category</data>
      <data key="d2">The lowest-risk category in the Grade Group system, corresponding to a Gleason score of 6.</data>
      <data key="d3">chunk-1c7418fb993bb3daa95d8563909da1de</data>
    </node>
    <node id="Grade Group 2">
      <data key="d0">Grade Group 2</data>
      <data key="d1">category</data>
      <data key="d2">An intermediate-risk classification representing cancer with a Gleason score of 7 where the lower-grade pattern predominates.</data>
      <data key="d3">chunk-1c7418fb993bb3daa95d8563909da1de</data>
    </node>
    <node id="Grade Group 3">
      <data key="d0">Grade Group 3</data>
      <data key="d1">category</data>
      <data key="d2">An intermediate-risk classification representing a more serious Gleason score of 7 where the higher-grade pattern occupies the largest biopsy area.</data>
      <data key="d3">chunk-1c7418fb993bb3daa95d8563909da1de</data>
    </node>
    <node id="Grade Group 4">
      <data key="d0">Grade Group 4</data>
      <data key="d1">category</data>
      <data key="d2">A high-risk category within the Grade Group system indicating aggressive cancer cell patterns.</data>
      <data key="d3">chunk-1c7418fb993bb3daa95d8563909da1de</data>
    </node>
    <node id="Grade Group 5">
      <data key="d0">Grade Group 5</data>
      <data key="d1">category</data>
      <data key="d2">The highest-risk category in the Grade Group system, assigned to Gleason scores of 9 or 10 indicating very high risk and aggressive cancer.</data>
      <data key="d3">chunk-1c7418fb993bb3daa95d8563909da1de</data>
    </node>
    <node id="BRCA2 Mutation">
      <data key="d0">BRCA2 Mutation</data>
      <data key="d1">category</data>
      <data key="d2">An inherited genetic alteration identified through testing that significantly increases an individual's risk of developing prostate cancer and other cancers.</data>
      <data key="d3">chunk-aa251c48fc1fccfe45605a384f743662</data>
    </node>
    <node id="Hispanic Males">
      <data key="d0">Hispanic Males</data>
      <data key="d1">category</data>
      <data key="d2">A demographic group identified as having lower prostate cancer diagnosis rates in comparison to both white and Black males.</data>
      <data key="d3">chunk-aa251c48fc1fccfe45605a384f743662</data>
    </node>
    <node id="Asian Males">
      <data key="d0">Asian Males</data>
      <data key="d1">category</data>
      <data key="d2">A demographic group characterized by lower rates of prostate cancer diagnosis relative to white and Black males.</data>
      <data key="d3">chunk-aa251c48fc1fccfe45605a384f743662</data>
    </node>
    <node id="Researchers">
      <data key="d0">Researchers</data>
      <data key="d1">person</data>
      <data key="d2">Scientists investigating disparities, biological factors, genetic changes, and emerging treatments for prostate cancer.</data>
      <data key="d3">chunk-aa251c48fc1fccfe45605a384f743662</data>
    </node>
    <node id="Family History Of Cancer">
      <data key="d0">Family History Of Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A hereditary risk factor where having a sibling or parent with prostate cancer or other related cancers (such as breast, ovarian, colon, or pancreatic cancer) elevates personal cancer risk.</data>
      <data key="d3">chunk-aa251c48fc1fccfe45605a384f743662</data>
    </node>
    <node id="Radiopharmaceuticals">
      <data key="d0">Radiopharmaceuticals</data>
      <data key="d1">category</data>
      <data key="d2">A category of therapeutic radioactive drugs designed to treat advanced-stage prostate cancer.</data>
      <data key="d3">chunk-aa251c48fc1fccfe45605a384f743662</data>
    </node>
    <node id="Top Cancer Centers">
      <data key="d0">Top Cancer Centers</data>
      <data key="d1">organization</data>
      <data key="d2">Leading specialized medical institutions that conduct research and establish best practice protocols for advanced prostate cancer care.</data>
      <data key="d3">chunk-697db1653f51e966e79b92eefeb01ec6</data>
    </node>
    <node id="Black People">
      <data key="d0">Black People</data>
      <data key="d1">category</data>
      <data key="d2">A demographic group recognized as having an elevated risk of developing prostate cancer.</data>
      <data key="d3">chunk-697db1653f51e966e79b92eefeb01ec6</data>
    </node>
    <node id="Family Member">
      <data key="d0">Family Member</data>
      <data key="d1">person</data>
      <data key="d2">Blood relatives whose medical history is evaluated to determine inherited risks for prostate cancer and other diseases.</data>
      <data key="d3">chunk-697db1653f51e966e79b92eefeb01ec6</data>
    </node>
    <node id="Tumor Staging">
      <data key="d0">Tumor Staging</data>
      <data key="d1">event</data>
      <data key="d2">A clinical evaluation process used to determine how advanced a tumor is and how far cancer has spread.</data>
      <data key="d3">chunk-697db1653f51e966e79b92eefeb01ec6</data>
    </node>
    <node id="Health History Assessment">
      <data key="d0">Health History Assessment</data>
      <data key="d1">event</data>
      <data key="d2">A clinical inquiry by a care team into past illnesses, injuries, medications, and treatments.</data>
      <data key="d3">chunk-697db1653f51e966e79b92eefeb01ec6</data>
    </node>
    <node id="PSMA-PET Scan">
      <data key="d0">PSMA-PET Scan</data>
      <data key="d1">category</data>
      <data key="d2">A PSMA-PET scan is an advanced imaging procedure that uses tracers targeting prostate-specific membrane antigen to monitor recurrence and detect metastases.&lt;SEP&gt;A specialized PET imaging scan targeting prostate-specific membrane antigen to detect prostate cancer recurrence and guide targeted therapies.</data>
      <data key="d3">chunk-975e540ddee1810d43caf8df4adcf205&lt;SEP&gt;chunk-67e9c4dc95841db7d0af39e1267ae71b</data>
    </node>
    <node id="Diagnosis">
      <data key="d0">Diagnosis</data>
      <data key="d1">category</data>
      <data key="d2">The formal clinical identification and naming of an illness or condition based on clinical assessments and diagnostic tests.</data>
      <data key="d3">chunk-67e9c4dc95841db7d0af39e1267ae71b</data>
    </node>
    <node id="Quality Of Life">
      <data key="d0">Quality Of Life</data>
      <data key="d1">category</data>
      <data key="d2">A medical evaluation measure assessing a patient's overall satisfaction with their well-being and ability to participate in daily activities.&lt;SEP&gt;An individual's overall enjoyment of life, personal well-being, and ability to engage in everyday activities during and after medical treatment.</data>
      <data key="d3">chunk-bb68daec67dd8f436d82814b0e61ff21&lt;SEP&gt;chunk-67e9c4dc95841db7d0af39e1267ae71b</data>
    </node>
    <node id="University of Chicago Medicine">
      <data key="d0">University of Chicago Medicine</data>
      <data key="d1">organization</data>
      <data key="d2">University of Chicago Medicine is an academic medical institution that provided clinical diagnostic images of prostate cancer.</data>
      <data key="d3">chunk-975e540ddee1810d43caf8df4adcf205</data>
    </node>
    <node id="Biopsy of the Metastasis">
      <data key="d0">Biopsy of the Metastasis</data>
      <data key="d1">event</data>
      <data key="d2">A biopsy procedure performed on lymph nodes, internal organs, bone, or blood (liquid biopsy) to test for the spread of cancer cells.</data>
      <data key="d3">chunk-975e540ddee1810d43caf8df4adcf205</data>
    </node>
    <node id="MRI-TRUS Fusion">
      <data key="d0">MRI-TRUS Fusion</data>
      <data key="d1">category</data>
      <data key="d2">MRI-TRUS fusion is a targeted diagnostic technique that combines saved MRI images with real-time ultrasound to enhance the precision of prostate biopsies.</data>
      <data key="d3">chunk-975e540ddee1810d43caf8df4adcf205</data>
    </node>
    <node id="Bone Metastasis">
      <data key="d0">Bone Metastasis</data>
      <data key="d1">category</data>
      <data key="d2">The spread of prostate cancer cells into the skeletal system, causing bone damage and pain.</data>
      <data key="d3">chunk-975e540ddee1810d43caf8df4adcf205</data>
    </node>
    <node id="Hereditary Gene Testing">
      <data key="d0">Hereditary Gene Testing</data>
      <data key="d1">event</data>
      <data key="d2">A form of genetic test performed using blood, urine, or saliva to identify inherited germline mutations present in every cell.</data>
      <data key="d3">chunk-965e5a6bad03f2129a98be4373f99176</data>
    </node>
    <node id="Tumor Testing">
      <data key="d0">Tumor Testing</data>
      <data key="d1">event</data>
      <data key="d2">A molecular diagnostic procedure that examines tumor tissue or blood for somatic mutations and DNA repair abnormalities.</data>
      <data key="d3">chunk-965e5a6bad03f2129a98be4373f99176</data>
    </node>
    <node id="Hereditary Mutation">
      <data key="d0">Hereditary Mutation</data>
      <data key="d1">category</data>
      <data key="d2">A genetic change, also called a germline mutation, that is inherited from parents and present in every cell of the body from birth.</data>
      <data key="d3">chunk-965e5a6bad03f2129a98be4373f99176</data>
    </node>
    <node id="FANCA">
      <data key="d0">FANCA</data>
      <data key="d1">category</data>
      <data key="d2">A DNA repair pathway gene examined during molecular tumor profiling for prostate cancer.</data>
      <data key="d3">chunk-965e5a6bad03f2129a98be4373f99176</data>
    </node>
    <node id="TNM System">
      <data key="d0">TNM System</data>
      <data key="d1">category</data>
      <data key="d2">The tumor, node, metastasis system is a standardized cancer staging framework created by cancer experts to describe the size, lymph node involvement, and distant spread of tumors.</data>
      <data key="d3">chunk-b3958b5f7df8a8fc2661705e37dc1e06</data>
    </node>
    <node id="Androgen Deprivation Therapy">
      <data key="d0">Androgen Deprivation Therapy</data>
      <data key="d1">category</data>
      <data key="d2">A medical treatment category that lowers testosterone levels, used as a primary therapy for advanced prostate cancer.&lt;SEP&gt;A specific form of hormone therapy designed to drastically lower testosterone levels or prevent cancer cells from using testosterone, thereby starving the tumor.</data>
      <data key="d3">chunk-b3958b5f7df8a8fc2661705e37dc1e06&lt;SEP&gt;chunk-53c0ac935ec10ce8a0839db4ad053ad1</data>
    </node>
    <node id="Non-Hormone Therapy">
      <data key="d0">Non-Hormone Therapy</data>
      <data key="d1">category</data>
      <data key="d2">A group of treatments for advanced prostate cancer that includes chemotherapy, immunotherapy, targeted therapy, and radiation therapy.</data>
      <data key="d3">chunk-b3958b5f7df8a8fc2661705e37dc1e06</data>
    </node>
    <node id="Orchiectomy">
      <data key="d0">Orchiectomy</data>
      <data key="d1">category</data>
      <data key="d2">A permanent surgical procedure involving the removal of one or both testicles to achieve surgical castration and eliminate the primary source of testosterone.</data>
      <data key="d3">chunk-b3958b5f7df8a8fc2661705e37dc1e06</data>
    </node>
    <node id="Cancer Staging">
      <data key="d0">Cancer Staging</data>
      <data key="d1">category</data>
      <data key="d2">A clinical classification measuring how far cancer has grown and spread to determine prognosis and treatment strategy.&lt;SEP&gt;A clinical classification method combining T, N, M, and G scores to assess cancer extent and severity, ranging from Stage I to Stage IV.&lt;SEP&gt;A clinical classification process used to describe the extent, size, and spread of a tumor to establish prognosis and direct treatment options.&lt;SEP&gt;A clinical evaluation process that integrates results from imaging scans and examinations to assess the extent and spread of cancer.&lt;SEP&gt;A diagnostic evaluation process conducted at diagnosis and after treatment to determine how much cancer is present and how far it has spread in the body.&lt;SEP&gt;Cancer staging is a numerical classification system (ranging from stage 0 to stage 4) indicating how far cancer has physically grown into the bladder wall and whether it has spread.</data>
      <data key="d3">chunk-84367cc8f7a94b97b4b66a1ca127c15f&lt;SEP&gt;chunk-b3958b5f7df8a8fc2661705e37dc1e06&lt;SEP&gt;chunk-29d1ec9b874dd38ef0f3a4a2081f548e&lt;SEP&gt;chunk-7a890e27eba8c63d10f19b85a72fc14a&lt;SEP&gt;chunk-ea7b3f83164304ee4a562046eb0f5033&lt;SEP&gt;chunk-be6e1cb2fe11f4d9962741c30d446a69</data>
    </node>
    <node id="PSA">
      <data key="d0">PSA</data>
      <data key="d1">category</data>
      <data key="d2">Prostate-specific antigen, a biomarker found in the bloodstream whose elevated levels can indicate prostate cancer.</data>
      <data key="d3">chunk-b3958b5f7df8a8fc2661705e37dc1e06</data>
    </node>
    <node id="LHRH Agonist">
      <data key="d0">LHRH Agonist</data>
      <data key="d1">category</data>
      <data key="d2">A class of androgen deprivation therapy drugs that lower testosterone levels, including medications like goserelin, leuprolide, or triptorelin.</data>
      <data key="d3">chunk-b3958b5f7df8a8fc2661705e37dc1e06</data>
    </node>
    <node id="LHRH Antagonist">
      <data key="d0">LHRH Antagonist</data>
      <data key="d1">category</data>
      <data key="d2">A drug class used in androgen deprivation therapy to suppress testosterone production, including degarelix or relugolix.</data>
      <data key="d3">chunk-b3958b5f7df8a8fc2661705e37dc1e06</data>
    </node>
    <node id="Anti-Androgen">
      <data key="d0">Anti-Androgen</data>
      <data key="d1">category</data>
      <data key="d2">A category of medications, including nilutamide, flutamide, and bicalutamide, used alongside LHRH agonists to block androgen activity.</data>
      <data key="d3">chunk-b3958b5f7df8a8fc2661705e37dc1e06</data>
    </node>
    <node id="Testicles">
      <data key="d0">Testicles</data>
      <data key="d1">category</data>
      <data key="d2">The male reproductive organs that produce sperm and serve as the body's primary manufacturer of testosterone.</data>
      <data key="d3">chunk-b3958b5f7df8a8fc2661705e37dc1e06</data>
    </node>
    <node id="LHRH Agonists">
      <data key="d0">LHRH Agonists</data>
      <data key="d1">category</data>
      <data key="d2">A class of hormone therapy drugs that cause the testicles to stop making testosterone, including medications like leuprolide, goserelin, and triptorelin.&lt;SEP&gt;A drug class that halts luteinizing hormone-releasing hormone production to suppress ovarian hormone and testosterone secretion.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408&lt;SEP&gt;chunk-53c0ac935ec10ce8a0839db4ad053ad1</data>
    </node>
    <node id="LHRH Antagonists">
      <data key="d0">LHRH Antagonists</data>
      <data key="d1">category</data>
      <data key="d2">A class of hormone therapy medications that block testosterone production, including degarelix and relugolix.</data>
      <data key="d3">chunk-53c0ac935ec10ce8a0839db4ad053ad1</data>
    </node>
    <node id="Carcinomas">
      <data key="d0">Carcinomas</data>
      <data key="d1">category</data>
      <data key="d2">A classification of cancer that begins in epithelial cells lining the inner or outer surfaces of the body, encompassing almost all breast cancers.&lt;SEP&gt;A general category of cancers that originate in cells lining the inner or outer surfaces of the body, encompassing almost all breast cancer subtypes.</data>
      <data key="d3">chunk-6a93aa507dd7d98a02e8ba92d39e3649&lt;SEP&gt;chunk-53c0ac935ec10ce8a0839db4ad053ad1</data>
    </node>
    <node id="Invasive Breast Cancer">
      <data key="d0">Invasive Breast Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A diagnostic category of breast cancer that has spread from the milk ducts or lobules into surrounding breast tissue or lymph nodes.&lt;SEP&gt;A form of cancer that has broken through the ducts or lobules into surrounding breast tissue, with the capacity to spread through lymph or blood vessels.&lt;SEP&gt;A stage or classification of breast cancer where cancer cells have grown beyond the milk ducts or lobules into surrounding breast tissue or lymph nodes.&lt;SEP&gt;A stage or form of breast cancer where cancer cells have spread beyond their original location in breast tissue into surrounding tissue.&lt;SEP&gt;Breast cancer classified under stages 1, 2, or 3 that has grown outside the ducts, lobules, or breast skin, potentially involving axillary lymph nodes.&lt;SEP&gt;Invasive breast cancer is an advanced form of breast cancer that has spread from the ducts or lobules into the surrounding breast tissue or lymph nodes.</data>
      <data key="d3">chunk-a06038ec84f20e873b9e275a23aea8d9&lt;SEP&gt;chunk-c37f547042fc10baabdbfaadf010bce5&lt;SEP&gt;chunk-cb41559e96b71d2bb4ea207c806e8d5f&lt;SEP&gt;chunk-7390896141393e0b4d1c15df77b5c0a7&lt;SEP&gt;chunk-1dc8d8e5ed4f165f3e56305a7644ba05&lt;SEP&gt;chunk-53c0ac935ec10ce8a0839db4ad053ad1</data>
    </node>
    <node id="Metastatic Breast Cancer">
      <data key="d0">Metastatic Breast Cancer</data>
      <data key="d1">category</data>
      <data key="d2">Also known as advanced breast cancer, it is a stage of breast cancer that has spread beyond the breast and axillary lymph nodes to other parts of the body.&lt;SEP&gt;An advanced classification of breast cancer in which cancer cells have spread to distant body sites such as the bones, lungs, liver, or brain.&lt;SEP&gt;An advanced classification of breast cancer where malignant cells have spread via the bloodstream or lymphatic system from the primary tumor to distant sites such as bones, lungs, liver, or brain.&lt;SEP&gt;An advanced classification of breast cancer, designated as M1, indicating that cancer has migrated to distant parts of the body.&lt;SEP&gt;An advanced stage of breast cancer that has spread from the breast to other parts of the body.&lt;SEP&gt;Stage 4 breast cancer characterized by the spread of cancer cells to distant sites in the body, presenting de novo or from earlier stages.</data>
      <data key="d3">chunk-a06038ec84f20e873b9e275a23aea8d9&lt;SEP&gt;chunk-0d388da75afb5ea2d01c97e55cb2b872&lt;SEP&gt;chunk-c37f547042fc10baabdbfaadf010bce5&lt;SEP&gt;chunk-cb41559e96b71d2bb4ea207c806e8d5f&lt;SEP&gt;chunk-1dc8d8e5ed4f165f3e56305a7644ba05&lt;SEP&gt;chunk-53c0ac935ec10ce8a0839db4ad053ad1</data>
    </node>
    <node id="Anti-Androgens">
      <data key="d0">Anti-Androgens</data>
      <data key="d1">category</data>
      <data key="d2">A class of oral medications, including bicalutamide, flutamide, and nilutamide, used in prostate cancer treatment to block the action of androgens.</data>
      <data key="d3">chunk-53c0ac935ec10ce8a0839db4ad053ad1</data>
    </node>
    <node id="Corticosteroids">
      <data key="d0">Corticosteroids</data>
      <data key="d1">category</data>
      <data key="d2">A category of oral hormonal medications taken in pill form used in prostate cancer management.&lt;SEP&gt;A class of medications utilized as one of the medical treatment options for patients diagnosed with primary CNS lymphoma.&lt;SEP&gt;A class of medications, commonly called steroids, used short-term to shrink lymphomas and decrease swelling in the brain.&lt;SEP&gt;A steroid medication class used as a therapeutic option in the management and treatment of primary CNS lymphoma.</data>
      <data key="d3">chunk-53c0ac935ec10ce8a0839db4ad053ad1&lt;SEP&gt;chunk-725b48dc82aad42ba3dc14f4b5207551&lt;SEP&gt;chunk-9e8b25c2957355218780bdfd8b72df45&lt;SEP&gt;chunk-d0f15711706bc171fed17a7fab91b4b6</data>
    </node>
    <node id="Androgen Synthesis Inhibitors">
      <data key="d0">Androgen Synthesis Inhibitors</data>
      <data key="d1">category</data>
      <data key="d2">A class of pharmaceutical therapies taken as pills that suppress the body's synthesis of androgens in the treatment of prostate cancer.</data>
      <data key="d3">chunk-53c0ac935ec10ce8a0839db4ad053ad1</data>
    </node>
    <node id="Surgical Castration">
      <data key="d0">Surgical Castration</data>
      <data key="d1">category</data>
      <data key="d2">A surgical hormone therapy procedure that permanently removes or blocks testicle function to eliminate testosterone production.</data>
      <data key="d3">chunk-53c0ac935ec10ce8a0839db4ad053ad1</data>
    </node>
    <node id="Ductal Breast Cancer">
      <data key="d0">Ductal Breast Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A common subtype of breast cancer that originates within the milk ducts of the breast.&lt;SEP&gt;A common subtype of breast carcinoma originating from the epithelial cells lining the milk ducts.</data>
      <data key="d3">chunk-53c0ac935ec10ce8a0839db4ad053ad1&lt;SEP&gt;chunk-c37f547042fc10baabdbfaadf010bce5</data>
    </node>
    <node id="Lobular Breast Cancer">
      <data key="d0">Lobular Breast Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A common subtype of breast cancer that originates within the lobules, or milk-producing glands, of the breast.&lt;SEP&gt;A primary subtype of breast carcinoma that develops from epithelial cells in the milk glands or lobules.</data>
      <data key="d3">chunk-53c0ac935ec10ce8a0839db4ad053ad1&lt;SEP&gt;chunk-c37f547042fc10baabdbfaadf010bce5</data>
    </node>
    <node id="Local Metastasis">
      <data key="d0">Local Metastasis</data>
      <data key="d1">category</data>
      <data key="d2">A classification of cancer spread where tumor cells extend to adjacent tissues or regional lymph nodes, such as axillary lymph nodes.</data>
      <data key="d3">chunk-53c0ac935ec10ce8a0839db4ad053ad1</data>
    </node>
    <node id="Distant Metastasis">
      <data key="d0">Distant Metastasis</data>
      <data key="d1">category</data>
      <data key="d2">A classification of advanced cancer progression where tumor cells travel to distant sites including the bones, lungs, liver, and brain.</data>
      <data key="d3">chunk-53c0ac935ec10ce8a0839db4ad053ad1</data>
    </node>
    <node id="Ductal Carcinoma">
      <data key="d0">Ductal Carcinoma</data>
      <data key="d1">category</data>
      <data key="d2">A subtype and the most common form of breast cancer, beginning in the cells lining the milk ducts.&lt;SEP&gt;One of the most common types of breast carcinoma, developing within the cells of the milk ducts.</data>
      <data key="d3">chunk-a06038ec84f20e873b9e275a23aea8d9&lt;SEP&gt;chunk-1dc8d8e5ed4f165f3e56305a7644ba05</data>
    </node>
    <node id="Lobular Carcinoma">
      <data key="d0">Lobular Carcinoma</data>
      <data key="d1">category</data>
      <data key="d2">A prevalent subtype of breast carcinoma originating in the milk-producing lobules of the breast.&lt;SEP&gt;A subtype of breast cancer that originates in the milk-producing lobules of the breast.&lt;SEP&gt;The second most common category of breast cancer, originating in the milk-producing lobules of the breast.</data>
      <data key="d3">chunk-6a93aa507dd7d98a02e8ba92d39e3649&lt;SEP&gt;chunk-a06038ec84f20e873b9e275a23aea8d9&lt;SEP&gt;chunk-1dc8d8e5ed4f165f3e56305a7644ba05</data>
    </node>
    <node id="Genetic Cancer Risk Testing">
      <data key="d0">Genetic Cancer Risk Testing</data>
      <data key="d1">category</data>
      <data key="d2">A diagnostic evaluation category used to assess hereditary risk factors and genetic predisposition to cancer.&lt;SEP&gt;A genetic screening category assessing hereditary gene mutations associated with an increased susceptibility to cancer.&lt;SEP&gt;Diagnostic testing aimed at identifying inherited genetic mutations that elevate the risk of developing breast cancer.&lt;SEP&gt;Diagnostic tests assessing inherited genetic susceptibility and mutations related to cancer.&lt;SEP&gt;Genetic cancer risk testing is a diagnostic evaluation performed to detect inherited genetic factors linked to breast cancer.&lt;SEP&gt;Laboratory testing of blood or saliva to detect inherited germline gene mutations associated with cancer risk.</data>
      <data key="d3">chunk-a06038ec84f20e873b9e275a23aea8d9&lt;SEP&gt;chunk-c37f547042fc10baabdbfaadf010bce5&lt;SEP&gt;chunk-ba28a3ce3534c0655a0d08a953d7f038&lt;SEP&gt;chunk-30c0bb66b1a2f93e89f5342ab1077451&lt;SEP&gt;chunk-7390896141393e0b4d1c15df77b5c0a7&lt;SEP&gt;chunk-1dc8d8e5ed4f165f3e56305a7644ba05</data>
    </node>
    <node id="Hormone Receptor Status Testing">
      <data key="d0">Hormone Receptor Status Testing</data>
      <data key="d1">category</data>
      <data key="d2">A biomarker testing category used to measure estrogen and progesterone receptor expression in breast cancer cells to guide treatment plans.&lt;SEP&gt;A laboratory pathology assessment analyzing tissue samples for estrogen and progesterone receptors to inform targeted therapies.</data>
      <data key="d3">chunk-a06038ec84f20e873b9e275a23aea8d9&lt;SEP&gt;chunk-c37f547042fc10baabdbfaadf010bce5</data>
    </node>
    <node id="HER2 Status Testing">
      <data key="d0">HER2 Status Testing</data>
      <data key="d1">category</data>
      <data key="d2">A specific biomarker assessment category that evaluates the presence or overexpression of the HER2 protein or gene in breast cancer tissue.</data>
      <data key="d3">chunk-a06038ec84f20e873b9e275a23aea8d9</data>
    </node>
    <node id="Fertility Testing">
      <data key="d0">Fertility Testing</data>
      <data key="d1">category</data>
      <data key="d2">A category of medical tests and evaluations that assess reproductive potential and options across genders prior to cancer interventions.</data>
      <data key="d3">chunk-a06038ec84f20e873b9e275a23aea8d9</data>
    </node>
    <node id="Diagnostic Testing for MBC">
      <data key="d0">Diagnostic Testing for MBC</data>
      <data key="d1">category</data>
      <data key="d2">A group of clinical procedures and evaluations—including biopsies, imaging, biomarker testing, hormone receptor status, and genetic screening—used to assess cancer characteristics and guide treatment plans.</data>
      <data key="d3">chunk-c37f547042fc10baabdbfaadf010bce5</data>
    </node>
    <node id="HER2 Testing">
      <data key="d0">HER2 Testing</data>
      <data key="d1">category</data>
      <data key="d2">A diagnostic procedure performed on newly discovered tumor biopsy samples via immunohistochemistry and in situ hybridization to measure HER2 gene amplification and receptor levels.&lt;SEP&gt;A specialized molecular diagnostic test evaluating cancer cells for overexpression of human epidermal growth factor receptor 2 protein.</data>
      <data key="d3">chunk-562e1870b5e20f8648a2e56d960a1148&lt;SEP&gt;chunk-c37f547042fc10baabdbfaadf010bce5</data>
    </node>
    <node id="Performance Status Assessment">
      <data key="d0">Performance Status Assessment</data>
      <data key="d1">category</data>
      <data key="d2">A standard clinical evaluation measuring a patient's functional capacity, daily living activities, and ability to undergo cancer therapies.</data>
      <data key="d3">chunk-c37f547042fc10baabdbfaadf010bce5</data>
    </node>
    <node id="Fertility Preservation Testing">
      <data key="d0">Fertility Preservation Testing</data>
      <data key="d1">category</data>
      <data key="d2">A clinical category of reproductive assessments conducted across genders prior to cancer treatment to evaluate and manage reproductive impacts.</data>
      <data key="d3">chunk-c37f547042fc10baabdbfaadf010bce5</data>
    </node>
    <node id="NCCN Patient Survey">
      <data key="d0">NCCN Patient Survey</data>
      <data key="d1">event</data>
      <data key="d2">An online feedback initiative conducted by NCCN to collect patient insights regarding NCCN Guidelines for Patients.</data>
      <data key="d3">chunk-c37f547042fc10baabdbfaadf010bce5</data>
    </node>
    <node id="Ductal Carcinoma In Situ">
      <data key="d0">Ductal Carcinoma In Situ</data>
      <data key="d1">category</data>
      <data key="d2">A non-invasive or pre-invasive stage of breast cancer where abnormal cells are found in the lining of a breast duct, addressed in patient guidelines.&lt;SEP&gt;A noninvasive stage 0 breast cancer confined solely to the breast ducts that has not spread to surrounding tissue, lymph nodes, or distant sites.&lt;SEP&gt;Ductal carcinoma in situ (DCIS), also called intraductal carcinoma, is a noninvasive, stage 0 breast cancer located in the cells that line the milk ducts.</data>
      <data key="d3">chunk-cb41559e96b71d2bb4ea207c806e8d5f&lt;SEP&gt;chunk-7390896141393e0b4d1c15df77b5c0a7&lt;SEP&gt;chunk-1dc8d8e5ed4f165f3e56305a7644ba05</data>
    </node>
    <node id="Screening Mammogram">
      <data key="d0">Screening Mammogram</data>
      <data key="d1">event</data>
      <data key="d2">A routine breast imaging examination used for early detection before cancer symptoms appear, distinguished from diagnostic mammography.&lt;SEP&gt;A routine low-dose x-ray exam of the breasts performed on asymptomatic individuals to check for early signs of breast cancer.&lt;SEP&gt;A screening mammogram is a routine breast x-ray examination performed when there are no signs or symptoms of breast cancer.</data>
      <data key="d3">chunk-a2778e34af702d49d5e70867726e14b2&lt;SEP&gt;chunk-fc469adbdd7a41816d59f249439bc726&lt;SEP&gt;chunk-7390896141393e0b4d1c15df77b5c0a7</data>
    </node>
    <node id="Diagnostic Mammogram">
      <data key="d0">Diagnostic Mammogram</data>
      <data key="d1">event</data>
      <data key="d2">A diagnostic mammogram is an x-ray examination performed for individuals experiencing breast symptoms or to investigate abnormal findings from a screening mammogram.&lt;SEP&gt;A specialized x-ray examination of the breast used to evaluate symptoms, measure tumors, and investigate abnormalities found during screening.&lt;SEP&gt;An X-ray imaging evaluation of breast tissue used to detect abnormalities, although it often does not reveal distinct lumps in IBC.&lt;SEP&gt;An imaging test that captures detailed images of both breasts to evaluate abnormal findings or symptoms, distinct from a routine screening mammogram.</data>
      <data key="d3">chunk-a2778e34af702d49d5e70867726e14b2&lt;SEP&gt;chunk-fc469adbdd7a41816d59f249439bc726&lt;SEP&gt;chunk-7390896141393e0b4d1c15df77b5c0a7&lt;SEP&gt;chunk-5846f51c2ca4fae54459ce9c50e3e820</data>
    </node>
    <node id="Stage 0 Cancer">
      <data key="d0">Stage 0 Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A clinical stage designation referring to noninvasive cancerous cells that remain confined to their original site without spreading.</data>
      <data key="d3">chunk-7390896141393e0b4d1c15df77b5c0a7</data>
    </node>
    <node id="Cancer Stages">
      <data key="d0">Cancer Stages</data>
      <data key="d1">category</data>
      <data key="d2">A clinical classification system used to evaluate the extent, progression, and spread of cancer to guide treatment planning.</data>
      <data key="d3">chunk-7390896141393e0b4d1c15df77b5c0a7</data>
    </node>
    <node id="Tomosynthesis">
      <data key="d0">Tomosynthesis</data>
      <data key="d1">category</data>
      <data key="d2">A three-dimensional (3D) digital mammogram technique that uses low-dose x-rays to create detailed breast images.&lt;SEP&gt;A three-dimensional (3D) mammography imaging technique used to examine breast tissue in detail.&lt;SEP&gt;Also known as a 3D mammogram, an advanced breast imaging technology using multiple low-dose x-rays combined by computer into detailed images.</data>
      <data key="d3">chunk-a2778e34af702d49d5e70867726e14b2&lt;SEP&gt;chunk-7390896141393e0b4d1c15df77b5c0a7&lt;SEP&gt;chunk-1dc8d8e5ed4f165f3e56305a7644ba05</data>
    </node>
    <node id="2D Digital Mammogram">
      <data key="d0">2D Digital Mammogram</data>
      <data key="d1">category</data>
      <data key="d2">A standard two-dimensional breast imaging modality utilizing low-dose x-rays to examine the breast.&lt;SEP&gt;A standard two-dimensional imaging test that uses low-dose x-rays to examine the breast for abnormalities.</data>
      <data key="d3">chunk-7390896141393e0b4d1c15df77b5c0a7&lt;SEP&gt;chunk-1dc8d8e5ed4f165f3e56305a7644ba05</data>
    </node>
    <node id="Estrogen Receptor Status">
      <data key="d0">Estrogen Receptor Status</data>
      <data key="d1">category</data>
      <data key="d2">A biomarker category assessing whether breast cancer cells express estrogen receptors (ER), guiding prognostic staging and treatment selection.&lt;SEP&gt;A diagnostic biological marker and testing category assessed to characterize breast cancer cells and guide therapeutic decisions.&lt;SEP&gt;A pathological categorization that measures whether breast cancer cells possess receptors for estrogen, influencing treatment decisions.</data>
      <data key="d3">chunk-0d388da75afb5ea2d01c97e55cb2b872&lt;SEP&gt;chunk-7390896141393e0b4d1c15df77b5c0a7&lt;SEP&gt;chunk-1dc8d8e5ed4f165f3e56305a7644ba05</data>
    </node>
    <node id="Breast Specialist">
      <data key="d0">Breast Specialist</data>
      <data key="d1">person</data>
      <data key="d2">A healthcare provider who specializes in breast health and diseases.&lt;SEP&gt;A medical doctor specialized in evaluating, diagnosing, and treating conditions and cancers of the breast.&lt;SEP&gt;A medical healthcare provider specializing in the comprehensive evaluation, health, and diseases of the breast.</data>
      <data key="d3">chunk-6a93aa507dd7d98a02e8ba92d39e3649&lt;SEP&gt;chunk-7f9fe20fe42489996573eb1b436128b6&lt;SEP&gt;chunk-1dc8d8e5ed4f165f3e56305a7644ba05</data>
    </node>
    <node id="Breast Diagnostic Radiologist">
      <data key="d0">Breast Diagnostic Radiologist</data>
      <data key="d1">person</data>
      <data key="d2">A medical specialist who interprets imaging studies such as mammograms and MRIs, and performs needle biopsies.&lt;SEP&gt;A medical specialist who interprets imaging tests such as mammograms and MRIs and performs needle biopsies.</data>
      <data key="d3">chunk-6a93aa507dd7d98a02e8ba92d39e3649&lt;SEP&gt;chunk-1dc8d8e5ed4f165f3e56305a7644ba05</data>
    </node>
    <node id="Gynecologist">
      <data key="d0">Gynecologist</data>
      <data key="d1">category</data>
      <data key="d2">A medical healthcare provider specializing in diagnosing and treating diseases of the female reproductive system.&lt;SEP&gt;A physician focused on women's reproductive health who participates in the patient care team during cancer management.&lt;SEP&gt;A physician specializing in diagnosing and treating conditions of female reproductive organs.</data>
      <data key="d3">chunk-db3a86fc5d439d9bfb3845e468a2a551&lt;SEP&gt;chunk-6a93aa507dd7d98a02e8ba92d39e3649&lt;SEP&gt;chunk-1dc8d8e5ed4f165f3e56305a7644ba05</data>
    </node>
    <node id="Lactation Consultant">
      <data key="d0">Lactation Consultant</data>
      <data key="d1">person</data>
      <data key="d2">A healthcare provider specializing in clinical management of breastfeeding.&lt;SEP&gt;A specialized healthcare provider focusing on breastfeeding education and support.</data>
      <data key="d3">chunk-6a93aa507dd7d98a02e8ba92d39e3649&lt;SEP&gt;chunk-1dc8d8e5ed4f165f3e56305a7644ba05</data>
    </node>
    <node id="Mammogram">
      <data key="d0">Mammogram</data>
      <data key="d1">category</data>
      <data key="d2">A diagnostic and screening imaging technique using low-dose x-rays, conducted in 2D digital form or 3D tomosynthesis, to examine breast tissue.&lt;SEP&gt;A specialized radiographic imaging examination of the breast used for cancer screening and diagnostic assessment.&lt;SEP&gt;An X-ray imaging method of the breast used for screening, diagnosis, and guiding biopsy procedures.</data>
      <data key="d3">chunk-6a93aa507dd7d98a02e8ba92d39e3649&lt;SEP&gt;chunk-7f9fe20fe42489996573eb1b436128b6&lt;SEP&gt;chunk-1dc8d8e5ed4f165f3e56305a7644ba05</data>
    </node>
    <node id="Breast Cancer Screening">
      <data key="d0">Breast Cancer Screening</data>
      <data key="d1">event</data>
      <data key="d2">A preventive medical evaluation process aimed at finding breast cancer at its earliest and most treatable stages.&lt;SEP&gt;A routine medical preventative evaluation and imaging process designed to identify breast cancer early before physical symptoms appear.</data>
      <data key="d3">chunk-6a93aa507dd7d98a02e8ba92d39e3649&lt;SEP&gt;chunk-1dc8d8e5ed4f165f3e56305a7644ba05</data>
    </node>
    <node id="Invasive Ductal Carcinoma">
      <data key="d0">Invasive Ductal Carcinoma</data>
      <data key="d1">category</data>
      <data key="d2">A common type of breast cancer that begins in the cells lining the milk ducts and invades surrounding breast tissue.&lt;SEP&gt;The most common form of breast cancer, beginning in the cells lining the milk ducts and invading surrounding breast tissue.</data>
      <data key="d3">chunk-6a93aa507dd7d98a02e8ba92d39e3649&lt;SEP&gt;chunk-fc469adbdd7a41816d59f249439bc726</data>
    </node>
    <node id="Inflammatory Breast Cancer">
      <data key="d0">Inflammatory Breast Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A rare, aggressive subtype of breast cancer characterized by cancer cells blocking lymph vessels in the skin, causing swelling, redness, and warmth.&lt;SEP&gt;A specific aggressive subtype of breast cancer classified as T4d, characterized by invasion of the skin and chest wall.&lt;SEP&gt;A specific and treatable form of breast cancer typically managed through a multimodal approach including systemic therapy, surgery, and radiation therapy.&lt;SEP&gt;A specific, aggressive type of breast cancer denoted as IBC whose management and treatment options are addressed in dedicated care guidelines.&lt;SEP&gt;A subtype of breast cancer that may be treated using single-agent or multi-agent chemotherapy regimens.&lt;SEP&gt;An aggressive and difficult-to-diagnose type of breast cancer characterized by inflammation and skin changes.&lt;SEP&gt;An aggressive form of breast cancer diagnosed often through skin biopsy and known to frequently overexpress HER2.&lt;SEP&gt;An aggressive form of breast cancer, predominantly categorized as invasive ductal carcinoma, typically diagnosed at stage 3 or stage 4.</data>
      <data key="d3">chunk-0d388da75afb5ea2d01c97e55cb2b872&lt;SEP&gt;chunk-cb41559e96b71d2bb4ea207c806e8d5f&lt;SEP&gt;chunk-6a93aa507dd7d98a02e8ba92d39e3649&lt;SEP&gt;chunk-7f9fe20fe42489996573eb1b436128b6&lt;SEP&gt;chunk-9040f5949ae0ff36ce88faa1f4b67ead&lt;SEP&gt;chunk-fc469adbdd7a41816d59f249439bc726&lt;SEP&gt;chunk-e90bcd28496f1f39a21973656e3e496f&lt;SEP&gt;chunk-562e1870b5e20f8648a2e56d960a1148</data>
    </node>
    <node id="Advanced Practice Providers">
      <data key="d0">Advanced Practice Providers</data>
      <data key="d1">category</data>
      <data key="d2">A clinical group including nurse practitioners, physician assistants, and certified nurse midwives who prevent, examine, and diagnose diseases including breast cancer.</data>
      <data key="d3">chunk-6a93aa507dd7d98a02e8ba92d39e3649</data>
    </node>
    <node id="Obstetrician">
      <data key="d0">Obstetrician</data>
      <data key="d1">category</data>
      <data key="d2">A physician specializing in pregnancy, prenatal care, and childbirth.</data>
      <data key="d3">chunk-6a93aa507dd7d98a02e8ba92d39e3649</data>
    </node>
    <node id="Imaging Technologists">
      <data key="d0">Imaging Technologists</data>
      <data key="d1">category</data>
      <data key="d2">Specialized medical technicians who operate diagnostic equipment including mammography units, MRI machines, and ultrasound systems.</data>
      <data key="d3">chunk-6a93aa507dd7d98a02e8ba92d39e3649</data>
    </node>
    <node id="Health Checkup">
      <data key="d0">Health Checkup</data>
      <data key="d1">event</data>
      <data key="d2">A routine clinical medical examination during which preventative screenings and physical health evaluations are conducted.</data>
      <data key="d3">chunk-6a93aa507dd7d98a02e8ba92d39e3649</data>
    </node>
    <node id="Magnetic Resonance Imaging (MRI)">
      <data key="d0">Magnetic Resonance Imaging (MRI)</data>
      <data key="d1">event</data>
      <data key="d2">An advanced diagnostic imaging procedure used to evaluate soft breast tissues and detect abnormalities.</data>
      <data key="d3">chunk-6a93aa507dd7d98a02e8ba92d39e3649</data>
    </node>
    <node id="Peau d'Orange">
      <data key="d0">Peau d'Orange</data>
      <data key="d1">category</data>
      <data key="d2">A dimpled, pitted skin condition resembling an orange peel, recognized as a clinical sign of inflammatory breast cancer.</data>
      <data key="d3">chunk-6a93aa507dd7d98a02e8ba92d39e3649</data>
    </node>
    <node id="Edema">
      <data key="d0">Edema</data>
      <data key="d1">category</data>
      <data key="d2">Swelling caused by excess fluid accumulation in body tissues, presenting as a symptom of inflammatory breast cancer.&lt;SEP&gt;Swelling in the brain tissue caused by a growing glioma pressing against or infiltrating surrounding brain structures.</data>
      <data key="d3">chunk-6a93aa507dd7d98a02e8ba92d39e3649&lt;SEP&gt;chunk-fa5247d6b8c17e58ab315a0d641c7ad3</data>
    </node>
    <node id="Erythema">
      <data key="d0">Erythema</data>
      <data key="d1">category</data>
      <data key="d2">Reddening of the skin appearing in patches, characteristic of inflammatory breast cancer presentations.</data>
      <data key="d3">chunk-6a93aa507dd7d98a02e8ba92d39e3649</data>
    </node>
    <node id="Inflammatory Breast Cancer (IBC)">
      <data key="d0">Inflammatory Breast Cancer (IBC)</data>
      <data key="d1">category</data>
      <data key="d2">A rare, aggressive form of breast cancer where cancer cells block lymph vessels in the skin of the breast, causing symptoms such as redness, swelling, warmth, and pain, often without a detectable lump.</data>
      <data key="d3">chunk-5846f51c2ca4fae54459ce9c50e3e820</data>
    </node>
    <node id="Clinical Breast Exam (CBE)">
      <data key="d0">Clinical Breast Exam (CBE)</data>
      <data key="d1">event</data>
      <data key="d2">A specialized physical examination of the bare breast and armpit performed by a healthcare provider to detect lumps, swelling, or skin changes.</data>
      <data key="d3">chunk-5846f51c2ca4fae54459ce9c50e3e820</data>
    </node>
    <node id="Medical History and Physical Exam (H&amp;P)">
      <data key="d0">Medical History and Physical Exam (H&amp;P)</data>
      <data key="d1">event</data>
      <data key="d2">An initial comprehensive medical assessment conducted by a multidisciplinary team covering health history, physical examination, and medical photography.</data>
      <data key="d3">chunk-5846f51c2ca4fae54459ce9c50e3e820</data>
    </node>
    <node id="Primary Care Physician (PCP)">
      <data key="d0">Primary Care Physician (PCP)</data>
      <data key="d1">person</data>
      <data key="d2">A patient's principal general doctor who is kept informed of diagnostic updates and cancer treatments.</data>
      <data key="d3">chunk-5846f51c2ca4fae54459ce9c50e3e820</data>
    </node>
    <node id="Nurse Patient">
      <data key="d0">Nurse Patient</data>
      <data key="d1">person</data>
      <data key="d2">A healthcare worker and patient featured in a personal account who was diagnosed with inflammatory breast cancer after persistent breast changes.</data>
      <data key="d3">chunk-5846f51c2ca4fae54459ce9c50e3e820</data>
    </node>
    <node id="Hormone Receptor Status">
      <data key="d0">Hormone Receptor Status</data>
      <data key="d1">category</data>
      <data key="d2">A biological marker category evaluated as part of biomarker testing to determine treatment planning in breast cancer.&lt;SEP&gt;A diagnostic biomarker measurement determining whether cancer cells possess estrogen or progesterone receptors to guide therapy.</data>
      <data key="d3">chunk-650982a589c2d527bc13923ccd0569ef&lt;SEP&gt;chunk-5846f51c2ca4fae54459ce9c50e3e820</data>
    </node>
    <node id="HER2 Status">
      <data key="d0">HER2 Status</data>
      <data key="d1">category</data>
      <data key="d2">A biomarker evaluation determining whether cancer cells overexpress the human epidermal growth factor receptor 2 protein.&lt;SEP&gt;A molecular diagnostic marker indicating the level of human epidermal growth factor receptor 2 in breast cancer cells.</data>
      <data key="d3">chunk-0d388da75afb5ea2d01c97e55cb2b872&lt;SEP&gt;chunk-5846f51c2ca4fae54459ce9c50e3e820</data>
    </node>
    <node id="Comprehensive Metabolic Panel (CMP)">
      <data key="d0">Comprehensive Metabolic Panel (CMP)</data>
      <data key="d1">category</data>
      <data key="d2">A routine blood panel assessing organ function, including liver function tests (LFTs) and alkaline phosphatase.</data>
      <data key="d3">chunk-5846f51c2ca4fae54459ce9c50e3e820</data>
    </node>
    <node id="Breast MRI">
      <data key="d0">Breast MRI</data>
      <data key="d1">category</data>
      <data key="d2">A specialized magnetic resonance imaging study of the breast used to evaluate tissue changes and tumor extent.&lt;SEP&gt;An MRI test of the breast performed with contrast while lying face down, typically used in addition to mammography.</data>
      <data key="d3">chunk-a2778e34af702d49d5e70867726e14b2&lt;SEP&gt;chunk-5846f51c2ca4fae54459ce9c50e3e820</data>
    </node>
    <node id="PET-CT">
      <data key="d0">PET-CT</data>
      <data key="d1">category</data>
      <data key="d2">An advanced imaging modality combining positron emission tomography and computed tomography used for cancer staging.</data>
      <data key="d3">chunk-5846f51c2ca4fae54459ce9c50e3e820</data>
    </node>
    <node id="Nurse">
      <data key="d0">Nurse</data>
      <data key="d1">person</data>
      <data key="d2">A healthcare professional who assists in patient care, clinical communication, and managing portal messages within the healthcare setting.&lt;SEP&gt;A healthcare worker who assists providers and attends clinical procedures, such as physical breast examinations.</data>
      <data key="d3">chunk-0bd86bf8fc82f14fa5f7f51d924514e7&lt;SEP&gt;chunk-f9a9eb8b01f29fdf214c10bdffac3203</data>
    </node>
    <node id="Breast Exam">
      <data key="d0">Breast Exam</data>
      <data key="d1">event</data>
      <data key="d2">A physical diagnostic examination in which a medical provider palpates the entire breast and armpit to assess for abnormalities.</data>
      <data key="d3">chunk-0bd86bf8fc82f14fa5f7f51d924514e7</data>
    </node>
    <node id="Alkaline Phosphatase Test">
      <data key="d0">Alkaline Phosphatase Test</data>
      <data key="d1">category</data>
      <data key="d2">A diagnostic blood evaluation measuring ALP enzyme levels to detect bone tumors, liver disorders, or pregnancy.&lt;SEP&gt;A diagnostic blood test measuring ALP enzyme levels; elevated levels can signal cancer metastasis to the bone or liver.</data>
      <data key="d3">chunk-3fbf2f6a3c150687a59f814d94f1d150&lt;SEP&gt;chunk-0bd86bf8fc82f14fa5f7f51d924514e7</data>
    </node>
    <node id="Bone X-ray">
      <data key="d0">Bone X-ray</data>
      <data key="d1">category</data>
      <data key="d2">A low-dose radiation imaging test used to detect tumors and bone issues, often ordered if pain is present or after an abnormal bone scan.</data>
      <data key="d3">chunk-a2778e34af702d49d5e70867726e14b2</data>
    </node>
    <node id="Spine And Brain MRI">
      <data key="d0">Spine And Brain MRI</data>
      <data key="d1">category</data>
      <data key="d2">An MRI scan conducted to identify potential breast cancer metastasis to the spine or brain.</data>
      <data key="d3">chunk-a2778e34af702d49d5e70867726e14b2</data>
    </node>
    <node id="PET-CT Scan">
      <data key="d0">PET-CT Scan</data>
      <data key="d1">category</data>
      <data key="d2">A medical imaging technique combining Positron Emission Tomography (PET) and Computed Tomography (CT) to detect cancer and abnormal bodily activity.&lt;SEP&gt;An advanced imaging modality combining positron emission tomography and computed tomography into a single evaluation.</data>
      <data key="d3">chunk-a2778e34af702d49d5e70867726e14b2&lt;SEP&gt;chunk-7f9fe20fe42489996573eb1b436128b6</data>
    </node>
    <node id="Sodium Fluoride PET-CT">
      <data key="d0">Sodium Fluoride PET-CT</data>
      <data key="d1">category</data>
      <data key="d2">A specialized PET-CT scan utilizing a sodium fluoride radiotracer, often used as an alternative to a bone scan to detect cancer in bones.&lt;SEP&gt;A specific PET-CT imaging technique that may be utilized as an alternative to a standard bone scan.</data>
      <data key="d3">chunk-a2778e34af702d49d5e70867726e14b2&lt;SEP&gt;chunk-7f9fe20fe42489996573eb1b436128b6</data>
    </node>
    <node id="Radiotracer">
      <data key="d0">Radiotracer</data>
      <data key="d1">category</data>
      <data key="d2">A radioactive substance injected into a vein that releases small amounts of radiation, utilized in bone scans and PET scans to highlight damage or cancer.</data>
      <data key="d3">chunk-a2778e34af702d49d5e70867726e14b2</data>
    </node>
    <node id="Bilateral Mammogram">
      <data key="d0">Bilateral Mammogram</data>
      <data key="d1">category</data>
      <data key="d2">A type of mammogram that involves capturing x-ray images of both breasts for treatment planning.</data>
      <data key="d3">chunk-a2778e34af702d49d5e70867726e14b2</data>
    </node>
    <node id="2D Digital Mammography">
      <data key="d0">2D Digital Mammography</data>
      <data key="d1">category</data>
      <data key="d2">Standard two-dimensional digital x-ray imaging used for screening and diagnostic breast examinations.</data>
      <data key="d3">chunk-a2778e34af702d49d5e70867726e14b2</data>
    </node>
    <node id="FDG PET-CT">
      <data key="d0">FDG PET-CT</data>
      <data key="d1">category</data>
      <data key="d2">A diagnostic scan using F-18 fluorodeoxyglucose radiotracer to identify cancer cells in lymph nodes and distant body sites.</data>
      <data key="d3">chunk-7f9fe20fe42489996573eb1b436128b6</data>
    </node>
    <node id="FES PET-CT">
      <data key="d0">FES PET-CT</data>
      <data key="d1">category</data>
      <data key="d2">A PET-CT imaging procedure using radioactive estrogen, employed when breast cancer is estrogen receptor-positive.</data>
      <data key="d3">chunk-7f9fe20fe42489996573eb1b436128b6</data>
    </node>
    <node id="Vacuum-Assisted Core Biopsy">
      <data key="d0">Vacuum-Assisted Core Biopsy</data>
      <data key="d1">category</data>
      <data key="d2">A minimally invasive biopsy technique that employs suction with a vacuum device to obtain tissue samples.</data>
      <data key="d3">chunk-7f9fe20fe42489996573eb1b436128b6</data>
    </node>
    <node id="Excisional Biopsy">
      <data key="d0">Excisional Biopsy</data>
      <data key="d1">event</data>
      <data key="d2">A surgical procedure in which all or part of a lymph node is removed by cutting into the skin for diagnostic examination.&lt;SEP&gt;A surgical procedure in which an entire abnormal area or tumor is removed for examination.&lt;SEP&gt;A surgical procedure in which an entire lymph node is removed by a surgeon for examination and diagnostic testing.</data>
      <data key="d3">chunk-a18089523f6dcd63cfa5664dc1c01618&lt;SEP&gt;chunk-7f9fe20fe42489996573eb1b436128b6&lt;SEP&gt;chunk-717174ace5855cc823d51c46c9a70648</data>
    </node>
    <node id="Incisional Biopsy">
      <data key="d0">Incisional Biopsy</data>
      <data key="d1">category</data>
      <data key="d2">A biopsy method that involves making an incision to remove a portion of an abnormal area for diagnostic testing.&lt;SEP&gt;A surgical biopsy procedure in which only part of a lymph node is removed for diagnostic evaluation.</data>
      <data key="d3">chunk-7f9fe20fe42489996573eb1b436128b6&lt;SEP&gt;chunk-717174ace5855cc823d51c46c9a70648</data>
    </node>
    <node id="Axillary Lymph Node Needle Biopsy">
      <data key="d0">Axillary Lymph Node Needle Biopsy</data>
      <data key="d1">category</data>
      <data key="d2">A diagnostic needle biopsy targeting lymph nodes near the armpit to evaluate whether cancer cells have spread.</data>
      <data key="d3">chunk-7f9fe20fe42489996573eb1b436128b6</data>
    </node>
    <node id="Mastectomy">
      <data key="d0">Mastectomy</data>
      <data key="d1">category</data>
      <data key="d2">A surgical operation or procedure to remove all or part of the breast to eliminate cancerous tissue.&lt;SEP&gt;A surgical operation performed to remove the breast, during which a sentinel lymph node biopsy may also be conducted.&lt;SEP&gt;A surgical procedure performed by surgical oncologists to remove breast tissue affected by cancer, often followed by breast reconstruction.&lt;SEP&gt;A surgical procedure that involves the surgical removal of one or both breasts, often used in cancer treatment.</data>
      <data key="d3">chunk-7f9fe20fe42489996573eb1b436128b6&lt;SEP&gt;chunk-e90bcd28496f1f39a21973656e3e496f&lt;SEP&gt;chunk-562e1870b5e20f8648a2e56d960a1148&lt;SEP&gt;chunk-cb41559e96b71d2bb4ea207c806e8d5f</data>
    </node>
    <node id="Lumpectomy">
      <data key="d0">Lumpectomy</data>
      <data key="d1">category</data>
      <data key="d2">A breast-conserving surgical procedure to excise a tumor and an optimal margin of surrounding normal tissue.&lt;SEP&gt;A surgical operation to remove a breast tumor while conserving breast tissue, often accompanied by a sentinel lymph node biopsy.</data>
      <data key="d3">chunk-7f9fe20fe42489996573eb1b436128b6&lt;SEP&gt;chunk-562e1870b5e20f8648a2e56d960a1148</data>
    </node>
    <node id="Stereotactic Needle Biopsy">
      <data key="d0">Stereotactic Needle Biopsy</data>
      <data key="d1">category</data>
      <data key="d2">A biopsy technique where mammography is used to guide the needle into the tumor.</data>
      <data key="d3">chunk-7f9fe20fe42489996573eb1b436128b6</data>
    </node>
    <node id="Open Biopsy">
      <data key="d0">Open Biopsy</data>
      <data key="d1">event</data>
      <data key="d2">A surgical diagnostic procedure involving a craniotomy to open the skull and excise tissue samples from a brain tumor.&lt;SEP&gt;A surgical procedure to excise a tumor in order to evaluate tissue structure and confirm histological diagnosis.&lt;SEP&gt;One of the standard types of surgical biopsy procedures for gliomas, used when tumor resection is not viable.</data>
      <data key="d3">chunk-ffc3446f8ec092af24a460bda94f772f&lt;SEP&gt;chunk-49c7ff3a71e74b3f0eb59258541e739e&lt;SEP&gt;chunk-562e1870b5e20f8648a2e56d960a1148</data>
    </node>
    <node id="Hormone Receptor-Positive Breast Cancer">
      <data key="d0">Hormone Receptor-Positive Breast Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A classification of breast cancer where cancer cells express estrogen and/or progesterone receptors that stimulate growth and can be targeted by endocrine therapy.&lt;SEP&gt;A subtype of breast cancer where cancer cells express estrogen or progesterone receptors, making them susceptible to endocrine therapies.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408&lt;SEP&gt;chunk-562e1870b5e20f8648a2e56d960a1148</data>
    </node>
    <node id="Hormone Receptor-Negative Breast Cancer">
      <data key="d0">Hormone Receptor-Negative Breast Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A breast cancer classification where cells lack both estrogen and progesterone receptors, often growing faster than hormone receptor-positive cancers.</data>
      <data key="d3">chunk-562e1870b5e20f8648a2e56d960a1148</data>
    </node>
    <node id="Estrogen Receptor-Positive Breast Cancer">
      <data key="d0">Estrogen Receptor-Positive Breast Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A subset of breast cancer in which cancer cells express estrogen receptors that receive growth signals stimulated by estrogen.</data>
      <data key="d3">chunk-562e1870b5e20f8648a2e56d960a1148</data>
    </node>
    <node id="HER2-Positive Breast Cancer">
      <data key="d0">HER2-Positive Breast Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A breast cancer classification marked by elevated levels of the HER2 protein, making it eligible for HER2-targeted therapy.&lt;SEP&gt;A subtype of breast cancer characterized by high amounts of the HER2 protein or amplification of the HER2 gene, leading to increased cell growth and division.</data>
      <data key="d3">chunk-9040f5949ae0ff36ce88faa1f4b67ead&lt;SEP&gt;chunk-562e1870b5e20f8648a2e56d960a1148</data>
    </node>
    <node id="Endocrine Therapy">
      <data key="d0">Endocrine Therapy</data>
      <data key="d1">category</data>
      <data key="d2">A cancer treatment category, also known as hormone therapy, that blocks estrogen or progesterone to treat hormone receptor-positive breast cancer.&lt;SEP&gt;A category of medical cancer treatment involving the modulation or suppression of hormones.&lt;SEP&gt;A medical treatment approach that blocks estrogen receptor signaling or deprives cancer cells of hormones to halt growth in hormone receptor-positive cancers.&lt;SEP&gt;A systemic treatment class utilized in breast cancer therapy based on hormone receptor status such as estrogen receptor and progesterone receptor.&lt;SEP&gt;A targeted treatment for hormone receptor-positive breast cancers that slows or stops cancer cell growth by interfering with hormones.&lt;SEP&gt;Hormonal systemic therapy used in hormone receptor-positive breast cancer, often combined with targeted inhibitors like CDK4/6 or mTOR inhibitors.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408&lt;SEP&gt;chunk-562e1870b5e20f8648a2e56d960a1148&lt;SEP&gt;chunk-cb41559e96b71d2bb4ea207c806e8d5f&lt;SEP&gt;chunk-dd58424a14d9942181ba4ca3c1ec81c1&lt;SEP&gt;chunk-9040f5949ae0ff36ce88faa1f4b67ead&lt;SEP&gt;chunk-e90bcd28496f1f39a21973656e3e496f</data>
    </node>
    <node id="In Situ Hybridization">
      <data key="d0">In Situ Hybridization</data>
      <data key="d1">category</data>
      <data key="d2">A specialized molecular test that counts the number of copies of the HER2 gene, typically used when immunohistochemistry results are unclear.</data>
      <data key="d3">chunk-562e1870b5e20f8648a2e56d960a1148</data>
    </node>
    <node id="Hormone Receptor Testing">
      <data key="d0">Hormone Receptor Testing</data>
      <data key="d1">event</data>
      <data key="d2">A laboratory diagnostic procedure performed on biopsy samples from newly identified tumors to assess estrogen and progesterone receptor status.</data>
      <data key="d3">chunk-562e1870b5e20f8648a2e56d960a1148</data>
    </node>
    <node id="Tumor Marker Testing">
      <data key="d0">Tumor Marker Testing</data>
      <data key="d1">event</data>
      <data key="d2">A diagnostic evaluation conducted on blood or biopsy tissue samples to identify specific proteins associated with cancer.</data>
      <data key="d3">chunk-562e1870b5e20f8648a2e56d960a1148</data>
    </node>
    <node id="ER-Low-Positive Invasive Breast Cancer">
      <data key="d0">ER-Low-Positive Invasive Breast Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A subcategory of invasive breast cancer in which estrogen receptors are identified in only 1 to 10 out of every 100 cancer cells, and for which endocrine therapy might not be recommended.</data>
      <data key="d3">chunk-562e1870b5e20f8648a2e56d960a1148</data>
    </node>
    <node id="Tumor Mutational Burden">
      <data key="d0">Tumor Mutational Burden</data>
      <data key="d1">category</data>
      <data key="d2">A genomic metric (TMB-H) measuring the number of mutations per million base pairs in tumor DNA, used to predict response to immune checkpoint inhibitors.</data>
      <data key="d3">chunk-650982a589c2d527bc13923ccd0569ef</data>
    </node>
    <node id="PD-1 And PD-L1 Testing">
      <data key="d0">PD-1 And PD-L1 Testing</data>
      <data key="d1">category</data>
      <data key="d2">Evaluation of the immune proteins PD-1 and PD-L1 on cancer cells to determine candidate eligibility for checkpoint inhibitor therapy.</data>
      <data key="d3">chunk-650982a589c2d527bc13923ccd0569ef</data>
    </node>
    <node id="FISH">
      <data key="d0">FISH</data>
      <data key="d1">category</data>
      <data key="d2">Fluorescence in situ hybridization, a molecular cytogenetic testing method using fluorescent dye probes that bind to specific pieces of DNA.&lt;SEP&gt;Fluorescence in situ hybridization, a specialized genetic testing method used to analyze CLL cells for treatment planning.</data>
      <data key="d3">chunk-650982a589c2d527bc13923ccd0569ef&lt;SEP&gt;chunk-717174ace5855cc823d51c46c9a70648</data>
    </node>
    <node id="BRCA Tests">
      <data key="d0">BRCA Tests</data>
      <data key="d1">category</data>
      <data key="d2">Genetic assessments evaluating mutations in the BRCA1 and BRCA2 genes, which are associated with increased risks of breast, ovarian, and other cancers.</data>
      <data key="d3">chunk-650982a589c2d527bc13923ccd0569ef</data>
    </node>
    <node id="Family Cancer Health History">
      <data key="d0">Family Cancer Health History</data>
      <data key="d1">category</data>
      <data key="d2">A recorded collection of health information and cancer diagnoses among biological relatives used to identify hereditary health patterns.</data>
      <data key="d3">chunk-650982a589c2d527bc13923ccd0569ef</data>
    </node>
    <node id="Targeted Therapies">
      <data key="d0">Targeted Therapies</data>
      <data key="d1">category</data>
      <data key="d2">Cancer treatments targeted at specific molecular changes in tumor cells, selected based on biomarker testing results.&lt;SEP&gt;Medical cancer therapies specifically designed to target distinct gene alterations, such as PIK3CA mutations.</data>
      <data key="d3">chunk-650982a589c2d527bc13923ccd0569ef&lt;SEP&gt;chunk-9d0e32bdc49dbab9c2c953abf363e317</data>
    </node>
    <node id="HER2">
      <data key="d0">HER2</data>
      <data key="d1">category</data>
      <data key="d2">A cellular protein and established biomarker tested in breast cancer to inform therapeutic strategies.&lt;SEP&gt;A protein biomarker tested in recurrent cervical cancer to assess eligibility for targeted agents.</data>
      <data key="d3">chunk-650982a589c2d527bc13923ccd0569ef&lt;SEP&gt;chunk-b3ba7430f3a31330247f52afe7e9c68a</data>
    </node>
    <node id="PIK3CA">
      <data key="d0">PIK3CA</data>
      <data key="d1">category</data>
      <data key="d2">A specific tumor gene mutation that can be detected through tumor mutation testing and treated with targeted therapies.</data>
      <data key="d3">chunk-650982a589c2d527bc13923ccd0569ef</data>
    </node>
    <node id="PD-1">
      <data key="d0">PD-1</data>
      <data key="d1">category</data>
      <data key="d2">Programmed death protein 1, an immune protein on cell surfaces that suppresses anti-tumor immune responses and serves as a drug target.</data>
      <data key="d3">chunk-650982a589c2d527bc13923ccd0569ef</data>
    </node>
    <node id="PD-L1">
      <data key="d0">PD-L1</data>
      <data key="d1">category</data>
      <data key="d2">A biomarker protein evaluated in recurrent, progressive, or metastatic cervical cancer to assess suitability for immunotherapy.&lt;SEP&gt;Programmed death-ligand 1, an immune protein expressed on cancer cells targeted by checkpoint inhibitors.</data>
      <data key="d3">chunk-650982a589c2d527bc13923ccd0569ef&lt;SEP&gt;chunk-b3ba7430f3a31330247f52afe7e9c68a</data>
    </node>
    <node id="Carcinoembryonic Antigen">
      <data key="d0">Carcinoembryonic Antigen</data>
      <data key="d1">category</data>
      <data key="d2">A protein tumor marker (CEA) tested in blood or tissue to monitor cancer growth or spread.</data>
      <data key="d3">chunk-650982a589c2d527bc13923ccd0569ef</data>
    </node>
    <node id="CA 15-3">
      <data key="d0">CA 15-3</data>
      <data key="d1">category</data>
      <data key="d2">A protein biomarker monitored in breast cancer patients that may reflect disease progression.</data>
      <data key="d3">chunk-650982a589c2d527bc13923ccd0569ef</data>
    </node>
    <node id="Mismatch Repair Proteins">
      <data key="d0">Mismatch Repair Proteins</data>
      <data key="d1">category</data>
      <data key="d2">Cellular repair proteins (MMR) that fix short DNA replication errors; deficiency leads to microsatellite instability.&lt;SEP&gt;Proteins responsible for recognizing and repairing errors in short, repeated DNA sequences called microsatellites.</data>
      <data key="d3">chunk-650982a589c2d527bc13923ccd0569ef&lt;SEP&gt;chunk-30c0bb66b1a2f93e89f5342ab1077451</data>
    </node>
    <node id="Breast Cancer Staging">
      <data key="d0">Breast Cancer Staging</data>
      <data key="d1">category</data>
      <data key="d2">A system used to classify the extent of breast cancer based on tumor size, lymph node involvement, metastasis (TNM), and biomarker status to determine prognosis and treatment.</data>
      <data key="d3">chunk-fc469adbdd7a41816d59f249439bc726</data>
    </node>
    <node id="Hereditary Genetic Testing">
      <data key="d0">Hereditary Genetic Testing</data>
      <data key="d1">event</data>
      <data key="d2">Diagnostic genetic testing recommended based on family medical history to identify inherited mutations linked to breast cancer risk.</data>
      <data key="d3">chunk-fc469adbdd7a41816d59f249439bc726</data>
    </node>
    <node id="Biomarker Status">
      <data key="d0">Biomarker Status</data>
      <data key="d1">category</data>
      <data key="d2">The classification of tumor receptors and biological markers including estrogen receptor (ER), progesterone receptor (PR), and HER2 that guide treatment.</data>
      <data key="d3">chunk-fc469adbdd7a41816d59f249439bc726</data>
    </node>
    <node id="Stage 3 Breast Cancer">
      <data key="d0">Stage 3 Breast Cancer</data>
      <data key="d1">category</data>
      <data key="d2">An advanced breast cancer classification characterized by tumors involving skin, chest wall, or fixed lymph nodes.</data>
      <data key="d3">chunk-fc469adbdd7a41816d59f249439bc726</data>
    </node>
    <node id="Stage 4 Breast Cancer">
      <data key="d0">Stage 4 Breast Cancer</data>
      <data key="d1">category</data>
      <data key="d2">An advanced cancer classification denoting metastatic breast cancer that has spread to distant organs and other parts of the body.</data>
      <data key="d3">chunk-fc469adbdd7a41816d59f249439bc726</data>
    </node>
    <node id="Hereditary Breast Cancer">
      <data key="d0">Hereditary Breast Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A form of breast cancer attributed to inherited gene mutations, representing approximately one in ten breast cancer cases.</data>
      <data key="d3">chunk-fc469adbdd7a41816d59f249439bc726</data>
    </node>
    <node id="Prognostic Stage">
      <data key="d0">Prognostic Stage</data>
      <data key="d1">category</data>
      <data key="d2">A breast cancer classification framework that incorporates anatomic TNM measures, tumor grade, and biomarker status (such as ER, PR, and HER2) under standard-of-care assumptions.</data>
      <data key="d3">chunk-0d388da75afb5ea2d01c97e55cb2b872</data>
    </node>
    <node id="Tumor Size (T)">
      <data key="d0">Tumor Size (T)</data>
      <data key="d1">category</data>
      <data key="d2">A staging metric within the TNM system measuring the size, depth, and local invasion of the primary tumor in centimeters or millimeters.</data>
      <data key="d3">chunk-0d388da75afb5ea2d01c97e55cb2b872</data>
    </node>
    <node id="Lymph Node Status (N)">
      <data key="d0">Lymph Node Status (N)</data>
      <data key="d1">category</data>
      <data key="d2">A staging metric assessing the spread of cancer to nearby regional lymph nodes, such as axillary, internal mammary, infraclavicular, and supraclavicular nodes.</data>
      <data key="d3">chunk-0d388da75afb5ea2d01c97e55cb2b872</data>
    </node>
    <node id="Distant Metastasis (M)">
      <data key="d0">Distant Metastasis (M)</data>
      <data key="d1">category</data>
      <data key="d2">A staging metric identifying whether breast cancer cells have spread to distant body organs such as the bones or lungs.</data>
      <data key="d3">chunk-0d388da75afb5ea2d01c97e55cb2b872</data>
    </node>
    <node id="Progesterone Receptor Status">
      <data key="d0">Progesterone Receptor Status</data>
      <data key="d1">category</data>
      <data key="d2">A biomarker category evaluating the presence of progesterone receptors (PR) on cancer cells, used in prognostic staging.</data>
      <data key="d3">chunk-0d388da75afb5ea2d01c97e55cb2b872</data>
    </node>
    <node id="Drug Therapy">
      <data key="d0">Drug Therapy</data>
      <data key="d1">category</data>
      <data key="d2">Pharmacological treatment administered before or after surgery, altering staging notation (such as ypT) when given preoperatively.</data>
      <data key="d3">chunk-0d388da75afb5ea2d01c97e55cb2b872</data>
    </node>
    <node id="Axillary Lymph Nodes">
      <data key="d0">Axillary Lymph Nodes</data>
      <data key="d1">category</data>
      <data key="d2">Regional lymph nodes located under the arm, typically the initial site of regional breast cancer spread.</data>
      <data key="d3">chunk-0d388da75afb5ea2d01c97e55cb2b872</data>
    </node>
    <node id="Internal Mammary Lymph Nodes">
      <data key="d0">Internal Mammary Lymph Nodes</data>
      <data key="d1">category</data>
      <data key="d2">Regional lymph nodes situated near the breastbone that are assessed during clinical staging.</data>
      <data key="d3">chunk-0d388da75afb5ea2d01c97e55cb2b872</data>
    </node>
    <node id="Infraclavicular Lymph Nodes">
      <data key="d0">Infraclavicular Lymph Nodes</data>
      <data key="d1">category</data>
      <data key="d2">Regional lymph nodes situated beneath the collarbone evaluated for cancer involvement.</data>
      <data key="d3">chunk-0d388da75afb5ea2d01c97e55cb2b872</data>
    </node>
    <node id="Supraclavicular Lymph Nodes">
      <data key="d0">Supraclavicular Lymph Nodes</data>
      <data key="d1">category</data>
      <data key="d2">Regional lymph nodes located above the collarbone monitored during clinical staging of breast cancer.</data>
      <data key="d3">chunk-0d388da75afb5ea2d01c97e55cb2b872</data>
    </node>
    <node id="Isolated Tumor Cells (ITCs)">
      <data key="d0">Isolated Tumor Cells (ITCs)</data>
      <data key="d1">category</data>
      <data key="d2">Very small clusters of malignant cells detected in lymph nodes that fall within the N0 regional node category.</data>
      <data key="d3">chunk-0d388da75afb5ea2d01c97e55cb2b872</data>
    </node>
    <node id="Lymph Node Micrometastasis">
      <data key="d0">Lymph Node Micrometastasis</data>
      <data key="d1">category</data>
      <data key="d2">A cluster of approximately 200 cancerous cells within regional lymph nodes, designated as N1mi.</data>
      <data key="d3">chunk-0d388da75afb5ea2d01c97e55cb2b872</data>
    </node>
    <node id="Tumor Micrometastasis">
      <data key="d0">Tumor Micrometastasis</data>
      <data key="d1">category</data>
      <data key="d2">A minute collection of cancer cells smaller than 1 mm within primary tumor assessment, designated as T1mi.</data>
      <data key="d3">chunk-0d388da75afb5ea2d01c97e55cb2b872</data>
    </node>
    <node id="Doctors">
      <data key="d0">Doctors</data>
      <data key="d1">person</data>
      <data key="d2">Medical professionals who evaluate diagnostic findings, assign cancer stages, and communicate treatment plans.</data>
      <data key="d3">chunk-0d388da75afb5ea2d01c97e55cb2b872</data>
    </node>
    <node id="HER2-Targeted Therapy">
      <data key="d0">HER2-Targeted Therapy</data>
      <data key="d1">category</data>
      <data key="d2">A specialized class of systemic therapies targeted specifically at HER2 receptors on cancer cells to inhibit breast tumor growth.&lt;SEP&gt;A systemic therapy class designed to target HER2 expression in cancer cells using antibodies, inhibitors, and antibody-drug conjugates.&lt;SEP&gt;A targeted cancer therapy category comprising antibodies, inhibitors, and antibody-drug conjugates that target HER2 proteins.</data>
      <data key="d3">chunk-9040f5949ae0ff36ce88faa1f4b67ead&lt;SEP&gt;chunk-e90bcd28496f1f39a21973656e3e496f&lt;SEP&gt;chunk-cb41559e96b71d2bb4ea207c806e8d5f</data>
    </node>
    <node id="Bone-Strengthening Therapy">
      <data key="d0">Bone-Strengthening Therapy</data>
      <data key="d1">category</data>
      <data key="d2">A supportive therapeutic category utilized in breast cancer care to protect and strengthen bones, particularly during advanced or metastatic disease.</data>
      <data key="d3">chunk-cb41559e96b71d2bb4ea207c806e8d5f</data>
    </node>
    <node id="Diagnostic Radiologist">
      <data key="d0">Diagnostic Radiologist</data>
      <data key="d1">person</data>
      <data key="d2">A medical specialist who interprets imaging studies such as mammograms and ultrasounds to detect and evaluate breast abnormalities.&lt;SEP&gt;A physician specializing in interpreting diagnostic medical imaging, such as x-rays, to detect and monitor disease.</data>
      <data key="d3">chunk-dea00cf063e8831db4919330d94b1f2a&lt;SEP&gt;chunk-cb41559e96b71d2bb4ea207c806e8d5f</data>
    </node>
    <node id="Surgical Oncologist">
      <data key="d0">Surgical Oncologist</data>
      <data key="d1">person</data>
      <data key="d2">A surgeon specialized in performing oncologic operations, such as lumpectomies or mastectomies, to remove cancerous tissue.</data>
      <data key="d3">chunk-cb41559e96b71d2bb4ea207c806e8d5f</data>
    </node>
    <node id="Oncology Nurse">
      <data key="d0">Oncology Nurse</data>
      <data key="d1">person</data>
      <data key="d2">A specialized healthcare provider who administers systemic treatments, coordinates patient care, and assists with managing adverse side effects.&lt;SEP&gt;An oncology nurse provides direct, hands-on care for cancer patients, administering systemic therapy, managing clinical care, addressing inquiries, and helping manage treatment side effects.</data>
      <data key="d3">chunk-dea00cf063e8831db4919330d94b1f2a&lt;SEP&gt;chunk-cb41559e96b71d2bb4ea207c806e8d5f</data>
    </node>
    <node id="Oncology Pharmacist">
      <data key="d0">Oncology Pharmacist</data>
      <data key="d1">person</data>
      <data key="d2">A clinical expert who specializes in selecting, dosing, and managing antineoplastic drugs and symptom-relief medications.</data>
      <data key="d3">chunk-cb41559e96b71d2bb4ea207c806e8d5f</data>
    </node>
    <node id="Clinical Social Worker">
      <data key="d0">Clinical Social Worker</data>
      <data key="d1">person</data>
      <data key="d2">A mental health and supportive care provider who diagnoses and treats emotional concerns, addresses anxiety, and assists patients with financial and logistical challenges.</data>
      <data key="d3">chunk-cb41559e96b71d2bb4ea207c806e8d5f</data>
    </node>
    <node id="Local Therapy">
      <data key="d0">Local Therapy</data>
      <data key="d1">category</data>
      <data key="d2">A treatment approach focused on the breast, chest wall, and lymph node area, including procedures such as mastectomy and radiation therapy.&lt;SEP&gt;Site-specific medical interventions used to manage localized tumor lesions in organs such as the liver, lungs, or bones prior to systemic therapy.</data>
      <data key="d3">chunk-e90bcd28496f1f39a21973656e3e496f&lt;SEP&gt;chunk-8ba71a5181f3814dffb21d3399441bea</data>
    </node>
    <node id="Modified Radical Mastectomy">
      <data key="d0">Modified Radical Mastectomy</data>
      <data key="d1">category</data>
      <data key="d2">A surgical procedure frequently used for inflammatory breast cancer in which the entire breast and axillary lymph nodes, and sometimes part of the chest wall muscle, are removed.&lt;SEP&gt;A surgical procedure in which the entire breast, some lymph nodes, and potentially part of the chest wall muscle are removed.</data>
      <data key="d3">chunk-9040f5949ae0ff36ce88faa1f4b67ead&lt;SEP&gt;chunk-e90bcd28496f1f39a21973656e3e496f</data>
    </node>
    <node id="Clinical Social Workers">
      <data key="d0">Clinical Social Workers</data>
      <data key="d1">category</data>
      <data key="d2">Mental health professionals who diagnose and treat behavioral, mental, and emotional issues in patients facing cancer.</data>
      <data key="d3">chunk-e90bcd28496f1f39a21973656e3e496f</data>
    </node>
    <node id="Inhibitor Therapy">
      <data key="d0">Inhibitor Therapy</data>
      <data key="d1">category</data>
      <data key="d2">A systemic treatment category that includes CDK4/6, mTOR, and PARP inhibitors such as palbociclib, everolimus, and olaparib.</data>
      <data key="d3">chunk-e90bcd28496f1f39a21973656e3e496f</data>
    </node>
    <node id="Breast Reconstruction">
      <data key="d0">Breast Reconstruction</data>
      <data key="d1">category</data>
      <data key="d2">A surgical procedure, often performed in stages as delayed reconstruction, to rebuild the breast following a mastectomy.</data>
      <data key="d3">chunk-e90bcd28496f1f39a21973656e3e496f</data>
    </node>
    <node id="Plastic Surgeon">
      <data key="d0">Plastic Surgeon</data>
      <data key="d1">category</data>
      <data key="d2">A specialized surgeon consulted to perform breast reconstruction surgery following cancer treatment.</data>
      <data key="d3">chunk-e90bcd28496f1f39a21973656e3e496f</data>
    </node>
    <node id="Cancer Centers and Hospitals">
      <data key="d0">Cancer Centers and Hospitals</data>
      <data key="d1">organization</data>
      <data key="d2">Healthcare facilities with specialized experience and high procedure volumes for treating complex diseases like inflammatory breast cancer.</data>
      <data key="d3">chunk-e90bcd28496f1f39a21973656e3e496f</data>
    </node>
    <node id="Myeloid Growth Factors">
      <data key="d0">Myeloid Growth Factors</data>
      <data key="d1">category</data>
      <data key="d2">A therapeutic class of treatments used to boost white blood cell counts and prevent infections during chemotherapy.</data>
      <data key="d3">chunk-9040f5949ae0ff36ce88faa1f4b67ead</data>
    </node>
    <node id="CDK4/6 Inhibitors">
      <data key="d0">CDK4/6 Inhibitors</data>
      <data key="d1">category</data>
      <data key="d2">A category of targeted inhibitor drugs that block cyclin-dependent kinase proteins to impede cancer cell division, often combined with endocrine therapy.</data>
      <data key="d3">chunk-9040f5949ae0ff36ce88faa1f4b67ead</data>
    </node>
    <node id="mTOR Inhibitors">
      <data key="d0">mTOR Inhibitors</data>
      <data key="d1">category</data>
      <data key="d2">A category of targeted drugs that inhibit mTOR cell proteins to restore the efficacy of endocrine therapy.</data>
      <data key="d3">chunk-9040f5949ae0ff36ce88faa1f4b67ead</data>
    </node>
    <node id="Regional Nodal Irradiation">
      <data key="d0">Regional Nodal Irradiation</data>
      <data key="d1">category</data>
      <data key="d2">A radiation therapy approach targeting lymph nodes in areas such as the infraclavicular, supraclavicular, or axillary bed.</data>
      <data key="d3">chunk-9040f5949ae0ff36ce88faa1f4b67ead</data>
    </node>
    <node id="Whole Breast Radiation Therapy">
      <data key="d0">Whole Breast Radiation Therapy</data>
      <data key="d1">category</data>
      <data key="d2">Radiation therapy directed at the entire breast tissue, commonly administered using a linear accelerator.</data>
      <data key="d3">chunk-9040f5949ae0ff36ce88faa1f4b67ead</data>
    </node>
    <node id="Herbal Supplements">
      <data key="d0">Herbal Supplements</data>
      <data key="d1">category</data>
      <data key="d2">Botanical and dietary products, including turmeric, gingko biloba, green tea extract, and St. John's wort, that can cause adverse drug interactions during systemic therapy.</data>
      <data key="d3">chunk-9040f5949ae0ff36ce88faa1f4b67ead</data>
    </node>
    <node id="Antibody Drug Conjugates">
      <data key="d0">Antibody Drug Conjugates</data>
      <data key="d1">category</data>
      <data key="d2">A class of targeted therapeutic agents (ADCs) that deliver cell-specific chemotherapy directly into HER2-positive cancer cells.</data>
      <data key="d3">chunk-9040f5949ae0ff36ce88faa1f4b67ead</data>
    </node>
    <node id="HER2 Antibodies">
      <data key="d0">HER2 Antibodies</data>
      <data key="d1">category</data>
      <data key="d2">Targeted agents that block external HER2 growth signals and stimulate the immune system to target cancer cells.</data>
      <data key="d3">chunk-9040f5949ae0ff36ce88faa1f4b67ead</data>
    </node>
    <node id="HER2 Inhibitors">
      <data key="d0">HER2 Inhibitors</data>
      <data key="d1">category</data>
      <data key="d2">Targeted therapeutic agents that block intracellular growth signals generated by HER2 proteins.</data>
      <data key="d3">chunk-9040f5949ae0ff36ce88faa1f4b67ead</data>
    </node>
    <node id="Ovarian Suppression">
      <data key="d0">Ovarian Suppression</data>
      <data key="d1">category</data>
      <data key="d2">A medical intervention involving ovarian suppression or ablation required for premenopausal individuals receiving CDK4/6 inhibitor regimens.&lt;SEP&gt;A therapeutic medical process using pharmacological agents, such as LHRH agonists, to temporarily stop the ovaries from producing hormones.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408&lt;SEP&gt;chunk-9040f5949ae0ff36ce88faa1f4b67ead</data>
    </node>
    <node id="Left Ventricular Ejection Fraction Test">
      <data key="d0">Left Ventricular Ejection Fraction Test</data>
      <data key="d1">event</data>
      <data key="d2">A diagnostic monitoring procedure measuring the heart's pumping efficiency before and during trastuzumab treatment.</data>
      <data key="d3">chunk-9040f5949ae0ff36ce88faa1f4b67ead</data>
    </node>
    <node id="Drug Interaction">
      <data key="d0">Drug Interaction</data>
      <data key="d1">event</data>
      <data key="d2">An adverse pharmacological event where herbal supplements, vitamins, or concurrent medications alter the efficacy or safety of systemic cancer therapy.</data>
      <data key="d3">chunk-9040f5949ae0ff36ce88faa1f4b67ead</data>
    </node>
    <node id="MTOR Inhibitors">
      <data key="d0">MTOR Inhibitors</data>
      <data key="d1">category</data>
      <data key="d2">A class of targeted drugs that inhibit the mTOR cell protein to help restore the effectiveness of endocrine therapy in cancer treatment.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408</data>
    </node>
    <node id="PIK3CA Inhibitors">
      <data key="d0">PIK3CA Inhibitors</data>
      <data key="d1">category</data>
      <data key="d2">A class of targeted therapies that inhibit mutated PIK3CA gene activity to counteract cancer cell growth and drug resistance.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408</data>
    </node>
    <node id="Aromatase Inhibitors">
      <data key="d0">Aromatase Inhibitors</data>
      <data key="d1">category</data>
      <data key="d2">A class of endocrine therapy drugs that prevent the enzyme aromatase from converting androgen into estrogen.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408</data>
    </node>
    <node id="Estrogen Receptor Modulators">
      <data key="d0">Estrogen Receptor Modulators</data>
      <data key="d1">category</data>
      <data key="d2">A category of anti-estrogen therapies that prevent hormones from binding to receptors, including SERMs and SERDs.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408</data>
    </node>
    <node id="Selective Estrogen Receptor Modulators">
      <data key="d0">Selective Estrogen Receptor Modulators</data>
      <data key="d1">category</data>
      <data key="d2">A subclass of estrogen receptor modulators, known as SERMs, that prevent estrogen from attaching to hormone receptors.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408</data>
    </node>
    <node id="Selective Estrogen Receptor Degraders">
      <data key="d0">Selective Estrogen Receptor Degraders</data>
      <data key="d1">category</data>
      <data key="d2">A subclass of estrogen receptor modulators, known as SERDs, that block and degrade estrogen receptors.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408</data>
    </node>
    <node id="Primary CNS Lymphoma">
      <data key="d0">Primary CNS Lymphoma</data>
      <data key="d1">category</data>
      <data key="d2">A distinct category of lymphoma affecting the central nervous system.&lt;SEP&gt;A form of cancer affecting the central nervous system for which various treatment options including chemotherapy, radiation, and stem cell rescue are utilized.&lt;SEP&gt;A rare and aggressive cancer category that originates in the lymphocytes of the central nervous system, including the brain, spinal cord, cerebrospinal fluid, or eyes.&lt;SEP&gt;A rare and aggressive cancer of lymphocytes that primarily develops in the central nervous system, including the brain, spinal cord, cerebrospinal fluid, and eyes.&lt;SEP&gt;A rare cancer affecting the central nervous system, including the brain and eyes, treatable with radiation, targeted therapy, immunotherapy, and stem cell rescue.&lt;SEP&gt;A rare cancer category affecting the central nervous system, including the brain, cerebrospinal fluid, spine, and eyes.&lt;SEP&gt;A rare type of cancer affecting the central nervous system, treated typically through a multi-step process including induction and consolidation phases.&lt;SEP&gt;A rare type of cancer that develops deep within brain tissue, typically treated with chemotherapy, steroids, or clinical trials rather than surgery.&lt;SEP&gt;A rare type of cancer that develops deep within the central nervous system, requiring specialized diagnostic tests, staging, and treatment regimens.&lt;SEP&gt;Primary CNS lymphoma is a type of cancer that originates in the central nervous system, affecting the brain, spinal cord, cerebrospinal fluid, or eyes.&lt;SEP&gt;Primary central nervous system (CNS) lymphoma is a type of cancer that develops in the brain, spine, or central nervous system with symptoms resembling other neurological conditions.</data>
      <data key="d3">chunk-8fbedfa2d88a7b3852f4c2bd0bb64af0&lt;SEP&gt;chunk-e45947107c74d8a06e350be57a94a408&lt;SEP&gt;chunk-dd58424a14d9942181ba4ca3c1ec81c1&lt;SEP&gt;chunk-bb68daec67dd8f436d82814b0e61ff21&lt;SEP&gt;chunk-fba176235a4410ba8723447134c92579&lt;SEP&gt;chunk-4966a628b12ecec4187796598764cf23&lt;SEP&gt;chunk-d0f15711706bc171fed17a7fab91b4b6&lt;SEP&gt;chunk-a0d4d6b091e033fd01aa721422b68ef5&lt;SEP&gt;chunk-9e8b25c2957355218780bdfd8b72df45&lt;SEP&gt;chunk-725b48dc82aad42ba3dc14f4b5207551&lt;SEP&gt;chunk-a65ba958750476cc543741efe815c7c4</data>
    </node>
    <node id="Bilateral Oophorectomy">
      <data key="d0">Bilateral Oophorectomy</data>
      <data key="d1">event</data>
      <data key="d2">A surgical procedure to remove both ovaries, functioning as a form of surgical endocrine therapy.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408</data>
    </node>
    <node id="Ovarian Ablation">
      <data key="d0">Ovarian Ablation</data>
      <data key="d1">event</data>
      <data key="d2">A medical radiation procedure used to permanently stop the ovaries from producing hormones.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408</data>
    </node>
    <node id="Premenopause">
      <data key="d0">Premenopause</data>
      <data key="d1">category</data>
      <data key="d2">A biological reproductive state characterized by regular menstrual cycles, where the ovaries serve as the primary source of estrogen and progesterone.&lt;SEP&gt;A reproductive biological state in which the ovaries function as the primary source of estrogen and progesterone.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408&lt;SEP&gt;chunk-dd58424a14d9942181ba4ca3c1ec81c1</data>
    </node>
    <node id="Menopause">
      <data key="d0">Menopause</data>
      <data key="d1">category</data>
      <data key="d2">A biological life stage and hormonal transition in which menstrual cycles cease, often addressed with hormone replacement therapy.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408</data>
    </node>
    <node id="Amenorrhea">
      <data key="d0">Amenorrhea</data>
      <data key="d1">category</data>
      <data key="d2">A medical condition characterized by the cessation of menstrual periods, which can occur during and after medical treatment.&lt;SEP&gt;A medical condition involving the temporary or permanent cessation of menstrual periods, which can occur as a side effect of cancer treatment.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408&lt;SEP&gt;chunk-dd58424a14d9942181ba4ca3c1ec81c1</data>
    </node>
    <node id="Steroidal Aromatase Inhibitors">
      <data key="d0">Steroidal Aromatase Inhibitors</data>
      <data key="d1">category</data>
      <data key="d2">A subclass of aromatase inhibitor medications, exemplified by exemestane (Aromasin), that irreversibly inactivate aromatase enzymes.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408</data>
    </node>
    <node id="Non-Steroidal Aromatase Inhibitors">
      <data key="d0">Non-Steroidal Aromatase Inhibitors</data>
      <data key="d1">category</data>
      <data key="d2">A subclass of aromatase inhibitor medications, including anastrozole and letrozole, that competitively inhibit aromatase enzymes.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408</data>
    </node>
    <node id="Testosterone-Suppressing Therapy">
      <data key="d0">Testosterone-Suppressing Therapy</data>
      <data key="d1">category</data>
      <data key="d2">A category of endocrine therapy used to reduce androgen levels in patients assigned male at birth who continue to produce testosterone.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408</data>
    </node>
    <node id="HER2-Negative Breast Cancer">
      <data key="d0">HER2-Negative Breast Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A subtype of breast cancer that does not overexpress the HER2 protein, specified as a requirement for PARP inhibitor treatment.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408</data>
    </node>
    <node id="Secondary CNS Lymphoma">
      <data key="d0">Secondary CNS Lymphoma</data>
      <data key="d1">category</data>
      <data key="d2">A category of lymphoma that starts in another part of the body and subsequently spreads to the brain or spinal cord.</data>
      <data key="d3">chunk-dd58424a14d9942181ba4ca3c1ec81c1</data>
    </node>
    <node id="Immunodeficiency Disorder">
      <data key="d0">Immunodeficiency Disorder</data>
      <data key="d1">category</data>
      <data key="d2">A classification of illnesses that weaken the immune system's capacity to fight infections and diseases, acting as a risk factor for primary CNS lymphoma.</data>
      <data key="d3">chunk-dd58424a14d9942181ba4ca3c1ec81c1</data>
    </node>
    <node id="HIV">
      <data key="d0">HIV</data>
      <data key="d1">category</data>
      <data key="d2">A viral pathogen category that causes AIDS and weakens the immune system, frequently linked to primary CNS lymphoma.&lt;SEP&gt;Human immunodeficiency virus, an infection that significantly elevates an individual's risk of developing anal cancer.&lt;SEP&gt;Human immunodeficiency virus, identified as a risk factor contributing to the development of anal cancer.</data>
      <data key="d3">chunk-b0bad5ee25cb854c10bdbc9d33b54a1a&lt;SEP&gt;chunk-a18089523f6dcd63cfa5664dc1c01618&lt;SEP&gt;chunk-dd58424a14d9942181ba4ca3c1ec81c1</data>
    </node>
    <node id="Epstein-Barr Virus">
      <data key="d0">Epstein-Barr Virus</data>
      <data key="d1">category</data>
      <data key="d2">A common human virus category that causes mononucleosis and remains dormant in the body, recognized as a risk factor for primary CNS lymphoma.&lt;SEP&gt;A viral pathogen whose DNA testing is utilized as needed during evaluation and treatment planning for nasopharyngeal carcinoma.&lt;SEP&gt;Epstein-Barr virus (EBV) is a biological marker whose presence in the blood or lymph nodes is factored into prognostic staging for nasopharyngeal cancer.&lt;SEP&gt;Epstein-Barr virus (EBV) is a viral pathogen whose presence in neck lymph nodes is used to identify early-stage T0 nasopharyngeal tumors.</data>
      <data key="d3">chunk-711bee9440e11d7c737bc4a49b880910&lt;SEP&gt;chunk-3f05c8ea6f7c7b4ba1fb0ff1c1733980&lt;SEP&gt;chunk-d249262ff9e7e657de99a30199159cdf&lt;SEP&gt;chunk-dd58424a14d9942181ba4ca3c1ec81c1</data>
    </node>
    <node id="Autoimmune Disease">
      <data key="d0">Autoimmune Disease</data>
      <data key="d1">category</data>
      <data key="d2">A category of diseases in which the immune system overreacts and attacks healthy tissues and organs.</data>
      <data key="d3">chunk-dd58424a14d9942181ba4ca3c1ec81c1</data>
    </node>
    <node id="Organ Transplant">
      <data key="d0">Organ Transplant</data>
      <data key="d1">event</data>
      <data key="d2">A major medical and surgical procedure that necessitates immunosuppressive medications, resulting in increased risk of infections and cancers such as primary CNS lymphoma.</data>
      <data key="d3">chunk-dd58424a14d9942181ba4ca3c1ec81c1</data>
    </node>
    <node id="Older Adults">
      <data key="d0">Older Adults</data>
      <data key="d1">category</data>
      <data key="d2">A demographic age category, primarily individuals in their 60s and 70s, representing the age group most frequently diagnosed with primary CNS lymphoma.</data>
      <data key="d3">chunk-dd58424a14d9942181ba4ca3c1ec81c1</data>
    </node>
    <node id="Brain Tumor">
      <data key="d0">Brain Tumor</data>
      <data key="d1">category</data>
      <data key="d2">A broad classification of abnormal cell growths occurring in the brain or central nervous system, which can be benign or malignant.&lt;SEP&gt;A broad clinical classification of abnormal growths located in the brain, which can include primary CNS lymphoma.&lt;SEP&gt;A broad disease category referring to intracranial neoplasms, of which gliomas are a specific type.&lt;SEP&gt;An abnormal growth of cells within the brain that can cause intracranial pressure, physical weakness, cognitive issues, and mood changes.</data>
      <data key="d3">chunk-da0bfe00946dcdff3a8a6fb3d73ce6e1&lt;SEP&gt;chunk-c77e0d4642a374a51f87e7e25b19281f&lt;SEP&gt;chunk-49c7ff3a71e74b3f0eb59258541e739e&lt;SEP&gt;chunk-dd58424a14d9942181ba4ca3c1ec81c1</data>
    </node>
    <node id="Central Nervous System">
      <data key="d0">Central Nervous System</data>
      <data key="d1">category</data>
      <data key="d2">The anatomical system comprising the brain and spinal cord, identified in pathology reports as the origin of primary gliomas.&lt;SEP&gt;The anatomical system comprising the brain and spinal cord, which is the primary site of origin and spread for primary CNS lymphoma.&lt;SEP&gt;The biological body system consisting of the brain and spinal cord that receives sensory input, processes information, and controls bodily actions.</data>
      <data key="d3">chunk-ffc3446f8ec092af24a460bda94f772f&lt;SEP&gt;chunk-a0d4d6b091e033fd01aa721422b68ef5&lt;SEP&gt;chunk-dd58424a14d9942181ba4ca3c1ec81c1</data>
    </node>
    <node id="Immune System">
      <data key="d0">Immune System</data>
      <data key="d1">category</data>
      <data key="d2">The biological defense network that protects the human body from infection, disease, and abnormal cellular growths.</data>
      <data key="d3">chunk-dd58424a14d9942181ba4ca3c1ec81c1</data>
    </node>
    <node id="AIDS">
      <data key="d0">AIDS</data>
      <data key="d1">category</data>
      <data key="d2">Acquired immunodeficiency syndrome is an advanced disease state that severely compromises the immune system, raising the risk of HPV persistence and cervical cancer.&lt;SEP&gt;Acquired immunodeficiency syndrome, an advanced immune deficiency state caused by the HIV virus.</data>
      <data key="d3">chunk-b4d036ee5fd77783b9e7ddef3a8477ae&lt;SEP&gt;chunk-dd58424a14d9942181ba4ca3c1ec81c1</data>
    </node>
    <node id="Mononucleosis">
      <data key="d0">Mononucleosis</data>
      <data key="d1">category</data>
      <data key="d2">An infectious illness caused by infection with the Epstein-Barr virus, commonly referred to as mono.</data>
      <data key="d3">chunk-dd58424a14d9942181ba4ca3c1ec81c1</data>
    </node>
    <node id="Stem Cell Transplant">
      <data key="d0">Stem Cell Transplant</data>
      <data key="d1">category</data>
      <data key="d2">An intensive medical procedure utilized as a treatment option for patients diagnosed with primary CNS lymphoma.</data>
      <data key="d3">chunk-4966a628b12ecec4187796598764cf23</data>
    </node>
    <node id="Neurological Exam">
      <data key="d0">Neurological Exam</data>
      <data key="d1">event</data>
      <data key="d2">A clinical diagnostic examination used to evaluate brain function, nerve responses, and sensory or motor coordination in suspected primary CNS lymphoma.&lt;SEP&gt;A clinical examination involving tests of alertness, thinking, balance, coordination, reflexes, strength, hearing, touch, and smell to evaluate brain function.&lt;SEP&gt;A neurological exam is a clinical evaluation of a patient's alertness, balance, reflexes, coordination, senses, and nerve health during the diagnosis of CNS conditions.</data>
      <data key="d3">chunk-a0d4d6b091e033fd01aa721422b68ef5&lt;SEP&gt;chunk-4966a628b12ecec4187796598764cf23&lt;SEP&gt;chunk-49c7ff3a71e74b3f0eb59258541e739e</data>
    </node>
    <node id="Eye Exam">
      <data key="d0">Eye Exam</data>
      <data key="d1">event</data>
      <data key="d2">A diagnostic procedure performed alongside a neurological examination to check the health and condition of the nerves at the back of the eyes.&lt;SEP&gt;A diagnostic test conducted to evaluate the health of the nerves at the back of the eye during a neurological assessment.&lt;SEP&gt;A specialized diagnostic examination performed by an eye specialist using a slit lamp to inspect the retina, optic nerve, and vitreous for lymphoma involvement.&lt;SEP&gt;A specialized ophthalmologic examination used to detect lymphoma involvement or vision changes within ocular structures.&lt;SEP&gt;An ophthalmic assessment recommended prior to starting treatment for specific conditions like nasopharyngeal cancer.</data>
      <data key="d3">chunk-052101b592e186cce702983d2acc67e4&lt;SEP&gt;chunk-49c7ff3a71e74b3f0eb59258541e739e&lt;SEP&gt;chunk-fba176235a4410ba8723447134c92579&lt;SEP&gt;chunk-4966a628b12ecec4187796598764cf23&lt;SEP&gt;chunk-a0d4d6b091e033fd01aa721422b68ef5</data>
    </node>
    <node id="Impaired Immune System">
      <data key="d0">Impaired Immune System</data>
      <data key="d1">category</data>
      <data key="d2">A medical condition characterized by a compromised or weakened immune response, serving as a primary risk factor for developing primary CNS lymphoma.</data>
      <data key="d3">chunk-4966a628b12ecec4187796598764cf23</data>
    </node>
    <node id="Remission">
      <data key="d0">Remission</data>
      <data key="d1">category</data>
      <data key="d2">A clinical disease state in which symptoms and signs of cancer disappear following successful therapeutic intervention.</data>
      <data key="d3">chunk-4966a628b12ecec4187796598764cf23</data>
    </node>
    <node id="Relapse">
      <data key="d0">Relapse</data>
      <data key="d1">category</data>
      <data key="d2">The recurrence of primary CNS lymphoma following initial rounds of treatment, representing a key scenario where stem cell rescue is evaluated.&lt;SEP&gt;The recurrence of primary CNS lymphoma in the brain, spinal cord, or eye after a period of remission.</data>
      <data key="d3">chunk-4966a628b12ecec4187796598764cf23&lt;SEP&gt;chunk-a65ba958750476cc543741efe815c7c4</data>
    </node>
    <node id="Specialized Treatment Center">
      <data key="d0">Specialized Treatment Center</data>
      <data key="d1">organization</data>
      <data key="d2">Medical centers and hospitals with specialized expertise and clinical experience in diagnosing and treating lymphomas of the brain.</data>
      <data key="d3">chunk-4966a628b12ecec4187796598764cf23</data>
    </node>
    <node id="Stephanie E. Weiss">
      <data key="d0">Stephanie E. Weiss</data>
      <data key="d1">person</data>
      <data key="d2">Stephanie E. Weiss, MD, FASTRO, is a medical doctor and radiation oncology specialist associated with imaging documentation of primary CNS lymphoma.&lt;SEP&gt;Stephanie E. Weiss, MD, FASTRO, is a medical specialist who contributed diagnostic imaging for the clinical publication.</data>
      <data key="d3">chunk-a0d4d6b091e033fd01aa721422b68ef5&lt;SEP&gt;chunk-fba176235a4410ba8723447134c92579</data>
    </node>
    <node id="Brain Cancer">
      <data key="d0">Brain Cancer</data>
      <data key="d1">category</data>
      <data key="d2">Brain cancer refers to malignancies affecting brain tissue, which can present clinical signs and symptoms similar to primary CNS lymphoma.</data>
      <data key="d3">chunk-a0d4d6b091e033fd01aa721422b68ef5</data>
    </node>
    <node id="Magnetic Resonance Imaging">
      <data key="d0">Magnetic Resonance Imaging</data>
      <data key="d1">category</data>
      <data key="d2">A diagnostic imaging technique that can be combined with PET scans to assess the extent of cancer.&lt;SEP&gt;An imaging technique utilizing magnetic fields and radio waves, without radiation, to produce detailed images of soft tissue and pelvic structures.&lt;SEP&gt;Magnetic resonance imaging (MRI) is a diagnostic imaging category used in specific colon cancer scenarios, such as examining the liver or rectum, or clarifying CT findings.&lt;SEP&gt;Magnetic resonance imaging (MRI) is the primary non-invasive diagnostic imaging method using magnetic fields and radio waves to visualize soft tissues and tumors in the brain and spine.</data>
      <data key="d3">chunk-ee254e84e63bd35682ed56c41cef9247&lt;SEP&gt;chunk-a0d4d6b091e033fd01aa721422b68ef5&lt;SEP&gt;chunk-a18089523f6dcd63cfa5664dc1c01618&lt;SEP&gt;chunk-27b3a0f53b4be1d525497f87555d7a06</data>
    </node>
    <node id="Computed Tomography">
      <data key="d0">Computed Tomography</data>
      <data key="d1">category</data>
      <data key="d2">An imaging procedure using x-rays and computer processing, often administered with contrast agents, to examine the pelvis, chest, and abdomen for cancer spread.&lt;SEP&gt;An imaging scan using x-rays and computer processing to create detailed 3-D images of the chest, abdomen, or pelvis.&lt;SEP&gt;An x-ray imaging modality (CT) combined with a contrast agent to produce detailed cross-sectional views of the chest, abdomen, and pelvis to detect cancer spread.&lt;SEP&gt;Computed tomography (CT) is a primary category of diagnostic medical imaging used to evaluate the presence and extent of colon cancer in the body.&lt;SEP&gt;Computed tomography (CT) is an X-ray imaging procedure that generates cross-sectional 3D images of the body, utilized as an alternative when MRI is unavailable.</data>
      <data key="d3">chunk-27b3a0f53b4be1d525497f87555d7a06&lt;SEP&gt;chunk-fba176235a4410ba8723447134c92579&lt;SEP&gt;chunk-ee254e84e63bd35682ed56c41cef9247&lt;SEP&gt;chunk-a0d4d6b091e033fd01aa721422b68ef5&lt;SEP&gt;chunk-a18089523f6dcd63cfa5664dc1c01618</data>
    </node>
    <node id="Stereotactic Biopsy">
      <data key="d0">Stereotactic Biopsy</data>
      <data key="d1">event</data>
      <data key="d2">A highly precise surgical procedure using a frame or markers and a hollow needle to extract tissue from hard-to-reach or vital brain areas.&lt;SEP&gt;A stereotactic biopsy is a specialized diagnostic surgical procedure in which a needle is guided into the brain to extract tumor tissue for pathological testing.&lt;SEP&gt;A stereotactic biopsy is an image-guided surgical procedure performed by a neurosurgeon to extract tumor tissue from vital brain areas for definitive histological diagnosis.&lt;SEP&gt;A surgical diagnostic procedure performed by a neurosurgeon using imaging navigation and a thin hollow needle to obtain a small brain tumor sample.&lt;SEP&gt;The standard diagnostic biopsy procedure for primary CNS lymphoma, utilizing precision targeting to extract tumor samples from deep or vital brain regions.</data>
      <data key="d3">chunk-ffc3446f8ec092af24a460bda94f772f&lt;SEP&gt;chunk-49c7ff3a71e74b3f0eb59258541e739e&lt;SEP&gt;chunk-fba176235a4410ba8723447134c92579&lt;SEP&gt;chunk-d0f15711706bc171fed17a7fab91b4b6&lt;SEP&gt;chunk-a0d4d6b091e033fd01aa721422b68ef5</data>
    </node>
    <node id="Gadolinium">
      <data key="d0">Gadolinium</data>
      <data key="d1">category</data>
      <data key="d2">Gadolinium is an intravenous contrast agent used in MRI scans to highlight blood vessels, organs, and tumor tissues in primary CNS lymphoma.</data>
      <data key="d3">chunk-a0d4d6b091e033fd01aa721422b68ef5</data>
    </node>
    <node id="Neurological Illnesses">
      <data key="d0">Neurological Illnesses</data>
      <data key="d1">category</data>
      <data key="d2">Medical conditions of the nervous system that share overlapping symptoms and clinical signs with primary CNS lymphoma.</data>
      <data key="d3">chunk-a0d4d6b091e033fd01aa721422b68ef5</data>
    </node>
    <node id="Physical Examination">
      <data key="d0">Physical Examination</data>
      <data key="d1">event</data>
      <data key="d2">A clinical evaluation assessing vital signs, body organs, lymph nodes, and head and neck structures to inform diagnosis and treatment planning.&lt;SEP&gt;An initial general medical evaluation conducted by clinicians before specialized diagnostic imaging and biopsy procedures.</data>
      <data key="d3">chunk-711bee9440e11d7c737bc4a49b880910&lt;SEP&gt;chunk-a0d4d6b091e033fd01aa721422b68ef5</data>
    </node>
    <node id="Neurosurgeon">
      <data key="d0">Neurosurgeon</data>
      <data key="d1">person</data>
      <data key="d2">A medical specialist who performs surgical procedures on the brain, including stereotactic biopsies, open biopsies, and tumor resections.&lt;SEP&gt;A surgical specialist who performs brain surgeries, including resections and stereotactic biopsies.&lt;SEP&gt;A surgical specialist who performs stereotactic brain biopsies using image-guided navigation systems.</data>
      <data key="d3">chunk-ffc3446f8ec092af24a460bda94f772f&lt;SEP&gt;chunk-a0d4d6b091e033fd01aa721422b68ef5&lt;SEP&gt;chunk-49c7ff3a71e74b3f0eb59258541e739e</data>
    </node>
    <node id="Vitreoretinal Lymphoma">
      <data key="d0">Vitreoretinal Lymphoma</data>
      <data key="d1">category</data>
      <data key="d2">Vitreoretinal lymphoma is a manifestation of primary CNS lymphoma that affects the vitreous and retina within the eyes.</data>
      <data key="d3">chunk-fba176235a4410ba8723447134c92579</data>
    </node>
    <node id="Vitrectomy">
      <data key="d0">Vitrectomy</data>
      <data key="d1">category</data>
      <data key="d2">A vitrectomy is a procedure where a needle removes a small sample of the eye's vitreous gel for diagnostic testing and cancer confirmation.</data>
      <data key="d3">chunk-fba176235a4410ba8723447134c92579</data>
    </node>
    <node id="Ophthalmologist">
      <data key="d0">Ophthalmologist</data>
      <data key="d1">category</data>
      <data key="d2">A medical eye doctor who performs comprehensive eye examinations and vitrectomies to assess and detect ocular lymphoma involvement.</data>
      <data key="d3">chunk-fba176235a4410ba8723447134c92579</data>
    </node>
    <node id="Positron Emission Tomography">
      <data key="d0">Positron Emission Tomography</data>
      <data key="d1">event</data>
      <data key="d2">An advanced imaging modality (PET) that uses an injected radioactive drug to detect metabolically active cancer cells throughout the body.&lt;SEP&gt;An imaging procedure involving radioactive glucose injection to detect metabolically active cancer cells, often combined with CT or MRI.&lt;SEP&gt;An imaging test utilizing a radioactive sugar tracer to detect actively metabolizing cancer cells in the body.</data>
      <data key="d3">chunk-a18089523f6dcd63cfa5664dc1c01618&lt;SEP&gt;chunk-fba176235a4410ba8723447134c92579&lt;SEP&gt;chunk-27b3a0f53b4be1d525497f87555d7a06</data>
    </node>
    <node id="Testicular Ultrasound">
      <data key="d0">Testicular Ultrasound</data>
      <data key="d1">category</data>
      <data key="d2">An ultrasound imaging procedure used to evaluate whether lymphoma has spread to the testicles.</data>
      <data key="d3">chunk-fba176235a4410ba8723447134c92579</data>
    </node>
    <node id="NCCN Guidelines For Patients">
      <data key="d0">NCCN Guidelines For Patients</data>
      <data key="d1">category</data>
      <data key="d2">Educational and clinical practice materials published by NCCN to guide cancer patients through disease management.&lt;SEP&gt;Patient-oriented clinical practice guidelines developed by the National Comprehensive Cancer Network to provide educational guidance regarding cancer diagnosis and treatment.</data>
      <data key="d3">chunk-0d4cea71149e0e4157126efdaa0ea3e3&lt;SEP&gt;chunk-fba176235a4410ba8723447134c92579</data>
    </node>
    <node id="HIV Blood Test">
      <data key="d0">HIV Blood Test</data>
      <data key="d1">category</data>
      <data key="d2">A recommended diagnostic test for individuals diagnosed with primary CNS lymphoma to determine the need for concurrent antiretroviral therapy.</data>
      <data key="d3">chunk-d0f15711706bc171fed17a7fab91b4b6</data>
    </node>
    <node id="Hepatitis B Testing">
      <data key="d0">Hepatitis B Testing</data>
      <data key="d1">category</data>
      <data key="d2">A blood screening required prior to immunotherapy to prevent the potential reactivation of the hepatitis B virus.</data>
      <data key="d3">chunk-d0f15711706bc171fed17a7fab91b4b6</data>
    </node>
    <node id="Stem Cell Rescue">
      <data key="d0">Stem Cell Rescue</data>
      <data key="d1">category</data>
      <data key="d2">A medical intervention often requiring high-dose chemotherapy as an essential preparatory component for treating certain cancers.&lt;SEP&gt;A medical procedure involving the harvesting, freezing, and reinfusion of a patient's stem cells following high-dose chemotherapy to restore healthy blood-forming cells in bone marrow.&lt;SEP&gt;An intensive medical procedure, also known as hematopoietic stem cell transplant, consisting of stem cell harvesting, high-dose chemotherapy, and stem cell reinfusion to restore bone marrow.&lt;SEP&gt;An intensive medical treatment category often paired with chemotherapy to restore blood-forming cells in lymphoma treatment.</data>
      <data key="d3">chunk-a65ba958750476cc543741efe815c7c4&lt;SEP&gt;chunk-9e8b25c2957355218780bdfd8b72df45&lt;SEP&gt;chunk-725b48dc82aad42ba3dc14f4b5207551&lt;SEP&gt;chunk-d0f15711706bc171fed17a7fab91b4b6</data>
    </node>
    <node id="Psychological Distress">
      <data key="d0">Psychological Distress</data>
      <data key="d1">category</data>
      <data key="d2">A mental health condition encompassing depression and anxiety commonly experienced by individuals diagnosed with brain tumors.</data>
      <data key="d3">chunk-d0f15711706bc171fed17a7fab91b4b6</data>
    </node>
    <node id="Ultrasound Of The Testicles">
      <data key="d0">Ultrasound Of The Testicles</data>
      <data key="d1">category</data>
      <data key="d2">A post-diagnosis imaging examination used to detect potential lymphoma spread to the testicles if whole-body PET/CT findings warrant it.</data>
      <data key="d3">chunk-d0f15711706bc171fed17a7fab91b4b6</data>
    </node>
    <node id="Eye Examination">
      <data key="d0">Eye Examination</data>
      <data key="d1">category</data>
      <data key="d2">A thorough diagnostic evaluation recommended for all individuals diagnosed with primary CNS lymphoma to check for ocular lymphoma involvement.</data>
      <data key="d3">chunk-d0f15711706bc171fed17a7fab91b4b6</data>
    </node>
    <node id="Antiretroviral Therapy">
      <data key="d0">Antiretroviral Therapy</data>
      <data key="d1">category</data>
      <data key="d2">Specialized pharmacological therapy required for individuals diagnosed with both primary CNS lymphoma and HIV alongside cancer treatment.</data>
      <data key="d3">chunk-d0f15711706bc171fed17a7fab91b4b6</data>
    </node>
    <node id="Clinical Depression">
      <data key="d0">Clinical Depression</data>
      <data key="d1">category</data>
      <data key="d2">A psychiatric mood disorder affecting approximately one in three patients diagnosed with primary brain tumors.</data>
      <data key="d3">chunk-d0f15711706bc171fed17a7fab91b4b6</data>
    </node>
    <node id="Informed Consent">
      <data key="d0">Informed Consent</data>
      <data key="d1">event</data>
      <data key="d2">A formal process and signed agreement wherein clinical trial participants are detailed on study objectives, risks, benefits, and rights prior to enrolling.&lt;SEP&gt;A formal process and voluntary agreement in which trial participants are fully informed about study procedures, risks, and benefits before enrolling.</data>
      <data key="d3">chunk-725b48dc82aad42ba3dc14f4b5207551&lt;SEP&gt;chunk-541f1323a24c5990b4a6408e0c5442ab</data>
    </node>
    <node id="Placebo">
      <data key="d0">Placebo</data>
      <data key="d1">category</data>
      <data key="d2">An inactive substance used in clinical trials, almost never administered alone in cancer trials but sometimes paired with standard therapies.&lt;SEP&gt;An inactive substance used in clinical trials, rarely administered alone in cancer trials, often coupled with standard therapies.</data>
      <data key="d3">chunk-cd2be7a2ce722f07b19c80e6e1690a8e&lt;SEP&gt;chunk-725b48dc82aad42ba3dc14f4b5207551</data>
    </node>
    <node id="Intraocular Chemotherapy">
      <data key="d0">Intraocular Chemotherapy</data>
      <data key="d1">category</data>
      <data key="d2">A chemotherapy treatment category delivered directly into the eye or via a vein to address primary CNS lymphoma affecting the eyes.</data>
      <data key="d3">chunk-8fbedfa2d88a7b3852f4c2bd0bb64af0</data>
    </node>
    <node id="High-Dose Methotrexate">
      <data key="d0">High-Dose Methotrexate</data>
      <data key="d1">category</data>
      <data key="d2">The primary chemotherapy drug category used to treat primary CNS lymphoma, requiring hospitalization and supportive care due to potential organ toxicity.</data>
      <data key="d3">chunk-8fbedfa2d88a7b3852f4c2bd0bb64af0</data>
    </node>
    <node id="Whole-Brain Radiation Therapy">
      <data key="d0">Whole-Brain Radiation Therapy</data>
      <data key="d1">category</data>
      <data key="d2">A radiation therapy technique that targets the entire brain to treat multiple lesions and microscopic tumors associated with primary CNS lymphoma.&lt;SEP&gt;The most frequently employed radiation treatment technique for patients with primary CNS lymphoma.</data>
      <data key="d3">chunk-8fbedfa2d88a7b3852f4c2bd0bb64af0&lt;SEP&gt;chunk-9e8b25c2957355218780bdfd8b72df45</data>
    </node>
    <node id="Eye Surgeon">
      <data key="d0">Eye Surgeon</data>
      <data key="d1">person</data>
      <data key="d2">A medical specialist who performs surgical procedures to treat eye complications, such as cataracts resulting from intraocular chemotherapy.&lt;SEP&gt;A medical surgical specialist who performs routine operations to repair vision problems such as radiation-induced cataracts.</data>
      <data key="d3">chunk-8fbedfa2d88a7b3852f4c2bd0bb64af0&lt;SEP&gt;chunk-a65ba958750476cc543741efe815c7c4</data>
    </node>
    <node id="Induction Phase">
      <data key="d0">Induction Phase</data>
      <data key="d1">event</data>
      <data key="d2">The initial phase of cancer treatment aimed at destroying the main tumor burden, often utilizing chemotherapy or radiation therapy.&lt;SEP&gt;The initial phase of cancer treatment for primary CNS lymphoma designed to wipe out lymphoma cells, often lasting several months and utilizing high-dose chemotherapy.</data>
      <data key="d3">chunk-8fbedfa2d88a7b3852f4c2bd0bb64af0&lt;SEP&gt;chunk-bb68daec67dd8f436d82814b0e61ff21</data>
    </node>
    <node id="Consolidation Phase">
      <data key="d0">Consolidation Phase</data>
      <data key="d1">event</data>
      <data key="d2">The second phase of cancer treatment for primary CNS lymphoma designed to eliminate any remaining cancer cells and prevent recurrence.&lt;SEP&gt;The secondary phase of cancer therapy administered to eliminate leftover cancer cells following initial induction treatment.</data>
      <data key="d3">chunk-8fbedfa2d88a7b3852f4c2bd0bb64af0&lt;SEP&gt;chunk-bb68daec67dd8f436d82814b0e61ff21</data>
    </node>
    <node id="Ocular Radiation Therapy">
      <data key="d0">Ocular Radiation Therapy</data>
      <data key="d1">category</data>
      <data key="d2">A targeted radiation treatment modality focused specifically on the eyes or expanded via WBRT to treat primary CNS lymphoma affecting ocular structures.</data>
      <data key="d3">chunk-8fbedfa2d88a7b3852f4c2bd0bb64af0</data>
    </node>
    <node id="Cataracts">
      <data key="d0">Cataracts</data>
      <data key="d1">category</data>
      <data key="d2">An ocular medical condition and potential adverse side effect of intraocular chemotherapy, characterized by clouding of the eye lens that can be treated surgically.&lt;SEP&gt;An ocular medical condition that impairs vision, which can be caused as a complication of radiation therapy to the eyes.</data>
      <data key="d3">chunk-8fbedfa2d88a7b3852f4c2bd0bb64af0&lt;SEP&gt;chunk-a65ba958750476cc543741efe815c7c4</data>
    </node>
    <node id="Chemotherapy Cycle">
      <data key="d0">Chemotherapy Cycle</data>
      <data key="d1">category</data>
      <data key="d2">A structured treatment schedule—commonly lasting 14, 21, or 28 days—alternating medication administration with rest periods to allow bodily recovery.</data>
      <data key="d3">chunk-8fbedfa2d88a7b3852f4c2bd0bb64af0</data>
    </node>
    <node id="WBRT">
      <data key="d0">WBRT</data>
      <data key="d1">category</data>
      <data key="d2">Whole brain radiation therapy, a form of radiation treatment that can be expanded to include the eyes to treat primary CNS lymphoma.</data>
      <data key="d3">chunk-a65ba958750476cc543741efe815c7c4</data>
    </node>
    <node id="Rituximab">
      <data key="d0">Rituximab</data>
      <data key="d1">category</data>
      <data key="d2">A monoclonal antibody immunotherapy medication administered via IV infusion that targets CD20 proteins on cancerous blood cells in primary CNS lymphoma.&lt;SEP&gt;An immunotherapy drug commonly paired with high-dose methotrexate chemotherapy to treat primary central nervous system lymphoma.&lt;SEP&gt;The main immunotherapy agent used in the treatment of primary CNS lymphoma.</data>
      <data key="d3">chunk-bb68daec67dd8f436d82814b0e61ff21&lt;SEP&gt;chunk-9e8b25c2957355218780bdfd8b72df45&lt;SEP&gt;chunk-a65ba958750476cc543741efe815c7c4</data>
    </node>
    <node id="Monoclonal Antibody">
      <data key="d0">Monoclonal Antibody</data>
      <data key="d1">category</data>
      <data key="d2">A type of immunotherapy engineered to hunt and bind to specific surface proteins on cancer cells.</data>
      <data key="d3">chunk-a65ba958750476cc543741efe815c7c4</data>
    </node>
    <node id="CD20">
      <data key="d0">CD20</data>
      <data key="d1">category</data>
      <data key="d2">A specific surface protein found on cancerous blood cells and certain healthy blood cells, targeted by rituximab.</data>
      <data key="d3">chunk-a65ba958750476cc543741efe815c7c4</data>
    </node>
    <node id="High-Dose Chemotherapy">
      <data key="d0">High-Dose Chemotherapy</data>
      <data key="d1">event</data>
      <data key="d2">An aggressive chemotherapy treatment administered during stem cell rescue to eradicate remaining lymphoma cells and existing bone marrow cells.</data>
      <data key="d3">chunk-a65ba958750476cc543741efe815c7c4</data>
    </node>
    <node id="Stem Cell Removal">
      <data key="d0">Stem Cell Removal</data>
      <data key="d1">event</data>
      <data key="d2">The initial procedural stage of a stem cell rescue involving the collection and cryopreservation of healthy stem cells from blood or bone marrow.</data>
      <data key="d3">chunk-a65ba958750476cc543741efe815c7c4</data>
    </node>
    <node id="Stem Cell Replacement">
      <data key="d0">Stem Cell Replacement</data>
      <data key="d1">event</data>
      <data key="d2">The final procedural phase of stem cell rescue where cryopreserved stem cells are thawed and transfused into the patient to restore depleted bone marrow.</data>
      <data key="d3">chunk-a65ba958750476cc543741efe815c7c4</data>
    </node>
    <node id="Induction">
      <data key="d0">Induction</data>
      <data key="d1">category</data>
      <data key="d2">The initial phase of cancer treatment aimed at destroying lymphoma cells and inducing disease remission.</data>
      <data key="d3">chunk-9e8b25c2957355218780bdfd8b72df45</data>
    </node>
    <node id="Consolidation">
      <data key="d0">Consolidation</data>
      <data key="d1">category</data>
      <data key="d2">A subsequent phase of cancer treatment administered after initial induction to eliminate residual disease and maintain long-term remission.</data>
      <data key="d3">chunk-9e8b25c2957355218780bdfd8b72df45</data>
    </node>
    <node id="Integrative Medicine">
      <data key="d0">Integrative Medicine</data>
      <data key="d1">category</data>
      <data key="d2">A complementary healthcare approach provided by hospital facilities to support conventional cancer treatments and enhance patient well-being.</data>
      <data key="d3">chunk-9e8b25c2957355218780bdfd8b72df45</data>
    </node>
    <node id="Multidisciplinary Care">
      <data key="d0">Multidisciplinary Care</data>
      <data key="d1">category</data>
      <data key="d2">A collaborative approach to healthcare involving a team of doctors, medical specialists, and allied health providers working together for patient care.</data>
      <data key="d3">chunk-bb68daec67dd8f436d82814b0e61ff21</data>
    </node>
    <node id="Treatment For The Spine">
      <data key="d0">Treatment For The Spine</data>
      <data key="d1">category</data>
      <data key="d2">A specialized component or phase of central nervous system lymphoma treatment targeted at cancer found in the spine or spinal fluid.</data>
      <data key="d3">chunk-bb68daec67dd8f436d82814b0e61ff21</data>
    </node>
    <node id="Treatment For The Eyes">
      <data key="d0">Treatment For The Eyes</data>
      <data key="d1">category</data>
      <data key="d2">A specific therapeutic phase or consideration in managing central nervous system lymphoma involving ocular manifestations.</data>
      <data key="d3">chunk-bb68daec67dd8f436d82814b0e61ff21</data>
    </node>
    <node id="Blood-Brain Barrier">
      <data key="d0">Blood-Brain Barrier</data>
      <data key="d1">category</data>
      <data key="d2">A protective biological layer surrounding the brain that prevents toxins, pathogens, and certain chemotherapy drugs from entering brain tissue.</data>
      <data key="d3">chunk-bb68daec67dd8f436d82814b0e61ff21</data>
    </node>
    <node id="Temozolomide">
      <data key="d0">Temozolomide</data>
      <data key="d1">category</data>
      <data key="d2">A chemotherapy medication used in combination therapy or as an alternative agent for treating primary CNS lymphoma.</data>
      <data key="d3">chunk-bb68daec67dd8f436d82814b0e61ff21</data>
    </node>
    <node id="Vincristine">
      <data key="d0">Vincristine</data>
      <data key="d1">category</data>
      <data key="d2">A chemotherapy medication that may be included alongside methotrexate and rituximab in induction protocols.</data>
      <data key="d3">chunk-bb68daec67dd8f436d82814b0e61ff21</data>
    </node>
    <node id="Procarbazine">
      <data key="d0">Procarbazine</data>
      <data key="d1">category</data>
      <data key="d2">An oral chemotherapy medication utilized as part of multi-agent induction therapy for primary CNS lymphoma.</data>
      <data key="d3">chunk-bb68daec67dd8f436d82814b0e61ff21</data>
    </node>
    <node id="Ibrutinib">
      <data key="d0">Ibrutinib</data>
      <data key="d1">category</data>
      <data key="d2">A targeted therapy medication considered an alternative induction option for primary CNS lymphoma patients unable to receive methotrexate.</data>
      <data key="d3">chunk-bb68daec67dd8f436d82814b0e61ff21</data>
    </node>
    <node id="Lenalidomide">
      <data key="d0">Lenalidomide</data>
      <data key="d1">category</data>
      <data key="d2">An immunomodulatory medication utilized with or without rituximab as an alternative induction therapy for primary CNS lymphoma.</data>
      <data key="d3">chunk-bb68daec67dd8f436d82814b0e61ff21</data>
    </node>
    <node id="Pemetrexed">
      <data key="d0">Pemetrexed</data>
      <data key="d1">category</data>
      <data key="d2">An antifolate chemotherapy drug used as an alternative induction agent in primary central nervous system lymphoma.</data>
      <data key="d3">chunk-bb68daec67dd8f436d82814b0e61ff21</data>
    </node>
    <node id="Pomalidomide">
      <data key="d0">Pomalidomide</data>
      <data key="d1">category</data>
      <data key="d2">An immunomodulatory therapy medication listed as an alternative induction agent for primary CNS lymphoma.</data>
      <data key="d3">chunk-bb68daec67dd8f436d82814b0e61ff21</data>
    </node>
    <node id="The Colon">
      <data key="d0">The Colon</data>
      <data key="d1">category</data>
      <data key="d2">The primary section of the large intestine where water is absorbed from digested food before stool moves into the rectum.</data>
      <data key="d3">chunk-bb68daec67dd8f436d82814b0e61ff21</data>
    </node>
    <node id="The Rectum">
      <data key="d0">The Rectum</data>
      <data key="d1">category</data>
      <data key="d2">The terminal six inches of the large bowel where stool is held before exiting the body.</data>
      <data key="d3">chunk-bb68daec67dd8f436d82814b0e61ff21</data>
    </node>
    <node id="The Cecum">
      <data key="d0">The Cecum</data>
      <data key="d1">category</data>
      <data key="d2">The anatomical pouch situated at the beginning of the colon, from which the appendix extends.</data>
      <data key="d3">chunk-bb68daec67dd8f436d82814b0e61ff21</data>
    </node>
    <node id="The Appendix">
      <data key="d0">The Appendix</data>
      <data key="d1">category</data>
      <data key="d2">A small, closed, finger-sized tube extending from the cecum.</data>
      <data key="d3">chunk-bb68daec67dd8f436d82814b0e61ff21</data>
    </node>
    <node id="Non-Metastatic Colon Cancer">
      <data key="d0">Non-Metastatic Colon Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A classification of colon cancer that has not spread to distant organs, typically treated with colectomy and potentially chemotherapy.</data>
      <data key="d3">chunk-85e75e869fcfcb7c5431dbcdd532137f</data>
    </node>
    <node id="Metastatic Colon Cancer">
      <data key="d0">Metastatic Colon Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A secondary cancer that originates in the large intestine (colon) and spreads to the liver.&lt;SEP&gt;An advanced classification of colon cancer where the cancer has spread to other organs such as the liver or lungs, requiring systemic and local therapies.</data>
      <data key="d3">chunk-84367cc8f7a94b97b4b66a1ca127c15f&lt;SEP&gt;chunk-85e75e869fcfcb7c5431dbcdd532137f</data>
    </node>
    <node id="Colectomy">
      <data key="d0">Colectomy</data>
      <data key="d1">category</data>
      <data key="d2">A colectomy is a major surgical procedure that removes the cancerous part of the colon along with nearby lymph nodes.&lt;SEP&gt;A surgical procedure involving the resection of all or part of the colon, after which residual microscopic disease may be evaluated.&lt;SEP&gt;A surgical procedure involving the resection of part or all of the colon, commonly used to treat non-metastatic colon cancer.&lt;SEP&gt;A surgical procedure to resect part or all of the colon, which carries potential side effects such as anastomotic leak, bowel obstruction, and hernia.</data>
      <data key="d3">chunk-ee254e84e63bd35682ed56c41cef9247&lt;SEP&gt;chunk-c1c1687a8a20b9c451956cf8bba241cc&lt;SEP&gt;chunk-b5cfcc365cd093374564eb27dcbf5b82&lt;SEP&gt;chunk-85e75e869fcfcb7c5431dbcdd532137f</data>
    </node>
    <node id="CEA Blood Test">
      <data key="d0">CEA Blood Test</data>
      <data key="d1">category</data>
      <data key="d2">A blood test measuring carcinoembryonic antigen levels, utilized to monitor colon cancer presence and recurrence.</data>
      <data key="d3">chunk-85e75e869fcfcb7c5431dbcdd532137f</data>
    </node>
    <node id="Circulating Tumor DNA">
      <data key="d0">Circulating Tumor DNA</data>
      <data key="d1">category</data>
      <data key="d2">A biomarker test category involving tumor-derived DNA fragments circulating in the blood.</data>
      <data key="d3">chunk-85e75e869fcfcb7c5431dbcdd532137f</data>
    </node>
    <node id="Polyps">
      <data key="d0">Polyps</data>
      <data key="d1">category</data>
      <data key="d2">Growths in the colon lining, such as hyperplastic and inflammatory polyps, from which almost all colon cancers originate if left untreated.</data>
      <data key="d3">chunk-85e75e869fcfcb7c5431dbcdd532137f</data>
    </node>
    <node id="Local Therapies">
      <data key="d0">Local Therapies</data>
      <data key="d1">category</data>
      <data key="d2">Targeted medical treatments directed specifically at localized secondary tumors in the liver and lungs in metastatic colon cancer.</data>
      <data key="d3">chunk-85e75e869fcfcb7c5431dbcdd532137f</data>
    </node>
    <node id="Inherited Cancer Syndromes">
      <data key="d0">Inherited Cancer Syndromes</data>
      <data key="d1">category</data>
      <data key="d2">Genetic disorders passed through families, such as Lynch syndrome and familial adenomatous polyposis, which significantly heighten cancer risks.</data>
      <data key="d3">chunk-85e75e869fcfcb7c5431dbcdd532137f</data>
    </node>
    <node id="Diagnostic Colonoscopy">
      <data key="d0">Diagnostic Colonoscopy</data>
      <data key="d1">event</data>
      <data key="d2">A specialized follow-up colon examination performed to thoroughly check the colon and identify other potential areas of cancer.</data>
      <data key="d3">chunk-85e75e869fcfcb7c5431dbcdd532137f</data>
    </node>
    <node id="Colorectal Cancer Survivor">
      <data key="d0">Colorectal Cancer Survivor</data>
      <data key="d1">person</data>
      <data key="d2">An individual diagnosed with colorectal cancer at age 44 whose patient perspective emphasizes advocating for timely care, family history awareness, and self-care.</data>
      <data key="d3">chunk-85e75e869fcfcb7c5431dbcdd532137f</data>
    </node>
    <node id="ctDNA Testing">
      <data key="d0">ctDNA Testing</data>
      <data key="d1">category</data>
      <data key="d2">Circulating tumor DNA (ctDNA) testing, also known as a liquid biopsy, is a category of diagnostic test that identifies tumor DNA fragments released into the bloodstream.</data>
      <data key="d3">chunk-ee254e84e63bd35682ed56c41cef9247</data>
    </node>
    <node id="Carcinoembryonic Antigen Test">
      <data key="d0">Carcinoembryonic Antigen Test</data>
      <data key="d1">category</data>
      <data key="d2">A tumor marker blood test (CEA) used in the baseline diagnostic and evaluative testing of colon cancer patients.</data>
      <data key="d3">chunk-ee254e84e63bd35682ed56c41cef9247</data>
    </node>
    <node id="Pedunculated Polyps">
      <data key="d0">Pedunculated Polyps</data>
      <data key="d1">category</data>
      <data key="d2">A structural classification of colon polyps characterized by a mushroom-like stalk attaching them to the colon wall.</data>
      <data key="d3">chunk-ee254e84e63bd35682ed56c41cef9247</data>
    </node>
    <node id="Sessile Polyps">
      <data key="d0">Sessile Polyps</data>
      <data key="d1">category</data>
      <data key="d2">A flat, broad-based classification of colon polyps that grow directly against the colon lining.</data>
      <data key="d3">chunk-ee254e84e63bd35682ed56c41cef9247</data>
    </node>
    <node id="Non-Metastatic Cancer">
      <data key="d0">Non-Metastatic Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A category of localized colon cancer that has not spread beyond the primary colon region to distant sites.</data>
      <data key="d3">chunk-ee254e84e63bd35682ed56c41cef9247</data>
    </node>
    <node id="The American Joint Committee">
      <data key="d0">The American Joint Committee</data>
      <data key="d1">organization</data>
      <data key="d2">The American Joint Committee is a medical organization referenced in the context of colon cancer staging guidelines and classification.</data>
      <data key="d3">chunk-b5cfcc365cd093374564eb27dcbf5b82</data>
    </node>
    <node id="Colostomy">
      <data key="d0">Colostomy</data>
      <data key="d1">category</data>
      <data key="d2">A colostomy is a surgical procedure that creates an abdominal stoma to divert the flow of stool when reconnecting the colon is unsafe.&lt;SEP&gt;A surgical procedure attaching the bowel to an opening on the abdomen, redirecting stool into an external pouch, often required after anal removal.&lt;SEP&gt;A surgical procedure connecting the colon to an external abdominal stoma to route stool into an ostomy bag, used if the rectum or anus is removed.&lt;SEP&gt;A surgical procedure that creates an opening in the abdominal wall for waste excretion, often required following an abdominoperineal resection.</data>
      <data key="d3">chunk-0d4cea71149e0e4157126efdaa0ea3e3&lt;SEP&gt;chunk-b5cfcc365cd093374564eb27dcbf5b82&lt;SEP&gt;chunk-419f40f64b13b1b2d0fac3cfb9fde92a&lt;SEP&gt;chunk-9d0e32bdc49dbab9c2c953abf363e317</data>
    </node>
    <node id="Invasive Colon Cancer">
      <data key="d0">Invasive Colon Cancer</data>
      <data key="d1">category</data>
      <data key="d2">Invasive colon cancer is a malignancy that grows through the colon wall layers and may spread to lymph nodes or other organs.</data>
      <data key="d3">chunk-b5cfcc365cd093374564eb27dcbf5b82</data>
    </node>
    <node id="Bowel Blockage">
      <data key="d0">Bowel Blockage</data>
      <data key="d1">category</data>
      <data key="d2">A bowel blockage is an obstruction caused when a colon tumor grows large enough to impede the passage of stool and gas.</data>
      <data key="d3">chunk-b5cfcc365cd093374564eb27dcbf5b82</data>
    </node>
    <node id="Anastomotic Leak">
      <data key="d0">Anastomotic Leak</data>
      <data key="d1">category</data>
      <data key="d2">A surgical complication characterized by leakage at the anatomical site where the colon is reconnected after a colectomy.&lt;SEP&gt;An anastomotic leak is a complication of colon resection surgery where fluid leaks from the site where the colon was reconnected.</data>
      <data key="d3">chunk-c1c1687a8a20b9c451956cf8bba241cc&lt;SEP&gt;chunk-b5cfcc365cd093374564eb27dcbf5b82</data>
    </node>
    <node id="One-Stage Colectomy">
      <data key="d0">One-Stage Colectomy</data>
      <data key="d1">event</data>
      <data key="d2">A one-stage colectomy is a surgical intervention that removes the tumor and resolves a bowel blockage in a single operation.</data>
      <data key="d3">chunk-b5cfcc365cd093374564eb27dcbf5b82</data>
    </node>
    <node id="Stent Placement">
      <data key="d0">Stent Placement</data>
      <data key="d1">event</data>
      <data key="d2">Stent placement is a procedure in which a mesh metal tube is inserted to open a blocked colon, permitting stool passage prior to cancer surgery.</data>
      <data key="d3">chunk-b5cfcc365cd093374564eb27dcbf5b82</data>
    </node>
    <node id="Open Colectomy">
      <data key="d0">Open Colectomy</data>
      <data key="d1">event</data>
      <data key="d2">An open colectomy is a surgical method for removing colon tumor tissue through a large abdominal incision.</data>
      <data key="d3">chunk-b5cfcc365cd093374564eb27dcbf5b82</data>
    </node>
    <node id="Minimally Invasive Colectomy">
      <data key="d0">Minimally Invasive Colectomy</data>
      <data key="d1">event</data>
      <data key="d2">A minimally invasive colectomy is a surgical method that uses several small abdominal incisions and specialized tools to excise cancerous colon tissue.</data>
      <data key="d3">chunk-b5cfcc365cd093374564eb27dcbf5b82</data>
    </node>
    <node id="Stage 0 Colon Cancer">
      <data key="d0">Stage 0 Colon Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A stage of colon cancer characterized by abnormal cells located solely on the innermost layer of the colon wall, also known as carcinoma in situ.</data>
      <data key="d3">chunk-c1c1687a8a20b9c451956cf8bba241cc</data>
    </node>
    <node id="Stage 1 Colon Cancer">
      <data key="d0">Stage 1 Colon Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A stage where colon cancer has grown into the second or third layer of the colon wall without spreading to lymph nodes or distant organs.</data>
      <data key="d3">chunk-c1c1687a8a20b9c451956cf8bba241cc</data>
    </node>
    <node id="Stage 2 Colon Cancer">
      <data key="d0">Stage 2 Colon Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A stage where colon cancer has grown into or through the fourth layer of the colon wall without lymph node involvement or distant spread.</data>
      <data key="d3">chunk-c1c1687a8a20b9c451956cf8bba241cc</data>
    </node>
    <node id="Stage 3 Colon Cancer">
      <data key="d0">Stage 3 Colon Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A stage where colon cancer has spread to nearby lymph nodes or produced tumor deposits in fat around the colon.</data>
      <data key="d3">chunk-c1c1687a8a20b9c451956cf8bba241cc</data>
    </node>
    <node id="Stage 4 Colon Cancer">
      <data key="d0">Stage 4 Colon Cancer</data>
      <data key="d1">category</data>
      <data key="d2">An advanced stage where colon cancer has metastasized to distant organs outside the colon, such as the liver or lungs.</data>
      <data key="d3">chunk-c1c1687a8a20b9c451956cf8bba241cc</data>
    </node>
    <node id="dMMR/MSI-H Cancers">
      <data key="d0">dMMR/MSI-H Cancers</data>
      <data key="d1">category</data>
      <data key="d2">A molecular subtype of colon cancer with deficient mismatch repair or high microsatellite instability that is responsive to immune checkpoint inhibitors.</data>
      <data key="d3">chunk-c1c1687a8a20b9c451956cf8bba241cc</data>
    </node>
    <node id="pMMR/MSS Cancers">
      <data key="d0">pMMR/MSS Cancers</data>
      <data key="d1">category</data>
      <data key="d2">A molecular subtype of colon cancer characterized by proficient mismatch repair and microsatellite stability, typically managed with chemotherapy.</data>
      <data key="d3">chunk-c1c1687a8a20b9c451956cf8bba241cc</data>
    </node>
    <node id="Checkpoint Inhibitors">
      <data key="d0">Checkpoint Inhibitors</data>
      <data key="d1">category</data>
      <data key="d2">A class of immunotherapy drugs that enhance the immune system's response to identify and eradicate cancer cells, particularly in dMMR/MSI-H colon cancers.&lt;SEP&gt;A subcategory of immunotherapy drugs that block inhibitory immune mechanisms to empower the immune system to fight cancer.</data>
      <data key="d3">chunk-c1c1687a8a20b9c451956cf8bba241cc&lt;SEP&gt;chunk-48b513355d29308e212a3074ba326b10</data>
    </node>
    <node id="Pembrolizumab (Keytruda)">
      <data key="d0">Pembrolizumab (Keytruda)</data>
      <data key="d1">category</data>
      <data key="d2">An immune checkpoint inhibitor drug recommended for use before colectomy in patients with dMMR/MSI-H colon cancer.</data>
      <data key="d3">chunk-c1c1687a8a20b9c451956cf8bba241cc</data>
    </node>
    <node id="Nivolumab (Opdivo)">
      <data key="d0">Nivolumab (Opdivo)</data>
      <data key="d1">category</data>
      <data key="d2">An immune checkpoint inhibitor medication utilized before surgery for dMMR/MSI-H colon cancer, administered with or without ipilimumab.</data>
      <data key="d3">chunk-c1c1687a8a20b9c451956cf8bba241cc</data>
    </node>
    <node id="Ipilimumab (Yervoy)">
      <data key="d0">Ipilimumab (Yervoy)</data>
      <data key="d1">category</data>
      <data key="d2">An immunotherapy checkpoint inhibitor drug used in combination with nivolumab for treating dMMR/MSI-H colon cancer prior to surgery.</data>
      <data key="d3">chunk-c1c1687a8a20b9c451956cf8bba241cc</data>
    </node>
    <node id="FOLFOX">
      <data key="d0">FOLFOX</data>
      <data key="d1">category</data>
      <data key="d2">A combination chemotherapy regimen consisting of 5-FU, leucovorin, and oxaliplatin recommended as a first-line treatment option for metastatic anal cancer.&lt;SEP&gt;A multi-drug chemotherapy regimen administered over six months, recommended for high-risk stage 2 and all stage 3 colon cancers.</data>
      <data key="d3">chunk-5349eed06f06d7c9bcb541ced69e4664&lt;SEP&gt;chunk-c1c1687a8a20b9c451956cf8bba241cc</data>
    </node>
    <node id="CAPEOX">
      <data key="d0">CAPEOX</data>
      <data key="d1">category</data>
      <data key="d2">A chemotherapy regimen administered over three months, recommended as an adjuvant treatment option for high-risk stage 2 and stage 3 colon cancers.</data>
      <data key="d3">chunk-c1c1687a8a20b9c451956cf8bba241cc</data>
    </node>
    <node id="Capecitabine">
      <data key="d0">Capecitabine</data>
      <data key="d1">category</data>
      <data key="d2">An oral chemotherapy medication prescribed as a single agent or part of combination regimens for treating stage 2 and stage 3 colon cancers.&lt;SEP&gt;An oral chemotherapy medicine taken twice daily on radiation days, which can cause adverse effects like hand-foot syndrome.&lt;SEP&gt;An oral chemotherapy medicine used in combination with mitomycin and radiation to treat anal cancer.</data>
      <data key="d3">chunk-c1c1687a8a20b9c451956cf8bba241cc&lt;SEP&gt;chunk-6236b93e627d54f73f1c8fe341127e67&lt;SEP&gt;chunk-0fdcce851d69aa713ed64ba1895bd5d1</data>
    </node>
    <node id="5-Fluorouracil (5-FU)">
      <data key="d0">5-Fluorouracil (5-FU)</data>
      <data key="d1">category</data>
      <data key="d2">A chemotherapy drug often given with leucovorin as an adjuvant treatment regimen for stage 2 and stage 3 colon cancers.</data>
      <data key="d3">chunk-c1c1687a8a20b9c451956cf8bba241cc</data>
    </node>
    <node id="North Africa">
      <data key="d0">North Africa</data>
      <data key="d1">geo</data>
      <data key="d2">A geographic region identified as having an elevated incidence of nasopharyngeal carcinoma.&lt;SEP&gt;A geographical region in Africa where nasopharyngeal cancer is noted to commonly occur.</data>
      <data key="d3">chunk-711bee9440e11d7c737bc4a49b880910&lt;SEP&gt;chunk-c9383db20cd696688798a193862cb5cc</data>
    </node>
    <node id="Native America">
      <data key="d0">Native America</data>
      <data key="d1">geo</data>
      <data key="d2">A geographic and demographic designation noted for a higher occurrence of nasopharyngeal cancer.&lt;SEP&gt;A region/population group identified with higher occurrences of nasopharyngeal carcinoma.</data>
      <data key="d3">chunk-711bee9440e11d7c737bc4a49b880910&lt;SEP&gt;chunk-c9383db20cd696688798a193862cb5cc</data>
    </node>
    <node id="Nasopharyngeal Carcinoma">
      <data key="d0">Nasopharyngeal Carcinoma</data>
      <data key="d1">category</data>
      <data key="d2">A rare type of head and neck cancer that begins in the nasopharynx, frequently presenting as squamous cell carcinoma.&lt;SEP&gt;A type of cancer affecting the nasopharynx, which connects the nasal cavity to the back of the mouth, categorized under head and neck cancers.&lt;SEP&gt;Nasopharyngeal Carcinoma (NPC) is a type of cancer that originates in the nasopharynx, often evaluated and categorized using the TNM staging system.&lt;SEP&gt;Nasopharyngeal carcinoma (NPC) is a type of cancer arising in the nasopharynx that is staged based on tumor size, lymph node involvement, and distant spread.</data>
      <data key="d3">chunk-711bee9440e11d7c737bc4a49b880910&lt;SEP&gt;chunk-3f05c8ea6f7c7b4ba1fb0ff1c1733980&lt;SEP&gt;chunk-d249262ff9e7e657de99a30199159cdf&lt;SEP&gt;chunk-c9383db20cd696688798a193862cb5cc</data>
    </node>
    <node id="Surveillance Follow-Up Testing">
      <data key="d0">Surveillance Follow-Up Testing</data>
      <data key="d1">event</data>
      <data key="d2">A post-treatment monitoring regimen consisting of periodic physical exams, imaging, and lab tests to detect cancer recurrence early.</data>
      <data key="d3">chunk-c9383db20cd696688798a193862cb5cc</data>
    </node>
    <node id="Cancer Survivors">
      <data key="d0">Cancer Survivors</data>
      <data key="d1">category</data>
      <data key="d2">Individuals who have completed cancer treatment and require ongoing survivorship care and monitoring.</data>
      <data key="d3">chunk-c9383db20cd696688798a193862cb5cc</data>
    </node>
    <node id="Comprehensive Cancer Center">
      <data key="d0">Comprehensive Cancer Center</data>
      <data key="d1">organization</data>
      <data key="d2">A specialized medical facility staffed by experts in evaluating and treating nasopharyngeal carcinoma.</data>
      <data key="d3">chunk-711bee9440e11d7c737bc4a49b880910</data>
    </node>
    <node id="Nasopharyngeal Fiberoptic Exam">
      <data key="d0">Nasopharyngeal Fiberoptic Exam</data>
      <data key="d1">event</data>
      <data key="d2">An endoscopic procedure using a lighted fiberoptic scope to directly inspect the nasopharynx and oropharynx for tumors.</data>
      <data key="d3">chunk-711bee9440e11d7c737bc4a49b880910</data>
    </node>
    <node id="MRI With Contrast">
      <data key="d0">MRI With Contrast</data>
      <data key="d1">event</data>
      <data key="d2">A magnetic resonance imaging scan from collarbone to skull base performed to evaluate tumor extent in nasopharyngeal cancer.</data>
      <data key="d3">chunk-711bee9440e11d7c737bc4a49b880910</data>
    </node>
    <node id="Distant Metastases">
      <data key="d0">Distant Metastases</data>
      <data key="d1">category</data>
      <data key="d2">The spread of cancer cells from the primary nasopharyngeal site to distant organs such as the chest or other body areas.</data>
      <data key="d3">chunk-711bee9440e11d7c737bc4a49b880910</data>
    </node>
    <node id="Mind and Body Therapist">
      <data key="d0">Mind and Body Therapist</data>
      <data key="d1">person</data>
      <data key="d2">A supportive care provider on the treatment team who assists cancer patients with managing emotional distress, anxiety, and depression.</data>
      <data key="d3">chunk-052101b592e186cce702983d2acc67e4</data>
    </node>
    <node id="Nutritionist">
      <data key="d0">Nutritionist</data>
      <data key="d1">person</data>
      <data key="d2">A healthcare specialist who provides targeted dietary and nutritional counseling suited to a patient's medical condition.&lt;SEP&gt;A nutritional professional or dietician who consults with cancer patients to formulate optimal dietary and hydration plans prior to therapy.</data>
      <data key="d3">chunk-dea00cf063e8831db4919330d94b1f2a&lt;SEP&gt;chunk-052101b592e186cce702983d2acc67e4</data>
    </node>
    <node id="Speech and Swallowing Therapist">
      <data key="d0">Speech and Swallowing Therapist</data>
      <data key="d1">person</data>
      <data key="d2">A specialized therapist who evaluates and monitors a patient's capacity to speak and swallow before and after cancer treatment.</data>
      <data key="d3">chunk-052101b592e186cce702983d2acc67e4</data>
    </node>
    <node id="Birth Control">
      <data key="d0">Birth Control</data>
      <data key="d1">category</data>
      <data key="d2">Contraceptive options, including barrier methods and intrauterine devices (IUDs), advised during and after cancer treatment to prevent pregnancy.</data>
      <data key="d3">chunk-052101b592e186cce702983d2acc67e4</data>
    </node>
    <node id="Biopsy of Metastasis">
      <data key="d0">Biopsy of Metastasis</data>
      <data key="d1">category</data>
      <data key="d2">A targeted biopsy procedure performed on suspected areas of cancer spread, such as lymph nodes or the lung, to confirm metastasis.</data>
      <data key="d3">chunk-9ad38c9dc069a8ff8df58c42f00eba23</data>
    </node>
    <node id="Cannabis">
      <data key="d0">Cannabis</data>
      <data key="d1">category</data>
      <data key="d2">A psychoactive substance whose consumption may alter the required dosage of anesthesia during surgical procedures.</data>
      <data key="d3">chunk-9ad38c9dc069a8ff8df58c42f00eba23</data>
    </node>
    <node id="EBV-Related Cancer">
      <data key="d0">EBV-Related Cancer</data>
      <data key="d1">category</data>
      <data key="d2">EBV-related cancer is a disease classification caused by the Epstein-Barr virus, which accounts for the majority of nasopharyngeal cancers.</data>
      <data key="d3">chunk-ea7b3f83164304ee4a562046eb0f5033</data>
    </node>
    <node id="TMB-H">
      <data key="d0">TMB-H</data>
      <data key="d1">category</data>
      <data key="d2">Tumor mutational burden-high is a genomic biomarker classification defined by 10 or more mutations per million base pairs of tumor DNA.</data>
      <data key="d3">chunk-ea7b3f83164304ee4a562046eb0f5033</data>
    </node>
    <node id="HPV-Related Cancer">
      <data key="d0">HPV-Related Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A category of malignant neoplasms caused by human papillomavirus infection, which includes most throat cancers.</data>
      <data key="d3">chunk-ea7b3f83164304ee4a562046eb0f5033</data>
    </node>
    <node id="Tumor HPV Testing">
      <data key="d0">Tumor HPV Testing</data>
      <data key="d1">category</data>
      <data key="d2">A diagnostic procedure performed on tumor tissue to detect human papillomavirus (HPV) infection, commonly used in throat and certain nasopharyngeal cancers.</data>
      <data key="d3">chunk-ea7b3f83164304ee4a562046eb0f5033</data>
    </node>
    <node id="TNM Scores">
      <data key="d0">TNM Scores</data>
      <data key="d1">category</data>
      <data key="d2">A cancer staging metric that scores primary tumor size and extent, regional lymph node involvement, and distant metastasis.</data>
      <data key="d3">chunk-ea7b3f83164304ee4a562046eb0f5033</data>
    </node>
    <node id="Infectious Mononucleosis">
      <data key="d0">Infectious Mononucleosis</data>
      <data key="d1">category</data>
      <data key="d2">A common viral disease caused by the Epstein-Barr virus (EBV), which is also linked to EBV-related cancers.</data>
      <data key="d3">chunk-ea7b3f83164304ee4a562046eb0f5033</data>
    </node>
    <node id="Squamous Cell Carcinoma Of The Nasopharynx">
      <data key="d0">Squamous Cell Carcinoma Of The Nasopharynx</data>
      <data key="d1">category</data>
      <data key="d2">A specific histological subtype of nasopharyngeal carcinoma evaluated using standard TNM staging criteria.</data>
      <data key="d3">chunk-3f05c8ea6f7c7b4ba1fb0ff1c1733980</data>
    </node>
    <node id="Cervical Intraepithelial Neoplasia">
      <data key="d0">Cervical Intraepithelial Neoplasia</data>
      <data key="d1">category</data>
      <data key="d2">Cervical intraepithelial neoplasia (CIN) refers to abnormal cervical cellular changes or dysplasia categorized into grades 1, 2, or 3, which can progress to invasive cancer if untreated.</data>
      <data key="d3">chunk-d249262ff9e7e657de99a30199159cdf</data>
    </node>
    <node id="Low-Grade Squamous Intraepithelial Lesion">
      <data key="d0">Low-Grade Squamous Intraepithelial Lesion</data>
      <data key="d1">category</data>
      <data key="d2">A form of mild anal dysplasia (LSIL) representing abnormal cell growth that may precede anal cancer.&lt;SEP&gt;Low-grade squamous intraepithelial lesion (LSIL) is a classification of mild cervical dysplasia corresponding to CIN 1.</data>
      <data key="d3">chunk-d249262ff9e7e657de99a30199159cdf&lt;SEP&gt;chunk-9530f389987c13273449ab22a85170ae</data>
    </node>
    <node id="High-Grade Squamous Intraepithelial Lesion">
      <data key="d0">High-Grade Squamous Intraepithelial Lesion</data>
      <data key="d1">category</data>
      <data key="d2">High-grade squamous intraepithelial lesion (HSIL) is a clinical classification representing moderate to severe cervical dysplasia (CIN 2 and 3) considered a pre-cancerous condition.&lt;SEP&gt;Moderate to severe anal dysplasia (HSIL) featuring abnormal cellular changes with higher risk of malignant progression.</data>
      <data key="d3">chunk-d249262ff9e7e657de99a30199159cdf&lt;SEP&gt;chunk-9530f389987c13273449ab22a85170ae</data>
    </node>
    <node id="Head and Neck Tumors">
      <data key="d0">Head and Neck Tumors</data>
      <data key="d1">category</data>
      <data key="d2">Head and neck tumors are a broad category of neoplasms measured in centimeters, of which nasopharyngeal carcinoma is a specific type.</data>
      <data key="d3">chunk-d249262ff9e7e657de99a30199159cdf</data>
    </node>
    <node id="Squamous Cell Carcinoma of the Nasopharynx">
      <data key="d0">Squamous Cell Carcinoma of the Nasopharynx</data>
      <data key="d1">category</data>
      <data key="d2">Squamous cell carcinoma of the nasopharynx is a specific histologic subtype of nasopharyngeal cancer evaluated by TNM staging.</data>
      <data key="d3">chunk-d249262ff9e7e657de99a30199159cdf</data>
    </node>
    <node id="Sexually Transmitted Infection">
      <data key="d0">Sexually Transmitted Infection</data>
      <data key="d1">category</data>
      <data key="d2">Infections transmitted through sexual contact; a history of STIs serves as a risk factor for anal cancer.&lt;SEP&gt;Sexually transmitted infections are communicable diseases spread through sexual activity, with HPV being the most prevalent.</data>
      <data key="d3">chunk-d249262ff9e7e657de99a30199159cdf&lt;SEP&gt;chunk-9530f389987c13273449ab22a85170ae</data>
    </node>
    <node id="Pap Smear">
      <data key="d0">Pap Smear</data>
      <data key="d1">category</data>
      <data key="d2">The Pap smear is a preventive diagnostic screening test that detects cervical changes, substantially reducing cervical cancer incidence.</data>
      <data key="d3">chunk-d249262ff9e7e657de99a30199159cdf</data>
    </node>
    <node id="Uterine Sarcomas">
      <data key="d0">Uterine Sarcomas</data>
      <data key="d1">category</data>
      <data key="d2">Uterine sarcomas are rare malignancies forming in the muscle or supportive tissues of the uterus, treated differently from cervical cancer.</data>
      <data key="d3">chunk-d249262ff9e7e657de99a30199159cdf</data>
    </node>
    <node id="Cervical Dysplasia">
      <data key="d0">Cervical Dysplasia</data>
      <data key="d1">category</data>
      <data key="d2">Cervical dysplasia refers to the presence of abnormal cells on the cervical lining, categorized into mild, moderate, or severe cervical intraepithelial neoplasia (CIN).&lt;SEP&gt;Cervical dysplasia represents premalignant cellular abnormalities on the surface of the cervix, categorized into grades 1, 2, or 3.</data>
      <data key="d3">chunk-d249262ff9e7e657de99a30199159cdf&lt;SEP&gt;chunk-b4d036ee5fd77783b9e7ddef3a8477ae</data>
    </node>
    <node id="Childbirth">
      <data key="d0">Childbirth</data>
      <data key="d1">event</data>
      <data key="d2">Childbirth is the physiological event during which the cervix dilates and effaces to allow a baby to move from the uterus through the vagina.</data>
      <data key="d3">chunk-d249262ff9e7e657de99a30199159cdf</data>
    </node>
    <node id="Menstruation">
      <data key="d0">Menstruation</data>
      <data key="d1">event</data>
      <data key="d2">Menstruation is the periodic physiological shedding of uterine tissue and blood that passes through the external os of the cervix into the vagina.</data>
      <data key="d3">chunk-d249262ff9e7e657de99a30199159cdf</data>
    </node>
    <node id="Human Papillomavirus (HPV)">
      <data key="d0">Human Papillomavirus (HPV)</data>
      <data key="d1">category</data>
      <data key="d2">Human papillomavirus is a common sexually transmitted virus with over 100 strains, responsible for causing almost all cervical cancers as well as several other malignancies and genital warts.</data>
      <data key="d3">chunk-b4d036ee5fd77783b9e7ddef3a8477ae</data>
    </node>
    <node id="High-Grade Squamous Intraepithelial Lesion (HSIL)">
      <data key="d0">High-Grade Squamous Intraepithelial Lesion (HSIL)</data>
      <data key="d1">category</data>
      <data key="d2">High-grade squamous intraepithelial lesion refers to moderate or severe dysplasia (CIN 2 and 3) on the cervix and is considered a pre-cancerous condition.</data>
      <data key="d3">chunk-b4d036ee5fd77783b9e7ddef3a8477ae</data>
    </node>
    <node id="Low-Grade Squamous Intraepithelial Lesion (LSIL)">
      <data key="d0">Low-Grade Squamous Intraepithelial Lesion (LSIL)</data>
      <data key="d1">category</data>
      <data key="d2">Low-grade squamous intraepithelial lesion denotes mild cervical dysplasia (CIN 1) characterized by abnormal surface cells.</data>
      <data key="d3">chunk-b4d036ee5fd77783b9e7ddef3a8477ae</data>
    </node>
    <node id="Neuroendocrine Carcinoma of the Cervix (NECC)">
      <data key="d0">Neuroendocrine Carcinoma of the Cervix (NECC)</data>
      <data key="d1">category</data>
      <data key="d2">Neuroendocrine carcinoma of the cervix is the rarest and most aggressive histological subtype of cervical cancer.</data>
      <data key="d3">chunk-b4d036ee5fd77783b9e7ddef3a8477ae</data>
    </node>
    <node id="HPV Vaccine">
      <data key="d0">HPV Vaccine</data>
      <data key="d1">category</data>
      <data key="d2">A preventive vaccine covering nine strains of HPV, recommended for individuals up to age 45 to protect against new infections and HPV-related cancers.&lt;SEP&gt;The HPV vaccine is an immunization that protects against multiple strains of human papillomavirus, preventing new infections and HPV-associated cancers.</data>
      <data key="d3">chunk-b4d036ee5fd77783b9e7ddef3a8477ae&lt;SEP&gt;chunk-9530f389987c13273449ab22a85170ae</data>
    </node>
    <node id="Human Immunodeficiency Virus (HIV)">
      <data key="d0">Human Immunodeficiency Virus (HIV)</data>
      <data key="d1">category</data>
      <data key="d2">Human immunodeficiency virus is a pathogen that causes immune system deficiency, increasing vulnerability to persistent HPV infection and cervical cancer.</data>
      <data key="d3">chunk-b4d036ee5fd77783b9e7ddef3a8477ae</data>
    </node>
    <node id="HPV-16">
      <data key="d0">HPV-16</data>
      <data key="d1">category</data>
      <data key="d2">HPV-16 is one of the highest-risk strains of human papillomavirus linked to the development of cervical cancer and other malignancies.</data>
      <data key="d3">chunk-b4d036ee5fd77783b9e7ddef3a8477ae</data>
    </node>
    <node id="HPV-18">
      <data key="d0">HPV-18</data>
      <data key="d1">category</data>
      <data key="d2">HPV-18 is a high-risk strain of human papillomavirus known to cause cervical cancer and is targeted by specific HPV vaccines.</data>
      <data key="d3">chunk-b4d036ee5fd77783b9e7ddef3a8477ae</data>
    </node>
    <node id="Sexually Transmitted Infection (STI)">
      <data key="d0">Sexually Transmitted Infection (STI)</data>
      <data key="d1">category</data>
      <data key="d2">A broad class of infections passed through sexual contact, of which HPV is noted as an extremely common example.</data>
      <data key="d3">chunk-b4d036ee5fd77783b9e7ddef3a8477ae</data>
    </node>
    <node id="Anal Cancer">
      <data key="d0">Anal Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A form of malignancy located in the anus that is caused by long-term infection with human papillomavirus.&lt;SEP&gt;A malignancy developing in the tissues of the anus, frequently linked to HPV infection and characterized by symptoms such as rectal bleeding, itching, and pain.&lt;SEP&gt;A malignancy of the anal canal, commonly treated with concurrent chemotherapy regimens and radiation therapy.&lt;SEP&gt;A malignancy of the anus discussed in the text, requiring diagnostic testing, staging, and individualized treatment planning.&lt;SEP&gt;A malignancy originating in either the anal canal or the perianal region, most commonly manifesting as squamous cell carcinoma.&lt;SEP&gt;A type of cancer occurring in the anus and anal canal, predominantly caused by human papillomavirus (HPV) infection.&lt;SEP&gt;An uncommon cancer of the digestive system that most frequently originates in the squamous cells of the anal canal or perianal region.&lt;SEP&gt;Anal cancer is a malignancy affecting the anal canal, whose treatments can lead to bowel changes, sexual side effects, and pelvic health complications.&lt;SEP&gt;Anal cancer is a malignancy arising in the anal canal or perianal region, staged from stage 0 (precancer) to stage IV based on tumor size, lymph node involvement, and distant metastasis.&lt;SEP&gt;Anal cancer is a rare type of malignancy affecting the anal canal or perianal area, requiring specialized treatment regimens and follow-up care.&lt;SEP&gt;Anal cancer is a type of cancer arising in the tissues of the anus, forming the central subject of the patient inquiry guide.</data>
      <data key="d3">chunk-f2a44e885faf856aa579d824b3cd85e7&lt;SEP&gt;chunk-6236b93e627d54f73f1c8fe341127e67&lt;SEP&gt;chunk-06384634b72466c480713ee8d57f25ed&lt;SEP&gt;chunk-419f40f64b13b1b2d0fac3cfb9fde92a&lt;SEP&gt;chunk-b0bad5ee25cb854c10bdbc9d33b54a1a&lt;SEP&gt;chunk-0d4cea71149e0e4157126efdaa0ea3e3&lt;SEP&gt;chunk-b4d036ee5fd77783b9e7ddef3a8477ae&lt;SEP&gt;chunk-9530f389987c13273449ab22a85170ae&lt;SEP&gt;chunk-0fdcce851d69aa713ed64ba1895bd5d1&lt;SEP&gt;chunk-cf41d1c08e8df109ad214d831867a5d9&lt;SEP&gt;chunk-44a870810cef881997b741c32ec368fe</data>
    </node>
    <node id="Penile Cancer">
      <data key="d0">Penile Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A malignancy affecting the male genital organs associated with human papillomavirus infection.&lt;SEP&gt;A rare malignancy affecting the penis, identified as one of the cancer types caused by human papillomavirus.&lt;SEP&gt;A type of malignancy occurring on the penis that can be caused by infection with HPV strains.</data>
      <data key="d3">chunk-f2a44e885faf856aa579d824b3cd85e7&lt;SEP&gt;chunk-b4d036ee5fd77783b9e7ddef3a8477ae&lt;SEP&gt;chunk-9530f389987c13273449ab22a85170ae</data>
    </node>
    <node id="Vaginal Cancer">
      <data key="d0">Vaginal Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A form of gynecologic cancer occurring in the vagina, listed among malignancies associated with HPV.&lt;SEP&gt;A gynecological cancer of the vaginal canal etiologically linked to human papillomavirus infection.&lt;SEP&gt;A malignancy linked to HPV infection; a personal history of vaginal cancer elevates the risk of anal cancer.</data>
      <data key="d3">chunk-f2a44e885faf856aa579d824b3cd85e7&lt;SEP&gt;chunk-b4d036ee5fd77783b9e7ddef3a8477ae&lt;SEP&gt;chunk-9530f389987c13273449ab22a85170ae</data>
    </node>
    <node id="Vulvar Cancer">
      <data key="d0">Vulvar Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A gynecologic cancer developing on the external female genitalia, induced by persistent HPV infection.&lt;SEP&gt;A gynecological cancer affecting the external female genitalia that can be caused by human papillomavirus infection.&lt;SEP&gt;An HPV-associated cancer of the external female genitalia; a prior history increases the risk of anal cancer.</data>
      <data key="d3">chunk-f2a44e885faf856aa579d824b3cd85e7&lt;SEP&gt;chunk-b4d036ee5fd77783b9e7ddef3a8477ae&lt;SEP&gt;chunk-9530f389987c13273449ab22a85170ae</data>
    </node>
    <node id="Genital Warts">
      <data key="d0">Genital Warts</data>
      <data key="d1">category</data>
      <data key="d2">Abnormal benign skin growths that form on the anus or genitals as a result of HPV infection.&lt;SEP&gt;Abnormal skin growths that develop on the anus, genitals, or other areas of the body as a result of infection with certain HPV types.</data>
      <data key="d3">chunk-b4d036ee5fd77783b9e7ddef3a8477ae&lt;SEP&gt;chunk-9530f389987c13273449ab22a85170ae</data>
    </node>
    <node id="Cervical Biopsy">
      <data key="d0">Cervical Biopsy</data>
      <data key="d1">event</data>
      <data key="d2">A diagnostic medical procedure that involves removing tissue samples from the ectocervix or endocervical canal to diagnose cervical cancer and pre-cancer.&lt;SEP&gt;A diagnostic procedure wherein tissue samples are removed from the cervix to test for dysplasia and cervical cancer.&lt;SEP&gt;A medical procedure that involves removing small samples of tissue from the cervix to diagnose cervical cancer.</data>
      <data key="d3">chunk-e9a7fe3b15f3289198c7114b44890dea&lt;SEP&gt;chunk-b4d036ee5fd77783b9e7ddef3a8477ae&lt;SEP&gt;chunk-27b3a0f53b4be1d525497f87555d7a06</data>
    </node>
    <node id="Glassy-Cell Carcinoma">
      <data key="d0">Glassy-Cell Carcinoma</data>
      <data key="d1">category</data>
      <data key="d2">A distinct and uncommon histological subtype of cervical cancer noted in diagnostic considerations.</data>
      <data key="d3">chunk-b4d036ee5fd77783b9e7ddef3a8477ae</data>
    </node>
    <node id="Transformation Zone">
      <data key="d0">Transformation Zone</data>
      <data key="d1">category</data>
      <data key="d2">The specific anatomical area on the cervix where the ectocervix meets the endocervix, where most pre-cancers and cervical cancers originate.</data>
      <data key="d3">chunk-b4d036ee5fd77783b9e7ddef3a8477ae</data>
    </node>
    <node id="HIV Specialist">
      <data key="d0">HIV Specialist</data>
      <data key="d1">person</data>
      <data key="d2">A healthcare professional specializing in managing human immunodeficiency virus, to whom HIV-positive cancer patients may be referred.</data>
      <data key="d3">chunk-27b3a0f53b4be1d525497f87555d7a06</data>
    </node>
    <node id="Cone Biopsy">
      <data key="d0">Cone Biopsy</data>
      <data key="d1">event</data>
      <data key="d2">A diagnostic and therapeutic surgical procedure that removes a cone-shaped section of tissue from the cervix to treat or assess early-stage cancer.&lt;SEP&gt;A surgical diagnostic procedure used to excise a cone-shaped wedge of cervical tissue to assess tumor margins and confirm stage 1A cancer.&lt;SEP&gt;A surgical procedure used for diagnosing and excising early-stage cervical cancer tissue, preserving the uterus.&lt;SEP&gt;Also known as cervical conization, a surgical procedure that removes a cone-shaped section of the cervix including the transformation zone for diagnostic and therapeutic purposes.</data>
      <data key="d3">chunk-e9a7fe3b15f3289198c7114b44890dea&lt;SEP&gt;chunk-95c76786e9d6dbf06ddf5d55af0cf658&lt;SEP&gt;chunk-27b3a0f53b4be1d525497f87555d7a06&lt;SEP&gt;chunk-e247ae57c50c62bded7114986471226e</data>
    </node>
    <node id="Cold Knife Conization">
      <data key="d0">Cold Knife Conization</data>
      <data key="d1">event</data>
      <data key="d2">A surgical technique for cone biopsy that utilizes a scalpel to excise cervical tissue.</data>
      <data key="d3">chunk-27b3a0f53b4be1d525497f87555d7a06</data>
    </node>
    <node id="Loop Electrosurgical Excision Procedure">
      <data key="d0">Loop Electrosurgical Excision Procedure</data>
      <data key="d1">event</data>
      <data key="d2">A cone biopsy technique that uses a thin loop of heated, electrified wire to remove cervical tissue.</data>
      <data key="d3">chunk-27b3a0f53b4be1d525497f87555d7a06</data>
    </node>
    <node id="Endocervical Curettage">
      <data key="d0">Endocervical Curettage</data>
      <data key="d1">event</data>
      <data key="d2">A procedure using a curette to scrape a tissue sample from the cervical canal following a cone biopsy.</data>
      <data key="d3">chunk-27b3a0f53b4be1d525497f87555d7a06</data>
    </node>
    <node id="Pelvic Examination">
      <data key="d0">Pelvic Examination</data>
      <data key="d1">event</data>
      <data key="d2">A physical examination to evaluate the size, position, and appearance of the cervix and uterus.</data>
      <data key="d3">chunk-27b3a0f53b4be1d525497f87555d7a06</data>
    </node>
    <node id="Technician">
      <data key="d0">Technician</data>
      <data key="d1">person</data>
      <data key="d2">A medical staff member who operates the imaging equipment and communicates with the patient during a CT scan.</data>
      <data key="d3">chunk-27b3a0f53b4be1d525497f87555d7a06</data>
    </node>
    <node id="HIV Test">
      <data key="d0">HIV Test</data>
      <data key="d1">event</data>
      <data key="d2">A laboratory test recommended to check for human immunodeficiency virus infection before proceeding with cancer care.</data>
      <data key="d3">chunk-27b3a0f53b4be1d525497f87555d7a06</data>
    </node>
    <node id="Pre-Cancer">
      <data key="d0">Pre-Cancer</data>
      <data key="d1">category</data>
      <data key="d2">Abnormal cell changes identified by a pathologist in cervical tissue that have not yet progressed into invasive malignancy.</data>
      <data key="d3">chunk-27b3a0f53b4be1d525497f87555d7a06</data>
    </node>
    <node id="Early-Stage Cervical Cancer">
      <data key="d0">Early-Stage Cervical Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A localized phase of cervical cancer for which cone biopsy may serve as an effective definitive treatment.&lt;SEP&gt;A stage category of cervical cancer (such as stages 1A and small 1B) typically managed with surgical interventions like hysterectomy or cone biopsy.</data>
      <data key="d3">chunk-e247ae57c50c62bded7114986471226e&lt;SEP&gt;chunk-27b3a0f53b4be1d525497f87555d7a06</data>
    </node>
    <node id="Symptoms Of Cervical Cancer">
      <data key="d0">Symptoms Of Cervical Cancer</data>
      <data key="d1">category</data>
      <data key="d2">Clinical indicators such as watery vaginal discharge that prompt medical investigation and history taking.</data>
      <data key="d3">chunk-27b3a0f53b4be1d525497f87555d7a06</data>
    </node>
    <node id="Small Cell Neuroendocrine Carcinoma of the Cervix">
      <data key="d0">Small Cell Neuroendocrine Carcinoma of the Cervix</data>
      <data key="d1">category</data>
      <data key="d2">A rare, specific type of cervical cancer that follows dedicated surveillance protocols post-treatment.&lt;SEP&gt;A specific subtype of cervical cancer (NECC) for which an MRI of the brain is recommended as part of initial testing.</data>
      <data key="d3">chunk-e247ae57c50c62bded7114986471226e&lt;SEP&gt;chunk-be6e1cb2fe11f4d9962741c30d446a69</data>
    </node>
    <node id="Fertility-Sparing Treatment">
      <data key="d0">Fertility-Sparing Treatment</data>
      <data key="d1">category</data>
      <data key="d2">A category of treatment strategies designed to preserve reproductive potential, typically indicated for small, early-stage cancers.&lt;SEP&gt;A therapeutic approach designed to preserve reproductive potential in patients with early-stage cervical cancer limited to the cervix.&lt;SEP&gt;A treatment approach for stage 1 cervical cancers that preserves the uterus and ovaries to allow for natural pregnancy.&lt;SEP&gt;A treatment classification designed to preserve reproductive capability, such as trachelectomy for early-stage cervical cancer.&lt;SEP&gt;Conservative oncologic treatment that preserves reproductive organs, necessitating specialized MRI surveillance post-surgery.</data>
      <data key="d3">chunk-8ec4d44b145ca896ff1216caa90ce5dd&lt;SEP&gt;chunk-b3ba7430f3a31330247f52afe7e9c68a&lt;SEP&gt;chunk-95c76786e9d6dbf06ddf5d55af0cf658&lt;SEP&gt;chunk-e9a7fe3b15f3289198c7114b44890dea&lt;SEP&gt;chunk-be6e1cb2fe11f4d9962741c30d446a69</data>
    </node>
    <node id="Reproductive Endocrinologist">
      <data key="d0">Reproductive Endocrinologist</data>
      <data key="d1">person</data>
      <data key="d2">A doctor specializing in fertility preservation procedures such as ovarian transposition, egg freezing, and surrogacy.&lt;SEP&gt;A medical doctor who specializes in fertility and provides expert consultation when fertility-sparing treatments are considered.</data>
      <data key="d3">chunk-95c76786e9d6dbf06ddf5d55af0cf658&lt;SEP&gt;chunk-be6e1cb2fe11f4d9962741c30d446a69</data>
    </node>
    <node id="Surrogate">
      <data key="d0">Surrogate</data>
      <data key="d1">person</data>
      <data key="d2">A gestational carrier who volunteers to have embryos transferred into their uterus to carry a pregnancy to term.</data>
      <data key="d3">chunk-be6e1cb2fe11f4d9962741c30d446a69</data>
    </node>
    <node id="Examination Under Anesthesia">
      <data key="d0">Examination Under Anesthesia</data>
      <data key="d1">event</data>
      <data key="d2">Diagnostic evaluation procedures (EUAs) performed under general anesthesia to inspect surrounding organs for cancer involvement.</data>
      <data key="d3">chunk-be6e1cb2fe11f4d9962741c30d446a69</data>
    </node>
    <node id="Cystoscopy">
      <data key="d0">Cystoscopy</data>
      <data key="d1">event</data>
      <data key="d2">A diagnostic procedure using a lighted lens to inspect the bladder and urinary tract under anesthesia.&lt;SEP&gt;A diagnostic procedure using a viewing instrument inserted through the urethra to inspect the bladder lining for cancer.&lt;SEP&gt;An endoscopic diagnostic procedure used to examine the interior of the bladder.&lt;SEP&gt;An endoscopic examination of the bladder under anesthesia to assess potential local cancer invasion.&lt;SEP&gt;An examination procedure using a cystoscope to inspect the inside of the urethra and bladder for signs of cancer and obtain tissue biopsies.&lt;SEP&gt;Cystoscopy is an endoscopic procedure using a lighted tube with a camera to examine the urethra and bladder for signs of cancer and to obtain biopsies.</data>
      <data key="d3">chunk-7a890e27eba8c63d10f19b85a72fc14a&lt;SEP&gt;chunk-8aa2c7020ce6e89888e81972588726e3&lt;SEP&gt;chunk-76a038845aaedb9ef7852018f26778b3&lt;SEP&gt;chunk-e9a7fe3b15f3289198c7114b44890dea&lt;SEP&gt;chunk-dea00cf063e8831db4919330d94b1f2a&lt;SEP&gt;chunk-be6e1cb2fe11f4d9962741c30d446a69</data>
    </node>
    <node id="Embryo Freezing">
      <data key="d0">Embryo Freezing</data>
      <data key="d1">event</data>
      <data key="d2">A fertility preservation procedure where fertilized embryos are frozen and stored for future use in assisted reproduction.</data>
      <data key="d3">chunk-be6e1cb2fe11f4d9962741c30d446a69</data>
    </node>
    <node id="X-Ray">
      <data key="d0">X-Ray</data>
      <data key="d1">event</data>
      <data key="d2">A conventional medical diagnostic imaging test that utilizes radiation, contrasted with non-radiation techniques like MRI.&lt;SEP&gt;A foundational radiation-based imaging modality whose multi-angle pictures are compiled to generate CT scans.&lt;SEP&gt;An x-ray is a diagnostic radiography procedure that uses low doses of radiation to produce images of internal body structures.</data>
      <data key="d3">chunk-3fbf2f6a3c150687a59f814d94f1d150&lt;SEP&gt;chunk-76a038845aaedb9ef7852018f26778b3&lt;SEP&gt;chunk-be6e1cb2fe11f4d9962741c30d446a69</data>
    </node>
    <node id="Stage 1 Cervical Cancer">
      <data key="d0">Stage 1 Cervical Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A stage where cancer is confined strictly to the cervix, ranging from microscopic lesions (1A) up to larger tumors (1B).&lt;SEP&gt;Early-stage cervical cancer where imaging such as FDG-PET/CT or pelvic MRI is utilized depending on whether fertility-sparing or non-fertility-sparing treatment was performed.</data>
      <data key="d3">chunk-db3a86fc5d439d9bfb3845e468a2a551&lt;SEP&gt;chunk-b3ba7430f3a31330247f52afe7e9c68a</data>
    </node>
    <node id="Stage 2 Cervical Cancer">
      <data key="d0">Stage 2 Cervical Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A stage where cervical cancer has extended beyond the cervix into the upper vagina or the surrounding parametrium.</data>
      <data key="d3">chunk-db3a86fc5d439d9bfb3845e468a2a551</data>
    </node>
    <node id="Stage 3 Cervical Cancer">
      <data key="d0">Stage 3 Cervical Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A stage where cervical cancer has reached the lower third of the vagina, pelvic wall, or regional lymph nodes.</data>
      <data key="d3">chunk-db3a86fc5d439d9bfb3845e468a2a551</data>
    </node>
    <node id="Stage 4 Cervical Cancer">
      <data key="d0">Stage 4 Cervical Cancer</data>
      <data key="d1">category</data>
      <data key="d2">An advanced stage where cervical cancer has invaded nearby organs like the bladder or rectum, or metastasized to distant organs.</data>
      <data key="d3">chunk-db3a86fc5d439d9bfb3845e468a2a551</data>
    </node>
    <node id="Stage 1A Cervical Cancer">
      <data key="d0">Stage 1A Cervical Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A subcategory of cervical cancer where the tumor is 5 millimeters or smaller and confined to the cervix.</data>
      <data key="d3">chunk-db3a86fc5d439d9bfb3845e468a2a551</data>
    </node>
    <node id="Stage 1B Cervical Cancer">
      <data key="d0">Stage 1B Cervical Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A subcategory of stage 1 cervical cancer divided into sub-stages 1B1, 1B2, and 1B3 based on tumor sizes extending beyond 5 mm.</data>
      <data key="d3">chunk-db3a86fc5d439d9bfb3845e468a2a551</data>
    </node>
    <node id="Stage 2A Cervical Cancer">
      <data key="d0">Stage 2A Cervical Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A subcategory of stage 2 cervical cancer where the tumor has grown into the upper vagina, divided into 2A1 and 2A2 based on size.</data>
      <data key="d3">chunk-db3a86fc5d439d9bfb3845e468a2a551</data>
    </node>
    <node id="Stage 2B Cervical Cancer">
      <data key="d0">Stage 2B Cervical Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A subcategory of stage 2 cervical cancer where the cancer has grown into the parametrium surrounding the cervix and uterus.</data>
      <data key="d3">chunk-db3a86fc5d439d9bfb3845e468a2a551</data>
    </node>
    <node id="Stage 3A Cervical Cancer">
      <data key="d0">Stage 3A Cervical Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A subcategory of stage 3 cervical cancer where the tumor has grown into the lower third of the vagina.</data>
      <data key="d3">chunk-db3a86fc5d439d9bfb3845e468a2a551</data>
    </node>
    <node id="Stage 3B Cervical Cancer">
      <data key="d0">Stage 3B Cervical Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A subcategory of stage 3 cervical cancer where tumor growth reaches the pelvic wall or causes kidney swelling or dysfunction.</data>
      <data key="d3">chunk-db3a86fc5d439d9bfb3845e468a2a551</data>
    </node>
    <node id="Stage 3C Cervical Cancer">
      <data key="d0">Stage 3C Cervical Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A subcategory of stage 3 cervical cancer involving spread to pelvic lymph nodes or abdominal para-aortic lymph nodes.</data>
      <data key="d3">chunk-db3a86fc5d439d9bfb3845e468a2a551</data>
    </node>
    <node id="Stage 4A Cervical Cancer">
      <data key="d0">Stage 4A Cervical Cancer</data>
      <data key="d1">category</data>
      <data key="d2">An advanced stage subcategory characterized by direct cancer spread to adjacent organs such as the bladder or rectum.</data>
      <data key="d3">chunk-db3a86fc5d439d9bfb3845e468a2a551</data>
    </node>
    <node id="Stage 4B Cervical Cancer">
      <data key="d0">Stage 4B Cervical Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A metastatic stage subcategory where cancer has spread to distant organs such as the liver, lungs, abdomen, or bone.&lt;SEP&gt;Metastatic cervical cancer characterized by distant spread or recurrence, where imaging monitors response to systemic therapy.</data>
      <data key="d3">chunk-db3a86fc5d439d9bfb3845e468a2a551&lt;SEP&gt;chunk-b3ba7430f3a31330247f52afe7e9c68a</data>
    </node>
    <node id="Cancer Care Plan">
      <data key="d0">Cancer Care Plan</data>
      <data key="d1">category</data>
      <data key="d2">A tailored clinical document outlining treatment options, team members, side effects, and goals for cancer therapy.</data>
      <data key="d3">chunk-db3a86fc5d439d9bfb3845e468a2a551</data>
    </node>
    <node id="Trachelectomy">
      <data key="d0">Trachelectomy</data>
      <data key="d1">category</data>
      <data key="d2">A fertility-sparing surgical procedure that removes the cervix and upper part of the vagina while preserving the uterus.&lt;SEP&gt;A fertility-sparing surgical procedure to remove the cervix while leaving the uterus and ovaries intact, allowing potential future natural pregnancy.</data>
      <data key="d3">chunk-e9a7fe3b15f3289198c7114b44890dea&lt;SEP&gt;chunk-8ec4d44b145ca896ff1216caa90ce5dd</data>
    </node>
    <node id="Hysterectomy">
      <data key="d0">Hysterectomy</data>
      <data key="d1">category</data>
      <data key="d2">A surgical operation removing the uterus, standardly recommended for early-stage cervical cancer when fertility preservation is not needed.&lt;SEP&gt;A surgical procedure that removes the uterus and cervix, along with portions of vaginal or cervical connective tissue, and potentially the ovaries causing surgical menopause.&lt;SEP&gt;A surgical procedure to remove the uterus and cervix, categorized into simple (extrafascial), modified radical, and radical types based on the extent of tissue removed.&lt;SEP&gt;Surgical removal of the uterus, which may be avoided if cervical cancer has spread beyond the cervix.</data>
      <data key="d3">chunk-c9bfa651267335dd5e6ae5a24d85a072&lt;SEP&gt;chunk-e9a7fe3b15f3289198c7114b44890dea&lt;SEP&gt;chunk-8ec4d44b145ca896ff1216caa90ce5dd&lt;SEP&gt;chunk-95c76786e9d6dbf06ddf5d55af0cf658</data>
    </node>
    <node id="Dysplasia">
      <data key="d0">Dysplasia</data>
      <data key="d1">category</data>
      <data key="d2">Abnormal cell growth and precancerous cellular changes detected in cervical tissue during biopsy.</data>
      <data key="d3">chunk-e9a7fe3b15f3289198c7114b44890dea</data>
    </node>
    <node id="Minimally Invasive Surgery">
      <data key="d0">Minimally Invasive Surgery</data>
      <data key="d1">category</data>
      <data key="d2">Laparoscopic surgical techniques utilizing small incisions to reduce tissue trauma, post-operative pain, and recovery duration.</data>
      <data key="d3">chunk-e9a7fe3b15f3289198c7114b44890dea</data>
    </node>
    <node id="Extrafascial Hysterectomy">
      <data key="d0">Extrafascial Hysterectomy</data>
      <data key="d1">event</data>
      <data key="d2">A simple hysterectomy procedure recommended for stage 1A1 cancer patients who do not seek fertility preservation.&lt;SEP&gt;A simple hysterectomy procedure that removes only the uterus and cervix, commonly indicated for stage IA1 cervical cancer.&lt;SEP&gt;A simple surgical procedure involving the removal of the uterus and cervix, recommended for low-risk stage 1A and 1B1 cervical cancers meeting specific criteria.</data>
      <data key="d3">chunk-e9a7fe3b15f3289198c7114b44890dea&lt;SEP&gt;chunk-95c76786e9d6dbf06ddf5d55af0cf658&lt;SEP&gt;chunk-e247ae57c50c62bded7114986471226e</data>
    </node>
    <node id="Modified Radical Hysterectomy">
      <data key="d0">Modified Radical Hysterectomy</data>
      <data key="d1">category</data>
      <data key="d2">A surgical procedure that removes the uterus, cervix, adjacent parametrial connective tissue, and a small upper portion of the vagina via an abdominal incision.&lt;SEP&gt;A surgical procedure that removes the uterus, cervix, and adjacent tissue, recommended for stage 1A1 cancers with LVSI or when pre-cancer is found at cone margins.</data>
      <data key="d3">chunk-e9a7fe3b15f3289198c7114b44890dea&lt;SEP&gt;chunk-e247ae57c50c62bded7114986471226e</data>
    </node>
    <node id="Radical Hysterectomy">
      <data key="d0">Radical Hysterectomy</data>
      <data key="d1">category</data>
      <data key="d2">A surgical treatment option involving removal of reproductive organs, typically considered for carefully selected patients with local or regional cancer recurrence.&lt;SEP&gt;An extensive abdominal surgical procedure that removes the uterus, cervix, substantial surrounding parametrial tissue, and the upper quarter to third of the vagina.&lt;SEP&gt;An extensive surgical operation removing the uterus, cervix, parametrium, and upper vagina, used for stages 1B1 to 2A1 and higher-risk early-stage cases.</data>
      <data key="d3">chunk-e9a7fe3b15f3289198c7114b44890dea&lt;SEP&gt;chunk-9d0e32bdc49dbab9c2c953abf363e317&lt;SEP&gt;chunk-e247ae57c50c62bded7114986471226e</data>
    </node>
    <node id="Ovary Preservation">
      <data key="d0">Ovary Preservation</data>
      <data key="d1">category</data>
      <data key="d2">A clinical surgical strategy to retain the ovaries during hysterectomy to prevent premature surgical menopause and hormonal loss.</data>
      <data key="d3">chunk-e9a7fe3b15f3289198c7114b44890dea</data>
    </node>
    <node id="Diagnostic Imaging">
      <data key="d0">Diagnostic Imaging</data>
      <data key="d1">category</data>
      <data key="d2">A class of medical diagnostic techniques used to produce detailed pictures of internal body structures to detect tumors and metastasis.&lt;SEP&gt;Radiological modalities including CT, MRI, PET, and transvaginal ultrasound used to evaluate the anatomical extent and staging of cancer.</data>
      <data key="d3">chunk-e9a7fe3b15f3289198c7114b44890dea&lt;SEP&gt;chunk-76a038845aaedb9ef7852018f26778b3</data>
    </node>
    <node id="Locally Advanced Cervical Cancer">
      <data key="d0">Locally Advanced Cervical Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A clinical classification of cervical cancer that has grown beyond the cervix or is larger than 4 cm (such as stages 1B3 to 4A) without distant metastasis.&lt;SEP&gt;A stage of cervical cancer where the tumor has grown beyond the cervix but has not spread to distant sites like the liver, lungs, or bones.&lt;SEP&gt;Cervical cancer that has spread beyond the cervix into surrounding tissues or nodes but has not metastasized to distant organs.</data>
      <data key="d3">chunk-c9bfa651267335dd5e6ae5a24d85a072&lt;SEP&gt;chunk-e247ae57c50c62bded7114986471226e&lt;SEP&gt;chunk-d04ad65c55d0dbbee5061cf3b24030ef</data>
    </node>
    <node id="Metastatic Cervical Cancer">
      <data key="d0">Metastatic Cervical Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A classification of advanced cervical cancer that has spread to distant organs such as the liver, lungs, or bone, whether diagnosed initially or after treatment.&lt;SEP&gt;A stage of cervical cancer that has spread to distant sites such as liver, lungs, or bone, commonly managed with systemic therapies and supportive care.&lt;SEP&gt;Advanced cervical cancer that has spread to distant organs and tissues such as the liver, lungs, or bone.</data>
      <data key="d3">chunk-c9bfa651267335dd5e6ae5a24d85a072&lt;SEP&gt;chunk-9d0e32bdc49dbab9c2c953abf363e317&lt;SEP&gt;chunk-8ba71a5181f3814dffb21d3399441bea</data>
    </node>
    <node id="Laparoscopic Surgical Staging">
      <data key="d0">Laparoscopic Surgical Staging</data>
      <data key="d1">event</data>
      <data key="d2">A minimally invasive surgical procedure used to access, remove, and evaluate pelvic and para-aortic lymph nodes prior to treatment to guide therapy for advanced cancer.</data>
      <data key="d3">chunk-c9bfa651267335dd5e6ae5a24d85a072</data>
    </node>
    <node id="Intensity-Modulated Radiation Therapy">
      <data key="d0">Intensity-Modulated Radiation Therapy</data>
      <data key="d1">category</data>
      <data key="d2">An advanced conformal external beam radiation therapy technique using multiple beams of varying intensities to spare healthy tissues.&lt;SEP&gt;An advanced external radiation therapy technique that uses multiple beams of varying intensities, recommended for anal cancer.&lt;SEP&gt;An advanced radiation technique (IMRT) identified as the preferred method of radiation delivery for anal cancer.&lt;SEP&gt;An advanced technique of external beam radiation therapy that utilizes multiple beams of varying intensities to spare healthy organs while treating the tumor.&lt;SEP&gt;Intensity-modulated radiation therapy (IMRT) is an advanced high-precision radiation technique used to deliver targeted radiation doses to tumors while sparing healthy surrounding tissues.</data>
      <data key="d3">chunk-419f40f64b13b1b2d0fac3cfb9fde92a&lt;SEP&gt;chunk-b0bad5ee25cb854c10bdbc9d33b54a1a&lt;SEP&gt;chunk-0d4cea71149e0e4157126efdaa0ea3e3&lt;SEP&gt;chunk-0fdcce851d69aa713ed64ba1895bd5d1&lt;SEP&gt;chunk-c9bfa651267335dd5e6ae5a24d85a072</data>
    </node>
    <node id="Stereotactic Body Radiation Therapy">
      <data key="d0">Stereotactic Body Radiation Therapy</data>
      <data key="d1">category</data>
      <data key="d2">A specialized form of external beam radiation therapy delivering high doses of highly focused radiation to metastatic tumors in five or fewer sessions.&lt;SEP&gt;A specialized, targeted form of external beam radiation therapy (SBRT) delivered over few sessions to treat tumors in organs like the liver, lungs, or bone.&lt;SEP&gt;A specialized, targeted form of radiation therapy (SBRT</data>
      <data key="d3">chunk-c9bfa651267335dd5e6ae5a24d85a072&lt;SEP&gt;chunk-c35816f05289661283f683145d9f395f&lt;SEP&gt;chunk-9d0e32bdc49dbab9c2c953abf363e317</data>
    </node>
    <node id="Simulation">
      <data key="d0">Simulation</data>
      <data key="d1">event</data>
      <data key="d2">A clinical planning session involving scans and precise patient positioning conducted prior to external beam radiation therapy.&lt;SEP&gt;A preparation and planning session before radiation therapy where CT scans and positioning devices are used to establish precise treatment coordinates and doses.&lt;SEP&gt;A specialized planning session prior to radiation therapy where patient positioning, CT scans, and dose calculations are conducted.</data>
      <data key="d3">chunk-c9bfa651267335dd5e6ae5a24d85a072&lt;SEP&gt;chunk-b0bad5ee25cb854c10bdbc9d33b54a1a&lt;SEP&gt;chunk-1e017cd4fd8af1ebbcb582a93fbfe1ea</data>
    </node>
    <node id="Menopausal Hormone Therapy">
      <data key="d0">Menopausal Hormone Therapy</data>
      <data key="d1">category</data>
      <data key="d2">Hormone treatment, historically called hormone replacement therapy (HRT), used to mitigate the symptoms and long-term effects of radiation-induced menopause.</data>
      <data key="d3">chunk-c9bfa651267335dd5e6ae5a24d85a072</data>
    </node>
    <node id="Pelvic Lymph Nodes">
      <data key="d0">Pelvic Lymph Nodes</data>
      <data key="d1">category</data>
      <data key="d2">Lymph nodes situated in the pelvis closest to the cervix, representing the initial site where cervical cancer typically spreads.</data>
      <data key="d3">chunk-c9bfa651267335dd5e6ae5a24d85a072</data>
    </node>
    <node id="Para-Aortic Lymph Nodes">
      <data key="d0">Para-Aortic Lymph Nodes</data>
      <data key="d1">category</data>
      <data key="d2">Lymph nodes located in the abdomen that can be involved in the spread of cervical cancer and are sometimes surgically excised for staging.</data>
      <data key="d3">chunk-c9bfa651267335dd5e6ae5a24d85a072</data>
    </node>
    <node id="Premature Menopause">
      <data key="d0">Premature Menopause</data>
      <data key="d1">category</data>
      <data key="d2">Early cessation of ovarian function and menopausal onset triggered by surgical removal or radiation exposure of the ovaries.</data>
      <data key="d3">chunk-c9bfa651267335dd5e6ae5a24d85a072</data>
    </node>
    <node id="Intracavitary Brachytherapy">
      <data key="d0">Intracavitary Brachytherapy</data>
      <data key="d1">category</data>
      <data key="d2">A common brachytherapy technique for cervical cancer where instruments holding radioactive material are inserted into the cervix, uterus, and vagina.</data>
      <data key="d3">chunk-d04ad65c55d0dbbee5061cf3b24030ef</data>
    </node>
    <node id="Interstitial Brachytherapy">
      <data key="d0">Interstitial Brachytherapy</data>
      <data key="d1">category</data>
      <data key="d2">A specialized brachytherapy technique where catheters are placed directly into the tumor or neighboring tissues, used for more advanced cancers involving the parametrium.</data>
      <data key="d3">chunk-d04ad65c55d0dbbee5061cf3b24030ef</data>
    </node>
    <node id="High Dose-Rate Brachytherapy">
      <data key="d0">High Dose-Rate Brachytherapy</data>
      <data key="d1">category</data>
      <data key="d2">A form of brachytherapy (HDR) that delivers radiation in short bursts, commonly administered via specialized applicators over three to five sessions.</data>
      <data key="d3">chunk-d04ad65c55d0dbbee5061cf3b24030ef</data>
    </node>
    <node id="Recurrent Or Metastatic Cervical Cancer">
      <data key="d0">Recurrent Or Metastatic Cervical Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A classification of cervical cancer that either returns after initial therapy or has spread to distant regions, often managed with systemic treatments.</data>
      <data key="d3">chunk-d04ad65c55d0dbbee5061cf3b24030ef</data>
    </node>
    <node id="Low Dose-Rate Brachytherapy">
      <data key="d0">Low Dose-Rate Brachytherapy</data>
      <data key="d1">category</data>
      <data key="d2">A form of brachytherapy (LDR) that delivers radiation continuously in long bursts over an extended period.</data>
      <data key="d3">chunk-d04ad65c55d0dbbee5061cf3b24030ef</data>
    </node>
    <node id="Tandem And Ring Applicator">
      <data key="d0">Tandem And Ring Applicator</data>
      <data key="d1">category</data>
      <data key="d2">A medical device applicator used for HDR brachytherapy consisting of a tandem tube inserted into the uterus and a ring placed in the vagina against the cervix.</data>
      <data key="d3">chunk-d04ad65c55d0dbbee5061cf3b24030ef</data>
    </node>
    <node id="Tandem And Ovoid Applicator">
      <data key="d0">Tandem And Ovoid Applicator</data>
      <data key="d1">category</data>
      <data key="d2">A specialized brachytherapy applicator apparatus featuring a tandem combined with hollow, rounded capsules inserted into the vaginal vault.</data>
      <data key="d3">chunk-d04ad65c55d0dbbee5061cf3b24030ef</data>
    </node>
    <node id="Early-Stage Cancer">
      <data key="d0">Early-Stage Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A cancer stage classification typically managed with surgical interventions such as hysterectomy or trachelectomy.&lt;SEP&gt;Cervical cancers that are limited to the cervix (stage 1) or have spread to the upper vagina (stage 2A), typically treated with surgery or radiation.</data>
      <data key="d3">chunk-8ec4d44b145ca896ff1216caa90ce5dd&lt;SEP&gt;chunk-95c76786e9d6dbf06ddf5d55af0cf658</data>
    </node>
    <node id="Phase 1 Trial">
      <data key="d0">Phase 1 Trial</data>
      <data key="d1">event</data>
      <data key="d2">An initial clinical trial phase studying the dosage, safety, side effects, and early signs of efficacy of an investigational drug or treatment.</data>
      <data key="d3">chunk-8ec4d44b145ca896ff1216caa90ce5dd</data>
    </node>
    <node id="Phase 2 Trial">
      <data key="d0">Phase 2 Trial</data>
      <data key="d1">event</data>
      <data key="d2">A clinical research trial phase evaluating how effectively an investigational treatment works against a specific type of cancer.</data>
      <data key="d3">chunk-8ec4d44b145ca896ff1216caa90ce5dd</data>
    </node>
    <node id="Phase 3 Trial">
      <data key="d0">Phase 3 Trial</data>
      <data key="d1">event</data>
      <data key="d2">A clinical trial phase testing an investigational drug or approach directly against standard treatment to achieve regulatory approval.</data>
      <data key="d3">chunk-8ec4d44b145ca896ff1216caa90ce5dd</data>
    </node>
    <node id="Phase 4 Trial">
      <data key="d0">Phase 4 Trial</data>
      <data key="d1">event</data>
      <data key="d2">A post-marketing clinical trial studying the long-term safety and benefits of an FDA-approved cancer treatment.</data>
      <data key="d3">chunk-8ec4d44b145ca896ff1216caa90ce5dd</data>
    </node>
    <node id="Stage 1A1">
      <data key="d0">Stage 1A1</data>
      <data key="d1">category</data>
      <data key="d2">An early microinvasive stage of cervical cancer categorized by microscopic stromal invasion, often treated based on the presence of LVSI.&lt;SEP&gt;An early substage of cervical cancer diagnosed typically by cone biopsy, manageable with fertility-sparing or non-fertility-sparing approaches.</data>
      <data key="d3">chunk-e247ae57c50c62bded7114986471226e&lt;SEP&gt;chunk-95c76786e9d6dbf06ddf5d55af0cf658</data>
    </node>
    <node id="Stage 1A2">
      <data key="d0">Stage 1A2</data>
      <data key="d1">category</data>
      <data key="d2">A stage of cervical cancer characterized by slight depth of stromal invasion, managed through extrafascial or radical hysterectomy depending on risk factors.&lt;SEP&gt;A substage of cervical cancer evaluated with pelvic lymph node assessment and treated via cone biopsy or radical trachelectomy.</data>
      <data key="d3">chunk-e247ae57c50c62bded7114986471226e&lt;SEP&gt;chunk-95c76786e9d6dbf06ddf5d55af0cf658</data>
    </node>
    <node id="Stage 1B1">
      <data key="d0">Stage 1B1</data>
      <data key="d1">category</data>
      <data key="d2">A substage of cervical cancer where tumor size dictates whether cone biopsy or radical trachelectomy with lymph node evaluation is recommended.&lt;SEP&gt;An early-stage invasive cervical cancer tumor measuring 2 cm or smaller, qualifying for extrafascial hysterectomy under strict low-risk criteria or radical hysterectomy.</data>
      <data key="d3">chunk-e247ae57c50c62bded7114986471226e&lt;SEP&gt;chunk-95c76786e9d6dbf06ddf5d55af0cf658</data>
    </node>
    <node id="Stage 1B2">
      <data key="d0">Stage 1B2</data>
      <data key="d1">category</data>
      <data key="d2">A stage of cervical cancer measuring between 2 cm and 4 cm, typically managed with radical hysterectomy and pelvic lymph node evaluation.&lt;SEP&gt;An early substage of cervical cancer for which fertility-sparing surgery is uncommon due to larger tumor size.</data>
      <data key="d3">chunk-e247ae57c50c62bded7114986471226e&lt;SEP&gt;chunk-95c76786e9d6dbf06ddf5d55af0cf658</data>
    </node>
    <node id="Radical Trachelectomy">
      <data key="d0">Radical Trachelectomy</data>
      <data key="d1">event</data>
      <data key="d2">A surgical procedure to remove the cervix while leaving the uterus intact, offered as a fertility-sparing treatment in early-stage cervical cancer.</data>
      <data key="d3">chunk-95c76786e9d6dbf06ddf5d55af0cf658</data>
    </node>
    <node id="Lymphovascular Space Invasion">
      <data key="d0">Lymphovascular Space Invasion</data>
      <data key="d1">category</data>
      <data key="d2">A pathological risk factor indicating tumor cells within blood vessels or lymph vessels, which increases the likelihood of spread to nearby lymph nodes.</data>
      <data key="d3">chunk-95c76786e9d6dbf06ddf5d55af0cf658</data>
    </node>
    <node id="Pelvic Lymph Node Evaluation">
      <data key="d0">Pelvic Lymph Node Evaluation</data>
      <data key="d1">event</data>
      <data key="d2">A diagnostic and surgical assessment performed to detect cancer spread to lymph nodes located in the pelvis.</data>
      <data key="d3">chunk-95c76786e9d6dbf06ddf5d55af0cf658</data>
    </node>
    <node id="Vaginal Brachytherapy">
      <data key="d0">Vaginal Brachytherapy</data>
      <data key="d1">category</data>
      <data key="d2">An internal radiation therapy modality administered locally into the vagina, sometimes alongside EBRT and chemotherapy.</data>
      <data key="d3">chunk-95c76786e9d6dbf06ddf5d55af0cf658</data>
    </node>
    <node id="Stage 1">
      <data key="d0">Stage 1</data>
      <data key="d1">category</data>
      <data key="d2">A non-muscle-invasive bladder cancer stage where cancer has grown through the inner lining into the connective tissue layer.&lt;SEP&gt;An early stage of cervical cancer where the tumor has not spread beyond the cervix.</data>
      <data key="d3">chunk-29d1ec9b874dd38ef0f3a4a2081f548e&lt;SEP&gt;chunk-95c76786e9d6dbf06ddf5d55af0cf658</data>
    </node>
    <node id="Stage 2A">
      <data key="d0">Stage 2A</data>
      <data key="d1">category</data>
      <data key="d2">A stage of cervical cancer indicating that the malignancy has spread to the upper vagina.</data>
      <data key="d3">chunk-95c76786e9d6dbf06ddf5d55af0cf658</data>
    </node>
    <node id="Pelvic Lymph Node Dissection">
      <data key="d0">Pelvic Lymph Node Dissection</data>
      <data key="d1">event</data>
      <data key="d2">A surgical procedure to evaluate and remove lymph nodes within the pelvic basin to assess disease spread and determine staging.</data>
      <data key="d3">chunk-e247ae57c50c62bded7114986471226e</data>
    </node>
    <node id="Stage 1B3">
      <data key="d0">Stage 1B3</data>
      <data key="d1">category</data>
      <data key="d2">A cervical cancer stage where the tumor is larger than 4 cm without extension beyond the cervix, treated as locally advanced with chemoradiation or surgery.</data>
      <data key="d3">chunk-e247ae57c50c62bded7114986471226e</data>
    </node>
    <node id="Stage 2A1">
      <data key="d0">Stage 2A1</data>
      <data key="d1">category</data>
      <data key="d2">A cervical cancer stage involving the upper vagina measuring 4 cm or less, commonly treated with radical hysterectomy and lymph node evaluation.</data>
      <data key="d3">chunk-e247ae57c50c62bded7114986471226e</data>
    </node>
    <node id="Stage 2A2">
      <data key="d0">Stage 2A2</data>
      <data key="d1">category</data>
      <data key="d2">A cervical cancer stage measuring larger than 4 cm that extends into the upper vagina, preferably treated with chemoradiation.</data>
      <data key="d3">chunk-e247ae57c50c62bded7114986471226e</data>
    </node>
    <node id="Stage 2B">
      <data key="d0">Stage 2B</data>
      <data key="d1">category</data>
      <data key="d2">A locally advanced cervical cancer stage defined by parametrial invasion, treated primarily with definitive chemoradiation and brachytherapy.</data>
      <data key="d3">chunk-e247ae57c50c62bded7114986471226e</data>
    </node>
    <node id="Stage 3">
      <data key="d0">Stage 3</data>
      <data key="d1">category</data>
      <data key="d2">A locally advanced cervical cancer stage involving the lower vagina, pelvic wall, or causing hydronephrosis/kidney dysfunction, managed with chemoradiation.&lt;SEP&gt;A stage of bladder cancer that has grown through the wall into the surrounding fatty layer and potentially into nearby pelvic lymph nodes or organs.</data>
      <data key="d3">chunk-e247ae57c50c62bded7114986471226e&lt;SEP&gt;chunk-29d1ec9b874dd38ef0f3a4a2081f548e</data>
    </node>
    <node id="Stage 4A">
      <data key="d0">Stage 4A</data>
      <data key="d1">category</data>
      <data key="d2">A locally advanced stage of cervical cancer where the tumor has invaded adjacent pelvic organs such as the bladder or rectum without distant metastasis.&lt;SEP&gt;A subgroup of Stage 4 bladder cancer characterized by invasion into the pelvis or abdominal wall, or spread to distant lymph nodes.</data>
      <data key="d3">chunk-e247ae57c50c62bded7114986471226e&lt;SEP&gt;chunk-29d1ec9b874dd38ef0f3a4a2081f548e</data>
    </node>
    <node id="LVSI">
      <data key="d0">LVSI</data>
      <data key="d1">category</data>
      <data key="d2">Lymphovascular space invasion, a critical pathological risk factor whose presence dictates more extensive surgery or adjuvant chemoradiation.</data>
      <data key="d3">chunk-e247ae57c50c62bded7114986471226e</data>
    </node>
    <node id="Small Cell Neuroendocrine Carcinoma Of The Cervix">
      <data key="d0">Small Cell Neuroendocrine Carcinoma Of The Cervix</data>
      <data key="d1">category</data>
      <data key="d2">A rare and aggressive type of cervical cancer subject to post-treatment surveillance and care protocols.</data>
      <data key="d3">chunk-b3ba7430f3a31330247f52afe7e9c68a</data>
    </node>
    <node id="Physical Exams">
      <data key="d0">Physical Exams</data>
      <data key="d1">category</data>
      <data key="d2">Routine medical checkups conducted by oncologists to monitor for signs and symptoms of cancer recurrence post-treatment.</data>
      <data key="d3">chunk-b3ba7430f3a31330247f52afe7e9c68a</data>
    </node>
    <node id="Pap Tests">
      <data key="d0">Pap Tests</data>
      <data key="d1">category</data>
      <data key="d2">Cervical or vaginal cytology screening tests performed annually after treatment to detect abnormal and precancerous cells.</data>
      <data key="d3">chunk-b3ba7430f3a31330247f52afe7e9c68a</data>
    </node>
    <node id="Pelvic Recurrence">
      <data key="d0">Pelvic Recurrence</data>
      <data key="d1">category</data>
      <data key="d2">Local or regional return of cervical cancer within the pelvis following initial treatment.</data>
      <data key="d3">chunk-b3ba7430f3a31330247f52afe7e9c68a</data>
    </node>
    <node id="Stages 2, 3, And 4A Cervical Cancer">
      <data key="d0">Stages 2, 3, And 4A Cervical Cancer</data>
      <data key="d1">category</data>
      <data key="d2">Locally advanced stages of cervical cancer for which FDG-PET/CT or CT with contrast and pelvic MRI are recommended 3 to 6 months post-treatment.</data>
      <data key="d3">chunk-b3ba7430f3a31330247f52afe7e9c68a</data>
    </node>
    <node id="CT With Contrast">
      <data key="d0">CT With Contrast</data>
      <data key="d1">category</data>
      <data key="d2">Computed tomography scan using contrast dye, recommended as an imaging option for surveillance in advanced stages.</data>
      <data key="d3">chunk-b3ba7430f3a31330247f52afe7e9c68a</data>
    </node>
    <node id="EBRT">
      <data key="d0">EBRT</data>
      <data key="d1">category</data>
      <data key="d2">External beam radiation therapy recommended after surgical resection in cases of local pelvic recurrence that have not been previously irradiated.</data>
      <data key="d3">chunk-b3ba7430f3a31330247f52afe7e9c68a</data>
    </node>
    <node id="Exploratory Surgery">
      <data key="d0">Exploratory Surgery</data>
      <data key="d1">category</data>
      <data key="d2">Surgical investigation to assess the full extent and spread of suspected recurrent cancer within the body.</data>
      <data key="d3">chunk-b3ba7430f3a31330247f52afe7e9c68a</data>
    </node>
    <node id="Pelvic Exenteration">
      <data key="d0">Pelvic Exenteration</data>
      <data key="d1">category</data>
      <data key="d2">A radical surgical procedure involving the removal of multiple organs from the pelvis, including reproductive and potentially urinary or bowel organs, to treat recurrent pelvic cancer.&lt;SEP&gt;An extensive surgical procedure considered for local pelvic recurrence when prior radiation therapy precludes further radiation.</data>
      <data key="d3">chunk-b3ba7430f3a31330247f52afe7e9c68a&lt;SEP&gt;chunk-9d0e32bdc49dbab9c2c953abf363e317</data>
    </node>
    <node id="RET Gene Fusion">
      <data key="d0">RET Gene Fusion</data>
      <data key="d1">category</data>
      <data key="d2">A rare genomic biomarker examined in cervical cancer to determine treatment pathways.</data>
      <data key="d3">chunk-b3ba7430f3a31330247f52afe7e9c68a</data>
    </node>
    <node id="Cervical Sarcoma">
      <data key="d0">Cervical Sarcoma</data>
      <data key="d1">category</data>
      <data key="d2">A rare malignancy of the cervix specifically evaluated for NTRK gene fusions.</data>
      <data key="d3">chunk-b3ba7430f3a31330247f52afe7e9c68a</data>
    </node>
    <node id="Cancer Survivor">
      <data key="d0">Cancer Survivor</data>
      <data key="d1">person</data>
      <data key="d2">An individual who has completed cancer treatment and participates in ongoing surveillance and survivorship care.</data>
      <data key="d3">chunk-b3ba7430f3a31330247f52afe7e9c68a</data>
    </node>
    <node id="Stage 4B">
      <data key="d0">Stage 4B</data>
      <data key="d1">category</data>
      <data key="d2">A diagnostic cancer stage category designating cervical cancer that had already metastasized to distant organs at initial diagnosis.&lt;SEP&gt;A subgroup of Stage 4 representing metastatic bladder cancer that has spread to distant lymph nodes and distant organs such as bones, liver, or lungs.</data>
      <data key="d3">chunk-29d1ec9b874dd38ef0f3a4a2081f548e&lt;SEP&gt;chunk-9d0e32bdc49dbab9c2c953abf363e317</data>
    </node>
    <node id="Urinary Diversion">
      <data key="d0">Urinary Diversion</data>
      <data key="d1">category</data>
      <data key="d2">A category of surgical procedures, such as an ileal conduit or continent diversion (Indiana pouch), that redirect urine after the bladder is surgically removed.&lt;SEP&gt;A surgical procedure included with radical cystectomy designed to establish a new pathway for urine to leave the body.&lt;SEP&gt;Urinary diversion is a reconstructive surgical procedure performed alongside cystectomy to establish a new pathway for urine to exit the body.&lt;SEP&gt;Urinary diversion refers to surgical procedures that redirect the normal flow of urine out of the body, such as creating an Indiana pouch.</data>
      <data key="d3">chunk-f2a44e885faf856aa579d824b3cd85e7&lt;SEP&gt;chunk-13e723cb8b0af4bcf2f1b0fd37912cb2&lt;SEP&gt;chunk-b0a584e54ffa22e1c25f839302bcd727&lt;SEP&gt;chunk-9d0e32bdc49dbab9c2c953abf363e317</data>
    </node>
    <node id="Double-Barreled Wet Colostomy">
      <data key="d0">Double-Barreled Wet Colostomy</data>
      <data key="d1">category</data>
      <data key="d2">A surgical diversion procedure (DBWC) where both urine and stool exit through a single stoma when both the bladder and bowel are removed.</data>
      <data key="d3">chunk-9d0e32bdc49dbab9c2c953abf363e317</data>
    </node>
    <node id="Ablative Therapies">
      <data key="d0">Ablative Therapies</data>
      <data key="d1">category</data>
      <data key="d2">A category of localized treatments using needles, probes, or electrodes to destroy cancerous tumors with minimal harm to adjacent normal tissues.</data>
      <data key="d3">chunk-9d0e32bdc49dbab9c2c953abf363e317</data>
    </node>
    <node id="Local Or Regional Recurrence">
      <data key="d0">Local Or Regional Recurrence</data>
      <data key="d1">category</data>
      <data key="d2">A clinical condition where cancer returns in the same area or pelvic region after previous treatment.</data>
      <data key="d3">chunk-9d0e32bdc49dbab9c2c953abf363e317</data>
    </node>
    <node id="Distant Recurrence">
      <data key="d0">Distant Recurrence</data>
      <data key="d1">category</data>
      <data key="d2">A clinical condition where cancer returns and metastasizes to distant organs after initial treatment.</data>
      <data key="d3">chunk-9d0e32bdc49dbab9c2c953abf363e317</data>
    </node>
    <node id="Vaginal Reconstruction">
      <data key="d0">Vaginal Reconstruction</data>
      <data key="d1">category</data>
      <data key="d2">A surgical procedure often performed after pelvic exenteration to create a neovagina, commonly using a muscle flap such as the rectus abdominis.</data>
      <data key="d3">chunk-9d0e32bdc49dbab9c2c953abf363e317</data>
    </node>
    <node id="Ileal Conduit">
      <data key="d0">Ileal Conduit</data>
      <data key="d1">category</data>
      <data key="d2">An ileal conduit is a form of urinary diversion where a section of small intestine directs urine out through an abdominal stoma into an external ostomy bag.&lt;SEP&gt;An incontinent urinary diversion technique that uses a piece of the ileum to route urine from the kidneys to an external abdominal stoma and ostomy pouch.</data>
      <data key="d3">chunk-13e723cb8b0af4bcf2f1b0fd37912cb2&lt;SEP&gt;chunk-9d0e32bdc49dbab9c2c953abf363e317</data>
    </node>
    <node id="Continent Urinary Diversion">
      <data key="d0">Continent Urinary Diversion</data>
      <data key="d1">category</data>
      <data key="d2">A urinary diversion method, also called an artificial bladder or Indiana pouch, creating an internal intestinal reservoir catheterized through an abdominal stoma.</data>
      <data key="d3">chunk-9d0e32bdc49dbab9c2c953abf363e317</data>
    </node>
    <node id="Immunotherapies">
      <data key="d0">Immunotherapies</data>
      <data key="d1">category</data>
      <data key="d2">Cancer treatment modalities that stimulate or mobilize the body's immune system to attack cancer cells, guided by biomarker testing.</data>
      <data key="d3">chunk-9d0e32bdc49dbab9c2c953abf363e317</data>
    </node>
    <node id="Resection">
      <data key="d0">Resection</data>
      <data key="d1">event</data>
      <data key="d2">A surgical procedure aimed at removing part or all of a tumor, compared directly to an open biopsy in operative method.&lt;SEP&gt;A surgical procedure performed by a neurosurgeon to remove as much of a tumor as safely possible, serving as both treatment and diagnostic biopsy.&lt;SEP&gt;Surgical removal of new cancer growths, applicable in localized recurrence or selective metastatic settings.</data>
      <data key="d3">chunk-ffc3446f8ec092af24a460bda94f772f&lt;SEP&gt;chunk-9d0e32bdc49dbab9c2c953abf363e317&lt;SEP&gt;chunk-49c7ff3a71e74b3f0eb59258541e739e</data>
    </node>
    <node id="Mediastinal Gray Zone Lymphoma">
      <data key="d0">Mediastinal Gray Zone Lymphoma</data>
      <data key="d1">category</data>
      <data key="d2">A rare lymphoma subtype (MGZL) characterized by overlapping features of primary mediastinal B-cell lymphoma and Hodgkin lymphoma, usually presenting as a mediastinal mass.&lt;SEP&gt;Mediastinal gray zone lymphoma (MGZL) is a rare lymphoma showing features of both classical Hodgkin lymphoma and primary mediastinal B-cell lymphoma, lacking a standard care consensus.</data>
      <data key="d3">chunk-18b5e32980f3efa0cd012e2abab9b9fc&lt;SEP&gt;chunk-8ba71a5181f3814dffb21d3399441bea</data>
    </node>
    <node id="Primary Mediastinal B-Cell Lymphoma">
      <data key="d0">Primary Mediastinal B-Cell Lymphoma</data>
      <data key="d1">category</data>
      <data key="d2">A subtype of non-Hodgkin lymphoma (PMBL) arising in the mediastinum, sharing morphological and clinical characteristics with mediastinal gray zone lymphoma.</data>
      <data key="d3">chunk-8ba71a5181f3814dffb21d3399441bea</data>
    </node>
    <node id="Non-Mediastinal Gray Zone Lymphoma">
      <data key="d0">Non-Mediastinal Gray Zone Lymphoma</data>
      <data key="d1">category</data>
      <data key="d2">A category of gray zone lymphoma presenting outside the mediastinum, typically in older patients with higher rates of extranodal and bone marrow involvement.</data>
      <data key="d3">chunk-8ba71a5181f3814dffb21d3399441bea</data>
    </node>
    <node id="DLBCL-NOS">
      <data key="d0">DLBCL-NOS</data>
      <data key="d1">category</data>
      <data key="d2">Diffuse large B-cell lymphoma, not otherwise specified (DLBCL-NOS) is a diagnostic category applied to lymphoma cases with extra-mediastinal presentation.&lt;SEP&gt;Diffuse large B-cell lymphoma, not otherwise specified; a lymphoma classification assigned to patients with gray zone disease features occurring outside the mediastinum.</data>
      <data key="d3">chunk-18b5e32980f3efa0cd012e2abab9b9fc&lt;SEP&gt;chunk-8ba71a5181f3814dffb21d3399441bea</data>
    </node>
    <node id="Cancer Centers">
      <data key="d0">Cancer Centers</data>
      <data key="d1">organization</data>
      <data key="d2">Specialized medical and research facilities where clinical oncology practices, guidelines, and advanced biomarker evaluations are conducted.&lt;SEP&gt;Specialized medical facilities and hospitals that provide comprehensive cancer treatment, second opinions, and integrative oncology programs.&lt;SEP&gt;Specialized medical facilities and institutions equipped with experienced teams to manage and treat rare malignancies such as gray zone lymphomas.</data>
      <data key="d3">chunk-44a870810cef881997b741c32ec368fe&lt;SEP&gt;chunk-8ba71a5181f3814dffb21d3399441bea&lt;SEP&gt;chunk-bc89a92e9a97781ebca0db50abc34939</data>
    </node>
    <node id="Advance Care Planning">
      <data key="d0">Advance Care Planning</data>
      <data key="d1">category</data>
      <data key="d2">A structured process of communication and decision-making regarding future medical decisions and end-of-life care for patients with advanced disease.</data>
      <data key="d3">chunk-8ba71a5181f3814dffb21d3399441bea</data>
    </node>
    <node id="Palliative Care">
      <data key="d0">Palliative Care</data>
      <data key="d1">category</data>
      <data key="d2">Specialized supportive medical care focusing on relief from symptoms, pain, and stress for individuals living with advanced or metastatic cancers.</data>
      <data key="d3">chunk-8ba71a5181f3814dffb21d3399441bea</data>
    </node>
    <node id="Hospice Care">
      <data key="d0">Hospice Care</data>
      <data key="d1">category</data>
      <data key="d2">A model of compassionate, comfort-oriented end-of-life care provided as a component of supportive care when curative interventions are not viable.</data>
      <data key="d3">chunk-8ba71a5181f3814dffb21d3399441bea</data>
    </node>
    <node id="First-Line Therapy">
      <data key="d0">First-Line Therapy</data>
      <data key="d1">category</data>
      <data key="d2">The initial systemic therapy regimen chosen to treat metastatic cancer, often selected based on specific biomarker profiles.</data>
      <data key="d3">chunk-8ba71a5181f3814dffb21d3399441bea</data>
    </node>
    <node id="Second-Line Therapy">
      <data key="d0">Second-Line Therapy</data>
      <data key="d1">category</data>
      <data key="d2">Subsequent systemic treatment options administered when first-line therapies fail or platinum-based chemotherapy cannot be tolerated.</data>
      <data key="d3">chunk-8ba71a5181f3814dffb21d3399441bea</data>
    </node>
    <node id="Classical Hodgkin Lymphoma">
      <data key="d0">Classical Hodgkin Lymphoma</data>
      <data key="d1">category</data>
      <data key="d2">A subtype of Hodgkin lymphoma (CHL) that shares pathological and clinical overlapping features with mediastinal gray zone lymphoma.&lt;SEP&gt;Classical Hodgkin lymphoma (CHL) is a subtype of lymphoma whose clinical and pathological features overlap with mediastinal gray zone lymphoma.</data>
      <data key="d3">chunk-18b5e32980f3efa0cd012e2abab9b9fc&lt;SEP&gt;chunk-8ba71a5181f3814dffb21d3399441bea</data>
    </node>
    <node id="Hematopathologist">
      <data key="d0">Hematopathologist</data>
      <data key="d1">person</data>
      <data key="d2">A medical specialist trained in diagnosing diseases of the blood and lymphoid tissues whose expert review is required to confirm gray zone lymphoma.&lt;SEP&gt;A medical specialist who evaluates blood smears, lymph nodes, and bone marrow samples under a microscope to detect signs of disease.&lt;SEP&gt;A medical specialist who is an expert at diagnosing cancers of blood and immune cells by examining blood, bone marrow, and lymph node samples.</data>
      <data key="d3">chunk-098a64d7118fc8e1eb3e91ba0124258c&lt;SEP&gt;chunk-717174ace5855cc823d51c46c9a70648&lt;SEP&gt;chunk-8ba71a5181f3814dffb21d3399441bea</data>
    </node>
    <node id="Thyroid Cancer">
      <data key="d0">Thyroid Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A cancer of the thyroid gland, which in metastatic forms may be managed via monitoring, levothyroxine, targeted therapy, or clinical trials.&lt;SEP&gt;A category of cancer affecting the thyroid gland, treated via surgery, RAI therapy, targeted therapies, or radiation depending on its progression.&lt;SEP&gt;A malignancy originating in the thyroid gland that requires tailored surgical, diagnostic, and systemic treatment strategies.&lt;SEP&gt;Thyroid cancer is a malignancy of the thyroid gland, frequently diagnosed in young adults aged 18 to 33, with risks associated with radiation exposure and inherited syndromes.</data>
      <data key="d3">chunk-121b68d5de585c87804c9bce3cdc71eb&lt;SEP&gt;chunk-cd2be7a2ce722f07b19c80e6e1690a8e&lt;SEP&gt;chunk-18b5e32980f3efa0cd012e2abab9b9fc&lt;SEP&gt;chunk-9d383e4798456aa46e381fd2b02f6f96</data>
    </node>
    <node id="Cowden Syndrome">
      <data key="d0">Cowden Syndrome</data>
      <data key="d1">category</data>
      <data key="d2">Cowden syndrome, also called PTEN hamartoma tumor syndrome (PHTS), is an inherited condition that increases the risk of follicular thyroid cancer and other malignancies.</data>
      <data key="d3">chunk-18b5e32980f3efa0cd012e2abab9b9fc</data>
    </node>
    <node id="Multiple Endocrine Neoplasia">
      <data key="d0">Multiple Endocrine Neoplasia</data>
      <data key="d1">category</data>
      <data key="d2">Multiple endocrine neoplasia (MEN) is a group of hereditary syndromes associated with an increased susceptibility to thyroid cancer.</data>
      <data key="d3">chunk-18b5e32980f3efa0cd012e2abab9b9fc</data>
    </node>
    <node id="Non-Hodgkin PMBL">
      <data key="d0">Non-Hodgkin PMBL</data>
      <data key="d1">category</data>
      <data key="d2">Primary mediastinal large B-cell lymphoma (PMBL) is a subtype of non-Hodgkin lymphoma that shares clinical and pathological features with mediastinal gray zone lymphoma.</data>
      <data key="d3">chunk-18b5e32980f3efa0cd012e2abab9b9fc</data>
    </node>
    <node id="Follicular Thyroid Cancer">
      <data key="d0">Follicular Thyroid Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A differentiated thyroid cancer subtype eligible for radioactive iodine therapy when distant metastases absorb iodine.&lt;SEP&gt;Follicular thyroid cancer is a distinct histologic subtype of thyroid cancer that can be caused by inherited genetic conditions such as Cowden syndrome.</data>
      <data key="d3">chunk-18b5e32980f3efa0cd012e2abab9b9fc&lt;SEP&gt;chunk-9d383e4798456aa46e381fd2b02f6f96</data>
    </node>
    <node id="Thyroid Nodules">
      <data key="d0">Thyroid Nodules</data>
      <data key="d1">category</data>
      <data key="d2">Thyroid nodules are abnormal growths of tissue within the thyroid gland that are mostly benign but can occasionally be cancerous.</data>
      <data key="d3">chunk-18b5e32980f3efa0cd012e2abab9b9fc</data>
    </node>
    <node id="Hyperthyroidism">
      <data key="d0">Hyperthyroidism</data>
      <data key="d1">category</data>
      <data key="d2">An endocrine disorder marked by an overactive thyroid and abnormally low TSH levels, often linked to hormone-producing nodules.&lt;SEP&gt;Hyperthyroidism, or an overactive thyroid, is a clinical condition characterized by high thyroid hormone levels and suppressed or low thyroid-stimulating hormone (TSH) levels.</data>
      <data key="d3">chunk-8a1130b0f6bbe935ceddbafc6ce2740f&lt;SEP&gt;chunk-18b5e32980f3efa0cd012e2abab9b9fc</data>
    </node>
    <node id="Adolescent And Young Adult Cancer">
      <data key="d0">Adolescent And Young Adult Cancer</data>
      <data key="d1">category</data>
      <data key="d2">Adolescent and young adult cancer refers to malignancies occurring in individuals aged 18 to 33, a demographic group where thyroid cancer is the most prevalent malignancy.</data>
      <data key="d3">chunk-18b5e32980f3efa0cd012e2abab9b9fc</data>
    </node>
    <node id="Chemoimmunotherapy">
      <data key="d0">Chemoimmunotherapy</data>
      <data key="d1">category</data>
      <data key="d2">Chemoimmunotherapy is a cancer treatment modality combining standard chemotherapy with immunotherapy drugs, such as rituximab, used to treat mediastinal gray zone lymphoma.&lt;SEP&gt;Chemoimmunotherapy is an oncologic treatment approach combining chemotherapy and immunotherapy targeting specific biomarkers in CLL.</data>
      <data key="d3">chunk-67015f3916810c4378b2ed269cc27f29&lt;SEP&gt;chunk-18b5e32980f3efa0cd012e2abab9b9fc</data>
    </node>
    <node id="Involved-Site Radiation Therapy">
      <data key="d0">Involved-Site Radiation Therapy</data>
      <data key="d1">category</data>
      <data key="d2">Involved-site radiation therapy (ISRT) is a targeted radiation treatment method used for patients with localized mediastinal gray zone lymphoma.</data>
      <data key="d3">chunk-18b5e32980f3efa0cd012e2abab9b9fc</data>
    </node>
    <node id="TSH Test">
      <data key="d0">TSH Test</data>
      <data key="d1">category</data>
      <data key="d2">A diagnostic blood test measuring thyroid-stimulating hormone levels to assess thyroid gland function and evaluate nodule activity.&lt;SEP&gt;The thyroid-stimulating hormone (TSH) test is a blood diagnostic test used to evaluate nodule hormone production and guide thyroid cancer evaluation.</data>
      <data key="d3">chunk-8a1130b0f6bbe935ceddbafc6ce2740f&lt;SEP&gt;chunk-18b5e32980f3efa0cd012e2abab9b9fc</data>
    </node>
    <node id="Radioactive Iodine Uptake Test">
      <data key="d0">Radioactive Iodine Uptake Test</data>
      <data key="d1">category</data>
      <data key="d2">A diagnostic evaluation ordered by a provider to assess thyroid nodule function and thyroid hormone production.&lt;SEP&gt;The radioactive iodine (RAI) uptake test is a diagnostic imaging assessment used to evaluate thyroid gland and nodule function.</data>
      <data key="d3">chunk-8a1130b0f6bbe935ceddbafc6ce2740f&lt;SEP&gt;chunk-18b5e32980f3efa0cd012e2abab9b9fc</data>
    </node>
    <node id="Radiation Exposure">
      <data key="d0">Radiation Exposure</data>
      <data key="d1">category</data>
      <data key="d2">Radiation exposure, including therapeutic neck irradiation or environmental contamination, is a major established risk factor for developing thyroid cancer.</data>
      <data key="d3">chunk-18b5e32980f3efa0cd012e2abab9b9fc</data>
    </node>
    <node id="Catastrophic Event">
      <data key="d0">Catastrophic Event</data>
      <data key="d1">event</data>
      <data key="d2">A catastrophic event involving environmental radiation release represents a significant source of exposure that elevates thyroid cancer risk.</data>
      <data key="d3">chunk-18b5e32980f3efa0cd012e2abab9b9fc</data>
    </node>
    <node id="Papillary Carcinoma">
      <data key="d0">Papillary Carcinoma</data>
      <data key="d1">category</data>
      <data key="d2">The most common classification and type of thyroid cancer, categorized as a differentiated thyroid cancer.</data>
      <data key="d3">chunk-8a1130b0f6bbe935ceddbafc6ce2740f</data>
    </node>
    <node id="Follicular Carcinoma">
      <data key="d0">Follicular Carcinoma</data>
      <data key="d1">category</data>
      <data key="d2">The second most common type of thyroid cancer, classified as one of the differentiated thyroid cancers.</data>
      <data key="d3">chunk-8a1130b0f6bbe935ceddbafc6ce2740f</data>
    </node>
    <node id="Oncocytic Carcinoma">
      <data key="d0">Oncocytic Carcinoma</data>
      <data key="d1">category</data>
      <data key="d2">A specific classification of thyroid cancer grouped under differentiated thyroid cancers.&lt;SEP&gt;Oncocytic carcinoma, formerly known as Hürthle cell carcinoma (HCC), is an uncommon thyroid cancer more prone to spreading to lymph nodes and invading blood vessels.</data>
      <data key="d3">chunk-8a1130b0f6bbe935ceddbafc6ce2740f&lt;SEP&gt;chunk-b8a273f96e02707e2e87fc43353ed57f</data>
    </node>
    <node id="Differentiated Thyroid Cancers">
      <data key="d0">Differentiated Thyroid Cancers</data>
      <data key="d1">category</data>
      <data key="d2">A broader category of slow-growing thyroid malignancies that includes papillary, follicular, and oncocytic carcinomas.&lt;SEP&gt;A group of thyroid cancers including papillary, follicular, and oncocytic carcinoma that generally grow slowly and have favorable treatment outcomes.</data>
      <data key="d3">chunk-8a1130b0f6bbe935ceddbafc6ce2740f&lt;SEP&gt;chunk-e74c94f9f2ff33172671e8742338c6d1</data>
    </node>
    <node id="Medullary Thyroid Cancer">
      <data key="d0">Medullary Thyroid Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A distinct category of thyroid cancer for which radioactive iodine therapy is not effective.&lt;SEP&gt;A distinct subtype of thyroid cancer that may harbor RET gene fusions and requires specific diagnostic and therapeutic considerations.&lt;SEP&gt;The third most common form of thyroid cancer, which can have an inherited genetic component running in families.</data>
      <data key="d3">chunk-8a1130b0f6bbe935ceddbafc6ce2740f&lt;SEP&gt;chunk-9d383e4798456aa46e381fd2b02f6f96&lt;SEP&gt;chunk-1e017cd4fd8af1ebbcb582a93fbfe1ea</data>
    </node>
    <node id="Anaplastic Thyroid Cancer">
      <data key="d0">Anaplastic Thyroid Cancer</data>
      <data key="d1">category</data>
      <data key="d2">An aggressive form of thyroid cancer for which external beam radiation therapy is commonly utilized.&lt;SEP&gt;An aggressive form of thyroid cancer that is not responsive to radioactive iodine therapy and is almost always treated with radiation therapy.&lt;SEP&gt;The least common and most aggressive type of thyroid cancer, often treated with combined chemotherapy and radiation therapy.&lt;SEP&gt;The most aggressive and rare category of thyroid cancer, which predominantly affects older adults.</data>
      <data key="d3">chunk-8a1130b0f6bbe935ceddbafc6ce2740f&lt;SEP&gt;chunk-cd2be7a2ce722f07b19c80e6e1690a8e&lt;SEP&gt;chunk-e74c94f9f2ff33172671e8742338c6d1&lt;SEP&gt;chunk-1e017cd4fd8af1ebbcb582a93fbfe1ea</data>
    </node>
    <node id="Lobectomy">
      <data key="d0">Lobectomy</data>
      <data key="d1">event</data>
      <data key="d2">A surgical procedure involving the partial removal of the thyroid gland, evaluated as an option when cancer has not spread beyond the thyroid.&lt;SEP&gt;A surgical procedure involving the partial removal of the thyroid gland, requiring distinct surveillance methods compared to total thyroidectomy.&lt;SEP&gt;A surgical procedure performed under general anesthesia that removes the cancerous lobe and isthmus of the thyroid gland.&lt;SEP&gt;A surgical procedure removing part of the thyroid, suitable for small, low-risk, noninvasive cancers.</data>
      <data key="d3">chunk-8a1130b0f6bbe935ceddbafc6ce2740f&lt;SEP&gt;chunk-9d383e4798456aa46e381fd2b02f6f96&lt;SEP&gt;chunk-e74c94f9f2ff33172671e8742338c6d1&lt;SEP&gt;chunk-b8a273f96e02707e2e87fc43353ed57f</data>
    </node>
    <node id="Total Thyroidectomy">
      <data key="d0">Total Thyroidectomy</data>
      <data key="d1">event</data>
      <data key="d2">A surgical procedure involving the complete removal of the thyroid gland, often preceding radioactive iodine therapy.&lt;SEP&gt;A surgical procedure involving the complete removal of the thyroid gland, recommended for tumors larger than 4 cm or those extending beyond the thyroid.&lt;SEP&gt;A surgical procedure involving the complete removal of the thyroid gland, requiring specific post-operative surveillance protocols including Tg testing.&lt;SEP&gt;A surgical procedure removing the entire thyroid gland, and sometimes adjacent lymph nodes, to treat thyroid cancer.&lt;SEP&gt;Surgical removal of the entire thyroid gland, used for larger, higher-risk, or invasive thyroid cancers.</data>
      <data key="d3">chunk-8a1130b0f6bbe935ceddbafc6ce2740f&lt;SEP&gt;chunk-e74c94f9f2ff33172671e8742338c6d1&lt;SEP&gt;chunk-1e017cd4fd8af1ebbcb582a93fbfe1ea&lt;SEP&gt;chunk-b8a273f96e02707e2e87fc43353ed57f&lt;SEP&gt;chunk-9d383e4798456aa46e381fd2b02f6f96</data>
    </node>
    <node id="Thyroid Hormone Replacement Therapy">
      <data key="d0">Thyroid Hormone Replacement Therapy</data>
      <data key="d1">category</data>
      <data key="d2">A medical treatment using levothyroxine to replace thyroid hormones and maintain low or normal TSH levels following thyroid surgery.&lt;SEP&gt;A therapeutic category involving synthetic thyroid hormone (such as levothyroxine) used to restore hormone levels and suppress TSH to prevent cancer recurrence.&lt;SEP&gt;A therapeutic medical regimen using synthetic hormone replacement medications, such as levothyroxine, required after thyroid removal.&lt;SEP&gt;A treatment, often using levothyroxine, required after total thyroidectomy or certain lobectomies to replace hormones and regulate TSH levels.</data>
      <data key="d3">chunk-8a1130b0f6bbe935ceddbafc6ce2740f&lt;SEP&gt;chunk-b8a273f96e02707e2e87fc43353ed57f&lt;SEP&gt;chunk-e74c94f9f2ff33172671e8742338c6d1&lt;SEP&gt;chunk-1e017cd4fd8af1ebbcb582a93fbfe1ea</data>
    </node>
    <node id="Provider">
      <data key="d0">Provider</data>
      <data key="d1">person</data>
      <data key="d2">A medical clinician or physician who evaluates patient nodules, orders laboratory and imaging tests, and directs cancer management plans.</data>
      <data key="d3">chunk-8a1130b0f6bbe935ceddbafc6ce2740f</data>
    </node>
    <node id="Molecular Tests">
      <data key="d0">Molecular Tests</data>
      <data key="d1">category</data>
      <data key="d2">Diagnostic genetic and molecular testing methods performed on biopsy specimens to assess malignancy risk and determine the necessity of surgery.</data>
      <data key="d3">chunk-8a1130b0f6bbe935ceddbafc6ce2740f</data>
    </node>
    <node id="Neck Dissection">
      <data key="d0">Neck Dissection</data>
      <data key="d1">event</data>
      <data key="d2">A surgical procedure performed during thyroidectomy to remove cervical lymph nodes known or suspected to contain cancer.</data>
      <data key="d3">chunk-8a1130b0f6bbe935ceddbafc6ce2740f</data>
    </node>
    <node id="Hypoparathyroidism">
      <data key="d0">Hypoparathyroidism</data>
      <data key="d1">category</data>
      <data key="d2">An endocrine condition resulting in low blood calcium levels that can arise as a long-term complication of thyroid surgery.</data>
      <data key="d3">chunk-8a1130b0f6bbe935ceddbafc6ce2740f</data>
    </node>
    <node id="Differentiated Thyroid Cancer">
      <data key="d0">Differentiated Thyroid Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A broad classification of thyroid cancers that commonly responds to thyroid hormone suppression and radioactive iodine therapy.</data>
      <data key="d3">chunk-1e017cd4fd8af1ebbcb582a93fbfe1ea</data>
    </node>
    <node id="Papillary Cancer">
      <data key="d0">Papillary Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A common form of differentiated thyroid cancer for which external beam radiation therapy is rarely indicated.</data>
      <data key="d3">chunk-1e017cd4fd8af1ebbcb582a93fbfe1ea</data>
    </node>
    <node id="Follicular Cancer">
      <data key="d0">Follicular Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A form of differentiated thyroid cancer for which external beam radiation therapy is infrequently used.</data>
      <data key="d3">chunk-1e017cd4fd8af1ebbcb582a93fbfe1ea</data>
    </node>
    <node id="Radioactive Iodine Therapy">
      <data key="d0">Radioactive Iodine Therapy</data>
      <data key="d1">category</data>
      <data key="d2">A targeted cancer therapy using radioactive iodine-131 to destroy remaining thyroid cells and metastatic cancer following surgery.&lt;SEP&gt;A treatment (RAI therapy) used following thyroidectomy to eliminate residual cancer cells in the body.&lt;SEP&gt;A treatment (RAI) used in thyroid cancer management when cancer cells absorb iodine.&lt;SEP&gt;Radioactive iodine (RAI) therapy is a post-surgical medical treatment used to eliminate residual thyroid cancer cells in the body.</data>
      <data key="d3">chunk-121b68d5de585c87804c9bce3cdc71eb&lt;SEP&gt;chunk-b8a273f96e02707e2e87fc43353ed57f&lt;SEP&gt;chunk-e74c94f9f2ff33172671e8742338c6d1&lt;SEP&gt;chunk-1e017cd4fd8af1ebbcb582a93fbfe1ea</data>
    </node>
    <node id="Whole-Body RAI Scan">
      <data key="d0">Whole-Body RAI Scan</data>
      <data key="d1">event</data>
      <data key="d2">A diagnostic nuclear medicine imaging procedure conducted before or after radioactive iodine therapy to locate residual thyroid tissue or cancer spread.</data>
      <data key="d3">chunk-1e017cd4fd8af1ebbcb582a93fbfe1ea</data>
    </node>
    <node id="Endocrinologist">
      <data key="d0">Endocrinologist</data>
      <data key="d1">person</data>
      <data key="d2">A medical specialist in hormone conditions who serves as part of the multidisciplinary thyroid cancer treatment team.</data>
      <data key="d3">chunk-1e017cd4fd8af1ebbcb582a93fbfe1ea</data>
    </node>
    <node id="Nuclear Medicine Specialist">
      <data key="d0">Nuclear Medicine Specialist</data>
      <data key="d1">person</data>
      <data key="d2">A medical physician specialized in radioactive materials who administers radioactive iodine treatments and scans.</data>
      <data key="d3">chunk-1e017cd4fd8af1ebbcb582a93fbfe1ea</data>
    </node>
    <node id="Thyrotoxicosis">
      <data key="d0">Thyrotoxicosis</data>
      <data key="d1">category</data>
      <data key="d2">A clinical condition caused by an excess of thyroid hormone in the body, which can result from excessive levothyroxine dosage.</data>
      <data key="d3">chunk-1e017cd4fd8af1ebbcb582a93fbfe1ea</data>
    </node>
    <node id="Remnant Ablation">
      <data key="d0">Remnant Ablation</data>
      <data key="d1">event</data>
      <data key="d2">A low-dose radioactive iodine-131 procedure performed shortly after thyroidectomy to eliminate remaining normal thyroid tissue.</data>
      <data key="d3">chunk-1e017cd4fd8af1ebbcb582a93fbfe1ea</data>
    </node>
    <node id="Thyroidectomy">
      <data key="d0">Thyroidectomy</data>
      <data key="d1">event</data>
      <data key="d2">Surgical removal of all or part of the thyroid gland, often considered before radioactive iodine therapy.</data>
      <data key="d3">chunk-1e017cd4fd8af1ebbcb582a93fbfe1ea</data>
    </node>
    <node id="U.S. FDA">
      <data key="d0">U.S. FDA</data>
      <data key="d1">organization</data>
      <data key="d2">The U.S. Food and Drug Administration (FDA) is the regulatory agency responsible for evaluating and approving investigational medical treatments tested in clinical trials.&lt;SEP&gt;The U.S. Food and Drug Administration is the regulatory authority responsible for approving investigational treatments evaluated in clinical trials.&lt;SEP&gt;The United States Food and Drug Administration is the regulatory agency responsible for reviewing and approving new cancer drugs, devices, and treatment approaches evaluated in clinical trials.</data>
      <data key="d3">chunk-cd2be7a2ce722f07b19c80e6e1690a8e&lt;SEP&gt;chunk-6236b93e627d54f73f1c8fe341127e67&lt;SEP&gt;chunk-e74c94f9f2ff33172671e8742338c6d1</data>
    </node>
    <node id="Kinase Inhibitors">
      <data key="d0">Kinase Inhibitors</data>
      <data key="d1">category</data>
      <data key="d2">A class of targeted therapy medications, mostly oral capsules, used to treat specific forms of thyroid cancer.</data>
      <data key="d3">chunk-cd2be7a2ce722f07b19c80e6e1690a8e</data>
    </node>
    <node id="External Radiation">
      <data key="d0">External Radiation</data>
      <data key="d1">category</data>
      <data key="d2">A specific form of radiation therapy delivered from an external machine to targeted areas like the neck to treat tumors and relieve cancer symptoms.</data>
      <data key="d3">chunk-cd2be7a2ce722f07b19c80e6e1690a8e</data>
    </node>
    <node id="RAI Therapy">
      <data key="d0">RAI Therapy</data>
      <data key="d1">category</data>
      <data key="d2">Radioactive iodine therapy used post-surgery to ablate residual thyroid tissue and treat iodine-avid recurrent or metastatic thyroid cancer.&lt;SEP&gt;Radioactive iodine therapy, a primary treatment option for thyroid cancer before alternative systemic or targeted therapies are considered.</data>
      <data key="d3">chunk-cd2be7a2ce722f07b19c80e6e1690a8e&lt;SEP&gt;chunk-9d383e4798456aa46e381fd2b02f6f96</data>
    </node>
    <node id="Study Sponsor">
      <data key="d0">Study Sponsor</data>
      <data key="d1">organization</data>
      <data key="d2">An organization or entity funding clinical research and covering research-related costs such as investigational study drugs.</data>
      <data key="d3">chunk-cd2be7a2ce722f07b19c80e6e1690a8e</data>
    </node>
    <node id="Papillary Thyroid Carcinoma">
      <data key="d0">Papillary Thyroid Carcinoma</data>
      <data key="d1">category</data>
      <data key="d2">The most common type of thyroid cancer, often treated with lobectomy or total thyroidectomy, or managed through active surveillance in low-risk cases.</data>
      <data key="d3">chunk-e74c94f9f2ff33172671e8742338c6d1</data>
    </node>
    <node id="Follicular and Oncocytic Carcinoma">
      <data key="d0">Follicular and Oncocytic Carcinoma</data>
      <data key="d1">category</data>
      <data key="d2">Subtypes of differentiated thyroid cancer that typically grow slowly and are treated surgically.</data>
      <data key="d3">chunk-e74c94f9f2ff33172671e8742338c6d1</data>
    </node>
    <node id="Completion Thyroidectomy">
      <data key="d0">Completion Thyroidectomy</data>
      <data key="d1">category</data>
      <data key="d2">A secondary surgical procedure performed to remove the remaining portion of the thyroid gland following high-risk findings from an initial lobectomy.&lt;SEP&gt;A subsequent surgical procedure to remove the remainder of the thyroid following a previous lobectomy when high-risk or invasive features are identified.</data>
      <data key="d3">chunk-e74c94f9f2ff33172671e8742338c6d1&lt;SEP&gt;chunk-b8a273f96e02707e2e87fc43353ed57f</data>
    </node>
    <node id="Levothyroxine">
      <data key="d0">Levothyroxine</data>
      <data key="d1">category</data>
      <data key="d2">A synthetic hormone medication used in lifelong thyroid hormone replacement therapy to keep thyroid-stimulating hormone (TSH) levels low or normal.&lt;SEP&gt;A thyroid hormone replacement drug taken by patients to replace thyroid function and suppress TSH levels to prevent cancer progression.</data>
      <data key="d3">chunk-9d383e4798456aa46e381fd2b02f6f96&lt;SEP&gt;chunk-e74c94f9f2ff33172671e8742338c6d1</data>
    </node>
    <node id="Classic Type Papillary Thyroid Cancer">
      <data key="d0">Classic Type Papillary Thyroid Cancer</data>
      <data key="d1">category</data>
      <data key="d2">The most frequently diagnosed subtype of papillary thyroid carcinoma.</data>
      <data key="d3">chunk-e74c94f9f2ff33172671e8742338c6d1</data>
    </node>
    <node id="Follicular Variant of Papillary Thyroid Cancer">
      <data key="d0">Follicular Variant of Papillary Thyroid Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A subtype of papillary thyroid cancer that may present different growth patterns compared to classic variants.</data>
      <data key="d3">chunk-e74c94f9f2ff33172671e8742338c6d1</data>
    </node>
    <node id="Tall-Cell/Columnar Cell Carcinoma">
      <data key="d0">Tall-Cell/Columnar Cell Carcinoma</data>
      <data key="d1">category</data>
      <data key="d2">An aggressive subtype of papillary thyroid carcinoma characterized by faster growth and greater propensity to spread.</data>
      <data key="d3">chunk-e74c94f9f2ff33172671e8742338c6d1</data>
    </node>
    <node id="Hobnail Variant">
      <data key="d0">Hobnail Variant</data>
      <data key="d1">category</data>
      <data key="d2">A subtype of papillary thyroid cancer known to grow and spread more rapidly.</data>
      <data key="d3">chunk-e74c94f9f2ff33172671e8742338c6d1</data>
    </node>
    <node id="Diffuse Sclerosing Variant">
      <data key="d0">Diffuse Sclerosing Variant</data>
      <data key="d1">category</data>
      <data key="d2">A recognized subtype of papillary thyroid cancer that exhibits more aggressive spread.</data>
      <data key="d3">chunk-e74c94f9f2ff33172671e8742338c6d1</data>
    </node>
    <node id="Follicular Thyroid Carcinoma">
      <data key="d0">Follicular Thyroid Carcinoma</data>
      <data key="d1">category</data>
      <data key="d2">Follicular thyroid carcinoma (FTC) is the second most common type of thyroid cancer, characterized by invasion into blood vessels or the outer tumor layer.</data>
      <data key="d3">chunk-b8a273f96e02707e2e87fc43353ed57f</data>
    </node>
    <node id="NIFTP">
      <data key="d0">NIFTP</data>
      <data key="d1">category</data>
      <data key="d2">Noninvasive follicular thyroid neoplasm with papillary-like nuclear features (NIFTP) is a low-risk, noninvasive thyroid tumor formerly considered an encapsulated follicular variant of papillary thyroid cancer.</data>
      <data key="d3">chunk-b8a273f96e02707e2e87fc43353ed57f</data>
    </node>
    <node id="Papillary Thyroid Cancer">
      <data key="d0">Papillary Thyroid Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A common differentiated thyroid cancer subtype that is often treated with RAI therapy when metastatic disease exhibits iodine uptake.&lt;SEP&gt;A common type of thyroid cancer compared against follicular and oncocytic carcinomas, and historically linked to NIFTP.</data>
      <data key="d3">chunk-9d383e4798456aa46e381fd2b02f6f96&lt;SEP&gt;chunk-b8a273f96e02707e2e87fc43353ed57f</data>
    </node>
    <node id="Hürthle Cell Carcinoma">
      <data key="d0">Hürthle Cell Carcinoma</data>
      <data key="d1">category</data>
      <data key="d2">The former medical designation for oncocytic carcinoma, an uncommon and often more aggressive form of thyroid cancer.</data>
      <data key="d3">chunk-b8a273f96e02707e2e87fc43353ed57f</data>
    </node>
    <node id="Differentiated High-Grade Carcinoma">
      <data key="d0">Differentiated High-Grade Carcinoma</data>
      <data key="d1">category</data>
      <data key="d2">A specific diagnostic classification of malignant thyroid tumor characterized by differentiated features but aggressive, high-grade behavior.&lt;SEP&gt;An aggressive subtype of thyroid cancer that serves as an explicit indication for radioactive iodine therapy.</data>
      <data key="d3">chunk-9d383e4798456aa46e381fd2b02f6f96&lt;SEP&gt;chunk-b8a273f96e02707e2e87fc43353ed57f</data>
    </node>
    <node id="Neck Ultrasound">
      <data key="d0">Neck Ultrasound</data>
      <data key="d1">event</data>
      <data key="d2">A non-invasive diagnostic imaging procedure used to inspect the neck for local recurrence of thyroid cancer following surgery.&lt;SEP&gt;A noninvasive post-operative imaging test recommended 6 to 12 months after total thyroidectomy for cancer surveillance.</data>
      <data key="d3">chunk-9d383e4798456aa46e381fd2b02f6f96&lt;SEP&gt;chunk-b8a273f96e02707e2e87fc43353ed57f</data>
    </node>
    <node id="Whole-Body RAI Imaging">
      <data key="d0">Whole-Body RAI Imaging</data>
      <data key="d1">event</data>
      <data key="d2">A specialized follow-up nuclear medicine scan performed after radioactive iodine therapy to locate any residual thyroid cancer cells.</data>
      <data key="d3">chunk-b8a273f96e02707e2e87fc43353ed57f</data>
    </node>
    <node id="Recurrence">
      <data key="d0">Recurrence</data>
      <data key="d1">category</data>
      <data key="d2">The return of cancer after a disease-free interval, which can occur locally at the anus, in regional lymph nodes, or at distant metastatic sites.&lt;SEP&gt;The return of thyroid cancer in the neck or distant areas following initial surgical and adjuvant treatment.</data>
      <data key="d3">chunk-9d383e4798456aa46e381fd2b02f6f96&lt;SEP&gt;chunk-29b3a349650a8bb55b318dcc6ecb0519</data>
    </node>
    <node id="Thyroid-Stimulating Hormone">
      <data key="d0">Thyroid-Stimulating Hormone</data>
      <data key="d1">category</data>
      <data key="d2">A pituitary hormone (TSH) monitored via blood testing to manage thyroid hormone replacement and evaluate thyroid disease status.</data>
      <data key="d3">chunk-9d383e4798456aa46e381fd2b02f6f96</data>
    </node>
    <node id="Thyroglobulin">
      <data key="d0">Thyroglobulin</data>
      <data key="d1">category</data>
      <data key="d2">A protein (Tg) produced exclusively by thyroid tissue, serving as a primary serum tumor marker for monitoring recurrence after total thyroidectomy.</data>
      <data key="d3">chunk-9d383e4798456aa46e381fd2b02f6f96</data>
    </node>
    <node id="Anti-Thyroglobulin Antibodies">
      <data key="d0">Anti-Thyroglobulin Antibodies</data>
      <data key="d1">category</data>
      <data key="d2">Antibodies (Tg ab) produced against thyroglobulin that can interfere with Tg measurement and whose levels help assess treatment response.</data>
      <data key="d3">chunk-9d383e4798456aa46e381fd2b02f6f96</data>
    </node>
    <node id="No Evidence Of Disease">
      <data key="d0">No Evidence Of Disease</data>
      <data key="d1">category</data>
      <data key="d2">A clinical status (NED) indicating that follow-up exams, laboratory tests, and imaging show no signs of persistent or recurrent cancer.</data>
      <data key="d3">chunk-9d383e4798456aa46e381fd2b02f6f96</data>
    </node>
    <node id="Lenvatinib">
      <data key="d0">Lenvatinib</data>
      <data key="d1">category</data>
      <data key="d2">An oral targeted multikinase inhibitor (marketed as Lenvima) designated as a preferred therapy for progressive, unresectable, radioactive iodine-refractory thyroid cancer.</data>
      <data key="d3">chunk-9d383e4798456aa46e381fd2b02f6f96</data>
    </node>
    <node id="Cabozantinib">
      <data key="d0">Cabozantinib</data>
      <data key="d1">category</data>
      <data key="d2">A targeted multikinase inhibitor (marketed as Cabometyx) recommended as a subsequent therapy if cancer progresses after treatment with lenvatinib or sorafenib.</data>
      <data key="d3">chunk-9d383e4798456aa46e381fd2b02f6f96</data>
    </node>
    <node id="Oncocytic Thyroid Cancer">
      <data key="d0">Oncocytic Thyroid Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A subtype of thyroid cancer for which radioactive iodine therapy is indicated in metastatic disease that demonstrates iodine avidity.</data>
      <data key="d3">chunk-9d383e4798456aa46e381fd2b02f6f96</data>
    </node>
    <node id="Bone Cancer">
      <data key="d0">Bone Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A class of malignant disease affecting the skeletal system, primarily staged using the TNM classification system.&lt;SEP&gt;A group of malignancies originating in the bone or cartilage, distinguished as primary bone cancer or secondary metastatic cancer.&lt;SEP&gt;A group of malignant cancers originating in bone tissue that can disrupt normal bone formation and remodeling processes.&lt;SEP&gt;A malignancy of the bone, the diagnosis of which is confirmed through procedures like core needle or surgical biopsy.&lt;SEP&gt;A rare form of cancer and tumor disorders affecting the skeletal system, encompassing several distinct types such as osteosarcoma, chondrosarcoma, and chordoma.&lt;SEP&gt;A type of malignancy staged using T, N, M, and G criteria, which can also be a destination site for metastatic spread from primary liver cancer.</data>
      <data key="d3">chunk-121b68d5de585c87804c9bce3cdc71eb&lt;SEP&gt;chunk-84367cc8f7a94b97b4b66a1ca127c15f&lt;SEP&gt;chunk-ba28a3ce3534c0655a0d08a953d7f038&lt;SEP&gt;chunk-74f18dd51a0091fc888512458a85b0a1&lt;SEP&gt;chunk-30c0bb66b1a2f93e89f5342ab1077451&lt;SEP&gt;chunk-6b02315423350f3598288e189fbcb8ae</data>
    </node>
    <node id="Osteosarcoma">
      <data key="d0">Osteosarcoma</data>
      <data key="d1">category</data>
      <data key="d2">A common primary bone sarcoma that arises in bone-forming cells, typically located in the metaphysis near growth plates.&lt;SEP&gt;A more common type of bone cancer typically managed through a combination of therapeutic modalities.</data>
      <data key="d3">chunk-121b68d5de585c87804c9bce3cdc71eb&lt;SEP&gt;chunk-ba28a3ce3534c0655a0d08a953d7f038</data>
    </node>
    <node id="Ewing Sarcoma">
      <data key="d0">Ewing Sarcoma</data>
      <data key="d1">category</data>
      <data key="d2">A form of bone cancer characterized by chromosomal translocation and gene fusion, most commonly between chromosomes 11 and 22.&lt;SEP&gt;A type of bone cancer whose treatment protocol generally initiates with systemic therapy.&lt;SEP&gt;A type of bone sarcoma originating in the bone marrow, commonly affecting long bones or flat bones like the pelvis and scapula.</data>
      <data key="d3">chunk-30c0bb66b1a2f93e89f5342ab1077451&lt;SEP&gt;chunk-121b68d5de585c87804c9bce3cdc71eb&lt;SEP&gt;chunk-ba28a3ce3534c0655a0d08a953d7f038</data>
    </node>
    <node id="Chondrosarcoma">
      <data key="d0">Chondrosarcoma</data>
      <data key="d1">category</data>
      <data key="d2">A primary bone cancer that originates in cells forming cartilage.&lt;SEP&gt;A specific type of bone cancer typically treated through surgical removal of the tumor.&lt;SEP&gt;A type of bone cancer whose patients are frequently prone to IDH1 gene mutations.</data>
      <data key="d3">chunk-6b02315423350f3598288e189fbcb8ae&lt;SEP&gt;chunk-121b68d5de585c87804c9bce3cdc71eb&lt;SEP&gt;chunk-ba28a3ce3534c0655a0d08a953d7f038</data>
    </node>
    <node id="Chordoma">
      <data key="d0">Chordoma</data>
      <data key="d1">category</data>
      <data key="d2">A rare bone tumor starting in notochordal cells that form the spine, typically occurring in the sacrum or skull base.&lt;SEP&gt;A type of bone cancer with treatment options typically including surgical resection or radiation therapy.</data>
      <data key="d3">chunk-121b68d5de585c87804c9bce3cdc71eb&lt;SEP&gt;chunk-ba28a3ce3534c0655a0d08a953d7f038</data>
    </node>
    <node id="Giant Cell Tumor of Bone">
      <data key="d0">Giant Cell Tumor of Bone</data>
      <data key="d1">category</data>
      <data key="d2">A bone tumor characterized by cell overgrowth in the metaphysis extending into the epiphysis.&lt;SEP&gt;Also known as GCTB, a bone condition that is usually non-cancerous but requires aggressive medical treatment to prevent bone damage.</data>
      <data key="d3">chunk-121b68d5de585c87804c9bce3cdc71eb&lt;SEP&gt;chunk-ba28a3ce3534c0655a0d08a953d7f038</data>
    </node>
    <node id="Multiple Myeloma">
      <data key="d0">Multiple Myeloma</data>
      <data key="d1">category</data>
      <data key="d2">A cancer affecting plasma cells in the bone marrow, highlighted alongside other bone-related malignancies.&lt;SEP&gt;A cancer of plasma cells that weakens immune defenses, increasing susceptibility to anal cancer.</data>
      <data key="d3">chunk-121b68d5de585c87804c9bce3cdc71eb&lt;SEP&gt;chunk-9530f389987c13273449ab22a85170ae</data>
    </node>
    <node id="Primary Bone Cancer">
      <data key="d0">Primary Bone Cancer</data>
      <data key="d1">category</data>
      <data key="d2">Malignancies that originate directly in the bone or cartilage, most commonly classified as sarcomas.</data>
      <data key="d3">chunk-121b68d5de585c87804c9bce3cdc71eb</data>
    </node>
    <node id="Secondary Bone Malignancies">
      <data key="d0">Secondary Bone Malignancies</data>
      <data key="d1">category</data>
      <data key="d2">Metastatic cancers that originate in other organs such as the breast, lungs, or kidneys and spread to the bones.</data>
      <data key="d3">chunk-121b68d5de585c87804c9bce3cdc71eb</data>
    </node>
    <node id="Bone Sarcoma">
      <data key="d0">Bone Sarcoma</data>
      <data key="d1">category</data>
      <data key="d2">A main group of sarcomas that originate within bone-forming cells, comprising cancers such as osteosarcoma.</data>
      <data key="d3">chunk-121b68d5de585c87804c9bce3cdc71eb</data>
    </node>
    <node id="Patients">
      <data key="d0">Patients</data>
      <data key="d1">person</data>
      <data key="d2">Individuals diagnosed with conditions such as thyroid or bone cancer who make treatment decisions using educational guides.&lt;SEP&gt;Individuals diagnosed with or living with a glioma or brain tumor who experience symptoms, undergo testing, and receive treatments.</data>
      <data key="d3">chunk-121b68d5de585c87804c9bce3cdc71eb&lt;SEP&gt;chunk-fa5247d6b8c17e58ab315a0d641c7ad3</data>
    </node>
    <node id="Cancer Experts">
      <data key="d0">Cancer Experts</data>
      <data key="d1">person</data>
      <data key="d2">Respected medical oncologists and clinicians who formulate cancer care recommendations based on the latest scientific research.</data>
      <data key="d3">chunk-121b68d5de585c87804c9bce3cdc71eb</data>
    </node>
    <node id="Bone Cancer Staging">
      <data key="d0">Bone Cancer Staging</data>
      <data key="d1">category</data>
      <data key="d2">The diagnostic process of determining the extent, severity, and anatomical location of bone tumors within the body.</data>
      <data key="d3">chunk-ba28a3ce3534c0655a0d08a953d7f038</data>
    </node>
    <node id="Surgical Biopsy">
      <data key="d0">Surgical Biopsy</data>
      <data key="d1">category</data>
      <data key="d2">An open biopsy method requiring an operating room and an incision to remove a sample of a tumor.</data>
      <data key="d3">chunk-30c0bb66b1a2f93e89f5342ab1077451</data>
    </node>
    <node id="Treating Surgeon">
      <data key="d0">Treating Surgeon</data>
      <data key="d1">person</data>
      <data key="d2">An experienced specialist responsible for performing surgical biopsies and subsequent cancer treatments at a specialized center.</data>
      <data key="d3">chunk-30c0bb66b1a2f93e89f5342ab1077451</data>
    </node>
    <node id="Chromosomal Translocation">
      <data key="d0">Chromosomal Translocation</data>
      <data key="d1">category</data>
      <data key="d2">A genetic error where portions of two different chromosomes break off and switch locations, often causing gene fusions.</data>
      <data key="d3">chunk-30c0bb66b1a2f93e89f5342ab1077451</data>
    </node>
    <node id="EWSR1 Gene">
      <data key="d0">EWSR1 Gene</data>
      <data key="d1">category</data>
      <data key="d2">A gene located on chromosome 22 that commonly fuses with an ETS family gene in Ewing sarcoma.</data>
      <data key="d3">chunk-30c0bb66b1a2f93e89f5342ab1077451</data>
    </node>
    <node id="FLI1 Gene">
      <data key="d0">FLI1 Gene</data>
      <data key="d1">category</data>
      <data key="d2">A member of the ETS gene family located on chromosome 11 that most commonly fuses with EWSR1 in Ewing sarcoma.</data>
      <data key="d3">chunk-30c0bb66b1a2f93e89f5342ab1077451</data>
    </node>
    <node id="Tumor Mutational Burden-High (TMB-H)">
      <data key="d0">Tumor Mutational Burden-High (TMB-H)</data>
      <data key="d1">category</data>
      <data key="d2">A tumor classification indicating 10 or more mutations per million base pairs of tumor DNA.</data>
      <data key="d3">chunk-6b02315423350f3598288e189fbcb8ae</data>
    </node>
    <node id="IDH1 Mutation">
      <data key="d0">IDH1 Mutation</data>
      <data key="d1">category</data>
      <data key="d2">A specific genetic mutation found in conditions such as chondrosarcoma that can be targeted by specific therapies.</data>
      <data key="d3">chunk-6b02315423350f3598288e189fbcb8ae</data>
    </node>
    <node id="Next-Generation Sequencing (NGS)">
      <data key="d0">Next-Generation Sequencing (NGS)</data>
      <data key="d1">category</data>
      <data key="d2">An advanced genetic sequencing method used to analyze DNA sequences and identify detailed mutations in genes.</data>
      <data key="d3">chunk-6b02315423350f3598288e189fbcb8ae</data>
    </node>
    <node id="Polymerase Chain Reaction (PCR)">
      <data key="d0">Polymerase Chain Reaction (PCR)</data>
      <data key="d1">category</data>
      <data key="d2">A highly sensitive molecular testing technique used to make millions or billions of copies of DNA or RNA.</data>
      <data key="d3">chunk-6b02315423350f3598288e189fbcb8ae</data>
    </node>
    <node id="Sarcoma Cancer Center">
      <data key="d0">Sarcoma Cancer Center</data>
      <data key="d1">organization</data>
      <data key="d2">Specialized medical facilities or hospitals equipped to diagnose, biopsy, and treat sarcoma and bone cancer.</data>
      <data key="d3">chunk-6b02315423350f3598288e189fbcb8ae</data>
    </node>
    <node id="Ossification">
      <data key="d0">Ossification</data>
      <data key="d1">category</data>
      <data key="d2">The biological process of new bone formation that starts in the womb and concludes during adolescence when skeletal growth ceases.</data>
      <data key="d3">chunk-6b02315423350f3598288e189fbcb8ae</data>
    </node>
    <node id="Bone Remodeling">
      <data key="d0">Bone Remodeling</data>
      <data key="d1">category</data>
      <data key="d2">A continuous physiological process that replaces mature bone by breaking down and rebuilding tissue to maintain calcium homeostasis.</data>
      <data key="d3">chunk-6b02315423350f3598288e189fbcb8ae</data>
    </node>
    <node id="Osteoblasts">
      <data key="d0">Osteoblasts</data>
      <data key="d1">category</data>
      <data key="d2">Specialized bone-forming cells that synthesize bone tissue using calcium from the bloodstream.</data>
      <data key="d3">chunk-6b02315423350f3598288e189fbcb8ae</data>
    </node>
    <node id="Osteoclasts">
      <data key="d0">Osteoclasts</data>
      <data key="d1">category</data>
      <data key="d2">Specialized bone cells responsible for breaking down bone tissue to release calcium into the bloodstream.</data>
      <data key="d3">chunk-6b02315423350f3598288e189fbcb8ae</data>
    </node>
    <node id="Epiphysis">
      <data key="d0">Epiphysis</data>
      <data key="d1">category</data>
      <data key="d2">An anatomical section at the end of a long bone, covered with cartilage to form a joint.</data>
      <data key="d3">chunk-6b02315423350f3598288e189fbcb8ae</data>
    </node>
    <node id="Metaphysis">
      <data key="d0">Metaphysis</data>
      <data key="d1">category</data>
      <data key="d2">The intermediate anatomical region of a bone located between the physis and diaphysis.</data>
      <data key="d3">chunk-6b02315423350f3598288e189fbcb8ae</data>
    </node>
    <node id="Diaphysis">
      <data key="d0">Diaphysis</data>
      <data key="d1">category</data>
      <data key="d2">The anatomical middle region of a long bone.&lt;SEP&gt;The main shaft or central middle region of a long bone.</data>
      <data key="d3">chunk-6b02315423350f3598288e189fbcb8ae&lt;SEP&gt;chunk-74f18dd51a0091fc888512458a85b0a1</data>
    </node>
    <node id="Physis">
      <data key="d0">Physis</data>
      <data key="d1">category</data>
      <data key="d2">The cartilaginous growth plate of a bone that forms a physeal line or scar following skeletal maturity.&lt;SEP&gt;The growth plate made of cartilage that enables bone elongation and forms a physeal scar after skeletal maturity.</data>
      <data key="d3">chunk-6b02315423350f3598288e189fbcb8ae&lt;SEP&gt;chunk-74f18dd51a0091fc888512458a85b0a1</data>
    </node>
    <node id="T Category">
      <data key="d0">T Category</data>
      <data key="d1">category</data>
      <data key="d2">A component of the TNM staging system that classifies the size, extent, and depth of the primary tumor across different anatomical regions.</data>
      <data key="d3">chunk-74f18dd51a0091fc888512458a85b0a1</data>
    </node>
    <node id="N Category">
      <data key="d0">N Category</data>
      <data key="d1">category</data>
      <data key="d2">A component of the TNM system indicating whether cancer has spread to nearby or regional lymph nodes.</data>
      <data key="d3">chunk-74f18dd51a0091fc888512458a85b0a1</data>
    </node>
    <node id="M Category">
      <data key="d0">M Category</data>
      <data key="d1">category</data>
      <data key="d2">A component of the TNM system designating whether bone cancer has spread to distant body sites, such as the lungs or other bones.</data>
      <data key="d3">chunk-74f18dd51a0091fc888512458a85b0a1</data>
    </node>
    <node id="Appendicular Skeleton">
      <data key="d0">Appendicular Skeleton</data>
      <data key="d1">category</data>
      <data key="d2">An anatomical division consisting of 126 bones of the limbs and shoulder and pelvic girdles, used to define specific T-stage criteria.</data>
      <data key="d3">chunk-74f18dd51a0091fc888512458a85b0a1</data>
    </node>
    <node id="Spine">
      <data key="d0">Spine</data>
      <data key="d1">category</data>
      <data key="d2">An anatomical vertebral column including 24 flexible vertebrae, sacrum, and coccyx, featuring unique tumor staging designations.</data>
      <data key="d3">chunk-74f18dd51a0091fc888512458a85b0a1</data>
    </node>
    <node id="Skeletal Maturity">
      <data key="d0">Skeletal Maturity</data>
      <data key="d1">event</data>
      <data key="d2">A biological developmental milestone after which the growth plate ceases activity and leaves a physeal scar in the bone.</data>
      <data key="d3">chunk-74f18dd51a0091fc888512458a85b0a1</data>
    </node>
    <node id="Shoulder Girdle">
      <data key="d0">Shoulder Girdle</data>
      <data key="d1">category</data>
      <data key="d2">A group of bones connecting the upper arm limbs to the torso, forming part of the appendicular skeleton.</data>
      <data key="d3">chunk-74f18dd51a0091fc888512458a85b0a1</data>
    </node>
    <node id="Pelvic Girdle">
      <data key="d0">Pelvic Girdle</data>
      <data key="d1">category</data>
      <data key="d2">A group of bones connecting the lower leg limbs to the body, forming part of the appendicular skeleton.</data>
      <data key="d3">chunk-74f18dd51a0091fc888512458a85b0a1</data>
    </node>
    <node id="Sacroiliac Joint">
      <data key="d0">Sacroiliac Joint</data>
      <data key="d1">category</data>
      <data key="d2">The anatomical articulation linking the pelvis to the lower spine, evaluated in high-stage T4 pelvic bone tumors.</data>
      <data key="d3">chunk-74f18dd51a0091fc888512458a85b0a1</data>
    </node>
    <node id="Spinal Canal">
      <data key="d0">Spinal Canal</data>
      <data key="d1">category</data>
      <data key="d2">The anatomical cavity within the vertebral column that houses the spinal cord, monitored for invasion by T4 spinal tumors.</data>
      <data key="d3">chunk-74f18dd51a0091fc888512458a85b0a1</data>
    </node>
    <node id="Lung">
      <data key="d0">Lung</data>
      <data key="d1">category</data>
      <data key="d2">A common distant visceral organ site for bone cancer metastasis, designated under subcategory M1a.</data>
      <data key="d3">chunk-74f18dd51a0091fc888512458a85b0a1</data>
    </node>
    <node id="Primary Liver Cancer">
      <data key="d0">Primary Liver Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A medical category encompassing cancers that originate directly in the liver, with hepatocellular carcinoma being the most prevalent type in adults.</data>
      <data key="d3">chunk-84367cc8f7a94b97b4b66a1ca127c15f</data>
    </node>
    <node id="Secondary Liver Cancer">
      <data key="d0">Secondary Liver Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A medical classification referring to cancers that originate in other organs, such as the colon, and spread or metastasize to the liver.</data>
      <data key="d3">chunk-84367cc8f7a94b97b4b66a1ca127c15f</data>
    </node>
    <node id="Hepatocellular Carcinoma">
      <data key="d0">Hepatocellular Carcinoma</data>
      <data key="d1">category</data>
      <data key="d2">A specific category of liver cancer that forms the primary subject of diagnostic evaluation, risk monitoring, and screening programs.&lt;SEP&gt;The most common form of primary liver cancer in adults, often arising from underlying liver disease such as cirrhosis or chronic hepatitis infections.&lt;SEP&gt;The most common type of primary liver cancer in adults, which is the primary focus of patient guidelines and clinical management.</data>
      <data key="d3">chunk-5fdcf47f3da06d3e0213112c96eb93d4&lt;SEP&gt;chunk-d4bc8b1b941d18ac455e5f255e1df8c1&lt;SEP&gt;chunk-84367cc8f7a94b97b4b66a1ca127c15f</data>
    </node>
    <node id="Fibrolamellar Hepatocellular Carcinoma">
      <data key="d0">Fibrolamellar Hepatocellular Carcinoma</data>
      <data key="d1">category</data>
      <data key="d2">A rare subtype of hepatocellular carcinoma that typically occurs in younger individuals and affects a small patient population.</data>
      <data key="d3">chunk-84367cc8f7a94b97b4b66a1ca127c15f</data>
    </node>
    <node id="Intrahepatic Cholangiocarcinoma">
      <data key="d0">Intrahepatic Cholangiocarcinoma</data>
      <data key="d1">category</data>
      <data key="d2">The second most common primary liver cancer in adults, arising specifically within the bile ducts inside the liver.</data>
      <data key="d3">chunk-84367cc8f7a94b97b4b66a1ca127c15f</data>
    </node>
    <node id="Metastatic Liver Cancer">
      <data key="d0">Metastatic Liver Cancer</data>
      <data key="d1">category</data>
      <data key="d2">Cancer that spreads from the liver to distant sites such as the lungs or bones, or secondary cancer originating elsewhere and spreading to the liver.&lt;SEP&gt;Liver cancer that has spread beyond the primary tumor to distant body sites, most frequently the lungs or bones.</data>
      <data key="d3">chunk-d4bc8b1b941d18ac455e5f255e1df8c1&lt;SEP&gt;chunk-84367cc8f7a94b97b4b66a1ca127c15f</data>
    </node>
    <node id="Hepatobiliary System">
      <data key="d0">Hepatobiliary System</data>
      <data key="d1">category</data>
      <data key="d2">A biological anatomical system consisting of the liver, gallbladder, and bile ducts that produces, stores, and transports bile.</data>
      <data key="d3">chunk-84367cc8f7a94b97b4b66a1ca127c15f</data>
    </node>
    <node id="Cancer Research UK">
      <data key="d0">Cancer Research UK</data>
      <data key="d1">organization</data>
      <data key="d2">A cancer research and awareness charity, credited via CRUK for the anatomical diagram of the liver lobes and blood supply.</data>
      <data key="d3">chunk-84367cc8f7a94b97b4b66a1ca127c15f</data>
    </node>
    <node id="Wikimedia Commons">
      <data key="d0">Wikimedia Commons</data>
      <data key="d1">organization</data>
      <data key="d2">An online media repository hosting diagrammatic educational content regarding liver anatomy and blood supply.&lt;SEP&gt;An online open-access media repository cited as the host of medical diagram resources illustrating stomach cancer cells in lymph nodes.&lt;SEP&gt;An online repository and media platform hosting scientific and biomedical imagery.&lt;SEP&gt;An online repository providing open-access educational images and media referenced in medical literature.</data>
      <data key="d3">chunk-098a64d7118fc8e1eb3e91ba0124258c&lt;SEP&gt;chunk-c77e0d4642a374a51f87e7e25b19281f&lt;SEP&gt;chunk-84367cc8f7a94b97b4b66a1ca127c15f&lt;SEP&gt;chunk-717174ace5855cc823d51c46c9a70648</data>
    </node>
    <node id="Sarcoma Of The Liver">
      <data key="d0">Sarcoma Of The Liver</data>
      <data key="d1">category</data>
      <data key="d2">A rare form of primary liver cancer in adults that begins in the blood vessel cells of the liver.</data>
      <data key="d3">chunk-84367cc8f7a94b97b4b66a1ca127c15f</data>
    </node>
    <node id="Mixed-Type Liver Tumor">
      <data key="d0">Mixed-Type Liver Tumor</data>
      <data key="d1">category</data>
      <data key="d2">A rare form of primary liver malignancy composed of both hepatocellular carcinoma and cholangiocarcinoma cells.</data>
      <data key="d3">chunk-84367cc8f7a94b97b4b66a1ca127c15f</data>
    </node>
    <node id="Gallbladder And Bile Duct Tumors">
      <data key="d0">Gallbladder And Bile Duct Tumors</data>
      <data key="d1">category</data>
      <data key="d2">Malignancies developing in the gallbladder and biliary tract covered in specialized patient guidelines.</data>
      <data key="d3">chunk-84367cc8f7a94b97b4b66a1ca127c15f</data>
    </node>
    <node id="Hepatitis">
      <data key="d0">Hepatitis</data>
      <data key="d1">category</data>
      <data key="d2">An inflammatory liver condition listed as a major risk factor associated with liver cancer development.</data>
      <data key="d3">chunk-84367cc8f7a94b97b4b66a1ca127c15f</data>
    </node>
    <node id="GX Grade">
      <data key="d0">GX Grade</data>
      <data key="d1">category</data>
      <data key="d2">A histological grading classification denoting that the degree of cellular differentiation cannot be assessed.</data>
      <data key="d3">chunk-84367cc8f7a94b97b4b66a1ca127c15f</data>
    </node>
    <node id="G1 Grade">
      <data key="d0">G1 Grade</data>
      <data key="d1">category</data>
      <data key="d2">A low-grade histological classification describing well-differentiated cancer cells that closely resemble normal cells.</data>
      <data key="d3">chunk-84367cc8f7a94b97b4b66a1ca127c15f</data>
    </node>
    <node id="G2 Grade">
      <data key="d0">G2 Grade</data>
      <data key="d1">category</data>
      <data key="d2">A high-grade histological classification describing moderately differentiated cancer cells.</data>
      <data key="d3">chunk-84367cc8f7a94b97b4b66a1ca127c15f</data>
    </node>
    <node id="G3 Grade">
      <data key="d0">G3 Grade</data>
      <data key="d1">category</data>
      <data key="d2">A high-grade histological classification describing poorly differentiated cancer cells that look very abnormal compared to normal cells.</data>
      <data key="d3">chunk-84367cc8f7a94b97b4b66a1ca127c15f</data>
    </node>
    <node id="Cirrhosis">
      <data key="d0">Cirrhosis</data>
      <data key="d1">category</data>
      <data key="d2">A chronic liver condition classified as a key risk factor that warrants routine liver cancer screening.&lt;SEP&gt;A chronic liver disease characterized by the scarring of liver tissue, functioning as a primary risk factor for the development of liver cancer.</data>
      <data key="d3">chunk-5fdcf47f3da06d3e0213112c96eb93d4&lt;SEP&gt;chunk-d4bc8b1b941d18ac455e5f255e1df8c1</data>
    </node>
    <node id="Non-Alcoholic Fatty Liver Disease">
      <data key="d0">Non-Alcoholic Fatty Liver Disease</data>
      <data key="d1">category</data>
      <data key="d2">A liver condition occurring in individuals who drink little or no alcohol, linked to obesity, diabetes, and high cholesterol, which can progress to cirrhosis and liver cancer.</data>
      <data key="d3">chunk-d4bc8b1b941d18ac455e5f255e1df8c1</data>
    </node>
    <node id="Genetic Hemochromatosis">
      <data key="d0">Genetic Hemochromatosis</data>
      <data key="d1">category</data>
      <data key="d2">An inherited medical disorder that causes the body and liver to store excessive amounts of iron from food, contributing to cirrhosis.</data>
      <data key="d3">chunk-d4bc8b1b941d18ac455e5f255e1df8c1</data>
    </node>
    <node id="Liver Cancer Screening">
      <data key="d0">Liver Cancer Screening</data>
      <data key="d1">category</data>
      <data key="d2">A preventive medical routine involving ultrasound and alpha-fetoprotein (AFP) testing every six months to detect liver cancer early in high-risk populations.&lt;SEP&gt;A routine testing process performed on asymptomatic individuals at risk, such as those with cirrhosis or chronic hepatitis B, to detect cancer early.</data>
      <data key="d3">chunk-5fdcf47f3da06d3e0213112c96eb93d4&lt;SEP&gt;chunk-d4bc8b1b941d18ac455e5f255e1df8c1</data>
    </node>
    <node id="Primary Biliary Cholangitis">
      <data key="d0">Primary Biliary Cholangitis</data>
      <data key="d1">category</data>
      <data key="d2">A chronic liver disease that, particularly at Stage 4, causes progressive bile duct damage and serves as an established cause of liver cirrhosis.</data>
      <data key="d3">chunk-d4bc8b1b941d18ac455e5f255e1df8c1</data>
    </node>
    <node id="Alpha-1-Antitrypsin Deficiency">
      <data key="d0">Alpha-1-Antitrypsin Deficiency</data>
      <data key="d1">category</data>
      <data key="d2">A genetic disorder leading to a deficiency in the alpha-1-antitrypsin protein, which causes liver damage and acts as a risk factor for cirrhosis.</data>
      <data key="d3">chunk-d4bc8b1b941d18ac455e5f255e1df8c1</data>
    </node>
    <node id="Alpha-Fetoprotein Test">
      <data key="d0">Alpha-Fetoprotein Test</data>
      <data key="d1">category</data>
      <data key="d2">A clinical blood test evaluating levels of alpha-fetoprotein (AFP), an elevated marker indicating the possible presence of primary liver cancer.</data>
      <data key="d3">chunk-d4bc8b1b941d18ac455e5f255e1df8c1</data>
    </node>
    <node id="Chronic Hepatitis B">
      <data key="d0">Chronic Hepatitis B</data>
      <data key="d1">category</data>
      <data key="d2">A chronic viral infection of the liver recognized as a major risk factor requiring ongoing liver cancer screening.</data>
      <data key="d3">chunk-5fdcf47f3da06d3e0213112c96eb93d4</data>
    </node>
    <node id="Liver Cancer">
      <data key="d0">Liver Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A broad category of malignant tumors in the liver, commonly diagnosed using imaging tests and monitored through screening protocols.</data>
      <data key="d3">chunk-5fdcf47f3da06d3e0213112c96eb93d4</data>
    </node>
    <node id="Liver Disease">
      <data key="d0">Liver Disease</data>
      <data key="d1">category</data>
      <data key="d2">A broad medical category encompassing acute and chronic conditions affecting liver health, posing physical and emotional challenges.</data>
      <data key="d3">chunk-5fdcf47f3da06d3e0213112c96eb93d4</data>
    </node>
    <node id="Gastrointestinal Tract">
      <data key="d0">Gastrointestinal Tract</data>
      <data key="d1">category</data>
      <data key="d2">An anatomical pathway within the digestive system comprising the esophagus, stomach, small intestine, colon, and rectum.</data>
      <data key="d3">chunk-5fdcf47f3da06d3e0213112c96eb93d4</data>
    </node>
    <node id="Dad">
      <data key="d0">Dad</data>
      <data key="d1">person</data>
      <data key="d2">A cancer patient who was given a six-month prognosis in 2013 but achieved clinical cure through expert medical care and patient advocacy.</data>
      <data key="d3">chunk-01c80b2d18abb91c5be598d33cf7a33a</data>
    </node>
    <node id="2013 Cancer Diagnosis">
      <data key="d0">2013 Cancer Diagnosis</data>
      <data key="d1">event</data>
      <data key="d2">An event in 2013 where a patient received a critical cancer diagnosis with an initial prognosis of six months to live.</data>
      <data key="d3">chunk-01c80b2d18abb91c5be598d33cf7a33a</data>
    </node>
    <node id="Intestinal Type">
      <data key="d0">Intestinal Type</data>
      <data key="d1">category</data>
      <data key="d2">A major category of stomach adenocarcinoma where cells adhere to form tube- and gland-shaped structures, commonly carrying mutations treatable with targeted therapy.</data>
      <data key="d3">chunk-01c80b2d18abb91c5be598d33cf7a33a</data>
    </node>
    <node id="Diffuse Type">
      <data key="d0">Diffuse Type</data>
      <data key="d1">category</data>
      <data key="d2">A less common category of stomach adenocarcinoma where cells do not stick together and appear scattered across a broad area.</data>
      <data key="d3">chunk-01c80b2d18abb91c5be598d33cf7a33a</data>
    </node>
    <node id="Early-Stage Stomach Cancer">
      <data key="d0">Early-Stage Stomach Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A classification of stomach cancer characterized by tumors that have not spread beyond the innermost mucosa layer.&lt;SEP&gt;A clinical category of gastric cancer that has not grown beyond the first layer (mucosa) of the stomach wall, typically characterized by small tumors of 2 centimeters or less without lymph node involvement.</data>
      <data key="d3">chunk-01c80b2d18abb91c5be598d33cf7a33a&lt;SEP&gt;chunk-c77e0d4642a374a51f87e7e25b19281f</data>
    </node>
    <node id="Narrator">
      <data key="d0">Narrator</data>
      <data key="d1">person</data>
      <data key="d2">The author and family caregiver who helped assemble a team of experts to navigate their father's terminal cancer prognosis and achieve a clinical cure.</data>
      <data key="d3">chunk-01c80b2d18abb91c5be598d33cf7a33a</data>
    </node>
    <node id="Team of Experts">
      <data key="d0">Team of Experts</data>
      <data key="d1">organization</data>
      <data key="d2">A multidisciplinary group of healthcare specialists formed by the narrator's family to navigate and treat the father's advanced cancer diagnosis.</data>
      <data key="d3">chunk-01c80b2d18abb91c5be598d33cf7a33a</data>
    </node>
    <node id="Precancerous Changes">
      <data key="d0">Precancerous Changes</data>
      <data key="d1">category</data>
      <data key="d2">A category of early cellular abnormalities in the stomach mucosa that often develop slowly without symptoms prior to cancer onset.</data>
      <data key="d3">chunk-01c80b2d18abb91c5be598d33cf7a33a</data>
    </node>
    <node id="Layers of the Stomach Wall">
      <data key="d0">Layers of the Stomach Wall</data>
      <data key="d1">category</data>
      <data key="d2">The anatomical classification of the five tissue layers composing the stomach: mucosa, submucosa, muscle layer, subserosa, and serosa.</data>
      <data key="d3">chunk-01c80b2d18abb91c5be598d33cf7a33a</data>
    </node>
    <node id="Mucosa">
      <data key="d0">Mucosa</data>
      <data key="d1">category</data>
      <data key="d2">The innermost layer category of the stomach wall, comprising the surface epithelium, lamina propria, and muscularis mucosae, where stomach cancers typically originate.</data>
      <data key="d3">chunk-01c80b2d18abb91c5be598d33cf7a33a</data>
    </node>
    <node id="Submucosa">
      <data key="d0">Submucosa</data>
      <data key="d1">category</data>
      <data key="d2">A structural layer category of connective tissue, blood vessels, nerve cells, and lymph channels situated beneath the mucosa.</data>
      <data key="d3">chunk-01c80b2d18abb91c5be598d33cf7a33a</data>
    </node>
    <node id="Muscularis Propria">
      <data key="d0">Muscularis Propria</data>
      <data key="d1">category</data>
      <data key="d2">The muscle tissue layer category of the stomach wall responsible for churning and propelling food during digestion.</data>
      <data key="d3">chunk-01c80b2d18abb91c5be598d33cf7a33a</data>
    </node>
    <node id="Subserosa">
      <data key="d0">Subserosa</data>
      <data key="d1">category</data>
      <data key="d2">A supporting connective tissue layer category located directly underneath the serosa.</data>
      <data key="d3">chunk-01c80b2d18abb91c5be598d33cf7a33a</data>
    </node>
    <node id="Serosa">
      <data key="d0">Serosa</data>
      <data key="d1">category</data>
      <data key="d2">The outermost membrane category covering the stomach wall that facilitates smooth movement against adjacent organs.</data>
      <data key="d3">chunk-01c80b2d18abb91c5be598d33cf7a33a</data>
    </node>
    <node id="Digestive Organs">
      <data key="d0">Digestive Organs</data>
      <data key="d1">category</data>
      <data key="d2">The anatomical category of organs involved in processing nutrients and waste, including the stomach, esophagus, liver, pancreas, intestines, and gallbladder.</data>
      <data key="d3">chunk-01c80b2d18abb91c5be598d33cf7a33a</data>
    </node>
    <node id="Locoregional Stomach Cancer">
      <data key="d0">Locoregional Stomach Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A stage or category of stomach cancer that has invaded deeper layers of the stomach wall (submucosa and beyond) and may have spread to nearby lymph nodes or adjacent organs.</data>
      <data key="d3">chunk-c77e0d4642a374a51f87e7e25b19281f</data>
    </node>
    <node id="Metastatic Stomach Cancer">
      <data key="d0">Metastatic Stomach Cancer</data>
      <data key="d1">category</data>
      <data key="d2">An advanced classification of gastric cancer where malignant cells have spread to distant areas of the body, such as the liver, peritoneum, distant lymph nodes, lungs, or bones.</data>
      <data key="d3">chunk-c77e0d4642a374a51f87e7e25b19281f</data>
    </node>
    <node id="Glioma">
      <data key="d0">Glioma</data>
      <data key="d1">category</data>
      <data key="d2">A broad category of brain tumors arising from glial cells, classified based on histology, grade, and molecular biomarkers.&lt;SEP&gt;A category of primary brain tumor originating in glial cells, discussed in terms of diagnosis, causes, types, and potential treatments.&lt;SEP&gt;A common type of malignant brain tumor originating from glial cells in the central nervous system, known for invading normal brain tissue.&lt;SEP&gt;A type of brain tumor that can cause symptoms such as sensory disturbances, vision problems, cognitive changes, weakness, and nausea.&lt;SEP&gt;A type of central nervous system tumor originating from glial cells in the brain or spinal cord, characterized by potential recurrence and disruption of brain function.</data>
      <data key="d3">chunk-ffc3446f8ec092af24a460bda94f772f&lt;SEP&gt;chunk-da0bfe00946dcdff3a8a6fb3d73ce6e1&lt;SEP&gt;chunk-49c7ff3a71e74b3f0eb59258541e739e&lt;SEP&gt;chunk-fa5247d6b8c17e58ab315a0d641c7ad3&lt;SEP&gt;chunk-c77e0d4642a374a51f87e7e25b19281f</data>
    </node>
    <node id="H. Pylori Tests">
      <data key="d0">H. Pylori Tests</data>
      <data key="d1">category</data>
      <data key="d2">A diagnostic category focused on identifying Helicobacter pylori bacterial infection in the stomach.</data>
      <data key="d3">chunk-c77e0d4642a374a51f87e7e25b19281f</data>
    </node>
    <node id="H. Pylori Infection">
      <data key="d0">H. Pylori Infection</data>
      <data key="d1">category</data>
      <data key="d2">A bacterial condition affecting the gastric lining that is relevant to patient medical history and gastric disease risk.</data>
      <data key="d3">chunk-c77e0d4642a374a51f87e7e25b19281f</data>
    </node>
    <node id="Support Person">
      <data key="d0">Support Person</data>
      <data key="d1">person</data>
      <data key="d2">A trusted peer, family member, or friend who assists the patient by providing transportation to visits, meals, note-taking, and emotional support.</data>
      <data key="d3">chunk-c77e0d4642a374a51f87e7e25b19281f</data>
    </node>
    <node id="Astrocytoma">
      <data key="d0">Astrocytoma</data>
      <data key="d1">category</data>
      <data key="d2">A common type of glioma tumor composed of cells resembling star-shaped astrocytes, which maintain the chemical environment for nerve cell communication.&lt;SEP&gt;A subtype of glioma characterized by cells that resemble astrocytes, often identified alongside specific genetic mutations such as IDH.</data>
      <data key="d3">chunk-ffc3446f8ec092af24a460bda94f772f&lt;SEP&gt;chunk-da0bfe00946dcdff3a8a6fb3d73ce6e1</data>
    </node>
    <node id="Oligodendroglioma">
      <data key="d0">Oligodendroglioma</data>
      <data key="d1">category</data>
      <data key="d2">A common type of glioma tumor formed from cells resembling oligodendrocytes, which protect electrical signaling in nerve cells.&lt;SEP&gt;A subtype of glioma characterized by cells that resemble oligodendrocytes under microscopic analysis.</data>
      <data key="d3">chunk-ffc3446f8ec092af24a460bda94f772f&lt;SEP&gt;chunk-da0bfe00946dcdff3a8a6fb3d73ce6e1</data>
    </node>
    <node id="Glioblastoma">
      <data key="d0">Glioblastoma</data>
      <data key="d1">category</data>
      <data key="d2">The most common form of grade 4 glioma, marked by aggressive cellular growth and spread.&lt;SEP&gt;The most destructive and dangerous type of glioma tumor, developing from precursor cells that form astrocytes and oligodendrocytes.</data>
      <data key="d3">chunk-da0bfe00946dcdff3a8a6fb3d73ce6e1&lt;SEP&gt;chunk-bc89a92e9a97781ebca0db50abc34939</data>
    </node>
    <node id="Low-Grade Glioma">
      <data key="d0">Low-Grade Glioma</data>
      <data key="d1">category</data>
      <data key="d2">A classification encompassing Grade 1 and Grade 2 gliomas, characterized by slower growth and distinct prognosis.&lt;SEP&gt;A classification of glioma characterized by slower-growing tumor behavior.</data>
      <data key="d3">chunk-ffc3446f8ec092af24a460bda94f772f&lt;SEP&gt;chunk-da0bfe00946dcdff3a8a6fb3d73ce6e1</data>
    </node>
    <node id="High-Grade Glioma">
      <data key="d0">High-Grade Glioma</data>
      <data key="d1">category</data>
      <data key="d2">A classification encompassing Grade 3 and Grade 4 gliomas, characterized by faster proliferation and invasiveness.&lt;SEP&gt;A classification of glioma characterized by rapid tumor growth and aggressive progression.</data>
      <data key="d3">chunk-ffc3446f8ec092af24a460bda94f772f&lt;SEP&gt;chunk-da0bfe00946dcdff3a8a6fb3d73ce6e1</data>
    </node>
    <node id="Glial Cells">
      <data key="d0">Glial Cells</data>
      <data key="d1">category</data>
      <data key="d2">A category of non-neuronal cells in the central nervous system that support the function of neurons and serve as the cells of origin for gliomas.&lt;SEP&gt;Supportive brain and spinal cord cells that assist nerve cell function and from which gliomas originate when mutations occur.&lt;SEP&gt;Supportive brain cells after which different varieties of gliomas are classified and named.</data>
      <data key="d3">chunk-ffc3446f8ec092af24a460bda94f772f&lt;SEP&gt;chunk-da0bfe00946dcdff3a8a6fb3d73ce6e1&lt;SEP&gt;chunk-fa5247d6b8c17e58ab315a0d641c7ad3</data>
    </node>
    <node id="Cancer Cells">
      <data key="d0">Cancer Cells</data>
      <data key="d1">category</data>
      <data key="d2">A category of abnormal cells that bypass regular cellular regulation, multiply rapidly, crowd out healthy cells, and resist programmed death.</data>
      <data key="d3">chunk-da0bfe00946dcdff3a8a6fb3d73ce6e1</data>
    </node>
    <node id="Normal Cells">
      <data key="d0">Normal Cells</data>
      <data key="d1">category</data>
      <data key="d2">A category of healthy bodily cells that regulate growth according to bodily requirements and die when damaged or aged.</data>
      <data key="d3">chunk-da0bfe00946dcdff3a8a6fb3d73ce6e1</data>
    </node>
    <node id="Specialized Brain Tumor Center">
      <data key="d0">Specialized Brain Tumor Center</data>
      <data key="d1">organization</data>
      <data key="d2">A medical facility or clinical institution with focused clinical experience and specialized expertise in diagnosing and managing brain tumors.</data>
      <data key="d3">chunk-da0bfe00946dcdff3a8a6fb3d73ce6e1</data>
    </node>
    <node id="Astrocytomas">
      <data key="d0">Astrocytomas</data>
      <data key="d1">category</data>
      <data key="d2">One of the three most common subtypes of glioma brain tumors.</data>
      <data key="d3">chunk-fa5247d6b8c17e58ab315a0d641c7ad3</data>
    </node>
    <node id="Oligodendrogliomas">
      <data key="d0">Oligodendrogliomas</data>
      <data key="d1">category</data>
      <data key="d2">One of the three primary types of glioma brain tumors.</data>
      <data key="d3">chunk-fa5247d6b8c17e58ab315a0d641c7ad3</data>
    </node>
    <node id="Glioblastomas">
      <data key="d0">Glioblastomas</data>
      <data key="d1">category</data>
      <data key="d2">One of the most common and aggressive subtypes of glioma tumors.</data>
      <data key="d3">chunk-fa5247d6b8c17e58ab315a0d641c7ad3</data>
    </node>
    <node id="Low-Grade Gliomas">
      <data key="d0">Low-Grade Gliomas</data>
      <data key="d1">category</data>
      <data key="d2">A class of gliomas that typically grow slowly over years and may not immediately produce symptoms.</data>
      <data key="d3">chunk-fa5247d6b8c17e58ab315a0d641c7ad3</data>
    </node>
    <node id="High-Grade Gliomas">
      <data key="d0">High-Grade Gliomas</data>
      <data key="d1">category</data>
      <data key="d2">An advanced classification of gliomas associated with serious complications, including blood clots in the legs and lungs.&lt;SEP&gt;An aggressive classification of gliomas that grow rapidly over weeks or months and produce noticeable symptoms.</data>
      <data key="d3">chunk-49c7ff3a71e74b3f0eb59258541e739e&lt;SEP&gt;chunk-fa5247d6b8c17e58ab315a0d641c7ad3</data>
    </node>
    <node id="Central Nervous System Tumors">
      <data key="d0">Central Nervous System Tumors</data>
      <data key="d1">category</data>
      <data key="d2">Tumors located in the brain and spinal cord that disrupt normal neurological and cognitive functions.</data>
      <data key="d3">chunk-fa5247d6b8c17e58ab315a0d641c7ad3</data>
    </node>
    <node id="Lab Testing">
      <data key="d0">Lab Testing</data>
      <data key="d1">category</data>
      <data key="d2">Diagnostic tests conducted to evaluate health parameters and tumor properties to guide treatment planning.</data>
      <data key="d3">chunk-fa5247d6b8c17e58ab315a0d641c7ad3</data>
    </node>
    <node id="Headaches">
      <data key="d0">Headaches</data>
      <data key="d1">category</data>
      <data key="d2">A common early symptom of gliomas, often occurring in the morning or during the night and potentially accompanied by nausea.</data>
      <data key="d3">chunk-fa5247d6b8c17e58ab315a0d641c7ad3</data>
    </node>
    <node id="Seizures">
      <data key="d0">Seizures</data>
      <data key="d1">category</data>
      <data key="d2">A frequent neurological symptom associated with brain tumors, often serving as an early indicator of low-grade gliomas.</data>
      <data key="d3">chunk-fa5247d6b8c17e58ab315a0d641c7ad3</data>
    </node>
    <node id="Fatigue">
      <data key="d0">Fatigue</data>
      <data key="d1">category</data>
      <data key="d2">A complex physical, cognitive, or emotional symptom characterized by exhaustion, influenced by tumors, medications, lifestyle, or environmental factors.&lt;SEP&gt;A frequent and debilitating symptom experienced by brain tumor patients that is not directly relieved by sleep.</data>
      <data key="d3">chunk-49c7ff3a71e74b3f0eb59258541e739e&lt;SEP&gt;chunk-fa5247d6b8c17e58ab315a0d641c7ad3</data>
    </node>
    <node id="Follow-Up Visits">
      <data key="d0">Follow-Up Visits</data>
      <data key="d1">event</data>
      <data key="d2">Periodic medical checkups recommended after glioma treatment to monitor recurrence and assess disease stability.</data>
      <data key="d3">chunk-fa5247d6b8c17e58ab315a0d641c7ad3</data>
    </node>
    <node id="Parietal Lobe">
      <data key="d0">Parietal Lobe</data>
      <data key="d1">category</data>
      <data key="d2">An anatomical brain region responsible for functions including intelligence, language, reading, sensation, and sensory perception.</data>
      <data key="d3">chunk-49c7ff3a71e74b3f0eb59258541e739e</data>
    </node>
    <node id="Occipital Lobe">
      <data key="d0">Occipital Lobe</data>
      <data key="d1">category</data>
      <data key="d2">An anatomical brain region responsible for visual processing and color perception.</data>
      <data key="d3">chunk-49c7ff3a71e74b3f0eb59258541e739e</data>
    </node>
    <node id="Blood Clots">
      <data key="d0">Blood Clots</data>
      <data key="d1">category</data>
      <data key="d2">A vascular complication in the legs and lungs linked to high-grade gliomas, causing swelling, chest pain, and breathing difficulties.</data>
      <data key="d3">chunk-49c7ff3a71e74b3f0eb59258541e739e</data>
    </node>
    <node id="Neuropathologist">
      <data key="d0">Neuropathologist</data>
      <data key="d1">person</data>
      <data key="d2">A medical specialist who analyzes brain tumor biopsy tissues under a microscope and conducts molecular testing to diagnose and classify tumors.&lt;SEP&gt;A medical specialist who examines tissue samples from tumors to identify specific biomarkers and provide diagnostic information about gliomas.</data>
      <data key="d3">chunk-ffc3446f8ec092af24a460bda94f772f&lt;SEP&gt;chunk-bc89a92e9a97781ebca0db50abc34939</data>
    </node>
    <node id="Biomarkers">
      <data key="d0">Biomarkers</data>
      <data key="d1">category</data>
      <data key="d2">Biological indicators, including gene and protein mutations, evaluated through neuropathology testing to classify gliomas and guide targeted treatments.&lt;SEP&gt;Molecular and genetic characteristics, such as IDH mutations, used to classify gliomas and predict their behavior.</data>
      <data key="d3">chunk-ffc3446f8ec092af24a460bda94f772f&lt;SEP&gt;chunk-bc89a92e9a97781ebca0db50abc34939</data>
    </node>
    <node id="Craniotomy">
      <data key="d0">Craniotomy</data>
      <data key="d1">event</data>
      <data key="d2">A surgical operation in which a section of the skull bone is temporarily removed to access the brain, performed during an open biopsy or resection.</data>
      <data key="d3">chunk-ffc3446f8ec092af24a460bda94f772f</data>
    </node>
    <node id="Hospital Or Medical Center">
      <data key="d0">Hospital Or Medical Center</data>
      <data key="d1">organization</data>
      <data key="d2">A healthcare facility providing neurosurgical and pathology services for tumor diagnosis and management.</data>
      <data key="d3">chunk-ffc3446f8ec092af24a460bda94f772f</data>
    </node>
    <node id="Astrocytes">
      <data key="d0">Astrocytes</data>
      <data key="d1">category</data>
      <data key="d2">A specific type of glial cell that astrocytoma tumor cells morphologically resemble.</data>
      <data key="d3">chunk-ffc3446f8ec092af24a460bda94f772f</data>
    </node>
    <node id="Oligodendrocytes">
      <data key="d0">Oligodendrocytes</data>
      <data key="d1">category</data>
      <data key="d2">A type of glial cell that oligodendroglioma tumor cells resemble under microscopic analysis.</data>
      <data key="d3">chunk-ffc3446f8ec092af24a460bda94f772f</data>
    </node>
    <node id="IDH Gene Mutation">
      <data key="d0">IDH Gene Mutation</data>
      <data key="d1">category</data>
      <data key="d2">A specific genetic biomarker mutation identified during molecular testing to classify gliomas such as astrocytomas.</data>
      <data key="d3">chunk-ffc3446f8ec092af24a460bda94f772f</data>
    </node>
    <node id="Astrocytoma IDH-Mutant Grade 2">
      <data key="d0">Astrocytoma IDH-Mutant Grade 2</data>
      <data key="d1">category</data>
      <data key="d2">An integrated diagnosis combining histology, biomarker status, and tumor grade.</data>
      <data key="d3">chunk-ffc3446f8ec092af24a460bda94f772f</data>
    </node>
    <node id="Grade 1 Glioma">
      <data key="d0">Grade 1 Glioma</data>
      <data key="d1">category</data>
      <data key="d2">A slow-growing, typically benign classification of glioma tumor that is more common in children and often treated primarily with surgery.&lt;SEP&gt;A slow-growing, typically benign glioma type that is more common in children and often manageable with surgery alone.</data>
      <data key="d3">chunk-ffc3446f8ec092af24a460bda94f772f&lt;SEP&gt;chunk-bc89a92e9a97781ebca0db50abc34939</data>
    </node>
    <node id="Grade 2 Glioma">
      <data key="d0">Grade 2 Glioma</data>
      <data key="d1">category</data>
      <data key="d2">A slow-growing classification of glioma with somewhat abnormal cells that can invade normal tissue and may recur years later as a higher-grade tumor.&lt;SEP&gt;A slow-growing glioma with somewhat abnormal cells that can infiltrate normal brain tissue and potentially recur as a higher grade.</data>
      <data key="d3">chunk-ffc3446f8ec092af24a460bda94f772f&lt;SEP&gt;chunk-bc89a92e9a97781ebca0db50abc34939</data>
    </node>
    <node id="Grade 3 Glioma">
      <data key="d0">Grade 3 Glioma</data>
      <data key="d1">category</data>
      <data key="d2">A high-grade glioma category characterized by abnormal cells that multiply rapidly and invade nearby tissue, requiring therapies such as radiation and chemotherapy post-surgery.&lt;SEP&gt;A high-grade glioma subtype marked by abnormal cellular patterns and aggressive clinical behavior.</data>
      <data key="d3">chunk-ffc3446f8ec092af24a460bda94f772f&lt;SEP&gt;chunk-bc89a92e9a97781ebca0db50abc34939</data>
    </node>
    <node id="Grade 4 Glioma">
      <data key="d0">Grade 4 Glioma</data>
      <data key="d1">category</data>
      <data key="d2">The most aggressive classification of glioma with highly abnormal cells that grow and spread very rapidly.</data>
      <data key="d3">chunk-bc89a92e9a97781ebca0db50abc34939</data>
    </node>
    <node id="Small Lymphocytic Lymphoma">
      <data key="d0">Small Lymphocytic Lymphoma</data>
      <data key="d1">category</data>
      <data key="d2">A hematological condition closely related to chronic lymphocytic leukemia that affects the lymphatic system.&lt;SEP&gt;Small lymphocytic lymphoma (SLL) is the same disease as CLL, differing primarily in the primary location of the abnormal cells, which are mostly found in lymph nodes and the spleen.</data>
      <data key="d3">chunk-098a64d7118fc8e1eb3e91ba0124258c&lt;SEP&gt;chunk-bc89a92e9a97781ebca0db50abc34939</data>
    </node>
    <node id="Radiation">
      <data key="d0">Radiation</data>
      <data key="d1">category</data>
      <data key="d2">A cancer therapy utilizing high-energy rays, administered alongside chemotherapy following surgery for high-grade gliomas.&lt;SEP&gt;A cancer treatment modality that uses high-energy rays to treat cancer, capable of causing specific short- and long-term side effects.</data>
      <data key="d3">chunk-541f1323a24c5990b4a6408e0c5442ab&lt;SEP&gt;chunk-bc89a92e9a97781ebca0db50abc34939</data>
    </node>
    <node id="High-Grade Tumors">
      <data key="d0">High-Grade Tumors</data>
      <data key="d1">category</data>
      <data key="d2">A classification of aggressive gliomas comprising grades 3 and 4 that rapidly invade tissue and require multimodal post-surgical therapy.</data>
      <data key="d3">chunk-bc89a92e9a97781ebca0db50abc34939</data>
    </node>
    <node id="DNA Mutation">
      <data key="d0">DNA Mutation</data>
      <data key="d1">category</data>
      <data key="d2">An abnormal change in genetic code that alters cellular behavior and can lead to malignancies such as gliomas or chronic lymphocytic leukemia.</data>
      <data key="d3">chunk-bc89a92e9a97781ebca0db50abc34939</data>
    </node>
    <node id="Richter Transformation">
      <data key="d0">Richter Transformation</data>
      <data key="d1">category</data>
      <data key="d2">Richter transformation is a medical condition associated with lymphoma progression or transformation discussed in patient care materials.&lt;SEP&gt;Richter transformation is a rare complication and disease progression event where CLL develops into a more aggressive lymphoma.&lt;SEP&gt;Richter transformation is a significant medical complication and advanced condition that can develop in patients diagnosed with chronic lymphocytic leukemia.</data>
      <data key="d3">chunk-098a64d7118fc8e1eb3e91ba0124258c&lt;SEP&gt;chunk-67015f3916810c4378b2ed269cc27f29&lt;SEP&gt;chunk-196a80cd0ae47fda3849b101cca91a15</data>
    </node>
    <node id="Mantle Cell Lymphoma">
      <data key="d0">Mantle Cell Lymphoma</data>
      <data key="d1">category</data>
      <data key="d2">Mantle cell lymphoma is a distinct type of lymphoma that lacks proteins such as CD200 and LEF1 found on CLL cells.</data>
      <data key="d3">chunk-098a64d7118fc8e1eb3e91ba0124258c</data>
    </node>
    <node id="NIAID">
      <data key="d0">NIAID</data>
      <data key="d1">organization</data>
      <data key="d2">The National Institute of Allergy and Infectious Diseases (NIAID) is a research organization credited in the source material for medical imagery regarding B cell surface markers.</data>
      <data key="d3">chunk-098a64d7118fc8e1eb3e91ba0124258c</data>
    </node>
    <node id="Minimal Residual Disease">
      <data key="d0">Minimal Residual Disease</data>
      <data key="d1">category</data>
      <data key="d2">A post-treatment clinical condition where cancerous cells are reduced to minimal levels and blood cells are mostly healthy.</data>
      <data key="d3">chunk-098a64d7118fc8e1eb3e91ba0124258c</data>
    </node>
    <node id="Anemia">
      <data key="d0">Anemia</data>
      <data key="d1">category</data>
      <data key="d2">A medical condition characterized by low levels of normal red blood cells, which can trigger the need for CLL treatment.</data>
      <data key="d3">chunk-098a64d7118fc8e1eb3e91ba0124258c</data>
    </node>
    <node id="Blood Smear">
      <data key="d0">Blood Smear</data>
      <data key="d1">event</data>
      <data key="d2">A microscopic examination of a blood drop performed by a hematopathologist and oncologist to identify cancer cell morphology.&lt;SEP&gt;A microscopic laboratory examination of a drop of blood used to inspect the appearance of abnormal cells for clues about cancer.</data>
      <data key="d3">chunk-098a64d7118fc8e1eb3e91ba0124258c&lt;SEP&gt;chunk-717174ace5855cc823d51c46c9a70648</data>
    </node>
    <node id="CLL">
      <data key="d0">CLL</data>
      <data key="d1">category</data>
      <data key="d2">Chronic lymphocytic leukemia (CLL) is a type of blood cancer diagnosed by the presence of at least 5,000 monoclonal B lymphocytes per microliter of blood.</data>
      <data key="d3">chunk-717174ace5855cc823d51c46c9a70648</data>
    </node>
    <node id="Small Lymphocytic Lymphoma (SLL)">
      <data key="d0">Small Lymphocytic Lymphoma (SLL)</data>
      <data key="d1">category</data>
      <data key="d2">Small lymphocytic lymphoma is a form of cancer closely related to CLL that is confirmed through lymph node examinations.</data>
      <data key="d3">chunk-717174ace5855cc823d51c46c9a70648</data>
    </node>
    <node id="Hematologist-Oncologist">
      <data key="d0">Hematologist-Oncologist</data>
      <data key="d1">person</data>
      <data key="d2">A medical specialist who focuses on blood cancers, evaluates diagnostic pathology reports, performs physical examinations, and coordinates cancer treatment plans.</data>
      <data key="d3">chunk-717174ace5855cc823d51c46c9a70648</data>
    </node>
    <node id="Bone Marrow Aspiration">
      <data key="d0">Bone Marrow Aspiration</data>
      <data key="d1">event</data>
      <data key="d2">A clinical procedure performed on the back of the hip bone to extract liquid and cells from the bone marrow.</data>
      <data key="d3">chunk-717174ace5855cc823d51c46c9a70648</data>
    </node>
    <node id="Beta-2 Microglobulin">
      <data key="d0">Beta-2 Microglobulin</data>
      <data key="d1">category</data>
      <data key="d2">A blood laboratory marker tested as part of the workup for planning CLL treatment.</data>
      <data key="d3">chunk-717174ace5855cc823d51c46c9a70648</data>
    </node>
    <node id="DNA Sequencing">
      <data key="d0">DNA Sequencing</data>
      <data key="d1">category</data>
      <data key="d2">A molecular testing method used to analyze genetic sequences in blood cancer cells to guide treatment.&lt;SEP&gt;DNA sequencing is a laboratory molecular test used to detect genetic mutations in the TP53 and IGHV genes.</data>
      <data key="d3">chunk-67015f3916810c4378b2ed269cc27f29&lt;SEP&gt;chunk-717174ace5855cc823d51c46c9a70648</data>
    </node>
    <node id="CpG-Stimulated Karyotype">
      <data key="d0">CpG-Stimulated Karyotype</data>
      <data key="d1">category</data>
      <data key="d2">A cytogenetic laboratory test assessing chromosome structure used in treatment planning for CLL.</data>
      <data key="d3">chunk-717174ace5855cc823d51c46c9a70648</data>
    </node>
    <node id="Diagnostic CT Scan">
      <data key="d0">Diagnostic CT Scan</data>
      <data key="d1">event</data>
      <data key="d2">Radiological imaging of the chest, abdomen, and pelvis that may be used during treatment planning to check for internal lymph node and organ enlargement.</data>
      <data key="d3">chunk-717174ace5855cc823d51c46c9a70648</data>
    </node>
    <node id="Direct Antiglobulin Test">
      <data key="d0">Direct Antiglobulin Test</data>
      <data key="d1">category</data>
      <data key="d2">Also known as the Coombs test, an optional laboratory test used during treatment planning for CLL patients.</data>
      <data key="d3">chunk-717174ace5855cc823d51c46c9a70648</data>
    </node>
    <node id="Cutaneous B-Cell Lymphoma">
      <data key="d0">Cutaneous B-Cell Lymphoma</data>
      <data key="d1">category</data>
      <data key="d2">Cutaneous B-cell lymphoma (CBCL) is a form of cancer that requires accurate blood tests, tissue tests, imaging, and biopsy to diagnose and establish a treatment plan.&lt;SEP&gt;Cutaneous B-cell lymphoma (CBCL) is a form of primary cutaneous lymphoma that starts in B-cell lymphocytes within the lymphatic system.&lt;SEP&gt;Cutaneous B-cell lymphoma (CBCL) is a subtype of primary cutaneous lymphoma that develops from abnormal B cells, typically presenting as skin nodules or papules.</data>
      <data key="d3">chunk-67015f3916810c4378b2ed269cc27f29&lt;SEP&gt;chunk-196a80cd0ae47fda3849b101cca91a15&lt;SEP&gt;chunk-f9a9eb8b01f29fdf214c10bdffac3203</data>
    </node>
    <node id="Diagnostic CT">
      <data key="d0">Diagnostic CT</data>
      <data key="d1">category</data>
      <data key="d2">A medical imaging procedure that utilizes radiation and a contrast agent to detect enlarged lymph nodes and assess the extent of cancer prior to treatment.</data>
      <data key="d3">chunk-67015f3916810c4378b2ed269cc27f29</data>
    </node>
    <node id="CLL Specialist">
      <data key="d0">CLL Specialist</data>
      <data key="d1">person</data>
      <data key="d2">A specialized medical practitioner who provides expert consultation, diagnosis, and treatment guidance for chronic lymphocytic leukemia patients.</data>
      <data key="d3">chunk-67015f3916810c4378b2ed269cc27f29</data>
    </node>
    <node id="Differential">
      <data key="d0">Differential</data>
      <data key="d1">category</data>
      <data key="d2">A differential is a laboratory blood test that counts the most common types of white blood cells and checks their balance in the blood, often showing elevated counts in CLL.</data>
      <data key="d3">chunk-67015f3916810c4378b2ed269cc27f29</data>
    </node>
    <node id="17p Deletion">
      <data key="d0">17p Deletion</data>
      <data key="d1">category</data>
      <data key="d2">17p deletion is a specific chromosomal biomarker detected by FISH in CLL cells that helps determine disease prognosis and guide treatment selection.</data>
      <data key="d3">chunk-67015f3916810c4378b2ed269cc27f29</data>
    </node>
    <node id="Fertility Counselor">
      <data key="d0">Fertility Counselor</data>
      <data key="d1">person</data>
      <data key="d2">A specialized healthcare professional who counsels cancer patients on options and procedures for preserving fertility before starting treatment.</data>
      <data key="d3">chunk-67015f3916810c4378b2ed269cc27f29</data>
    </node>
    <node id="Radiology Department">
      <data key="d0">Radiology Department</data>
      <data key="d1">organization</data>
      <data key="d2">A specialized hospital or clinical department equipped with scanners where diagnostic CT imaging is performed.</data>
      <data key="d3">chunk-67015f3916810c4378b2ed269cc27f29</data>
    </node>
    <node id="Consultation With A CLL Specialist">
      <data key="d0">Consultation With A CLL Specialist</data>
      <data key="d1">event</data>
      <data key="d2">A clinical meeting between a patient and a chronic lymphocytic leukemia specialist to review diagnosis, test results, and treatment recommendations.</data>
      <data key="d3">chunk-67015f3916810c4378b2ed269cc27f29</data>
    </node>
    <node id="Primary Cutaneous Lymphomas">
      <data key="d0">Primary Cutaneous Lymphomas</data>
      <data key="d1">category</data>
      <data key="d2">A clinical category of lymphomas arising in the skin, which encompasses cutaneous B-cell lymphoma.&lt;SEP&gt;Primary cutaneous lymphomas (PCL) are a rare group of non-Hodgkin lymphomas that originate in the skin from abnormal B or T lymphocytes.</data>
      <data key="d3">chunk-67015f3916810c4378b2ed269cc27f29&lt;SEP&gt;chunk-196a80cd0ae47fda3849b101cca91a15</data>
    </node>
    <node id="Cutaneous T-Cell Lymphoma">
      <data key="d0">Cutaneous T-Cell Lymphoma</data>
      <data key="d1">category</data>
      <data key="d2">Cutaneous T-cell lymphoma (CTCL) is a subtype of primary cutaneous lymphoma that develops from abnormal T lymphocytes, including forms like mycosis fungoides and Sézary syndrome.</data>
      <data key="d3">chunk-196a80cd0ae47fda3849b101cca91a15</data>
    </node>
    <node id="Primary Cutaneous Marginal Zone Lymphoma">
      <data key="d0">Primary Cutaneous Marginal Zone Lymphoma</data>
      <data key="d1">category</data>
      <data key="d2">Primary cutaneous marginal zone lymphoma (PCMZL), also known as PCMZ lymphoproliferative disorder, is an indolent subtype of primary cutaneous B-cell lymphoma.</data>
      <data key="d3">chunk-196a80cd0ae47fda3849b101cca91a15</data>
    </node>
    <node id="Primary Cutaneous Follicle Center Lymphoma">
      <data key="d0">Primary Cutaneous Follicle Center Lymphoma</data>
      <data key="d1">category</data>
      <data key="d2">Primary cutaneous follicle center lymphoma (PCFCL) is an indolent subtype of primary cutaneous B-cell lymphoma.</data>
      <data key="d3">chunk-196a80cd0ae47fda3849b101cca91a15</data>
    </node>
    <node id="Primary Cutaneous Diffuse Large B-Cell Lymphoma, Leg Type">
      <data key="d0">Primary Cutaneous Diffuse Large B-Cell Lymphoma, Leg Type</data>
      <data key="d1">category</data>
      <data key="d2">Primary cutaneous diffuse large B-cell lymphoma, leg type (PC-DLBCL, leg type) is a specific subtype of primary cutaneous B-cell lymphoma.</data>
      <data key="d3">chunk-196a80cd0ae47fda3849b101cca91a15</data>
    </node>
    <node id="Mycosis Fungoides">
      <data key="d0">Mycosis Fungoides</data>
      <data key="d1">category</data>
      <data key="d2">Mycosis fungoides is a specific type of cutaneous T-cell lymphoma (CTCL).</data>
      <data key="d3">chunk-196a80cd0ae47fda3849b101cca91a15</data>
    </node>
    <node id="Sézary Syndrome">
      <data key="d0">Sézary Syndrome</data>
      <data key="d1">category</data>
      <data key="d2">Sézary syndrome is an aggressive variant and clinical form of cutaneous T-cell lymphoma (CTCL).</data>
      <data key="d3">chunk-196a80cd0ae47fda3849b101cca91a15</data>
    </node>
    <node id="Primary Cutaneous T-Cell Lymphoproliferative Disorders">
      <data key="d0">Primary Cutaneous T-Cell Lymphoproliferative Disorders</data>
      <data key="d1">category</data>
      <data key="d2">Primary cutaneous T-cell lymphoproliferative disorders (PCLPDs) are a group of disorders related to cutaneous T-cell lymphomas.</data>
      <data key="d3">chunk-196a80cd0ae47fda3849b101cca91a15</data>
    </node>
    <node id="Testing For CBCL">
      <data key="d0">Testing For CBCL</data>
      <data key="d1">event</data>
      <data key="d2">Testing for CBCL comprises a series of diagnostic evaluations—such as skin exams, blood tests, biopsies, imaging, and immunophenotyping—used to diagnose and determine a treatment plan for cutaneous B-cell lymphoma.</data>
      <data key="d3">chunk-196a80cd0ae47fda3849b101cca91a15</data>
    </node>
    <node id="Doctor Visit">
      <data key="d0">Doctor Visit</data>
      <data key="d1">event</data>
      <data key="d2">An in-person or telehealth clinical appointment where patients consult with healthcare providers, review diagnostic findings, and discuss treatment plans.</data>
      <data key="d3">chunk-f9a9eb8b01f29fdf214c10bdffac3203</data>
    </node>
    <node id="Follow-Up Testing">
      <data key="d0">Follow-Up Testing</data>
      <data key="d1">event</data>
      <data key="d2">Routine diagnostic tests conducted over several years following cancer treatment to monitor and detect any recurrence of bladder cancer.</data>
      <data key="d3">chunk-f9a9eb8b01f29fdf214c10bdffac3203</data>
    </node>
    <node id="Medical History Assessment">
      <data key="d0">Medical History Assessment</data>
      <data key="d1">event</data>
      <data key="d2">A clinical evaluation process where a patient's past illnesses, injuries, treatments, medications, and supplements are documented to help determine optimal therapy.</data>
      <data key="d3">chunk-f9a9eb8b01f29fdf214c10bdffac3203</data>
    </node>
    <node id="Blood And Tissue Tests">
      <data key="d0">Blood And Tissue Tests</data>
      <data key="d1">category</data>
      <data key="d2">A category of laboratory diagnostic evaluations performed on fluid and tissue specimens to identify and manage cutaneous B-cell lymphoma.</data>
      <data key="d3">chunk-f9a9eb8b01f29fdf214c10bdffac3203</data>
    </node>
    <node id="Urothelial Cancer">
      <data key="d0">Urothelial Cancer</data>
      <data key="d1">category</data>
      <data key="d2">The most common form of bladder cancer that originates in the urothelial cells lining the urinary tract.&lt;SEP&gt;The primary and most common form of bladder cancer originating in urothelial cells, featuring multiple subtypes such as glandular, squamous cell, and micropapillary.</data>
      <data key="d3">chunk-a158766f46bf752d6cdfe95c92f14547&lt;SEP&gt;chunk-f9a9eb8b01f29fdf214c10bdffac3203</data>
    </node>
    <node id="Hematuria">
      <data key="d0">Hematuria</data>
      <data key="d1">category</data>
      <data key="d2">A medical symptom category characterized by the presence of blood in the urine, serving as the most common early sign of bladder cancer.</data>
      <data key="d3">chunk-8aa2c7020ce6e89888e81972588726e3</data>
    </node>
    <node id="Non-Muscle-Invasive Bladder Cancer">
      <data key="d0">Non-Muscle-Invasive Bladder Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A category of bladder cancer (stages 0 and 1) that has not invaded the deeper muscle layer of the bladder wall.&lt;SEP&gt;A clinical phase of bladder cancer where the tumor is confined to the inner urothelial layer and has not invaded the bladder muscle wall.&lt;SEP&gt;A specific form of bladder cancer that has not invaded the deeper muscle layer of the bladder wall and frequently requires post-treatment surveillance.</data>
      <data key="d3">chunk-dea00cf063e8831db4919330d94b1f2a&lt;SEP&gt;chunk-8aa2c7020ce6e89888e81972588726e3&lt;SEP&gt;chunk-29d1ec9b874dd38ef0f3a4a2081f548e</data>
    </node>
    <node id="Muscle-Invasive Bladder Cancer">
      <data key="d0">Muscle-Invasive Bladder Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A category of bladder cancer (stages 2, 3, and 4) where cancer has penetrated into or beyond the bladder wall muscle layer, requiring more intensive treatment.&lt;SEP&gt;A more advanced stage of bladder cancer that has grown into the muscle layer of the bladder, requiring more intensive or complicated treatment.&lt;SEP&gt;An aggressive phase of bladder cancer where tumor cells have grown into the muscle layer of the bladder wall.&lt;SEP&gt;Bladder cancer encompassing stages 2, 3, and 4 where the tumor has invaded into or through the muscular layer of the bladder wall.&lt;SEP&gt;Muscle-invasive bladder cancer is an advanced stage of bladder malignancy that has penetrated into the muscle wall, typically requiring radical cystectomy.</data>
      <data key="d3">chunk-68217ea9e5382d1756c99b5152ea98db&lt;SEP&gt;chunk-a158766f46bf752d6cdfe95c92f14547&lt;SEP&gt;chunk-29d1ec9b874dd38ef0f3a4a2081f548e&lt;SEP&gt;chunk-13e723cb8b0af4bcf2f1b0fd37912cb2&lt;SEP&gt;chunk-8aa2c7020ce6e89888e81972588726e3</data>
    </node>
    <node id="Metastatic Bladder Cancer">
      <data key="d0">Metastatic Bladder Cancer</data>
      <data key="d1">category</data>
      <data key="d2">Advanced bladder cancer that has spread beyond the pelvis to distant organs and lymph nodes, specifically designated as Stage 4B.&lt;SEP&gt;An advanced phase of bladder cancer characterized by the spread of cancer cells beyond the bladder to distant sites like lymph nodes, bones, lungs, or liver.&lt;SEP&gt;An advanced stage of bladder cancer that has spread beyond the bladder to other parts of the body, which is treatable with systemic therapies though typically not curable.</data>
      <data key="d3">chunk-68217ea9e5382d1756c99b5152ea98db&lt;SEP&gt;chunk-8aa2c7020ce6e89888e81972588726e3&lt;SEP&gt;chunk-29d1ec9b874dd38ef0f3a4a2081f548e</data>
    </node>
    <node id="Chemical Exposure">
      <data key="d0">Chemical Exposure</data>
      <data key="d1">category</data>
      <data key="d2">An environmental and occupational risk factor category involving substances found in dyes, rubber, leather, printing, textiles, and paint that elevate bladder cancer risk.</data>
      <data key="d3">chunk-8aa2c7020ce6e89888e81972588726e3</data>
    </node>
    <node id="Cancer of the Urothelium">
      <data key="d0">Cancer of the Urothelium</data>
      <data key="d1">category</data>
      <data key="d2">A form of cancer that originates in the urothelial lining of the urinary tract, which includes the bladder, kidneys, ureters, and urethra.</data>
      <data key="d3">chunk-8aa2c7020ce6e89888e81972588726e3</data>
    </node>
    <node id="Frequent Urination">
      <data key="d0">Frequent Urination</data>
      <data key="d1">category</data>
      <data key="d2">A urinary symptom marked by needing to urinate more often than usual, which can indicate bladder cancer.</data>
      <data key="d3">chunk-8aa2c7020ce6e89888e81972588726e3</data>
    </node>
    <node id="Urgency to Urinate">
      <data key="d0">Urgency to Urinate</data>
      <data key="d1">category</data>
      <data key="d2">A medical symptom characterized by a sudden, intense need to urinate, associated with bladder cancer.</data>
      <data key="d3">chunk-8aa2c7020ce6e89888e81972588726e3</data>
    </node>
    <node id="Painful Urination">
      <data key="d0">Painful Urination</data>
      <data key="d1">category</data>
      <data key="d2">A condition characterized by discomfort or burning during urination, presenting as a symptom of bladder cancer.</data>
      <data key="d3">chunk-8aa2c7020ce6e89888e81972588726e3</data>
    </node>
    <node id="Back Pain">
      <data key="d0">Back Pain</data>
      <data key="d1">category</data>
      <data key="d2">A physical discomfort in the back that can serve as a symptom of bladder cancer.</data>
      <data key="d3">chunk-8aa2c7020ce6e89888e81972588726e3</data>
    </node>
    <node id="Urinalysis">
      <data key="d0">Urinalysis</data>
      <data key="d1">category</data>
      <data key="d2">A laboratory test performed on urine samples to identify microscopic blood and other abnormalities.</data>
      <data key="d3">chunk-8aa2c7020ce6e89888e81972588726e3</data>
    </node>
    <node id="Urine Cytology">
      <data key="d0">Urine Cytology</data>
      <data key="d1">category</data>
      <data key="d2">A diagnostic laboratory test examining urine samples under a microscope to detect abnormal or cancerous cells.&lt;SEP&gt;Urine cytology is a diagnostic laboratory test analyzing urine samples under a microscope to detect cancerous or precancerous cells.</data>
      <data key="d3">chunk-dea00cf063e8831db4919330d94b1f2a&lt;SEP&gt;chunk-8aa2c7020ce6e89888e81972588726e3</data>
    </node>
    <node id="Genetic Mutations">
      <data key="d0">Genetic Mutations</data>
      <data key="d1">category</data>
      <data key="d2">Abnormal alterations in cellular DNA instructions that cause normal cells to transform into cancerous cells.</data>
      <data key="d3">chunk-8aa2c7020ce6e89888e81972588726e3</data>
    </node>
    <node id="Secondhand Smoke">
      <data key="d0">Secondhand Smoke</data>
      <data key="d1">category</data>
      <data key="d2">Environmental tobacco smoke exposure that increases an individual's risk of developing bladder cancer.&lt;SEP&gt;Passive tobacco smoke inhaled by family members and friends, raising their relative risk of developing bladder cancer.</data>
      <data key="d3">chunk-8aa2c7020ce6e89888e81972588726e3&lt;SEP&gt;chunk-7a890e27eba8c63d10f19b85a72fc14a</data>
    </node>
    <node id="Clinical Team">
      <data key="d0">Clinical Team</data>
      <data key="d1">organization</data>
      <data key="d2">A group of doctors and medical specialists responsible for diagnosing, evaluating, and determining treatment options for bladder cancer patients.</data>
      <data key="d3">chunk-8aa2c7020ce6e89888e81972588726e3</data>
    </node>
    <node id="Non-Invasive Bladder Cancer">
      <data key="d0">Non-Invasive Bladder Cancer</data>
      <data key="d1">category</data>
      <data key="d2">An early phase of bladder cancer where the cancer cells have not penetrated into the deeper muscle tissue, often curable with treatment.</data>
      <data key="d3">chunk-68217ea9e5382d1756c99b5152ea98db</data>
    </node>
    <node id="Cystoscopy And Biopsy">
      <data key="d0">Cystoscopy And Biopsy</data>
      <data key="d1">category</data>
      <data key="d2">Diagnostic procedures used to visualize the inside of the bladder and extract tissue samples to confirm the diagnosis and extent of bladder cancer.</data>
      <data key="d3">chunk-68217ea9e5382d1756c99b5152ea98db</data>
    </node>
    <node id="Medical And Family Histories">
      <data key="d0">Medical And Family Histories</data>
      <data key="d1">category</data>
      <data key="d2">A diagnostic health assessment documenting past illnesses, treatments, medications, and hereditary disease patterns among blood relatives.</data>
      <data key="d3">chunk-68217ea9e5382d1756c99b5152ea98db</data>
    </node>
    <node id="Blood And Urine Tests">
      <data key="d0">Blood And Urine Tests</data>
      <data key="d1">category</data>
      <data key="d2">Laboratory evaluations of fluid samples designed to identify disease signs and monitor organ performance in cancer patients.</data>
      <data key="d3">chunk-68217ea9e5382d1756c99b5152ea98db</data>
    </node>
    <node id="Primary Care Doctor">
      <data key="d0">Primary Care Doctor</data>
      <data key="d1">person</data>
      <data key="d2">A primary care doctor is a general physician who manages non-cancer medical care and helps patients communicate their treatment preferences to their oncology team.</data>
      <data key="d3">chunk-dea00cf063e8831db4919330d94b1f2a</data>
    </node>
    <node id="Urologic Oncologist">
      <data key="d0">Urologic Oncologist</data>
      <data key="d1">person</data>
      <data key="d2">A urologic oncologist is a surgeon specialized in diagnosing and treating urinary tract and male reproductive cancers using surgery and intravesical therapy.</data>
      <data key="d3">chunk-dea00cf063e8831db4919330d94b1f2a</data>
    </node>
    <node id="Pharmacist">
      <data key="d0">Pharmacist</data>
      <data key="d1">person</data>
      <data key="d2">A healthcare professional who prepares chemotherapy and other oncology medications, and provides advice on drug treatments.</data>
      <data key="d3">chunk-dea00cf063e8831db4919330d94b1f2a</data>
    </node>
    <node id="Advanced Practice Provider">
      <data key="d0">Advanced Practice Provider</data>
      <data key="d1">person</data>
      <data key="d2">Medical professionals including registered nurse practitioners and physician assistants who monitor patient health, manage care, and provide treatment within a healthcare team.</data>
      <data key="d3">chunk-dea00cf063e8831db4919330d94b1f2a</data>
    </node>
    <node id="Resident and Fellow">
      <data key="d0">Resident and Fellow</data>
      <data key="d1">person</data>
      <data key="d2">Trainee physicians pursuing ongoing specialized medical education under supervision to become fully credentialed specialists.</data>
      <data key="d3">chunk-dea00cf063e8831db4919330d94b1f2a</data>
    </node>
    <node id="Psychologist and Psychiatrist">
      <data key="d0">Psychologist and Psychiatrist</data>
      <data key="d1">person</data>
      <data key="d2">Mental health clinicians who assist patients in managing psychological symptoms such as depression and anxiety related to their cancer diagnosis.</data>
      <data key="d3">chunk-dea00cf063e8831db4919330d94b1f2a</data>
    </node>
    <node id="Liver Function Test">
      <data key="d0">Liver Function Test</data>
      <data key="d1">category</data>
      <data key="d2">A diagnostic blood evaluation component of a CMP that measures hepatic enzymes, such as alkaline phosphatase and bilirubin, to check liver health.</data>
      <data key="d3">chunk-dea00cf063e8831db4919330d94b1f2a</data>
    </node>
    <node id="Kidney Function Test">
      <data key="d0">Kidney Function Test</data>
      <data key="d1">category</data>
      <data key="d2">A diagnostic blood evaluation component of a CMP measuring waste products like creatinine and blood urea nitrogen to verify renal function prior to cancer treatment.</data>
      <data key="d3">chunk-dea00cf063e8831db4919330d94b1f2a</data>
    </node>
    <node id="Biomarker Test">
      <data key="d0">Biomarker Test</data>
      <data key="d1">category</data>
      <data key="d2">A diagnostic laboratory test detecting tumor markers or cellular clues in urine to assist in bladder cancer evaluation and surveillance.</data>
      <data key="d3">chunk-dea00cf063e8831db4919330d94b1f2a</data>
    </node>
    <node id="Clinic Or Hospital">
      <data key="d0">Clinic Or Hospital</data>
      <data key="d1">organization</data>
      <data key="d2">A healthcare facility and surgical setting where larger tumors found during examinations are removed in an operating room.</data>
      <data key="d3">chunk-76a038845aaedb9ef7852018f26778b3</data>
    </node>
    <node id="Ureteroscopy">
      <data key="d0">Ureteroscopy</data>
      <data key="d1">event</data>
      <data key="d2">A diagnostic procedure examining the upper parts of the urinary tract, including the ureters and inner kidneys, using a cystoscope.</data>
      <data key="d3">chunk-76a038845aaedb9ef7852018f26778b3</data>
    </node>
    <node id="Urogram">
      <data key="d0">Urogram</data>
      <data key="d1">event</data>
      <data key="d2">An imaging test using contrast solution alongside CT or MRI to evaluate the condition and lining of the kidneys, ureters, and bladder.&lt;SEP&gt;An imaging test using contrast with CT or MRI to evaluate the urinary tract lining and assess the extent of bladder cancer.</data>
      <data key="d3">chunk-7a890e27eba8c63d10f19b85a72fc14a&lt;SEP&gt;chunk-76a038845aaedb9ef7852018f26778b3</data>
    </node>
    <node id="Renal Ultrasound">
      <data key="d0">Renal Ultrasound</data>
      <data key="d1">event</data>
      <data key="d2">A non-surgical, painless imaging procedure utilizing sound waves to generate real-time images of the kidneys, ureters, and bladder.&lt;SEP&gt;A painless, non-surgical real-time imaging test producing black-and-white images of the kidneys, ureters, and bladder.</data>
      <data key="d3">chunk-7a890e27eba8c63d10f19b85a72fc14a&lt;SEP&gt;chunk-76a038845aaedb9ef7852018f26778b3</data>
    </node>
    <node id="Blue Light Cystoscopy">
      <data key="d0">Blue Light Cystoscopy</data>
      <data key="d1">category</data>
      <data key="d2">An advanced cystoscopic imaging method that combines blue light and injected dye to detect bladder tumors more distinctly than standard white light.</data>
      <data key="d3">chunk-76a038845aaedb9ef7852018f26778b3</data>
    </node>
    <node id="Narrow-Band Imaging">
      <data key="d0">Narrow-Band Imaging</data>
      <data key="d1">category</data>
      <data key="d2">An emerging endoscopic imaging technology that enhances tumor visibility during cystoscopy without requiring dye.</data>
      <data key="d3">chunk-76a038845aaedb9ef7852018f26778b3</data>
    </node>
    <node id="Lab">
      <data key="d0">Lab</data>
      <data key="d1">organization</data>
      <data key="d2">A laboratory facility responsible for testing and analyzing tissue samples collected during biopsies for the presence of cancer.</data>
      <data key="d3">chunk-76a038845aaedb9ef7852018f26778b3</data>
    </node>
    <node id="Tumor Removal">
      <data key="d0">Tumor Removal</data>
      <data key="d1">event</data>
      <data key="d2">A surgical procedure conducted in an operating room at a clinic or hospital to excise cancerous growths identified in the bladder.</data>
      <data key="d3">chunk-76a038845aaedb9ef7852018f26778b3</data>
    </node>
    <node id="White Light Cystoscopy">
      <data key="d0">White Light Cystoscopy</data>
      <data key="d1">category</data>
      <data key="d2">The traditional standard method of examining the interior of the bladder using conventional white light illumination.</data>
      <data key="d3">chunk-76a038845aaedb9ef7852018f26778b3</data>
    </node>
    <node id="Post-Cystoscopy Side Effects">
      <data key="d0">Post-Cystoscopy Side Effects</data>
      <data key="d1">category</data>
      <data key="d2">A group of common temporary complications following cystoscopy, including urethral bleeding, burning sensations during urination, and urinary frequency.</data>
      <data key="d3">chunk-76a038845aaedb9ef7852018f26778b3</data>
    </node>
    <node id="Pyelogram">
      <data key="d0">Pyelogram</data>
      <data key="d1">category</data>
      <data key="d2">An x-ray procedure using contrast solution to identify blockages such as tumors, stones, or blood clots in the ureters and kidneys.</data>
      <data key="d3">chunk-7a890e27eba8c63d10f19b85a72fc14a</data>
    </node>
    <node id="Chest Imaging">
      <data key="d0">Chest Imaging</data>
      <data key="d1">category</data>
      <data key="d2">A diagnostic imaging procedure utilizing CT or x-ray to determine if cancer has metastasized to the lungs.</data>
      <data key="d3">chunk-7a890e27eba8c63d10f19b85a72fc14a</data>
    </node>
    <node id="Vaping">
      <data key="d0">Vaping</data>
      <data key="d1">category</data>
      <data key="d2">The use of e-cigarettes, which introduces nicotine and chemicals that hinder cancer treatments and increase complication risks.</data>
      <data key="d3">chunk-7a890e27eba8c63d10f19b85a72fc14a</data>
    </node>
    <node id="FindAGeneticCounselor.com">
      <data key="d0">FindAGeneticCounselor.com</data>
      <data key="d1">organization</data>
      <data key="d2">A dedicated web directory assisting patients in locating qualified genetic counselors for hereditary cancer risk evaluation.</data>
      <data key="d3">chunk-7a890e27eba8c63d10f19b85a72fc14a</data>
    </node>
    <node id="Upper Urinary Tract Cancer">
      <data key="d0">Upper Urinary Tract Cancer</data>
      <data key="d1">category</data>
      <data key="d2">Cancer located in the kidneys or ureters, which serves as a clinical indication for germline genetic testing.</data>
      <data key="d3">chunk-7a890e27eba8c63d10f19b85a72fc14a</data>
    </node>
    <node id="Cancer Grading">
      <data key="d0">Cancer Grading</data>
      <data key="d1">category</data>
      <data key="d2">A pathological assessment measuring how fast cancer cells are growing, categorizing tumors into low or high grades.&lt;SEP&gt;Cancer grading is a measure of the aggressiveness and rate of growth of cancer cells, categorized into low grade (slow growing) and high grade (fast growing).</data>
      <data key="d3">chunk-29d1ec9b874dd38ef0f3a4a2081f548e&lt;SEP&gt;chunk-7a890e27eba8c63d10f19b85a72fc14a</data>
    </node>
    <node id="Stage 0">
      <data key="d0">Stage 0</data>
      <data key="d1">category</data>
      <data key="d2">The earliest stage of bladder cancer that affects only the inner urothelial lining, comprising subgroups Stage 0a and Stage 0is.</data>
      <data key="d3">chunk-29d1ec9b874dd38ef0f3a4a2081f548e</data>
    </node>
    <node id="Stage 0a">
      <data key="d0">Stage 0a</data>
      <data key="d1">category</data>
      <data key="d2">A subgroup of Stage 0 bladder cancer describing cancer cells growing outward toward the hollow center of the bladder rather than into the bladder wall.</data>
      <data key="d3">chunk-29d1ec9b874dd38ef0f3a4a2081f548e</data>
    </node>
    <node id="Stage 2">
      <data key="d0">Stage 2</data>
      <data key="d1">category</data>
      <data key="d2">A muscle-invasive bladder cancer stage where tumor cells have grown into the bladder muscle layer without reaching the outer fatty layer or spreading.</data>
      <data key="d3">chunk-29d1ec9b874dd38ef0f3a4a2081f548e</data>
    </node>
    <node id="Stage 3A">
      <data key="d0">Stage 3A</data>
      <data key="d1">category</data>
      <data key="d2">A subgroup of Stage 3 bladder cancer that has reached surrounding fatty tissue, potentially a single nearby lymph node, or nearby reproductive organs such as the prostate, uterus, or vagina.</data>
      <data key="d3">chunk-29d1ec9b874dd38ef0f3a4a2081f548e</data>
    </node>
    <node id="Stage 3B">
      <data key="d0">Stage 3B</data>
      <data key="d1">category</data>
      <data key="d2">A subgroup of Stage 3 bladder cancer that has spread to multiple pelvic lymph nodes but not to distant organs or lymph nodes.</data>
      <data key="d3">chunk-29d1ec9b874dd38ef0f3a4a2081f548e</data>
    </node>
    <node id="Stage 4">
      <data key="d0">Stage 4</data>
      <data key="d1">category</data>
      <data key="d2">An advanced stage of bladder cancer where the cancer has grown through the bladder wall and may have spread to distant lymph nodes or distant organs.</data>
      <data key="d3">chunk-29d1ec9b874dd38ef0f3a4a2081f548e</data>
    </node>
    <node id="Low Grade">
      <data key="d0">Low Grade</data>
      <data key="d1">category</data>
      <data key="d2">A cancer grade classification (LG) indicating cancer cells that closely resemble normal cells and are slow-growing.&lt;SEP&gt;A grading classification (LG) indicating that bladder cancer cells appear relatively normal and are slow-growing.</data>
      <data key="d3">chunk-a158766f46bf752d6cdfe95c92f14547&lt;SEP&gt;chunk-29d1ec9b874dd38ef0f3a4a2081f548e</data>
    </node>
    <node id="High Grade">
      <data key="d0">High Grade</data>
      <data key="d1">category</data>
      <data key="d2">A cancer grade classification (HG) indicating cancer cells that look very abnormal and grow and spread quickly.&lt;SEP&gt;A grading classification (HG) indicating that bladder cancer cells look significantly abnormal, growing and spreading rapidly.</data>
      <data key="d3">chunk-a158766f46bf752d6cdfe95c92f14547&lt;SEP&gt;chunk-29d1ec9b874dd38ef0f3a4a2081f548e</data>
    </node>
    <node id="Urothelial Layer">
      <data key="d0">Urothelial Layer</data>
      <data key="d1">category</data>
      <data key="d2">The innermost lining of the bladder wall made of urothelial cells, where the majority of bladder cancers originate.</data>
      <data key="d3">chunk-29d1ec9b874dd38ef0f3a4a2081f548e</data>
    </node>
    <node id="Connective Tissue Layer">
      <data key="d0">Connective Tissue Layer</data>
      <data key="d1">category</data>
      <data key="d2">The second anatomical layer of the bladder wall located between the inner urothelial lining and the muscle layer.</data>
      <data key="d3">chunk-29d1ec9b874dd38ef0f3a4a2081f548e</data>
    </node>
    <node id="Muscle Layer">
      <data key="d0">Muscle Layer</data>
      <data key="d1">category</data>
      <data key="d2">The muscular layer of the bladder wall; whether cancer has invaded this layer serves as the primary distinction between non-muscle-invasive and muscle-invasive disease.</data>
      <data key="d3">chunk-29d1ec9b874dd38ef0f3a4a2081f548e</data>
    </node>
    <node id="Outer Fatty Layer">
      <data key="d0">Outer Fatty Layer</data>
      <data key="d1">category</data>
      <data key="d2">The outermost anatomical layer surrounding the bladder wall, involved when cancer advances to Stage 3.</data>
      <data key="d3">chunk-29d1ec9b874dd38ef0f3a4a2081f548e</data>
    </node>
    <node id="TURBT">
      <data key="d0">TURBT</data>
      <data key="d1">category</data>
      <data key="d2">Transurethral Resection of Bladder Tumor (TURBT) is a surgical procedure used to remove visible bladder tumors.&lt;SEP&gt;Transurethral Resection of Bladder Tumor is a surgical procedure performed through the urethra to diagnose, stage, and resect bladder tumors.&lt;SEP&gt;Transurethral resection of bladder tumor (TURBT) is a surgical procedure that examines and removes tumors on the bladder wall, sometimes repeated for deeper biopsy or staging.&lt;SEP&gt;Transurethral resection of bladder tumor, a surgical procedure used to remove all visible cancer from the bladder prior to chemoradiation in trimodal therapy.</data>
      <data key="d3">chunk-a158766f46bf752d6cdfe95c92f14547&lt;SEP&gt;chunk-13e723cb8b0af4bcf2f1b0fd37912cb2&lt;SEP&gt;chunk-b0a584e54ffa22e1c25f839302bcd727&lt;SEP&gt;chunk-48b513355d29308e212a3074ba326b10</data>
    </node>
    <node id="Intravesical Therapy">
      <data key="d0">Intravesical Therapy</data>
      <data key="d1">category</data>
      <data key="d2">A local treatment method that involves filling the bladder with liquid medication to eliminate cancer cells, often combined with TURBT.&lt;SEP&gt;A localized cancer therapy administered directly into the bladder, which may cause bladder inflammation, pain, and urinary symptoms.&lt;SEP&gt;A localized cancer treatment method in which medication is instilled directly into the bladder via a catheter.&lt;SEP&gt;Intravesical therapy is a localized bladder treatment commonly performed in combination with TURBT.&lt;SEP&gt;Intravesical therapy is a medical procedure involving the instillation of liquid medication directly into the bladder via a catheter.</data>
      <data key="d3">chunk-f2a44e885faf856aa579d824b3cd85e7&lt;SEP&gt;chunk-a158766f46bf752d6cdfe95c92f14547&lt;SEP&gt;chunk-13e723cb8b0af4bcf2f1b0fd37912cb2&lt;SEP&gt;chunk-b0a584e54ffa22e1c25f839302bcd727&lt;SEP&gt;chunk-541f1323a24c5990b4a6408e0c5442ab</data>
    </node>
    <node id="Glandular Subtype">
      <data key="d0">Glandular Subtype</data>
      <data key="d1">category</data>
      <data key="d2">A rare histological variant of urothelial cancer showing glandular cell features that may grow or advance faster than typical urothelial cancer.</data>
      <data key="d3">chunk-a158766f46bf752d6cdfe95c92f14547</data>
    </node>
    <node id="Squamous Cell Subtype">
      <data key="d0">Squamous Cell Subtype</data>
      <data key="d1">category</data>
      <data key="d2">A variant of urothelial cancer exhibiting squamous cell features, potentially requiring more aggressive treatment due to faster growth.</data>
      <data key="d3">chunk-a158766f46bf752d6cdfe95c92f14547</data>
    </node>
    <node id="Micropapillary Subtype">
      <data key="d0">Micropapillary Subtype</data>
      <data key="d1">category</data>
      <data key="d2">An uncommon histological subtype of urothelial cancer known for potentially rapid disease advancement.</data>
      <data key="d3">chunk-a158766f46bf752d6cdfe95c92f14547</data>
    </node>
    <node id="Plasmacytoid Subtype">
      <data key="d0">Plasmacytoid Subtype</data>
      <data key="d1">category</data>
      <data key="d2">A rare histological subtype of urothelial cancer characterized by distinctive morphological features and potentially aggressive behavior.</data>
      <data key="d3">chunk-a158766f46bf752d6cdfe95c92f14547</data>
    </node>
    <node id="Sarcomatoid Subtype">
      <data key="d0">Sarcomatoid Subtype</data>
      <data key="d1">category</data>
      <data key="d2">A rare, aggressive variant of urothelial cancer presenting with spindle or sarcomatous cellular characteristics.</data>
      <data key="d3">chunk-a158766f46bf752d6cdfe95c92f14547</data>
    </node>
    <node id="Nested Subtype">
      <data key="d0">Nested Subtype</data>
      <data key="d1">category</data>
      <data key="d2">A recognized variant subtype of urothelial bladder carcinoma presenting with nested cell patterns.</data>
      <data key="d3">chunk-a158766f46bf752d6cdfe95c92f14547</data>
    </node>
    <node id="Lymphoepithelioma-Like Subtype">
      <data key="d0">Lymphoepithelioma-Like Subtype</data>
      <data key="d1">category</data>
      <data key="d2">A rare histological variant of urothelial carcinoma with morphological resemblance to lymphoepithelioma.</data>
      <data key="d3">chunk-a158766f46bf752d6cdfe95c92f14547</data>
    </node>
    <node id="Microcystic And Tubular Subtype">
      <data key="d0">Microcystic And Tubular Subtype</data>
      <data key="d1">category</data>
      <data key="d2">A rare histological subtype of urothelial carcinoma characterized by microcystic and tubular cellular patterns.</data>
      <data key="d3">chunk-a158766f46bf752d6cdfe95c92f14547</data>
    </node>
    <node id="Stage 0 Bladder Cancer">
      <data key="d0">Stage 0 Bladder Cancer</data>
      <data key="d1">category</data>
      <data key="d2">Non-muscle-invasive bladder cancer where abnormal cells have grown only on the inside lining of the bladder wall.</data>
      <data key="d3">chunk-a158766f46bf752d6cdfe95c92f14547</data>
    </node>
    <node id="Stage 1 Bladder Cancer">
      <data key="d0">Stage 1 Bladder Cancer</data>
      <data key="d1">category</data>
      <data key="d2">Early-stage bladder cancer where a tumor has invaded the layer of connective tissue in the bladder wall without reaching the muscle layer.</data>
      <data key="d3">chunk-a158766f46bf752d6cdfe95c92f14547</data>
    </node>
    <node id="Stage 3 Bladder Cancer">
      <data key="d0">Stage 3 Bladder Cancer</data>
      <data key="d1">category</data>
      <data key="d2">Advanced bladder cancer where the tumor has grown through the muscle layer into the surrounding fat layer, and potentially into nearby lymph nodes.</data>
      <data key="d3">chunk-a158766f46bf752d6cdfe95c92f14547</data>
    </node>
    <node id="Stage 4 Bladder Cancer">
      <data key="d0">Stage 4 Bladder Cancer</data>
      <data key="d1">category</data>
      <data key="d2">Metastatic bladder cancer in which the disease has spread beyond the bladder to distant sites in the body.</data>
      <data key="d3">chunk-a158766f46bf752d6cdfe95c92f14547</data>
    </node>
    <node id="Bladder Removal">
      <data key="d0">Bladder Removal</data>
      <data key="d1">category</data>
      <data key="d2">A surgical procedure (cystectomy) involving the total removal of the bladder and sometimes adjacent organs to treat severe bladder cancer.</data>
      <data key="d3">chunk-a158766f46bf752d6cdfe95c92f14547</data>
    </node>
    <node id="Indiana University">
      <data key="d0">Indiana University</data>
      <data key="d1">organization</data>
      <data key="d2">Indiana University is an academic institution whose surgeons developed the Indiana pouch urinary diversion technique.&lt;SEP&gt;Indiana University is an educational and research institution whose surgeons developed the Indiana pouch, a type of continent cutaneous urinary diversion.</data>
      <data key="d3">chunk-13e723cb8b0af4bcf2f1b0fd37912cb2&lt;SEP&gt;chunk-b0a584e54ffa22e1c25f839302bcd727</data>
    </node>
    <node id="Cystectomy">
      <data key="d0">Cystectomy</data>
      <data key="d1">event</data>
      <data key="d2">Cystectomy is a surgical procedure to remove all or part of the bladder, primarily utilized in treating bladder cancer.</data>
      <data key="d3">chunk-13e723cb8b0af4bcf2f1b0fd37912cb2</data>
    </node>
    <node id="Radical Cystectomy">
      <data key="d0">Radical Cystectomy</data>
      <data key="d1">event</data>
      <data key="d2">A major surgical operation used for muscle-invasive bladder cancer that removes the bladder, nearby lymph nodes, and other pelvic organs.&lt;SEP&gt;A surgical procedure involving the complete removal of the bladder, which can be avoided in certain patients through trimodal preservation therapy.&lt;SEP&gt;Radical cystectomy is a major surgical procedure involving the removal of the entire bladder, nearby lymph nodes, and potentially other adjacent organs for muscle-invasive bladder cancer.</data>
      <data key="d3">chunk-f2a44e885faf856aa579d824b3cd85e7&lt;SEP&gt;chunk-13e723cb8b0af4bcf2f1b0fd37912cb2&lt;SEP&gt;chunk-48b513355d29308e212a3074ba326b10</data>
    </node>
    <node id="Partial Cystectomy">
      <data key="d0">Partial Cystectomy</data>
      <data key="d1">event</data>
      <data key="d2">Partial cystectomy is a surgical operation that removes only a portion of the bladder, suitable for a small minority of bladder cancer patients.</data>
      <data key="d3">chunk-13e723cb8b0af4bcf2f1b0fd37912cb2</data>
    </node>
    <node id="Neobladder">
      <data key="d0">Neobladder</data>
      <data key="d1">event</data>
      <data key="d2">A neobladder is an internal urinary diversion procedure that reconstructs a reservoir from the small intestine and connects it to the urethra, allowing urination along the normal pathway.</data>
      <data key="d3">chunk-13e723cb8b0af4bcf2f1b0fd37912cb2</data>
    </node>
    <node id="Continent Cutaneous Pouch">
      <data key="d0">Continent Cutaneous Pouch</data>
      <data key="d1">event</data>
      <data key="d2">Continent cutaneous pouch, also known as an Indiana pouch, is a urinary diversion created from the large intestine with a stoma valve that is emptied via catheterization.</data>
      <data key="d3">chunk-13e723cb8b0af4bcf2f1b0fd37912cb2</data>
    </node>
    <node id="Urinary Incontinence">
      <data key="d0">Urinary Incontinence</data>
      <data key="d1">category</data>
      <data key="d2">A medical condition characterized by loss of bladder control and unintended leakage of urine, often resulting from bladder surgery.&lt;SEP&gt;A post-surgical complication characterized by an inability to control the flow of urine.&lt;SEP&gt;Urinary incontinence is a medical condition characterized by involuntary leakage of urine, identified as a common occurrence following neobladder surgery.</data>
      <data key="d3">chunk-f2a44e885faf856aa579d824b3cd85e7&lt;SEP&gt;chunk-13e723cb8b0af4bcf2f1b0fd37912cb2&lt;SEP&gt;chunk-541f1323a24c5990b4a6408e0c5442ab</data>
    </node>
    <node id="Catheterization">
      <data key="d0">Catheterization</data>
      <data key="d1">event</data>
      <data key="d2">Catheterization is the medical procedure of inserting a tube (catheter) through the urethra or a stoma to facilitate the drainage of urine from a reservoir.</data>
      <data key="d3">chunk-13e723cb8b0af4bcf2f1b0fd37912cb2</data>
    </node>
    <node id="BCG Shortage">
      <data key="d0">BCG Shortage</data>
      <data key="d1">event</data>
      <data key="d2">The BCG shortage is an ongoing supply crisis in the United States and globally that restricts access to bacillus Calmette-Guérin therapy for bladder cancer patients.</data>
      <data key="d3">chunk-b0a584e54ffa22e1c25f839302bcd727</data>
    </node>
    <node id="Indiana Pouch">
      <data key="d0">Indiana Pouch</data>
      <data key="d1">category</data>
      <data key="d2">The Indiana pouch is a type of catheterizable continent urinary diversion created using a section of the small intestine connected to an abdominal stoma.</data>
      <data key="d3">chunk-b0a584e54ffa22e1c25f839302bcd727</data>
    </node>
    <node id="Intravesical BCG">
      <data key="d0">Intravesical BCG</data>
      <data key="d1">category</data>
      <data key="d2">Intravesical BCG is an immunotherapy treatment using weakened bacillus Calmette-Guérin bacteria instilled into the bladder to stimulate immune destruction of cancer cells.</data>
      <data key="d3">chunk-b0a584e54ffa22e1c25f839302bcd727</data>
    </node>
    <node id="Intravesical Chemotherapy">
      <data key="d0">Intravesical Chemotherapy</data>
      <data key="d1">category</data>
      <data key="d2">A localized cancer treatment category delivered directly inside the bladder rather than throughout the entire body.&lt;SEP&gt;Intravesical chemotherapy is a localized drug treatment instilled into the bladder to eradicate residual cancer cells and prevent recurrence.</data>
      <data key="d3">chunk-b0a584e54ffa22e1c25f839302bcd727&lt;SEP&gt;chunk-48b513355d29308e212a3074ba326b10</data>
    </node>
    <node id="Non–Muscle-Invasive Bladder Cancer">
      <data key="d0">Non–Muscle-Invasive Bladder Cancer</data>
      <data key="d1">category</data>
      <data key="d2">Non–muscle-invasive bladder cancer is a specific category of bladder cancer that has not invaded the deeper muscle layer of the bladder wall.</data>
      <data key="d3">chunk-b0a584e54ffa22e1c25f839302bcd727</data>
    </node>
    <node id="High-Grade Bladder Cancer">
      <data key="d0">High-Grade Bladder Cancer</data>
      <data key="d1">category</data>
      <data key="d2">High-grade bladder cancer is an aggressive form of non-muscle-invasive bladder cancer commonly treated with intravesical BCG.</data>
      <data key="d3">chunk-b0a584e54ffa22e1c25f839302bcd727</data>
    </node>
    <node id="Bladder Removal Surgery">
      <data key="d0">Bladder Removal Surgery</data>
      <data key="d1">category</data>
      <data key="d2">A surgical treatment for bladder cancer involving the excision of the bladder, potentially causing bleeding, infections, incontinence, and sexual dysfunction.&lt;SEP&gt;Bladder removal surgery (cystectomy) is a surgical intervention considered for high-risk bladder cancer patients, particularly when BCG therapy is unavailable or ineffective.</data>
      <data key="d3">chunk-b0a584e54ffa22e1c25f839302bcd727&lt;SEP&gt;chunk-541f1323a24c5990b4a6408e0c5442ab</data>
    </node>
    <node id="FDA">
      <data key="d0">FDA</data>
      <data key="d1">organization</data>
      <data key="d2">The Food and Drug Administration is a regulatory agency responsible for approving treatments and drugs based on clinical trial results.&lt;SEP&gt;The Food and Drug Administration is a regulatory agency responsible for evaluating and approving safe and effective medical drugs, devices, and treatments based on clinical trial results.</data>
      <data key="d3">chunk-541f1323a24c5990b4a6408e0c5442ab&lt;SEP&gt;chunk-48b513355d29308e212a3074ba326b10</data>
    </node>
    <node id="Systemic Chemotherapy">
      <data key="d0">Systemic Chemotherapy</data>
      <data key="d1">category</data>
      <data key="d2">A whole-body cancer treatment category involving drugs injected into the bloodstream to kill cancer cells throughout the body.</data>
      <data key="d3">chunk-48b513355d29308e212a3074ba326b10</data>
    </node>
    <node id="Trimodal Therapy">
      <data key="d0">Trimodal Therapy</data>
      <data key="d1">category</data>
      <data key="d2">A bladder-preserving treatment protocol combining transurethral resection (TURBT) with concurrent chemotherapy and radiation therapy.</data>
      <data key="d3">chunk-48b513355d29308e212a3074ba326b10</data>
    </node>
    <node id="Phase 1 Clinical Trial">
      <data key="d0">Phase 1 Clinical Trial</data>
      <data key="d1">event</data>
      <data key="d2">An initial research trial phase designed to evaluate the dose, safety, side effects, and preliminary efficacy of an investigational therapy.</data>
      <data key="d3">chunk-48b513355d29308e212a3074ba326b10</data>
    </node>
    <node id="Phase 2 Clinical Trial">
      <data key="d0">Phase 2 Clinical Trial</data>
      <data key="d1">event</data>
      <data key="d2">A clinical research trial phase focused on assessing how well a treatment works against a specific type of cancer.</data>
      <data key="d3">chunk-48b513355d29308e212a3074ba326b10</data>
    </node>
    <node id="Phase 3 Clinical Trial">
      <data key="d0">Phase 3 Clinical Trial</data>
      <data key="d1">event</data>
      <data key="d2">A clinical research phase that tests investigational therapies against standard-of-care treatments to support regulatory approval.</data>
      <data key="d3">chunk-48b513355d29308e212a3074ba326b10</data>
    </node>
    <node id="Phase 4 Clinical Trial">
      <data key="d0">Phase 4 Clinical Trial</data>
      <data key="d1">event</data>
      <data key="d2">Post-approval research trials that assess the long-term safety, effectiveness, and benefits of therapies approved by regulatory agencies.</data>
      <data key="d3">chunk-48b513355d29308e212a3074ba326b10</data>
    </node>
    <node id="Dose-Dense Chemotherapy">
      <data key="d0">Dose-Dense Chemotherapy</data>
      <data key="d1">category</data>
      <data key="d2">A chemotherapy administration method that speeds up treatment by shortening the intervals between doses.</data>
      <data key="d3">chunk-48b513355d29308e212a3074ba326b10</data>
    </node>
    <node id="ddMVAC">
      <data key="d0">ddMVAC</data>
      <data key="d1">category</data>
      <data key="d2">A common systemic chemotherapy combination regimen consisting of dose-dense methotrexate, vinblastine, doxorubicin, and cisplatin used for bladder cancer.</data>
      <data key="d3">chunk-48b513355d29308e212a3074ba326b10</data>
    </node>
    <node id="Antibody-Drug Conjugate">
      <data key="d0">Antibody-Drug Conjugate</data>
      <data key="d1">category</data>
      <data key="d2">A targeted therapy subcategory, such as enfortumab vedotin-ejfv, that binds to specific cancer cell surface proteins to deliver cytotoxic payloads.</data>
      <data key="d3">chunk-48b513355d29308e212a3074ba326b10</data>
    </node>
    <node id="Sexual Dysfunction">
      <data key="d0">Sexual Dysfunction</data>
      <data key="d1">category</data>
      <data key="d2">A complication of cancer and its treatments involving impaired physical sexual function or reduced sexual desire.</data>
      <data key="d3">chunk-541f1323a24c5990b4a6408e0c5442ab</data>
    </node>
    <node id="Transurethral Resection of Bladder Tumor">
      <data key="d0">Transurethral Resection of Bladder Tumor</data>
      <data key="d1">event</data>
      <data key="d2">A surgical procedure (TURBT) that examines and removes tumors located on the bladder wall.</data>
      <data key="d3">chunk-f2a44e885faf856aa579d824b3cd85e7</data>
    </node>
    <node id="Human Papillomavirus Infection">
      <data key="d0">Human Papillomavirus Infection</data>
      <data key="d1">category</data>
      <data key="d2">A widespread sexually transmitted infection (HPV) recognized as the primary risk factor for the development of anal cancer and other malignancies.</data>
      <data key="d3">chunk-f2a44e885faf856aa579d824b3cd85e7</data>
    </node>
    <node id="Anal Adenocarcinoma">
      <data key="d0">Anal Adenocarcinoma</data>
      <data key="d1">category</data>
      <data key="d2">A rare histological subtype of anal cancer originating from glandular cells rather than squamous cells.</data>
      <data key="d3">chunk-f2a44e885faf856aa579d824b3cd85e7</data>
    </node>
    <node id="Anal Melanoma">
      <data key="d0">Anal Melanoma</data>
      <data key="d1">category</data>
      <data key="d2">An uncommon form of anal malignancy that develops in melanocyte cells.</data>
      <data key="d3">chunk-f2a44e885faf856aa579d824b3cd85e7</data>
    </node>
    <node id="Pelvic Floor Exercises">
      <data key="d0">Pelvic Floor Exercises</data>
      <data key="d1">category</data>
      <data key="d2">Physical therapeutic exercises recommended to help patients regain urinary control following bladder surgery.</data>
      <data key="d3">chunk-f2a44e885faf856aa579d824b3cd85e7</data>
    </node>
    <node id="HPV16">
      <data key="d0">HPV16</data>
      <data key="d1">category</data>
      <data key="d2">A high-risk strain of human papillomavirus strongly associated with the development of anal and other anogenital cancers.&lt;SEP&gt;A specific high-risk strain of human papillomavirus that is strongly associated with the development of anal cancer and other malignancies.</data>
      <data key="d3">chunk-f2a44e885faf856aa579d824b3cd85e7&lt;SEP&gt;chunk-9530f389987c13273449ab22a85170ae</data>
    </node>
    <node id="Human Immunodeficiency Virus">
      <data key="d0">Human Immunodeficiency Virus</data>
      <data key="d1">category</data>
      <data key="d2">A virus that weakens the immune system, hindering the body's ability to clear HPV infections and raising the risk of developing anal cancer.</data>
      <data key="d3">chunk-9530f389987c13273449ab22a85170ae</data>
    </node>
    <node id="Anal Dysplasia">
      <data key="d0">Anal Dysplasia</data>
      <data key="d1">category</data>
      <data key="d2">A pre-cancerous condition characterized by abnormal cell lesions in or near the anus, categorized into LSIL, HSIL, and AIN.&lt;SEP&gt;Abnormal cell growth on the surface of the anal canal or perianal skin, representing an anal precancerous state.</data>
      <data key="d3">chunk-06384634b72466c480713ee8d57f25ed&lt;SEP&gt;chunk-9530f389987c13273449ab22a85170ae</data>
    </node>
    <node id="Crohn's Disease">
      <data key="d0">Crohn's Disease</data>
      <data key="d1">category</data>
      <data key="d2">An autoimmune disorder identified as a potential risk factor contributing to an increased likelihood of anal cancer.</data>
      <data key="d3">chunk-9530f389987c13273449ab22a85170ae</data>
    </node>
    <node id="Superficially Invasive Squamous Cell Carcinoma">
      <data key="d0">Superficially Invasive Squamous Cell Carcinoma</data>
      <data key="d1">category</data>
      <data key="d2">The earliest, minimally invasive form of anal cancer, featuring microscopic lesions under 7 mm wide that are often detected incidentally.</data>
      <data key="d3">chunk-9530f389987c13273449ab22a85170ae</data>
    </node>
    <node id="High-Resolution Anoscopy">
      <data key="d0">High-Resolution Anoscopy</data>
      <data key="d1">event</data>
      <data key="d2">A specialized diagnostic examination procedure used to evaluate and detect abnormal tissue and anal cancer.&lt;SEP&gt;A specialized diagnostic procedure utilizing an anoscope, acetic acid, and a colposcope to examine the anal canal under magnification and take biopsies.&lt;SEP&gt;A specialized follow-up medical examination used to monitor and detect abnormalities or spread in anal tissue.</data>
      <data key="d3">chunk-44a870810cef881997b741c32ec368fe&lt;SEP&gt;chunk-a18089523f6dcd63cfa5664dc1c01618&lt;SEP&gt;chunk-9530f389987c13273449ab22a85170ae</data>
    </node>
    <node id="Anal Intraepithelial Neoplasia">
      <data key="d0">Anal Intraepithelial Neoplasia</data>
      <data key="d1">category</data>
      <data key="d2">Pre-cancerous abnormal changes in the lining of the anus, also classified under Stage 0 anal cancer or anal dysplasia.</data>
      <data key="d3">chunk-9530f389987c13273449ab22a85170ae</data>
    </node>
    <node id="Standard Anoscopy">
      <data key="d0">Standard Anoscopy</data>
      <data key="d1">event</data>
      <data key="d2">An examination of the anal canal using an anoscope without colposcopic magnification, contrasted with high-resolution anoscopy.</data>
      <data key="d3">chunk-9530f389987c13273449ab22a85170ae</data>
    </node>
    <node id="Anal Squamous Cell Carcinoma">
      <data key="d0">Anal Squamous Cell Carcinoma</data>
      <data key="d1">category</data>
      <data key="d2">A form of invasive anal cancer diagnosed by biopsy that requires detailed testing, lymph node assessment, imaging, and staging.</data>
      <data key="d3">chunk-a18089523f6dcd63cfa5664dc1c01618</data>
    </node>
    <node id="SISCCA">
      <data key="d0">SISCCA</data>
      <data key="d1">category</data>
      <data key="d2">Superficially invasive squamous cell carcinoma of the anus, an earlier and less advanced lesion than standard invasive anal cancer.</data>
      <data key="d3">chunk-a18089523f6dcd63cfa5664dc1c01618</data>
    </node>
    <node id="Precancer">
      <data key="d0">Precancer</data>
      <data key="d1">category</data>
      <data key="d2">Abnormal cell changes on the surface of the anal canal or perianal region that have not yet progressed to invasive cancer.</data>
      <data key="d3">chunk-a18089523f6dcd63cfa5664dc1c01618</data>
    </node>
    <node id="HPV">
      <data key="d0">HPV</data>
      <data key="d1">category</data>
      <data key="d2">Human papillomavirus, a viral pathogen identified as the primary cause of almost all cervical cancers and linked to anal cancer.&lt;SEP&gt;Human papillomavirus, a widespread sexually transmitted virus identified as the risk factor most strongly linked with anal cancer.</data>
      <data key="d3">chunk-b0bad5ee25cb854c10bdbc9d33b54a1a&lt;SEP&gt;chunk-a18089523f6dcd63cfa5664dc1c01618</data>
    </node>
    <node id="Lymph Node Palpation">
      <data key="d0">Lymph Node Palpation</data>
      <data key="d1">event</data>
      <data key="d2">A physical examination technique where a doctor presses on the skin of the groin to feel for enlarged inguinal lymph nodes.</data>
      <data key="d3">chunk-a18089523f6dcd63cfa5664dc1c01618</data>
    </node>
    <node id="Gynecologic Exam">
      <data key="d0">Gynecologic Exam</data>
      <data key="d1">event</data>
      <data key="d2">A clinical examination recommended for patients that includes cervical cancer and HPV screening.</data>
      <data key="d3">chunk-a18089523f6dcd63cfa5664dc1c01618</data>
    </node>
    <node id="Inguinal Lymph Nodes">
      <data key="d0">Inguinal Lymph Nodes</data>
      <data key="d1">category</data>
      <data key="d2">Lymph nodes located in the groin region that are clinically relevant in pelvic and anal diseases.&lt;SEP&gt;Lymph nodes located in the groin where the thigh meets the abdomen, serving as common sites for anal cancer spread.</data>
      <data key="d3">chunk-0d4cea71149e0e4157126efdaa0ea3e3&lt;SEP&gt;chunk-a18089523f6dcd63cfa5664dc1c01618</data>
    </node>
    <node id="Michael">
      <data key="d0">Michael</data>
      <data key="d1">person</data>
      <data key="d2">Michael is an anal cancer survivor who advocates for mentorship and mutual support among individuals undergoing and recovering from anal cancer treatment.</data>
      <data key="d3">chunk-06384634b72466c480713ee8d57f25ed</data>
    </node>
    <node id="Anal Precancer">
      <data key="d0">Anal Precancer</data>
      <data key="d1">category</data>
      <data key="d2">Anal precancer encompasses abnormal cell changes on the anal or perianal surface, including stage 0 anal cancer, anal dysplasia, carcinoma in situ, AIN, and HSIL.</data>
      <data key="d3">chunk-06384634b72466c480713ee8d57f25ed</data>
    </node>
    <node id="Stage I Anal Cancer">
      <data key="d0">Stage I Anal Cancer</data>
      <data key="d1">category</data>
      <data key="d2">Stage I anal cancer is a non-metastatic cancer stage defined by a primary tumor measuring 2 cm or smaller without spread to lymph nodes or distant sites.</data>
      <data key="d3">chunk-06384634b72466c480713ee8d57f25ed</data>
    </node>
    <node id="Stage II Anal Cancer">
      <data key="d0">Stage II Anal Cancer</data>
      <data key="d1">category</data>
      <data key="d2">Stage II anal cancer is a non-metastatic cancer stage subdivided into IIA (tumors larger than 2 cm up to 5 cm) and IIB (tumors larger than 5 cm) without spread to lymph nodes or distant sites.</data>
      <data key="d3">chunk-06384634b72466c480713ee8d57f25ed</data>
    </node>
    <node id="Stage III Anal Cancer">
      <data key="d0">Stage III Anal Cancer</data>
      <data key="d1">category</data>
      <data key="d2">Stage III anal cancer is an advanced non-metastatic stage subdivided into IIIA, IIIB, and IIIC, involving regional lymph node spread or invasion of nearby organs.</data>
      <data key="d3">chunk-06384634b72466c480713ee8d57f25ed</data>
    </node>
    <node id="Stage IV Anal Cancer">
      <data key="d0">Stage IV Anal Cancer</data>
      <data key="d1">category</data>
      <data key="d2">Stage IV anal cancer is metastatic cancer that has spread beyond the pelvis to distant organs such as the liver or lungs.</data>
      <data key="d3">chunk-06384634b72466c480713ee8d57f25ed</data>
    </node>
    <node id="Stage IIA Anal Cancer">
      <data key="d0">Stage IIA Anal Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A substage of stage II anal cancer characterized by tumors larger than 2 cm but not larger than 5 cm, with no spread to lymph nodes or distant sites (T2, N0, M0).</data>
      <data key="d3">chunk-06384634b72466c480713ee8d57f25ed</data>
    </node>
    <node id="Stage IIB Anal Cancer">
      <data key="d0">Stage IIB Anal Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A substage of stage II anal cancer characterized by tumors larger than 5 cm without spread to nearby lymph nodes or distant metastases (T3, N0, M0).</data>
      <data key="d3">chunk-06384634b72466c480713ee8d57f25ed</data>
    </node>
    <node id="Stage IIIA Anal Cancer">
      <data key="d0">Stage IIIA Anal Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A substage of stage III anal cancer where the primary tumor is 5 cm or smaller and cancer has spread to nearby lymph nodes (T1, N1, M0 or T2, N1, M0).</data>
      <data key="d3">chunk-06384634b72466c480713ee8d57f25ed</data>
    </node>
    <node id="Stage IIIB Anal Cancer">
      <data key="d0">Stage IIIB Anal Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A substage of stage III anal cancer where the tumor has invaded nearby organs like the vagina, urethra, or bladder without nodal spread (T4, N0, M0).</data>
      <data key="d3">chunk-06384634b72466c480713ee8d57f25ed</data>
    </node>
    <node id="Stage IIIC Anal Cancer">
      <data key="d0">Stage IIIC Anal Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A substage of stage III anal cancer where the tumor is larger than 5 cm or invades adjacent organs and has spread to regional lymph nodes (T3, N1, M0 or T4, N1, M0).</data>
      <data key="d3">chunk-06384634b72466c480713ee8d57f25ed</data>
    </node>
    <node id="High-Grade Anal Intraepithelial Neoplasia">
      <data key="d0">High-Grade Anal Intraepithelial Neoplasia</data>
      <data key="d1">category</data>
      <data key="d2">Also known as AIN, a form of severe precancerous lesion in the anal canal or perianal area with abnormal cells that may turn malignant.</data>
      <data key="d3">chunk-06384634b72466c480713ee8d57f25ed</data>
    </node>
    <node id="High-Grade Squamous Intraepithelial Lesions">
      <data key="d0">High-Grade Squamous Intraepithelial Lesions</data>
      <data key="d1">category</data>
      <data key="d2">Also known as HSIL, precancerous cellular abnormalities found in squamous tissue of the anal region.</data>
      <data key="d3">chunk-06384634b72466c480713ee8d57f25ed</data>
    </node>
    <node id="Human Immunodeficiency Virus Infection">
      <data key="d0">Human Immunodeficiency Virus Infection</data>
      <data key="d1">category</data>
      <data key="d2">Commonly known as HIV infection, an immunocompromising viral condition identified as a key risk factor for anal cancer.</data>
      <data key="d3">chunk-06384634b72466c480713ee8d57f25ed</data>
    </node>
    <node id="Infertility">
      <data key="d0">Infertility</data>
      <data key="d1">category</data>
      <data key="d2">A potential complication or side effect of pelvic cancer therapies resulting in the inability to conceive children.&lt;SEP&gt;The biological inability to conceive or produce children, frequently caused or contributed to by pelvic radiation therapy and chemotherapy.</data>
      <data key="d3">chunk-0d4cea71149e0e4157126efdaa0ea3e3&lt;SEP&gt;chunk-06384634b72466c480713ee8d57f25ed</data>
    </node>
    <node id="Non-Metastatic Anal Cancer">
      <data key="d0">Non-Metastatic Anal Cancer</data>
      <data key="d1">category</data>
      <data key="d2">Anal cancer classified as Stages I, II, or III, where the disease has not spread beyond the pelvis.</data>
      <data key="d3">chunk-b0bad5ee25cb854c10bdbc9d33b54a1a</data>
    </node>
    <node id="Metastatic Anal Cancer">
      <data key="d0">Metastatic Anal Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A category of anal cancer where the disease has spread to distant body sites, such as the liver or lungs.&lt;SEP&gt;An advanced stage of cancer originating in the anus that has spread to distant body parts, managed with systemic and local therapies.&lt;SEP&gt;Metastatic anal cancer refers to anal cancer that has spread beyond the pelvis to distant organs, most commonly the liver or lungs.&lt;SEP&gt;Stage IV anal cancer, where the malignancy has spread beyond the pelvis and requires systemic therapy.</data>
      <data key="d3">chunk-5349eed06f06d7c9bcb541ced69e4664&lt;SEP&gt;chunk-b0bad5ee25cb854c10bdbc9d33b54a1a&lt;SEP&gt;chunk-c35816f05289661283f683145d9f395f&lt;SEP&gt;chunk-29b3a349650a8bb55b318dcc6ecb0519</data>
    </node>
    <node id="Anal Canal Cancer">
      <data key="d0">Anal Canal Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A classification of cancer located within the anal canal, sharing chemoradiation and surveillance protocols with advanced perianal cancer.&lt;SEP&gt;A primary presentation of anal cancer that is predominantly treated with combined chemoradiation.&lt;SEP&gt;A specific form of anal cancer originating within the anal canal, categorized into non-metastatic (stages I–III) and metastatic forms.</data>
      <data key="d3">chunk-b0bad5ee25cb854c10bdbc9d33b54a1a&lt;SEP&gt;chunk-0fdcce851d69aa713ed64ba1895bd5d1&lt;SEP&gt;chunk-29b3a349650a8bb55b318dcc6ecb0519</data>
    </node>
    <node id="Perianal Cancer">
      <data key="d0">Perianal Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A form of cancer located in the perianal area, which can be nonmetastatic in stages I through III and managed via chemoradiation or local excision.&lt;SEP&gt;A specific classification of cancer affecting the perianal area, treated based on tumor grade, margins, and invasion depth.&lt;SEP&gt;A type of anal cancer that originates in the perianal region, surrounding the anal opening.</data>
      <data key="d3">chunk-b0bad5ee25cb854c10bdbc9d33b54a1a&lt;SEP&gt;chunk-0fdcce851d69aa713ed64ba1895bd5d1&lt;SEP&gt;chunk-29b3a349650a8bb55b318dcc6ecb0519</data>
    </node>
    <node id="Digital Rectal Examination">
      <data key="d0">Digital Rectal Examination</data>
      <data key="d1">event</data>
      <data key="d2">A routine surveillance physical exam recommended every 3 to 6 months for 5 years after treatment to detect cancer return.&lt;SEP&gt;DRE, a clinical diagnostic evaluation procedure recommended after an initial cancer diagnosis.</data>
      <data key="d3">chunk-b0bad5ee25cb854c10bdbc9d33b54a1a&lt;SEP&gt;chunk-29b3a349650a8bb55b318dcc6ecb0519</data>
    </node>
    <node id="Anoscopy">
      <data key="d0">Anoscopy</data>
      <data key="d1">event</data>
      <data key="d2">An endoscopic examination of the anal canal recommended every 6 to 12 months for 3 years post-treatment, when tolerated.&lt;SEP&gt;An examination of the anal canal and lower rectum recommended every 6 to 12 months for surveillance after recurrence treatment for patients without APR.&lt;SEP&gt;An examination procedure recommended after diagnosis to evaluate the anal canal.</data>
      <data key="d3">chunk-5349eed06f06d7c9bcb541ced69e4664&lt;SEP&gt;chunk-b0bad5ee25cb854c10bdbc9d33b54a1a&lt;SEP&gt;chunk-29b3a349650a8bb55b318dcc6ecb0519</data>
    </node>
    <node id="HIV Testing">
      <data key="d0">HIV Testing</data>
      <data key="d1">event</data>
      <data key="d2">A diagnostic screening test recommended after diagnosis to check for human immunodeficiency virus infection.</data>
      <data key="d3">chunk-b0bad5ee25cb854c10bdbc9d33b54a1a</data>
    </node>
    <node id="Cervical Cancer Screening">
      <data key="d0">Cervical Cancer Screening</data>
      <data key="d1">event</data>
      <data key="d2">A screening assessment recommended after an anal cancer diagnosis to check for co-occurring cervical cancer.</data>
      <data key="d3">chunk-b0bad5ee25cb854c10bdbc9d33b54a1a</data>
    </node>
    <node id="Aquaphor">
      <data key="d0">Aquaphor</data>
      <data key="d1">category</data>
      <data key="d2">An over-the-counter soothing ointment recommended to help alleviate skin irritation and breakdown caused by radiation therapy.</data>
      <data key="d3">chunk-b0bad5ee25cb854c10bdbc9d33b54a1a</data>
    </node>
    <node id="Silvadene">
      <data key="d0">Silvadene</data>
      <data key="d1">category</data>
      <data key="d2">An over-the-counter healing cream suggested for use under the guidance of a radiation oncologist to treat skin damage from radiation.</data>
      <data key="d3">chunk-b0bad5ee25cb854c10bdbc9d33b54a1a</data>
    </node>
    <node id="Linear Accelerator">
      <data key="d0">Linear Accelerator</data>
      <data key="d1">category</data>
      <data key="d2">A large specialized machine used in external beam radiation therapy to deliver targeted high-energy x-rays.</data>
      <data key="d3">chunk-b0bad5ee25cb854c10bdbc9d33b54a1a</data>
    </node>
    <node id="Groin">
      <data key="d0">Groin</data>
      <data key="d1">geo</data>
      <data key="d2">The anatomical junction of the lower abdomen and the thigh containing vital lymph node basins.&lt;SEP&gt;The anatomical region where regional lymph nodes are located and targeted during radiation therapy for anal cancer.</data>
      <data key="d3">chunk-b0bad5ee25cb854c10bdbc9d33b54a1a&lt;SEP&gt;chunk-0d4cea71149e0e4157126efdaa0ea3e3</data>
    </node>
    <node id="Mitomycin">
      <data key="d0">Mitomycin</data>
      <data key="d1">category</data>
      <data key="d2">A chemotherapy drug commonly recommended in combination with capecitabine or 5-FU alongside radiation therapy for anal cancer.&lt;SEP&gt;An intravenous chemotherapy medicine administered on specific days in combination with capecitabine or 5-FU for anal cancer treatment.</data>
      <data key="d3">chunk-6236b93e627d54f73f1c8fe341127e67&lt;SEP&gt;chunk-0fdcce851d69aa713ed64ba1895bd5d1</data>
    </node>
    <node id="5-FU">
      <data key="d0">5-FU</data>
      <data key="d1">category</data>
      <data key="d2">Fluorouracil (5-FU) is a chemotherapy drug given via continuous intravenous infusion over several days using a wearable pump and catheter.&lt;SEP&gt;Fluorouracil, a chemotherapy drug used in combination regimens with mitomycin or cisplatin alongside radiation for anal cancer.</data>
      <data key="d3">chunk-6236b93e627d54f73f1c8fe341127e67&lt;SEP&gt;chunk-0fdcce851d69aa713ed64ba1895bd5d1</data>
    </node>
    <node id="PICC Line">
      <data key="d0">PICC Line</data>
      <data key="d1">category</data>
      <data key="d2">A deep intravenous line placed in the arm as a temporary alternative to a chest port for continuous chemotherapy infusion.</data>
      <data key="d3">chunk-0fdcce851d69aa713ed64ba1895bd5d1</data>
    </node>
    <node id="Hand-Foot Syndrome">
      <data key="d0">Hand-Foot Syndrome</data>
      <data key="d1">category</data>
      <data key="d2">A dermatologic side effect associated with capecitabine treatment, causing redness, swelling, pain, and blistering on the palms and soles.</data>
      <data key="d3">chunk-0fdcce851d69aa713ed64ba1895bd5d1</data>
    </node>
    <node id="Surgical Margin">
      <data key="d0">Surgical Margin</data>
      <data key="d1">category</data>
      <data key="d2">The edge of normal tissue removed around a tumor during local excision, evaluated for the absence of cancer cells.</data>
      <data key="d3">chunk-0fdcce851d69aa713ed64ba1895bd5d1</data>
    </node>
    <node id="Feedback Survey">
      <data key="d0">Feedback Survey</data>
      <data key="d1">event</data>
      <data key="d2">An online feedback initiative conducted by NCCN to improve educational materials for cancer patients.</data>
      <data key="d3">chunk-0fdcce851d69aa713ed64ba1895bd5d1</data>
    </node>
    <node id="5-FU Infusion">
      <data key="d0">5-FU Infusion</data>
      <data key="d1">event</data>
      <data key="d2">A multi-day continuous intravenous administration event delivering 5-FU medication through a wearable pump.</data>
      <data key="d3">chunk-0fdcce851d69aa713ed64ba1895bd5d1</data>
    </node>
    <node id="Janet">
      <data key="d0">Janet</data>
      <data key="d1">person</data>
      <data key="d2">Janet is an anal cancer survivor who advocates against stigma, emphasizing that anal cancer can affect anyone.</data>
      <data key="d3">chunk-29b3a349650a8bb55b318dcc6ecb0519</data>
    </node>
    <node id="Complete Remission">
      <data key="d0">Complete Remission</data>
      <data key="d1">category</data>
      <data key="d2">A post-treatment diagnostic category indicating that there are no detectable signs of cancer remaining in the body.</data>
      <data key="d3">chunk-29b3a349650a8bb55b318dcc6ecb0519</data>
    </node>
    <node id="Persistent Disease">
      <data key="d0">Persistent Disease</data>
      <data key="d1">category</data>
      <data key="d2">A clinical category describing cancer that remains in the body after treatment but has not grown or spread.</data>
      <data key="d3">chunk-29b3a349650a8bb55b318dcc6ecb0519</data>
    </node>
    <node id="Progressive Disease">
      <data key="d0">Progressive Disease</data>
      <data key="d1">category</data>
      <data key="d2">A clinical category describing cancer that has continued to grow or spread following treatment.</data>
      <data key="d3">chunk-29b3a349650a8bb55b318dcc6ecb0519</data>
    </node>
    <node id="G1 (Low Grade)">
      <data key="d0">G1 (Low Grade)</data>
      <data key="d1">category</data>
      <data key="d2">A grading category representing well-differentiated cancer cells eligible for local excision in perianal cancer cases.</data>
      <data key="d3">chunk-29b3a349650a8bb55b318dcc6ecb0519</data>
    </node>
    <node id="G2 (Intermediate Grade)">
      <data key="d0">G2 (Intermediate Grade)</data>
      <data key="d1">category</data>
      <data key="d2">A grading category representing moderately differentiated cancer cells eligible for local excision in perianal cancer cases.</data>
      <data key="d3">chunk-29b3a349650a8bb55b318dcc6ecb0519</data>
    </node>
    <node id="G3 (High Grade)">
      <data key="d0">G3 (High Grade)</data>
      <data key="d1">category</data>
      <data key="d2">A grading category representing poorly differentiated cancer cells that typically require chemoradiation rather than local excision.</data>
      <data key="d3">chunk-29b3a349650a8bb55b318dcc6ecb0519</data>
    </node>
    <node id="G4 (High Grade)">
      <data key="d0">G4 (High Grade)</data>
      <data key="d1">category</data>
      <data key="d2">A grading category representing undifferentiated cancer cells requiring intensive multimodal therapy like chemoradiation.</data>
      <data key="d3">chunk-29b3a349650a8bb55b318dcc6ecb0519</data>
    </node>
    <node id="Follow-Up Examination">
      <data key="d0">Follow-Up Examination</data>
      <data key="d1">event</data>
      <data key="d2">A clinical assessment with digital rectal examination and anoscopy recommended 8 to 12 weeks after chemoradiation to evaluate treatment efficacy.</data>
      <data key="d3">chunk-29b3a349650a8bb55b318dcc6ecb0519</data>
    </node>
    <node id="Abdominoperineal Resection (APR)">
      <data key="d0">Abdominoperineal Resection (APR)</data>
      <data key="d1">event</data>
      <data key="d2">A radical surgical procedure involving excision of the anus and perineum, indicated for locally progressive or recurrent anal cancer.</data>
      <data key="d3">chunk-29b3a349650a8bb55b318dcc6ecb0519</data>
    </node>
    <node id="Stage I Cancer">
      <data key="d0">Stage I Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A stage of cancer that, if high-grade and perianal, warrants chemoradiation rather than local excision.</data>
      <data key="d3">chunk-29b3a349650a8bb55b318dcc6ecb0519</data>
    </node>
    <node id="Stage II Cancer">
      <data key="d0">Stage II Cancer</data>
      <data key="d1">category</data>
      <data key="d2">A stage of cancer that is recommended for chemoradiation if high-grade or if it has invaded the sphincter, and requires annual imaging surveillance.</data>
      <data key="d3">chunk-29b3a349650a8bb55b318dcc6ecb0519</data>
    </node>
    <node id="Stage III Cancer">
      <data key="d0">Stage III Cancer</data>
      <data key="d1">category</data>
      <data key="d2">An advanced stage of nonmetastatic anal cancer that requires chemoradiation followed by surveillance, including regular imaging.</data>
      <data key="d3">chunk-29b3a349650a8bb55b318dcc6ecb0519</data>
    </node>
    <node id="Re-Excision">
      <data key="d0">Re-Excision</data>
      <data key="d1">event</data>
      <data key="d2">A secondary surgical procedure performed when the initial excision margin is less than 1 cm or contains cancer cells.</data>
      <data key="d3">chunk-29b3a349650a8bb55b318dcc6ecb0519</data>
    </node>
    <node id="Inguinal Lymph Node Exam">
      <data key="d0">Inguinal Lymph Node Exam</data>
      <data key="d1">event</data>
      <data key="d2">A physical examination of the groin lymph nodes conducted every 3 to 6 months for 5 years following treatment.</data>
      <data key="d3">chunk-29b3a349650a8bb55b318dcc6ecb0519</data>
    </node>
    <node id="Recurrent Anal Cancer">
      <data key="d0">Recurrent Anal Cancer</data>
      <data key="d1">category</data>
      <data key="d2">Recurrent anal cancer is cancer that returns to the anal area or regional lymph nodes following initial treatment.</data>
      <data key="d3">chunk-5349eed06f06d7c9bcb541ced69e4664</data>
    </node>
    <node id="Permanent Colostomy">
      <data key="d0">Permanent Colostomy</data>
      <data key="d1">category</data>
      <data key="d2">A permanent colostomy is a surgical creation of an opening (stoma) on the abdomen connecting to the colon to allow stool to exit into an external bag.</data>
      <data key="d3">chunk-5349eed06f06d7c9bcb541ced69e4664</data>
    </node>
    <node id="Groin Dissection">
      <data key="d0">Groin Dissection</data>
      <data key="d1">category</data>
      <data key="d2">A groin dissection is a surgical procedure to remove cancerous lymph nodes located in the groin area.&lt;SEP&gt;A surgical procedure recommended if anal cancer recurs in the lymph nodes of the groin following prior radiation.</data>
      <data key="d3">chunk-5349eed06f06d7c9bcb541ced69e4664&lt;SEP&gt;chunk-6236b93e627d54f73f1c8fe341127e67</data>
    </node>
    <node id="Muscle Flap Reconstruction">
      <data key="d0">Muscle Flap Reconstruction</data>
      <data key="d1">category</data>
      <data key="d2">A surgical reconstruction technique using muscle tissue to fill pelvic and perineal defects after extensive tissue removal such as APR.&lt;SEP&gt;Muscle flap reconstruction is a reconstructive surgical technique using tissue from another area of the body, such as the rectus abdominis, to promote perineal wound healing.</data>
      <data key="d3">chunk-5349eed06f06d7c9bcb541ced69e4664&lt;SEP&gt;chunk-419f40f64b13b1b2d0fac3cfb9fde92a</data>
    </node>
    <node id="Carboplatin and Paclitaxel">
      <data key="d0">Carboplatin and Paclitaxel</data>
      <data key="d1">category</data>
      <data key="d2">A chemotherapy regimen combining carboplatin and paclitaxel, recommended for treating recurrent anal cancer in lymph nodes and metastatic anal cancer.</data>
      <data key="d3">chunk-5349eed06f06d7c9bcb541ced69e4664</data>
    </node>
    <node id="5-FU and Cisplatin">
      <data key="d0">5-FU and Cisplatin</data>
      <data key="d1">category</data>
      <data key="d2">A systemic chemotherapy regimen composed of 5-fluorouracil and cisplatin used in treating recurrent lymph node cancer and metastatic anal cancer.</data>
      <data key="d3">chunk-5349eed06f06d7c9bcb541ced69e4664</data>
    </node>
    <node id="FOLFCIS">
      <data key="d0">FOLFCIS</data>
      <data key="d1">category</data>
      <data key="d2">A chemotherapy regimen consisting of 5-FU, leucovorin, and cisplatin recommended as an option for metastatic anal cancer.</data>
      <data key="d3">chunk-5349eed06f06d7c9bcb541ced69e4664</data>
    </node>
    <node id="Modified DCF">
      <data key="d0">Modified DCF</data>
      <data key="d1">category</data>
      <data key="d2">A modified chemotherapy regimen consisting of docetaxel, cisplatin, and fluorouracil used for metastatic anal cancer, typically not followed by chemoradiation.</data>
      <data key="d3">chunk-5349eed06f06d7c9bcb541ced69e4664</data>
    </node>
    <node id="Mitomycin and Capecitabine">
      <data key="d0">Mitomycin and Capecitabine</data>
      <data key="d1">category</data>
      <data key="d2">A chemotherapy regimen utilized in combination with radiation therapy for recurrent groin lymph node disease in patients without prior radiation.</data>
      <data key="d3">chunk-5349eed06f06d7c9bcb541ced69e4664</data>
    </node>
    <node id="5-FU and Mitomycin">
      <data key="d0">5-FU and Mitomycin</data>
      <data key="d1">category</data>
      <data key="d2">A chemotherapy regimen given alongside radiation therapy for recurrent inguinal lymph nodes in patients who received no prior radiation therapy.</data>
      <data key="d3">chunk-5349eed06f06d7c9bcb541ced69e4664</data>
    </node>
    <node id="Imaging Surveillance">
      <data key="d0">Imaging Surveillance</data>
      <data key="d1">category</data>
      <data key="d2">Periodic radiological evaluations—including CT of the chest, abdomen, and pelvis or MRI—recommended annually for 3 years following treatment for cancer recurrence.</data>
      <data key="d3">chunk-5349eed06f06d7c9bcb541ced69e4664</data>
    </node>
    <node id="Thom">
      <data key="d0">Thom</data>
      <data key="d1">person</data>
      <data key="d2">Thom is an anal cancer survivor who advocates for patient self-care, organization, note-taking, and active communication with healthcare teams.&lt;SEP&gt;Thom is an anal cancer survivor who shares words of encouragement about recovering from treatment and coping with life after cancer.</data>
      <data key="d3">chunk-c35816f05289661283f683145d9f395f&lt;SEP&gt;chunk-cf41d1c08e8df109ad214d831867a5d9</data>
    </node>
    <node id="Melissa">
      <data key="d0">Melissa</data>
      <data key="d1">person</data>
      <data key="d2">Melissa is an anal cancer survivor who advocates finding an experienced oncology team specializing in rare cancers.</data>
      <data key="d3">chunk-6236b93e627d54f73f1c8fe341127e67</data>
    </node>
    <node id="Survivorship">
      <data key="d0">Survivorship</data>
      <data key="d1">category</data>
      <data key="d2">Survivorship is a phase of post-treatment cancer care addressing the physical, emotional, and long-term health needs of cancer survivors.</data>
      <data key="d3">chunk-6236b93e627d54f73f1c8fe341127e67</data>
    </node>
    <node id="IMRT">
      <data key="d0">IMRT</data>
      <data key="d1">category</data>
      <data key="d2">Intensity-Modulated Radiation Therapy, an advanced radiation technique recommended for anal cancer that limits radiation exposure to adjacent healthy organs and tissues.</data>
      <data key="d3">chunk-6236b93e627d54f73f1c8fe341127e67</data>
    </node>
    <node id="APR Surgery">
      <data key="d0">APR Surgery</data>
      <data key="d1">category</data>
      <data key="d2">Abdominoperineal resection, a surgical procedure to remove the anus and create a permanent colostomy when anal cancer recurs or fails initial treatment.</data>
      <data key="d3">chunk-6236b93e627d54f73f1c8fe341127e67</data>
    </node>
    <node id="Survivorship Care Plan">
      <data key="d0">Survivorship Care Plan</data>
      <data key="d1">category</data>
      <data key="d2">A comprehensive written document created by an oncologist detailing treatment history, side effects, and follow-up schedules for post-treatment cancer management.</data>
      <data key="d3">chunk-6236b93e627d54f73f1c8fe341127e67</data>
    </node>
    <node id="Anal Cancer Foundation">
      <data key="d0">Anal Cancer Foundation</data>
      <data key="d1">organization</data>
      <data key="d2">An advocacy and support organization dedicated to empowering patients, accelerating research, and providing resources for anal cancer.&lt;SEP&gt;The Anal Cancer Foundation is a non-profit patient advocacy organization providing support, education, and research funding for anal cancer.&lt;SEP&gt;The Anal Cancer Foundation is an organization providing support to anal cancer patients and caregivers, notably through its Peer-To-Peer Support Program.</data>
      <data key="d3">chunk-0d4cea71149e0e4157126efdaa0ea3e3&lt;SEP&gt;chunk-419f40f64b13b1b2d0fac3cfb9fde92a&lt;SEP&gt;chunk-cf41d1c08e8df109ad214d831867a5d9</data>
    </node>
    <node id="Pelvic Floor Physical Therapy">
      <data key="d0">Pelvic Floor Physical Therapy</data>
      <data key="d1">category</data>
      <data key="d2">A specialized therapy involving exercises and hands-on techniques to strengthen muscles supporting pelvic organs, assisting bowel, bladder, and sexual recovery.</data>
      <data key="d3">chunk-cf41d1c08e8df109ad214d831867a5d9</data>
    </node>
    <node id="Vaginal Dilator Therapy">
      <data key="d0">Vaginal Dilator Therapy</data>
      <data key="d1">category</data>
      <data key="d2">A therapeutic intervention utilizing dilators of varying sizes to prevent and manage vaginal stenosis caused by pelvic radiation therapy.</data>
      <data key="d3">chunk-cf41d1c08e8df109ad214d831867a5d9</data>
    </node>
    <node id="Ostomy Care">
      <data key="d0">Ostomy Care</data>
      <data key="d1">category</data>
      <data key="d2">A specialized branch of healthcare and patient self-management aimed at maintaining quality of life and active living for individuals with an ostomy.</data>
      <data key="d3">chunk-cf41d1c08e8df109ad214d831867a5d9</data>
    </node>
    <node id="Peer-To-Peer Support Program">
      <data key="d0">Peer-To-Peer Support Program</data>
      <data key="d1">category</data>
      <data key="d2">A supportive initiative established by the Anal Cancer Foundation to pair patients and caregivers with trained peer volunteers.</data>
      <data key="d3">chunk-cf41d1c08e8df109ad214d831867a5d9</data>
    </node>
    <node id="Fecal Incontinence">
      <data key="d0">Fecal Incontinence</data>
      <data key="d1">category</data>
      <data key="d2">A condition involving involuntary loss of bowel control, which can occur as a complication following anal cancer treatment.</data>
      <data key="d3">chunk-cf41d1c08e8df109ad214d831867a5d9</data>
    </node>
    <node id="Pelvic Floor">
      <data key="d0">Pelvic Floor</data>
      <data key="d1">category</data>
      <data key="d2">A group of muscles that supports the pelvic organs and plays a critical role in bowel and bladder control, as well as sexual function.</data>
      <data key="d3">chunk-cf41d1c08e8df109ad214d831867a5d9</data>
    </node>
    <node id="Kegel Exercises">
      <data key="d0">Kegel Exercises</data>
      <data key="d1">category</data>
      <data key="d2">At-home physical exercises designed to tighten and release the vaginal and anal muscles to improve pelvic floor strength.</data>
      <data key="d3">chunk-cf41d1c08e8df109ad214d831867a5d9</data>
    </node>
    <node id="Vaginal Stenosis">
      <data key="d0">Vaginal Stenosis</data>
      <data key="d1">category</data>
      <data key="d2">A condition causing shortening, narrowing, and scarring of the vaginal canal, frequently secondary to pelvic radiation or surgery.&lt;SEP&gt;The medical narrowing and shortening of the vagina that often results from pelvic radiation therapy, leading to pain or difficulty with intercourse and exams.</data>
      <data key="d3">chunk-0d4cea71149e0e4157126efdaa0ea3e3&lt;SEP&gt;chunk-cf41d1c08e8df109ad214d831867a5d9</data>
    </node>
    <node id="Cancer Screening">
      <data key="d0">Cancer Screening</data>
      <data key="d1">category</data>
      <data key="d2">Preventive medical evaluations for detecting secondary malignancies such as breast, cervical, colorectal, and prostate cancers in cancer survivors.</data>
      <data key="d3">chunk-cf41d1c08e8df109ad214d831867a5d9</data>
    </node>
    <node id="Dietitian">
      <data key="d0">Dietitian</data>
      <data key="d1">category</data>
      <data key="d2">Healthcare professionals specializing in oncology nutrition who provide dietary guidance to manage bowel changes after cancer therapy.</data>
      <data key="d3">chunk-cf41d1c08e8df109ad214d831867a5d9</data>
    </node>
    <node id="Sexual Health Therapist">
      <data key="d0">Sexual Health Therapist</data>
      <data key="d1">category</data>
      <data key="d2">Mental health and wellness practitioners specializing in helping cancer survivors address and overcome post-treatment sexual dysfunction.</data>
      <data key="d3">chunk-cf41d1c08e8df109ad214d831867a5d9</data>
    </node>
    <node id="Ostomy Nurse">
      <data key="d0">Ostomy Nurse</data>
      <data key="d1">category</data>
      <data key="d2">A specialized healthcare provider trained in assisting and educating patients with stomas and ostomies.</data>
      <data key="d3">chunk-cf41d1c08e8df109ad214d831867a5d9</data>
    </node>
    <node id="Cancer Survivorship">
      <data key="d0">Cancer Survivorship</data>
      <data key="d1">category</data>
      <data key="d2">A phase of cancer care focused on maintaining healthy living, managing long-term side effects, and addressing emotional and physical well-being after diagnosis and treatment.</data>
      <data key="d3">chunk-44a870810cef881997b741c32ec368fe</data>
    </node>
    <node id="Integrative Oncology">
      <data key="d0">Integrative Oncology</data>
      <data key="d1">category</data>
      <data key="d2">A medical approach to cancer care that combines conventional standard cancer treatments with evidence-based complementary and alternative therapies.</data>
      <data key="d3">chunk-44a870810cef881997b741c32ec368fe</data>
    </node>
    <node id="Complementary And Alternative Therapies">
      <data key="d0">Complementary And Alternative Therapies</data>
      <data key="d1">category</data>
      <data key="d2">A collection of non-conventional health practices and products, such as acupuncture, meditation, and massage therapy, used to ease side effects and support cancer patients.</data>
      <data key="d3">chunk-44a870810cef881997b741c32ec368fe</data>
    </node>
    <node id="Shared Decision-Making">
      <data key="d0">Shared Decision-Making</data>
      <data key="d1">category</data>
      <data key="d2">A collaborative communication process between cancer patients and their doctors to agree upon a treatment plan aligned with the patient's values and medical options.</data>
      <data key="d3">chunk-44a870810cef881997b741c32ec368fe</data>
    </node>
    <node id="Second Opinion">
      <data key="d0">Second Opinion</data>
      <data key="d1">category</data>
      <data key="d2">An evaluation obtained from an independent medical expert to verify a diagnosis or review proposed cancer treatment plans.&lt;SEP&gt;The practice of having another physician evaluate diagnosis and test results to suggest or validate a cancer treatment plan.</data>
      <data key="d3">chunk-44a870810cef881997b741c32ec368fe&lt;SEP&gt;chunk-419f40f64b13b1b2d0fac3cfb9fde92a</data>
    </node>
    <node id="Bone Density Monitoring">
      <data key="d0">Bone Density Monitoring</data>
      <data key="d1">category</data>
      <data key="d2">A surveillance procedure used to assess pelvic bone strength and fracture risk following pelvic radiation therapy.</data>
      <data key="d3">chunk-44a870810cef881997b741c32ec368fe</data>
    </node>
    <node id="Smoking Cessation">
      <data key="d0">Smoking Cessation</data>
      <data key="d1">category</data>
      <data key="d2">The process of quitting tobacco use through physician-guided counseling and lifestyle interventions to reduce recurrence and secondary cancer risks.</data>
      <data key="d3">chunk-44a870810cef881997b741c32ec368fe</data>
    </node>
    <node id="Health Insurance Companies">
      <data key="d0">Health Insurance Companies</data>
      <data key="d1">organization</data>
      <data key="d2">Financial and healthcare organizations whose policies and coverage networks determine out-of-pocket costs for cancer treatments and second opinions.</data>
      <data key="d3">chunk-44a870810cef881997b741c32ec368fe</data>
    </node>
    <node id="Fertility Specialists">
      <data key="d0">Fertility Specialists</data>
      <data key="d1">category</data>
      <data key="d2">Medical experts consulted to discuss fertility preservation before initiating cancer treatments that may impair reproductive capability.</data>
      <data key="d3">chunk-44a870810cef881997b741c32ec368fe</data>
    </node>
    <node id="Acupuncture">
      <data key="d0">Acupuncture</data>
      <data key="d1">category</data>
      <data key="d2">A complementary therapeutic technique used to alleviate side effects and enhance comfort during and after cancer treatment.</data>
      <data key="d3">chunk-44a870810cef881997b741c32ec368fe</data>
    </node>
    <node id="Medical Marijuana">
      <data key="d0">Medical Marijuana</data>
      <data key="d1">category</data>
      <data key="d2">A complementary therapeutic product utilized in cancer care to alleviate symptoms and treatment-related discomfort.</data>
      <data key="d3">chunk-44a870810cef881997b741c32ec368fe</data>
    </node>
    <node id="Yoga">
      <data key="d0">Yoga</data>
      <data key="d1">category</data>
      <data key="d2">A mind-body complementary practice used in integrative oncology to promote patient well-being and symptom relief.</data>
      <data key="d3">chunk-44a870810cef881997b741c32ec368fe</data>
    </node>
    <node id="Meditation">
      <data key="d0">Meditation</data>
      <data key="d1">category</data>
      <data key="d2">A complementary mindfulness practice employed to manage emotional distress, anxiety, and side effects during cancer care.</data>
      <data key="d3">chunk-44a870810cef881997b741c32ec368fe</data>
    </node>
    <node id="American Cancer Society">
      <data key="d0">American Cancer Society</data>
      <data key="d1">organization</data>
      <data key="d2">A prominent health organization providing information, support, and resources on cancer, including anal cancer.&lt;SEP&gt;The American Cancer Society is a nationwide voluntary health organization dedicated to eliminating cancer and providing patient support and information.</data>
      <data key="d3">chunk-0d4cea71149e0e4157126efdaa0ea3e3&lt;SEP&gt;chunk-419f40f64b13b1b2d0fac3cfb9fde92a</data>
    </node>
    <node id="Cancer Hope Network">
      <data key="d0">Cancer Hope Network</data>
      <data key="d1">organization</data>
      <data key="d2">A supportive care organization offering peer mentorship and resources for cancer patients and their families.&lt;SEP&gt;Cancer Hope Network is an organization providing free, confidential one-on-one peer support for cancer patients and their loved ones.</data>
      <data key="d3">chunk-0d4cea71149e0e4157126efdaa0ea3e3&lt;SEP&gt;chunk-419f40f64b13b1b2d0fac3cfb9fde92a</data>
    </node>
    <node id="Cancer.Net">
      <data key="d0">Cancer.Net</data>
      <data key="d1">organization</data>
      <data key="d2">An oncologist-approved patient information resource offering comprehensive guides on cancer types, including anal cancer.&lt;SEP&gt;Cancer.Net is a comprehensive, oncologist-approved patient information resource offering guides and educational materials on various cancer types.</data>
      <data key="d3">chunk-0d4cea71149e0e4157126efdaa0ea3e3&lt;SEP&gt;chunk-419f40f64b13b1b2d0fac3cfb9fde92a</data>
    </node>
    <node id="CancerCare">
      <data key="d0">CancerCare</data>
      <data key="d1">organization</data>
      <data key="d2">A national organization providing free, professional support services to anyone affected by cancer.&lt;SEP&gt;CancerCare is a national organization providing free professional support services, counseling, and financial assistance to people affected by cancer.</data>
      <data key="d3">chunk-0d4cea71149e0e4157126efdaa0ea3e3&lt;SEP&gt;chunk-419f40f64b13b1b2d0fac3cfb9fde92a</data>
    </node>
    <node id="Cancer Support Community">
      <data key="d0">Cancer Support Community</data>
      <data key="d1">organization</data>
      <data key="d2">A global non-profit network of cancer support dedicated to uplifting and strengthening people impacted by cancer.&lt;SEP&gt;Cancer Support Community is an international non-profit dedicated to providing support services, education, and hope to cancer patients and families.</data>
      <data key="d3">chunk-0d4cea71149e0e4157126efdaa0ea3e3&lt;SEP&gt;chunk-419f40f64b13b1b2d0fac3cfb9fde92a</data>
    </node>
    <node id="Colorectal Cancer Alliance">
      <data key="d0">Colorectal Cancer Alliance</data>
      <data key="d1">organization</data>
      <data key="d2">A non-profit organization dedicated to ending colorectal cancer through patient support, research, and prevention.&lt;SEP&gt;The Colorectal Cancer Alliance is a non-profit dedicated to ending colorectal-related cancers through patient support, awareness, and research.</data>
      <data key="d3">chunk-0d4cea71149e0e4157126efdaa0ea3e3&lt;SEP&gt;chunk-419f40f64b13b1b2d0fac3cfb9fde92a</data>
    </node>
    <node id="Fight Colorectal Cancer">
      <data key="d0">Fight Colorectal Cancer</data>
      <data key="d1">organization</data>
      <data key="d2">An advocacy organization fighting colorectal cancer through research, education, and patient empowerment.&lt;SEP&gt;Fight Colorectal Cancer is an advocacy organization providing research, resources, and policy advocacy for patients with colorectal cancers.</data>
      <data key="d3">chunk-0d4cea71149e0e4157126efdaa0ea3e3&lt;SEP&gt;chunk-419f40f64b13b1b2d0fac3cfb9fde92a</data>
    </node>
    <node id="HPV Cancers Alliance">
      <data key="d0">HPV Cancers Alliance</data>
      <data key="d1">organization</data>
      <data key="d2">An advocacy organization focused on raising awareness, prevention, and support for cancers caused by human papillomavirus.&lt;SEP&gt;HPV Cancers Alliance is an organization dedicated to raising awareness, education, and resources for cancers linked to the human papillomavirus.</data>
      <data key="d3">chunk-0d4cea71149e0e4157126efdaa0ea3e3&lt;SEP&gt;chunk-419f40f64b13b1b2d0fac3cfb9fde92a</data>
    </node>
    <node id="Love Your Buns">
      <data key="d0">Love Your Buns</data>
      <data key="d1">organization</data>
      <data key="d2">An advocacy organization providing support and raising awareness for anal and rectal cancer.&lt;SEP&gt;Love Your Buns is an awareness and support organization focused on educating the public and supporting patients with rectal and anal cancers.</data>
      <data key="d3">chunk-0d4cea71149e0e4157126efdaa0ea3e3&lt;SEP&gt;chunk-419f40f64b13b1b2d0fac3cfb9fde92a</data>
    </node>
    <node id="Pelvic Radiation">
      <data key="d0">Pelvic Radiation</data>
      <data key="d1">category</data>
      <data key="d2">Radiation therapy administered specifically to the pelvic region, an important consideration when evaluating future chemoradiation regimens.</data>
      <data key="d3">chunk-419f40f64b13b1b2d0fac3cfb9fde92a</data>
    </node>
    <node id="Follow-Up Care">
      <data key="d0">Follow-Up Care</data>
      <data key="d1">category</data>
      <data key="d2">Routine medical monitoring, surveillance testing, and healthcare visits conducted after completing cancer therapy to track late effects and detect recurrence.</data>
      <data key="d3">chunk-419f40f64b13b1b2d0fac3cfb9fde92a</data>
    </node>
    <node id="Survivor Support Group">
      <data key="d0">Survivor Support Group</data>
      <data key="d1">category</data>
      <data key="d2">Support networks offering emotional support, peer guidance, and shared resources for cancer survivors post-treatment.</data>
      <data key="d3">chunk-419f40f64b13b1b2d0fac3cfb9fde92a</data>
    </node>
    <node id="National Coalition for Cancer Survivorship">
      <data key="d0">National Coalition for Cancer Survivorship</data>
      <data key="d1">organization</data>
      <data key="d2">An advocacy organization advocating for quality cancer care for all people touched by cancer.</data>
      <data key="d3">chunk-0d4cea71149e0e4157126efdaa0ea3e3</data>
    </node>
    <node id="PAN Foundation">
      <data key="d0">PAN Foundation</data>
      <data key="d1">organization</data>
      <data key="d2">An independent charitable organization that helps federally insured individuals access healthcare and treatment.</data>
      <data key="d3">chunk-0d4cea71149e0e4157126efdaa0ea3e3</data>
    </node>
    <node id="The Anchor Study">
      <data key="d0">The Anchor Study</data>
      <data key="d1">organization</data>
      <data key="d2">A clinical research study evaluating prevention strategies and screening for anal cancer.</data>
      <data key="d3">chunk-0d4cea71149e0e4157126efdaa0ea3e3</data>
    </node>
    <node id="Anal Canal">
      <data key="d0">Anal Canal</data>
      <data key="d1">category</data>
      <data key="d2">A small section of the large intestine connecting the rectum and the anal opening.</data>
      <data key="d3">chunk-0d4cea71149e0e4157126efdaa0ea3e3</data>
    </node>
    <node id="Anal Sphincter">
      <data key="d0">Anal Sphincter</data>
      <data key="d1">category</data>
      <data key="d2">A ring-shaped muscle around the anal opening that regulates opening and closing for stool elimination.</data>
      <data key="d3">chunk-0d4cea71149e0e4157126efdaa0ea3e3</data>
    </node>
    <node id="Anus">
      <data key="d0">Anus</data>
      <data key="d1">category</data>
      <data key="d2">The terminal opening of the large bowel through which digestive waste exits the human body.</data>
      <data key="d3">chunk-0d4cea71149e0e4157126efdaa0ea3e3</data>
    </node>
    <node id="Libido">
      <data key="d0">Libido</data>
      <data key="d1">category</data>
      <data key="d2">Sexual desire or psychosexual energy, which may be affected by cancer and pelvic oncological treatments.</data>
      <data key="d3">chunk-0d4cea71149e0e4157126efdaa0ea3e3</data>
    </node>
    <node id="Perianal Region">
      <data key="d0">Perianal Region</data>
      <data key="d1">category</data>
      <data key="d2">The external surface and skin immediately surrounding the anal opening.</data>
      <data key="d3">chunk-0d4cea71149e0e4157126efdaa0ea3e3</data>
    </node>
    <node id="NCCN">
      <data key="d0">NCCN</data>
      <data key="d1">organization</data>
      <data key="d2">The **National Comprehensive Cancer Network (NCCN)** is an alliance of leading cancer centers and medical experts dedicated to improving oncology care, treatment outcomes, and patient education. The organization develops and publishes authoritative, research-based clinical practice guidelines and recommendations trusted by healthcare providers and patients alike to guide decisions across the continuum of cancer prevention, screening, diagnosis, treatment, supportive care, and survivorship. 

NCCN provides extensive patient-focused educational resources, most notably the *NCCN Guidelines for Patients* series, which translates complex medical recommendations into accessible guidance to help individuals navigate treatment options and disease staging. These resources are</data>
      <data key="d3">chunk-18b5e32980f3efa0cd012e2abab9b9fc&lt;SEP&gt;chunk-bc89a92e9a97781ebca0db50abc34939&lt;SEP&gt;chunk-c1c1687a8a20b9c451956cf8bba241cc&lt;SEP&gt;chunk-e247ae57c50c62bded7114986471226e&lt;SEP&gt;chunk-8ba71a5181f3814dffb21d3399441bea&lt;SEP&gt;chunk-28e4e845dfd1390f7f94cfb11bee1526&lt;SEP&gt;chunk-052101b592e186cce702983d2acc67e4&lt;SEP&gt;chunk-f8eae4d6dadf6a6fbd339efa4dec2172&lt;SEP&gt;chunk-fba176235a4410ba8723447134c92579&lt;SEP&gt;chunk-ba28a3ce3534c0655a0d08a953d7f038&lt;SEP&gt;chunk-725b48dc82aad42ba3dc14f4b5207551&lt;SEP&gt;chunk-541f1323a24c5990b4a6408e0c5442ab&lt;SEP&gt;chunk-82c7205fc2067a4d00e43fd22276db22&lt;SEP&gt;chunk-121b68d5de585c87804c9bce3cdc71eb&lt;SEP&gt;chunk-d73843c009e523101e1464a2b28bc144&lt;SEP&gt;chunk-48e138ec8da954a5667dc785e919c86b&lt;SEP&gt;chunk-ef6586b896c47b361bf4f6aabb4c35d5&lt;SEP&gt;chunk-196a80cd0ae47fda3849b101cca91a15&lt;SEP&gt;chunk-594536d6aaa61f8f1699ba50bf218a33&lt;SEP&gt;chunk-06384634b72466c480713ee8d57f25ed&lt;SEP&gt;chunk-85e75e869fcfcb7c5431dbcdd532137f&lt;SEP&gt;chunk-5a84075aaac61b0ad85e5f811fc4f24b&lt;SEP&gt;chunk-3821a6febf2d21784059ac62a6e659c1&lt;SEP&gt;chunk-d9882c04dd7676c6433074e5e393c72e&lt;SEP&gt;chunk-fc469adbdd7a41816d59f249439bc726&lt;SEP&gt;chunk-01c80b2d18abb91c5be598d33cf7a33a&lt;SEP&gt;chunk-3f05c8ea6f7c7b4ba1fb0ff1c1733980&lt;SEP&gt;chunk-a158766f46bf752d6cdfe95c92f14547&lt;SEP&gt;chunk-8b66e38931f28ed6ac9b231faaf202fb&lt;SEP&gt;chunk-8b44f0b4da13a804cd1dfb917ac7e981&lt;SEP&gt;chunk-cf41d1c08e8df109ad214d831867a5d9&lt;SEP&gt;chunk-7bdde77ad1be3ee9308db3c7703674b0&lt;SEP&gt;chunk-cb41559e96b71d2bb4ea207c806e8d5f&lt;SEP&gt;chunk-53c0ac935ec10ce8a0839db4ad053ad1&lt;SEP&gt;chunk-c37f547042fc10baabdbfaadf010bce5&lt;SEP&gt;chunk-06f823f3a91fcbc32c62fac3c6347715&lt;SEP&gt;chunk-0fdcce851d69aa713ed64ba1895bd5d1&lt;SEP&gt;chunk-44a870810cef881997b741c32ec368fe&lt;SEP&gt;chunk-67015f3916810c4378b2ed269cc27f29&lt;SEP&gt;chunk-0bd86bf8fc82f14fa5f7f51d924514e7&lt;SEP&gt;chunk-419f40f64b13b1b2d0fac3cfb9fde92a&lt;SEP&gt;chunk-ae28e3852f4a9f229250fc19eb39036b&lt;SEP&gt;chunk-f6fd03791661f76f6c1a246b2074b2a0&lt;SEP&gt;chunk-0d4cea71149e0e4157126efdaa0ea3e3&lt;SEP&gt;chunk-ee254e84e63bd35682ed56c41cef9247&lt;SEP&gt;chunk-ea7b3f83164304ee4a562046eb0f5033&lt;SEP&gt;chunk-c9383db20cd696688798a193862cb5cc&lt;SEP&gt;chunk-d47a420aa2acde1175ad95bf6dc2e664&lt;SEP&gt;chunk-8fbedfa2d88a7b3852f4c2bd0bb64af0&lt;SEP&gt;chunk-9040f5949ae0ff36ce88faa1f4b67ead&lt;SEP&gt;chunk-aa251c48fc1fccfe45605a384f743662&lt;SEP&gt;chunk-84367cc8f7a94b97b4b66a1ca127c15f&lt;SEP&gt;chunk-bb68daec67dd8f436d82814b0e61ff21&lt;SEP&gt;chunk-f43f96815f23658d5b24fe95ed4bd5ed&lt;SEP&gt;chunk-d0f15711706bc171fed17a7fab91b4b6&lt;SEP&gt;chunk-d4bc8b1b941d18ac455e5f255e1df8c1&lt;SEP&gt;chunk-ecc6c4bcd3cab65fa05ab5f3c55e528d&lt;SEP&gt;chunk-be6e1cb2fe11f4d9962741c30d446a69&lt;SEP&gt;chunk-7102a43dfb62e649d725bc95ba292688&lt;SEP&gt;chunk-08475506372bb4ce9ec1bd326caf0fe9&lt;SEP&gt;chunk-c622c677deca24391324ecd5f16ce4a3&lt;SEP&gt;chunk-64895edc4d35c98b293c555e32022a37&lt;SEP&gt;chunk-66dd071b6c2be50e36cee1a1c1bd3b33&lt;SEP&gt;chunk-7843955573cdc294b34e74019195fafb&lt;SEP&gt;chunk-b11b0c66441242d2f687a0c55adee585&lt;SEP&gt;chunk-b8a273f96e02707e2e87fc43353ed57f&lt;SEP&gt;chunk-aa14ecd19e2d721cb99ea9590f0ede3a&lt;SEP&gt;chunk-bd06bc83e13e7562ce65d6eee1b6024f&lt;SEP&gt;chunk-925a474b4538dda470bfd817f9d9a17d&lt;SEP&gt;chunk-5fa7c7369d88ae71c842152510867223&lt;SEP&gt;chunk-9fa573748870dc50a98a935843997c68&lt;SEP&gt;chunk-b3958b5f7df8a8fc2661705e37dc1e06&lt;SEP&gt;chunk-1dc8d8e5ed4f165f3e56305a7644ba05&lt;SEP&gt;chunk-e9a7fe3b15f3289198c7114b44890dea&lt;SEP&gt;chunk-7606b44d6a30ad0519bc4c10785de79a&lt;SEP&gt;chunk-d67bee20d5e5400994f8c8f03052dd06&lt;SEP&gt;chunk-cd2be7a2ce722f07b19c80e6e1690a8e&lt;SEP&gt;chunk-098a64d7118fc8e1eb3e91ba0124258c</data>
    </node>
    <node id="Surgery">
      <data key="d0">Surgery</data>
      <data key="d1">category</data>
      <data key="d2">**Surgery** is a conventional, invasive operative medical intervention widely utilized as a primary cancer treatment modality</data>
      <data key="d3">chunk-e74c94f9f2ff33172671e8742338c6d1&lt;SEP&gt;chunk-f6fd03791661f76f6c1a246b2074b2a0&lt;SEP&gt;chunk-8ec4d44b145ca896ff1216caa90ce5dd&lt;SEP&gt;chunk-0739b33959299ea67072f390ce38bffd&lt;SEP&gt;chunk-74f18dd51a0091fc888512458a85b0a1&lt;SEP&gt;chunk-bc89a92e9a97781ebca0db50abc34939&lt;SEP&gt;chunk-8b44f0b4da13a804cd1dfb917ac7e981&lt;SEP&gt;chunk-c9383db20cd696688798a193862cb5cc&lt;SEP&gt;chunk-b4da30dee72e228147daa825e4f5be72&lt;SEP&gt;chunk-b69d38fafe014cece3427bd0459ae42b&lt;SEP&gt;chunk-da0bfe00946dcdff3a8a6fb3d73ce6e1&lt;SEP&gt;chunk-44a870810cef881997b741c32ec368fe&lt;SEP&gt;chunk-0d388da75afb5ea2d01c97e55cb2b872&lt;SEP&gt;chunk-68217ea9e5382d1756c99b5152ea98db&lt;SEP&gt;chunk-f8639a06098656be20a04fe129660616&lt;SEP&gt;chunk-ba28a3ce3534c0655a0d08a953d7f038&lt;SEP&gt;chunk-bd06bc83e13e7562ce65d6eee1b6024f&lt;SEP&gt;chunk-6a93aa507dd7d98a02e8ba92d39e3649&lt;SEP&gt;chunk-aa251c48fc1fccfe45605a384f743662&lt;SEP&gt;chunk-725b48dc82aad42ba3dc14f4b5207551&lt;SEP&gt;chunk-121b68d5de585c87804c9bce3cdc71eb&lt;SEP&gt;chunk-6232dd9ed168a1113955e7300645338b&lt;SEP&gt;chunk-789ec6c06f8c999ac21c89b085b3fdb7&lt;SEP&gt;chunk-b0bad5ee25cb854c10bdbc9d33b54a1a&lt;SEP&gt;chunk-5d8e20e6004dd43ae0f68185383b594d&lt;SEP&gt;chunk-d0f15711706bc171fed17a7fab91b4b6&lt;SEP&gt;chunk-e8ac9bf8f198bc5ad54fd1a7b843e810&lt;SEP&gt;chunk-fa5247d6b8c17e58ab315a0d641c7ad3&lt;SEP&gt;chunk-e9a7fe3b15f3289198c7114b44890dea&lt;SEP&gt;chunk-6268b6efa690f6e094e443dca6b4cb52&lt;SEP&gt;chunk-9ad38c9dc069a8ff8df58c42f00eba23&lt;SEP&gt;chunk-e5406c28b41e499fad4ae44f2c44fdd7&lt;SEP&gt;chunk-cd2be7a2ce722f07b19c80e6e1690a8e&lt;SEP&gt;chunk-64895edc4d35c98b293c555e32022a37&lt;SEP&gt;chunk-66dd071b6c2be50e36cee1a1c1bd3b33</data>

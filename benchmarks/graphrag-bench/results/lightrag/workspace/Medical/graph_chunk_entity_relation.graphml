      <data key="d4">8.0</data>
      <data key="d5">PSA testing is commonly paired with the digital rectal exam to provide a more comprehensive assessment of prostate health.</data>
      <data key="d6">complementary screening, clinical evaluation</data>
      <data key="d7">chunk-9dc281a303d0d4c5300c0c1c45b739ed</data>
    </edge>
    <edge source="Digital Rectal Exam" target="Prostate Biopsy">
      <data key="d4">7.0</data>

    <edge source="Non-Small Cell Lung Cancer" target="Adenocarcinoma">
      <data key="d4">27.0</data>
      <data key="d5">Adenocarcinoma is a major subtype of non-small cell lung cancer.&lt;SEP&gt;Adenocarcinoma is classified as a subtype of non-small cell lung cancer.&lt;SEP&gt;Adenocarcinoma is the most frequent histologic subtype of non-small cell lung cancer.</data>
      <data key="d6">disease classification, cancer subtype&lt;SEP&gt;histological subtype, disease classification&lt;SEP&gt;subtyping, medical classification</data>
      <data key="d7">chunk-bd06bc83e13e7562ce65d6eee1b6024f&lt;SEP&gt;chunk-7843955573cdc294b34e74019195fafb&lt;SEP&gt;chunk-08475506372bb4ce9ec1bd326caf0fe9</data>
    </edge>
    <edge source="Non-Small Cell Lung Cancer" target="Large Cell Carcinoma">
      <data key="d4">27.0</data>
      <data key="d5">Large cell carcinoma is an identified subtype of non-small cell lung cancer.&lt;SEP&gt;Large cell carcinoma is an undifferentiated histological subtype of non-small cell lung cancer.&lt;SEP&gt;Large cell carcinoma is an undifferentiated subtype categorized under non-small cell lung cancer.</data>
      <data key="d6">disease classification, cancer subtype&lt;SEP&gt;histological subtype, disease classification&lt;SEP&gt;subtyping, pathology</data>
      <data key="d7">chunk-bd06bc83e13e7562ce65d6eee1b6024f&lt;SEP&gt;chunk-7843955573cdc294b34e74019195fafb&lt;SEP&gt;chunk-08475506372bb4ce9ec1bd326caf0fe9</data>
    </edge>
    <edge source="Non-Small Cell Lung Cancer" target="Early and Locally Advanced NSCLC">
      <data key="d4">8.0</data>
      <data key="d5">Early and locally advanced NSCLC describes specific clinical stages of non-small cell lung cancer.</data>
      <data key="d6">cancer staging, clinical classification</data>
      <data key="d7">chunk-bd06bc83e13e7562ce65d6eee1b6024f</data>
    </edge>
    <edge source="Non-Small Cell Lung Cancer" target="Lung Nodules">
      <data key="d4">8.0</data>
      <data key="d5">Lung nodules are abnormal growths that may be evaluated and diagnosed as lung cancer.</data>
      <data key="d6">clinical diagnosis, screening</data>
      <data key="d7">chunk-bd06bc83e13e7562ce65d6eee1b6024f</data>
    </edge>
    <edge source="Non-Small Cell Lung Cancer" target="Clinical Trials">
      <data key="d4">7.0</data>
      <data key="d5">Clinical trials offer patients with lung cancer access to research-based therapies and novel treatments.</data>
      <data key="d6">clinical research, treatment options</data>
      <data key="d7">chunk-bd06bc83e13e7562ce65d6eee1b6024f</data>
    </edge>
    <edge source="Non-Small Cell Lung Cancer" target="Stomach Cancer">
      <data key="d4">6.0</data>
      <data key="d5">Stomach cancer metastatic to the lung is distinguished from primary non-small cell lung cancer based on origin.</data>
      <data key="d6">differential diagnosis, disease origin</data>
      <data key="d7">chunk-bd06bc83e13e7562ce65d6eee1b6024f</data>
    </edge>
    <edge source="Non-Small Cell Lung Cancer" target="Combined Cell Lung Carcinoma">
      <data key="d4">8.0</data>
      <data key="d5">Combined cell lung carcinoma features tumor cells from both non-small cell and small cell lung cancer types.</data>
      <data key="d6">tumor composition, disease classification</data>
      <data key="d7">chunk-08475506372bb4ce9ec1bd326caf0fe9</data>
    </edge>
    <edge source="Non-Small Cell Lung Cancer" target="Adenosquamous Carcinoma">
      <data key="d4">9.0</data>
      <data key="d5">Adenosquamous carcinoma is explicitly listed as a subtype of non-small cell lung cancer.</data>
      <data key="d6">subtyping, categorization</data>
      <data key="d7">chunk-08475506372bb4ce9ec1bd326caf0fe9</data>
    </edge>
    <edge source="Non-Small Cell Lung Cancer" target="Sarcomatoid Carcinoma">
      <data key="d4">9.0</data>
      <data key="d5">Sarcomatoid carcinoma is identified as a subtype of non-small cell lung cancer.</data>
      <data key="d6">subtyping, categorization</data>
      <data key="d7">chunk-08475506372bb4ce9ec1bd326caf0fe9</data>
    </edge>
    <edge source="Small Cell Lung Cancer" target="NCCN">
      <data key="d4">8.0</data>
      <data key="d5">NCCN produces resources and guides focusing on small cell lung cancer and its treatment.</data>
      <data key="d6">medical guidance, healthcare resources</data>
      <data key="d7">chunk-08475506372bb4ce9ec1bd326caf0fe9</data>
    </edge>
    <edge source="Small Cell Lung Cancer" target="Combined Cell Lung Carcinoma">
      <data key="d4">8.0</data>
      <data key="d5">Combined cell lung carcinoma contains small cell lung cancer components and is typically managed and treated similarly to SCLC.</data>
      <data key="d6">cancer classification, treatment protocol</data>
      <data key="d7">chunk-08475506372bb4ce9ec1bd326caf0fe9</data>
    </edge>
    <edge source="Small Cell Lung Cancer" target="Smoking">
      <data key="d4">9.0</data>
      <data key="d5">Cigarette smoking is cited as the primary cause and predominant risk factor for developing small cell lung cancer.</data>
      <data key="d6">causality, etiology, risk factors</data>
      <data key="d7">chunk-08475506372bb4ce9ec1bd326caf0fe9</data>
    </edge>
    <edge source="Small Cell Lung Cancer" target="Second-Hand Smoke">
      <data key="d4">8.0</data>
      <data key="d5">Exposure to second-hand smoke acts as an environmental risk factor increasing the likelihood of lung cancer.</data>
      <data key="d6">environmental risk, etiology</data>
      <data key="d7">chunk-08475506372bb4ce9ec1bd326caf0fe9</data>
    </edge>
    <edge source="Small Cell Lung Cancer" target="Lung Cancer Screening">
      <data key="d4">8.0</data>
      <data key="d5">Lung cancer screening aims to identify lung cancers such as small cell lung cancer at early, treatable stages.</data>
      <data key="d6">early detection, clinical intervention</data>
      <data key="d7">chunk-08475506372bb4ce9ec1bd326caf0fe9</data>
    </edge>
    <edge source="Small Cell Lung Cancer" target="Small Cell Carcinoma">
      <data key="d4">9.0</data>
      <data key="d5">Small cell carcinoma is one of the main subtypes under the small cell lung cancer diagnosis.</data>
      <data key="d6">subtyping, disease classification</data>
      <data key="d7">chunk-08475506372bb4ce9ec1bd326caf0fe9</data>
    </edge>
    <edge source="Small Cell Lung Cancer" target="Scientists">
      <data key="d4">7.0</data>
      <data key="d5">Scientific research into cancer cell behavior has driven the improvement of modern treatments.</data>
      <data key="d6">scientific research, therapeutic advancements</data>
      <data key="d7">chunk-08475506372bb4ce9ec1bd326caf0fe9</data>
    </edge>
    <edge source="CML Specialist" target="Care Team">
      <data key="d4">8.0</data>
      <data key="d5">A CML specialist collaborates within or alongside the broader clinical care team to guide cancer decision-making.</data>
      <data key="d6">clinical collaboration, patient care</data>
      <data key="d7">chunk-ef6586b896c47b361bf4f6aabb4c35d5</data>
    </edge>
    <edge source="CML Specialist" target="CML">
      <data key="d4">8.0</data>
      <data key="d5">Patients diagnosed with CML are advised to consult a CML specialist to guide treatment planning and disease management.</data>
      <data key="d6">medical consultation, cancer care</data>
      <data key="d7">chunk-7606b44d6a30ad0519bc4c10785de79a</data>
    </edge>
    <edge source="Caregiver" target="Care Team">
      <data key="d4">15.0</data>
      <data key="d5">Caregivers interact directly with the care team to ask questions, manage treatment steps, and communicate patient needs.&lt;SEP&gt;Caregivers interact with the care team by communicating about patient symptoms and asking questions during consultations.</data>
      <data key="d6">advocacy, communication, support&lt;SEP&gt;care coordination, patient support</data>
      <data key="d7">chunk-f9a9eb8b01f29fdf214c10bdffac3203&lt;SEP&gt;chunk-ef6586b896c47b361bf4f6aabb4c35d5</data>
    </edge>
    <edge source="Caregiver" target="Doctor Visits">
      <data key="d4">9.0</data>
      <data key="d5">Caregivers accompany patients to doctor visits to take notes, ask questions, and provide physical and emotional assistance.</data>
      <data key="d6">appointment attendance, patient support</data>
      <data key="d7">chunk-ef6586b896c47b361bf4f6aabb4c35d5</data>
    </edge>
    <edge source="Caregiver" target="Health Care Team">
      <data key="d4">7.0</data>
      <data key="d5">Caregivers attend appointments, take notes, and communicate with the health care team on behalf of the patient.</data>
      <data key="d6">patient support, clinical engagement</data>
      <data key="d7">chunk-829d6b7840e9f2c8d97d22d2ce2c43c1</data>
    </edge>
    <edge source="Caregiver" target="Primary CNS Lymphoma">
      <data key="d4">9.0</data>
      <data key="d5">Caregivers provide critical physical, cognitive, and daily living assistance to individuals managing primary CNS lymphoma.</data>
      <data key="d6">patient support, caregiving</data>
      <data key="d7">chunk-4966a628b12ecec4187796598764cf23</data>
    </edge>
    <edge source="Caregiver" target="Doctor Visit">
      <data key="d4">9.0</data>
      <data key="d5">Caregivers accompany patients to doctor visits or join via phone or telehealth to ask questions and take notes.</data>
      <data key="d6">appointment attendance, support role</data>
      <data key="d7">chunk-f9a9eb8b01f29fdf214c10bdffac3203</data>
    </edge>
    <edge source="Doctor Visits" target="Telehealth Visits">
      <data key="d4">7.0</data>
      <data key="d5">Telehealth visits serve as virtual alternatives or complements to in-person doctor visits for care continuity.</data>
      <data key="d6">telemedicine, clinical consultations</data>
      <data key="d7">chunk-ef6586b896c47b361bf4f6aabb4c35d5</data>
    </edge>
    <edge source="Doctor Visits" target="Care Team">
      <data key="d4">24.0</data>
      <data key="d5">Doctor visits provide the setting for patients to interact directly with their care team, share concerns, and receive test results.&lt;SEP&gt;Patients interact with and take notes from their care team during scheduled doctor visits.&lt;SEP&gt;The care team meets with patients and caregivers during doctor visits to review test results and discuss care.</data>
      <data key="d6">clinical consultation, patient-provider interaction&lt;SEP&gt;patient consultation, care delivery&lt;SEP&gt;patient-provider consultation, clinical care</data>
      <data key="d7">chunk-7606b44d6a30ad0519bc4c10785de79a&lt;SEP&gt;chunk-a06038ec84f20e873b9e275a23aea8d9&lt;SEP&gt;chunk-1dc8d8e5ed4f165f3e56305a7644ba05</data>
    </edge>
    <edge source="Doctor Visits" target="Caregivers">
      <data key="d4">8.0</data>
      <data key="d5">Caregivers are encouraged to attend doctor visits to ask questions and take notes for the patient.</data>
      <data key="d6">patient support, shared decision-making</data>
      <data key="d7">chunk-7606b44d6a30ad0519bc4c10785de79a</data>
    </edge>
    <edge source="Doctor Visits" target="Doctor">
      <data key="d4">9.0</data>
      <data key="d5">The doctor conducts doctor visits to evaluate the patient, take medical histories, and explain test results.</data>
      <data key="d6">medical consultation, patient evaluation</data>
      <data key="d7">chunk-c77e0d4642a374a51f87e7e25b19281f</data>
    </edge>
    <edge source="Doctor Visits" target="Support Person">
      <data key="d4">8.0</data>
      <data key="d5">Patients are encouraged to bring a support person to doctor visits to take notes and provide assistance.</data>
      <data key="d6">appointment accompaniment, patient support</data>
      <data key="d7">chunk-c77e0d4642a374a51f87e7e25b19281f</data>
    </edge>
    <edge source="Telehealth Visits" target="Care Team">
      <data key="d4">7.0</data>
      <data key="d5">The care team communicates with and provides remote consultations to patients through telehealth visits.</data>
      <data key="d6">remote consultation, telemedicine</data>
      <data key="d7">chunk-7606b44d6a30ad0519bc4c10785de79a</data>
    </edge>
    <edge source="Telehealth Visits" target="Caregivers">
      <data key="d4">7.0</data>
      <data key="d5">Caregivers can join telehealth visits to participate in patient discussions and care coordination.</data>
      <data key="d6">telehealth participation, emotional support</data>
      <data key="d7">chunk-7606b44d6a30ad0519bc4c10785de79a</data>
    </edge>
    <edge source="Bone Marrow Tests" target="CML">
      <data key="d4">8.0</data>
      <data key="d5">Bone marrow tests evaluate cellularity, blast phases, and genetic changes essential for CML diagnosis and staging.</data>
      <data key="d6">diagnostic assessment, bone marrow staging</data>
      <data key="d7">chunk-7606b44d6a30ad0519bc4c10785de79a</data>
    </edge>
    <edge source="Bone Marrow Tests" target="Acute Lymphoblastic Leukemia">
      <data key="d4">7.0</data>
      <data key="d5">Bone marrow tests detect lymphoblasts crowding out normal blood-forming cells in ALL.</data>
      <data key="d6">diagnostic pathology, marrow evaluation</data>
      <data key="d7">chunk-7606b44d6a30ad0519bc4c10785de79a</data>
    </edge>
    <edge source="Adenocarcinoma" target="Rectal Cancer">
      <data key="d4">9.0</data>
      <data key="d5">Adenocarcinoma represents the most frequent histological form of rectal cancer.</data>
      <data key="d6">histology, tumor type</data>
      <data key="d7">chunk-c5bc83f5f4f3e29b7f0a6f4787c3ad83</data>
    </edge>
    <edge source="Adenocarcinoma" target="Cervical Cancer">
      <data key="d4">27.0</data>
      <data key="d5">Adenocarcinoma is a major histological type of cervical cancer.&lt;SEP&gt;Adenocarcinoma is identified as a primary subtype of cervical cancer.&lt;SEP&gt;Adenocarcinoma represents about 2 out of 10 cervical cancers and develops in the endocervical canal.</data>
      <data key="d6">cancer classification, oncology&lt;SEP&gt;disease classification, cancer subtypes&lt;SEP&gt;disease classification, histological subtype</data>
      <data key="d7">chunk-b4d036ee5fd77783b9e7ddef3a8477ae&lt;SEP&gt;chunk-8ec4d44b145ca896ff1216caa90ce5dd&lt;SEP&gt;chunk-95c76786e9d6dbf06ddf5d55af0cf658</data>
    </edge>
    <edge source="Adenocarcinoma" target="Early-Stage Cervical Cancer">
      <data key="d4">7.0</data>
      <data key="d5">Low-grade adenocarcinoma is a criterion considered when deciding on extrafascial hysterectomy for early-stage cervical cancer.</data>
      <data key="d6">histological classification, treatment criteria</data>
      <data key="d7">chunk-e247ae57c50c62bded7114986471226e</data>
    </edge>
    <edge source="Adenocarcinoma" target="Intestinal Type">
      <data key="d4">9.0</data>
      <data key="d5">Intestinal type is identified as one of the two primary categories of stomach adenocarcinoma.</data>
      <data key="d6">cancer classification, histology</data>
      <data key="d7">chunk-01c80b2d18abb91c5be598d33cf7a33a</data>
    </edge>
    <edge source="Adenocarcinoma" target="Diffuse Type">
      <data key="d4">9.0</data>
      <data key="d5">Diffuse type is identified as one of the two primary categories of stomach adenocarcinoma.</data>
      <data key="d6">cancer classification, histology</data>
      <data key="d7">chunk-01c80b2d18abb91c5be598d33cf7a33a</data>
    </edge>
    <edge source="Adenocarcinoma" target="Stomach Cancer">
      <data key="d4">10.0</data>
      <data key="d5">Adenocarcinoma constitutes the vast majority of stomach cancer cases.</data>
      <data key="d6">disease classification, oncology</data>
      <data key="d7">chunk-01c80b2d18abb91c5be598d33cf7a33a</data>
    </edge>
    <edge source="Adenocarcinoma" target="Early-Stage Stomach Cancer">
      <data key="d4">8.0</data>
      <data key="d5">Adenocarcinoma begins in the mucosa and may initially present as early-stage stomach cancer confined to the innermost gastric layer.</data>
      <data key="d6">disease classification, cancer staging</data>
      <data key="d7">chunk-c77e0d4642a374a51f87e7e25b19281f</data>
    </edge>
    <edge source="Adenocarcinoma" target="Locoregional Stomach Cancer">
      <data key="d4">8.0</data>
      <data key="d5">Adenocarcinoma can progress by invading deeper stomach wall layers and regional lymph nodes as locoregional disease.</data>
      <data key="d6">disease progression, cancer staging</data>
      <data key="d7">chunk-c77e0d4642a374a51f87e7e25b19281f</data>
    </edge>
    <edge source="Adenocarcinoma" target="Metastatic Stomach Cancer">
      <data key="d4">8.0</data>
      <data key="d5">Adenocarcinoma can spread via blood or the lymphatic system to distant organs, progressing into metastatic stomach cancer.</data>
      <data key="d6">metastasis, disease progression</data>
      <data key="d7">chunk-c77e0d4642a374a51f87e7e25b19281f</data>
    </edge>
    <edge source="Adenocarcinoma" target="Bladder Cancer">
      <data key="d4">16.0</data>
      <data key="d5">Adenocarcinoma is an uncommon subtype of non-urothelial bladder cancer.&lt;SEP&gt;Adenocarcinoma is identified as a rare non-urothelial subtype of bladder cancer.</data>
      <data key="d6">cancer classification, disease subtype&lt;SEP&gt;cancer classification, subtype</data>
      <data key="d7">chunk-8aa2c7020ce6e89888e81972588726e3&lt;SEP&gt;chunk-f9a9eb8b01f29fdf214c10bdffac3203</data>
    </edge>
    <edge source="Early and Locally Advanced NSCLC" target="NCCN">
      <data key="d4">9.0</data>
      <data key="d5">NCCN publishes patient guidelines and resources focused on early and locally advanced non-small cell lung cancer.</data>
      <data key="d6">medical guidelines, patient education</data>
      <data key="d7">chunk-bd06bc83e13e7562ce65d6eee1b6024f</data>
    </edge>
    <edge source="Early and Locally Advanced NSCLC" target="Metastatic Cancer">
      <data key="d4">7.0</data>
      <data key="d5">Early and locally advanced cancers can spread beyond local tissue and lymph nodes to become metastatic cancer.</data>
      <data key="d6">disease progression, metastasis</data>
      <data key="d7">chunk-bd06bc83e13e7562ce65d6eee1b6024f</data>
    </edge>
    <edge source="Early and Locally Advanced NSCLC" target="Stage 1 Lung Cancer">
      <data key="d4">9.0</data>
      <data key="d5">Stage 1 lung cancer defines the early classification of non-small cell lung cancer.</data>
      <data key="d6">cancer staging, disease classification</data>
      <data key="d7">chunk-bd06bc83e13e7562ce65d6eee1b6024f</data>
    </edge>
    <edge source="Early and Locally Advanced NSCLC" target="Stage 2 and 3 Lung Cancer">
      <data key="d4">9.0</data>
      <data key="d5">Stage 2 and stage 3 represent the locally advanced stages of non-small cell lung cancer.</data>
      <data key="d6">cancer staging, disease classification</data>
      <data key="d7">chunk-bd06bc83e13e7562ce65d6eee1b6024f</data>
    </edge>
    <edge source="Early and Locally Advanced NSCLC" target="Surgery">
      <data key="d4">9.0</data>
      <data key="d5">Surgery is used as a primary treatment to remove cancerous tissue in early and locally advanced NSCLC.</data>
      <data key="d6">surgical treatment, clinical intervention</data>
      <data key="d7">chunk-bd06bc83e13e7562ce65d6eee1b6024f</data>
    </edge>
    <edge source="Early and Locally Advanced NSCLC" target="Radiation Therapy">
      <data key="d4">8.0</data>
      <data key="d5">Radiation therapy is an alternative treatment option for patients with early NSCLC who cannot undergo surgery.</data>
      <data key="d6">therapeutic alternative, radiation oncology</data>
      <data key="d7">chunk-bd06bc83e13e7562ce65d6eee1b6024f</data>
    </edge>
    <edge source="Early and Locally Advanced NSCLC" target="Chemoradiation">
      <data key="d4">8.0</data>
      <data key="d5">Chemoradiation is utilized as a treatment modality for particular presentations of locally advanced NSCLC.</data>
      <data key="d6">combined therapy, oncology treatment</data>
      <data key="d7">chunk-bd06bc83e13e7562ce65d6eee1b6024f</data>
    </edge>
    <edge source="Metastatic Cancer" target="Stage 4 Lung Cancer">
      <data key="d4">9.0</data>
      <data key="d5">Stage 4 lung cancer corresponds to metastatic cancer present at the time of initial diagnosis.</data>
      <data key="d6">cancer staging, metastatic disease</data>
      <data key="d7">chunk-bd06bc83e13e7562ce65d6eee1b6024f</data>
    </edge>
    <edge source="Metastatic Cancer" target="TNM Staging System">
      <data key="d4">8.0</data>
      <data key="d5">TNM staging categorizes stage 4 disease, which frequently encompasses metastatic cancer with distant spread.</data>
      <data key="d6">disease classification, metastasis</data>
      <data key="d7">chunk-d9882c04dd7676c6433074e5e393c72e</data>
    </edge>
    <edge source="Metastatic Cancer" target="Targeted Therapy">
      <data key="d4">17.0</data>
      <data key="d5">Targeted therapy is typically indicated for recurrent or metastatic cervical cancer.&lt;SEP&gt;Targeted therapy is utilized for metastatic thyroid cancers that do not take up iodine and show disease progression.</data>
      <data key="d6">metastatic treatment, biomarker guidance&lt;SEP&gt;pharmacotherapy, systemic therapy</data>
      <data key="d7">chunk-8ec4d44b145ca896ff1216caa90ce5dd&lt;SEP&gt;chunk-9d383e4798456aa46e381fd2b02f6f96</data>
    </edge>
    <edge source="Metastatic Cancer" target="Immunotherapy">
      <data key="d4">9.0</data>
      <data key="d5">Immunotherapy is commonly used to treat metastatic cervical cancer.</data>
      <data key="d6">metastatic treatment, biomarker guidance</data>
      <data key="d7">chunk-8ec4d44b145ca896ff1216caa90ce5dd</data>
    </edge>
    <edge source="Metastatic Cancer" target="Cervical Cancer">
      <data key="d4">8.0</data>
      <data key="d5">Metastatic cancer designates an advanced spreading stage of cervical cancer.</data>
      <data key="d6">disease staging, metastasis</data>
      <data key="d7">chunk-8ec4d44b145ca896ff1216caa90ce5dd</data>
    </edge>
    <edge source="Metastatic Cancer" target="Thyroid Cancer">
      <data key="d4">9.0</data>
      <data key="d5">Thyroid cancer can progress to metastatic cancer when malignant cells spread outside the neck to distant sites.</data>
      <data key="d6">disease progression, metastasis</data>
      <data key="d7">chunk-9d383e4798456aa46e381fd2b02f6f96</data>
    </edge>
    <edge source="Metastatic Cancer" target="RAI Therapy">
      <data key="d4">8.0</data>
      <data key="d5">RAI therapy is recommended for metastatic thyroid cancer cases that demonstrate iodine uptake.</data>
      <data key="d6">systemic treatment, cancer therapy</data>
      <data key="d7">chunk-9d383e4798456aa46e381fd2b02f6f96</data>
    </edge>
    <edge source="Metastatic Cancer" target="Papillary Thyroid Cancer">
      <data key="d4">8.0</data>
      <data key="d5">Metastatic papillary thyroid cancer is treated with RAI therapy if the tumors take up iodine.</data>
      <data key="d6">metastatic disease, cancer subtype</data>
      <data key="d7">chunk-9d383e4798456aa46e381fd2b02f6f96</data>
    </edge>
    <edge source="Metastatic Cancer" target="Follicular Thyroid Cancer">
      <data key="d4">8.0</data>
      <data key="d5">Metastatic follicular thyroid cancer is managed with RAI therapy when iodine avidity is present.</data>
      <data key="d6">metastatic disease, cancer subtype</data>
      <data key="d7">chunk-9d383e4798456aa46e381fd2b02f6f96</data>
    </edge>
    <edge source="Metastatic Cancer" target="Oncocytic Thyroid Cancer">
      <data key="d4">8.0</data>
      <data key="d5">Metastatic oncocytic thyroid cancer is eligible for RAI therapy if the lesions absorb radioactive iodine.</data>
      <data key="d6">metastatic disease, cancer subtype</data>
      <data key="d7">chunk-9d383e4798456aa46e381fd2b02f6f96</data>
    </edge>
    <edge source="Metastatic Cancer" target="Levothyroxine">
      <data key="d4">8.0</data>
      <data key="d5">Patients with metastatic thyroid cancer continue taking levothyroxine to suppress TSH and reduce tumor growth stimulation.</data>
      <data key="d6">hormone suppression, cancer management</data>
      <data key="d7">chunk-9d383e4798456aa46e381fd2b02f6f96</data>
    </edge>
    <edge source="Lung Nodules" target="Solid Nodules">
      <data key="d4">8.0</data>

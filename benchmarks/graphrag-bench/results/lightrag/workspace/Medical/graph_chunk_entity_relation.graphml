      <data key="d7">chunk-76a038845aaedb9ef7852018f26778b3</data>
    </edge>
    <edge source="Cystoscopy" target="White Light Cystoscopy">
      <data key="d4">9.0</data>
      <data key="d5">White light cystoscopy represents the conventional standard method used during cystoscopic examinations.</data>
      <data key="d6">standard technique, procedure baseline</data>
      <data key="d7">chunk-76a038845aaedb9ef7852018f26778b3</data>
    </edge>
    <edge source="Cystoscopy" target="Post-Cystoscopy Side Effects">
      <data key="d4">8.0</data>
      <data key="d5">Patients undergoing cystoscopy commonly experience temporary side effects including bleeding and burning upon urination.</data>
      <data key="d6">procedural aftermath, symptom development</data>

    <edge source="Reproductive Endocrinologist" target="Surrogate">
      <data key="d4">7.0</data>
      <data key="d5">Reproductive endocrinologists discuss gestational surrogacy as an alternative pregnancy option for patients with frozen embryos or eggs.</data>
      <data key="d6">assisted reproduction, family planning</data>
      <data key="d7">chunk-be6e1cb2fe11f4d9962741c30d446a69</data>
    </edge>

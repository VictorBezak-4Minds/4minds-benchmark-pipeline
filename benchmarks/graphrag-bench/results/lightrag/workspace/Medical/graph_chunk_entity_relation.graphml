    <edge source="Dad" target="Team of Experts">
      <data key="d4">9.0</data>
      <data key="d5">The team of experts treated Dad and helped him overcome a six-month prognosis to become clinically cured.</data>
      <data key="d6">medical treatment, patient recovery</data>

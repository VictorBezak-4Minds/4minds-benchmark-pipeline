    </edge>
    <edge source="Methotrexate" target="Induction Phase">
      <data key="d4">9.0</data>
      <data key="d5">High-dose methotrexate is the recommended standard drug protocol during the induction phase of primary CNS lymphoma.</data>
      <data key="d6">therapeutic protocol, induction drug</data>
      <data key="d7">chunk-bb68daec67dd8f436d82814b0e61ff21</data>
    </edge>

      <data key="d6">patient management, cancer treatment</data>
      <data key="d7">chunk-38185832d6395b9952def9a72ecc339d</data>
    </edge>
    <edge source="Oropharyngeal Cancer" target="Biopsy">
      <data key="d4">9.0</data>

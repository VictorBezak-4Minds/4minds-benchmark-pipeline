      <data key="d5">Genetic risk testing identifies predispositions to breast cancer that inform screening protocols.</data>
      <data key="d6">risk assessment, personalized prevention</data>
      <data key="d7">chunk-1dc8d8e5ed4f165f3e56305a7644ba05</data>
    </edge>
    <edge source="Hormone Receptor Status Testing" target="Biomarker Testing">
      <data key="d4">9.0</data>

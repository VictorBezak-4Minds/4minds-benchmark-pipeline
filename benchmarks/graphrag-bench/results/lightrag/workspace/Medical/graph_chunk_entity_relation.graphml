    </edge>
    <edge source="Chronic Myeloid Leukemia" target="Blood Cells">
      <data key="d4">9.0</data>
      <data key="d5">Chronic myeloid leukemia disrupts normal blood cell production, causing an overproduction of white blood cells such as granulocytes.</data>
      <data key="d6">disease manifestation, hematologic pathology</data>

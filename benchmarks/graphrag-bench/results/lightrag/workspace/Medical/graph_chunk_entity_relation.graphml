      <data key="d4">9.0</data>
      <data key="d5">Low-grade endometrioid carcinoma is considered a less common epithelial ovarian histology.</data>
      <data key="d6">disease classification, subtype</data>
      <data key="d7">chunk-b4da30dee72e228147daa825e4f5be72</data>
    </edge>

      <data key="d6">diagnostic pathway, clinical evaluation</data>
      <data key="d7">chunk-6232dd9ed168a1113955e7300645338b</data>
    </edge>
    <edge source="Imaging" target="Glioma">
      <data key="d4">8.0</data>

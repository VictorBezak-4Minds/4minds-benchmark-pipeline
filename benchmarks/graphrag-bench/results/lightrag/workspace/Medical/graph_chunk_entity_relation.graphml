      <data key="d6">laboratory assessment, disease tracking</data>
      <data key="d7">chunk-29c9b8b5fd2cd967c48522af79a9598f</data>
    </edge>
    <edge source="Acute Myeloid Leukemia" target="Multidisciplinary Team">
      <data key="d4">9.0</data>
      <data key="d5">A multidisciplinary team collaborates to coordinate, plan, and administer treatment strategies tailored to a patient's AML subtype.</data>
      <data key="d6">medical treatment, patient care</data>
      <data key="d7">chunk-8333423c91919d7adde114b8286cca7e</data>
    </edge>
    <edge source="Acute Myeloid Leukemia" target="Hypomethylating Agents">
      <data key="d4">8.0</data>
      <data key="d5">Hypomethylating agents are used in AML treatment to unblock silenced genes and allow leukemic blasts to mature.</data>
      <data key="d6">therapeutic mechanism, cancer treatment</data>
      <data key="d7">chunk-8333423c91919d7adde114b8286cca7e</data>
    </edge>

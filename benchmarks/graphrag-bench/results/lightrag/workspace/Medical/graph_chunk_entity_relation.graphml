      <data key="d7">chunk-1e017cd4fd8af1ebbcb582a93fbfe1ea</data>
    </edge>
    <edge source="Treatment Team" target="Endocrinologist">
      <data key="d4">9.0</data>
      <data key="d5">The endocrinologist is a core expert physician on the thyroid cancer care team.</data>
      <data key="d6">team composition, medical specialization</data>
      <data key="d7">chunk-1e017cd4fd8af1ebbcb582a93fbfe1ea</data>
    </edge>
    <edge source="Treatment Team" target="Nuclear Medicine Specialist">
      <data key="d4">9.0</data>
      <data key="d5">The nuclear medicine specialist is a member of the care team responsible for radioiodine therapies and scans.</data>
      <data key="d6">team composition, nuclear medicine</data>
      <data key="d7">chunk-1e017cd4fd8af1ebbcb582a93fbfe1ea</data>
    </edge>
    <edge source="Treatment Team" target="Neuropathologist">
      <data key="d4">8.0</data>
      <data key="d5">The treatment team relies on diagnostic findings from the neuropathologist to design therapeutic plans.</data>
      <data key="d6">multidisciplinary care, diagnosis guidance</data>
      <data key="d7">chunk-ffc3446f8ec092af24a460bda94f772f</data>
    </edge>
    <edge source="Treatment Team" target="Neurosurgeon">
      <data key="d4">8.0</data>
      <data key="d5">The neurosurgeon is an integral part of the patient's treatment team performing tumor sampling and surgery.</data>
      <data key="d6">clinical collaboration, patient care</data>
      <data key="d7">chunk-ffc3446f8ec092af24a460bda94f772f</data>
    </edge>
    <edge source="Treatment Team" target="Urologist">
      <data key="d4">8.0</data>
      <data key="d5">The urologist collaborates directly with the patient's treatment team to manage bladder cancer treatment plans.</data>
      <data key="d6">clinical collaboration, multidisciplinary care</data>
      <data key="d7">chunk-13e723cb8b0af4bcf2f1b0fd37912cb2</data>
    </edge>
    <edge source="Treatment Team" target="Bladder Cancer">
      <data key="d4">8.0</data>
      <data key="d5">The treatment team manages therapeutic decisions, surgical procedures, and symptom alleviation for patients with bladder cancer.</data>
      <data key="d6">patient care, clinical management</data>
      <data key="d7">chunk-f2a44e885faf856aa579d824b3cd85e7</data>
    </edge>
    <edge source="Gynecologic Oncologist" target="Laparotomy">
      <data key="d4">7.0</data>
      <data key="d5">Gynecologic oncologists perform laparotomy incisions to evaluate and treat extensive ovarian tumors and perform debulking.</data>
      <data key="d6">surgical technique, professional practice</data>
      <data key="d7">chunk-77ac570b4029abb181150e0d0975aefb</data>
    </edge>
    <edge source="Gynecologic Oncologist" target="Laparoscopy">
      <data key="d4">7.0</data>
      <data key="d5">Gynecologic oncologists experienced in minimally invasive surgery may perform laparoscopy in select ovarian cancer cases.</data>
      <data key="d6">specialized surgical technique, clinical expertise</data>
      <data key="d7">chunk-77ac570b4029abb181150e0d0975aefb</data>
    </edge>
    <edge source="Gynecologic Oncologist" target="Cancer Care Plan">
      <data key="d4">9.0</data>
      <data key="d5">The gynecologic oncologist is a core specialist on the cancer treatment team contributing to the treatment plan.</data>
      <data key="d6">care team, treatment planning</data>
      <data key="d7">chunk-db3a86fc5d439d9bfb3845e468a2a551</data>
    </edge>
    <edge source="Gynecologic Oncologist" target="Chemotherapy">
      <data key="d4">8.0</data>
      <data key="d5">Gynecologic oncologists are trained experts in administering chemotherapy for reproductive cancers.</data>
      <data key="d6">oncology specialization, treatment administration</data>
      <data key="d7">chunk-db3a86fc5d439d9bfb3845e468a2a551</data>
    </edge>

    </edge>
    <edge source="Immune Checkpoint Inhibitors" target="PD-1">
      <data key="d4">9.0</data>
      <data key="d5">Immune checkpoint inhibitors target PD-1 proteins to restore the body's anti-tumor immune response.</data>
      <data key="d6">therapeutic target, drug mechanism</data>
      <data key="d7">chunk-650982a589c2d527bc13923ccd0569ef</data>
    </edge>
    <edge source="Immune Checkpoint Inhibitors" target="PD-L1">
      <data key="d4">9.0</data>
      <data key="d5">Immune checkpoint inhibitors target PD-L1 expressed on cancer cells to activate immune defense.</data>
      <data key="d6">therapeutic target, drug mechanism</data>
      <data key="d7">chunk-650982a589c2d527bc13923ccd0569ef</data>
    </edge>
    <edge source="Immune Checkpoint Inhibitors" target="Chemotherapy">
      <data key="d4">8.0</data>
      <data key="d5">Chemotherapy is combined with checkpoint inhibitor therapy to treat cancers expressing PD-1 or PD-L1.</data>
      <data key="d6">combination therapy, treatment protocol</data>
      <data key="d7">chunk-650982a589c2d527bc13923ccd0569ef</data>
    </edge>

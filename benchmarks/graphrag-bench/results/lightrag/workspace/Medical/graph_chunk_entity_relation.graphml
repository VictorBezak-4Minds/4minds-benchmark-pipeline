      <data key="d7">chunk-1dc8d8e5ed4f165f3e56305a7644ba05</data>
    </edge>
    <edge source="2D Digital Mammogram" target="Mammogram">
      <data key="d4">9.0</data>
      <data key="d5">The 2D digital mammogram is one of the primary forms of mammography used to examine breasts.</data>
      <data key="d6">imaging modality, diagnostic method</data>
      <data key="d7">chunk-1dc8d8e5ed4f165f3e56305a7644ba05</data>
    </edge>
    <edge source="Estrogen Receptor Status" target="Prognostic Stage">
      <data key="d4">8.0</data>
      <data key="d5">Estrogen receptor status is evaluated as a crucial biomarker component within prognostic breast cancer staging.</data>
      <data key="d6">biomarker assessment, clinical prognosis</data>
      <data key="d7">chunk-0d388da75afb5ea2d01c97e55cb2b872</data>
    </edge>
    <edge source="Breast Specialist" target="Inflammatory Breast Cancer">
      <data key="d4">7.0</data>
      <data key="d5">Patients suspected of having inflammatory breast cancer are advised to seek referral to a breast specialist.</data>
      <data key="d6">medical consultation, referral</data>
      <data key="d7">chunk-7f9fe20fe42489996573eb1b436128b6</data>
    </edge>
    <edge source="Breast Specialist" target="Care Team">
      <data key="d4">7.0</data>
      <data key="d5">A breast specialist is a key medical provider who may participate in or be consulted by the patient's care team.</data>
      <data key="d6">clinical coordination, healthcare roles</data>
      <data key="d7">chunk-7f9fe20fe42489996573eb1b436128b6</data>
    </edge>
    <edge source="Breast Diagnostic Radiologist" target="Mammogram">
      <data key="d4">17.0</data>
      <data key="d5">A breast diagnostic radiologist interprets the results of mammograms and performs follow-up needle biopsies.&lt;SEP&gt;Breast diagnostic radiologists analyze and interpret the results of mammogram imaging studies.</data>
      <data key="d6">diagnostic imaging, radiological interpretation&lt;SEP&gt;medical evaluation, imaging analysis</data>
      <data key="d7">chunk-6a93aa507dd7d98a02e8ba92d39e3649&lt;SEP&gt;chunk-1dc8d8e5ed4f165f3e56305a7644ba05</data>
    </edge>
    <edge source="Breast Diagnostic Radiologist" target="Biopsy">
      <data key="d4">18.0</data>
      <data key="d5">A breast diagnostic radiologist performs needle biopsies based on imaging evaluations.&lt;SEP&gt;Breast diagnostic radiologists perform needle biopsies under imaging guidance.</data>
      <data key="d6">biopsy procedure, clinical intervention&lt;SEP&gt;diagnostic procedure, medical specialty</data>

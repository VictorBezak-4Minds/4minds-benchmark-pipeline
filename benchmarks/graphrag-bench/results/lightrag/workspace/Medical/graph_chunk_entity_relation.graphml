      <data key="d7">chunk-7f9fe20fe42489996573eb1b436128b6</data>
    </edge>
    <edge source="Mammogram" target="Stereotactic Needle Biopsy">
      <data key="d4">9.0</data>
      <data key="d5">Stereotactic needle biopsy is specifically defined by the use of mammography during the biopsy procedure.</data>

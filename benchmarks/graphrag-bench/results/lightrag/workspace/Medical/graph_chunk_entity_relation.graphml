    </edge>
    <edge source="Blast Phase CML" target="Myeloid Progenitor Cells">
      <data key="d4">8.0</data>
      <data key="d5">Advanced blast phase CML leads to an elevated proliferation of myeloid or lymphoid progenitor cells.</data>

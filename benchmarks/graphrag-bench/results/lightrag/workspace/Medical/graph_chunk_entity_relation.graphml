    </edge>
    <edge source="General Health Tests" target="Physical Exam">
      <data key="d4">16.0</data>
      <data key="d5">A physical exam is detailed as one of the general health tests administered to patients.&lt;SEP&gt;A physical examination is one of the core components under general health tests.</data>
      <data key="d6">clinical evaluation, diagnostic assessment&lt;SEP&gt;health assessment, clinical procedure</data>
      <data key="d7">chunk-aa14ecd19e2d721cb99ea9590f0ede3a&lt;SEP&gt;chunk-69e63736c94b8b08a565c3d8679d3b57</data>
    </edge>

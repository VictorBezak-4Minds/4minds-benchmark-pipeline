    </edge>
    <edge source="Mammogram" target="Imaging Technologists">
      <data key="d4">9.0</data>
      <data key="d5">Imaging technologists directly operate the mammography units used during patient screenings.</data>
      <data key="d6">technical operation, imaging screening</data>
      <data key="d7">chunk-6a93aa507dd7d98a02e8ba92d39e3649</data>
    </edge>

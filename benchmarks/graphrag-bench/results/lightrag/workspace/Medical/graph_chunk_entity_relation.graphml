      <data key="d6">clinical evaluation, differential diagnosis</data>
      <data key="d7">chunk-1c7418fb993bb3daa95d8563909da1de</data>
    </edge>
    <edge source="Multidisciplinary Care Team" target="Consult Meeting">
      <data key="d4">8.0</data>

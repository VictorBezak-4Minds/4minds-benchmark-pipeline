      <data key="d6">cell therapy, curative treatment</data>
      <data key="d7">chunk-29c9b8b5fd2cd967c48522af79a9598f</data>
    </edge>
    <edge source="Acute Myeloid Leukemia" target="Genetic and Biomarker Tests">
      <data key="d4">9.0</data>
      <data key="d5">Genetic and biomarker testing identifies chromosomal abnormalities and specific mutations to determine the AML subtype, prognosis, and tailored treatments.</data>
      <data key="d6">disease classification, prognostic evaluation</data>
      <data key="d7">chunk-29c9b8b5fd2cd967c48522af79a9598f</data>
    </edge>
    <edge source="Acute Myeloid Leukemia" target="Blood Tests">
      <data key="d4">8.0</data>

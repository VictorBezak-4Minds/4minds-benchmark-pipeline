      <data key="d7">chunk-ecc6c4bcd3cab65fa05ab5f3c55e528d</data>
    </edge>
    <edge source="Thoracic Surgeon" target="Assessment Team">
      <data key="d4">8.0</data>
      <data key="d5">A thoracic surgeon evaluates patients and may perform biopsies or surgical interventions as part of the assessment team.</data>
      <data key="d6">surgical evaluation, multidisciplinary care</data>

    </edge>
    <edge source="Treatment Team" target="Gynecologic Oncologist">
      <data key="d4">8.0</data>
      <data key="d5">Gynecologic oncologists are core specialists on the treatment team responsible for conducting initial surgical procedures.</data>
      <data key="d6">medical team, surgical leadership</data>
      <data key="d7">chunk-b4da30dee72e228147daa825e4f5be72</data>
    </edge>
    <edge source="Treatment Team" target="Clinical Trials">
      <data key="d4">7.0</data>
      <data key="d5">The cancer treatment team discusses and integrates clinical trial options into the patient's treatment plan.</data>
      <data key="d6">clinical research, treatment planning</data>
      <data key="d7">chunk-b4da30dee72e228147daa825e4f5be72</data>
    </edge>
    <edge source="Treatment Team" target="Genetic Counselors">
      <data key="d4">7.0</data>
      <data key="d5">Genetic counselors are specialized team members available to provide genetic evaluation within the cancer care team.</data>
      <data key="d6">multidisciplinary care, genetics</data>
      <data key="d7">chunk-b4da30dee72e228147daa825e4f5be72</data>
    </edge>
    <edge source="Treatment Team" target="Social Workers">
      <data key="d4">7.0</data>
      <data key="d5">Social workers participate in the multidisciplinary care team to support the patient during cancer treatment.</data>
      <data key="d6">patient support, multidisciplinary team</data>
      <data key="d7">chunk-b4da30dee72e228147daa825e4f5be72</data>
    </edge>
    <edge source="Treatment Team" target="Biomarker Testing">
      <data key="d4">16.0</data>
      <data key="d5">Biomarker testing provides molecular diagnostic data that guides the treatment team's management decisions.&lt;SEP&gt;The treatment team recommends and orders specific biomarker tests to design an individualized treatment approach for the patient.</data>
      <data key="d6">clinical decision-making, personalized medicine&lt;SEP&gt;diagnostic evaluation, personalized medicine</data>
      <data key="d7">chunk-562e1870b5e20f8648a2e56d960a1148&lt;SEP&gt;chunk-b4da30dee72e228147daa825e4f5be72</data>
    </edge>
    <edge source="Treatment Team" target="Ovarian Cancer Surgery">
      <data key="d4">8.0</data>
      <data key="d5">The treatment team issues preoperative instructions and oversees patient care before and during surgery.</data>
      <data key="d6">patient care, clinical management</data>
      <data key="d7">chunk-cf2d987135a5936876bc819136e3a5b5</data>
    </edge>
    <edge source="Treatment Team" target="Primary CNS Lymphoma">
      <data key="d4">8.0</data>
      <data key="d5">The treatment team monitors, treats, and oversees patients undergoing therapy for primary CNS lymphoma.</data>
      <data key="d6">clinical care, patient monitoring</data>
      <data key="d7">chunk-8fbedfa2d88a7b3852f4c2bd0bb64af0</data>
    </edge>
    <edge source="Treatment Team" target="Radiation Therapy">
      <data key="d4">15.0</data>
      <data key="d5">Patients consult their treatment team to evaluate the cognitive risks and therapeutic benefits of radiation therapy.&lt;SEP&gt;The treatment team evaluates and discusses the benefits versus long-term risks of radiation therapy, including nervous system damage, with patients.</data>
      <data key="d6">patient consultation, clinical assessment&lt;SEP&gt;risk evaluation, patient consultation</data>
      <data key="d7">chunk-8fbedfa2d88a7b3852f4c2bd0bb64af0&lt;SEP&gt;chunk-a65ba958750476cc543741efe815c7c4</data>
    </edge>
    <edge source="Treatment Team" target="Stem Cell Rescue">
      <data key="d4">8.0</data>
      <data key="d5">The treatment team evaluates multiple patient health and disease factors to decide whether a stem cell rescue is appropriate.</data>
      <data key="d6">clinical evaluation, treatment planning</data>
      <data key="d7">chunk-a65ba958750476cc543741efe815c7c4</data>
    </edge>
    <edge source="Treatment Team" target="Doctor">
      <data key="d4">8.0</data>
      <data key="d5">Doctors work as part of the overall treatment team evaluating patient care options and side effects.</data>
      <data key="d6">medical collaboration, healthcare delivery</data>
      <data key="d7">chunk-8ec4d44b145ca896ff1216caa90ce5dd</data>
    </edge>
    <edge source="Treatment Team" target="Differentiated Thyroid Cancer">
      <data key="d4">7.0</data>
      <data key="d5">The multidisciplinary treatment team creates comprehensive management plans for patients diagnosed with differentiated thyroid cancer.</data>

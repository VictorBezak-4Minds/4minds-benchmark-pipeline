      <data key="d6">treatment indication, blood transfusion</data>
      <data key="d7">chunk-9fa573748870dc50a98a935843997c68</data>
    </edge>
    <edge source="AML Genetic Changes" target="Molecular Testing">
      <data key="d4">9.0</data>
      <data key="d5">Molecular and genomic testing identifies specific chromosomal and genetic mutations unique to AML cells.</data>
      <data key="d6">mutation detection, genomic analysis</data>
      <data key="d7">chunk-0786666c65b5bf00705439d5cb60d5a0</data>
    </edge>
    <edge source="AML Genetic Changes" target="FLT">
      <data key="d4">7.0</data>

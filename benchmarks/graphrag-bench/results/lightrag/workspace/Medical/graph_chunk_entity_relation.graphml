      <data key="d4">16.0</data>
      <data key="d5">A catheter is an intravenous delivery mechanism used to administer systemic therapy directly into the bloodstream.&lt;SEP&gt;Catheters are vascular access devices placed in patients to deliver systemic therapy and fluids.</data>
      <data key="d6">medical delivery, drug administration&lt;SEP&gt;treatment delivery, medical equipment</data>
      <data key="d7">chunk-8333423c91919d7adde114b8286cca7e&lt;SEP&gt;chunk-97836a515d346931beb424ae40a89877</data>
    </edge>
    <edge source="Port" target="Systemic Therapy">
      <data key="d4">16.0</data>
      <data key="d5">A port is surgically implanted in the chest to facilitate long-term delivery of systemic therapies and medications.&lt;SEP&gt;Ports are implanted devices in the chest used to administer systemic therapy treatments.</data>
      <data key="d6">drug administration, therapeutic access&lt;SEP&gt;medical delivery, drug administration</data>
      <data key="d7">chunk-8333423c91919d7adde114b8286cca7e&lt;SEP&gt;chunk-97836a515d346931beb424ae40a89877</data>
    </edge>
    <edge source="Port" target="5-FU">
      <data key="d4">9.0</data>
      <data key="d5">5-FU is continuously infused through a central venous catheter port placed in the upper chest.</data>
      <data key="d6">drug administration, medical device</data>
      <data key="d7">chunk-0fdcce851d69aa713ed64ba1895bd5d1</data>
    </edge>
    <edge source="Antimetabolites" target="Chemotherapy">
      <data key="d4">26.0</data>
      <data key="d5">Antimetabolites are a specific class of chemotherapy drugs used to treat AML.&lt;SEP&gt;Antimetabolites represent a category of chemotherapy drugs.&lt;SEP&gt;Antimetabolites represent a specific subcategory of chemotherapy drugs utilized in AML treatment regimens.</data>
      <data key="d6">drug classification, chemotherapy regimen&lt;SEP&gt;drug classification, pharmacology</data>
      <data key="d7">chunk-9040f5949ae0ff36ce88faa1f4b67ead&lt;SEP&gt;chunk-8333423c91919d7adde114b8286cca7e&lt;SEP&gt;chunk-53afdc6713818c4177b64a712ecce11b</data>
    </edge>
    <edge source="Antimetabolites" target="Anthracyclines">
      <data key="d4">7.0</data>
      <data key="d5">Antimetabolites and anthracyclines are combined in dual-drug formulations such as CPX-351 for multi-agent chemotherapy regimens.</data>
      <data key="d6">combination therapy, multi-agent regimen</data>
      <data key="d7">chunk-53afdc6713818c4177b64a712ecce11b</data>
    </edge>
    <edge source="Antimetabolites" target="Cladribine">
      <data key="d4">9.0</data>
      <data key="d5">Cladribine is a specific drug belonging to the antimetabolite category of chemotherapies.</data>
      <data key="d6">drug classification, antimetabolite</data>
      <data key="d7">chunk-8333423c91919d7adde114b8286cca7e</data>
    </edge>
    <edge source="Antimetabolites" target="Clofarabine">
      <data key="d4">9.0</data>
      <data key="d5">Clofarabine is categorized as an antimetabolite used in leukemia treatment.</data>
      <data key="d6">drug classification, antimetabolite</data>
      <data key="d7">chunk-8333423c91919d7adde114b8286cca7e</data>
    </edge>
    <edge source="Antimetabolites" target="Cytarabine">
      <data key="d4">9.0</data>
      <data key="d5">Cytarabine is an antimetabolite agent that blocks DNA synthesis in cancer cells.</data>
      <data key="d6">drug classification, antimetabolite</data>
      <data key="d7">chunk-8333423c91919d7adde114b8286cca7e</data>
    </edge>
    <edge source="Antimetabolites" target="Fludarabine">
      <data key="d4">9.0</data>
      <data key="d5">Fludarabine is an antimetabolite chemotherapy drug.</data>
      <data key="d6">drug classification, antimetabolite</data>
      <data key="d7">chunk-8333423c91919d7adde114b8286cca7e</data>
    </edge>
    <edge source="Antimetabolites" target="Methotrexate">
      <data key="d4">9.0</data>
      <data key="d5">Methotrexate is an antimetabolite that disrupts cancer cell DNA synthesis.</data>
      <data key="d6">drug classification, antimetabolite</data>
      <data key="d7">chunk-8333423c91919d7adde114b8286cca7e</data>
    </edge>
    <edge source="Antimetabolites" target="CPX-351">
      <data key="d4">8.0</data>
      <data key="d5">CPX-351 incorporates an antimetabolite within its formulation.</data>
      <data key="d6">drug formulation, drug class</data>
      <data key="d7">chunk-8333423c91919d7adde114b8286cca7e</data>
    </edge>
    <edge source="Anthracyclines" target="Chemotherapy">
      <data key="d4">26.0</data>
      <data key="d5">Anthracyclines are a specific category of chemotherapy drugs frequently used in AML treatment regimens.&lt;SEP&gt;Anthracyclines are a specific type of chemotherapy medication used to treat AML by disrupting DNA.&lt;SEP&gt;Anthracyclines represent a specific category of chemotherapy drugs.</data>
      <data key="d6">drug classification, cancer treatment&lt;SEP&gt;drug classification, chemotherapy regimen&lt;SEP&gt;drug classification, pharmacology</data>
      <data key="d7">chunk-9040f5949ae0ff36ce88faa1f4b67ead&lt;SEP&gt;chunk-8333423c91919d7adde114b8286cca7e&lt;SEP&gt;chunk-53afdc6713818c4177b64a712ecce11b</data>
    </edge>
    <edge source="Anthracyclines" target="Daunorubicin">
      <data key="d4">9.0</data>
      <data key="d5">Daunorubicin is an anthracycline chemotherapy drug known for causing potential cardiac toxicity and DNA disruption.</data>
      <data key="d6">drug classification, anthracycline</data>
      <data key="d7">chunk-8333423c91919d7adde114b8286cca7e</data>
    </edge>
    <edge source="Anthracyclines" target="Idarubicin">
      <data key="d4">9.0</data>
      <data key="d5">Idarubicin is an example of an anthracycline chemotherapy drug.</data>
      <data key="d6">drug classification, anthracycline</data>
      <data key="d7">chunk-8333423c91919d7adde114b8286cca7e</data>
    </edge>
    <edge source="Anthracyclines" target="Mitoxantrone">
      <data key="d4">9.0</data>
      <data key="d5">Mitoxantrone is an anthracycline drug used in cancer chemotherapy.</data>
      <data key="d6">drug classification, anthracycline</data>
      <data key="d7">chunk-8333423c91919d7adde114b8286cca7e</data>
    </edge>
    <edge source="Anthracyclines" target="CPX-351">
      <data key="d4">8.0</data>
      <data key="d5">CPX-351 incorporates an anthracycline agent into its liposome delivery system.</data>
      <data key="d6">drug formulation, drug class</data>
      <data key="d7">chunk-8333423c91919d7adde114b8286cca7e</data>
    </edge>
    <edge source="Hypomethylating Agents" target="Azacitidine">
      <data key="d4">18.0</data>
      <data key="d5">Azacitidine is a hypomethylating agent that prevents methyl groups from silencing genes.&lt;SEP&gt;Azacitidine is classified as a hypomethylating agent that prevents DNA hypermethylation in leukemia.</data>
      <data key="d6">drug classification, epigenetic therapy&lt;SEP&gt;drug classification, hypomethylating therapy</data>
      <data key="d7">chunk-06f823f3a91fcbc32c62fac3c6347715&lt;SEP&gt;chunk-8333423c91919d7adde114b8286cca7e</data>
    </edge>
    <edge source="Hypomethylating Agents" target="Targeted Therapy">
      <data key="d4">7.0</data>
      <data key="d5">Both hypomethylating agents and targeted therapies are specialized cancer therapy categories designed to alter cancer cell function and promote normal cell maturation.</data>
      <data key="d6">cancer therapeutics, systemic therapy</data>
      <data key="d7">chunk-06f823f3a91fcbc32c62fac3c6347715</data>
    </edge>
    <edge source="Hypomethylating Agents" target="Decitabine">
      <data key="d4">9.0</data>
      <data key="d5">Decitabine is a hypomethylating agent utilized to demethylate DNA and reactivate silenced tumor-suppressing genes.</data>
      <data key="d6">drug classification, epigenetic therapy</data>
      <data key="d7">chunk-06f823f3a91fcbc32c62fac3c6347715</data>
    </edge>
    <edge source="Ovarian Cancer" target="Female Reproductive System">
      <data key="d4">9.0</data>
      <data key="d5">Ovarian cancer develops within the ovaries and fallopian tubes, which are core organs of the female reproductive system.</data>
      <data key="d6">anatomical localization, disease origin</data>
      <data key="d7">chunk-53afdc6713818c4177b64a712ecce11b</data>
    </edge>
    <edge source="Ovarian Cancer" target="Epithelial Ovarian Cancer">
      <data key="d4">9.0</data>
      <data key="d5">Epithelial ovarian cancer is the most common form of ovarian cancer, developing on the outer tissue layer of the ovaries.</data>
      <data key="d6">disease classification, cancer subtype</data>
      <data key="d7">chunk-53afdc6713818c4177b64a712ecce11b</data>
    </edge>
    <edge source="Ovarian Cancer" target="Abdominal Exam">
      <data key="d4">8.0</data>
      <data key="d5">The abdominal exam is performed to check for physical signs, organ enlargement, and fluid buildup linked to suspected ovarian cancer.</data>
      <data key="d6">diagnostic evaluation, symptom assessment</data>
      <data key="d7">chunk-e5406c28b41e499fad4ae44f2c44fdd7</data>
    </edge>
    <edge source="Ovarian Cancer" target="Pelvic Exam">
      <data key="d4">8.0</data>
      <data key="d5">The pelvic exam allows providers to palpate changes in the ovaries and reproductive organs when evaluating ovarian cancer.</data>
      <data key="d6">clinical examination, staging</data>
      <data key="d7">chunk-e5406c28b41e499fad4ae44f2c44fdd7</data>
    </edge>
    <edge source="Ovarian Cancer" target="CT Scan">
      <data key="d4">16.0</data>
      <data key="d5">CT scans assess whether ovarian cancer has spread outside the ovaries or into nearby lymph nodes.&lt;SEP&gt;CT scans produce detailed 3-D images to assess internal structures and tumors in patients evaluated for cancer.</data>
      <data key="d6">diagnostic imaging, cancer evaluation&lt;SEP&gt;staging, metastatic assessment</data>
      <data key="d7">chunk-ae40f53e9d867c255e1e6901f5cfb058&lt;SEP&gt;chunk-e5406c28b41e499fad4ae44f2c44fdd7</data>
    </edge>
    <edge source="Ovarian Cancer" target="Surgery">
      <data key="d4">9.0</data>
      <data key="d5">Surgery is used both as a potential primary treatment and as the definitive method to determine the exact amount of ovarian cancer in the body.</data>
      <data key="d6">surgical treatment, definitive staging</data>
      <data key="d7">chunk-e5406c28b41e499fad4ae44f2c44fdd7</data>
    </edge>
    <edge source="Ovarian Cancer" target="Healthcare Provider">
      <data key="d4">8.0</data>
      <data key="d5">The healthcare provider evaluates symptoms to determine whether ovarian cancer is suspected and initiates diagnostic tests.</data>
      <data key="d6">diagnosis, patient assessment</data>
      <data key="d7">chunk-e5406c28b41e499fad4ae44f2c44fdd7</data>
    </edge>
    <edge source="Ovarian Cancer" target="Ascites">
      <data key="d4">8.0</data>
      <data key="d5">Ascites is a clinical manifestation and sign of fluid buildup associated with ovarian cancer.</data>
      <data key="d6">clinical manifestation, pathology</data>
      <data key="d7">chunk-e5406c28b41e499fad4ae44f2c44fdd7</data>
    </edge>
    <edge source="Ovarian Cancer" target="Transabdominal Ultrasound">
      <data key="d4">8.0</data>
      <data key="d5">Transabdominal ultrasound evaluates masses in the abdomen and pelvis to help identify ovarian cancer.</data>
      <data key="d6">radiological assessment, tumor detection</data>
      <data key="d7">chunk-e5406c28b41e499fad4ae44f2c44fdd7</data>
    </edge>
    <edge source="Ovarian Cancer" target="Transvaginal Ultrasound">
      <data key="d4">9.0</data>
      <data key="d5">Transvaginal ultrasound allows doctors to closely view the ovaries and distinguish whether an ovarian mass is solid or cystic.</data>
      <data key="d6">radiological assessment, tumor characterization</data>
      <data key="d7">chunk-e5406c28b41e499fad4ae44f2c44fdd7</data>
    </edge>
    <edge source="Ovarian Cancer" target="Imaging Tests">
      <data key="d4">9.0</data>
      <data key="d5">Imaging tests identify the location, size, shape, and spread of ovarian tumors beyond the ovaries.</data>
      <data key="d6">disease assessment, oncology imaging</data>
      <data key="d7">chunk-e5406c28b41e499fad4ae44f2c44fdd7</data>
    </edge>
    <edge source="Ovarian Cancer" target="Hereditary Ovarian Cancer">
      <data key="d4">8.0</data>
      <data key="d5">Hereditary ovarian cancer accounts for about one in six cases of ovarian cancer and typically develops at a younger age.</data>
      <data key="d6">subtype, etiology</data>
      <data key="d7">chunk-ae40f53e9d867c255e1e6901f5cfb058</data>
    </edge>
    <edge source="Ovarian Cancer" target="Pathologist">
      <data key="d4">9.0</data>
      <data key="d5">A pathologist confirms the diagnosis and features of ovarian cancer by examining tumor specimens.</data>
      <data key="d6">cancer diagnosis, pathology</data>
      <data key="d7">chunk-ae40f53e9d867c255e1e6901f5cfb058</data>
    </edge>
    <edge source="Ovarian Cancer" target="Biopsy">
      <data key="d4">27.0</data>
      <data key="d5">A biopsy is mandatory to pathologically confirm ovarian cancer before starting neoadjuvant chemotherapy.&lt;SEP&gt;A biopsy is necessary to definitively diagnose ovarian cancer by removing tissue samples before or during surgery.&lt;SEP&gt;Biopsy of tumor tissue is the primary method used to diagnose ovarian cancer.</data>
      <data key="d6">cancer diagnosis, pathology verification&lt;SEP&gt;diagnosis, tissue sampling&lt;SEP&gt;diagnostic procedure, pathological confirmation</data>
      <data key="d7">chunk-cf2d987135a5936876bc819136e3a5b5&lt;SEP&gt;chunk-77ac570b4029abb181150e0d0975aefb&lt;SEP&gt;chunk-ae40f53e9d867c255e1e6901f5cfb058</data>
    </edge>
    <edge source="Ovarian Cancer" target="Diagnostic Laparoscopy">
      <data key="d4">8.0</data>
      <data key="d5">Diagnostic laparoscopy is used to determine how much ovarian cancer is present in the abdomen and guide initial treatment choices.</data>
      <data key="d6">cancer staging, treatment planning</data>
      <data key="d7">chunk-ae40f53e9d867c255e1e6901f5cfb058</data>
    </edge>
    <edge source="Ovarian Cancer" target="Chest X-ray">
      <data key="d4">7.0</data>
      <data key="d5">A chest x-ray is utilized to determine if ovarian cancer has metastasized to the lungs and to evaluate treatment outcomes.</data>
      <data key="d6">metastasis detection, treatment monitoring</data>
      <data key="d7">chunk-ae40f53e9d867c255e1e6901f5cfb058</data>
    </edge>
    <edge source="Ovarian Cancer" target="BRCA Mutation">
      <data key="d4">9.0</data>
      <data key="d5">Patients diagnosed with ovarian cancer are tested for BRCA mutations to direct therapeutic strategy and maintenance therapy.</data>
      <data key="d6">genetic testing, cancer treatment</data>
      <data key="d7">chunk-96238b4b361e393ff452a09d1ce26154</data>
    </edge>
    <edge source="Ovarian Cancer" target="Homologous Recombination Deficiency (HRD)">
      <data key="d4">8.0</data>
      <data key="d5">The HRD status of an ovarian cancer tumor guides treatment decisions, particularly regarding maintenance therapy.</data>
      <data key="d6">therapeutic decision-making, disease profiling</data>
      <data key="d7">chunk-96238b4b361e393ff452a09d1ce26154</data>
    </edge>
    <edge source="Ovarian Cancer" target="Tumor Markers">
      <data key="d4">8.0</data>
      <data key="d5">Tumor markers such as CA-125 are utilized to aid in diagnosing ovarian cancer and tracking treatment response.</data>
      <data key="d6">diagnostic markers, disease monitoring</data>
      <data key="d7">chunk-96238b4b361e393ff452a09d1ce26154</data>
    </edge>
    <edge source="Ovarian Cancer" target="Initial Surgery">
      <data key="d4">8.0</data>
      <data key="d5">Diagnostic biopsy and primary treatment for ovarian cancer are typically conducted during initial surgery.</data>
      <data key="d6">surgical diagnosis, medical intervention</data>
      <data key="d7">chunk-96238b4b361e393ff452a09d1ce26154</data>
    </edge>
    <edge source="Ovarian Cancer" target="Blood Tests">
      <data key="d4">15.0</data>
      <data key="d5">Blood tests are conducted in ovarian cancer care to evaluate general health, organ function, and potential cancer spread.&lt;SEP&gt;Blood tests, such as CBC, chemistry profiles, liver function tests, and tumor markers, are used in evaluating suspected ovarian cancer.</data>
      <data key="d6">diagnostic testing, health assessment&lt;SEP&gt;laboratory assessment, disease evaluation</data>
      <data key="d7">chunk-96238b4b361e393ff452a09d1ce26154&lt;SEP&gt;chunk-77ac570b4029abb181150e0d0975aefb</data>
    </edge>
    <edge source="Ovarian Cancer" target="Gastrointestinal Tract Examination">
      <data key="d4">6.0</data>
      <data key="d5">Endoscopic evaluations of the GI tract may be performed to examine digestive health and investigate symptoms in ovarian cancer patients.</data>
      <data key="d6">symptom evaluation, diagnostic imaging</data>
      <data key="d7">chunk-96238b4b361e393ff452a09d1ce26154</data>
    </edge>
    <edge source="Ovarian Cancer" target="CA-125 Test">
      <data key="d4">9.0</data>
      <data key="d5">The CA-125 test is the most common tumor marker test employed to assess and monitor ovarian cancer.</data>
      <data key="d6">diagnostic testing, tumor marker</data>
      <data key="d7">chunk-96238b4b361e393ff452a09d1ce26154</data>
    </edge>
    <edge source="Ovarian Cancer" target="Registered Dietitian Or Nutritionist">
      <data key="d4">7.0</data>
      <data key="d5">Ovarian cancer patients experiencing GI symptoms and poor nutrient intake are referred to dietitians or nutritionists to improve surgical outcomes.</data>
      <data key="d6">nutritional support, patient care</data>
      <data key="d7">chunk-96238b4b361e393ff452a09d1ce26154</data>
    </edge>
    <edge source="Ovarian Cancer" target="Recurrent Ovarian Cancer">
      <data key="d4">8.0</data>
      <data key="d5">Ovarian cancer can return after primary treatment, presenting as recurrent disease requiring specialized biomarker testing.</data>
      <data key="d6">disease progression, recurrence</data>
      <data key="d7">chunk-96238b4b361e393ff452a09d1ce26154</data>
    </edge>
    <edge source="Ovarian Cancer" target="Chemotherapy">
      <data key="d4">44.0</data>
      <data key="d5">Chemotherapy is a primary systemic treatment modality used across various stages of ovarian cancer.&lt;SEP&gt;Chemotherapy is a primary treatment modality for ovarian cancer, administered prior to surgery, postoperatively, or for maintenance.&lt;SEP&gt;Chemotherapy is used as a medical treatment for ovarian cancer, potentially given prior to primary surgery.&lt;SEP&gt;Chemotherapy regimens such as paclitaxel and carboplatin are administered to shrink or eradicate ovarian cancer cells.&lt;SEP&gt;Chemotherapy serves as a primary systemic treatment modality for patients diagnosed with ovarian cancer.</data>
      <data key="d6">cancer treatment, therapeutic intervention&lt;SEP&gt;cancer treatment, therapeutic protocol&lt;SEP&gt;systemic treatment, cancer care&lt;SEP&gt;systemic treatment, cancer therapy&lt;SEP&gt;treatment modality, oncology therapy</data>
      <data key="d7">chunk-b69d38fafe014cece3427bd0459ae42b&lt;SEP&gt;chunk-77ac570b4029abb181150e0d0975aefb&lt;SEP&gt;chunk-96238b4b361e393ff452a09d1ce26154&lt;SEP&gt;chunk-cf2d987135a5936876bc819136e3a5b5&lt;SEP&gt;chunk-8b44f0b4da13a804cd1dfb917ac7e981</data>
    </edge>
    <edge source="Ovarian Cancer" target="Less Common Ovarian Cancers (LCOCs)">
      <data key="d4">8.0</data>
      <data key="d5">LCOCs represent rarer variants of ovarian cancer that utilize distinct tumor marker panels.</data>
      <data key="d6">cancer classification, subtypes</data>
      <data key="d7">chunk-96238b4b361e393ff452a09d1ce26154</data>
    </edge>
    <edge source="Ovarian Cancer" target="High-Grade Serous Carcinoma">
      <data key="d4">9.0</data>
      <data key="d5">High-grade serous carcinoma is identified as one of the most common forms of ovarian cancer.</data>
      <data key="d6">disease subtype, cancer classification</data>
      <data key="d7">chunk-77ac570b4029abb181150e0d0975aefb</data>
    </edge>
    <edge source="Ovarian Cancer" target="High-Grade Endometrioid Carcinoma">
      <data key="d4">9.0</data>
      <data key="d5">High-grade endometrioid carcinoma is identified as one of the most common types of ovarian cancer.</data>
      <data key="d6">disease subtype, cancer classification</data>
      <data key="d7">chunk-77ac570b4029abb181150e0d0975aefb</data>
    </edge>
    <edge source="Ovarian Cancer" target="Gynecologic Oncologist">
      <data key="d4">8.0</data>
      <data key="d5">Surgical management of ovarian cancer should be performed by a specialist gynecologic oncologist.</data>
      <data key="d6">specialized care, surgical management</data>
      <data key="d7">chunk-77ac570b4029abb181150e0d0975aefb</data>
    </edge>
    <edge source="Ovarian Cancer" target="Hysterectomy and Bilateral Salpingo-Oophorectomy (BSO)">
      <data key="d4">9.0</data>
      <data key="d5">Hysterectomy with BSO represents the most common surgical intervention utilized to treat ovarian cancer.</data>
      <data key="d6">surgical standard of care, treatment procedure</data>
      <data key="d7">chunk-77ac570b4029abb181150e0d0975aefb</data>
    </edge>
    <edge source="Ovarian Cancer" target="BRCA Genes">
      <data key="d4">9.0</data>
      <data key="d5">Mutations in the BRCA genes are the most common cause of hereditary ovarian cancer, indicating mandatory genetic testing.</data>
      <data key="d6">genetic predisposition, risk factor</data>
      <data key="d7">chunk-77ac570b4029abb181150e0d0975aefb</data>
    </edge>
    <edge source="Ovarian Cancer" target="Biomarker Testing">
      <data key="d4">8.0</data>
      <data key="d5">Biomarker testing on removed tumor tissue is performed to guide targeted therapies and individualized treatment regimens for ovarian cancer.</data>
      <data key="d6">molecular diagnostics, targeted therapy</data>
      <data key="d7">chunk-77ac570b4029abb181150e0d0975aefb</data>
    </edge>
    <edge source="Ovarian Cancer" target="Surgical Staging">
      <data key="d4">9.0</data>
      <data key="d5">Surgical staging is performed during surgery to evaluate tissues and identify microscopic metastases for accurate disease staging.</data>
      <data key="d6">diagnostic procedure, disease staging</data>
      <data key="d7">chunk-77ac570b4029abb181150e0d0975aefb</data>
    </edge>
    <edge source="Ovarian Cancer" target="Clinical Trials">
      <data key="d4">7.0</data>
      <data key="d5">Clinical trials represent a key treatment consideration for patients managing ovarian cancer.</data>
      <data key="d6">clinical research, treatment pathway</data>
      <data key="d7">chunk-77ac570b4029abb181150e0d0975aefb</data>
    </edge>
    <edge source="Ovarian Cancer" target="FIGO Staging System">
      <data key="d4">9.0</data>
      <data key="d5">The FIGO staging system is used to evaluate the extent, spread, and stage of ovarian cancer.</data>
      <data key="d6">disease classification, clinical staging</data>
      <data key="d7">chunk-cf2d987135a5936876bc819136e3a5b5</data>
    </edge>
    <edge source="Ovarian Cancer" target="AJCC Staging System">
      <data key="d4">8.0</data>
      <data key="d5">The AJCC staging system is one of two primary staging systems used to determine the extent of ovarian cancer.</data>
      <data key="d6">disease classification, clinical staging</data>
      <data key="d7">chunk-cf2d987135a5936876bc819136e3a5b5</data>
    </edge>
    <edge source="Ovarian Cancer" target="Ovarian Cancer Surgery">
      <data key="d4">10.0</data>
      <data key="d5">Surgery is a primary diagnostic and therapeutic intervention to remove tumors and determine the pathologic stage of ovarian cancer.</data>
      <data key="d6">oncological treatment, surgical intervention</data>
      <data key="d7">chunk-cf2d987135a5936876bc819136e3a5b5</data>
    </edge>
    <edge source="Ovarian Cancer" target="Interval Cytoreductive Surgery">
      <data key="d4">9.0</data>
      <data key="d5">Interval cytoreductive surgery is utilized in ovarian cancer cases following chemotherapy when upfront surgery is not feasible.</data>
      <data key="d6">delayed resection, multimodal therapy</data>
      <data key="d7">chunk-cf2d987135a5936876bc819136e3a5b5</data>
    </edge>
    <edge source="Ovarian Cancer" target="Microscopic Metastases">
      <data key="d4">9.0</data>
      <data key="d5">Microscopic metastases represent the microscopic spread of ovarian cancer outside the primary tumor site.</data>
      <data key="d6">disease metastasis, cancer pathology</data>
      <data key="d7">chunk-cf2d987135a5936876bc819136e3a5b5</data>
    </edge>
    <edge source="Ovarian Cancer" target="FIGO">
      <data key="d4">9.0</data>
      <data key="d5">FIGO establishes the official medical staging system used to categorize the extent and progression of ovarian cancer.</data>
      <data key="d6">medical staging, diagnostic standards</data>
      <data key="d7">chunk-b69d38fafe014cece3427bd0459ae42b</data>
    </edge>
    <edge source="Ovarian Cancer" target="Stage 1 Ovarian Cancer">
      <data key="d4">9.0</data>
      <data key="d5">Stage 1 represents the initial, localized stage category within the ovarian cancer staging system.</data>
      <data key="d6">disease staging, classification</data>
      <data key="d7">chunk-b69d38fafe014cece3427bd0459ae42b</data>
    </edge>
    <edge source="Ovarian Cancer" target="Stage 2 Ovarian Cancer">
      <data key="d4">9.0</data>
      <data key="d5">Stage 2 is an intermediate stage category within the ovarian cancer staging system denoting pelvic spread.</data>
      <data key="d6">disease staging, classification</data>
      <data key="d7">chunk-b69d38fafe014cece3427bd0459ae42b</data>
    </edge>
    <edge source="Ovarian Cancer" target="Stage 3 Ovarian Cancer">
      <data key="d4">9.0</data>
      <data key="d5">Stage 3 is an advanced stage category within the ovarian cancer staging system involving abdominal or nodal spread.</data>
      <data key="d6">disease staging, classification</data>
      <data key="d7">chunk-b69d38fafe014cece3427bd0459ae42b</data>
    </edge>
    <edge source="Ovarian Cancer" target="Stage 4 Ovarian Cancer">
      <data key="d4">9.0</data>
      <data key="d5">Stage 4 is the metastatic stage category within the ovarian cancer staging system representing distant spread.</data>
      <data key="d6">disease staging, classification</data>
      <data key="d7">chunk-b69d38fafe014cece3427bd0459ae42b</data>
    </edge>
    <edge source="Ovarian Cancer" target="Maintenance Therapy">
      <data key="d4">9.0</data>
      <data key="d5">Maintenance therapy is utilized following primary surgery and chemotherapy to reduce recurrence risks in ovarian cancer patients.</data>
      <data key="d6">disease management, recurrence prevention</data>
      <data key="d7">chunk-8b44f0b4da13a804cd1dfb917ac7e981</data>
    </edge>
    <edge source="Ovarian Cancer" target="Germline Mutations">
      <data key="d4">8.0</data>
      <data key="d5">Germline mutations in genes including BRCA1 and BRCA2 elevate the risk for ovarian cancer as well as prostate cancer.</data>
      <data key="d6">hereditary cancer, genetic predisposition</data>
      <data key="d7">chunk-789ec6c06f8c999ac21c89b085b3fdb7</data>
    </edge>
    <edge source="Ovarian Cancer" target="BRCA2">
      <data key="d4">17.0</data>
      <data key="d5">BRCA2 mutations are linked to an increased risk of ovarian cancer.&lt;SEP&gt;Inherited alterations in BRCA2 raise the risk of developing ovarian cancer.</data>
      <data key="d6">hereditary risk, disease predisposition&lt;SEP&gt;hereditary risk, oncological link</data>
      <data key="d7">chunk-650982a589c2d527bc13923ccd0569ef&lt;SEP&gt;chunk-965e5a6bad03f2129a98be4373f99176</data>
    </edge>
    <edge source="Ovarian Cancer" target="BRCA1">
      <data key="d4">9.0</data>
      <data key="d5">Mutations in BRCA1 significantly elevate the risk of developing ovarian cancer.</data>
      <data key="d6">hereditary risk, disease predisposition</data>
      <data key="d7">chunk-650982a589c2d527bc13923ccd0569ef</data>
    </edge>
    <edge source="Standard Of Care" target="Preferred Therapies">
      <data key="d4">8.0</data>
      <data key="d5">Preferred therapies represent treatments with the strongest evidence that frequently define the standard of care.</data>
      <data key="d6">clinical guidelines, treatment hierarchy</data>
      <data key="d7">chunk-53afdc6713818c4177b64a712ecce11b</data>
    </edge>
    <edge source="Standard Of Care" target="Chemotherapy">
      <data key="d4">18.0</data>
      <data key="d5">Chemotherapy is considered the standard of care for treating acute myeloid leukemia.&lt;SEP&gt;Chemotherapy serves as the established standard of care regimen for treating AML based on clinical trial outcomes.</data>
      <data key="d6">clinical protocol, standard treatment&lt;SEP&gt;treatment protocol, standard of care</data>
      <data key="d7">chunk-8333423c91919d7adde114b8286cca7e&lt;SEP&gt;chunk-53afdc6713818c4177b64a712ecce11b</data>
    </edge>
    <edge source="Standard Of Care" target="Clinical Trials">
      <data key="d4">8.0</data>
      <data key="d5">Standard of care protocols are developed and validated through outcomes of clinical trials.</data>
      <data key="d6">evidence-based medicine, clinical research</data>
      <data key="d7">chunk-8333423c91919d7adde114b8286cca7e</data>
    </edge>
    <edge source="Multi-Agent Chemotherapy" target="Chemotherapy">
      <data key="d4">18.0</data>
      <data key="d5">Chemotherapy drugs are frequently administered together in multi-agent chemotherapy regimens.&lt;SEP&gt;Multi-agent chemotherapy is a specialized regimen format where multiple chemotherapy drugs are combined.</data>
      <data key="d6">regimen classification, combined modality&lt;SEP&gt;treatment regimen, drug combination</data>
      <data key="d7">chunk-8333423c91919d7adde114b8286cca7e&lt;SEP&gt;chunk-53afdc6713818c4177b64a712ecce11b</data>
    </edge>
    <edge source="Intrathecal Chemotherapy" target="Chemotherapy">
      <data key="d4">17.0</data>
      <data key="d5">Intrathecal chemotherapy is a direct administration method of chemotherapy targeting the fluid around the brain and spine.&lt;SEP&gt;Intrathecal chemotherapy is a specialized form of chemotherapy administered directly into the cerebrospinal fluid.</data>
      <data key="d6">drug administration, central nervous system treatment&lt;SEP&gt;treatment specialization, route of administration</data>
      <data key="d7">chunk-725b48dc82aad42ba3dc14f4b5207551&lt;SEP&gt;chunk-53afdc6713818c4177b64a712ecce11b</data>
    </edge>
    <edge source="Intrathecal Chemotherapy" target="Cytarabine">
      <data key="d4">9.0</data>
      <data key="d5">Cytarabine can be administered via intrathecal chemotherapy into the spinal fluid to treat AML affecting the central nervous system.</data>
      <data key="d6">drug administration, route of delivery</data>
      <data key="d7">chunk-8333423c91919d7adde114b8286cca7e</data>
    </edge>
    <edge source="Intrathecal Chemotherapy" target="Methotrexate">
      <data key="d4">9.0</data>
      <data key="d5">Methotrexate is utilized in intrathecal chemotherapy to treat leukemia in spinal and brain fluid.</data>
      <data key="d6">drug administration, route of delivery</data>
      <data key="d7">chunk-8333423c91919d7adde114b8286cca7e</data>
    </edge>
    <edge source="Intrathecal Chemotherapy" target="Primary CNS Lymphoma">
      <data key="d4">16.0</data>
      <data key="d5">Intrathecal chemotherapy is indicated if primary CNS lymphoma spreads to the cerebrospinal fluid or spine.&lt;SEP&gt;Intrathecal chemotherapy is utilized in select cases or protocols when primary CNS lymphoma is detected in the cerebrospinal fluid.</data>
      <data key="d6">localized therapy, disease management&lt;SEP&gt;targeted intervention, disease progression</data>
      <data key="d7">chunk-8fbedfa2d88a7b3852f4c2bd0bb64af0&lt;SEP&gt;chunk-725b48dc82aad42ba3dc14f4b5207551</data>
    </edge>
    <edge source="CD33 Protein" target="Targeted Therapy">
      <data key="d4">9.0</data>
      <data key="d5">Targeted therapies like gemtuzumab ozogamicin bind specifically to CD33 cell surface proteins on leukemic blasts.</data>
      <data key="d6">molecular targeting, protein binding</data>
      <data key="d7">chunk-53afdc6713818c4177b64a712ecce11b</data>
    </edge>
    <edge source="FLT3 Mutation" target="Targeted Therapy">
      <data key="d4">9.0</data>
      <data key="d5">Targeted inhibitors such as gilteritinib and quizartinib are used to treat AML cases harboring FLT3 mutations.</data>
      <data key="d6">targeted intervention, genetic mutation</data>
      <data key="d7">chunk-53afdc6713818c4177b64a712ecce11b</data>
    </edge>
    <edge source="FLT3 Mutation" target="Gilteritinib">
      <data key="d4">9.0</data>
      <data key="d5">Gilteritinib is targeted specifically against leukemia cells harboring FLT3 mutations.</data>
      <data key="d6">molecular target, precision oncology</data>
      <data key="d7">chunk-06f823f3a91fcbc32c62fac3c6347715</data>
    </edge>
    <edge source="FLT3 Mutation" target="Quizartinib">
      <data key="d4">9.0</data>
      <data key="d5">Quizartinib is prescribed for the targeted treatment of AML driven by the FLT3-ITD mutation.</data>
      <data key="d6">targeted inhibition, mutation specificity</data>
      <data key="d7">chunk-06f823f3a91fcbc32c62fac3c6347715</data>
    </edge>
    <edge source="FLT3 Mutation" target="Midostaurin">
      <data key="d4">9.0</data>
      <data key="d5">Midostaurin acts as an inhibitor targeting leukemia cells harboring FLT3 genetic mutations.</data>
      <data key="d6">kinase inhibition, targeted treatment</data>
      <data key="d7">chunk-06f823f3a91fcbc32c62fac3c6347715</data>
    </edge>
    <edge source="FLT3 Mutation" target="Sorafenib">
      <data key="d4">9.0</data>
      <data key="d5">Sorafenib is employed as a targeted therapy to treat AML characterized by FLT3-ITD mutations.</data>
      <data key="d6">targeted therapy, molecular inhibition</data>
      <data key="d7">chunk-06f823f3a91fcbc32c62fac3c6347715</data>
    </edge>
    <edge source="Female Reproductive System" target="Cervical Cancer">
      <data key="d4">9.0</data>
      <data key="d5">Cervical cancer is a major malignancy that affects the cervix, an integral organ of the female reproductive system.</data>
      <data key="d6">anatomical localization, gynecologic oncology</data>
      <data key="d7">chunk-d249262ff9e7e657de99a30199159cdf</data>
    </edge>
    <edge source="Female Reproductive System" target="Childbirth">
      <data key="d4">8.0</data>
      <data key="d5">During childbirth, organs of the female reproductive system, particularly the cervix and vagina, accommodate the delivery of a baby.</data>
      <data key="d6">reproductive physiology, maternal delivery</data>
      <data key="d7">chunk-d249262ff9e7e657de99a30199159cdf</data>
    </edge>
    <edge source="Female Reproductive System" target="Menstruation">
      <data key="d4">7.0</data>
      <data key="d5">Menstruation is a cyclical function of the female reproductive system involving the uterus and cervical openings.</data>
      <data key="d6">reproductive physiology, menstrual cycle</data>
      <data key="d7">chunk-d249262ff9e7e657de99a30199159cdf</data>
    </edge>
    <edge source="Epithelial Ovarian Cancer" target="High-Grade Serous Carcinoma">
      <data key="d4">9.0</data>
      <data key="d5">High-grade serous carcinoma is one of the most common subtypes of epithelial ovarian cancer.</data>
      <data key="d6">disease classification, cancer subtypes</data>
      <data key="d7">chunk-b4da30dee72e228147daa825e4f5be72</data>
    </edge>
    <edge source="Epithelial Ovarian Cancer" target="High-Grade Endometrioid Carcinoma">
      <data key="d4">8.0</data>
      <data key="d5">High-grade endometrioid carcinoma is a primary form of epithelial ovarian cancer.</data>
      <data key="d6">disease classification, cancer subtypes</data>
      <data key="d7">chunk-b4da30dee72e228147daa825e4f5be72</data>
    </edge>
    <edge source="Epithelial Ovarian Cancer" target="Less Common Ovarian Cancers">
      <data key="d4">7.0</data>
      <data key="d5">Less common ovarian cancers encompass rare forms of epithelial tumors as well as non-epithelial tumors.</data>
      <data key="d6">cancer classification, rare malignancies</data>

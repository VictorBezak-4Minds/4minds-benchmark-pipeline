    </edge>
    <edge source="Methotrexate" target="Chemotherapy">
      <data key="d4">9.0</data>
      <data key="d5">Methotrexate is identified as the main chemotherapy agent used against primary CNS lymphoma.</data>
      <data key="d6">pharmacotherapy, drug classification</data>

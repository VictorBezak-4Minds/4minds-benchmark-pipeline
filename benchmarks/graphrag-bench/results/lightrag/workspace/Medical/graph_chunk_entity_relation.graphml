      <data key="d6">genetic mutation, disease association</data>
      <data key="d7">chunk-6b02315423350f3598288e189fbcb8ae</data>
    </edge>
    <edge source="Chordoma" target="Radiation Therapy">
      <data key="d4">8.0</data>

      <data key="d6">nodule classification, diagnostic categorization</data>
      <data key="d7">chunk-bd06bc83e13e7562ce65d6eee1b6024f</data>
    </edge>
    <edge source="Lung Nodules" target="Subsolid Nodules">
      <data key="d4">8.0</data>
      <data key="d5">Subsolid nodules are a distinct subtype of lung nodules requiring clinical follow-up to evaluate malignancy risk.</data>
      <data key="d6">nodule classification, diagnostic categorization</data>
      <data key="d7">chunk-bd06bc83e13e7562ce65d6eee1b6024f</data>
    </edge>
    <edge source="Pulmonologist" target="Assessment Team">
      <data key="d4">8.0</data>

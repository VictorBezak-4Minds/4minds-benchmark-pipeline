    </edge>
    <edge source="HER2 Testing" target="Biopsy">
      <data key="d4">9.0</data>
      <data key="d5">Biopsy samples are analyzed to detect the presence or expression level of HER2 receptors.</data>
      <data key="d6">pathology assessment, molecular testing</data>
      <data key="d7">chunk-c37f547042fc10baabdbfaadf010bce5</data>
    </edge>

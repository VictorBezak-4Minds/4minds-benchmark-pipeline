      <data key="d6">blood analysis, biomarker test</data>
      <data key="d7">chunk-9dc281a303d0d4c5300c0c1c45b739ed</data>
    </edge>
    <edge source="Blood Test" target="IsoPSA">
      <data key="d4">8.0</data>
      <data key="d5">IsoPSA is a diagnostic blood test utilized to evaluate the likelihood of prostate cancer.</data>
      <data key="d6">blood biomarker, diagnostic evaluation</data>
      <data key="d7">chunk-9dc281a303d0d4c5300c0c1c45b739ed</data>
    </edge>
    <edge source="Blood Test" target="Care Team">
      <data key="d4">8.0</data>

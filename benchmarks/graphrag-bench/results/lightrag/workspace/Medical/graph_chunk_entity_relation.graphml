      <data key="d6">treatment subtype, therapeutic modality</data>
      <data key="d7">chunk-cd2be7a2ce722f07b19c80e6e1690a8e</data>
    </edge>
    <edge source="Study Sponsor" target="Clinical Trials">
      <data key="d4">17.0</data>
      <data key="d5">The study sponsor finances research protocol expenses and provides investigational drugs for clinical trials.&lt;SEP&gt;The study sponsor funds clinical trials and provides the investigational drugs.</data>
      <data key="d6">research funding, trial sponsorship&lt;SEP&gt;study sponsorship, medical financing</data>

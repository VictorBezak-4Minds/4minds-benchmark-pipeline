    </edge>
    <edge source="Human Papillomavirus" target="p16 Testing">
      <data key="d4">9.0</data>
      <data key="d5">The p16 protein serves as a clinical surrogate biomarker to detect HPV infection in cancer cells.</data>
      <data key="d6">biomarker, viral detection</data>
      <data key="d7">chunk-5fa7c7369d88ae71c842152510867223</data>
    </edge>
    <edge source="Human Papillomavirus" target="p16 Protein">
      <data key="d4">9.0</data>
      <data key="d5">The p16 protein is typically overexpressed in cells infected with human papillomavirus, making it a reliable surrogate indicator.</data>
      <data key="d6">viral marker, molecular biology</data>
      <data key="d7">chunk-5fa7c7369d88ae71c842152510867223</data>
    </edge>
    <edge source="Human Papillomavirus" target="HPV Type 16">
      <data key="d4">9.0</data>

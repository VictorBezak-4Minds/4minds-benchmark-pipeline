      <data key="d6">clinical consultation, collaborative care</data>
      <data key="d7">chunk-0fb70c1c798caae12ac2d64e61bcbad4</data>
    </edge>
    <edge source="Multidisciplinary Care Team" target="Primary CNS Lymphoma">

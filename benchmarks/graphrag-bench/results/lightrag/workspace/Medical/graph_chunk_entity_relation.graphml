      <data key="d5">Both 2D digital mammograms and 3D tomosynthesis are alternative low-dose x-ray imaging modalities used for breast evaluation.</data>
      <data key="d6">imaging comparison, medical technology</data>
      <data key="d7">chunk-7390896141393e0b4d1c15df77b5c0a7</data>
    </edge>
    <edge source="Tomosynthesis" target="Mammogram">
      <data key="d4">9.0</data>

      <data key="d6">disease staging, cancer progression</data>
      <data key="d7">chunk-48e138ec8da954a5667dc785e919c86b</data>
    </edge>
    <edge source="Kidney Cancer" target="Urinary System">
      <data key="d4">8.0</data>
      <data key="d5">Kidney cancer affects the primary organs of the urinary system responsible for blood filtration and waste elimination.</data>
      <data key="d6">organ pathology, anatomical system</data>
      <data key="d7">chunk-48e138ec8da954a5667dc785e919c86b</data>
    </edge>

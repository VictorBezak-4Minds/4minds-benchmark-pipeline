      <data key="d7">chunk-50c5e5d6c7a62da56b73abb9a3384301</data>
    </edge>
    <edge source="Fine-Needle Aspiration (FNA)" target="Biopsy">
      <data key="d4">9.0</data>
      <data key="d5">Fine-needle aspiration is a primary biopsy technique used to confirm cancer spread to lymph nodes.</data>

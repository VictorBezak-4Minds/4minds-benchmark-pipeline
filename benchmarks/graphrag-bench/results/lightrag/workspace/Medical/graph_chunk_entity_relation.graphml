    </edge>
    <edge source="Glioma" target="Surgery">
      <data key="d4">17.0</data>
      <data key="d5">Surgery is one of the main standard treatments used to treat gliomas.&lt;SEP&gt;Surgery is one of the primary medical treatments used to resect and debulk glioma tumors in the brain.</data>

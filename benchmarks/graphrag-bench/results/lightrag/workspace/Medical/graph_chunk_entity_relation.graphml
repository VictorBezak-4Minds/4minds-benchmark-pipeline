      <data key="d6">diagnostic testing, treatment planning</data>
      <data key="d7">chunk-38185832d6395b9952def9a72ecc339d</data>
    </edge>
    <edge source="Oropharyngeal Cancer" target="Oropharynx">
      <data key="d4">10.0</data>
      <data key="d5">The oropharynx is the anatomical location where oropharyngeal cancer develops.</data>
      <data key="d6">anatomical site, disease location</data>
      <data key="d7">chunk-38185832d6395b9952def9a72ecc339d</data>
    </edge>
    <edge source="Oropharyngeal Cancer" target="CT Scan">
      <data key="d4">8.0</data>
      <data key="d5">CT scans are imaging tests used to evaluate the primary tumor and neck for throat cancer treatment planning.</data>
      <data key="d6">diagnostic imaging, cancer staging</data>
      <data key="d7">chunk-38185832d6395b9952def9a72ecc339d</data>
    </edge>
    <edge source="Oropharyngeal Cancer" target="FDG-PET/CT">
      <data key="d4">7.0</data>
      <data key="d5">FDG-PET/CT is utilized as needed to stage and assess the tumor and neck region.</data>
      <data key="d6">diagnostic imaging, tumor assessment</data>
      <data key="d7">chunk-38185832d6395b9952def9a72ecc339d</data>
    </edge>
    <edge source="Oropharyngeal Cancer" target="Endoscopy With Examination Under Anesthesia">
      <data key="d4">8.0</data>
      <data key="d5">Endoscopy with EUA is performed to visually evaluate tumors within the throat and oropharynx.</data>
      <data key="d6">diagnostic examination, endoscopy</data>
      <data key="d7">chunk-38185832d6395b9952def9a72ecc339d</data>
    </edge>
    <edge source="Oropharyngeal Cancer" target="Speech And Swallowing Evaluation">
      <data key="d4">8.0</data>
      <data key="d5">Speech and swallowing functions are frequently assessed because oropharyngeal cancer and its treatments impact throat function.</data>
      <data key="d6">functional assessment, supportive oncology</data>
      <data key="d7">chunk-38185832d6395b9952def9a72ecc339d</data>
    </edge>
    <edge source="Oral Cavity" target="Respiratory System">
      <data key="d4">8.0</data>
      <data key="d5">The oral cavity functions as a key component aiding breathing within the respiratory system.</data>
      <data key="d6">anatomical structure, bodily systems</data>
      <data key="d7">chunk-f43f96815f23658d5b24fe95ed4bd5ed</data>
    </edge>
    <edge source="Local Hospital" target="Support Groups">
      <data key="d4">7.0</data>

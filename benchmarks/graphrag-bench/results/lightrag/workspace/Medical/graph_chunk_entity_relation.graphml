      <data key="d6">nutritional support, patient care</data>
      <data key="d7">chunk-dea00cf063e8831db4919330d94b1f2a</data>
    </edge>
    <edge source="Multidisciplinary Care Team" target="Psychologist and Psychiatrist">
      <data key="d4">6.0</data>
      <data key="d5">Psychologists and psychiatrists collaborate with the cancer team to address psychological distress such as anxiety and depression.</data>
      <data key="d6">mental health, psychosocial support</data>
      <data key="d7">chunk-dea00cf063e8831db4919330d94b1f2a</data>
    </edge>
    <edge source="Consult Meeting" target="Physical Exam">
      <data key="d4">8.0</data>
      <data key="d5">A physical exam is performed by care team members during the consult meeting to evaluate signs of disease.</data>
      <data key="d6">clinical evaluation, patient consultation</data>
      <data key="d7">chunk-0fb70c1c798caae12ac2d64e61bcbad4</data>
    </edge>
    <edge source="Erectile Dysfunction" target="Prostate">
      <data key="d4">7.0</data>
      <data key="d5">Erectile dysfunction is identified as a symptom that may indicate underlying issues with the prostate.</data>

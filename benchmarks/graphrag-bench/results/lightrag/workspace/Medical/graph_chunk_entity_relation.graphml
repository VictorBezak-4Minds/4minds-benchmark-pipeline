      <data key="d7">chunk-9530f389987c13273449ab22a85170ae</data>
    </edge>
    <edge source="Sexually Transmitted Infection" target="Anal Cancer">
      <data key="d4">7.0</data>
      <data key="d5">A medical history of sexually transmitted infections increases the risk of anal cancer.</data>
      <data key="d6">infection risk, sexual health</data>
      <data key="d7">chunk-9530f389987c13273449ab22a85170ae</data>
    </edge>
    <edge source="Cervical Dysplasia" target="High-Grade Squamous Intraepithelial Lesion (HSIL)">
      <data key="d4">9.0</data>
      <data key="d5">HSIL represents moderate to severe cervical dysplasia (CIN 2 and 3) and is classified as pre-cancer.</data>
      <data key="d6">clinical classification, lesion severity</data>
      <data key="d7">chunk-b4d036ee5fd77783b9e7ddef3a8477ae</data>
    </edge>
    <edge source="Cervical Dysplasia" target="Low-Grade Squamous Intraepithelial Lesion (LSIL)">
      <data key="d4">9.0</data>
      <data key="d5">LSIL is a classification describing mild cervical dysplasia (CIN 1).</data>
      <data key="d6">clinical classification, lesion severity</data>
      <data key="d7">chunk-b4d036ee5fd77783b9e7ddef3a8477ae</data>
    </edge>
    <edge source="Human Papillomavirus (HPV)" target="HPV Vaccine">
      <data key="d4">9.0</data>
      <data key="d5">The HPV vaccine prevents infection from specific strains of HPV, including high-risk oncogenic types.</data>
      <data key="d6">prevention, immunization</data>
      <data key="d7">chunk-b4d036ee5fd77783b9e7ddef3a8477ae</data>
    </edge>
    <edge source="Human Papillomavirus (HPV)" target="Human Immunodeficiency Virus (HIV)">
      <data key="d4">8.0</data>
      <data key="d5">HIV weakens the immune system, impairing the body's ability to clear HPV infections.</data>
      <data key="d6">immunosuppression, infection susceptibility</data>
      <data key="d7">chunk-b4d036ee5fd77783b9e7ddef3a8477ae</data>
    </edge>
    <edge source="Human Papillomavirus (HPV)" target="HPV-16">
      <data key="d4">9.0</data>
      <data key="d5">HPV-16 is a major high-risk strain of human papillomavirus.</data>
      <data key="d6">viral strain, classification</data>
      <data key="d7">chunk-b4d036ee5fd77783b9e7ddef3a8477ae</data>
    </edge>
    <edge source="Human Papillomavirus (HPV)" target="HPV-18">
      <data key="d4">9.0</data>
      <data key="d5">HPV-18 is a high-risk oncogenic strain of human papillomavirus.</data>
      <data key="d6">viral strain, classification</data>
      <data key="d7">chunk-b4d036ee5fd77783b9e7ddef3a8477ae</data>
    </edge>
    <edge source="Human Papillomavirus (HPV)" target="Sexually Transmitted Infection (STI)">
      <data key="d4">9.0</data>
      <data key="d5">HPV is identified as an extremely common sexually transmitted infection.</data>
      <data key="d6">infection type, epidemiology</data>
      <data key="d7">chunk-b4d036ee5fd77783b9e7ddef3a8477ae</data>
    </edge>
    <edge source="Human Papillomavirus (HPV)" target="Anal Cancer">
      <data key="d4">8.0</data>
      <data key="d5">Persistent HPV infection is an established cause of anal cancer.</data>
      <data key="d6">disease etiology, viral oncology</data>
      <data key="d7">chunk-b4d036ee5fd77783b9e7ddef3a8477ae</data>
    </edge>
    <edge source="Human Papillomavirus (HPV)" target="Penile Cancer">
      <data key="d4">8.0</data>
      <data key="d5">HPV infection is responsible for causing penile cancers.</data>
      <data key="d6">disease etiology, viral oncology</data>
      <data key="d7">chunk-b4d036ee5fd77783b9e7ddef3a8477ae</data>
    </edge>
    <edge source="Human Papillomavirus (HPV)" target="Vaginal Cancer">
      <data key="d4">8.0</data>
      <data key="d5">Long-term HPV infection causes vaginal cancer.</data>
      <data key="d6">disease etiology, viral oncology</data>
      <data key="d7">chunk-b4d036ee5fd77783b9e7ddef3a8477ae</data>
    </edge>
    <edge source="Human Papillomavirus (HPV)" target="Vulvar Cancer">
      <data key="d4">8.0</data>
      <data key="d5">Vulvar cancer is caused by persistent infection with human papillomavirus.</data>
      <data key="d6">disease etiology, viral oncology</data>
      <data key="d7">chunk-b4d036ee5fd77783b9e7ddef3a8477ae</data>
    </edge>
    <edge source="Human Papillomavirus (HPV)" target="Genital Warts">
      <data key="d4">8.0</data>
      <data key="d5">Non-oncogenic strains of HPV cause warts to form on the genitals and other bodily areas.</data>
      <data key="d6">symptom etiology, clinical manifestation</data>
      <data key="d7">chunk-b4d036ee5fd77783b9e7ddef3a8477ae</data>
    </edge>
    <edge source="HPV Vaccine" target="HPV-16">
      <data key="d4">9.0</data>
      <data key="d5">HPV vaccines specifically target high-risk strain HPV-16 to prevent malignancy.</data>
      <data key="d6">vaccine target, immune prevention</data>
      <data key="d7">chunk-b4d036ee5fd77783b9e7ddef3a8477ae</data>
    </edge>
    <edge source="HPV Vaccine" target="HPV-18">
      <data key="d4">9.0</data>
      <data key="d5">Global HPV vaccine formulations target high-risk strain HPV-18.</data>
      <data key="d6">vaccine target, immune prevention</data>
      <data key="d7">chunk-b4d036ee5fd77783b9e7ddef3a8477ae</data>
    </edge>
    <edge source="HPV Vaccine" target="Anal Cancer">
      <data key="d4">8.0</data>
      <data key="d5">By preventing HPV infection, the HPV vaccine reduces the incidence and risk of developing anal cancer.</data>
      <data key="d6">cancer prevention, prophylaxis</data>
      <data key="d7">chunk-9530f389987c13273449ab22a85170ae</data>
    </edge>
    <edge source="Anal Cancer" target="Human Papillomavirus Infection">
      <data key="d4">10.0</data>
      <data key="d5">Long-term infection with high-risk human papillomavirus is the strongest established risk factor for developing anal cancer.</data>
      <data key="d6">etiology, oncogenic risk factor</data>
      <data key="d7">chunk-f2a44e885faf856aa579d824b3cd85e7</data>
    </edge>
    <edge source="Anal Cancer" target="Radiation Therapy">
      <data key="d4">26.0</data>
      <data key="d5">Radiation therapy is a primary treatment modality coordinated by oncology teams for treating anal cancer.&lt;SEP&gt;Radiation therapy targeted at the pelvic area is a standard treatment option for patients diagnosed with anal cancer.&lt;SEP&gt;Radiation therapy to the pelvic area is a primary treatment modality for anal cancer patients.</data>
      <data key="d6">cancer treatment, therapeutic intervention&lt;SEP&gt;oncological treatment, therapeutic intervention&lt;SEP&gt;radiation oncology, cancer treatment</data>
      <data key="d7">chunk-f2a44e885faf856aa579d824b3cd85e7&lt;SEP&gt;chunk-44a870810cef881997b741c32ec368fe&lt;SEP&gt;chunk-cf41d1c08e8df109ad214d831867a5d9</data>
    </edge>
    <edge source="Anal Cancer" target="Clinical Trial">
      <data key="d4">14.0</data>
      <data key="d5">Anal cancer patients are encouraged to participate in clinical trials to evaluate and receive cutting-edge treatment protocols.&lt;SEP&gt;Clinical trials are explored as potential experimental or advanced treatment avenues for patients with anal cancer.</data>
      <data key="d6">clinical research, treatment evaluation&lt;SEP&gt;clinical research, treatment options</data>
      <data key="d7">chunk-f2a44e885faf856aa579d824b3cd85e7&lt;SEP&gt;chunk-419f40f64b13b1b2d0fac3cfb9fde92a</data>
    </edge>
    <edge source="Anal Cancer" target="Anal Adenocarcinoma">
      <data key="d4">8.0</data>
      <data key="d5">Anal adenocarcinoma is a rare distinct subtype of anal cancer differing from the more common squamous cell carcinoma.</data>
      <data key="d6">histological variant, oncology subtype</data>
      <data key="d7">chunk-f2a44e885faf856aa579d824b3cd85e7</data>
    </edge>
    <edge source="Anal Cancer" target="Anal Melanoma">
      <data key="d4">7.0</data>
      <data key="d5">Anal melanoma represents a rare and aggressive histological variant among anal malignancies.</data>
      <data key="d6">oncological variant, rare cancer</data>
      <data key="d7">chunk-f2a44e885faf856aa579d824b3cd85e7</data>
    </edge>
    <edge source="Anal Cancer" target="Human Immunodeficiency Virus">
      <data key="d4">8.0</data>
      <data key="d5">Infection with Human Immunodeficiency Virus weakens the immune system, raising the risk of persistent HPV infection and anal cancer.</data>
      <data key="d6">immunodeficiency, cancer risk</data>
      <data key="d7">chunk-9530f389987c13273449ab22a85170ae</data>
    </edge>
    <edge source="Anal Cancer" target="Crohn's Disease">
      <data key="d4">6.0</data>
      <data key="d5">Crohn's disease is an autoimmune condition recognized as a risk factor for anal cancer.</data>
      <data key="d6">autoimmune risk, disease predisposition</data>
      <data key="d7">chunk-9530f389987c13273449ab22a85170ae</data>
    </edge>
    <edge source="Anal Cancer" target="Anal Dysplasia">
      <data key="d4">9.0</data>
      <data key="d5">Anal dysplasia consists of pre-cancerous lesions that can advance to anal cancer if not identified and treated.</data>
      <data key="d6">disease progression, premalignant lesion</data>
      <data key="d7">chunk-9530f389987c13273449ab22a85170ae</data>
    </edge>
    <edge source="Anal Cancer" target="High-Resolution Anoscopy">
      <data key="d4">18.0</data>
      <data key="d5">High-Resolution Anoscopy is used to detect, magnify, and biopsy suspicious lesions to confirm an anal cancer diagnosis.&lt;SEP&gt;High-resolution anoscopy is a key diagnostic test utilized to investigate and stage anal cancer.</data>
      <data key="d6">diagnostic testing, cancer detection&lt;SEP&gt;diagnostic testing, disease detection</data>
      <data key="d7">chunk-44a870810cef881997b741c32ec368fe&lt;SEP&gt;chunk-9530f389987c13273449ab22a85170ae</data>
    </edge>
    <edge source="Anal Cancer" target="Superficially Invasive Squamous Cell Carcinoma">
      <data key="d4">9.0</data>
      <data key="d5">Superficially Invasive Squamous Cell Carcinoma is the earliest, micro-invasive stage of anal cancer.</data>
      <data key="d6">cancer classification, disease staging</data>
      <data key="d7">chunk-9530f389987c13273449ab22a85170ae</data>
    </edge>
    <edge source="Anal Cancer" target="HPV16">
      <data key="d4">9.0</data>
      <data key="d5">HPV16 is a high-risk strain of human papillomavirus directly associated with an elevated risk of anal cancer.</data>
      <data key="d6">viral strain, oncogenesis</data>
      <data key="d7">chunk-9530f389987c13273449ab22a85170ae</data>
    </edge>
    <edge source="Anal Cancer" target="Vulvar Cancer">
      <data key="d4">8.0</data>
      <data key="d5">A personal medical history of vulvar cancer increases the subsequent risk of developing anal cancer.</data>
      <data key="d6">shared risk factor, cancer susceptibility</data>
      <data key="d7">chunk-9530f389987c13273449ab22a85170ae</data>
    </edge>
    <edge source="Anal Cancer" target="Vaginal Cancer">
      <data key="d4">8.0</data>
      <data key="d5">A prior history of vaginal cancer raises an individual's risk for anal cancer.</data>
      <data key="d6">shared risk factor, cancer susceptibility</data>
      <data key="d7">chunk-9530f389987c13273449ab22a85170ae</data>
    </edge>
    <edge source="Anal Cancer" target="Multiple Myeloma">
      <data key="d4">7.0</data>
      <data key="d5">Multiple myeloma acts as an immunocompromising risk factor for anal cancer development.</data>
      <data key="d6">hematologic risk, immune impairment</data>
      <data key="d7">chunk-9530f389987c13273449ab22a85170ae</data>
    </edge>
    <edge source="Anal Cancer" target="Biopsy">
      <data key="d4">18.0</data>
      <data key="d5">A biopsy confirms the pathological diagnosis of anal cancer by testing sampled tissue.&lt;SEP&gt;Biopsies provide essential pathological information regarding cancer grade and stage needed to determine anal cancer therapy.</data>
      <data key="d6">pathology, diagnostic confirmation&lt;SEP&gt;pathology, staging</data>
      <data key="d7">chunk-44a870810cef881997b741c32ec368fe&lt;SEP&gt;chunk-9530f389987c13273449ab22a85170ae</data>
    </edge>
    <edge source="Anal Cancer" target="Michael">
      <data key="d4">9.0</data>
      <data key="d5">Michael is a survivor of anal cancer who shares advice on finding mentors and supporting fellow patients during recovery.</data>
      <data key="d6">cancer survivorship, patient support</data>
      <data key="d7">chunk-06384634b72466c480713ee8d57f25ed</data>
    </edge>
    <edge source="Anal Cancer" target="Anal Precancer">
      <data key="d4">9.0</data>
      <data key="d5">Anal precancer represents precursor lesions that may develop into invasive anal cancer if left untreated.</data>
      <data key="d6">disease progression, premalignancy</data>
      <data key="d7">chunk-06384634b72466c480713ee8d57f25ed</data>
    </edge>
    <edge source="Anal Cancer" target="Stage I Anal Cancer">
      <data key="d4">9.0</data>
      <data key="d5">Stage I is an early diagnostic classification of localized anal cancer.</data>
      <data key="d6">clinical staging, early-stage cancer</data>
      <data key="d7">chunk-06384634b72466c480713ee8d57f25ed</data>
    </edge>
    <edge source="Anal Cancer" target="Stage II Anal Cancer">
      <data key="d4">9.0</data>
      <data key="d5">Stage II is an intermediate diagnostic classification of localized anal cancer based on tumor size.</data>
      <data key="d6">clinical staging, disease progression</data>
      <data key="d7">chunk-06384634b72466c480713ee8d57f25ed</data>
    </edge>
    <edge source="Anal Cancer" target="Stage III Anal Cancer">
      <data key="d4">9.0</data>
      <data key="d5">Stage III is a locally advanced diagnostic classification of anal cancer characterized by regional nodal or organ involvement.</data>
      <data key="d6">clinical staging, nodal involvement</data>
      <data key="d7">chunk-06384634b72466c480713ee8d57f25ed</data>
    </edge>
    <edge source="Anal Cancer" target="Stage IV Anal Cancer">
      <data key="d4">9.0</data>
      <data key="d5">Stage IV is the advanced, metastatic form of anal cancer that has spread to distant body sites.</data>
      <data key="d6">metastatic disease, advanced cancer</data>
      <data key="d7">chunk-06384634b72466c480713ee8d57f25ed</data>
    </edge>
    <edge source="Anal Cancer" target="Immunotherapy">
      <data key="d4">16.0</data>
      <data key="d5">Immunotherapy serves as a main treatment option for metastatic (stage IV) anal cancer.&lt;SEP&gt;Immunotherapy using immune checkpoint inhibitors is recommended for metastatic anal cancer that progresses after chemotherapy.</data>
      <data key="d6">advanced cancer treatment, immunotherapy protocol&lt;SEP&gt;systemic therapy, palliative treatment</data>
      <data key="d7">chunk-6236b93e627d54f73f1c8fe341127e67&lt;SEP&gt;chunk-06384634b72466c480713ee8d57f25ed</data>
    </edge>
    <edge source="Anal Cancer" target="Human Immunodeficiency Virus Infection">
      <data key="d4">8.0</data>
      <data key="d5">HIV infection is an identified risk factor predisposing individuals to the development of anal cancer.</data>
      <data key="d6">disease risk factor, immunocompromise</data>
      <data key="d7">chunk-06384634b72466c480713ee8d57f25ed</data>
    </edge>
    <edge source="Anal Cancer" target="HPV">
      <data key="d4">9.0</data>
      <data key="d5">Long-term HPV infection is the risk factor most strongly linked with the development of anal cancer.</data>
      <data key="d6">risk factor, viral etiology</data>
      <data key="d7">chunk-b0bad5ee25cb854c10bdbc9d33b54a1a</data>
    </edge>
    <edge source="Anal Cancer" target="Non-Metastatic Anal Cancer">
      <data key="d4">8.0</data>
      <data key="d5">Non-metastatic anal cancer represents stages I through III of anal cancer.</data>
      <data key="d6">disease staging, classification</data>
      <data key="d7">chunk-b0bad5ee25cb854c10bdbc9d33b54a1a</data>
    </edge>
    <edge source="Anal Cancer" target="Metastatic Anal Cancer">
      <data key="d4">8.0</data>
      <data key="d5">Metastatic anal cancer represents stage IV disease where cancer has spread beyond the pelvis.</data>
      <data key="d6">disease staging, advanced cancer</data>
      <data key="d7">chunk-b0bad5ee25cb854c10bdbc9d33b54a1a</data>
    </edge>
    <edge source="Anal Cancer" target="Anal Canal Cancer">
      <data key="d4">17.0</data>
      <data key="d5">Anal canal cancer is a primary form of anal cancer managed with chemoradiation.&lt;SEP&gt;Anal canal cancer is one of the two primary anatomical starting points for anal cancer.</data>
      <data key="d6">disease classification, anatomical site&lt;SEP&gt;disease classification, oncology</data>
      <data key="d7">chunk-b0bad5ee25cb854c10bdbc9d33b54a1a&lt;SEP&gt;chunk-0fdcce851d69aa713ed64ba1895bd5d1</data>
    </edge>
    <edge source="Anal Cancer" target="Perianal Cancer">
      <data key="d4">17.0</data>
      <data key="d5">Perianal cancer is evaluated similarly to anal canal cancer, with both often treated with chemoradiation.&lt;SEP&gt;Perianal cancer is one of the primary anatomical classifications of anal cancer occurring in the perianal region.</data>
      <data key="d6">disease classification, anatomical site&lt;SEP&gt;disease classification, oncology</data>
      <data key="d7">chunk-b0bad5ee25cb854c10bdbc9d33b54a1a&lt;SEP&gt;chunk-0fdcce851d69aa713ed64ba1895bd5d1</data>
    </edge>
    <edge source="Anal Cancer" target="Digital Rectal Examination">
      <data key="d4">8.0</data>
      <data key="d5">DRE is one of the recommended diagnostic post-diagnosis evaluations for anal cancer.</data>
      <data key="d6">clinical diagnostic, staging assessment</data>
      <data key="d7">chunk-b0bad5ee25cb854c10bdbc9d33b54a1a</data>
    </edge>
    <edge source="Anal Cancer" target="Anoscopy">
      <data key="d4">8.0</data>
      <data key="d5">Anoscopy is recommended following an anal cancer diagnosis for physical assessment.</data>
      <data key="d6">clinical examination, post-diagnosis workup</data>
      <data key="d7">chunk-b0bad5ee25cb854c10bdbc9d33b54a1a</data>
    </edge>
    <edge source="Anal Cancer" target="HIV Testing">
      <data key="d4">8.0</data>
      <data key="d5">HIV testing is a recommended post-diagnosis evaluation for anal cancer patients.</data>
      <data key="d6">diagnostic evaluation, risk assessment</data>
      <data key="d7">chunk-b0bad5ee25cb854c10bdbc9d33b54a1a</data>
    </edge>
    <edge source="Anal Cancer" target="Cervical Cancer Screening">
      <data key="d4">7.0</data>
      <data key="d5">Screening for cervical cancer is recommended as part of the workup after an anal cancer diagnosis.</data>
      <data key="d6">post-diagnosis screening, co-morbidity evaluation</data>
      <data key="d7">chunk-b0bad5ee25cb854c10bdbc9d33b54a1a</data>
    </edge>
    <edge source="Anal Cancer" target="Surgery">
      <data key="d4">8.0</data>
      <data key="d5">Surgery to remove the anus is an intervention reserved for persistent or recurrent anal cancer.</data>
      <data key="d6">salvage treatment, surgical oncology</data>
      <data key="d7">chunk-b0bad5ee25cb854c10bdbc9d33b54a1a</data>
    </edge>
    <edge source="Anal Cancer" target="Clinical Trials">
      <data key="d4">7.0</data>
      <data key="d5">Clinical trials represent experimental therapeutic options outlined for anal cancer management.</data>
      <data key="d6">clinical research, treatment options</data>
      <data key="d7">chunk-b0bad5ee25cb854c10bdbc9d33b54a1a</data>
    </edge>
    <edge source="Anal Cancer" target="Intensity-Modulated Radiation Therapy">
      <data key="d4">17.0</data>
      <data key="d5">Intensity-modulated radiation therapy (IMRT) is the preferred radiation modality used to treat anal cancer.&lt;SEP&gt;Intensity-modulated radiation therapy is a recommended form of radiation therapy for treating anal cancer.</data>
      <data key="d6">radiation oncology, cancer treatment</data>
      <data key="d7">chunk-0d4cea71149e0e4157126efdaa0ea3e3&lt;SEP&gt;chunk-0fdcce851d69aa713ed64ba1895bd5d1</data>
    </edge>
    <edge source="Anal Cancer" target="Chemotherapy">
      <data key="d4">18.0</data>
      <data key="d5">Chemotherapy is a core systemic treatment modality recommended in combination with radiation or for metastatic anal cancer.&lt;SEP&gt;Chemotherapy regimens are administered in conjunction with radiation therapy to treat stages I, II, and III anal cancer.</data>
      <data key="d6">cancer treatment, systemic therapy&lt;SEP&gt;systemic therapy, cancer regimen</data>
      <data key="d7">chunk-6236b93e627d54f73f1c8fe341127e67&lt;SEP&gt;chunk-0fdcce851d69aa713ed64ba1895bd5d1</data>
    </edge>
    <edge source="Anal Cancer" target="NCCN">
      <data key="d4">29.0</data>
      <data key="d5">NCCN establishes clinical practice guidelines and patient resources relevant to the staging, treatment, and care of patients with anal cancer.&lt;SEP&gt;NCCN provides patient guidelines and treatment standards for the management of anal cancer.&lt;SEP&gt;NCCN provides patient guidelines to assist individuals dealing with emotional distress and side effects during and after cancer treatment.&lt;SEP&gt;NCCN publishes patient guidance and solicits feedback on educational resources regarding anal and perianal cancer treatments.</data>
      <data key="d6">clinical guidelines, cancer care&lt;SEP&gt;clinical guidelines, patient education&lt;SEP&gt;guidelines, patient education&lt;SEP&gt;patient education, healthcare guidance</data>
      <data key="d7">chunk-44a870810cef881997b741c32ec368fe&lt;SEP&gt;chunk-0fdcce851d69aa713ed64ba1895bd5d1&lt;SEP&gt;chunk-cf41d1c08e8df109ad214d831867a5d9&lt;SEP&gt;chunk-0d4cea71149e0e4157126efdaa0ea3e3</data>
    </edge>
    <edge source="Anal Cancer" target="Melissa">
      <data key="d4">9.0</data>
      <data key="d5">Melissa is an anal cancer survivor who shares advice on treatment and survivorship.</data>
      <data key="d6">patient perspective, cancer survivorship</data>
      <data key="d7">chunk-6236b93e627d54f73f1c8fe341127e67</data>
    </edge>
    <edge source="Anal Cancer" target="Survivorship">
      <data key="d4">8.0</data>
      <data key="d5">Survivorship care addresses the specific long-term and late side effects experienced by individuals recovering from anal cancer.</data>
      <data key="d6">post-treatment care, recovery management</data>
      <data key="d7">chunk-6236b93e627d54f73f1c8fe341127e67</data>
    </edge>
    <edge source="Anal Cancer" target="IMRT">
      <data key="d4">9.0</data>
      <data key="d5">IMRT is an advanced radiation therapy technique specifically recommended for treating anal cancer while sparing adjacent tissues.</data>
      <data key="d6">targeted therapy, radiation technique</data>
      <data key="d7">chunk-6236b93e627d54f73f1c8fe341127e67</data>
    </edge>
    <edge source="Anal Cancer" target="APR Surgery">
      <data key="d4">8.0</data>
      <data key="d5">APR surgery is performed for anal cancer that does not respond to primary chemoradiation or that recurs locally.</data>
      <data key="d6">salvage surgery, surgical intervention</data>
      <data key="d7">chunk-6236b93e627d54f73f1c8fe341127e67</data>
    </edge>
    <edge source="Anal Cancer" target="Groin Dissection">
      <data key="d4">7.0</data>
      <data key="d5">Groin dissection is recommended if anal cancer recurs in the groin lymph nodes after radiation.</data>
      <data key="d6">recurrence management, surgical dissection</data>
      <data key="d7">chunk-6236b93e627d54f73f1c8fe341127e67</data>
    </edge>

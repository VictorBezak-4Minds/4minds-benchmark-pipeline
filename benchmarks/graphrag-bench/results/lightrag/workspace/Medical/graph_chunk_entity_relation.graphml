      <data key="d6">sample analysis, clinical expertise</data>
      <data key="d7">chunk-9fa573748870dc50a98a935843997c68</data>
    </edge>
    <edge source="Bone Marrow Test" target="Biopsy">
      <data key="d4">7.0</data>
      <data key="d5">Bone marrow testing includes a bone marrow biopsy component to sample core marrow tissue.</data>
      <data key="d6">procedural relationship, diagnostic method</data>
      <data key="d7">chunk-30c0bb66b1a2f93e89f5342ab1077451</data>
    </edge>
    <edge source="Hemoglobin" target="Red Blood Cell Transfusion">

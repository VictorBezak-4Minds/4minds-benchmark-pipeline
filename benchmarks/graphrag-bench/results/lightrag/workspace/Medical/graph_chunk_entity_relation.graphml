      <data key="d5">The urologist is a core specialist on the multidisciplinary care team for urinary system issues.</data>
      <data key="d6">specialist care, team member</data>
      <data key="d7">chunk-dea00cf063e8831db4919330d94b1f2a</data>
    </edge>
    <edge source="Multidisciplinary Care Team" target="Primary Care Doctor">
      <data key="d4">6.0</data>
      <data key="d5">The primary care doctor helps the patient communicate treatment goals with the cancer care team.</data>
      <data key="d6">patient advocacy, care collaboration</data>
      <data key="d7">chunk-dea00cf063e8831db4919330d94b1f2a</data>
    </edge>
    <edge source="Multidisciplinary Care Team" target="Oncology Nurse">
      <data key="d4">8.0</data>
      <data key="d5">Oncology nurses are essential members of the multidisciplinary care team providing direct patient care and administering systemic therapy.</data>
      <data key="d6">patient care, multidisciplinary team</data>
      <data key="d7">chunk-dea00cf063e8831db4919330d94b1f2a</data>
    </edge>
    <edge source="Multidisciplinary Care Team" target="Pharmacist">
      <data key="d4">7.0</data>
      <data key="d5">A pharmacist collaborates with the care team by preparing chemotherapy and advising on oncology medications.</data>
      <data key="d6">medication management, clinical collaboration</data>
      <data key="d7">chunk-dea00cf063e8831db4919330d94b1f2a</data>
    </edge>
    <edge source="Multidisciplinary Care Team" target="Diagnostic Radiologist">
      <data key="d4">7.0</data>
      <data key="d5">A diagnostic radiologist works with the care team by interpreting diagnostic imaging tests.</data>
      <data key="d6">imaging analysis, diagnostics</data>
      <data key="d7">chunk-dea00cf063e8831db4919330d94b1f2a</data>
    </edge>
    <edge source="Multidisciplinary Care Team" target="Advanced Practice Provider">
      <data key="d4">7.0</data>
      <data key="d5">Advanced practice providers serve on the multidisciplinary team monitoring health and delivering supportive clinical care.</data>
      <data key="d6">clinical care, patient monitoring</data>
      <data key="d7">chunk-dea00cf063e8831db4919330d94b1f2a</data>
    </edge>

      <data key="d5">NCCN provides patient guidelines specifically addressing invasive breast cancer management.</data>
      <data key="d6">clinical guidelines, treatment guidelines</data>
      <data key="d7">chunk-1dc8d8e5ed4f165f3e56305a7644ba05</data>
    </edge>
    <edge source="Metastatic Breast Cancer" target="NCCN">
      <data key="d4">23.0</data>
      <data key="d5">NCCN provides patient guidelines dedicated to metastatic breast cancer care.&lt;SEP&gt;NCCN publishes patient guidelines and guides focused on metastatic breast cancer.&lt;SEP&gt;NCCN publishes specialized patient guidelines and resources concerning metastatic breast cancer care.</data>
      <data key="d6">clinical guidelines, advanced treatment&lt;SEP&gt;patient resources, medical guidelines</data>

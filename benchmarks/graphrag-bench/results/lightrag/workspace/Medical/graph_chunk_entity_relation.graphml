      <data key="d6">team composition, clinical assessment</data>
      <data key="d7">chunk-ecc6c4bcd3cab65fa05ab5f3c55e528d</data>
    </edge>
    <edge source="Thoracic Radiologist" target="Lung Nodule">
      <data key="d4">8.0</data>
      <data key="d5">Thoracic radiologists review chest scans to assess and monitor lung nodules.</data>
      <data key="d6">diagnostic imaging, clinical evaluation</data>
      <data key="d7">chunk-7843955573cdc294b34e74019195fafb</data>
    </edge>
    <edge source="Thoracic Radiologist" target="Assessment Team">
      <data key="d4">8.0</data>

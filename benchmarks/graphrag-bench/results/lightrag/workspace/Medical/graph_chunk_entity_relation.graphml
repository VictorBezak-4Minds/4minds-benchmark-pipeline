      <data key="d6">targeted therapy, genetic mutation</data>
      <data key="d7">chunk-e45947107c74d8a06e350be57a94a408</data>
    </edge>
    <edge source="Breast Cancer" target="PIK3CA Inhibitors">
      <data key="d4">8.0</data>
      <data key="d5">PIK3CA inhibitors treat breast cancers harboring mutations in the PIK3CA gene.</data>
      <data key="d6">targeted therapy, genetic mutation</data>
      <data key="d7">chunk-e45947107c74d8a06e350be57a94a408</data>
    </edge>
    <edge source="Breast Cancer" target="Cowden Syndrome">
      <data key="d4">8.0</data>
      <data key="d5">Cowden syndrome is associated with a spectrum of malignancies that includes breast cancer.</data>

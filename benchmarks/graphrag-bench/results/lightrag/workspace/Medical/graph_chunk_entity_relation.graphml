      <data key="d7">chunk-8b66e38931f28ed6ac9b231faaf202fb</data>
    </edge>
    <edge source="Chronic Myeloid Leukemia" target="Platelets">
      <data key="d4">7.0</data>
      <data key="d5">Platelet levels are disrupted in chronic myeloid leukemia, manifesting as abnormally high or low counts.</data>
      <data key="d6">hematologic disorder, clinical manifestation</data>
      <data key="d7">chunk-8b66e38931f28ed6ac9b231faaf202fb</data>
    </edge>

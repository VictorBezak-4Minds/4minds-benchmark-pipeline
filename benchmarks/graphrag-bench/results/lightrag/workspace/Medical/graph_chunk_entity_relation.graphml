    </edge>
    <edge source="Stomach Cancer" target="Digestive System">
      <data key="d4">8.0</data>
      <data key="d5">Stomach cancer occurs in the stomach, a core muscular organ of the gastrointestinal digestive system.</data>
      <data key="d6">organ pathology, anatomical system</data>
      <data key="d7">chunk-5fdcf47f3da06d3e0213112c96eb93d4</data>
    </edge>
    <edge source="Stomach Cancer" target="Gastrointestinal Tract">
      <data key="d4">9.0</data>
      <data key="d5">Stomach cancer develops within the stomach, which forms part of the gastrointestinal tract.</data>
      <data key="d6">anatomical location, oncology</data>
      <data key="d7">chunk-5fdcf47f3da06d3e0213112c96eb93d4</data>
    </edge>
    <edge source="Stomach Cancer" target="Layers of the Stomach Wall">
      <data key="d4">9.0</data>
      <data key="d5">Stomach cancer originates in the innermost layer and spreads outward across the stomach wall layers.</data>
      <data key="d6">disease progression, tumor invasion</data>
      <data key="d7">chunk-01c80b2d18abb91c5be598d33cf7a33a</data>
    </edge>
    <edge source="Stomach Cancer" target="Precancerous Changes">
      <data key="d4">8.0</data>
      <data key="d5">Precancerous changes develop within the mucosa before progressing into overt stomach cancer.</data>
      <data key="d6">pathogenesis, disease onset</data>
      <data key="d7">chunk-01c80b2d18abb91c5be598d33cf7a33a</data>
    </edge>
    <edge source="Stomach Cancer" target="Digestive Organs">
      <data key="d4">8.0</data>
      <data key="d5">Stomach cancer can invade neighboring digestive organs such as the liver, pancreas, and intestines.</data>
      <data key="d6">metastasis, anatomical involvement</data>
      <data key="d7">chunk-01c80b2d18abb91c5be598d33cf7a33a</data>
    </edge>
    <edge source="Chemoradiation" target="Rectal Cancer">
      <data key="d4">8.0</data>
      <data key="d5">Chemoradiation is utilized as an alternative or adjuvant treatment option for rectal cancer.</data>
      <data key="d6">oncological treatment, multimodal therapy</data>
      <data key="d7">chunk-37bca9f4d2ebaeed359c9b4eb7a0c1de</data>
    </edge>
    <edge source="Chemoradiation" target="Local Excision">
      <data key="d4">7.0</data>
      <data key="d5">Chemoradiation serves as an alternative secondary treatment option following local excision.</data>

    </edge>
    <edge source="Breast Cancer" target="Breast Cancer Screening">
      <data key="d4">18.0</data>
      <data key="d5">Breast cancer screening aims to detect breast cancer early to improve treatment outcomes.&lt;SEP&gt;Breast cancer screening is performed to detect breast cancer early to improve treatment outcomes.</data>

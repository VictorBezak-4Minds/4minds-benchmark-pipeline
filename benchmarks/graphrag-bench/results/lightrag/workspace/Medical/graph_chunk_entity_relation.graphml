      <data key="d6">disease taxonomy, oncology classification</data>
      <data key="d7">chunk-ba28a3ce3534c0655a0d08a953d7f038</data>
    </edge>
    <edge source="Bone Cancer" target="Osteosarcoma">
      <data key="d4">9.0</data>
      <data key="d5">Osteosarcoma is identified as one of the more common types of bone cancer.</data>

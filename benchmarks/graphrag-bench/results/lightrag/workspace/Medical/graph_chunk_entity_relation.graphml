      <data key="d7">chunk-76a038845aaedb9ef7852018f26778b3</data>
    </edge>
    <edge source="Cystoscopy" target="Narrow-Band Imaging">
      <data key="d4">8.0</data>
      <data key="d5">Narrow-band imaging is an optical technique applied during cystoscopy to enhance tumor detection.</data>

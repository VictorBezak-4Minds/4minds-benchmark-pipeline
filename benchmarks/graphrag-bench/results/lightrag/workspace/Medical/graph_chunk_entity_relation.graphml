      <data key="d7">chunk-7102a43dfb62e649d725bc95ba292688</data>
    </edge>
    <edge source="Kidney Cancer" target="RCC Subtypes">
      <data key="d4">9.0</data>
      <data key="d5">RCC subtypes represent specific morphological and pathological classifications of kidney cancer.</data>
      <data key="d6">classification, oncology</data>
      <data key="d7">chunk-37bca9f4d2ebaeed359c9b4eb7a0c1de</data>
    </edge>
    <edge source="Kidney Cancer" target="Renal Cell Carcinoma">
      <data key="d4">9.0</data>
      <data key="d5">Renal cell carcinoma is the primary and most common form of kidney cancer, representing about 9 out of 10 cases.</data>
      <data key="d6">disease classification, cancer subtype</data>
      <data key="d7">chunk-48e138ec8da954a5667dc785e919c86b</data>
    </edge>
    <edge source="Kidney Cancer" target="Urothelial Carcinoma">
      <data key="d4">7.0</data>
      <data key="d5">Urothelial carcinoma arises in the renal pelvis and ureter near the kidney and can be confused with kidney cancer, although it is treated differently.</data>
      <data key="d6">differential diagnosis, disease comparison</data>
      <data key="d7">chunk-48e138ec8da954a5667dc785e919c86b</data>
    </edge>
    <edge source="Kidney Cancer" target="Wilms Tumor">
      <data key="d4">7.0</data>
      <data key="d5">Wilms tumor is a specific form of kidney cancer predominantly found in pediatric patients.</data>
      <data key="d6">pediatric oncology, cancer subtype</data>
      <data key="d7">chunk-48e138ec8da954a5667dc785e919c86b</data>
    </edge>
    <edge source="Kidney Cancer" target="Renal Sarcoma">
      <data key="d4">7.0</data>
      <data key="d5">Renal sarcoma is an uncommon cancer arising within the kidney's connective tissue or blood vessels.</data>
      <data key="d6">rare malignancy, disease classification</data>
      <data key="d7">chunk-48e138ec8da954a5667dc785e919c86b</data>
    </edge>
    <edge source="Kidney Cancer" target="Advanced Kidney Cancer">
      <data key="d4">9.0</data>

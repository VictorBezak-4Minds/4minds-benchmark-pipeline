    </edge>
    <edge source="Head And Neck Cancers" target="Throat Cancer">
      <data key="d4">9.0</data>
      <data key="d5">Throat cancer is classified under the overarching group of head and neck cancers.</data>
      <data key="d6">oncological classification, anatomical category</data>

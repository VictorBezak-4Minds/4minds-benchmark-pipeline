    <edge source="Cirrhosis" target="Non-Alcoholic Fatty Liver Disease">
      <data key="d4">8.0</data>
      <data key="d5">Non-alcoholic fatty liver disease can progress to liver scarring and cirrhosis.</data>
      <data key="d6">disease progression, liver pathology</data>

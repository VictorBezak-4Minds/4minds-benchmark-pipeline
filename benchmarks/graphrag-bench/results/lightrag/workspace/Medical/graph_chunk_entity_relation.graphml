      <data key="d6">diagnostic review, specimen analysis</data>
      <data key="d7">chunk-0786666c65b5bf00705439d5cb60d5a0</data>
    </edge>
    <edge source="Molecular Testing" target="Biomarker Testing">
      <data key="d4">9.0</data>

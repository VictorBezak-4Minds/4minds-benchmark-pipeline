      <data key="d7">chunk-6a93aa507dd7d98a02e8ba92d39e3649</data>
    </edge>
    <edge source="Mammogram" target="Breast Cancer Screening">
      <data key="d4">9.0</data>
      <data key="d5">Mammograms are the primary imaging examination utilized during breast cancer screening.</data>

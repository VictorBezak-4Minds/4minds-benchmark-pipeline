      <data key="d6">patient management, clinical coordination</data>
      <data key="d7">chunk-9e8b25c2957355218780bdfd8b72df45</data>
    </edge>
    <edge source="Multidisciplinary Care Team" target="Physical Exam">
      <data key="d4">7.0</data>
      <data key="d5">Healthcare providers on the multidisciplinary care team perform physical exams to detect clinical signs of disease.</data>
      <data key="d6">clinical evaluation, patient examination</data>
      <data key="d7">chunk-68217ea9e5382d1756c99b5152ea98db</data>
    </edge>
    <edge source="Multidisciplinary Care Team" target="Urologic Oncologist">
      <data key="d4">8.0</data>
      <data key="d5">The urologic oncologist is a surgical oncology specialist on the bladder cancer care team.</data>
      <data key="d6">surgical oncology, team member</data>
      <data key="d7">chunk-dea00cf063e8831db4919330d94b1f2a</data>
    </edge>
    <edge source="Multidisciplinary Care Team" target="Urologist">

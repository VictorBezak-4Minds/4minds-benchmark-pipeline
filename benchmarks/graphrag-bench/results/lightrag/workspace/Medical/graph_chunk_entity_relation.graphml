      <data key="d7">chunk-6268b6efa690f6e094e443dca6b4cb52</data>
    </edge>
    <edge source="Genetic Tests" target="Prostate Cancer">
      <data key="d4">8.0</data>
      <data key="d5">Genetic tests evaluate inherited mutations that place patients at higher risk for prostate cancer.</data>

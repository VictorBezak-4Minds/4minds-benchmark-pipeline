    <edge source="Bone Marrow" target="Lymphatic System">
      <data key="d4">8.0</data>
      <data key="d5">Bone marrow produces the lymphocytes that circulate through the lymphatic system.</data>
      <data key="d6">cellular production, anatomy</data>
      <data key="d7">chunk-d67bee20d5e5400994f8c8f03052dd06</data>
    </edge>
    <edge source="Bone Marrow" target="Lymphocytes">

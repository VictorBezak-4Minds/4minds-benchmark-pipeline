    </edge>
    <edge source="Metastatic Breast Cancer" target="Distant Metastasis">
      <data key="d4">10.0</data>
      <data key="d5">Distant metastasis defines metastatic breast cancer as malignant cells colonize distant organs such as the bones, liver, lungs, or brain.</data>
      <data key="d6">advanced disease, hematogenous spread</data>
      <data key="d7">chunk-53c0ac935ec10ce8a0839db4ad053ad1</data>
    </edge>

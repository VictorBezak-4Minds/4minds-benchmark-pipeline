      <data key="d7">chunk-711bee9440e11d7c737bc4a49b880910</data>
    </edge>
    <edge source="Resectable Tumor" target="Surgery">
      <data key="d4">9.0</data>
      <data key="d5">A resectable tumor is defined by its ability to be completely removed through surgical procedures.</data>

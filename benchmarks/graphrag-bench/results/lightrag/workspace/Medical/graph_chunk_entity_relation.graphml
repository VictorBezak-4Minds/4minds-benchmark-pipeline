    </edge>
    <edge source="Early-Stage Prostate Cancer" target="Health Care Providers">
      <data key="d4">8.0</data>
      <data key="d5">Health care providers plan and monitor treatment or active surveillance for patients with early-stage prostate cancer.</data>
      <data key="d6">clinical management, patient care</data>
      <data key="d7">chunk-6232dd9ed168a1113955e7300645338b</data>
    </edge>
    <edge source="Early-Stage Prostate Cancer" target="Diagnostic Tests">
      <data key="d4">8.0</data>
      <data key="d5">Diagnostic tests determine whether prostate cancer is classified as early-stage or advanced-stage to guide treatment planning.</data>
      <data key="d6">disease staging, clinical diagnosis</data>
      <data key="d7">chunk-6232dd9ed168a1113955e7300645338b</data>
    </edge>
    <edge source="Early-Stage Prostate Cancer" target="PSMA/PET Scan">
      <data key="d4">7.0</data>
      <data key="d5">Patients with early-stage prostate cancer generally do not require advanced PSMA/PET imaging at initial diagnosis.</data>

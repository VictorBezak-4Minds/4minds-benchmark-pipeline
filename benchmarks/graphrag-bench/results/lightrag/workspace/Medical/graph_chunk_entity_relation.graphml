      <data key="d7">chunk-c37f547042fc10baabdbfaadf010bce5</data>
    </edge>
    <edge source="HER2 Status Testing" target="Biomarker Testing">
      <data key="d4">9.0</data>
      <data key="d5">HER2 status testing represents a standard procedure within the category of biomarker evaluations used in breast cancer management.</data>
      <data key="d6">molecular testing, targeted therapy</data>
      <data key="d7">chunk-a06038ec84f20e873b9e275a23aea8d9</data>
    </edge>
    <edge source="Diagnostic Testing for MBC" target="Biopsy">
